# Copy this file to .env and fill in your own values.
# Without MONGODB_URI, the app falls back to a local JSON file (src/data/db.json)
# which resets whenever the server restarts on free hosting like Render.
#
# To get MONGODB_URI:
# 1. Sign up free at https://www.mongodb.com/cloud/atlas/register
# 2. Create a free M0 cluster
# 3. Database Access -> add a database user (username/password)
# 4. Network Access -> allow access from anywhere (0.0.0.0/0)
# 5. Connect -> Drivers -> copy the connection string and paste below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional: database name to use inside your Atlas cluster (default: lilteam_shop)
MONGODB_DB_NAME=lilteam_shop

# Recommended for production and admin-account recovery.
# On startup, the app ensures this username is an active admin and applies this password
# without resetting any shop data. Use a long, unique password on the hosting dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

PORT=3000

# SlipOK (https://slipok.com) — auto-verifies bank transfer slips on top-up.
# Without these two values, slip upload still works but skips auto-verification
# (falls back to manual admin review, as before).
# Get these from your SlipOK dashboard: Branch settings -> Branch ID, and API Key.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
