# Copy this file to .env and fill in your own values.
# Without MONGODB_URI, the app falls back to a local JSON file (src/data/db.json)
# which resets whenever the server restarts on free hosting like Render.
#
# To get MONGODB_URI:
# 1. Sign up free at https://www.mongodb.com/cloud/atlas/register
# 2. Create a free M0 cluster
# 3. Database Access -> add a database user (username/password)
# 4. Network Access -> allow access from anywhere (0.0.0.0/0)
# 5. Connect -> Drivers -> copy the connection string and paste below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional: database name to use inside your Atlas cluster (default: lilteam_shop)
MONGODB_DB_NAME=lilteam_shop

# Recommended for production and admin-account recovery.
# On startup, the app ensures this username is an active admin and applies this password
# without resetting any shop data. Use a long, unique password on the hosting dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

PORT=3000

# SlipOK (https://slipok.com) — auto-verifies bank transfer slips on top-up.
# Without these two values, slip upload still works but skips auto-verification
# (falls back to manual admin review, as before).
# Get these from your SlipOK dashboard: Branch settings -> Branch ID, and API Key.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# License key system for renting this shop out (see "ให้คนอื่นเช่าระบบนี้ไปเปิดร้านเอง" in README.md).
# LICENSE_SECRET: required to sign/verify keys at all. Set this on BOTH your
#   own seller shop (to sell keys via /rent-website) AND every rented deployment
#   (to verify keys entered at /license) — same value everywhere.
# LICENSE_GATE=on: ONLY set this on a RENTED deployment to actually lock it
#   until a valid key is entered. Never set this on your own seller shop, or
#   it will lock itself out.
LICENSE_SECRET=
LICENSE_GATE=

# Fully-automatic "เปิดเว็บใหม่" at /rent-website — customer-funded by default,
# so it costs the seller nothing. Only RAILWAY_TEMPLATE_REPO is required on
# your own seller shop; the buyer pastes their OWN Railway API token + own
# MongoDB URI into the purchase form (with direct links to get both), and
# the new project is created on THEIR Railway account/billing. Their token
# and URI are used only for that one request and are never stored.
# RAILWAY_TEMPLATE_REPO: "owner/repo" of this codebase on GitHub, e.g.
#   "lilteam4629/lilteam-shop". Must be a public repo (or connected to the
#   buyer's own Railway GitHub integration) so any buyer's token can deploy it.
RAILWAY_TEMPLATE_REPO=

# Optional fallback: if set, used only when a buyer doesn't provide their own
# Railway token (i.e. YOU foot the bill for that site instead). Leave blank
# to require every "new site" buyer to bring their own.
RAILWAY_API_TOKEN=

# Which branch customer sites deploy from (default: "release"). Keep this
# DIFFERENT from the branch you normally push to (e.g. "main") so pushing
# your own updates only affects YOUR OWN shop. When you're ready to push an
# update to all rented sites at once, merge your branch into this one and
# push — every site tracking it auto-redeploys. Customers can also pull the
# latest release into just their own site anytime via the "ซิงค์ตอนนี้"
# button on their purchase page (needs their Railway token again, not
# stored), without touching anyone else's site.
RAILWAY_RELEASE_BRANCH=release

# Powers the "🚀 ปล่อยอัพเดตให้เว็บลูกค้าทั้งหมด" button in
# /admin/license-plans — merges your dev branch (GITHUB_DEV_BRANCH,
# default "main") into RAILWAY_RELEASE_BRANCH with one click, so you don't
# have to do it by hand. Needs a GitHub Personal Access Token with `repo`
# scope: github.com -> Settings -> Developer settings -> Personal access
# tokens -> generate one, scoped to just this repo if possible.
GITHUB_TOKEN=
GITHUB_DEV_BRANCH=main
