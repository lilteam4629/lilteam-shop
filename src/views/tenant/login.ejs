<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }</style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-[#1a160d] border border-[#3a3220] rounded-2xl p-6">
    <h1 class="text-xl font-bold text-center mb-1">🔑 เข้าสู่ระบบ</h1>
    <p class="text-sm text-[#a89a6c] text-center mb-5"><%= shop.name %></p>
    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>
    <form action="/s/<%= shop.slug %>/login" method="post" class="space-y-3">
      <input name="password" type="password" required placeholder="รหัสผ่านเจ้าของร้าน" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm text-center" />
      <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-2.5 text-sm">เข้าสู่ระบบ</button>
    </form>
    <a href="/s/<%= shop.slug %>" class="block text-center text-xs text-[#a89a6c] mt-4">← กลับหน้าร้าน</a>
  </div>
</body>
</html>
