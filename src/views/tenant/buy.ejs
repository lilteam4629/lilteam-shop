<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }</style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-[#1a160d] border border-[#3a3220] rounded-2xl p-6">
    <a href="/s/<%= shop.slug %>" class="text-xs text-[#a89a6c]">← กลับหน้าร้าน</a>
    <h1 class="text-lg font-bold mt-2 mb-1"><%= product.title %></h1>
    <p class="text-[#c8a63f] font-bold text-xl mb-4">฿<%= product.price.toLocaleString() %></p>

    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>

    <form action="/s/<%= shop.slug %>/buy/<%= product.id %>" method="post" class="space-y-3">
      <div>
        <label class="block text-xs mb-1 text-[#a89a6c]">ชื่อของคุณ</label>
        <input name="buyerName" required class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs mb-1 text-[#a89a6c]">ช่องทางติดต่อกลับ (Line/เบอร์/อีเมล)</label>
        <input name="buyerContact" required class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
      </div>
      <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-2.5 text-sm mt-2">ยืนยันสั่งซื้อ</button>
    </form>
    <p class="text-[10px] text-[#5a5133] text-center mt-4">ร้านจะติดต่อกลับเพื่อแจ้งช่องทางชำระเงิน (ยังไม่มีระบบตัดเงินอัตโนมัติ)</p>
  </div>
</body>
</html>
