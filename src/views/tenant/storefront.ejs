<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }</style>
</head>
<body class="min-h-screen p-4">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold">🏪 <%= shop.name %></h1>
      <a href="/s/<%= shop.slug %>/login" class="text-xs text-[#a89a6c] border border-[#443a22] rounded-full px-3 py-1.5">เจ้าของร้าน →</a>
    </div>

    <% if (!products.length) { %>
      <div class="bg-[#1a160d] border border-[#3a3220] rounded-2xl p-8 text-center text-sm text-[#a89a6c]">
        ร้านนี้ยังไม่มีสินค้าวางขาย
      </div>
    <% } else { %>
      <div class="grid sm:grid-cols-2 gap-4">
        <% products.forEach(p => { %>
          <div class="bg-[#1a160d] border border-[#3a3220] rounded-2xl overflow-hidden">
            <% if (p.image) { %>
              <img src="<%= p.image %>" class="w-full h-36 object-cover" alt="<%= p.title %>" />
            <% } %>
            <div class="p-4">
              <div class="font-semibold mb-1"><%= p.title %></div>
              <% if (p.description) { %><p class="text-xs text-[#a89a6c] mb-2 line-clamp-2"><%= p.description %></p><% } %>
              <div class="flex items-center justify-between">
                <span class="text-[#c8a63f] font-bold">฿<%= p.price.toLocaleString() %></span>
                <span class="text-[10px] text-[#5a5133]">สต๊อก <%= p.stock %></span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
    <p class="text-[10px] text-[#5a5133] text-center mt-6">ระบบตะกร้า/ชำระเงินยังไม่เปิดใช้งาน (อยู่ระหว่างพัฒนา)</p>
  </div>
</body>
</html>
