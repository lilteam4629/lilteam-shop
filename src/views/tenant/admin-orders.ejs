<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }</style>
</head>
<body class="min-h-screen p-4">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
      <div>
        <h1 class="text-xl font-bold">🧾 ออเดอร์ — <%= shop.name %></h1>
        <p class="text-xs text-[#a89a6c]">/s/<%= shop.slug %></p>
      </div>
      <div class="flex gap-2">
        <a href="/s/<%= shop.slug %>/admin" class="text-xs text-[#a89a6c] border border-[#443a22] rounded-full px-3 py-1.5">← สินค้า</a>
        <a href="/s/<%= shop.slug %>" class="text-xs text-[#a89a6c] border border-[#443a22] rounded-full px-3 py-1.5">ดูหน้าร้าน →</a>
      </div>
    </div>

    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>
    <% if (messages.success && messages.success.length) { %>
      <% messages.success.forEach(m => { %>
        <div class="bg-emerald-900/30 border border-emerald-700 text-emerald-300 px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>

    <div class="bg-[#1a160d] border border-[#3a3220] rounded-2xl overflow-x-auto">
      <table class="w-full text-sm min-w-[640px]">
        <thead class="text-[#a89a6c] text-left border-b border-[#3a3220]">
          <tr>
            <th class="p-3">สินค้า</th>
            <th class="p-3">ราคา</th>
            <th class="p-3">ผู้ซื้อ</th>
            <th class="p-3">ติดต่อ</th>
            <th class="p-3">สถานะ</th>
            <th class="p-3">เวลา</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#3a3220]">
          <% orders.forEach(o => { %>
            <tr>
              <td class="p-3 whitespace-nowrap"><%= o.productTitle %></td>
              <td class="p-3 text-[#c8a63f] whitespace-nowrap">฿<%= o.price.toLocaleString() %></td>
              <td class="p-3 whitespace-nowrap"><%= o.buyerName %></td>
              <td class="p-3 whitespace-nowrap"><%= o.buyerContact %></td>
              <td class="p-3 whitespace-nowrap">
                <form action="/s/<%= shop.slug %>/admin/orders/<%= o.id %>/status" method="post" class="inline">
                  <select name="status" onchange="this.form.submit()" class="bg-[#211c11] border border-[#443a22] rounded-lg px-2 py-1 text-xs">
                    <option value="pending" <%= o.status==='pending'?'selected':'' %>>รอดำเนินการ</option>
                    <option value="paid" <%= o.status==='paid'?'selected':'' %>>ชำระแล้ว</option>
                    <option value="fulfilled" <%= o.status==='fulfilled'?'selected':'' %>>ส่งมอบแล้ว</option>
                    <option value="cancelled" <%= o.status==='cancelled'?'selected':'' %>>ยกเลิก</option>
                  </select>
                </form>
              </td>
              <td class="p-3 text-[#5a5133] text-xs whitespace-nowrap"><%= new Date(o.createdAt).toLocaleString('th-TH') %></td>
            </tr>
          <% }) %>
          <% if (!orders.length) { %><tr><td class="p-3 text-[#5a5133]" colspan="6">ยังไม่มีออเดอร์</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
