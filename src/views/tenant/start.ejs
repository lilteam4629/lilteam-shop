<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    <%- typeof themeCss !== 'undefined' ? themeCss : '' %>
    body { font-family: 'Kanit', sans-serif; background: var(--bg, #100e08); color: var(--text, #f3ecd8); }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6">
    <div class="text-center mb-5">
      <% if (logoImage) { %>
        <img src="<%= logoImage %>" alt="โลโก้ร้าน" class="w-16 h-16 rounded-2xl object-contain p-1.5 mx-auto mb-2 bg-gradient-to-br from-[var(--gold-light)] via-[var(--gold)] to-[var(--gold-dark)] border border-[var(--gold)]/50 shadow-[0_0_16px_rgba(0,0,0,.3)]" />
      <% } else { %>
        <div class="text-3xl mb-2">🏪</div>
      <% } %>
      <h1 class="text-xl font-bold">เปิดร้านของคุณเอง</h1>
      <p class="text-sm text-[var(--text-3)] mt-1">ได้ร้านทันที พร้อมใช้งานเลย</p>
    </div>

    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/50 text-[var(--coral)] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>

    <% if (!domainReady) { %>
      <div class="bg-amber-900/30 border border-amber-600/50 text-amber-300 rounded-lg px-4 py-3 text-sm text-center">
        ⚠️ ระบบเปิดร้านยังไม่พร้อมใช้งาน (ต้องตั้งค่า MAIN_DOMAIN + DNS ก่อน)
      </div>
    <% } else if (!plans.length) { %>
      <div class="bg-amber-900/30 border border-amber-600/50 text-amber-300 rounded-lg px-4 py-3 text-sm text-center">
        ⚠️ ยังไม่มีแพ็กเกจให้เลือก กรุณาติดต่อผู้ดูแลเว็บ
      </div>
    <% } else { %>
      <form action="/start" method="post" class="space-y-3">
        <div>
          <label class="block text-xs mb-2 text-[var(--text-3)]">เลือกแพ็กเกจ</label>
          <div class="space-y-2">
            <% plans.forEach((plan, i) => { %>
              <label class="plan-pick-card relative flex items-center justify-between gap-2 rounded-lg border border-[var(--border-light)] bg-[var(--input)] px-3 py-2.5 cursor-pointer">
                <input type="radio" name="planId" value="<%= plan.id %>" required <%= (preselectedPlanId ? plan.id === preselectedPlanId : i === 0) ? 'checked' : '' %> class="peer sr-only" />
                <span class="absolute inset-0 rounded-lg border-2 border-transparent peer-checked:border-[var(--gold)] peer-checked:bg-[var(--gold)]/10 pointer-events-none"></span>
                <span class="relative flex items-center gap-2">
                  <span class="text-sm font-medium"><%= plan.days %> วัน</span>
                  <% if (plan.promo) { %>
                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-gradient-to-r from-[var(--gold-light)] to-[var(--gold)] text-[var(--bg)]">🔥 โปรโมชั่น</span>
                  <% } %>
                </span>
                <span class="relative text-sm font-semibold text-[var(--gold)]">฿<%= plan.price.toLocaleString() %></span>
              </label>
              <% if (plan.promo && (plan.promoLimit || plan.promoExpiresAt)) { %>
                <p class="text-[10px] text-[var(--text-4)] pl-1 -mt-1">
                  <% if (plan.promoLimit) { %>เหลือ <%= Math.max(0, plan.promoLimit - (plan.promoUsedCount || 0)) %>/<%= plan.promoLimit %> สิทธิ์<% } %>
                  <% if (plan.promoLimit && plan.promoExpiresAt) { %> · <% } %>
                  <% if (plan.promoExpiresAt) { %>หมดเขต <%= new Date(plan.promoExpiresAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', dateStyle: 'short', timeStyle: 'short' }) %><% } %>
                </p>
              <% } %>
            <% }) %>
          </div>
        </div>
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">ชื่อร้านค้า</label>
          <input name="shopName" required placeholder="เช่น My Game Shop" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
          <p class="text-[10px] text-[var(--text-4)] mt-1">ร้านของคุณจะอยู่ที่ ชื่อร้าน.<%= mainDomain %></p>
        </div>
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">ชื่อผู้ใช้แอดมิน (สำหรับเข้า /admin ของร้านใหม่)</label>
          <input name="adminUsername" required pattern="[a-zA-Z0-9_]{3,20}" placeholder="เช่น myshop_admin" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">รหัสผ่านแอดมิน (อย่างน้อย 8 ตัว)</label>
          <input name="adminPassword" type="password" required minlength="8" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
        </div>
        <% if (recaptchaSiteKey) { %>
          <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
        <% } %>
        <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg py-2.5 text-sm mt-2">🚀 เปิดร้านตอนนี้</button>
      </form>
      <% if (recaptchaSiteKey) { %>
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
      <% } %>
    <% } %>
    <p class="text-[10px] text-[var(--text-4)] text-center mt-4">ร้านที่เปิดจะได้ระบบสินค้า/สต๊อก/ออเดอร์/หลังบ้านครบเหมือนร้านนี้ทุกอย่าง — จ่ายจากเครดิตร้านนี้ (<a href="/account/topup" class="underline">เติมเงิน</a> ถ้ายังไม่พอ)</p>
  </div>
</body>
</html>
