<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-[#1a160d] border border-[#3a3220] rounded-2xl p-6">
    <div class="text-center mb-5">
      <div class="text-3xl mb-2">🏪</div>
      <h1 class="text-xl font-bold">เปิดร้านของคุณเอง</h1>
      <p class="text-sm text-[#a89a6c] mt-1">ได้ร้านทันที ไม่ต้องสมัคร Railway ไม่ต้องมี GitHub</p>
    </div>

    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>

    <% if (!domainReady) { %>
      <div class="bg-amber-900/30 border border-amber-600/50 text-amber-300 rounded-lg px-4 py-3 text-sm text-center">
        ⚠️ ระบบเปิดร้านยังไม่พร้อมใช้งาน (ต้องตั้งค่า MAIN_DOMAIN + DNS ก่อน)
      </div>
    <% } else { %>
      <form action="/start" method="post" class="space-y-3">
        <div>
          <label class="block text-xs mb-1 text-[#a89a6c]">ชื่อของคุณ</label>
          <input name="name" required placeholder="ชื่อของคุณ" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs mb-1 text-[#a89a6c]">ชื่อร้านค้า</label>
          <input name="shopName" required placeholder="เช่น My Game Shop" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
          <p class="text-[10px] text-[#5a5133] mt-1">ร้านของคุณจะอยู่ที่ ชื่อร้าน.<%= mainDomain %></p>
        </div>
        <div>
          <label class="block text-xs mb-1 text-[#a89a6c]">อีเมล</label>
          <input name="email" type="email" required placeholder="you@example.com" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs mb-1 text-[#a89a6c]">รหัสผ่าน (อย่างน้อย 8 ตัว)</label>
          <input name="password" type="password" required minlength="8" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm" />
        </div>
        <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-2.5 text-sm mt-2">🚀 เปิดร้านตอนนี้</button>
      </form>
    <% } %>
    <p class="text-[10px] text-[#5a5133] text-center mt-4">ร้านที่เปิดจะได้ระบบสินค้า/สต๊อก/ออเดอร์/หลังบ้านครบเหมือนร้านนี้ทุกอย่าง</p>
  </div>
</body>
</html>
