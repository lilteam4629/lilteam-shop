<%
  // Route views historically emitted stylesheets at the top of <body>.
  // Promote them into <head> so route-specific CSS is ready before first paint.
  const routeStylesheetPattern = /<link\b(?=[^>]*\brel\s*=\s*(?:"stylesheet"|'stylesheet'))[^>]*\/?\s*>/gi;
  const routeStylesheets = [];
  const pageBody = typeof body === 'string'
    ? body.replace(routeStylesheetPattern, (tag) => {
      routeStylesheets.push(tag.replace(/\/?\s*>$/, (end) => ` data-route-stylesheet${end}`));
      return '';
    })
    : body;
  const routeStylesheetMarkup = routeStylesheets.join('\n');
%>
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | ' + settings.shopName : settings.shopName %></title>
  <% if (settings.branding && settings.branding.logoImage) { %>
    <link rel="icon" href="<%= settings.branding.logoImage %>" />
  <% } %>
  <%
    // Open Graph tags — what Facebook/LINE/Discord show when someone shares
    // a link to this page. A page can override any of these (e.g. a
    // product page passes its own ogTitle/ogDescription/ogImage); anything
    // not overridden falls back to the shop's own info so every page still
    // gets a reasonable preview card even without per-page tags.
    const ogTitleVal = typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' ? title + ' | ' + settings.shopName : settings.shopName);
    const ogDescriptionVal = typeof ogDescription !== 'undefined' ? ogDescription : (settings.tagline || settings.shopName);
    const ogImageVal = typeof ogImage !== 'undefined' ? ogImage : (settings.branding && settings.branding.logoImage ? settings.branding.logoImage : null);
    const ogUrlVal = typeof ogUrl !== 'undefined' ? ogUrl : `${typeof currentRequestUrl !== 'undefined' ? currentRequestUrl : ''}`;
  %>
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>" />
  <meta property="og:site_name" content="<%= settings.shopName %>" />
  <meta property="og:title" content="<%= ogTitleVal %>" />
  <meta property="og:description" content="<%= ogDescriptionVal %>" />
  <% if (ogUrlVal) { %><meta property="og:url" content="<%= ogUrlVal %>" /><% } %>
  <% if (ogImageVal) { %><meta property="og:image" content="<%= ogImageVal %>" /><% } %>
  <meta name="twitter:card" content="<%= ogImageVal ? 'summary_large_image' : 'summary' %>" />
  <meta name="twitter:title" content="<%= ogTitleVal %>" />
  <meta name="twitter:description" content="<%= ogDescriptionVal %>" />
  <% if (ogImageVal) { %><meta name="twitter:image" content="<%= ogImageVal %>" /><% } %>
  <% const storefrontBackground = settings.storefrontAppearance && settings.storefrontAppearance.backgroundImage; %>
  <script>
    (function () {
      try {
        if (localStorage.getItem('lilteam_theme') === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="<%= asset('css/tailwind.generated.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/theme-contrast-v1.css') %>" />
  <% if (settings.storefrontModel === 'line-rangers') { %><link rel="stylesheet" href="<%= asset('css/storefront-line-rangers-v1.css') %>" /><% } %>
  <% if (settings.storefrontModel === 'rangers-market' || (typeof publicPreview !== 'undefined' && publicPreview)) { %><link rel="stylesheet" href="<%= asset('css/storefront-rangers-market-v1.css') %>" /><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof isUnifiedStorefront !== 'undefined' && isUnifiedStorefront) { %>
    <% if (typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7) { %>
      <link rel="stylesheet" href="<%= asset('css/storefront-pre-home-v1.css') %>" />
    <% } else { %>
      <link rel="stylesheet" href="<%= asset('css/storefront-pre-unified-v1.css') %>" />
    <% } %>
  <% } else { %>
    <link rel="stylesheet" href="<%= asset('css/storefront-navbar-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-home-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-mobile-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-catalog-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-auth-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/scroll-motion-v1.css') %>" />
  <% } %>
  <% if (typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7) { %>  <style id="storefront-home-critical-fallback">
    /* Bound the home layout before a mobile WebView restores its cached theme layers. */
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-grid,
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .store-product-gallery .product-grid,
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .all-products-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-card { display:block; min-width:0; overflow:hidden; border:1px solid var(--border); border-radius:14px; background:var(--card); color:var(--text); text-decoration:none; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-image { display:block; width:100%; overflow:hidden; line-height:0; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-image img { display:block; width:100%; height:auto; max-width:100%; object-fit:contain; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-orders-shell { overflow:hidden; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-orders-track,
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-orders-group { display:flex; width:max-content; gap:10px; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-order-card { display:flex; width:258px; min-height:96px; flex:0 0 258px; align-items:center; gap:9px; overflow:hidden; padding:10px; border:1px solid var(--border); border-radius:14px; background:var(--card); color:var(--text); text-decoration:none; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-order-image-wrap { display:grid; width:54px; height:60px; flex:0 0 54px; place-items:center; overflow:hidden; border-radius:9px; background:var(--input); }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-order-image { display:block; width:100%; height:100%; object-fit:contain; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-order-arrow { display:block; width:20px; height:20px; flex:0 0 20px; margin-left:auto; }
    #site-page-shell.storefront-owner-home-v7 #latest-orders .latest-order-meta svg { width:12px; height:12px; flex:none; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-product-card { display:flex; min-width:0; flex-direction:column; overflow:hidden; border:1px solid var(--border); border-radius:16px; background:var(--card); color:var(--text); text-decoration:none; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-media { position:relative; display:grid; width:100%; aspect-ratio:16/9; place-items:center; overflow:hidden; background:#151515; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-media>img { display:block; width:100%; height:100%; object-fit:contain; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-details { display:flex; min-width:0; flex-direction:column; gap:6px; padding:10px; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-title-row,
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-purchase-row { display:flex; min-width:0; align-items:center; justify-content:space-between; gap:8px; }
    #site-page-shell.storefront-owner-home-v7 .owner-home-v21-name { min-width:0; overflow:hidden; text-overflow:ellipsis; }
    @media (min-width:640px) {
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-grid,
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .store-product-gallery .product-grid,
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .all-products-grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    }
    @media (min-width:1024px) {
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .store-product-gallery .product-grid,
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .all-products-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
    }
    @media (min-width:1280px) {
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .store-product-gallery .product-grid,
      #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .all-products-grid { grid-template-columns:repeat(5,minmax(0,1fr)); }
    }
    @media (max-width:639px) { #site-page-shell.storefront-owner-home-v7 .owner-home-v20-main .home-category-grid { grid-template-columns:1fr; } }
  </style>
  <% } %>
  <style>
    <%- typeof themeCss !== 'undefined' ? themeCss : '' %>

    <% if (storefrontBackground) { %>
    /* Keep the configured storefront artwork on every page, not only the
       homepage shell. This prevents it disappearing during refresh or
       seamless navigation to products, help, contact, and account pages. */
    body.storefront-global-background {
      background-color: var(--bg) !important;
      background-image: url('<%= storefrontBackground %>') !important;
      background-repeat: no-repeat !important;
      background-position: center 64px !important;
      background-size: 100vw auto !important;
      background-attachment: fixed !important;
      background-blend-mode: normal !important;
    }
    @media (max-width: 900px) {
      body.storefront-global-background {
        background-attachment: scroll !important;
        background-image: none !important;
      }
    }
    <% } %>

    html.theme-switching, html.theme-switching *:not(.rail-track):not(.mg-box):not(.mg-card):not(.rail-center):not(.rail-pointer):not(.mg-confetti-piece) {
      transition: none !important;
      animation: none !important;
    }

    html.light .mobile-quick-card {
      background: linear-gradient(145deg, var(--card), var(--input)) !important;
      border-color: var(--border-light) !important;
      box-shadow: 0 7px 20px rgba(0, 0, 0, .1), inset 0 1px 0 rgba(255, 255, 255, .6) !important;
    }
    html.light .mobile-quick-card--topup {
      background: linear-gradient(145deg, var(--card), color-mix(in srgb, var(--gold) 20%, var(--input))) !important;
      border-color: color-mix(in srgb, var(--gold) 55%, var(--border-light)) !important;
    }
    html.light .mobile-quick-title { color: var(--gold-hover) !important; }
    html.light .mobile-quick-subtitle { color: var(--text-4) !important; }
    html.light .mobile-quick-icon--contact {
      color: var(--text-2) !important;
      background: color-mix(in srgb, var(--text) 8%, transparent) !important;
      border-color: color-mix(in srgb, var(--text) 18%, transparent) !important;
    }
    body { font-family: 'Kanit', sans-serif; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: #4a4028; border-radius: 4px; }

    @keyframes marquee-scroll {
      from { transform: translateX(100%); }
      to { transform: translateX(-100%); }
    }
    .marquee-track {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      white-space: nowrap;
      animation: marquee-scroll 22s linear infinite;
    }
    .marquee-track:hover { animation-play-state: paused; }

    @keyframes product-shimmer {
      0%, 58% { transform: translateX(-170%) skewX(-18deg); opacity: 0; }
      66% { opacity: .75; }
      84%, 100% { transform: translateX(230%) skewX(-18deg); opacity: 0; }
    }
    @keyframes ready-pulse {
      0%, 100% { box-shadow: 0 0 8px rgba(52, 211, 153, .32), inset 0 0 8px rgba(52, 211, 153, .08); }
      50% { box-shadow: 0 0 17px rgba(52, 211, 153, .62), inset 0 0 12px rgba(52, 211, 153, .16); }
    }
    .premium-product-card {
      box-shadow: 0 9px 28px rgba(0, 0, 0, .5), 0 0 0 1px rgba(216, 183, 82, .12), 0 0 18px rgba(200, 166, 63, .09);
    }
    .premium-product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 38px rgba(0, 0, 0, .58), 0 0 0 1px rgba(244, 210, 105, .48), 0 0 28px rgba(218, 181, 67, .28);
    }
    .product-shimmer { animation: product-shimmer 4.8s ease-in-out infinite; }
    .ready-glow { animation: ready-pulse 2.2s ease-in-out infinite; }
    .premium-product-card .ready-glow { animation-play-state: paused; }
    .premium-product-card.perf-visible .ready-glow { animation-play-state: running; }
    .hud-bar .hud-bar-glow, .hud-bar .hud-bar-scan::before, .mg-panel .mg-sparkle { animation-play-state: paused !important; }
    .hud-bar.perf-visible .hud-bar-glow, .hud-bar.perf-visible .hud-bar-scan::before, .mg-panel.perf-visible .mg-sparkle { animation-play-state: running !important; }
    .flash-corner-tag { clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%); }
    @media (prefers-reduced-motion: reduce) {
      .product-shimmer, .ready-glow { animation: none; }
      .premium-product-card:hover { transform: none; }
    }

    /* Shown while a link/form navigation is in flight (see the SPA-style
       navigation script below) so a tap always gets visible feedback
       instead of looking like nothing happened. */
    #page-loading-overlay {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      background: color-mix(in srgb, var(--bg) 75%, transparent);
      backdrop-filter: blur(3px);
      opacity: 0; visibility: hidden; pointer-events: none;
      transition: opacity .15s ease;
    }
    html.lilteam-navigating #page-loading-overlay {
      opacity: 1; visibility: visible; pointer-events: auto;
      transition: opacity .15s ease .15s;
    }
    #page-loading-overlay .loading-ring {
      position: relative; width: 92px; height: 92px; padding: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    #page-loading-overlay .loading-ring::before {
      content: ''; position: absolute; inset: 0;
      border-radius: 9999px;
      border: 3px solid color-mix(in srgb, var(--gold) 25%, transparent);
      border-top-color:var(--gold);
      animation: page-loading-spin .8s linear infinite;
    }
    #page-loading-overlay .loading-logo {
      max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    }
    #page-loading-overlay .loading-logo-fallback {
      width: 44px; height: 44px; border-radius: 9999px;
      background: var(--gold); color: var(--gold-contrast);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 18px;
    }
    @keyframes page-loading-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      #page-loading-overlay .loading-ring::before { animation-duration: 1.6s; }
    }
  </style>
  <% if (typeof isUnifiedStorefront !== 'undefined' && isUnifiedStorefront) { %>
    <% if (typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7) { %>
      <link rel="stylesheet" href="<%= asset('css/storefront-post-home-v1.css') %>" />
    <% } else { %>
      <link rel="stylesheet" href="<%= asset('css/storefront-post-unified-v1.css') %>" />
    <% } %>
  <% } else { %>
    <link rel="stylesheet" href="<%= asset('css/storefront-navbar-cozy-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-navbar-cozy-v2.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-mobile-header-cozy-shared-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-account-menu-cozy-v1.css') %>" />
    <% if (typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7) { %>
      <link rel="stylesheet" href="<%= asset('css/storefront-home-cozy-v1.css') %>" />
      <link rel="stylesheet" href="<%= asset('css/storefront-home-hero-cozy-v1.css') %>" />
    <% } %>
    <link rel="stylesheet" href="<%= asset('css/storefront-product-artwork-full-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/storefront-home-section-spacing-v1.css') %>" />
  <% } %>
  <%- routeStylesheetMarkup %>
</head>
<body class="bg-[var(--bg)] text-[var(--text)] min-h-screen flex flex-col storefront-model-<%= (typeof publicPreview !== 'undefined' && publicPreview) ? 'rangers-market' : (settings.storefrontModel || 'classic') %><%= typeof isUnifiedStorefront !== 'undefined' && isUnifiedStorefront ? ' storefront-unified' : '' %><%= (typeof isMainSite !== 'undefined' && isMainSite) ? ' storefront-owner-lilteam' : '' %><%= typeof storefrontCustomerRefresh !== 'undefined' && storefrontCustomerRefresh ? ' storefront-customer-refresh' : '' %><%= typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7 ? ' storefront-owner-home-page' : '' %><%= storefrontBackground ? ' storefront-global-background' : '' %><%= typeof storefrontMonochrome !== 'undefined' && storefrontMonochrome ? ' storefront-monochrome' : '' %>">
  <div id="page-loading-overlay" aria-hidden="true">
    <div class="loading-ring">
      <% if (settings.branding && settings.branding.logoImage) { %>
        <img src="<%= settings.branding.logoImage %>" alt="" width="72" height="72" class="loading-logo" />
      <% } else { %>
        <span class="loading-logo-fallback">L</span>
      <% } %>
    </div>
  </div>
  <div class="min-h-screen flex flex-col">
  <%- include('../partials/navbar') %>

  <% const isAuthPage = /\/(login|register)(?:[/?#]|$)/.test(typeof currentRequestUrl === 'string' ? currentRequestUrl : ''); %>
  <main id="site-page-shell" data-seamless-navigation="true" class="relative flex-1<%= typeof storefrontOwnerHomeV7 !== 'undefined' && storefrontOwnerHomeV7 ? ' storefront-owner-home-v7' : '' %>">
    <% if (messages.success && messages.success.length) { %>
      <div class="<%= isAuthPage ? 'absolute inset-x-0 top-0 z-40' : '' %> w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.success.forEach(m => { %>
          <div class="bg-emerald-900/40 border border-emerald-700 text-emerald-300 px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <% if (messages.error && messages.error.length) { %>
      <div class="<%= isAuthPage ? 'absolute inset-x-0 top-0 z-40' : '' %> w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.error.forEach(m => { %>
          <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/50 text-[var(--coral)] px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <%- pageBody %>
  </main>

  <%- include('../partials/footer') %>
  </div>

  <%- include('../partials/cookie-consent') %>

  <% if (storefrontBackground) { %>
  <!--
    Model templates can add their own body/shell backgrounds after this
    layout is rendered. Keep the merchant's uploaded storefront artwork as
    the final cascade winner without changing model-specific styling when no
    artwork is configured.
  -->
  <style id="storefront-background-override">
    body.storefront-global-background {
      background-color: var(--bg) !important;
      background-image: url('<%= storefrontBackground %>') !important;
      background-repeat: no-repeat !important;
      background-position: center 64px !important;
      background-size: 100vw auto !important;
      background-attachment: fixed !important;
      background-blend-mode: normal !important;
    }
    /* The owner-home theme paints an opaque gradient on the page shell.
       Clear that layer whenever a merchant background exists so the saved
       image is visible behind the entire storefront on desktop and mobile. */
    body.storefront-global-background #site-page-shell,
    body.storefront-global-background #site-page-shell.storefront-owner-home-v7 {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    #site-page-shell.storefront-owner-home-v7 {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    /* The current v20 home layout uses :has() to repaint an opaque page
       surface. Match that selector's specificity so the store wallpaper can
       actually show through, and set the longhand explicitly. */
    body.storefront-global-background #site-page-shell.storefront-owner-home-v7:has(.owner-home-v20-shell) {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    @media (max-width: 900px) {
      body.storefront-global-background {
        background-attachment: scroll !important;
        background-image: none !important;
      }
    }
  </style>
  <% } %>

  <% if (typeof storefrontMonochrome !== 'undefined' && storefrontMonochrome) { %>
  <!-- Legacy model styles may contain literal brand colours. This final
       storefront layer keeps the customer UI black/white after page content,
       route stylesheets, and model-specific inline styles have been emitted. -->
  <style id="storefront-monochrome-override">
    body.storefront-monochrome {
      --rm-navy:#000000; --rm-blue:#000000; --rm-lime:#ffffff;
      --rm-ink:#ffffff; --rm-paper:#ffffff; --rm-line:#d9d9d9;
      --coral:var(--text-2); --success:var(--text-2); --danger:var(--text-2); --warning:var(--text-2);
      background-color:var(--bg) !important; color:var(--text) !important;
    }
    body.storefront-monochrome #site-page-shell { background-color:transparent !important; }
    body.storefront-monochrome .storefront-model-rangers-market,
    body.storefront-monochrome.storefront-model-rangers-market { background:#000000 !important; color:#ffffff !important; }
    body.storefront-monochrome .storefront-model-rangers-market #site-page-shell,
    body.storefront-monochrome.storefront-model-rangers-market #site-page-shell { background:#000000 !important; }
    body.storefront-monochrome .rm-match,
    body.storefront-monochrome .rm-hero,
    body.storefront-monochrome .rm-finder,
    body.storefront-monochrome .rm-results,
    body.storefront-monochrome .rm-ranger-vault { background:#000000 !important; color:#ffffff !important; border-color:#3a3a3a !important; box-shadow:none !important; }
    body.storefront-monochrome .rm-match,
    body.storefront-monochrome .rm-hero { background:#000000 !important; }
    body.storefront-monochrome .rm-lineup article,
    body.storefront-monochrome .rm-vault-grid article { background:#ffffff !important; color:#000000 !important; box-shadow:none !important; }
    body.storefront-monochrome .rm-controls input,
    body.storefront-monochrome .rm-controls select,
    body.storefront-monochrome .rm-controls button,
    body.storefront-monochrome .rm-vault-search input { background:#000000 !important; color:#ffffff !important; border-color:#505050 !important; }
    body.storefront-monochrome .rm-match>a,
    body.storefront-monochrome .rm-card-foot>a,
    body.storefront-monochrome .rm-vault-tabs .is-active,
    body.storefront-monochrome .rm-vault-more { background:#ffffff !important; color:#000000 !important; border-color:#ffffff !important; }
