  <script>
    (function () {
      const widget = document.getElementById('music-widget');
      if (!widget) return;
      const videoId = widget.dataset.videoId;
      const toggleBtn = document.getElementById('music-toggle-btn');
      const settingsBtn = document.getElementById('music-settings-btn');
      const panel = document.getElementById('music-panel');
      const collapseBtn = document.getElementById('music-collapse-btn');
      const playBtn = document.getElementById('music-play-btn');
      const volumeSlider = document.getElementById('music-volume');
      const icon = document.getElementById('music-icon');
      const playingRing = document.getElementById('music-playing-ring');
      const titleEl = document.getElementById('music-title');
      const musicStateLabel = document.getElementById('music-state-label');
      const musicRestoreStateLabel = document.getElementById('music-restore-state-label');
      const musicRestoreTitle = document.getElementById('music-restore-title');
      const collapsedTitleEl = document.getElementById('music-collapsed-title');
      const collapsedStateEl = document.getElementById('music-collapsed-state');

      const STORAGE_PLAYING = 'lilteam_music_playing';
      const STORAGE_VOLUME = 'lilteam_music_volume';
      // Resume independently per configured track; a new song must never
      // inherit the previous song's playhead.
      const STORAGE_TIME = 'lilteam_music_time_' + videoId;

      // Privacy modes and embedded browsers can deny persistent storage. Keep
      // playback usable for the current page even when preferences cannot save.
      function storageGet(key) {
        try { return window.localStorage.getItem(key); } catch (e) { return null; }
      }
      function storageSet(key, value) {
        try { window.localStorage.setItem(key, String(value)); } catch (e) {}
      }

      let player = null;
      let apiRequested = false;
      let playerInitialized = false;
      let isPlaying = false;
      let playbackPending = false;
      let segmentTimer = null;
      let recoveryTimer = null;
      const startSeconds = parseInt(widget.dataset.startSeconds, 10) || 0;
      const endSeconds = parseInt(widget.dataset.endSeconds, 10) || 0;

      function loadYouTubeApi() {
        if (playerInitialized) return;
        if (window.YT && typeof window.YT.Player === 'function') {
          initializePlayer();
          return;
        }
        if (apiRequested) return;
        apiRequested = true;
        if (playbackWanted) setPlaybackPending(true);
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        script.async = true;
        script.onerror = function () {
          apiRequested = false;
          playbackPending = false;
          script.remove();
          setPlayingUI(false);
          setPlaybackMessage('โหลดเพลงไม่สำเร็จ แตะเพื่อลองใหม่');
        };
        document.head.appendChild(script);
      }

      const savedVolume = parseInt(storageGet(STORAGE_VOLUME), 10);
      const defaultVolume = parseInt(widget.dataset.defaultVolume, 10);
      const initialVolume = Math.max(0, Math.min(100,
        Number.isFinite(savedVolume) ? savedVolume : (Number.isFinite(defaultVolume) ? defaultVolume : 50)));
      let currentVolume = initialVolume;
      volumeSlider.value = initialVolume;
      // Clean up the old registration autoplay hint if present (superseded by default-on below).
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('music')) {
        urlParams.delete('music');
        const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '') + window.location.hash;
        window.history.replaceState({}, '', cleanUrl);
      }

      // Music plays by default on every visit — the ONLY thing that turns this off is the
      // visitor explicitly clicking the pause button (see playBtn handler below). Incidental
      // browser-triggered pauses (autoplay policy, tab backgrounding, bfcache, etc.) must
      // never write to this flag, or autoplay silently breaks itself on the next page.
      let playbackWanted = storageGet(STORAGE_PLAYING) !== 'false';
      let resumeAt = startSeconds;
      const savedTime = parseFloat(storageGet(STORAGE_TIME));
      if (!Number.isNaN(savedTime) && savedTime >= 0 && playbackWanted) {
        // Resume the exact heard position. Adding time spent away from the site
        // made the track jump unpredictably after refresh/back navigation.
        resumeAt = savedTime;
        if (endSeconds > startSeconds && resumeAt >= endSeconds) {
          resumeAt = startSeconds + ((resumeAt - startSeconds) % (endSeconds - startSeconds));
        }
      }

      function setPlayingUI(playing) {
        isPlaying = playing;
        const actionLabel = playing ? 'หยุดเพลง' : (playbackPending ? 'ยกเลิกการเปิดเพลง' : 'เล่นเพลง');
        toggleBtn.setAttribute('aria-label', actionLabel);
        toggleBtn.title = actionLabel;
        playBtn.textContent = playing ? '⏸' : '▶';
        playBtn.setAttribute('aria-label', actionLabel);
        playBtn.title = actionLabel;
        widget.dataset.playing = String(playing);
        if (collapsedStateEl) collapsedStateEl.textContent = playing ? 'กำลังเล่นเพลง' : (playbackPending ? 'กำลังโหลดเพลง…' : 'แตะเพื่อเล่นเพลง');
        if (icon) {
          if (icon.querySelector('svg')) icon.classList.toggle('is-playing', playing);
          else icon.textContent = playing ? '🎶' : '🎵';
        }
        if (musicStateLabel) musicStateLabel.textContent = playing ? 'กำลังเล่น' : 'แตะเพื่อเล่น';
        if (musicRestoreStateLabel) musicRestoreStateLabel.textContent = playing ? 'กำลังเล่น' : 'แตะเพื่อเปิด';
        widget.classList.toggle('is-playing', playing);
        playingRing.classList.toggle('hidden', !playing);
      }

      function setPlaybackMessage(message) {
        if (collapsedStateEl) collapsedStateEl.textContent = message;
        if (musicStateLabel) musicStateLabel.textContent = message;
        if (musicRestoreStateLabel) musicRestoreStateLabel.textContent = message;
      }

      function setPlaybackPending(pending) {
        playbackPending = Boolean(pending);
        if (!isPlaying) setPlayingUI(false);
      }

      function setPanelOpen(open) {
        if (!panel || !settingsBtn) return;
        panel.classList.toggle('hidden', !open);
        const label = open ? 'ปิดแผงควบคุมเพลง' : 'เปิดแผงควบคุมเพลง';
        settingsBtn.setAttribute('aria-expanded', String(open));
        settingsBtn.setAttribute('aria-label', label);
        settingsBtn.title = label;
      }

      function recoverPlayback(delay) {
        if (!playbackWanted || document.hidden || !player || typeof player.playVideo !== 'function') return;
        if (recoveryTimer) clearTimeout(recoveryTimer);
        recoveryTimer = setTimeout(function () {
          recoveryTimer = null;
          if (playbackWanted && !document.hidden && player && player.playVideo) {
            setPlaybackPending(true);
            player.playVideo();
          }
        }, delay || 700);
      }

      // Keep the user's intent independently from YouTube's delayed state events.
      // This also makes taps made while the iframe is still loading take effect on ready.
      function requestPlayback(wanted) {
        playbackWanted = wanted;
        storageSet(STORAGE_PLAYING, wanted ? 'true' : 'false');
        if (!player || typeof player.playVideo !== 'function') {
          setPlaybackPending(wanted);
          if (wanted) loadYouTubeApi();
          setPlayingUI(false);
          return;
        }
        if (wanted) {
          setPlaybackPending(true);
          player.unMute();
          player.playVideo();
        } else {
          playbackPending = false;
          if (recoveryTimer) clearTimeout(recoveryTimer);
          player.pauseVideo();
          setPlayingUI(false);
        }
      }

      function watchSegment() {
        if (segmentTimer) clearInterval(segmentTimer);
        segmentTimer = setInterval(function () {
          if (!player || typeof player.getCurrentTime !== 'function') return;
          const t = player.getCurrentTime();
          let resumeTime = t;
          if (endSeconds > startSeconds && t >= endSeconds) {
            player.seekTo(startSeconds, true);
            resumeTime = startSeconds;
          }
          storageSet(STORAGE_TIME, resumeTime);
        }, 1500);
      }

      function initializePlayer() {
        const youtubeApi = window.YT || (typeof YT !== 'undefined' ? YT : null);
        if (playerInitialized || !youtubeApi || typeof youtubeApi.Player !== 'function') return;
        playerInitialized = true;
        player = new youtubeApi.Player('music-yt-player', {
          videoId: videoId,
          playerVars: {
            autoplay: 0,
            mute: 0,
            controls: 0,
            loop: 1,
            playlist: videoId,
            start: Math.max(0, Math.floor(resumeAt)),
            playsinline: 1,
            origin: window.location.origin,
          },
          events: {
            onReady: function (e) {
              e.target.setVolume(currentVolume);
              if (playbackWanted) {
                setPlaybackPending(true);
                e.target.unMute();
                e.target.playVideo();
              }
            },
            onStateChange: function (e) {
              if (e.data === youtubeApi.PlayerState.PLAYING) {
                playbackPending = false;
                setPlayingUI(true);
                watchSegment();
              } else if (e.data === youtubeApi.PlayerState.BUFFERING) {
                playbackPending = playbackWanted;
                setPlayingUI(false);
              } else if (e.data === youtubeApi.PlayerState.PAUSED || e.data === youtubeApi.PlayerState.ENDED) {
                playbackPending = false;
                setPlayingUI(false);
                if (segmentTimer) clearInterval(segmentTimer);
                if (e.data === youtubeApi.PlayerState.ENDED && playbackWanted) {
                  setPlaybackPending(true);
                  storageSet(STORAGE_TIME, startSeconds);
                  player.seekTo(startSeconds, true);
                  player.playVideo();
                } else if (e.data === youtubeApi.PlayerState.PAUSED && playbackWanted) {
                  recoverPlayback(900);
                }
              }
            },
            onError: function () {
              // Invalid, private, or restricted videos should show a useful
              // state instead of appearing to silently pause.
              playbackWanted = false;
              playbackPending = false;
              storageSet(STORAGE_PLAYING, 'false');
              setPlayingUI(false);
              setPlaybackMessage('เปิดเพลงนี้ไม่ได้ ลองตรวจลิงก์ YouTube');
            },
            onAutoplayBlocked: function () {
              // YouTube reports browser autoplay policy separately from player
              // errors. A user tap can then retry with a direct interaction.
              playbackPending = false;
              setPlayingUI(false);
              setPlaybackMessage('เบราว์เซอร์บล็อกเพลง แตะเพื่อเล่น');
            },
          },
        });
      }

      const previousYouTubeReady = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function () {
        if (typeof previousYouTubeReady === 'function' && previousYouTubeReady !== window.onYouTubeIframeAPIReady) {
          try { previousYouTubeReady.call(window); } catch (e) {}
        }
        initializePlayer();
      };
      // The API may already be available after a cached shell or another embed.
      if (window.YT && typeof window.YT.Player === 'function') initializePlayer();

      if ('requestIdleCallback' in window) requestIdleCallback(loadYouTubeApi, { timeout: 3500 });
      else setTimeout(loadYouTubeApi, 1800);

      fetch('https://noembed.com/embed?url=' + encodeURIComponent('https://www.youtube.com/watch?v=' + videoId))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.title) {
            titleEl.textContent = data.title;
            if (collapsedTitleEl) collapsedTitleEl.textContent = data.title;
            if (musicRestoreTitle) musicRestoreTitle.textContent = data.title;
          }
        })
        .catch(function () {});

      toggleBtn.addEventListener('click', function () {
        requestPlayback(!(isPlaying || playbackPending));
      });
      if (settingsBtn) {
        settingsBtn.addEventListener('click', function () {
          setPanelOpen(panel.classList.contains('hidden'));
        });
      }
      collapseBtn.addEventListener('click', function () {
        setPanelOpen(false);
      });
      document.addEventListener('click', function (e) {
        if (!widget.contains(e.target)) setPanelOpen(false);
      });

      playBtn.addEventListener('click', function () {
        requestPlayback(!(isPlaying || playbackPending));
      });

      volumeSlider.addEventListener('input', function () {
        const v = parseInt(volumeSlider.value, 10);
        currentVolume = Math.max(0, Math.min(100, Number.isFinite(v) ? v : initialVolume));
        if (player) player.setVolume(currentVolume);
        storageSet(STORAGE_VOLUME, currentVolume);
      });

      window.addEventListener('beforeunload', function () {
        if (player && typeof player.getCurrentTime === 'function') {
          storageSet(STORAGE_TIME, player.getCurrentTime());
        }
      });

      // A bfcache restore keeps the existing player. Never reload here: reloading would
      // destroy the player and is exactly what makes back/forward playback jump around.
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) recoverPlayback(100);
      });
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) recoverPlayback(180);
      });
      window.addEventListener('online', function () { recoverPlayback(300); });
    })();
  </script>
  <% } %>

  <% if (typeof settings !== 'undefined' && settings.snow && settings.snow.enabled) { %>
  <div id="snow-container" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index: -1;"></div>
  <style>
    .snowflake {
      position: absolute;
      top: -5vh;
      color: #fff;
      text-shadow: 0 0 4px rgba(255,255,255,0.6);
      user-select: none;
      will-change: transform;
      animation-name: snow-fall;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    @keyframes snow-fall {
      0% { transform: translate3d(0,-5vh,0) rotate(0deg); }
      50% { transform: translate3d(18px,50vh,0) rotate(90deg); }
      100% { transform: translate3d(-10px,105vh,0) rotate(180deg); }
    }
  </style>
  <script>
    (function () {
      const container = document.getElementById('snow-container');
      if (!container) return;
      const count = window.innerWidth < 768 ? 3 : 14;
      for (let i = 0; i < count; i++) {
        const flake = document.createElement('span');
        flake.className = 'snowflake';
        flake.textContent = '❄';
        flake.style.left = Math.random() * 100 + 'vw';
        flake.style.fontSize = (8 + Math.random() * 14) + 'px';
        flake.style.opacity = 0.35 + Math.random() * 0.55;
        const fallDuration = 8 + Math.random() * 10;
        flake.style.animationDuration = fallDuration + 's';
        flake.style.animationDelay = (-Math.random() * fallDuration) + 's';
        container.appendChild(flake);
      }
    })();
  </script>
  <% } %>
  <% if (typeof settings !== 'undefined' && settings.systemModules && settings.systemModules.rain && settings.rain && settings.rain.enabled) { const rain = settings.rain; %>
  <canvas id="store-rain" aria-hidden="true" style="display:block;position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:20;background:transparent;contain:layout paint size"></canvas>
  <script>
    (function(){
      const canvas=document.getElementById('store-rain'); if(!canvas||!canvas.getContext)return;
      const ctx=canvas.getContext('2d',{alpha:true});if(!ctx){canvas.remove();return}
      const color=<%- JSON.stringify(/^#[0-9a-fA-F]{6}$/.test(rain.color||'')?rain.color:'#78c8ff') %>;
      const level=<%- JSON.stringify(['light','medium','heavy'].includes(rain.intensity)?rain.intensity:'medium') %>;
      const coarse=matchMedia('(max-width:900px), (pointer:coarse)').matches;
      const reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
      const limits={light:coarse?14:30,medium:coarse?24:52,heavy:coarse?34:72};
      let drops=[],frame=0,last=0,w=0,h=0,dpr=1,running=true;
      function reset(drop,randomY){const depth=.22+Math.random()*.78;drop.bucket=Math.min(2,Math.floor(depth*3));drop.x=-20+Math.random()*(w+40);drop.y=randomY?Math.random()*h:-35-Math.random()*90;drop.len=(7+Math.random()*11)*(.72+depth*.45);drop.speed=(430+Math.random()*300)*(.72+depth*.38);drop.wind=-12+Math.random()*30;drop.slant=(drop.wind/drop.speed)*drop.len+(-.55+Math.random()*1.1);return drop}
      function resize(force){const nextW=innerWidth,nextH=innerHeight;if(!force&&coarse&&w&&Math.abs(nextW-w)<2)return;dpr=Math.min(devicePixelRatio||1,coarse?1:1.25);w=nextW;h=nextH;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);const areaScale=coarse?1:Math.min(1,Math.max(.55,(w*h)/(1440*900)));const count=reduced?Math.max(7,Math.round(limits[level]*.4)):Math.max(9,Math.round(limits[level]*areaScale));drops=Array.from({length:count},()=>reset({},true))}
      function rainPath(bucket){ctx.beginPath();for(const d of drops){if(d.bucket!==bucket)continue;ctx.moveTo(d.x,d.y);ctx.lineTo(d.x+d.slant+(d.wind*.025),d.y+d.len)}}
      function draw(now){
        frame=0;
        if(document.hidden||!running)return;
        // Keep rainfall continuous during touch and momentum scrolling. Mobile
        // performance is controlled by the lower DPR/drop count above, rather
        // than freezing the animation whenever the page moves.
        // Allow a modest catch-up after a dropped frame so desktop rain keeps
        // its natural velocity instead of appearing frozen under scroll load.
        const elapsed=last?Math.min(.08,Math.max(.001,(now-last)/1000)):.016;last=now;ctx.clearRect(0,0,w,h);ctx.strokeStyle=color;ctx.lineCap='round';
        for(let bucket=0;bucket<3;bucket++){rainPath(bucket);ctx.globalAlpha=.2+(bucket*.13);ctx.lineWidth=.55+(bucket*.32);ctx.stroke()}
        for(const d of drops){d.x+=d.wind*elapsed;d.y+=d.speed*elapsed;if(d.y>h+35||d.x>w+35||d.x<-35)reset(d,false)}ctx.globalAlpha=1;
        frame=requestAnimationFrame(draw);
      }
      function start(){running=true;if(!frame){last=performance.now();frame=requestAnimationFrame(draw)}}
      function stop(){running=false;if(frame){cancelAnimationFrame(frame);frame=0}}
      let timer;addEventListener('resize',()=>{clearTimeout(timer);timer=setTimeout(()=>resize(false),180)},{passive:true});
      addEventListener('orientationchange',()=>{clearTimeout(timer);timer=setTimeout(()=>resize(true),220)},{passive:true});
      document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else start()});resize(true);start();
      addEventListener('pagehide',stop);
      addEventListener('pageshow',start);
    })();
  </script>
  <% } %>
<script>
  (function () {
    let performanceObserver = null;
    function observePerformanceTargets() {
      const mobileCoarse = window.matchMedia('(max-width: 900px) and (pointer: coarse)').matches;
      const animated = document.querySelectorAll(mobileCoarse
        ? '.banner-sparkle,.latest-orders-shell,.hud-bar,.mg-panel'
        : '.premium-product-card,.banner-sparkle,.latest-orders-shell,.hud-bar,.mg-panel');
      if (performanceObserver) performanceObserver.disconnect();
    if ('IntersectionObserver' in window) {
      performanceObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          entry.target.classList.toggle('perf-visible', entry.isIntersecting);
        });
      }, { rootMargin: '180px 0px', threshold: 0.01 });
      animated.forEach(function (element) { performanceObserver.observe(element); });
    } else {
      animated.forEach(function (element) { element.classList.add('perf-visible'); });
    }
    }
    observePerformanceTargets();
    document.addEventListener('lilteam:page-loaded', observePerformanceTargets);

    let clockTimer = null;
    function render() {
      const clocks = Array.from(document.querySelectorAll('.flash-countdown'));
      if (!clocks.length) return;
      const now = Date.now();
      let reloadNeeded = false;
      clocks.forEach(function (clock) {
        const target = Number(clock.dataset.flashEnd || clock.dataset.flashStart || 0);
        if (!Number.isFinite(target) || target <= 0) {
          clock.textContent = '--:--:--';
          return;
        }
        const remaining = Math.max(0, target - now);
        if (!remaining) reloadNeeded = true;
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const dayLabel = days ? days + (clock.dataset.flashCompact ? 'ว ' : 'วัน ') : '';
        clock.textContent = dayLabel + [hours, minutes, seconds].map(function (n) { return String(n).padStart(2, '0'); }).join(':');
      });
      if (reloadNeeded) window.location.reload();
    }
    function startClocks() {
      if (clockTimer) clearInterval(clockTimer);
      render();
      clockTimer = window.setInterval(render, 1000);
    }
    startClocks();
    document.addEventListener('lilteam:page-loaded', startClocks);
  })();
</script>
