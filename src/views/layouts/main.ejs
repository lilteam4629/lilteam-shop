        <button id="music-collapse-btn" type="button" aria-label="ปิดแผงควบคุมเพลง" title="ปิดแผงควบคุมเพลง" class="music-panel__close absolute top-2 right-2 w-7 h-7 rounded-full flex items-center justify-center">
