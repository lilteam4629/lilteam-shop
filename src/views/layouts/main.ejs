<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | ' + settings.shopName : settings.shopName %></title>
  <% if (settings.branding && settings.branding.logoImage) { %>
    <link rel="icon" href="<%= settings.branding.logoImage %>" />
  <% } %>
  <%
    // Open Graph tags — what Facebook/LINE/Discord show when someone shares
    // a link to this page. A page can override any of these (e.g. a
    // product page passes its own ogTitle/ogDescription/ogImage); anything
    // not overridden falls back to the shop's own info so every page still
    // gets a reasonable preview card even without per-page tags.
    const ogTitleVal = typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' ? title + ' | ' + settings.shopName : settings.shopName);
    const ogDescriptionVal = typeof ogDescription !== 'undefined' ? ogDescription : (settings.tagline || settings.shopName);
    const ogImageVal = typeof ogImage !== 'undefined' ? ogImage : (settings.branding && settings.branding.logoImage ? settings.branding.logoImage : null);
    const ogUrlVal = typeof ogUrl !== 'undefined' ? ogUrl : `${typeof currentRequestUrl !== 'undefined' ? currentRequestUrl : ''}`;
  %>
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>" />
  <meta property="og:site_name" content="<%= settings.shopName %>" />
  <meta property="og:title" content="<%= ogTitleVal %>" />
  <meta property="og:description" content="<%= ogDescriptionVal %>" />
  <% if (ogUrlVal) { %><meta property="og:url" content="<%= ogUrlVal %>" /><% } %>
  <% if (ogImageVal) { %><meta property="og:image" content="<%= ogImageVal %>" /><% } %>
  <meta name="twitter:card" content="<%= ogImageVal ? 'summary_large_image' : 'summary' %>" />
  <meta name="twitter:title" content="<%= ogTitleVal %>" />
  <meta name="twitter:description" content="<%= ogDescriptionVal %>" />
  <% if (ogImageVal) { %><meta name="twitter:image" content="<%= ogImageVal %>" /><% } %>
  <script>
    (function () {
      try {
        if (localStorage.getItem('lilteam_theme') === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="<%= asset('css/tailwind.generated.css') %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('css/storefront-navbar-v1.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/storefront-home-v1.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/storefront-mobile-v1.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/storefront-catalog-v1.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/storefront-auth-v1.css') %>" />
  <link rel="stylesheet" href="<%= asset('css/scroll-motion-v1.css') %>" />
  <style>
    <%- typeof themeCss !== 'undefined' ? themeCss : '' %>

    html.theme-switching, html.theme-switching *:not(.rail-track):not(.mg-box):not(.mg-card):not(.rail-center):not(.rail-pointer):not(.mg-confetti-piece) {
      transition: none !important;
      animation: none !important;
    }

    html.light .mobile-quick-card {
      background: linear-gradient(145deg, var(--card), var(--input)) !important;
      border-color: var(--border-light) !important;
      box-shadow: 0 7px 20px rgba(0, 0, 0, .1), inset 0 1px 0 rgba(255, 255, 255, .6) !important;
    }
    html.light .mobile-quick-card--topup {
      background: linear-gradient(145deg, var(--card), color-mix(in srgb, var(--gold) 20%, var(--input))) !important;
      border-color: color-mix(in srgb, var(--gold) 55%, var(--border-light)) !important;
    }
    html.light .mobile-quick-title { color: var(--gold-hover) !important; }
    html.light .mobile-quick-subtitle { color: var(--text-4) !important; }
    html.light .mobile-quick-icon--contact {
      color: var(--text-2) !important;
      background: color-mix(in srgb, var(--text) 8%, transparent) !important;
      border-color: color-mix(in srgb, var(--text) 18%, transparent) !important;
    }
    body { font-family: 'Kanit', sans-serif; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: #4a4028; border-radius: 4px; }

    @keyframes marquee-scroll {
      from { transform: translateX(100%); }
      to { transform: translateX(-100%); }
    }
    .marquee-track {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      white-space: nowrap;
      animation: marquee-scroll 22s linear infinite;
    }
    .marquee-track:hover { animation-play-state: paused; }

    @keyframes product-shimmer {
      0%, 58% { transform: translateX(-170%) skewX(-18deg); opacity: 0; }
      66% { opacity: .75; }
      84%, 100% { transform: translateX(230%) skewX(-18deg); opacity: 0; }
    }
    @keyframes ready-pulse {
      0%, 100% { box-shadow: 0 0 8px rgba(52, 211, 153, .32), inset 0 0 8px rgba(52, 211, 153, .08); }
      50% { box-shadow: 0 0 17px rgba(52, 211, 153, .62), inset 0 0 12px rgba(52, 211, 153, .16); }
    }
    .premium-product-card {
      box-shadow: 0 9px 28px rgba(0, 0, 0, .5), 0 0 0 1px rgba(216, 183, 82, .12), 0 0 18px rgba(200, 166, 63, .09);
    }
    .premium-product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 38px rgba(0, 0, 0, .58), 0 0 0 1px rgba(244, 210, 105, .48), 0 0 28px rgba(218, 181, 67, .28);
    }
    .product-shimmer { animation: product-shimmer 4.8s ease-in-out infinite; }
    .ready-glow { animation: ready-pulse 2.2s ease-in-out infinite; }
    .premium-product-card .ready-glow { animation-play-state: paused; }
    .premium-product-card.perf-visible .ready-glow { animation-play-state: running; }
    .hud-bar .hud-bar-glow, .hud-bar .hud-bar-scan::before, .mg-panel .mg-sparkle { animation-play-state: paused !important; }
    .hud-bar.perf-visible .hud-bar-glow, .hud-bar.perf-visible .hud-bar-scan::before, .mg-panel.perf-visible .mg-sparkle { animation-play-state: running !important; }
    .flash-corner-tag { clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%); }
    @media (prefers-reduced-motion: reduce) {
      .product-shimmer, .ready-glow { animation: none; }
      .premium-product-card:hover { transform: none; }
    }

    /* Shown while a link/form navigation is in flight (see the SPA-style
       navigation script below) so a tap always gets visible feedback
       instead of looking like nothing happened. */
    #page-loading-overlay {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      background: color-mix(in srgb, var(--bg) 75%, transparent);
      backdrop-filter: blur(3px);
      opacity: 0; visibility: hidden; pointer-events: none;
      transition: opacity .15s ease;
    }
    html.lilteam-navigating #page-loading-overlay {
      opacity: 1; visibility: visible; pointer-events: auto;
      transition: opacity .15s ease .15s;
    }
    #page-loading-overlay .loading-ring {
      position: relative; width: 92px; height: 92px; padding: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    #page-loading-overlay .loading-ring::before {
      content: ''; position: absolute; inset: 0;
      border-radius: 9999px;
      border: 3px solid color-mix(in srgb, var(--gold) 25%, transparent);
      border-top-color:var(--gold);
      animation: page-loading-spin .8s linear infinite;
    }
    #page-loading-overlay .loading-logo {
      max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    }
    #page-loading-overlay .loading-logo-fallback {
      width: 44px; height: 44px; border-radius: 9999px;
      background: var(--gold); color: var(--gold-contrast);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 18px;
    }
    @keyframes page-loading-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      #page-loading-overlay .loading-ring::before { animation-duration: 1.6s; }
    }
  </style>
</head>
<body class="bg-[var(--bg)] text-[var(--text)] min-h-screen flex flex-col">
  <div id="page-loading-overlay" aria-hidden="true">
    <div class="loading-ring">
      <% if (settings.branding && settings.branding.logoImage) { %>
        <img src="<%= settings.branding.logoImage %>" alt="" class="loading-logo" />
      <% } else { %>
        <span class="loading-logo-fallback">L</span>
      <% } %>
    </div>
  </div>
  <div class="min-h-screen flex flex-col">
  <%- include('../partials/navbar') %>

  <% const isAuthPage = /\/(login|register)(?:[/?#]|$)/.test(typeof currentRequestUrl === 'string' ? currentRequestUrl : ''); %>
  <main id="site-page-shell" data-seamless-navigation="true" class="relative flex-1">
    <% if (messages.success && messages.success.length) { %>
      <div class="<%= isAuthPage ? 'absolute inset-x-0 top-0 z-40' : '' %> w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.success.forEach(m => { %>
          <div class="bg-emerald-900/40 border border-emerald-700 text-emerald-300 px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <% if (messages.error && messages.error.length) { %>
      <div class="<%= isAuthPage ? 'absolute inset-x-0 top-0 z-40' : '' %> w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.error.forEach(m => { %>
          <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/50 text-[var(--coral)] px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>
  </div>

  <script>
    (function () {
      function isLight() { return document.documentElement.classList.contains('light'); }
      function updateIcon() {
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) icon.dataset.mode = isLight() ? 'light' : 'dark';
      }
      updateIcon();
      document.addEventListener('click', function (e) {
        if (!e.target.closest('#theme-toggle-btn')) return;
        const root = document.documentElement;
        root.classList.add('theme-switching');
        root.classList.toggle('light');
        try { localStorage.setItem('lilteam_theme', isLight() ? 'light' : 'dark'); } catch (e) {}
        updateIcon();
        requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.remove('theme-switching'); }); });
      });
      document.addEventListener('lilteam:page-loaded', updateIcon);
    })();

    let spotlightFrame = 0;
    let spotlightEvent = null;
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType && e.pointerType !== 'mouse') return;
      spotlightEvent = e;
      if (spotlightFrame) return;
      spotlightFrame = requestAnimationFrame(() => {
        spotlightFrame = 0;
        const event = spotlightEvent;
        const card = event && event.target.closest('.spotlight-card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((event.clientX - rect.left) / rect.width) * 100 + '%');
        card.style.setProperty('--my', ((event.clientY - rect.top) / rect.height) * 100 + '%');
      });
    }, { passive: true });
  </script>

  <script>
    // Keep the outer document (and therefore the music player) alive while visitors
    // move around the storefront. Only the server-rendered page shell is replaced.
    (function () {
      const SHELL_ID = 'site-page-shell';
      let activeRequest = null;

      function samePageHashOnly(url) {
        return url.pathname === window.location.pathname
          && url.search === window.location.search
          && url.hash;
      }

      function canHandle(url) {
        return url.origin === window.location.origin
          && !url.pathname.startsWith('/admin')
          && !url.pathname.startsWith('/uploads/')
          && url.pathname !== '/logout';
      }

      function saveScrollPosition() {
        const state = Object.assign({}, history.state || {}, {
          lilteamNavigation: true,
          scrollX: window.scrollX,
          scrollY: window.scrollY,
        });
        history.replaceState(state, '', window.location.href);
      }

      function runPageScripts(shell) {
        shell.querySelectorAll('script').forEach(function (oldScript) {
          const script = document.createElement('script');
          Array.from(oldScript.attributes).forEach(function (attr) {
            script.setAttribute(attr.name, attr.value);
          });
          script.textContent = oldScript.textContent;
          oldScript.replaceWith(script);
        });
      }

      function restoreScroll(url, position) {
        if (position) {
          window.scrollTo(position.x || 0, position.y || 0);
          return;
        }
        if (url.hash) {
          const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
          if (target) {
            target.scrollIntoView();
            return;
          }
        }
        window.scrollTo(0, 0);
      }

      function showNavigationError() {
        let notice = document.getElementById('lilteam-navigation-error');
        if (!notice) {
          notice = document.createElement('div');
          notice.id = 'lilteam-navigation-error';
          notice.setAttribute('role', 'status');
          notice.style.cssText = 'position:fixed;z-index:10000;left:50%;bottom:1rem;transform:translateX(-50%);max-width:calc(100vw - 2rem);padding:.7rem 1rem;border:1px solid var(--border);border-radius:.75rem;background:var(--card);color:var(--text);box-shadow:0 12px 35px rgba(0,0,0,.3);font-size:.82rem;text-align:center';
          document.body.appendChild(notice);
        }
        notice.textContent = 'การเชื่อมต่อใช้เวลานาน กรุณากดอีกครั้ง';
        notice.hidden = false;
        clearTimeout(notice._hideTimer);
        notice._hideTimer = setTimeout(function () { notice.hidden = true; }, 4500);
      }

      async function loadPage(url, options) {
        options = options || {};
        if (activeRequest) activeRequest.abort();
        const request = new AbortController();
        activeRequest = request;
        document.documentElement.classList.add('lilteam-navigating');
        const timeout = setTimeout(function () { request.abort('timeout'); }, 12000);

        try {
          const response = await fetch(url.href, {
            method: options.method || 'GET',
            body: options.body || undefined,
            credentials: 'same-origin',
            headers: { 'X-Lilteam-Navigation': '1' },
            signal: request.signal,
          });
          const finalUrl = new URL(response.url || url.href, window.location.href);
          const contentType = response.headers.get('content-type') || '';
          if (!contentType.includes('text/html') || !canHandle(finalUrl)) {
            window.location.assign(finalUrl.href);
            return;
          }

          const html = await response.text();
          const nextDocument = new DOMParser().parseFromString(html, 'text/html');
          const nextShell = nextDocument.getElementById(SHELL_ID);
          const currentShell = document.getElementById(SHELL_ID);
          if (!nextShell || !currentShell) {
            window.location.assign(finalUrl.href);
            return;
          }

          if (options.history !== 'pop') saveScrollPosition();
          document.dispatchEvent(new CustomEvent('lilteam:page-unloading'));
          const swapPage = function () {
            currentShell.replaceWith(nextShell);
            document.title = nextDocument.title;
            runPageScripts(nextShell);
          };
          if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            await document.startViewTransition(swapPage).updateCallbackDone;
          } else {
            swapPage();
          }

          if (options.history === 'push') {
            history.pushState({ lilteamNavigation: true, scrollX: 0, scrollY: 0 }, '', finalUrl.href);
          } else if (options.history === 'replace') {
            history.replaceState({ lilteamNavigation: true, scrollX: 0, scrollY: 0 }, '', finalUrl.href);
          }

          restoreScroll(finalUrl, options.scrollPosition);
          document.dispatchEvent(new CustomEvent('lilteam:page-loaded', { detail: { url: finalUrl.href } }));
        } catch (error) {
          // Do not replace one stalled request with another full-page request.
          // On timeout the current page remains usable and the visitor can retry.
          if (request.signal.aborted) {
            if (request.signal.reason === 'timeout') showNavigationError();
          } else {
            window.location.assign(url.href);
          }
        } finally {
          clearTimeout(timeout);
          if (activeRequest === request) {
            document.documentElement.classList.remove('lilteam-navigating');
            activeRequest = null;
          }
        }
      }

      document.addEventListener('click', function (event) {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target.closest('a[href]');
        if (!link || link.target && link.target !== '_self' || link.hasAttribute('download')) return;
        const rawHref = link.getAttribute('href') || '';
        if (!rawHref || rawHref.startsWith('javascript:') || rawHref.startsWith('mailto:') || rawHref.startsWith('tel:')) return;
        const url = new URL(link.href, window.location.href);
        if (!canHandle(url) || samePageHashOnly(url)) return;
        event.preventDefault();
        loadPage(url, { history: 'push' });
      });

      document.addEventListener('submit', function (event) {
        if (event.defaultPrevented) return;
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.target && form.target !== '_self') return;
        const method = (form.method || 'GET').toUpperCase();
        const url = new URL(form.action || window.location.href, window.location.href);
        if (!canHandle(url)) return;

        const data = new FormData(form);
        if (event.submitter && event.submitter.name) data.append(event.submitter.name, event.submitter.value);
        if (method === 'GET') {
          url.search = new URLSearchParams(data).toString();
          event.preventDefault();
          loadPage(url, { history: 'push' });
          return;
        }
        // State-changing forms use native navigation so redirects, validation,
        // uploads and one-time checkout actions retain normal browser semantics.
      });

      window.addEventListener('popstate', function (event) {
        loadPage(new URL(window.location.href), {
          history: 'pop',
          scrollPosition: event.state ? { x: event.state.scrollX, y: event.state.scrollY } : null,
        });
      });

      window.addEventListener('pageshow', function () {
        document.documentElement.classList.remove('lilteam-navigating');
      });
      window.addEventListener('offline', function () {
        if (activeRequest) activeRequest.abort('offline');
        document.documentElement.classList.remove('lilteam-navigating');
      });

      history.replaceState(Object.assign({}, history.state || {}, {
        lilteamNavigation: true,
        scrollX: window.scrollX,
        scrollY: window.scrollY,
      }), '', window.location.href);
    })();
  </script>

  <%
    function getYoutubeId(url) {
      if (!url) return null;
      const value = String(url).trim();
      const validId = id => (/^[a-zA-Z0-9_-]{11}$/.test(id || '') ? id : null);
      if (validId(value)) return value;
      try {
        const parsed = new URL(value);
        const host = parsed.hostname.replace(/^www\./, '').replace(/^music\./, '');
        if (host === 'youtu.be') return validId(parsed.pathname.split('/').filter(Boolean)[0]);
        if (host === 'youtube.com' || host === 'm.youtube.com') {
          const queryId = parsed.searchParams.get('v');
          if (queryId) return validId(queryId);
          const parts = parsed.pathname.split('/').filter(Boolean);
          if (['embed', 'shorts', 'live'].includes(parts[0])) return validId(parts[1]);
        }
      } catch (e) {}
      return null;
    }
    const musicVideoId = (typeof settings !== 'undefined' && settings.music && settings.music.enabled)
      ? getYoutubeId(settings.music.youtubeUrl) : null;
  %>
  <% if (musicVideoId) { %>
  <div id="music-widget" class="fixed bottom-4 right-4 z-50 select-none" data-video-id="<%= musicVideoId %>" data-default-volume="<%= settings.music.defaultVolume %>" data-start-seconds="<%= settings.music.startSeconds || 0 %>" data-end-seconds="<%= settings.music.endSeconds || 0 %>">
    <button id="music-toggle-btn" type="button" aria-label="เล่นเพลง" title="เล่นเพลง / หยุดเพลง" class="relative w-14 h-14 rounded-full bg-[var(--card)] border border-[var(--border)] shadow-lg flex items-center justify-center text-xl overflow-hidden hover:border-[var(--gold)]/60 transition">
      <img id="music-thumb" src="https://img.youtube.com/vi/<%= musicVideoId %>/mqdefault.jpg" class="absolute inset-0 w-full h-full object-cover opacity-40" alt="" />
      <span id="music-icon" class="relative z-10">🎵</span>
      <span id="music-playing-ring" class="hidden absolute inset-0 rounded-full border-2 border-[var(--gold)] animate-ping"></span>
    </button>
    <button id="music-settings-btn" type="button" aria-label="ตั้งค่าเพลง" title="ระดับเสียงและข้อมูลเพลง" class="absolute -top-2 -left-2 z-20 w-7 h-7 rounded-full bg-[var(--input)] border border-[var(--border-light)] text-xs shadow-lg hover:border-[var(--gold)]">⚙</button>

    <div id="music-panel" class="hidden absolute bottom-16 right-0 w-64 bg-[var(--card)] border border-[var(--border)] rounded-2xl shadow-2xl overflow-hidden text-[var(--text)]">
      <div class="relative aspect-video bg-[#0c0a06]">
        <img src="https://img.youtube.com/vi/<%= musicVideoId %>/mqdefault.jpg" class="w-full h-full object-cover" alt="เพลงหน้าเว็บ" />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--card)] via-transparent to-transparent"></div>
        <button id="music-collapse-btn" type="button" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-black/50 hover:bg-black/70 flex items-center justify-center text-sm leading-none">✕</button>
      </div>
      <div class="p-3">
        <p id="music-title" class="text-xs text-[var(--text-2)] mb-3 line-clamp-2 leading-snug">เพลงหน้าเว็บ</p>
        <div class="flex items-center gap-3">
          <button id="music-play-btn" type="button" class="w-10 h-10 rounded-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] flex items-center justify-center flex-shrink-0 text-base transition">▶</button>
          <div class="flex-1 flex items-center gap-2">
            <span class="text-xs">🔉</span>
            <input id="music-volume" type="range" min="0" max="100" value="<%= settings.music.defaultVolume %>" class="flex-1 accent-[var(--gold)]" />
          </div>
        </div>
      </div>
    </div>
    <div id="music-yt-player" aria-hidden="true" style="position:fixed;width:200px;height:200px;left:-9999px;top:0;opacity:0;pointer-events:none;"></div>
  </div>

  <script>
    (function () {
      const widget = document.getElementById('music-widget');
      if (!widget) return;
      const videoId = widget.dataset.videoId;
      const toggleBtn = document.getElementById('music-toggle-btn');
      const settingsBtn = document.getElementById('music-settings-btn');
      const panel = document.getElementById('music-panel');
      const collapseBtn = document.getElementById('music-collapse-btn');
      const playBtn = document.getElementById('music-play-btn');
      const volumeSlider = document.getElementById('music-volume');
      const icon = document.getElementById('music-icon');
      const playingRing = document.getElementById('music-playing-ring');
      const titleEl = document.getElementById('music-title');

      const STORAGE_PLAYING = 'lilteam_music_playing';
      const STORAGE_VOLUME = 'lilteam_music_volume';
      const STORAGE_TIME = 'lilteam_music_time';
      const STORAGE_TS = 'lilteam_music_ts';

      let player = null;
      let apiRequested = false;
      let isPlaying = false;
      let segmentTimer = null;
      let recoveryTimer = null;
      const startSeconds = parseInt(widget.dataset.startSeconds, 10) || 0;
      const endSeconds = parseInt(widget.dataset.endSeconds, 10) || 0;

      function loadYouTubeApi() {
        if (apiRequested || window.YT) return;
        apiRequested = true;
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        script.async = true;
        document.head.appendChild(script);
      }

      const savedVolume = localStorage.getItem(STORAGE_VOLUME);
      const initialVolume = savedVolume !== null ? parseInt(savedVolume, 10) : parseInt(widget.dataset.defaultVolume, 10);
      volumeSlider.value = initialVolume;

      // Clean up the old registration autoplay hint if present (superseded by default-on below).
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('music')) {
        urlParams.delete('music');
        const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '') + window.location.hash;
        window.history.replaceState({}, '', cleanUrl);
      }

      // Music plays by default on every visit — the ONLY thing that turns this off is the
      // visitor explicitly clicking the pause button (see playBtn handler below). Incidental
      // browser-triggered pauses (autoplay policy, tab backgrounding, bfcache, etc.) must
      // never write to this flag, or autoplay silently breaks itself on the next page.
      let playbackWanted = localStorage.getItem(STORAGE_PLAYING) !== 'false';
      let resumeAt = startSeconds;
      const savedTime = parseFloat(localStorage.getItem(STORAGE_TIME));
      if (!Number.isNaN(savedTime) && savedTime >= 0 && playbackWanted) {
        // Resume the exact heard position. Adding time spent away from the site
        // made the track jump unpredictably after refresh/back navigation.
        resumeAt = savedTime;
        if (endSeconds > startSeconds && resumeAt >= endSeconds) {
          resumeAt = startSeconds + ((resumeAt - startSeconds) % (endSeconds - startSeconds));
        }
      }

      function setPlayingUI(playing) {
        isPlaying = playing;
        toggleBtn.setAttribute('aria-label', playing ? 'หยุดเพลง' : 'เล่นเพลง');
        toggleBtn.title = playing ? 'หยุดเพลง' : 'เล่นเพลง';
        playBtn.textContent = playing ? '⏸' : '▶';
        playBtn.setAttribute('aria-label', playing ? 'หยุดเพลง' : 'เล่นเพลง');
        playBtn.title = playing ? 'หยุดเพลง' : 'เล่นเพลง';
        icon.textContent = playing ? '🎶' : '🎵';
        playingRing.classList.toggle('hidden', !playing);
      }

      function recoverPlayback(delay) {
        if (!playbackWanted || document.hidden || !player || typeof player.playVideo !== 'function') return;
        if (recoveryTimer) clearTimeout(recoveryTimer);
        recoveryTimer = setTimeout(function () {
          recoveryTimer = null;
          if (playbackWanted && !document.hidden && player && player.playVideo) player.playVideo();
        }, delay || 700);
      }

      // Keep the user's intent independently from YouTube's delayed state events.
      // This also makes taps made while the iframe is still loading take effect on ready.
      function requestPlayback(wanted) {
        playbackWanted = wanted;
        localStorage.setItem(STORAGE_PLAYING, wanted ? 'true' : 'false');
        if (!player || typeof player.playVideo !== 'function') {
          loadYouTubeApi();
          setPlayingUI(false);
          return;
        }
        if (wanted) {
          player.unMute();
          player.playVideo();
        } else {
          if (recoveryTimer) clearTimeout(recoveryTimer);
          player.pauseVideo();
          setPlayingUI(false);
        }
      }

      function watchSegment() {
        if (segmentTimer) clearInterval(segmentTimer);
        segmentTimer = setInterval(function () {
          if (!player || typeof player.getCurrentTime !== 'function') return;
          const t = player.getCurrentTime();
          if (endSeconds > startSeconds && t >= endSeconds) {
            player.seekTo(startSeconds, true);
          }
          localStorage.setItem(STORAGE_TIME, t);
          localStorage.setItem(STORAGE_TS, Date.now());
        }, 1500);
      }

      window.onYouTubeIframeAPIReady = function () {
        player = new YT.Player('music-yt-player', {
          videoId: videoId,
          playerVars: {
            autoplay: 0,
            mute: 0,
            controls: 0,
            loop: 1,
            playlist: videoId,
            start: Math.max(0, Math.floor(resumeAt)),
            playsinline: 1,
            origin: window.location.origin,
          },
          events: {
            onReady: function (e) {
              e.target.setVolume(initialVolume);
              if (playbackWanted) {
                // Try once. If the browser blocks autoplay the UI remains paused;
                // an explicit tap on the music button will start it reliably.
                e.target.unMute();
                e.target.playVideo();
              }
            },
            onStateChange: function (e) {
              if (e.data === YT.PlayerState.PLAYING) {
                setPlayingUI(true);
                watchSegment();
              } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) {
                setPlayingUI(false);
                if (segmentTimer) clearInterval(segmentTimer);
                if (e.data === YT.PlayerState.ENDED && playbackWanted) {
                  player.seekTo(startSeconds, true);
                  player.playVideo();
                } else if (e.data === YT.PlayerState.PAUSED && playbackWanted) {
                  recoverPlayback(900);
                }
              }
            },
            onError: function () {
              // Playback failed (e.g. blocked/restricted video) — don't get stuck claiming "playing".
              setPlayingUI(false);
            },
          },
        });
      };

      if ('requestIdleCallback' in window) requestIdleCallback(loadYouTubeApi, { timeout: 3500 });
      else setTimeout(loadYouTubeApi, 1800);

      fetch('https://noembed.com/embed?url=' + encodeURIComponent('https://www.youtube.com/watch?v=' + videoId))
        .then(function (r) { return r.json(); })
        .then(function (data) { if (data && data.title) titleEl.textContent = data.title; })
        .catch(function () {});

      toggleBtn.addEventListener('click', function () {
        requestPlayback(!isPlaying);
      });
      settingsBtn.addEventListener('click', function () {
        panel.classList.toggle('hidden');
      });
      collapseBtn.addEventListener('click', function () {
        panel.classList.add('hidden');
      });
      document.addEventListener('click', function (e) {
        if (!widget.contains(e.target)) panel.classList.add('hidden');
      });

      playBtn.addEventListener('click', function () {
        requestPlayback(!isPlaying);
      });

      volumeSlider.addEventListener('input', function () {
        const v = parseInt(volumeSlider.value, 10);
        if (player) player.setVolume(v);
        localStorage.setItem(STORAGE_VOLUME, v);
      });

      window.addEventListener('beforeunload', function () {
        if (player && typeof player.getCurrentTime === 'function') {
          localStorage.setItem(STORAGE_TIME, player.getCurrentTime());
          localStorage.setItem(STORAGE_TS, Date.now());
        }
      });

      // A bfcache restore keeps the existing player. Never reload here: reloading would
      // destroy the player and is exactly what makes back/forward playback jump around.
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) recoverPlayback(100);
      });
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) recoverPlayback(180);
      });
      window.addEventListener('online', function () { recoverPlayback(300); });
    })();
  </script>
  <% } %>

  <% if (typeof settings !== 'undefined' && settings.snow && settings.snow.enabled) { %>
  <div id="snow-container" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index: -1;"></div>
  <style>
    .snowflake {
      position: absolute;
      top: -5vh;
      color: #fff;
      text-shadow: 0 0 4px rgba(255,255,255,0.6);
      user-select: none;
      will-change: transform;
      animation-name: snow-fall;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    @keyframes snow-fall {
      0% { transform: translate3d(0,-5vh,0) rotate(0deg); }
      50% { transform: translate3d(18px,50vh,0) rotate(90deg); }
      100% { transform: translate3d(-10px,105vh,0) rotate(180deg); }
    }
  </style>
  <script>
    (function () {
      const container = document.getElementById('snow-container');
      if (!container) return;
      const count = window.innerWidth < 768 ? 3 : 14;
      for (let i = 0; i < count; i++) {
        const flake = document.createElement('span');
        flake.className = 'snowflake';
        flake.textContent = '❄';
        flake.style.left = Math.random() * 100 + 'vw';
        flake.style.fontSize = (8 + Math.random() * 14) + 'px';
        flake.style.opacity = 0.35 + Math.random() * 0.55;
        const fallDuration = 8 + Math.random() * 10;
        flake.style.animationDuration = fallDuration + 's';
        flake.style.animationDelay = (-Math.random() * fallDuration) + 's';
        container.appendChild(flake);
      }
    })();
  </script>
  <% } %>
  <% if (typeof settings !== 'undefined' && settings.systemModules && settings.systemModules.rain && settings.systemModules.rain.enabled && settings.rain && settings.rain.enabled) { const rain = settings.rain; %>
  <canvas id="store-rain" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:20"></canvas>
  <script>
    (function(){
      const canvas=document.getElementById('store-rain'); if(!canvas||!canvas.getContext)return;
      const ctx=canvas.getContext('2d',{alpha:true});
      const color=<%- JSON.stringify(/^#[0-9a-fA-F]{6}$/.test(rain.color||'')?rain.color:'#78c8ff') %>;
      const rgb=parseInt(color.slice(1),16),luma=((rgb>>16)*299+((rgb>>8)&255)*587+(rgb&255)*114)/1000;
      const contrast=luma<128?'#ffffff':'#07111f';
      const level=<%- JSON.stringify(['light','medium','heavy'].includes(rain.intensity)?rain.intensity:'medium') %>;
      const coarse=matchMedia('(max-width:900px), (pointer:coarse)').matches;
      const reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
      const limits={light:coarse?18:36,medium:coarse?30:62,heavy:coarse?44:92};
      let drops=[],frame=0,last=0,w=0,h=0,dpr=1;
      function reset(drop,randomY){drop.x=Math.random()*w;drop.y=randomY?Math.random()*h:-30;drop.len=14+Math.random()*18;drop.speed=(coarse?8:10)+Math.random()*8;drop.alpha=.48+Math.random()*.34;return drop}
      function resize(){dpr=Math.min(devicePixelRatio||1,1.5);w=innerWidth;h=innerHeight;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);const count=reduced?Math.max(12,Math.round(limits[level]*.45)):limits[level];drops=Array.from({length:count},()=>reset({},true))}
      function draw(now){frame=requestAnimationFrame(draw);if(document.hidden||now-last<16)return;last=now;ctx.clearRect(0,0,w,h);ctx.lineCap='round';for(const d of drops){ctx.globalAlpha=.28;ctx.lineWidth=coarse?2.5:2.9;ctx.strokeStyle=contrast;ctx.beginPath();ctx.moveTo(d.x,d.y);ctx.lineTo(d.x-3,d.y+d.len);ctx.stroke();ctx.globalAlpha=d.alpha;ctx.lineWidth=coarse?1.35:1.65;ctx.strokeStyle=color;ctx.stroke();d.x-=.8;d.y+=d.speed;if(d.y>h+30)reset(d,false)}ctx.globalAlpha=1}
      let timer;addEventListener('resize',()=>{clearTimeout(timer);timer=setTimeout(resize,160)},{passive:true});
      document.addEventListener('visibilitychange',()=>{if(!document.hidden)last=performance.now()});resize();frame=requestAnimationFrame(draw);
      addEventListener('pagehide',()=>cancelAnimationFrame(frame),{once:true});
    })();
  </script>
  <% } %>
<script>
  (function () {
    let performanceObserver = null;
    function observePerformanceTargets() {
      const mobileCoarse = window.matchMedia('(max-width: 900px) and (pointer: coarse)').matches;
      const animated = document.querySelectorAll(mobileCoarse
        ? '.banner-sparkle,.latest-orders-shell,.hud-bar,.mg-panel'
        : '.premium-product-card,.banner-sparkle,.latest-orders-shell,.hud-bar,.mg-panel');
      if (performanceObserver) performanceObserver.disconnect();
    if ('IntersectionObserver' in window) {
      performanceObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          entry.target.classList.toggle('perf-visible', entry.isIntersecting);
        });
      }, { rootMargin: '180px 0px', threshold: 0.01 });
      animated.forEach(function (element) { performanceObserver.observe(element); });
    } else {
      animated.forEach(function (element) { element.classList.add('perf-visible'); });
    }
    }
    observePerformanceTargets();
    document.addEventListener('lilteam:page-loaded', observePerformanceTargets);

    let clockTimer = null;
    function render() {
      const clocks = Array.from(document.querySelectorAll('.flash-countdown'));
      if (!clocks.length) return;
      const now = Date.now();
      let reloadNeeded = false;
      clocks.forEach(function (clock) {
        const target = Number(clock.dataset.flashEnd || clock.dataset.flashStart || 0);
        if (!Number.isFinite(target) || target <= 0) {
          clock.textContent = '--:--:--';
          return;
        }
        const remaining = Math.max(0, target - now);
        if (!remaining) reloadNeeded = true;
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const dayLabel = days ? days + (clock.dataset.flashCompact ? 'ว ' : 'วัน ') : '';
        clock.textContent = dayLabel + [hours, minutes, seconds].map(function (n) { return String(n).padStart(2, '0'); }).join(':');
      });
      if (reloadNeeded) window.location.reload();
    }
    function startClocks() {
      if (clockTimer) clearInterval(clockTimer);
      render();
      clockTimer = window.setInterval(render, 1000);
    }
    startClocks();
    document.addEventListener('lilteam:page-loaded', startClocks);
  })();
</script>
  <script src="<%= asset('js/scroll-motion-v1.js') %>" defer></script>
  <script src="<%= asset('js/interaction-performance-v1.js') %>" defer></script>
</body>
