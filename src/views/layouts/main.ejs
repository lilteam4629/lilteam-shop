<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | ' + settings.shopName : settings.shopName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Kanit', sans-serif; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: #4a4028; border-radius: 4px; }

    @keyframes marquee-scroll {
      from { transform: translateX(100%); }
      to { transform: translateX(-100%); }
    }
    .marquee-track {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      white-space: nowrap;
      animation: marquee-scroll 22s linear infinite;
    }
    .marquee-track:hover { animation-play-state: paused; }
  </style>
</head>
<body class="bg-[#100e08] text-[#f3ecd8] min-h-screen flex flex-col">
  <%- include('../partials/navbar') %>

  <main class="flex-1">
    <% if (messages.success && messages.success.length) { %>
      <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.success.forEach(m => { %>
          <div class="bg-emerald-900/40 border border-emerald-700 text-emerald-300 px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <% if (messages.error && messages.error.length) { %>
      <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-4">
        <% messages.error.forEach(m => { %>
          <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-2 text-sm"><%= m %></div>
        <% }) %>
      </div>
    <% } %>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('mousemove', (e) => {
      const card = e.target.closest('.spotlight-card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', ((e.clientX - rect.left) / rect.width) * 100 + '%');
      card.style.setProperty('--my', ((e.clientY - rect.top) / rect.height) * 100 + '%');
    });
  </script>

  <%
    function getYoutubeId(url) {
      if (!url) return null;
      const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
      return m ? m[1] : null;
    }
    const musicVideoId = (typeof settings !== 'undefined' && settings.music && settings.music.enabled)
      ? getYoutubeId(settings.music.youtubeUrl) : null;
  %>
  <% if (musicVideoId) { %>
  <div id="music-widget" class="fixed bottom-4 right-4 z-50 select-none" data-video-id="<%= musicVideoId %>" data-default-volume="<%= settings.music.defaultVolume %>">
    <button id="music-toggle-btn" type="button" class="w-12 h-12 rounded-full bg-[#1a160d] border border-[#3a3220] shadow-lg flex items-center justify-center text-lg hover:border-[#c8a63f]/60 transition">
      <span id="music-icon">🎵</span>
    </button>
    <div id="music-panel" class="hidden absolute bottom-14 right-0 w-56 bg-[#1a160d] border border-[#3a3220] rounded-xl shadow-xl p-3 text-[#f3ecd8]">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-[#a89a6c]">🎵 เพลงหน้าเว็บ</span>
        <button id="music-collapse-btn" type="button" class="text-[#7a6f47] hover:text-[#c8a63f] text-sm leading-none">✕</button>
      </div>
      <div class="flex items-center gap-2">
        <button id="music-play-btn" type="button" class="w-9 h-9 rounded-full bg-[#c8a63f] text-[#100e08] flex items-center justify-center flex-shrink-0 text-sm">▶</button>
        <input id="music-volume" type="range" min="0" max="100" value="<%= settings.music.defaultVolume %>" class="flex-1 accent-[#c8a63f]" />
      </div>
    </div>
    <div id="music-yt-player" style="position:absolute; width:0; height:0; overflow:hidden;"></div>
  </div>

  <script src="https://www.youtube.com/iframe_api"></script>
  <script>
    (function () {
      const widget = document.getElementById('music-widget');
      if (!widget) return;
      const videoId = widget.dataset.videoId;
      const toggleBtn = document.getElementById('music-toggle-btn');
      const panel = document.getElementById('music-panel');
      const collapseBtn = document.getElementById('music-collapse-btn');
      const playBtn = document.getElementById('music-play-btn');
      const volumeSlider = document.getElementById('music-volume');
      const icon = document.getElementById('music-icon');

      let player = null;
      let isPlaying = false;
      const savedVolume = localStorage.getItem('lilteam_music_volume');
      const initialVolume = savedVolume !== null ? parseInt(savedVolume, 10) : parseInt(widget.dataset.defaultVolume, 10);
      volumeSlider.value = initialVolume;

      window.onYouTubeIframeAPIReady = function () {
        player = new YT.Player('music-yt-player', {
          videoId: videoId,
          playerVars: { autoplay: 0, controls: 0, loop: 1, playlist: videoId },
          events: {
            onReady: function (e) {
              e.target.setVolume(initialVolume);
            },
            onStateChange: function (e) {
              if (e.data === YT.PlayerState.PLAYING) {
                isPlaying = true;
                playBtn.textContent = '⏸';
                icon.textContent = '🎶';
              } else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) {
                isPlaying = false;
                playBtn.textContent = '▶';
                icon.textContent = '🎵';
              }
            },
          },
        });
      };

      toggleBtn.addEventListener('click', function () {
        panel.classList.toggle('hidden');
      });
      collapseBtn.addEventListener('click', function () {
        panel.classList.add('hidden');
      });
      document.addEventListener('click', function (e) {
        if (!widget.contains(e.target)) panel.classList.add('hidden');
      });

      playBtn.addEventListener('click', function () {
        if (!player) return;
        if (isPlaying) player.pauseVideo();
        else player.playVideo();
      });

      volumeSlider.addEventListener('input', function () {
        const v = parseInt(volumeSlider.value, 10);
        if (player) player.setVolume(v);
        localStorage.setItem('lilteam_music_volume', v);
      });
    })();
  </script>
  <% } %>
</body>
</html>
