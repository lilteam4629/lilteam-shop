<!doctype html>
<% const hasBuiltAdminShell = typeof body === 'string' && /class="experiment-app(?:\s|\")/.test(body); %>
<% const pendingAdminNotificationCount = Math.max(0, Number(pendingTopupCount) || 0); %>
<% const notificationLabel = pendingAdminNotificationCount ? `คำขอเติมเงินรอตรวจสอบ ${pendingAdminNotificationCount} รายการ` : 'ดูการแจ้งเตือน'; %>
<% const notificationBadge = pendingAdminNotificationCount ? `<span class="experiment-notification-count" aria-hidden="true">${pendingAdminNotificationCount > 99 ? '99+' : pendingAdminNotificationCount}</span>` : ''; %>
<% const sharedAdminTopbar = '<header class="experiment-topbar"><span class="experiment-topbar-spacer" aria-hidden="true"></span><button class="experiment-icon-button experiment-menu-trigger" type="button" data-experiment-menu-open aria-label="เปิดเมนูหมวดหมู่" aria-controls="experiment-mobile-menu" aria-expanded="false" title="เปิดเมนูหมวดหมู่"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><button class="experiment-icon-button" type="button" data-experiment-notifications aria-label="' + notificationLabel + '" title="' + notificationLabel + '"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>' + notificationBadge + '</button><span class="experiment-user-name" aria-label="ผู้ดูแลระบบ">admin</span></header>'; %>
<% const normalizedAdminBody = hasBuiltAdminShell ? body.replace(/<header\b(?=[^>]*\bclass="[^"]*\bexperiment-topbar\b[^"]*")[^>]*>[\s\S]*?<\/header>/gi, sharedAdminTopbar) : body; %>
<html lang="th" class="<%= typeof isMainSite !== 'undefined' && isMainSite ? 'admin-main-site' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | LILTeam Shop</title>
  <meta name="description" content="ระบบจัดการร้านค้า LILTeam Shop" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&family=Rubik:wght@500;600;700&display=swap" rel="stylesheet" />
  <% if (!hasBuiltAdminShell) { %>
    <link rel="stylesheet" href="<%= asset('css/tailwind.generated.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/theme-contrast-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/admin-studio-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/admin-mobile-v1.css') %>" />
    <link rel="stylesheet" href="<%= asset('css/admin-main-legacy-compat-v1.css') %>" />
  <% } %>
  <link rel="stylesheet" href="<%= asset('css/admin-experiment-v1.css') %>" />
  <style><%- typeof adminBrandCss !== 'undefined' ? adminBrandCss : '' %></style>
</head>
<body class="experiment-admin admin-site <%= typeof isMainSite !== 'undefined' && isMainSite && active === 'welcome-popup' ? 'admin-main-site' : '' %> <%= typeof isMainSite !== 'undefined' && isMainSite && active === 'announcements' ? 'main-admin-announcements' : '' %>">
  <div id="experiment-canonical-sidebar-template" hidden><%- include('../partials/admin-experiment-sidebar-effects') %></div>
  <% if (hasBuiltAdminShell) { %>
    <%- normalizedAdminBody %>
  <% } else { %>
    <div class="experiment-app" data-experiment-framed-page>
      <div class="experiment-main">
        <%- sharedAdminTopbar %>
        <main class="experiment-content"><div class="experiment-legacy-content"><%- body %></div></main>
      </div>
    </div>
    <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin">⌂<span>ภาพรวม</span></a><a href="/admin/products">▦<span>สินค้า</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/topups">▭<span>การเงิน</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
  <% } %>
  <dialog class="experiment-menu-dialog" id="experiment-mobile-menu" data-experiment-menu-dialog aria-label="เมนูหมวดหมู่">
    <div class="experiment-menu-dialog-content">
      <div class="experiment-menu-dialog-head"><div><span class="experiment-menu-kicker">LILTEAM SHOP</span><h2>หมวดหมู่เมนู</h2><p>เลือกหน้าที่ต้องการจัดการ</p></div><button class="experiment-icon-button" type="button" data-experiment-menu-close aria-label="ปิดเมนู"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <div data-experiment-menu-content></div>
    </div>
  </dialog>
  <div id="experiment-toast" class="experiment-toast" role="status" aria-live="polite"></div>
  <dialog class="experiment-confirm-dialog" data-experiment-confirm-dialog aria-labelledby="experiment-confirm-title" aria-describedby="experiment-confirm-message">
    <div class="experiment-confirm-head">
      <div class="experiment-confirm-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></div>
      <div><span class="experiment-confirm-kicker">ตรวจสอบก่อนดำเนินการ</span><h2 id="experiment-confirm-title">ยืนยันการทำรายการ</h2></div>
    </div>
    <p class="experiment-confirm-message" data-experiment-confirm-message id="experiment-confirm-message"></p>
    <p class="experiment-confirm-note">ระบบจะทำรายการนี้ทันทีหลังจากกดยืนยัน</p>
    <div class="experiment-confirm-actions"><button class="experiment-button" type="button" data-experiment-confirm-cancel>ยกเลิก</button><button class="experiment-button primary" type="button" data-experiment-confirm-submit>ยืนยันรายการ</button></div>
  </dialog>
  <script>
    (function () {
      const experimentApp = document.querySelector('.experiment-app');
      const canonicalSidebarTemplate = document.getElementById('experiment-canonical-sidebar-template');
      if (experimentApp && canonicalSidebarTemplate) {
        experimentApp.querySelectorAll('[data-experiment-sidebar]').forEach(node => node.remove());
        const canonicalSidebar = canonicalSidebarTemplate.querySelector('[data-experiment-sidebar]');
        if (canonicalSidebar) experimentApp.insertBefore(canonicalSidebar, experimentApp.firstElementChild);
        canonicalSidebarTemplate.remove();
      }
      const root = document.documentElement;
      const sidebar = document.querySelector('[data-experiment-sidebar]');
      const collapse = document.querySelector('[data-experiment-collapse]');
      const toast = document.getElementById('experiment-toast');
      const confirmDialog = document.querySelector('[data-experiment-confirm-dialog]');
      const confirmMessage = document.querySelector('[data-experiment-confirm-message]');
      const confirmTitle = document.getElementById('experiment-confirm-title');
      const confirmCancel = document.querySelector('[data-experiment-confirm-cancel]');
      const confirmSubmit = document.querySelector('[data-experiment-confirm-submit]');
      const pendingAdminNotificationCount = <%= pendingAdminNotificationCount %>;
      let pendingConfirmForm = null;
      const showToast = (message) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add('show');
        window.clearTimeout(window.__experimentToastTimer);
        window.__experimentToastTimer = window.setTimeout(() => toast.classList.remove('show'), 2600);
      };
      window.showExperimentToast = showToast;
      const closeExperimentConfirm = () => {
        pendingConfirmForm = null;
        if (confirmDialog && confirmDialog.open) confirmDialog.close();
      };
      confirmCancel?.addEventListener('click', closeExperimentConfirm);
      confirmSubmit?.addEventListener('click', () => {
        if (!pendingConfirmForm) return;
        const form = pendingConfirmForm;
        pendingConfirmForm = null;
        confirmDialog.close();
        form.dataset.experimentConfirmed = 'true';
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.submit();
      });
      confirmDialog?.addEventListener('cancel', () => { pendingConfirmForm = null; });
      const sidebarScroll = document.querySelector('.experiment-sidebar-scroll');
      const extraNavGroups = [
        {
          title: 'แคตตาล็อก & หน้าร้าน',
          items: [
            ['/admin/home-sections', 'หมวดหมู่หน้าแรก', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 11H5m14 0a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2m14 0V9a2 2 0 0 0-2-2M5 11V9a2 2 0 0 1 2-2m0 0V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2M7 7h10"/></svg>'],
            ['/admin/catalog-api', 'API สินค้าร้านหลัก', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17 17 7M9 7h8v8"/></svg>'],
            ['/admin/storefront-models', 'โมเดลหน้าร้าน', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 10h16M4 14h10M4 18h10m4-6 2 2-2 2"/></svg>'],
          ],
        },
        {
          title: 'โปรโมชั่น & สมาชิก',
          items: [
            ['/admin/coupons', 'คูปองส่วนลด', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 0 0-2 2v3a2 2 0 1 1 0 4v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3a2 2 0 1 1 0-4V7a2 2 0 0 0-2-2H5Z"/></svg>'],
            ['/admin/users', 'จัดการสมาชิก', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3"/><path d="M5 20c.8-3 3-5 7-5s6.2 2 7 5"/></svg>'],
          ],
        },
        {
          title: 'ตกแต่ง & การตั้งค่า',
          items: [
            ['/admin/appearance', 'รูปและแบนเนอร์', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 16 8.6 11.4a2 2 0 0 1 2.8 0L16 16m-2-2 1.6-1.6a2 2 0 0 1 2.8 0L20 14M14 8h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"/></svg>'],
            ['/admin/theme', 'ธีมร้านค้า', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3a9 9 0 1 0 0 18h1.5a1.5 1.5 0 0 0 0-3H12a2 2 0 0 1 0-4h2a7 7 0 0 0 0-14h-2Z"/><path d="M7.5 10h.01M9 6.5h.01M14 6h.01"/></svg>'],
            ['/admin/announcements', 'ป้ายประกาศ', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m11 5-5 4H3v6h3l5 4V5Zm4.5 4a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12"/></svg>'],
            ['/admin/welcome-popup', 'ป๊อปอัปต้อนรับ', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 8h10M7 12h6m8 0a9 9 0 0 0-13.1-7.55L3 3v9a9 9 0 0 0 18 0Z"/></svg>'],
            ['/admin/effects', 'ลูกเล่นหน้าเว็บ', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l11-2v13M9 9l11-2M6 21a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm14-2a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>'],
            ['/admin/settings', 'ตั้งค่าร้านค้า', '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10.3 4.3c.4-1.8 3-1.8 3.4 0a1.7 1.7 0 0 0 2.6 1.1c1.5-.9 3.3.8 2.4 2.4a1.7 1.7 0 0 0 1.1 2.6c1.8.4 1.8 3 0 3.4a1.7 1.7 0 0 0-1.1 2.6c.9 1.5-.9 3.3-2.4 2.4a1.7 1.7 0 0 0-2.6 1.1c-.4 1.8-3 1.8-3.4 0a1.7 1.7 0 0 0-2.6-1.1c-1.5.9-3.3-.9-2.4-2.4a1.7 1.7 0 0 0-1.1-2.6c-1.8-.4-1.8-3 0-3.4a1.7 1.7 0 0 0 1.1-2.6c-.9-1.6.9-3.3 2.4-2.4a1.7 1.7 0 0 0 2.6-1.1Z"/><circle cx="12" cy="12" r="3"/></svg>'],
          ],
        },
      ];
      if (sidebarScroll && !sidebarScroll.querySelector('[data-experiment-extra-nav]')) {
        const existingHrefs = new Set(Array.from(sidebarScroll.querySelectorAll('a[href]')).map(link => { try { return new URL(link.getAttribute('href'), window.location.origin).pathname; } catch (_) { return link.getAttribute('href'); } }));
        extraNavGroups.forEach((group) => {
          const items = group.items.filter(([href]) => { try { return !existingHrefs.has(new URL(href, window.location.origin).pathname); } catch (_) { return !existingHrefs.has(href); } });
          if (!items.length) return;
          const section = document.createElement('div');
          section.className = 'experiment-nav-group';
          section.dataset.experimentExtraNav = 'true';
          section.innerHTML = `<div class="experiment-nav-label">${group.title}</div>${items.map(([href, label, icon]) => `<a class="experiment-nav-item" href="${href}" aria-label="${label}">${icon}<span>${label}</span></a>`).join('')}`;
          sidebarScroll.appendChild(section);
        });
      }
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/admin';
      document.querySelectorAll('a[target="_blank"]').forEach(link => {
        try {
          const linkUrl = new URL(link.getAttribute('href'), window.location.origin);
          if (linkUrl.origin === window.location.origin) {
            link.removeAttribute('target');
            link.removeAttribute('rel');
          }
        } catch (_) {}
      });
      sidebarScroll?.querySelectorAll('a[href]').forEach(link => {
        try {
          const linkPath = new URL(link.getAttribute('href'), window.location.origin).pathname.replace(/\/$/, '') || '/admin';
          const matchesCurrent = linkPath === currentPath || (linkPath !== '/admin' && currentPath.startsWith(`${linkPath}/`));
          link.classList.toggle('active', matchesCurrent);
          if (matchesCurrent) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        } catch (_) {}
      });
      const mobileMenuDialog = document.querySelector('[data-experiment-menu-dialog]');
      const mobileMenuOpen = document.querySelector('[data-experiment-menu-open]');
      const mobileMenuClose = document.querySelector('[data-experiment-menu-close]');
      const mobileMenuContent = document.querySelector('[data-experiment-menu-content]');
      if (sidebar && mobileMenuContent) {
        const mobileSidebar = sidebar.cloneNode(true);
        mobileSidebar.removeAttribute('data-experiment-sidebar');
        mobileSidebar.classList.add('experiment-mobile-drawer-sidebar');
        mobileSidebar.querySelectorAll('[data-experiment-collapse]').forEach(button => button.remove());
        mobileMenuContent.replaceChildren(mobileSidebar);
      }
      mobileMenuOpen?.addEventListener('click', () => {
        if (!mobileMenuDialog || typeof mobileMenuDialog.showModal !== 'function') return;
        mobileMenuDialog.showModal();
        mobileMenuOpen.setAttribute('aria-expanded', 'true');
        mobileMenuClose?.focus();
      });
      mobileMenuClose?.addEventListener('click', () => mobileMenuDialog?.close());
      mobileMenuDialog?.addEventListener('click', event => {
        if (event.target === mobileMenuDialog) mobileMenuDialog.close();
      });
      mobileMenuDialog?.addEventListener('close', () => {
        mobileMenuOpen?.setAttribute('aria-expanded', 'false');
        mobileMenuOpen?.focus();
      });
      try {
        if (localStorage.getItem('lilteam_experiment_sidebar') === 'collapsed') root.classList.add('experiment-sidebar-collapsed');
      } catch (_) {}
      if (collapse) collapse.addEventListener('click', function () {
        root.classList.toggle('experiment-sidebar-collapsed');
        try { localStorage.setItem('lilteam_experiment_sidebar', root.classList.contains('experiment-sidebar-collapsed') ? 'collapsed' : 'open'); } catch (_) {}
      });
      document.querySelectorAll('[data-experiment-alert-toggle]').forEach(function (button) {
        button.addEventListener('click', function () {
          const alert = document.querySelector('[data-experiment-stock-alert]');
          if (!alert) return;
          const expanded = alert.classList.toggle('expanded');
          button.textContent = expanded ? 'ย่อรายการ' : 'ดูทั้งหมด';
          button.setAttribute('aria-expanded', String(expanded));
        });
      });
      document.querySelectorAll('[data-experiment-notifications]').forEach(function (button) {
        button.addEventListener('click', function () {
          showToast(pendingAdminNotificationCount
            ? 'มีคำขอเติมเงินรอตรวจสอบ ' + pendingAdminNotificationCount + ' รายการ'
            : 'ยังไม่มีการแจ้งเตือนใหม่');
        });
      });
      document.querySelectorAll('form[data-experiment-confirm]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (form.dataset.experimentConfirmed === 'true') {
            delete form.dataset.experimentConfirmed;
            return;
          }
          event.preventDefault();
          pendingConfirmForm = form;
          const isDanger = /ลบ|ย้อนกลับไม่ได้/.test(form.dataset.experimentConfirm || '');
          confirmDialog.classList.toggle('danger', isDanger);
          confirmTitle.textContent = isDanger ? 'ยืนยันการลบข้อมูล' : 'ยืนยันการทำรายการ';
          confirmMessage.textContent = form.dataset.experimentConfirm || 'ต้องการดำเนินการนี้หรือไม่?';
          confirmSubmit.textContent = isDanger ? 'ยืนยันการลบ' : 'ยืนยันรายการ';
          confirmDialog.showModal();
          confirmCancel.focus();
        });
      });
    })();
  </script>
  <script src="<%= asset('js/admin-live-compat-v1.js') %>" defer></script>
</body>
</html>
