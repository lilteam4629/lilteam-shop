<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin - <%= settings.shopName %></title>
  <script>
    (function () {
      try {
        if (localStorage.getItem('lilteam_theme') === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    })();
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #100e08;
      --card: #1a160d;
      --border: #3a3220;
      --border-light: #443a22;
      --input: #211c11;
      --gold: #c8a63f;
      --gold-hover: #d9bc5e;
      --text: #f3ecd8;
      --text-2: #d6c9a0;
      --text-3: #a89a6c;
      --text-4: #7a6f47;
      --coral: #e2836f;
    }
    html.light {
      --bg: #faf6eb;
      --card: #ffffff;
      --border: #e2d8bd;
      --border-light: #d6c9a8;
      --input: #f3edd8;
      --gold: #a88022;
      --gold-hover: #946f1a;
      --text: #2a2414;
      --text-2: #4a4028;
      --text-3: #6b5e3d;
      --text-4: #8a7c5c;
      --coral: #c44a3a;
    }
    body { font-family: 'Kanit', sans-serif; }
  </style>
</head>
<body class="bg-[var(--bg)] text-[var(--text)] min-h-screen md:flex">
  <div class="md:hidden sticky top-0 z-40 flex items-center justify-between bg-[var(--card)] border-b border-[var(--border)] px-4 py-3">
    <a href="/admin" class="flex items-center gap-2 font-bold text-base">
      <span class="bg-gradient-to-br from-[var(--gold)] to-[var(--gold-hover)] w-7 h-7 rounded-lg flex items-center justify-center text-sm">L</span>
      Admin Panel
    </a>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-btn" type="button" title="สลับโหมดมืด/สว่าง" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border)]"><span id="theme-toggle-icon">🌙</span></button>
      <button id="admin-menu-btn" type="button" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border)] text-lg">☰</button>
    </div>
  </div>

  <div id="admin-sidebar-backdrop" class="hidden fixed inset-0 bg-black/60 z-40 md:hidden"></div>

  <aside id="admin-sidebar" class="w-64 shrink-0 bg-[var(--card)] border-r border-[var(--border)] min-h-screen p-4 fixed inset-y-0 left-0 z-50 -translate-x-full transition-transform duration-200 overflow-y-auto md:translate-x-0 md:static md:block">
    <div class="flex items-center justify-between mb-8">
      <a href="/admin" class="flex items-center gap-2 font-bold text-lg">
        <span class="bg-gradient-to-br from-[var(--gold)] to-[var(--gold-hover)] w-8 h-8 rounded-lg flex items-center justify-center">L</span>
        Admin Panel
      </a>
      <button id="admin-menu-close" type="button" class="md:hidden w-8 h-8 flex items-center justify-center rounded-lg border border-[var(--border)] text-[var(--text-3)]">✕</button>
    </div>
    <nav class="space-y-1 text-sm">
      <a href="/admin" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='dashboard'?'bg-[var(--input)] text-[var(--gold)]':'' %>">📊 แดชบอร์ด</a>
      <a href="/admin/products" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='products'?'bg-[var(--input)] text-[var(--gold)]':'' %>">🎮 สินค้า</a>
      <a href="/admin/filter-tags" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='filter-tags'?'bg-[var(--input)] text-[var(--gold)]':'' %>">🏷️ ตัวกรองสินค้า</a>
      <a href="/admin/orders" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='orders'?'bg-[var(--input)] text-[var(--gold)]':'' %>">🧾 คำสั่งซื้อ</a>
      <a href="/admin/users" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='users'?'bg-[var(--input)] text-[var(--gold)]':'' %>">👥 สมาชิก</a>
      <a href="/admin/topups" class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='topups'?'bg-[var(--input)] text-[var(--gold)]':'' %>">
        <span>💳 บัญชี</span>
        <% if (typeof pendingTopupCount !== 'undefined' && pendingTopupCount > 0) { %>
          <span class="bg-[var(--gold)] text-[var(--bg)] text-[10px] font-bold rounded-full min-w-[18px] px-1.5 py-0.5 text-center"><%= pendingTopupCount %></span>
        <% } %>
      </a>
      <a href="/admin/coupons" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='coupons'?'bg-[var(--input)] text-[var(--gold)]':'' %>">🏷️ คูปองส่วนลด</a>
      <a href="/admin/announcements" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='announcements'?'bg-[var(--input)] text-[var(--gold)]':'' %>">📢 ประกาศ</a>
      <a href="/admin/settings" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] <%= active==='settings'?'bg-[var(--input)] text-[var(--gold)]':'' %>">⚙️ ตั้งค่าร้าน</a>
      <div class="border-t border-[var(--border)] my-3"></div>
      <a href="/" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)]">🏠 กลับหน้าร้าน</a>
      <a href="/logout" class="block px-3 py-2 rounded-lg hover:bg-[var(--input)] text-rose-400">🚪 ออกจากระบบ</a>
    </nav>
  </aside>

  <div class="flex-1 min-w-0">
    <header class="hidden md:flex bg-[var(--card)]/60 border-b border-[var(--border)] px-6 py-3 items-center justify-between">
      <h1 class="font-semibold"><%= title %></h1>
      <div class="flex items-center gap-3">
        <button id="theme-toggle-btn-desktop" type="button" title="สลับโหมดมืด/สว่าง" class="w-8 h-8 flex items-center justify-center rounded-lg border border-[var(--border-light)] hover:border-[var(--gold)]/60"><span id="theme-toggle-icon-desktop">🌙</span></button>
        <span class="text-sm text-[var(--text-3)]">👤 <%= currentUser.username %></span>
      </div>
    </header>
    <main class="p-4 md:p-6 overflow-x-hidden">
      <h1 class="md:hidden font-semibold text-lg mb-4"><%= title %></h1>
      <% if (messages.success && messages.success.length) { %>
        <% messages.success.forEach(m => { %>
          <div class="bg-emerald-900/60 border border-emerald-600 text-emerald-200 px-4 py-2 rounded-lg mb-4 text-sm"><%= m %></div>
        <% }) %>
      <% } %>
      <% if (messages.error && messages.error.length) { %>
        <% messages.error.forEach(m => { %>
          <div class="bg-rose-900/60 border border-rose-600 text-rose-200 px-4 py-2 rounded-lg mb-4 text-sm"><%= m %></div>
        <% }) %>
      <% } %>
      <%- body %>
    </main>
  </div>

  <script>
    (function () {
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('admin-sidebar-backdrop');
      const openBtn = document.getElementById('admin-menu-btn');
      const closeBtn = document.getElementById('admin-menu-close');
      function openMenu() {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      }
      function closeMenu() {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }
      if (openBtn) openBtn.addEventListener('click', openMenu);
      if (closeBtn) closeBtn.addEventListener('click', closeMenu);
      if (backdrop) backdrop.addEventListener('click', closeMenu);
    })();

    (function () {
      const icons = [document.getElementById('theme-toggle-icon'), document.getElementById('theme-toggle-icon-desktop')].filter(Boolean);
      const buttons = [document.getElementById('theme-toggle-btn'), document.getElementById('theme-toggle-btn-desktop')].filter(Boolean);
      function isLight() { return document.documentElement.classList.contains('light'); }
      function updateIcons() { icons.forEach(function (i) { i.textContent = isLight() ? '☀️' : '🌙'; }); }
      updateIcons();
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.documentElement.classList.toggle('light');
          try { localStorage.setItem('lilteam_theme', isLight() ? 'light' : 'dark'); } catch (e) {}
          updateIcons();
        });
      });
    })();
  </script>
</body>
</html>
