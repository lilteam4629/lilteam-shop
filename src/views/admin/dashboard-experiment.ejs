<%
  const money = value => `฿${Number(value || 0).toLocaleString('th-TH')}`;
  const averageOrder = stats.orderCount ? Math.round(stats.revenue / stats.orderCount) : 0;
  const chartMax = Math.max(1, Number(maxDailyRevenue) || 1);
  const orderStatus = {
    pending: 'รอดำเนินการ', paid: 'ชำระเงินแล้ว', completed: 'สำเร็จ', cancelled: 'ยกเลิก',
  };
%>
<div class="experiment-app">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand">
      <div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div>
      <div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div>
      <button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>
    </div>
    <div class="experiment-sidebar-scroll">
      <div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item active" href="/admin"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span>แดชบอร์ด</span></a></div>
      <div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></svg><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7"/></svg><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M4 12h16M4 19h16"/><path d="M7 5v14"/></svg><span>หมวดหมู่แนะนำ</span></a></div>
      <div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg><span>เติมเงิน & ตรวจสอบ</span><% if (pendingTopupCount) { %><b class="experiment-sidebar-count"><%= pendingTopupCount %></b><% } %></a><a class="experiment-nav-item" href="/admin/coupons"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8h16v8H4z"/><path d="M8 8v8M16 8v8"/></svg><span>คูปองส่วนลด</span></a></div>
      <div class="experiment-nav-group"><div class="experiment-nav-label">ผู้ใช้งาน & ลูกค้า</div><a class="experiment-nav-item" href="/admin/users"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3"/><path d="M5 20c.8-3 3-5 7-5s6.2 2 7 5"/></svg><span>จัดการสมาชิก</span></a></div>
      <div class="experiment-nav-group"><div class="experiment-nav-label">ระบบเสริม</div><a class="experiment-nav-item" href="/admin/minigame"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2"/></svg><span>มินิเกม</span></a><a class="experiment-nav-item" href="/admin/slip-verification"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="m9 12 2 2 4-4"/></svg><span>ตรวจสอบอัตโนมัติ</span></a></div>
    </div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 11 8-7 8 7v8H4z"/><path d="M9 19v-5h6v5"/></svg><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>

  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">ภาพรวมร้านค้า</div><h1>ภาพรวมร้านค้า</h1><p>ยอดขาย สินค้า และงานที่ต้องตรวจสอบจากข้อมูลร้าน</p></div><div class="experiment-actions"><a href="/admin/products/new" class="experiment-button primary">+ เพิ่มสินค้าใหม่</a><a href="/admin/topups" class="experiment-button">ตรวจสอบเติมเงิน<% if (pendingTopupCount) { %> <b>(<%= pendingTopupCount %>)</b><% } %></a><a href="/admin/settings" class="experiment-button">ตั้งค่าร้าน</a></div></div>

      <div class="experiment-grid experiment-kpis">
        <div class="experiment-card experiment-kpi primary"><div class="experiment-kpi-icon">↗</div><div class="experiment-kpi-label">รายได้ 7 วันล่าสุด</div><div class="experiment-kpi-value"><%= money(stats.revenue7Days) %></div><div class="experiment-kpi-note">30 วันที่ผ่านมา: <b><%= money(stats.revenue30Days) %></b></div></div>
        <div class="experiment-card experiment-kpi"><div class="experiment-kpi-icon">฿</div><div class="experiment-kpi-label">รายได้วันนี้ (Today)</div><div class="experiment-kpi-value"><%= money(stats.revenueToday) %></div><div class="experiment-kpi-note"><span class="experiment-live-dot"></span> นับตามเวลาประเทศไทย (ICT)</div></div>
        <div class="experiment-card experiment-kpi"><div class="experiment-kpi-icon">#</div><div class="experiment-kpi-label">คำสั่งซื้อสะสม</div><div class="experiment-kpi-value"><%= stats.orderCount.toLocaleString('th-TH') %> <small style="font:500 12px var(--ex-font)">รายการ</small></div><div class="experiment-kpi-note">ยอดขายรวม <b><%= money(stats.revenue) %></b></div></div>
        <div class="experiment-card experiment-kpi"><div class="experiment-kpi-icon purple">+1</div><div class="experiment-kpi-label">ลูกค้าใหม่วันนี้</div><div class="experiment-kpi-value"><%= stats.newCustomersToday.toLocaleString('th-TH') %> <small style="font:500 12px var(--ex-font)">คน</small></div><div class="experiment-kpi-note">30 วันล่าสุด <b><%= stats.newCustomers30Days.toLocaleString('th-TH') %> คน</b></div></div>
      </div>

      <div class="experiment-summary"><div class="experiment-summary-item">ยอดขายรวมทั้งหมด <strong><%= money(stats.revenue) %></strong></div><div class="experiment-summary-item">อัตราเฉลี่ยต่อบิล <strong><%= money(averageOrder) %></strong></div><div class="experiment-summary-item">สินค้าในระบบ <strong><%= stats.productCount.toLocaleString('th-TH') %> รายการ</strong></div><div class="experiment-summary-item">สต๊อกพร้อมขาย <strong><%= stats.availableStock.toLocaleString('th-TH') %> รายการ</strong></div></div>

      <% if (lowStockProducts.length) { %>
        <section class="experiment-stock-alert" data-experiment-stock-alert aria-labelledby="experiment-stock-alert-title">
          <div class="experiment-alert-head">
            <div aria-hidden="true">▲</div>
            <div>
              <strong id="experiment-stock-alert-title">สินค้าสต๊อกใกล้หมด (<%= lowStockProducts.length %> รายการ)</strong>
              <p>กดชื่อสินค้าเพื่อเปิดหน้าจัดการสต๊อกโดยตรง</p>
            </div>
            <div class="experiment-alert-tools">
              <button type="button" data-experiment-alert-toggle aria-expanded="false" aria-controls="experiment-stock-alert-list">ดูทั้งหมด</button>
            </div>
          </div>
          <div class="experiment-alert-list" id="experiment-stock-alert-list">
            <% lowStockProducts.forEach(product => { %>
              <a class="experiment-stock-chip" href="/admin/products/<%= product.id %>/stock">
                <span class="experiment-stock-chip-name" title="<%= product.title %>"><%= product.title %></span>
                <em><%= (product.stockCount || 0) === 0 ? 'หมดแล้ว' : `${product.stockCount} เหลือ` %></em>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <section class="experiment-card experiment-luxury-menu" aria-labelledby="experiment-luxury-menu-title">
        <div class="experiment-luxury-ribbons" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
        <div class="experiment-luxury-menu-head"><div><div class="experiment-luxury-eyebrow">CURATED SHORTCUTS · LILTEAM</div><h2 id="experiment-luxury-menu-title">LILTeam Menu</h2><p>เมนูทางลัดตกแต่งสำหรับจัดการร้าน ใช้งานได้จริงจากจุดเดียว</p></div><span class="experiment-luxury-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></span></div>
        <div class="experiment-luxury-grid">
          <a class="experiment-luxury-card ready" href="/admin/products" aria-label="สินค้าในร้าน พร้อมใช้"><span class="experiment-luxury-card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 8 8-4 8 4-8 4-8-4Z"/><path d="M4 8v10l8 4 8-4V8M12 12v10"/></svg></span><span class="experiment-luxury-code">CATALOG · <%= stats.productCount.toLocaleString('th-TH') %> รายการ</span><strong>สินค้าในร้าน</strong><small>ราคา สต๊อก และสถานะ</small><em class="experiment-luxury-status ready">พร้อมใช้</em><span class="experiment-luxury-arrow" aria-hidden="true">↗</span></a>
          <a class="experiment-luxury-card" href="/admin/orders" aria-label="คำสั่งซื้อ"><span class="experiment-luxury-card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span><span class="experiment-luxury-code">ORDERS · NEXT</span><strong>คำสั่งซื้อ</strong><small>ติดตามรายการสั่งซื้อ</small><span class="experiment-luxury-arrow" aria-hidden="true">↗</span></a>
          <a class="experiment-luxury-card" href="/admin/topups" aria-label="เติมเงินและตรวจสอบ"><span class="experiment-luxury-card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M8 15h3"/></svg></span><span class="experiment-luxury-code">WALLET · <%= pendingTopupCount || 0 %> PENDING</span><strong>เติมเงิน & ตรวจสอบ</strong><small>ตรวจสอบหลักฐานการโอน</small><span class="experiment-luxury-arrow" aria-hidden="true">↗</span></a>
          <a class="experiment-luxury-card" href="/admin/settings" aria-label="ตั้งค่าร้าน"><span class="experiment-luxury-card-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="4"/></svg></span><span class="experiment-luxury-code">STUDIO · STYLE</span><strong>ตั้งค่าร้าน</strong><small>แต่งร้านและระบบหลัก</small><span class="experiment-luxury-arrow" aria-hidden="true">↗</span></a>
        </div>
      </section>

      <div class="experiment-grid experiment-section-grid">
        <section class="experiment-card experiment-panel experiment-chart-card"><div class="experiment-panel-head"><div><h2>กราฟยอดขาย 7 วันล่าสุด</h2><p>สรุปยอดขายรายวันตามเวลาประเทศไทย</p></div><div class="experiment-chart-meta"><small>รวม 7 วัน</small><strong><%= money(stats.revenue7Days) %></strong></div></div><div class="experiment-chart" aria-label="กราฟยอดขาย 7 วันล่าสุด"><% dailySales.forEach(day => { const height = Math.max(4, Math.round((day.amount / chartMax) * 180)); %><div class="experiment-chart-day" title="<%= day.label %>: <%= money(day.amount) %>"><div class="experiment-chart-bar" style="height:<%= height %>px"></div><span><%= day.label %></span></div><% }) %></div></section>
        <section class="experiment-card experiment-panel"><div class="experiment-panel-head"><div><h2>🏆 สินค้าขายดี</h2><p>เรียงตามจำนวนที่ขายได้</p></div><a class="experiment-table-link" href="/admin/products">ดูทั้งหมด →</a></div><div class="experiment-product-list"><% if (topProducts.length) { topProducts.forEach((product, index) => { %><a class="experiment-product" href="/admin/products/<%= product.id %>/edit"><span class="experiment-rank"><%= index + 1 %></span><span class="experiment-product-art">P</span><span class="experiment-product-info"><strong><%= product.title %></strong><small><%= money(product.revenue) %></small></span><span class="experiment-product-sales"><%= product.units %> ชิ้น</span></a><% }) } else { %><div style="padding:24px 8px;color:var(--ex-muted);font-size:12px;text-align:center">ยังไม่มีข้อมูลการขาย</div><% } %></div></section>
      </div>

      <section class="experiment-card experiment-panel experiment-orders"><div class="experiment-panel-head"><div><h2>คำสั่งซื้อล่าสุด</h2><p>รายการคำสั่งซื้อที่เข้ามาในระบบ</p></div><div class="experiment-table-actions"><input class="experiment-table-search" type="search" placeholder="ค้นหารหัสคำสั่งซื้อ..." aria-label="ค้นหารหัสคำสั่งซื้อ" data-experiment-order-search /><a href="/admin/orders" class="experiment-button small">ดูทั้งหมด →</a></div></div><div class="experiment-table-wrap"><table class="experiment-table"><thead><tr><th>รหัสคำสั่งซื้อ</th><th>วันที่ / เวลา</th><th>ยอดชำระ</th><th>สถานะ</th><th>การจัดการ</th></tr></thead><tbody><% if (recentOrders.length) { recentOrders.forEach(order => { %><tr data-experiment-order-row><td><%= order.id %></td><td><%= new Date(order.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></td><td><%= money(order.total) %></td><td><span class="experiment-status"><%= orderStatus[order.status] || order.status || 'รอตรวจสอบ' %></span></td><td><a class="experiment-table-link" href="/admin/orders/<%= order.id %>">ดูรายละเอียด →</a></td></tr><% }) } else { %><tr><td colspan="5" style="text-align:center;color:var(--ex-muted);padding:30px">ยังไม่มีคำสั่งซื้อ</td></tr><% } %></tbody></table></div></section>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a class="active" href="/admin">⌂<span>ภาพรวม</span></a><a href="/admin/products">▦<span>สินค้า</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/topups">฿<span>เติมเงิน</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>
<script>
  (function () {
    var input = document.querySelector('[data-experiment-order-search]');
    if (!input) return;
    input.addEventListener('input', function () {
      var query = input.value.toLowerCase().trim();
      document.querySelectorAll('[data-experiment-order-row]').forEach(function (row) {
        row.hidden = query && !row.textContent.toLowerCase().includes(query);
      });
    });
  })();
</script>
