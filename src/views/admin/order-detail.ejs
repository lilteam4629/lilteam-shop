<a href="/admin/orders" class="text-sm text-[var(--gold)]">← กลับไปหน้าคำสั่งซื้อ</a>
<h2 class="font-semibold text-lg mt-2 mb-1">คำสั่งซื้อ #<%= order.id %></h2>
<p class="text-[var(--text-4)] text-sm mb-6">ผู้ซื้อ: <%= buyer ? buyer.username : '-' %> &middot; <%= new Date(order.createdAt).toLocaleString('th-TH') %></p>

<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-3">
    <% itemsWithCreds.forEach(i => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4">
        <div class="flex justify-between mb-2"><span class="font-medium"><%= i.title %></span><span class="text-[var(--gold)]"><%= i.price.toLocaleString() %> ฿</span></div>
        <% if (i.fulfillmentMode === 'contact') { %>
          <div class="bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-lg p-3 text-sm">
            <div class="font-medium text-[var(--gold)]">ลูกค้าต้องติดต่อร้านเพื่อรับสินค้า</div>
            <% if (i.fulfillmentInstructions) { %><div class="text-[var(--text-3)] whitespace-pre-line mt-1"><%= i.fulfillmentInstructions %></div><% } %>
          </div>
        <% } else if (i.credentials) { %>
          <div class="bg-[var(--bg)] border border-[var(--border)] rounded-lg p-3 text-sm font-mono">
            <%= i.credentials.username %> / <%= i.credentials.password %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 space-y-3 h-fit">
    <div class="flex justify-between text-sm"><span class="text-[var(--text-4)]">ยอดรวมสินค้า</span><span><%= order.subtotal.toLocaleString() %> ฿</span></div>
    <% if (order.discount > 0) { %>
      <div class="flex justify-between text-sm text-emerald-400"><span>ส่วนลด</span><span>-<%= order.discount.toLocaleString() %> ฿</span></div>
    <% } %>
    <div class="flex justify-between font-bold pt-2 border-t border-[var(--border)]"><span>ยอดชำระ</span><span class="text-[var(--gold)]"><%= order.total.toLocaleString() %> ฿</span></div>
    <form action="/admin/orders/<%= order.id %>/status" method="post" class="pt-3 border-t border-[var(--border)] space-y-2">
      <label class="block text-xs text-[var(--text-4)]">อัปเดตสถานะ</label>
      <select name="status" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm">
        <% ['completed','pending','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= order.status===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">บันทึก</button>
    </form>
  </div>
</div>
