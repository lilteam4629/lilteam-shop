<a href="/admin/orders" class="text-sm text-[#c8a63f]">← กลับไปหน้าคำสั่งซื้อ</a>
<h2 class="font-semibold text-lg mt-2 mb-1">คำสั่งซื้อ #<%= order.id %></h2>
<p class="text-[#7a6f47] text-sm mb-6">ผู้ซื้อ: <%= buyer ? buyer.username : '-' %> &middot; <%= new Date(order.createdAt).toLocaleString('th-TH') %></p>

<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-3">
    <% itemsWithCreds.forEach(i => { %>
      <div class="bg-[#1a160d] border border-[#3a3220] rounded-xl p-4">
        <div class="flex justify-between mb-2"><span class="font-medium"><%= i.title %></span><span class="text-[#c8a63f]"><%= i.price.toLocaleString() %> ฿</span></div>
        <% if (i.credentials) { %>
          <div class="bg-[#100e08] border border-[#3a3220] rounded-lg p-3 text-sm font-mono">
            <%= i.credentials.username %> / <%= i.credentials.password %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
  <div class="bg-[#1a160d] border border-[#3a3220] rounded-xl p-5 space-y-3 h-fit">
    <div class="flex justify-between text-sm"><span class="text-[#7a6f47]">ยอดรวมสินค้า</span><span><%= order.subtotal.toLocaleString() %> ฿</span></div>
    <% if (order.discount > 0) { %>
      <div class="flex justify-between text-sm text-emerald-400"><span>ส่วนลด</span><span>-<%= order.discount.toLocaleString() %> ฿</span></div>
    <% } %>
    <div class="flex justify-between font-bold pt-2 border-t border-[#3a3220]"><span>ยอดชำระ</span><span class="text-[#c8a63f]"><%= order.total.toLocaleString() %> ฿</span></div>
    <form action="/admin/orders/<%= order.id %>/status" method="post" class="pt-3 border-t border-[#3a3220] space-y-2">
      <label class="block text-xs text-[#7a6f47]">อัปเดตสถานะ</label>
      <select name="status" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2 text-sm">
        <% ['completed','pending','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= order.status===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
      <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-medium rounded-lg py-2 text-sm">บันทึก</button>
    </form>
  </div>
</div>
