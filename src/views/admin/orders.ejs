<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
      <tr><th class="p-3">รหัส</th><th class="p-3">ผู้ซื้อ</th><th class="p-3">วันที่</th><th class="p-3">ยอดรวม</th><th class="p-3">สถานะ</th><th class="p-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)]">
      <% orders.forEach(o => { %>
        <tr class="hover:bg-[var(--input)]/50">
          <td class="p-3">#<%= o.id %></td>
          <td class="p-3"><%= o.buyer ? o.buyer.username : '-' %></td>
          <td class="p-3 text-[var(--text-3)]"><%= new Date(o.createdAt).toLocaleString('th-TH') %></td>
          <td class="p-3"><%= o.total.toLocaleString() %> ฿</td>
          <td class="p-3"><%= o.status %></td>
          <td class="p-3 text-right"><a href="/admin/orders/<%= o.id %>" class="text-[var(--gold)]">ดูรายละเอียด</a></td>
        </tr>
      <% }) %>
      <% if (!orders.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="6">ยังไม่มีคำสั่งซื้อ</td></tr><% } %>
    </tbody>
  </table>
</div>
