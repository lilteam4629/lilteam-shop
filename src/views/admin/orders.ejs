<div class="bg-[#1a160d] border border-[#3a3220] rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-[#7a6f47] text-left border-b border-[#3a3220]">
      <tr><th class="p-3">รหัส</th><th class="p-3">ผู้ซื้อ</th><th class="p-3">วันที่</th><th class="p-3">ยอดรวม</th><th class="p-3">สถานะ</th><th class="p-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-[#3a3220]">
      <% orders.forEach(o => { %>
        <tr class="hover:bg-[#211c11]/50">
          <td class="p-3">#<%= o.id %></td>
          <td class="p-3"><%= o.buyer ? o.buyer.username : '-' %></td>
          <td class="p-3 text-[#a89a6c]"><%= new Date(o.createdAt).toLocaleString('th-TH') %></td>
          <td class="p-3"><%= o.total.toLocaleString() %> ฿</td>
          <td class="p-3"><%= o.status %></td>
          <td class="p-3 text-right"><a href="/admin/orders/<%= o.id %>" class="text-[#c8a63f]">ดูรายละเอียด</a></td>
        </tr>
      <% }) %>
      <% if (!orders.length) { %><tr><td class="p-3 text-[#7a6f47]" colspan="6">ยังไม่มีคำสั่งซื้อ</td></tr><% } %>
    </tbody>
  </table>
</div>
