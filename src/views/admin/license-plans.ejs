<% if (!licenseEnabled) { %>
  <div class="bg-amber-900/40 border border-amber-500/60 text-amber-200 px-4 py-3 rounded-xl mb-6 text-sm max-w-xl">
    ⚠️ ยังไม่ได้ตั้งค่า <code class="font-mono">LICENSE_SECRET</code> ในร้านนี้ — ต้องตั้งก่อนถึงจะออกคีย์ขายได้ (ดูวิธีใน README.md หัวข้อ "ให้คนอื่นเช่าระบบนี้ไปเปิดร้านเอง") ตั้งเฉพาะร้านนี้ (ร้านผู้ขาย) เท่านั้น <b>อย่าเปิด LICENSE_GATE ที่นี่</b> ไม่งั้นร้านคุณจะถูกล็อกเอง
  </div>
<% } %>

<div class="grid lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
    <div class="p-4 border-b border-[var(--border)]"><h3 class="font-semibold">📦 แพ็กเกจเช่าเว็บ (ลูกค้าเห็นที่หน้า /rent-website)</h3></div>
    <table class="w-full text-sm">
      <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
        <tr><th class="p-3">จำนวนวัน</th><th class="p-3">ราคา (฿)</th><th class="p-3">สถานะ</th><th class="p-3"></th></tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% plans.forEach(p => { %>
          <tr>
            <td class="p-3"><%= p.days %> วัน</td>
            <td class="p-3">฿<%= p.price.toLocaleString() %></td>
            <td class="p-3"><%= p.active ? '🟢 เปิดขาย' : '⚪ ปิดขาย' %></td>
            <td class="p-3 text-right space-x-2 whitespace-nowrap">
              <form action="/admin/license-plans/<%= p.id %>/toggle" method="post" class="inline"><button class="text-[var(--text-3)] text-xs"><%= p.active ? 'ปิดขาย' : 'เปิดขาย' %></button></form>
              <form action="/admin/license-plans/<%= p.id %>/delete" method="post" class="inline" onsubmit="return confirm('ลบแพ็กเกจนี้?')"><button class="text-rose-400 text-xs">ลบ</button></form>
            </td>
          </tr>
        <% }) %>
        <% if (!plans.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="4">ยังไม่มีแพ็กเกจ</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 h-fit">
    <h3 class="font-semibold mb-3">➕ เพิ่มแพ็กเกจ</h3>
    <form action="/admin/license-plans" method="post" class="space-y-3">
      <input type="number" min="1" name="days" required placeholder="จำนวนวัน เช่น 30" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <input type="number" min="0" name="price" required placeholder="ราคา (฿)" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">เพิ่มแพ็กเกจ</button>
    </form>
  </div>
</div>

<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
  <div class="p-4 border-b border-[var(--border)]"><h3 class="font-semibold">📜 ประวัติการขายคีย์</h3></div>
  <table class="w-full text-sm">
    <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
      <tr><th class="p-3">ผู้ซื้อ</th><th class="p-3">จำนวนวัน</th><th class="p-3">ราคา</th><th class="p-3">คีย์</th><th class="p-3">เวลา</th></tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)]">
      <% sales.forEach(sale => { %>
        <tr>
          <td class="p-3"><%= sale.username %></td>
          <td class="p-3"><%= sale.days %> วัน</td>
          <td class="p-3 text-emerald-400">฿<%= sale.price.toLocaleString() %></td>
          <td class="p-3 font-mono text-xs break-all"><%= sale.key %></td>
          <td class="p-3 text-[var(--text-4)] text-xs"><%= new Date(sale.createdAt).toLocaleString('th-TH') %></td>
        </tr>
      <% }) %>
      <% if (!sales.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="5">ยังไม่มีการขาย</td></tr><% } %>
    </tbody>
  </table>
</div>
