<% if (!licenseEnabled) { %>
  <div class="bg-amber-900/40 border border-amber-500/60 text-amber-200 px-4 py-3 rounded-xl mb-6 text-sm max-w-xl">
    ⚠️ ยังไม่ได้ตั้งค่า <code class="font-mono">LICENSE_SECRET</code> ในร้านนี้ — ต้องตั้งก่อนถึงจะออกคีย์ขายได้ (ดูวิธีใน README.md หัวข้อ "ให้คนอื่นเช่าระบบนี้ไปเปิดร้านเอง") ตั้งเฉพาะร้านนี้ (ร้านผู้ขาย) เท่านั้น <b>อย่าเปิด LICENSE_GATE ที่นี่</b> ไม่งั้นร้านคุณจะถูกล็อกเอง
  </div>
<% } %>

<div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
  <div>
    <h3 class="font-semibold mb-1">🔄 อัพเดตเว็บลูกค้าทั้งหมด</h3>
    <p class="text-xs text-[var(--text-3)]">สั่งให้เว็บลูกค้าทุกคนดึงโค้ดล่าสุดจาก branch "release" มาใช้ทันที ไม่ต้องใส่คีย์ ไม่ต้องให้ลูกค้ากดอะไร</p>
  </div>
  <form action="/admin/license-plans/update-all" method="post" onsubmit="return confirm('อัพเดตเว็บลูกค้าทุกคนที่รองรับตอนนี้เลยใช่ไหม?')">
    <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg px-4 py-2 text-sm whitespace-nowrap">🔄 อัพเดตทั้งหมดตอนนี้</button>
  </form>
</div>

<details class="mb-6 text-xs text-[var(--text-4)]">
  <summary class="cursor-pointer select-none">⚙️ ขั้นสูง: ปล่อยโค้ดใหม่เข้า release branch เอง (ไม่จำเป็นต้องใช้ — ปกติแค่บอกแอดมิน/ผู้พัฒนาให้ปล่อยอัพเดตก็พอ)</summary>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 mt-2 flex items-center justify-between flex-wrap gap-3">
    <div>
      <% if (releaseEnabled) { %>
        <p>ดึงโค้ดล่าสุดจาก branch หลักของคุณเข้า branch "release" (ทำครั้งเดียว เว็บลูกค้าจะอัพเดตเองอัตโนมัติ ไม่ต้องกด "อัพเดตทั้งหมด" ด้านบนซ้ำ)</p>
      <% } else { %>
        <p class="text-amber-400">⚠️ ยังไม่ได้ตั้งค่า <code class="font-mono">GITHUB_TOKEN</code> ในร้าน — ไม่จำเป็นต้องตั้งก็ได้ ถ้าไม่ได้ต้องการทำขั้นตอนนี้เอง</p>
      <% } %>
    </div>
    <form action="/admin/license-plans/release-update" method="post" onsubmit="return confirm('ปล่อยโค้ดล่าสุดเข้า release branch เลยใช่ไหม?')">
      <button <%= releaseEnabled ? '' : 'disabled' %> class="bg-[var(--input)] hover:bg-[#2b2416] disabled:opacity-40 border border-[var(--border-light)] rounded-lg px-4 py-2 text-sm whitespace-nowrap">ปล่อยโค้ดเข้า release</button>
    </form>
  </div>
</details>

<div class="grid lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
    <div class="p-4 border-b border-[var(--border)]"><h3 class="font-semibold">📦 แพ็กเกจเช่าเว็บ (ลูกค้าเห็นที่หน้า /rent-website)</h3></div>
    <table class="w-full text-sm min-w-[480px]">
      <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
        <tr><th class="p-3 whitespace-nowrap">จำนวนวัน</th><th class="p-3 whitespace-nowrap">ราคา (฿)</th><th class="p-3 whitespace-nowrap">สถานะ</th><th class="p-3"></th></tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% plans.forEach(p => { %>
          <tr>
            <form id="edit-plan-<%= p.id %>" action="/admin/license-plans/<%= p.id %>/edit" method="post"></form>
            <td class="p-3"><input form="edit-plan-<%= p.id %>" type="number" min="1" name="days" value="<%= p.days %>" class="w-20 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1 text-sm" /> วัน</td>
            <td class="p-3">฿<input form="edit-plan-<%= p.id %>" type="number" min="0" name="price" value="<%= p.price %>" class="w-24 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1 text-sm" /></td>
            <td class="p-3"><%= p.active ? '🟢 เปิดขาย' : '⚪ ปิดขาย' %></td>
            <td class="p-3 text-right space-x-2 whitespace-nowrap">
              <button form="edit-plan-<%= p.id %>" class="text-[var(--gold)] text-xs">บันทึก</button>
              <form action="/admin/license-plans/<%= p.id %>/toggle" method="post" class="inline"><button class="text-[var(--text-3)] text-xs"><%= p.active ? 'ปิดขาย' : 'เปิดขาย' %></button></form>
              <form action="/admin/license-plans/<%= p.id %>/delete" method="post" class="inline" onsubmit="return confirm('ลบแพ็กเกจนี้?')"><button class="text-rose-400 text-xs">ลบ</button></form>
            </td>
          </tr>
        <% }) %>
        <% if (!plans.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="4">ยังไม่มีแพ็กเกจ</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 h-fit">
    <h3 class="font-semibold mb-3">➕ เพิ่มแพ็กเกจ</h3>
    <form action="/admin/license-plans" method="post" class="space-y-3">
      <input type="number" min="1" name="days" required placeholder="จำนวนวัน เช่น 30" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <input type="number" min="0" name="price" required placeholder="ราคา (฿)" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">เพิ่มแพ็กเกจ</button>
    </form>
  </div>
</div>

<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
  <div class="p-4 border-b border-[var(--border)]"><h3 class="font-semibold">📜 ประวัติการขายคีย์ / เว็บเช่าทั้งหมด</h3></div>
  <table class="w-full text-sm min-w-[1000px]">
    <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
      <tr>
        <th class="p-3 whitespace-nowrap">ผู้ซื้อ</th>
        <th class="p-3 whitespace-nowrap">จำนวนวัน</th>
        <th class="p-3 whitespace-nowrap">ราคา</th>
        <th class="p-3 whitespace-nowrap">ประเภท</th>
        <th class="p-3 whitespace-nowrap">เหลือเวลา</th>
        <th class="p-3 whitespace-nowrap">คีย์</th>
        <th class="p-3 whitespace-nowrap">เวลาซื้อ</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)]">
      <% sales.forEach(sale => { %>
        <tr>
          <td class="p-3 whitespace-nowrap"><%= sale.username %></td>
          <td class="p-3 whitespace-nowrap"><%= sale.days %> วัน</td>
          <td class="p-3 text-emerald-400 whitespace-nowrap">฿<%= sale.price.toLocaleString() %></td>
          <td class="p-3 text-xs max-w-[220px]">
            <% if (sale.type === 'new_site') { %>
              <% if (!sale.provisioning || sale.provisioning.status === 'creating') { %>
                <span class="text-amber-400 whitespace-nowrap">⏳ กำลังสร้างเว็บ</span>
              <% } else if (sale.provisioning.status === 'success') { %>
                <a href="<%= sale.provisioning.url %>" target="_blank" class="text-emerald-400 underline break-all">✓ <%= sale.provisioning.url %></a>
              <% } else { %>
                <details>
                  <summary class="text-[var(--coral)] cursor-pointer select-none">✕ ล้มเหลว: <%= sale.provisioning.error %></summary>
                  <pre class="whitespace-pre-wrap text-[10px] text-[var(--text-4)] mt-1 max-w-xs"><%= (sale.provisioning.log || []).join('\n') %></pre>
                </details>
              <% } %>
            <% } else { %>
              <span class="text-[var(--text-4)] whitespace-nowrap">ต่ออายุ</span>
            <% } %>
          </td>
          <td class="p-3 text-xs font-mono whitespace-nowrap">
            <% if (sale.exp) { %>
              <span class="countdown" data-exp="<%= sale.exp %>">…</span>
            <% } else { %>
              <span class="text-[var(--text-4)]">-</span>
            <% } %>
          </td>
          <td class="p-3 font-mono text-xs break-all max-w-[200px]"><%= sale.key %></td>
          <td class="p-3 text-[var(--text-4)] text-xs whitespace-nowrap"><%= new Date(sale.createdAt).toLocaleString('th-TH') %></td>
          <td class="p-3 text-right whitespace-nowrap">
            <% if (sale.type === 'new_site' && sale.provisioning && sale.provisioning.status === 'success') { %>
              <% if (sale.provisioning.projectToken) { %>
                <form action="/admin/license-plans/sale/<%= sale.id %>/sync" method="post" class="inline">
                  <button class="text-xs text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-2 py-1">🔄 อัพเดตเว็บนี้</button>
                </form>
              <% } else { %>
                <span class="text-[10px] text-[var(--text-4)]" title="เว็บเก่าก่อนมีฟีเจอร์นี้ ต้องให้ลูกค้ากดซิงค์เองที่หน้าใบเสร็จ">-</span>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!sales.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="8">ยังไม่มีการขาย</td></tr><% } %>
    </tbody>
  </table>
</div>

<script>
  function fmtCountdown(ms) {
    if (ms <= 0) return '✕ หมดอายุแล้ว';
    const s = Math.floor(ms / 1000);
    const d = Math.floor(s / 86400);
    const h = Math.floor((s % 86400) / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    if (d > 0) return `${d} วัน ${h} ชม.`;
    if (h > 0) return `${h} ชม. ${m} นาที`;
    if (m > 0) return `${m} นาที ${sec} วิ`;
    return `${sec} วินาที`;
  }
  function tickCountdowns() {
    document.querySelectorAll('.countdown[data-exp]').forEach(el => {
      const exp = Number(el.dataset.exp);
      const ms = exp - Date.now();
      el.textContent = fmtCountdown(ms);
      el.classList.toggle('text-[var(--coral)]', ms <= 0);
      el.classList.toggle('text-emerald-400', ms > 0);
    });
  }
  tickCountdowns();
  setInterval(tickCountdowns, 1000);
</script>
