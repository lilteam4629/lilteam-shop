<div class="hs-studio">
 <header class="hs-hero"><div><span>STOREFRONT COLLECTIONS</span><h1>จัดหน้าร้านให้เป็นระเบียบ</h1><p>สร้างและเรียงแถวสินค้า ลูกค้าจะเห็นตามลำดับจากบนลงล่าง</p></div><button type="button" data-open-create>＋ สร้างหมวดใหม่</button></header>
 <section class="hs-stats"><div><small>หมวดบนหน้าร้าน</small><b><%=homeSections.length%></b></div><div><small>อัปเดตอัตโนมัติ</small><b><%=homeSections.filter(s=>s.mode!=='manual').length%></b></div><div><small>เลือกสินค้าเอง</small><b><%=homeSections.filter(s=>s.mode==='manual').length%></b></div></section>
 <main class="hs-board"><header><div><i></i><span><b>ลำดับบนหน้าร้าน</b><small>รายการแรกอยู่ด้านบนสุด</small></span></div><em><%=homeSections.length%> หมวด</em></header>
 <%if(!homeSections.length){%><div class="hs-empty"><b>◇</b><h2>หน้าร้านยังไม่มีหมวดสินค้า</h2><p>เริ่มด้วยการสร้างหมวดแรกของคุณ</p><button type="button" data-open-create>สร้างหมวดแรก</button></div><%}%>
 <div class="hs-stack"><%homeSections.forEach((s,i)=>{const chosen=products.filter(p=>(s.productIds||[]).includes(p.id));const preview=s.mode==='manual'?chosen:products.slice(0,s.limit);%>
  <article class="hs-card"><div class="hs-rank"><small>ลำดับ</small><b><%=String(i+1).padStart(2,'0')%></b></div><div class="hs-info"><div><h3><%=s.title%></h3><span class="<%=s.mode==='manual'?'manual':''%>"><%=s.mode==='manual'?'เลือกเอง':'อัตโนมัติ'%></span></div><p><%=s.mode==='manual'?`${chosen.length} สินค้าที่เลือกไว้`:`สินค้าใหม่ล่าสุด ${s.limit} รายการ`%></p><div class="hs-previews"><%preview.slice(0,6).forEach(p=>{%><i><%if(p.images&&p.images[0]){%><img src="<%=p.images[0]%>" alt="" loading="lazy"><%}else{%>◇<%}%></i><%})%><%if(preview.length>6){%><em>+<%=preview.length-6%></em><%}%></div></div>
   <div class="hs-controls"><div><form action="/admin/home-sections/<%=s.id%>/move" method="post"><input type="hidden" name="direction" value="up"><button title="เลื่อนขึ้น" <%=i===0?'disabled':''%>>↑</button></form><form action="/admin/home-sections/<%=s.id%>/move" method="post"><input type="hidden" name="direction" value="down"><button title="เลื่อนลง" <%=i===homeSections.length-1?'disabled':''%>>↓</button></form></div><button type="button" data-edit="<%=s.id%>">ตั้งค่า</button></div>
   <div class="hs-editor" id="editor-<%=s.id%>"><form action="/admin/home-sections/<%=s.id%>/edit" method="post" class="hs-form"><div class="hs-form-grid"><label><span>ชื่อหมวดหมู่</span><input name="title" value="<%=s.title%>" required></label><label><span>รูปแบบสินค้า</span><select name="mode" class="section-mode-select"><option value="newest" <%=s.mode!=='manual'?'selected':''%>>สินค้าใหม่ล่าสุดอัตโนมัติ</option><option value="manual" <%=s.mode==='manual'?'selected':''%>>เลือกสินค้าเอง</option></select></label></div><label class="section-limit-field" <%=s.mode==='manual'?'hidden':''%>><span>จำนวนสินค้าที่แสดง</span><input type="number" name="limit" min="1" max="30" value="<%=s.limit%>"></label><%- include('partials/home-section-picker',{products,selected:s.productIds||[],visible:s.mode==='manual'}) %><div class="hs-actions"><button type="button" data-close-editor>ยกเลิก</button><button type="submit">บันทึกการเปลี่ยนแปลง</button></div></form><form action="/admin/home-sections/<%=s.id%>/delete" method="post" data-confirm="ต้องการลบหมวดหมู่ '<%=s.title%>' ใช่หรือไม่?" class="hs-delete"><button>ลบหมวดนี้</button></form></div>
  </article><%})%></div></main>
</div>
<div class="hs-drawer" id="hs-create"><button class="hs-backdrop" type="button" data-close-create></button><aside><header><div><span>NEW COLLECTION</span><h2>สร้างหมวดหน้าร้าน</h2></div><button type="button" data-close-create>✕</button></header><form action="/admin/home-sections" method="post" class="hs-form"><label><span>ชื่อหมวดหมู่</span><input name="title" required placeholder="เช่น สินค้าแนะนำ"></label><label><span>รูปแบบสินค้า</span><select name="mode" class="section-mode-select"><option value="newest">สินค้าใหม่ล่าสุดอัตโนมัติ</option><option value="manual">เลือกสินค้าเอง</option></select></label><label class="section-limit-field"><span>จำนวนสินค้าที่แสดง</span><input type="number" name="limit" min="1" max="30" value="5"></label><%- include('partials/home-section-picker',{products,selected:[],visible:false}) %><button class="hs-submit">สร้างหมวดหมู่</button></form></aside></div>
<script>(function(){const d=document.getElementById('hs-create'),toggle=o=>{d.classList.toggle('open',o);document.body.style.overflow=o?'hidden':''};document.querySelectorAll('[data-open-create]').forEach(b=>b.onclick=()=>toggle(true));document.querySelectorAll('[data-close-create]').forEach(b=>b.onclick=()=>toggle(false));document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>document.getElementById('editor-'+b.dataset.edit).classList.toggle('open'));document.querySelectorAll('[data-close-editor]').forEach(b=>b.onclick=()=>b.closest('.hs-editor').classList.remove('open'));document.querySelectorAll('.hs-form').forEach(f=>{const m=f.querySelector('.section-mode-select'),l=f.querySelector('.section-limit-field'),p=f.querySelector('.section-products-field');m?.addEventListener('change',()=>{const manual=m.value==='manual';if(l)l.hidden=manual;if(p)p.hidden=!manual});f.querySelector('[data-product-search]')?.addEventListener('input',e=>f.querySelectorAll('[data-product-card]').forEach(c=>c.hidden=!c.dataset.name.includes(e.target.value.trim().toLowerCase())))})})();</script>
