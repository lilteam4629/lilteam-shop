<!-- Home Sections Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">หมวดหมู่สินค้าหน้าแรก</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">จัดระเบียบและเรียงลำดับแถวหมวดหมู่สินค้าที่จะแสดงบนหน้าแรกของร้าน (<%= homeSections.length %> หมวดหมู่)</p>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6">

  <!-- Left Main Column: Sections List -->
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">ลำดับหมวดหมู่ปัจจุบัน</h3>
      <span class="text-xs text-[var(--text-4)]">ทั้งหมด <%= homeSections.length %> หมวดหมู่</span>
    </div>

    <% if (!homeSections.length) { %>
      <div class="py-12 text-center text-xs text-[var(--text-4)] border border-dashed border-[var(--border-light)] rounded-2xl">
        <div class="text-3xl mb-2">🗂️</div>
        <div class="text-sm font-semibold text-[var(--text-3)]">ยังไม่มีหมวดหมู่หน้าแรก</div>
        <p class="text-xs text-[var(--text-4)] mt-1">เพิ่มหมวดหมู่ใหม่ได้จากแบบฟอร์มด้านขวา</p>
      </div>
    <% } %>

    <div class="space-y-3.5">
      <% homeSections.forEach((s, i) => { %>
        <details class="bg-[var(--input)]/40 border border-[var(--border-light)] hover:border-[var(--gold)]/40 rounded-2xl p-4 transition group shadow-sm">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-6 h-6 rounded-lg bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-xs"><%= i + 1 %></span>
              <span class="text-sm font-bold text-[var(--text)] truncate"><%= s.title %></span>
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[var(--card)] border border-[var(--border-light)] text-[var(--gold)] shrink-0">
                <%= s.mode === 'manual' ? `เลือกเอง (${s.productIds.length} ชิ้น)` : `สินค้าใหม่ล่าสุด (${s.limit} ชิ้น)` %>
              </span>
            </div>
            <span class="text-xs text-[var(--gold)] font-medium group-open:rotate-180 transition-transform duration-200">▼</span>
          </summary>

          <!-- Re-order & Delete Controls -->
          <div class="flex items-center gap-2 mt-4 pt-3 border-t border-[var(--border)]">
            <form action="/admin/home-sections/<%= s.id %>/move" method="post">
              <input type="hidden" name="direction" value="up" />
              <button type="submit" class="text-xs font-semibold px-2.5 py-1 rounded-xl bg-[var(--card)] border border-[var(--border-light)] hover:border-[var(--gold)] disabled:opacity-30 transition" <%= i === 0 ? 'disabled' : '' %>>
                ▲ เลื่อนขึ้น
              </button>
            </form>

            <form action="/admin/home-sections/<%= s.id %>/move" method="post">
              <input type="hidden" name="direction" value="down" />
              <button type="submit" class="text-xs font-semibold px-2.5 py-1 rounded-xl bg-[var(--card)] border border-[var(--border-light)] hover:border-[var(--gold)] disabled:opacity-30 transition" <%= i === homeSections.length - 1 ? 'disabled' : '' %>>
                ▼ เลื่อนลง
              </button>
            </form>

            <form action="/admin/home-sections/<%= s.id %>/delete" method="post" data-confirm="ต้องการลบหมวดหมู่ '<%= s.title %>' ใช่หรือไม่?" class="ml-auto">
              <button type="submit" class="text-xs font-semibold text-rose-400 hover:bg-rose-500/10 px-2.5 py-1 rounded-xl transition">
                ลบหมวดหมู่นี้
              </button>
            </form>
          </div>

          <!-- Edit Section Form -->
          <form action="/admin/home-sections/<%= s.id %>/edit" method="post" class="space-y-3.5 mt-4">
            <div>
              <label class="block text-xs font-semibold text-[var(--text-3)] mb-1">ชื่อหมวดหมู่ *</label>
              <input name="title" required value="<%= s.title %>" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition font-medium" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-[var(--text-3)] mb-1">รูปแบบการแสดงสินค้า</label>
              <select name="mode" class="section-mode-select w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition">
                <option value="newest" <%= s.mode !== 'manual' ? 'selected' : '' %>>สินค้าใหม่ล่าสุดอัตโนมัติ</option>
                <option value="manual" <%= s.mode === 'manual' ? 'selected' : '' %>>เลือกสินค้าเองทีละชิ้น</option>
              </select>
            </div>

            <div class="section-limit-field" <%= s.mode === 'manual' ? 'hidden' : '' %>>
              <label class="block text-xs font-semibold text-[var(--text-3)] mb-1">จำนวนที่แสดง (ชิ้น)</label>
              <input type="number" name="limit" min="1" max="30" value="<%= s.limit %>" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
            </div>

            <div class="section-products-field" <%= s.mode !== 'manual' ? 'hidden' : '' %>>
              <label class="block text-xs font-semibold text-[var(--text-3)] mb-1">เลือกสินค้าที่จะแสดง (ติ๊กรูปเพื่อเลือก)</label>
              <div class="max-h-80 overflow-y-auto border border-[var(--border-light)] rounded-2xl p-2.5 bg-[var(--card)]">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                  <% products.forEach(p => { %>
                    <label class="product-pick-card relative block rounded-xl overflow-hidden border-2 border-transparent cursor-pointer transition">
                      <input type="checkbox" name="productIds" value="<%= p.id %>" <%= s.productIds.includes(p.id) ? 'checked' : '' %> class="peer sr-only" />
                      <img src="<%= p.images && p.images[0] %>" alt="<%= p.title %>" class="w-full aspect-square object-cover rounded-lg" />
                      <span class="absolute inset-0 peer-checked:border-2 peer-checked:border-[var(--gold)] peer-checked:bg-[var(--gold)]/20 rounded-xl pointer-events-none"></span>
                      <span class="absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-black/60 border border-white/40 flex items-center justify-center text-[10px] peer-checked:bg-[var(--gold)] peer-checked:text-[var(--bg)] peer-checked:border-[var(--gold)]">✓</span>
                      <span class="block text-[10px] px-1.5 py-1 bg-black/60 text-white truncate"><%= p.title %></span>
                    </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold rounded-xl py-2 text-xs shadow-md transition active:scale-95">
              💾 บันทึกการแก้ไขหมวดหมู่นี้
            </button>
          </form>
        </details>
      <% }) %>
    </div>
  </div>

  <!-- Right Column: Add New Section Card -->
  <div>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm sticky top-20">
      <div class="flex items-center gap-2.5 mb-4">
        <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-sm">
          🗂️
        </div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เพิ่มหมวดหมู่ใหม่</h3>
      </div>

      <form action="/admin/home-sections" method="post" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ชื่อหมวดหมู่ *</label>
          <input name="title" required placeholder="เช่น สินค้าแนะนำ, ลดราคาพิเศษ, ID ไก่ตัน" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">รูปแบบการแสดง</label>
          <select name="mode" class="section-mode-select w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition">
            <option value="newest">สินค้าใหม่ล่าสุดอัตโนมัติ</option>
            <option value="manual">เลือกสินค้าเอง</option>
          </select>
        </div>

        <div class="section-limit-field">
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">จำนวนสินค้าที่แสดง (ชิ้น)</label>
          <input type="number" name="limit" min="1" max="30" value="5" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div class="section-products-field" hidden>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">เลือกสินค้าที่จะแสดง</label>
          <div class="max-h-72 overflow-y-auto border border-[var(--border-light)] rounded-2xl p-2 bg-[var(--input)]">
            <div class="grid grid-cols-2 gap-2">
              <% products.forEach(p => { %>
                <label class="product-pick-card relative block rounded-xl overflow-hidden border-2 border-transparent cursor-pointer transition">
                  <input type="checkbox" name="productIds" value="<%= p.id %>" class="peer sr-only" />
                  <img src="<%= p.images && p.images[0] %>" alt="<%= p.title %>" class="w-full aspect-square object-cover rounded-lg" />
                  <span class="absolute inset-0 peer-checked:border-2 peer-checked:border-[var(--gold)] peer-checked:bg-[var(--gold)]/20 rounded-xl pointer-events-none"></span>
                  <span class="absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-black/60 border border-white/40 flex items-center justify-center text-[10px] peer-checked:bg-[var(--gold)] peer-checked:text-[var(--bg)] peer-checked:border-[var(--gold)]">✓</span>
                  <span class="block text-[10px] px-1.5 py-1 bg-black/60 text-white truncate"><%= p.title %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold rounded-xl py-2.5 text-xs shadow-md transition active:scale-95 mt-2">
          + เพิ่มหมวดหมู่หน้าแรก
        </button>
      </form>
    </div>
  </div>

</div>

<script>
  (function () {
    function bindModeSelect(wrap) {
      const select = wrap.querySelector('.section-mode-select');
      const limitField = wrap.querySelector('.section-limit-field');
      const productsField = wrap.querySelector('.section-products-field');
      if (!select) return;
      select.addEventListener('change', function () {
        const isManual = select.value === 'manual';
        if (limitField) limitField.hidden = isManual;
        if (productsField) productsField.hidden = !isManual;
      });
    }
    document.querySelectorAll('form').forEach(bindModeSelect);
  })();
</script>
