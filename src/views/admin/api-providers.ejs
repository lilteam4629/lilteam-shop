<!-- Admin API Providers Management -->
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-[var(--text-4)] mb-1">
        <a href="/admin" class="text-[var(--gold)] hover:underline font-semibold">แอดมิน</a>
        <span>/</span>
        <span>ระบบภายนอก</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)] flex items-center gap-2">
        <span>🌐 เชื่อมต่อระบบ API & ดึงสินค้าอัตโนมัติ</span>
      </h1>
      <p class="text-xs text-[var(--text-4)] mt-0.5">เชื่อมต่อ API ซัพพลายเออร์เพื่อตัดสต็อกและส่งมอบคีย์/ไอดีเกมให้ลูกค้าอัตโนมัติตลอด 24 ชม.</p>
    </div>

    <div class="flex items-center gap-2">
      <a href="/admin/products" class="bg-[var(--card)] hover:bg-[var(--input)] border border-[var(--border)] text-xs font-semibold px-4 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm">
        <span>📦 จัดการสินค้าในร้าน</span>
      </a>
    </div>
  </div>

  <!-- Provider Navigation Tabs -->
  <div class="flex border-b border-[var(--border)] gap-2 overflow-x-auto pb-px">
    <button type="button" onclick="switchApiTab('byshop')" id="tab-btn-byshop" class="api-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-bold text-sm transition border-[var(--gold)] text-[var(--gold)] bg-[var(--gold)]/5 rounded-t-xl">
      <span class="text-base">⭐</span>
      <span>BYSHOP API</span>
      <span class="text-[10px] bg-emerald-500/20 text-emerald-400 font-bold px-2 py-0.5 rounded-full border border-emerald-500/30">แนะนำอันดับ 1</span>
    </button>
    <button type="button" onclick="switchApiTab('custom')" id="tab-btn-custom" class="api-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-semibold text-sm transition border-transparent text-[var(--text-3)] hover:text-[var(--text)] rounded-t-xl">
      <span class="text-base">🔌</span>
      <span>Custom Webhook / API อื่นๆ</span>
    </button>
  </div>

  <!-- TAB 1: BYSHOP (Recommended) -->
  <div id="tab-content-byshop" class="api-tab-content space-y-6">
    
    <!-- Balance & Connection Status Banner -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-gradient-to-br from-[var(--card)] to-[var(--input)]/50 border border-[var(--border)] rounded-2xl p-5 shadow-sm relative overflow-hidden">
        <div class="absolute -right-4 -bottom-4 text-7xl opacity-5 select-none pointer-events-none">⭐</div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[var(--text-4)] uppercase tracking-wider">สถานะการเชื่อมต่อ</span>
          <% if (byshopConfig && byshopConfig.enabled && byshopConfig.apiKey) { %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              เปิดใช้งานอยู่
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-zinc-500/15 text-zinc-400 border border-zinc-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
              ยังไม่เปิดใช้งาน
            </span>
          <% } %>
        </div>
        <div class="text-sm font-bold text-[var(--text)] mt-1">BYSHOP Provider (byshop.me)</div>
        <p class="text-[11px] text-[var(--text-4)] mt-0.5">ระบบเชื่อมต่อ API อัตโนมัติสำหรับดึงสต็อกและสั่งซื้อ</p>
      </div>

      <div class="bg-gradient-to-br from-[var(--card)] to-[var(--input)]/50 border border-[var(--gold)]/30 rounded-2xl p-5 shadow-sm relative overflow-hidden md:col-span-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="text-xs font-semibold text-[var(--gold)] uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <span>💰 ยอดเครดิตในบัญชี BYSHOP</span>
              <% if (byshopInfo && byshopInfo.isDemo) { %>
                <span class="text-[10px] bg-amber-500/20 text-amber-400 px-2 py-0.5 rounded border border-amber-500/30">โหมดจำลอง Test/Demo Key</span>
              <% } %>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="byshop-balance-display" class="text-2xl sm:text-3xl font-extrabold text-[var(--text)]">
                <% if (byshopInfo && byshopInfo.ok) { %>
                  ฿<%= Number(byshopInfo.balance || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                <% } else { %>
                  ฿0.00
                <% } %>
              </span>
              <% if (byshopInfo && byshopInfo.username) { %>
                <span class="text-xs text-[var(--text-3)] font-medium">(บัญชี: <%= byshopInfo.username %>)</span>
              <% } %>
            </div>
            <div id="byshop-status-message" class="text-xs text-[var(--text-4)] mt-1">
              <%= byshopInfo ? byshopInfo.message : 'กรอก API Key และกดปุ่มทดสอบเพื่อตรวจสอบยอดเงินจริง' %>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button type="button" id="btn-test-byshop" onclick="testByshopConnection()" class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-1.5 shadow-md transition active:scale-95">
              <span id="test-spinner" class="hidden animate-spin">🔄</span>
              <span>⚡ ทดสอบการเชื่อมต่อ</span>
            </button>
            <a href="https://byshop.me" target="_blank" rel="noopener noreferrer" class="bg-[var(--input)] hover:bg-[var(--card)] border border-[var(--border)] text-[var(--text-2)] font-medium px-3.5 py-2.5 rounded-xl text-xs transition">
              ไปยังเว็บ BYSHOP ↗
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Configuration Form Card -->
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6 shadow-sm space-y-6">
      <div class="flex items-center gap-3 pb-4 border-b border-[var(--border)]">
        <div class="w-10 h-10 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-lg">
          ⭐
        </div>
        <div>
          <h2 class="text-base font-bold text-[var(--text)]">ตั้งค่าการเชื่อมต่อ BYSHOP API</h2>
          <p class="text-xs text-[var(--text-4)]">รับ API Key ได้จากหน้าโปรไฟล์ในเว็บไซต์ <a href="https://byshop.me" target="_blank" class="text-[var(--gold)] underline">byshop.me</a></p>
        </div>
      </div>

      <form action="/admin/api-providers/byshop" method="post" class="space-y-5">
        <!-- Enable Switch -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--input)]/40 border border-[var(--border-light)]">
          <div class="space-y-0.5">
            <label for="byshop_enabled" class="font-bold text-sm text-[var(--text)] cursor-pointer">เปิดใช้งานระบบ BYSHOP API</label>
            <p class="text-xs text-[var(--text-4)]">เปิดเพื่อให้ระบบสามารถตัดยอดและส่งมอบสินค้าผ่าน API อัตโนมัติ</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="byshop_enabled" name="enabled" class="sr-only peer" <%= byshopConfig && byshopConfig.enabled ? 'checked' : '' %>>
            <div class="w-11 h-6 bg-[var(--card)] peer-focus:outline-none rounded-full peer border border-[var(--border-light)] peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--gold)]"></div>
          </label>
        </div>

        <!-- API Key Input -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-3)] uppercase tracking-wider">
            BYSHOP API Key <span class="text-rose-400">*</span>
          </label>
          <div class="relative">
            <input type="password" id="byshop_api_key" name="apiKey" value="<%= byshopConfig ? byshopConfig.apiKey : '' %>" placeholder="เช่น by_live_xxxxxxxxxxxxxxxxxxxxxxxxxx" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-4 py-3 text-sm text-[var(--text)] font-mono outline-none focus:border-[var(--gold)] transition pr-24" />
            <button type="button" onclick="togglePasswordVisibility('byshop_api_key', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[var(--text-4)] hover:text-[var(--text)] px-2 py-1 bg-[var(--card)] rounded border border-[var(--border-light)]">
              แสดง
            </button>
          </div>
          <p class="text-[11px] text-[var(--text-4)]">
            💡 สำหรับการทดสอบโดยไม่ตัดเงินจริง สามารถใช้คีย์ <code class="bg-[var(--input)] px-1.5 py-0.5 rounded text-[var(--gold)] font-mono">BYSHOP_DEMO_KEY</code> หรือคีย์ขึ้นต้นด้วย <code class="bg-[var(--input)] px-1.5 py-0.5 rounded text-[var(--gold)] font-mono">test_</code>
          </p>
        </div>

        <!-- Endpoint URL -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-3)] uppercase tracking-wider">
            API Endpoint URL
          </label>
          <input type="url" name="endpoint" value="<%= byshopConfig && byshopConfig.endpoint ? byshopConfig.endpoint : 'https://api.byshop.me/api' %>" placeholder="https://api.byshop.me/api" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-4 py-2.5 text-sm text-[var(--text)] font-mono outline-none focus:border-[var(--gold)] transition" />
          <p class="text-[11px] text-[var(--text-4)]">ค่าเริ่มต้นคือ <code class="text-[var(--gold)]">https://api.byshop.me/api</code> ไม่ต้องเปลี่ยนหากใช้เซิร์ฟเวอร์หลักของ BYSHOP</p>
        </div>

        <!-- Auto Fulfillment Toggle -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--input)]/40 border border-[var(--border-light)]">
          <div class="space-y-0.5">
            <label for="byshop_auto_fulfill" class="font-bold text-sm text-[var(--text)] cursor-pointer">ส่งมอบสินค้าอัตโนมัติทันทีหลังลูกค้าชำระเงิน (Auto-Fulfill)</label>
            <p class="text-xs text-[var(--text-4)]">เมื่อลูกค้าซื้อสินค้าที่ผูกกับ BYSHOP ระบบจะยิงคำสั่งซื้อไปดึงคีย์มาให้ลูกค้าเห็นทันที</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="byshop_auto_fulfill" name="autoFulfill" class="sr-only peer" <%= !byshopConfig || byshopConfig.autoFulfill !== false ? 'checked' : '' %>>
            <div class="w-11 h-6 bg-[var(--card)] peer-focus:outline-none rounded-full peer border border-[var(--border-light)] peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--gold)]"></div>
          </label>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-6 py-2.5 rounded-xl text-sm shadow-md transition active:scale-95">
            💾 บันทึกการตั้งค่า BYSHOP
          </button>
        </div>
      </form>
    </div>

    <!-- Available Catalog from BYSHOP -->
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[var(--border)]">
        <div>
          <h3 class="font-bold text-sm sm:text-base text-[var(--text)] flex items-center gap-2">
            <span>📋 แคตตาล็อกสินค้าที่พร้อมดึงจาก BYSHOP</span>
          </h3>
          <p class="text-xs text-[var(--text-4)]">นำรหัสสินค้า (Product ID) ด้านล่างไปใส่ในช่องรหัสสินค้าของร้านคุณ</p>
        </div>
        <span class="text-xs bg-[var(--input)] text-[var(--text-3)] px-3 py-1 rounded-lg border border-[var(--border-light)]">
          พบ <%= byshopProducts.length %> รายการ
        </span>
      </div>

      <% if (!byshopProducts || !byshopProducts.length) { %>
        <div class="text-center py-8 text-[var(--text-4)] text-xs bg-[var(--input)]/20 rounded-xl border border-dashed border-[var(--border-light)]">
          ยังไม่มีรายการสินค้าจาก BYSHOP หรือยังไม่ได้เชื่อมต่อ API Key<br>
          กรุณากรอก API Key ด้านบนแล้วกดบันทึกหรือกดทดสอบการเชื่อมต่อ
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead class="text-[11px] uppercase tracking-wider text-[var(--text-4)] bg-[var(--input)]/40 border-y border-[var(--border-light)]">
              <tr>
                <th class="py-2.5 px-3">รหัสสินค้า (Product ID)</th>
                <th class="py-2.5 px-3">ชื่อสินค้าใน BYSHOP</th>
                <th class="py-2.5 px-3">หมวดหมู่</th>
                <th class="py-2.5 px-3">ราคาทุน</th>
                <th class="py-2.5 px-3">สถานะสต็อก</th>
                <th class="py-2.5 px-3 text-right">การกระทำ</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-light)]">
              <% byshopProducts.forEach(item => { %>
                <tr class="hover:bg-[var(--input)]/30 transition">
                  <td class="py-3 px-3 font-mono font-bold text-[var(--gold)]">
                    <%= item.id %>
                  </td>
                  <td class="py-3 px-3 font-medium text-[var(--text)]">
                    <%= item.name %>
                  </td>
                  <td class="py-3 px-3 text-[var(--text-3)]">
                    <%= item.category || '-' %>
                  </td>
                  <td class="py-3 px-3 font-bold text-emerald-400">
                    ฿<%= Number(item.price || 0).toLocaleString() %>
                  </td>
                  <td class="py-3 px-3">
                    <% if (item.stock > 0) { %>
                      <span class="text-emerald-400 font-medium">มีของ (<%= item.stock %>)</span>
                    <% } else { %>
                      <span class="text-rose-400 font-medium">หมดสต็อก</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <button type="button" onclick="copyText('<%= item.id %>', this)" class="bg-[var(--input)] hover:bg-[var(--gold)] hover:text-[var(--bg)] text-[var(--text-3)] font-semibold px-2.5 py-1 rounded-lg border border-[var(--border-light)] transition">
                      📋 คัดลอก ID
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>

  <!-- TAB 2: Custom Webhook / API -->
  <div id="tab-content-custom" class="api-tab-content hidden space-y-6">
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6 shadow-sm space-y-6">
      <div class="flex items-center gap-3 pb-4 border-b border-[var(--border)]">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-lg">
          🔌
        </div>
        <div>
          <h2 class="text-base font-bold text-[var(--text)]">ตั้งค่าเชื่อมต่อ Custom API / Webhook</h2>
          <p class="text-xs text-[var(--text-4)]">เชื่อมต่อระบบสต็อกภายนอกหรือ Webhook ตามความต้องการของร้านคุณ</p>
        </div>
      </div>

      <form action="/admin/api-providers/custom" method="post" class="space-y-5">
        <!-- Enable Switch -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--input)]/40 border border-[var(--border-light)]">
          <div class="space-y-0.5">
            <label for="custom_enabled" class="font-bold text-sm text-[var(--text)] cursor-pointer">เปิดใช้งาน Custom API</label>
            <p class="text-xs text-[var(--text-4)]">ส่งคำสั่งซื้อและรับข้อมูลผ่าน Webhook Endpoint ที่กำหนด</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="custom_enabled" name="enabled" class="sr-only peer" <%= customConfig && customConfig.enabled ? 'checked' : '' %>>
            <div class="w-11 h-6 bg-[var(--card)] peer-focus:outline-none rounded-full peer border border-[var(--border-light)] peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--gold)]"></div>
          </label>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-3)] uppercase tracking-wider">
            Webhook / API Endpoint URL
          </label>
          <input type="url" name="endpoint" value="<%= customConfig ? customConfig.endpoint : '' %>" placeholder="https://api.yourdomain.com/v1/orders" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-4 py-2.5 text-sm text-[var(--text)] font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-3)] uppercase tracking-wider">
            API Key / Bearer Token
          </label>
          <input type="password" name="apiKey" value="<%= customConfig ? customConfig.apiKey : '' %>" placeholder="Bearer Token หรือ API Key" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-4 py-2.5 text-sm text-[var(--text)] font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-3)] uppercase tracking-wider">
            Webhook Secret Key (สำหรับตรวจสอบ Signature)
          </label>
          <input type="password" name="webhookSecret" value="<%= customConfig ? customConfig.webhookSecret : '' %>" placeholder="Secret Key สำหรับถอดรหัส HMAC" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-4 py-2.5 text-sm text-[var(--text)] font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-6 py-2.5 rounded-xl text-sm shadow-md transition active:scale-95">
            💾 บันทึก Custom API
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

<script>
  function switchApiTab(tabId) {
    document.querySelectorAll('.api-tab-btn').forEach(btn => {
      btn.classList.remove('border-[var(--gold)]', 'text-[var(--gold)]', 'bg-[var(--gold)]/5', 'font-bold');
      btn.classList.add('border-transparent', 'text-[var(--text-3)]', 'font-semibold');
    });
    document.querySelectorAll('.api-tab-content').forEach(content => {
      content.classList.add('hidden');
    });

    const activeBtn = document.getElementById('tab-btn-' + tabId);
    const activeContent = document.getElementById('tab-content-' + tabId);

    if (activeBtn) {
      activeBtn.classList.remove('border-transparent', 'text-[var(--text-3)]', 'font-semibold');
      activeBtn.classList.add('border-[var(--gold)]', 'text-[var(--gold)]', 'bg-[var(--gold)]/5', 'font-bold');
    }
    if (activeContent) {
      activeContent.classList.remove('hidden');
    }
  }

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = 'ซ่อน';
    } else {
      input.type = 'password';
      btn.textContent = 'แสดง';
    }
  }

  function copyText(text, btn) {
    navigator.clipboard.writeText(text).then(() => {
      const orig = btn.textContent;
      btn.textContent = '✓ คัดลอกแล้ว';
      btn.classList.add('text-emerald-400');
      setTimeout(() => {
        btn.textContent = orig;
        btn.classList.remove('text-emerald-400');
      }, 2000);
    });
  }

  async function testByshopConnection() {
    const apiKey = document.getElementById('byshop_api_key').value.trim();
    const balanceDisplay = document.getElementById('byshop-balance-display');
    const statusMsg = document.getElementById('byshop-status-message');
    const spinner = document.getElementById('test-spinner');
    const btn = document.getElementById('btn-test-byshop');

    if (!apiKey) {
      alert('กรุณากรอก BYSHOP API Key ก่อนทำการทดสอบ');
      document.getElementById('byshop_api_key').focus();
      return;
    }

    spinner.classList.remove('hidden');
    btn.disabled = true;
    statusMsg.textContent = 'กำลังทดสอบเชื่อมต่อ BYSHOP API...';

    try {
      const res = await fetch('/admin/api-providers/byshop/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apiKey: apiKey })
      });
      const data = await res.json();

      if (data.ok) {
        balanceDisplay.textContent = '฿' + Number(data.balance || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        statusMsg.className = 'text-xs text-emerald-400 mt-1 font-semibold';
        statusMsg.textContent = '✓ ' + (data.message || 'เชื่อมต่อสำเร็จ');
      } else {
        statusMsg.className = 'text-xs text-rose-400 mt-1 font-semibold';
        statusMsg.textContent = '✗ ' + (data.message || 'การเชื่อมต่อล้มเหลว');
      }
    } catch (err) {
      statusMsg.className = 'text-xs text-rose-400 mt-1 font-semibold';
      statusMsg.textContent = '✗ เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์';
    } finally {
      spinner.classList.add('hidden');
      btn.disabled = false;
    }
  }
</script>
