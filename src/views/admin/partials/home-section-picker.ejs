<div class="section-products-field hs-picker" <%=visible?'':'hidden'%>><header><span>เลือกสินค้าที่ต้องการแสดง</span><input type="search" placeholder="ค้นหาสินค้า..." data-product-search></header><div><%products.forEach(p=>{%><label data-product-card data-name="<%=String(p.title).toLowerCase()%>"><input type="checkbox" name="productIds" value="<%=p.id%>" <%=selected.includes(p.id)?'checked':''%>><span><%if(p.images&&p.images[0]){%><img src="<%=p.images[0]%>" alt="" loading="lazy"><%}%><i>✓</i></span><b><%=p.title%></b></label><%})%></div></div>
