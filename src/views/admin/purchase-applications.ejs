<% const pending = applications.filter(item => item.status === 'pending'); %>
<div class="mb-5">
  <h2 class="font-semibold text-lg">คำขอที่รอตรวจสอบ (<%= pending.length %>)</h2>
  <p class="text-sm text-[var(--text-4)]">ตรวจข้อมูลที่ลูกค้าส่งมา แล้วอนุมัติสิทธิ์ซื้อเป็นรายสินค้า</p>
</div>

<div class="space-y-4">
  <% applications.forEach(item => { %>
    <article class="bg-[var(--card)] border <%= item.status === 'pending' ? 'border-[var(--gold)]/50' : 'border-[var(--border)]' %> rounded-xl p-4">
      <div class="flex flex-col lg:flex-row gap-4 lg:items-start">
        <% if (item.product && item.product.images && item.product.images[0]) { %><img src="<%= item.product.images[0] %>" class="w-20 h-24 object-contain rounded-lg bg-black/20" alt="" /><% } %>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="font-semibold"><%= item.product ? item.product.title : 'สินค้าถูกลบแล้ว' %></h3>
            <span class="text-xs rounded-full px-2 py-1 <%= item.status === 'approved' ? 'bg-emerald-500/15 text-emerald-400' : item.status === 'rejected' ? 'bg-rose-500/15 text-rose-400' : 'bg-amber-500/15 text-amber-300' %>"><%= item.status === 'approved' ? 'อนุมัติแล้ว' : item.status === 'rejected' ? 'ปฏิเสธ' : 'รอตรวจสอบ' %></span>
          </div>
          <p class="text-sm text-[var(--text-3)] mt-1">ลูกค้า: <%= item.user ? `${item.user.username} (${item.user.email})` : 'ไม่พบผู้ใช้' %></p>
          <div class="mt-3 bg-[var(--input)] border border-[var(--border-light)] rounded-lg p-3 text-sm whitespace-pre-wrap"><%= item.answer %></div>
          <p class="text-xs text-[var(--text-4)] mt-2"><%= new Date(item.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>
          <% if (item.adminNote) { %><p class="text-xs text-[var(--text-3)] mt-2">หมายเหตุแอดมิน: <%= item.adminNote %></p><% } %>
        </div>
        <% if (item.status === 'pending') { %>
          <div class="w-full lg:w-72 space-y-2">
            <form action="/admin/purchase-applications/<%= item.id %>/approve" method="post">
              <input name="adminNote" placeholder="หมายเหตุ (ไม่บังคับ)" class="w-full mb-2 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
              <button class="w-full bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg px-4 py-2 text-sm font-medium">✓ อนุมัติให้ซื้อได้</button>
            </form>
            <form action="/admin/purchase-applications/<%= item.id %>/reject" method="post">
              <button class="w-full border border-rose-500/50 text-rose-400 hover:bg-rose-500/10 rounded-lg px-4 py-2 text-sm">✕ ปฏิเสธคำขอ</button>
            </form>
          </div>
        <% } %>
      </div>
    </article>
  <% }) %>
  <% if (!applications.length) { %><div class="border border-dashed border-[var(--border-light)] rounded-xl py-14 text-center text-[var(--text-4)]">ยังไม่มีคำขอสิทธิ์ซื้อ</div><% } %>
</div>
