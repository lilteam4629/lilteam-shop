<link rel="stylesheet" href="<%= asset('css/admin-experiment-filter-tags-v1.css') %>" />
<div class="experiment-app experiment-filter-tags-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><span aria-hidden="true">▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products"><span aria-hidden="true">◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><span aria-hidden="true">◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item active" href="/admin/filter-tags"><span aria-hidden="true">◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><span aria-hidden="true">☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><span aria-hidden="true">▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span aria-hidden="true">▭</span><span>เติมเงิน & ตรวจสอบ</span></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span aria-hidden="true">⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">สินค้าและสต๊อก</div><h1>แท็กและจัดหมวดสินค้า</h1><p>สร้างแท็กจากรูปภาพ แล้วผูกกับสินค้าเพื่อให้ลูกค้าค้นหาหน้าร้านได้ง่ายขึ้น</p></div><div class="experiment-actions"><form action="/admin/filter-tags/efootball/import" method="post" data-experiment-confirm="นำเข้าการ์ด eFHUB New Players ทั้งหมดเป็นแท็กตัวกรองหรือไม่?"><button class="experiment-button" type="submit">นำเข้าการ์ดผู้เล่น</button></form><button class="experiment-button primary" type="button" data-filter-create-open>+ สร้างตัวกรอง</button></div></div>
      <div class="experiment-page-status-note"><strong>สถานะหน้านี้:</strong> คลังแท็กใช้งานได้ · เพิ่ม แก้ไข ลบ ค้นหา และผูกสินค้าได้จากหน้าเดียว</div>

      <section class="experiment-filter-radar" aria-labelledby="experiment-filter-radar-title">
        <div class="experiment-filter-radar-crown" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="experiment-filter-radar-head"><div><div class="experiment-filter-radar-kicker">QUICK ORGANIZER</div><h2 id="experiment-filter-radar-title">เมนูจัดหมวดด่วน</h2><p>ทางลัดจากข้อมูลจริงของร้าน กดแล้วจะกรองคลังตัวกรองให้ทันที</p></div><button class="experiment-filter-radar-reset" type="button" data-filter-shortcut="all">ดูแท็กทั้งหมด <span aria-hidden="true">→</span></button></div>
        <div class="experiment-filter-radar-grid">
          <button class="experiment-filter-radar-item sage" type="button" data-filter-shortcut="used"><span class="experiment-filter-radar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/><path d="M4 20h16"/></svg></span><span class="experiment-filter-radar-copy"><strong>มีสินค้าเชื่อมอยู่</strong><small><%= filterTags.filter(t => t.productCount > 0).length %> แท็กพร้อมใช้งาน</small></span><span class="experiment-filter-radar-arrow" aria-hidden="true">→</span></button>
          <button class="experiment-filter-radar-item gold" type="button" data-filter-shortcut="unused"><span class="experiment-filter-radar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></svg></span><span class="experiment-filter-radar-copy"><strong>ยังไม่ผูกสินค้า</strong><small><%= filterTags.filter(t => !t.productCount).length %> แท็กที่รอจัดหมวด</small></span><span class="experiment-filter-radar-arrow" aria-hidden="true">→</span></button>
          <% if (filterTags[0]) { %><button class="experiment-filter-radar-item plum" type="button" data-filter-shortcut="tag" data-filter-tag-name="<%= String(filterTags[0].name || '').toLowerCase() %>"><span class="experiment-filter-radar-image"><img src="<%= filterTags[0].image %>" alt="" loading="lazy" /></span><span class="experiment-filter-radar-copy"><strong><%= filterTags[0].name %></strong><small><%= filterTags[0].productCount %> สินค้าในแท็ก</small></span><span class="experiment-filter-radar-arrow" aria-hidden="true">→</span></button><% } else { %><button class="experiment-filter-radar-item plum" type="button" data-filter-create-open><span class="experiment-filter-radar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><span class="experiment-filter-radar-copy"><strong>สร้างแท็กแรก</strong><small>เริ่มจัดหมวดสินค้าของร้าน</small></span><span class="experiment-filter-radar-arrow" aria-hidden="true">→</span></button><% } %>
          <button class="experiment-filter-radar-item dark" type="button" data-filter-create-open><span class="experiment-filter-radar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><span class="experiment-filter-radar-copy"><strong>สร้างแท็กใหม่</strong><small>อัปโหลดรูปเพื่อเพิ่มตัวกรอง</small></span><span class="experiment-filter-radar-arrow" aria-hidden="true">→</span></button>
        </div>
      </section>

      <section class="experiment-filter-stats" aria-label="สรุปแท็กสินค้า"><div class="experiment-filter-stat"><span class="experiment-filter-stat-icon violet">◈</span><div><small>แท็กทั้งหมด</small><strong><%= filterTags.length %></strong><em>รายการ</em></div></div><div class="experiment-filter-stat"><span class="experiment-filter-stat-icon green">✓</span><div><small>กำลังใช้งาน</small><strong><%= filterTags.filter(t => t.productCount > 0).length %></strong><em>มีสินค้าเชื่อมอยู่</em></div></div><div class="experiment-filter-stat"><span class="experiment-filter-stat-icon gold">○</span><div><small>ยังไม่ผูกสินค้า</small><strong><%= filterTags.filter(t => !t.productCount).length %></strong><em>พร้อมจัดหมวด</em></div></div><div class="experiment-filter-stat note"><span class="experiment-filter-note-icon">TIP</span><div><strong>แนะนำ</strong><small>ใช้แท็กสั้น ๆ และรูปที่เห็นชัด เพื่อให้ลูกค้ากดเลือกได้ง่าย</small></div></div></section>

      <section class="experiment-card experiment-filter-heading"><form action="/admin/filter-tags/heading" method="post"><label><span>หัวข้อบนตัวกรองหน้าร้าน</span><small>ข้อความที่จะแสดงเหนือแถวตัวกรองในหน้าร้าน</small><input name="filterHeading" value="<%= settings.filterHeading || 'เลือกตัวที่ต้องการตามหา' %>" maxlength="100" required /></label><button class="experiment-button primary" type="submit">บันทึกหัวข้อ</button></form></section>

      <section class="experiment-card experiment-filter-library"><div class="experiment-filter-library-head"><div><h2>คลังตัวกรอง</h2><p>เลือกแท็กเพื่อจัดการหลายรายการ หรือเปิดจัดการสินค้าเฉพาะแท็ก</p></div><span class="experiment-filter-count"><i></i><%= filterTags.length %> รายการ</span></div><div class="experiment-filter-toolbar"><div class="experiment-filter-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><input type="search" placeholder="ค้นหาชื่อแท็ก..." aria-label="ค้นหาชื่อแท็ก" data-filter-search /></div><div class="experiment-filter-toolbar-actions"><button class="experiment-button compact" type="button" data-filter-select-all>เลือกทั้งหมด</button><form action="/admin/filter-tags/bulk-delete" method="post" data-experiment-confirm="ลบแท็กที่เลือกทั้งหมดหรือไม่? สินค้าที่ผูกไว้จะถูกถอดแท็กออกด้วย"><input type="hidden" name="tagIds" data-filter-selected-inputs /><button class="experiment-button compact danger" type="submit" data-filter-delete-selected disabled>ลบที่เลือก <b data-filter-selected-count>0</b></button></form></div></div>
        <% if (!filterTags.length) { %><div class="experiment-filter-empty"><span>◈</span><h3>ยังไม่มีแท็กสินค้า</h3><p>สร้างตัวกรองจากรูปภาพเพื่อเริ่มจัดหมวดสินค้า</p><button class="experiment-button primary" type="button" data-filter-create-open>สร้างตัวกรองแรก</button></div><% } else { %><div class="experiment-filter-grid" data-filter-grid><% filterTags.forEach(tag => { %><article class="experiment-filter-card" data-filter-card data-filter-name="<%= String(tag.name || '').toLowerCase() %>" data-filter-id="<%= tag.id %>" data-filter-title="<%= tag.name %>" data-filter-card-product-count="<%= tag.productCount %>"><button class="experiment-filter-select" type="button" aria-label="เลือก <%= tag.name %>" aria-pressed="false" data-filter-select><span>✓</span></button><div class="experiment-filter-image"><img src="<%= tag.image %>" alt="<%= tag.name %>" loading="lazy" /><span class="experiment-filter-image-badge <%= tag.productCount > 0 ? 'active' : 'empty' %>"><i></i><%= tag.productCount > 0 ? 'กำลังใช้งาน' : 'รอจัดหมวด' %></span></div><div class="experiment-filter-card-body"><div class="experiment-filter-card-title"><strong title="<%= tag.name %>"><%= tag.name %></strong><span><%= tag.productCount %> สินค้า</span></div><div class="experiment-filter-card-meta"><span><i></i><%= tag.productCount > 0 ? 'พร้อมใช้งาน' : 'ยังไม่มีสินค้าเชื่อม' %></span><small>อัปเดตจากระบบจริง</small></div><div class="experiment-filter-usage" aria-label="การใช้งาน <%= tag.productCount %> รายการ"><i style="width:<%= Math.min(100, tag.productCount * 12) %>%"></i></div><button class="experiment-filter-manage" type="button" data-filter-manage>จัดการสินค้าที่ผูกอยู่ <span aria-hidden="true">→</span></button><div class="experiment-filter-card-actions"><button type="button" data-filter-edit>แก้ไขชื่อ</button><form action="/admin/filter-tags/<%= tag.id %>/delete" method="post" data-experiment-confirm="ต้องการลบแท็ก '<%= tag.name %>' หรือไม่?"><button type="submit">ลบ</button></form></div><form class="experiment-filter-inline-edit" data-filter-inline-edit action="/admin/filter-tags/<%= tag.id %>/edit" method="post" hidden><input name="name" value="<%= tag.name %>" required maxlength="100" aria-label="ชื่อแท็ก <%= tag.name %>" /><button type="submit">บันทึก</button></form></div></article><% }) %></div><div class="experiment-filter-empty" data-filter-no-result hidden><span>⌕</span><h3>ไม่พบแท็กที่ค้นหา</h3><p>ลองใช้คำค้นหาอื่น</p></div><% } %></section>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin">⌂<span>ภาพรวม</span></a><a class="active" href="/admin/products">▦<span>สินค้า</span></a><a href="/admin/scheduled-products">◷<span>ตั้งเวลา</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>

<div class="experiment-filter-drawer" data-filter-create-drawer aria-hidden="true"><button class="experiment-filter-drawer-backdrop" type="button" data-filter-create-close aria-label="ปิดหน้าสร้างตัวกรอง"></button><aside><div class="experiment-filter-drawer-head"><div><small>FILTER LIBRARY</small><h2>สร้างตัวกรองใหม่</h2><p>อัปโหลดรูปแล้วระบบจะสร้างเป็นแท็กให้แต่ละรูป</p></div><button type="button" data-filter-create-close aria-label="ปิด">×</button></div><form action="/admin/filter-tags" method="post" enctype="multipart/form-data" class="experiment-filter-create-form"><label><span>ชื่อตัวกรอง</span><small>ใช้เมื่อเลือกเพียงรูปเดียว ถ้าเลือกหลายรูปจะใช้ชื่อไฟล์แทน</small><input name="name" placeholder="เช่น Messi, Epic, Barcelona" /></label><label class="experiment-filter-drop-zone" for="experiment-filter-images" data-filter-drop-zone><input id="experiment-filter-images" type="file" name="filterImages" multiple required accept="image/png,image/jpeg,image/webp,image/gif" /><span class="experiment-filter-upload-icon">↑</span><strong>วางรูปที่นี่ หรือกดเลือกไฟล์</strong><small>รองรับ PNG, JPG, WEBP และ GIF · เลือกได้หลายรูป</small></label><div class="experiment-filter-upload-preview" data-filter-upload-preview hidden></div><p class="experiment-filter-upload-hint" data-filter-upload-hint>ยังไม่ได้เลือกไฟล์</p><button class="experiment-button primary" type="submit">สร้างตัวกรองที่เลือก</button></form></aside></div>

<div class="experiment-filter-drawer" data-filter-products-drawer aria-hidden="true"><button class="experiment-filter-drawer-backdrop" type="button" data-filter-products-close aria-label="ปิดหน้าจัดการสินค้า"></button><aside class="experiment-filter-products-aside"><div class="experiment-filter-drawer-head"><div><small>PRODUCT CONNECTIONS</small><h2 data-filter-products-title>สินค้าในแท็ก</h2><p>เลือกสินค้าแล้วกดบันทึกเพื่อผูกแท็ก</p></div><button type="button" data-filter-products-close aria-label="ปิด">×</button></div><div class="experiment-filter-product-tools"><div class="experiment-filter-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><input type="search" placeholder="ค้นหาสินค้า..." aria-label="ค้นหาสินค้าในแท็ก" data-filter-product-search /></div><span><b data-filter-product-count>0</b> รายการที่เลือก</span></div><form action="" method="post" data-filter-products-form><div class="experiment-filter-product-list"><% products.forEach(product => { %><label class="experiment-filter-product-row" data-filter-product-row data-filter-product-name="<%= String(product.title || '').toLowerCase() %>" data-filter-tags='<%- JSON.stringify(product.filterTagIds || []) %>'><input type="checkbox" name="productIds" value="<%= product.id %>" /><span class="experiment-filter-product-thumb"><% if (product.image) { %><img src="<%= product.image %>" alt="" loading="lazy" /><% } else { %>◇<% } %></span><span class="experiment-filter-product-info"><strong><%= product.title %></strong><small><%= product.status === 'active' ? 'เปิดขาย' : 'ซ่อนอยู่' %></small></span><span class="experiment-filter-product-check">✓</span></label><% }) %></div><% if (!products.length) { %><div class="experiment-filter-empty compact"><span>◇</span><h3>ยังไม่มีสินค้า</h3><p>เพิ่มสินค้าก่อนจึงจะผูกแท็กได้</p></div><% } %><div class="experiment-filter-products-save"><button class="experiment-button primary" type="submit">บันทึกสินค้าที่เลือก</button></div></form></aside></div>

<script>
(function () {
  const createDrawer = document.querySelector('[data-filter-create-drawer]');
  const productsDrawer = document.querySelector('[data-filter-products-drawer]');
  const toggle = (drawer, open) => { if (!drawer) return; drawer.classList.toggle('is-open', open); drawer.setAttribute('aria-hidden', String(!open)); document.body.style.overflow = [createDrawer, productsDrawer].some(item => item?.classList.contains('is-open')) ? 'hidden' : ''; if (open) drawer.querySelector('input,button:not([data-filter-create-close]):not([data-filter-products-close])')?.focus(); };
  document.querySelectorAll('[data-filter-create-open]').forEach(button => button.addEventListener('click', () => toggle(createDrawer, true)));
  document.querySelectorAll('[data-filter-create-close]').forEach(button => button.addEventListener('click', () => toggle(createDrawer, false)));
  document.querySelectorAll('[data-filter-products-close]').forEach(button => button.addEventListener('click', () => toggle(productsDrawer, false)));
  document.addEventListener('keydown', event => { if (event.key === 'Escape') { toggle(createDrawer, false); toggle(productsDrawer, false); } });

  const cards = Array.from(document.querySelectorAll('[data-filter-card]'));
  const selected = new Set();
  const syncSelected = () => { const count = document.querySelector('[data-filter-selected-count]'); const input = document.querySelector('[data-filter-selected-inputs]'); const button = document.querySelector('[data-filter-delete-selected]'); if (count) count.textContent = selected.size; if (input) input.value = Array.from(selected).join(','); if (button) button.disabled = selected.size === 0; cards.forEach(card => { const isSelected = selected.has(card.dataset.filterId); card.classList.toggle('is-selected', isSelected); card.querySelector('[data-filter-select]')?.setAttribute('aria-pressed', String(isSelected)); }); };
  const applyCardFilter = (mode = 'search', rawValue = '') => { const value = String(rawValue || '').trim().toLowerCase(); let visible = 0; cards.forEach(card => { const productCount = Number(card.dataset.filterCardProductCount || 0); const match = mode === 'used' ? productCount > 0 : mode === 'unused' ? productCount === 0 : mode === 'tag' ? card.dataset.filterName.includes(value) : !value || card.dataset.filterName.includes(value); card.hidden = !match; if (match) visible += 1; }); document.querySelector('[data-filter-no-result]')?.toggleAttribute('hidden', visible !== 0); };
  document.querySelector('[data-filter-search]')?.addEventListener('input', event => applyCardFilter('search', event.target.value));
  document.querySelectorAll('[data-filter-shortcut]').forEach(button => button.addEventListener('click', () => { const mode = button.dataset.filterShortcut; if (mode === 'tag') { const search = document.querySelector('[data-filter-search]'); if (search) search.value = button.dataset.filterTagName || ''; applyCardFilter('tag', button.dataset.filterTagName || ''); } else { const search = document.querySelector('[data-filter-search]'); if (search) search.value = ''; applyCardFilter(mode); } document.querySelector('.experiment-filter-library')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  cards.forEach(card => { card.querySelector('[data-filter-select]')?.addEventListener('click', () => { const id = card.dataset.filterId; selected.has(id) ? selected.delete(id) : selected.add(id); syncSelected(); }); card.querySelector('[data-filter-edit]')?.addEventListener('click', () => { const editor = card.querySelector('[data-filter-inline-edit]'); editor.hidden = !editor.hidden; if (!editor.hidden) editor.querySelector('input')?.focus(); }); card.querySelector('[data-filter-manage]')?.addEventListener('click', () => openProducts(card)); });
  document.querySelector('[data-filter-select-all]')?.addEventListener('click', () => { const visible = cards.filter(card => !card.hidden); const allSelected = visible.length > 0 && visible.every(card => selected.has(card.dataset.filterId)); visible.forEach(card => allSelected ? selected.delete(card.dataset.filterId) : selected.add(card.dataset.filterId)); syncSelected(); });

  const productRows = Array.from(document.querySelectorAll('[data-filter-product-row]')); const productCount = document.querySelector('[data-filter-product-count]'); const syncProducts = () => { if (productCount) productCount.textContent = productRows.filter(row => row.querySelector('input')?.checked).length; };
  const openProducts = card => { const tagId = card.dataset.filterId; const title = document.querySelector('[data-filter-products-title]'); const form = document.querySelector('[data-filter-products-form]'); if (title) title.textContent = `สินค้าใน “${card.dataset.filterTitle}”`; if (form) form.action = `/admin/filter-tags/${encodeURIComponent(tagId)}/products`; productRows.forEach(row => { let tags = []; try { tags = JSON.parse(row.dataset.filterTags || '[]').map(String); } catch (_) {} row.querySelector('input').checked = tags.includes(String(tagId)); row.hidden = false; }); document.querySelector('[data-filter-product-search]').value = ''; syncProducts(); toggle(productsDrawer, true); };
  productRows.forEach(row => row.querySelector('input')?.addEventListener('change', syncProducts));
  document.querySelector('[data-filter-product-search]')?.addEventListener('input', event => { const query = event.target.value.trim().toLowerCase(); productRows.forEach(row => { row.hidden = !row.dataset.filterProductName.includes(query); }); });
  const uploadInput = document.getElementById('experiment-filter-images'); const dropZone = document.querySelector('[data-filter-drop-zone]'); const uploadPreview = document.querySelector('[data-filter-upload-preview]'); const uploadHint = document.querySelector('[data-filter-upload-hint]'); const renderUploadPreview = (fileList) => { if (!uploadPreview) return; uploadPreview.innerHTML = ''; const files = Array.from(fileList || []); uploadPreview.hidden = files.length === 0; if (uploadHint) uploadHint.textContent = files.length ? `เลือกแล้ว ${files.length} ไฟล์` : 'ยังไม่ได้เลือกไฟล์'; files.forEach(file => { const item = document.createElement('div'); const image = document.createElement('img'); const label = document.createElement('span'); image.src = URL.createObjectURL(file); image.onload = () => URL.revokeObjectURL(image.src); label.textContent = file.name.replace(/\.[^.]+$/, ''); item.append(image, label); uploadPreview.append(item); }); }; uploadInput?.addEventListener('change', () => renderUploadPreview(uploadInput.files)); dropZone?.addEventListener('dragover', event => { event.preventDefault(); dropZone.classList.add('is-dragging'); }); dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('is-dragging')); dropZone?.addEventListener('drop', event => { event.preventDefault(); dropZone.classList.remove('is-dragging'); if (!event.dataTransfer?.files?.length || !uploadInput) return; try { const transfer = new DataTransfer(); Array.from(event.dataTransfer.files).forEach(file => transfer.items.add(file)); uploadInput.files = transfer.files; renderUploadPreview(uploadInput.files); } catch (_) { renderUploadPreview(event.dataTransfer.files); } });
})();
</script>
