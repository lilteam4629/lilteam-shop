<link rel="stylesheet" href="<%= asset('css/admin-experiment-products-v1.css') %>" />
<%
  const visibleCount = products.filter(product => product.status === 'active').length;
  const hiddenCount = products.length - visibleCount;
%>
<div class="experiment-app experiment-products-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item active" href="/admin/products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></svg><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7"/></svg><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M4 12h16M4 19h16"/><path d="M7 5v14"/></svg><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg><span>เติมเงิน & ตรวจสอบ</span><% if (pendingTopupCount) { %><b class="experiment-sidebar-count"><%= pendingTopupCount %></b><% } %></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 11 8-7 8 7v8H4z"/><path d="M9 19v-5h6v5"/></svg><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main"><header class="experiment-topbar"><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">สินค้าและสต๊อก</div><h1>รายการสินค้าทั้งหมด</h1><p>จัดการราคา สต๊อก สถานะ และการตั้งค่าการขายจากจุดเดียว · <%= products.length %> รายการ</p></div><div class="experiment-actions"><div class="experiment-action-menu"><button class="experiment-button experiment-bulk-button" type="button" data-products-bulk-toggle aria-expanded="false" aria-haspopup="true"><svg class="experiment-bulk-button-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5.5h10M5 10h10M5 14.5h10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"/><circle cx="2.7" cy="5.5" r=".9" fill="currentColor"/><circle cx="2.7" cy="10" r=".9" fill="currentColor"/><circle cx="2.7" cy="14.5" r=".9" fill="currentColor"/></svg><span>จัดการหลายรายการ</span><svg class="experiment-bulk-button-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg></button><div class="experiment-action-menu-panel" data-products-bulk-menu hidden><a class="experiment-menu-item" href="/admin/products/bulk-import"><span class="experiment-menu-item-icon import" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v2h14v-2"/></svg></span><span class="experiment-menu-item-copy"><strong>นำเข้าจากโฟลเดอร์</strong><small>เพิ่มสินค้าและสต๊อกเป็นชุด</small></span></a><button class="experiment-menu-item" type="button" data-products-bulk-price><span class="experiment-menu-item-icon price" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M7 4v6m10-6v6M6 13h12M6 18h8"/></svg></span><span class="experiment-menu-item-copy"><strong>ปรับราคาเป็นเปอร์เซ็นต์</strong><small>เลือกสินค้าแล้วแก้ราคาเป็นชุด</small></span><span class="experiment-menu-chevron" aria-hidden="true">›</span></button><form action="/admin/products/stock/add-all" method="post" data-experiment-confirm="เพิ่มสต๊อกให้สินค้าที่หมดทั้งหมดหรือไม่?"><button class="experiment-menu-item" type="submit"><span class="experiment-menu-item-icon stock" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 0v9l8 4 8-4V8m-8 4v9M16 15h5m-2.5-2.5v5"/></svg></span><span class="experiment-menu-item-copy"><strong>เพิ่มสต๊อกสินค้าที่หมด</strong><small>เติมรายการที่มีจำนวนคงเหลือเป็นศูนย์</small></span><span class="experiment-menu-chevron" aria-hidden="true">›</span></button></form><form action="/admin/products/set-status-all" method="post" data-experiment-confirm="เปิดขายสินค้าทั้งหมดหรือไม่?"><input type="hidden" name="status" value="active" /><button class="experiment-menu-item" type="submit"><span class="experiment-menu-item-icon active" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/><path d="M4 20h16"/></svg></span><span class="experiment-menu-item-copy"><strong>เปิดขายสินค้าทั้งหมด</strong><small>เปลี่ยนสถานะทุกสินค้าเป็นเปิดขาย</small></span><span class="experiment-menu-chevron" aria-hidden="true">›</span></button></form></div></div><a href="/admin/products/new" class="experiment-button primary">+ เพิ่มสินค้าใหม่</a></div></div>
      <section class="experiment-card experiment-toolbar"><div class="experiment-search-wrap"><span class="experiment-search-icon" aria-hidden="true">⌕</span><input class="experiment-search" type="search" placeholder="ค้นหาชื่อสินค้า หมวดหมู่ หรือรหัส..." aria-label="ค้นหาสินค้า" data-products-search /></div><div class="experiment-filter-tabs" role="tablist" aria-label="กรองสถานะสินค้า"><button class="experiment-filter active" type="button" data-products-filter="all">ทั้งหมด (<%= products.length %>)</button><button class="experiment-filter" type="button" data-products-filter="active">เปิดขาย (<%= visibleCount %>)</button><button class="experiment-filter" type="button" data-products-filter="hidden">ซ่อนอยู่ (<%= hiddenCount %>)</button></div><div class="experiment-count"><i></i> สต๊อกพร้อมขาย <strong><%= totalAvailableProductCount.toLocaleString('th-TH') %></strong></div></section>
      <section class="experiment-card experiment-product-list-card"><div class="experiment-list-head"><div><h2>สินค้าในร้าน</h2><p>กดราคาเพื่อแก้ไขทันที หรือเปิดสต๊อกเพื่อเพิ่มข้อมูลสินค้า</p></div><span class="experiment-count"><i></i> มูลค่าสต๊อก <strong>฿<%= totalProductPrice.toLocaleString('th-TH') %></strong></span></div><div class="experiment-product-table-head" aria-hidden="true"><span></span><span>สินค้า</span><span>ราคาขาย</span><span>คงเหลือ</span><span>สถานะ</span><span>การจัดการ</span></div><div data-products-list><% products.forEach(product => { %><article class="experiment-product-row" data-product-row data-status="<%= product.status === 'active' ? 'active' : 'hidden' %>" data-search="<%= `${product.title} ${product.slug} ${product.internalNote || ''}`.toLowerCase() %>"><input class="experiment-check" type="checkbox" value="<%= product.id %>" aria-label="เลือก <%= product.title %>" data-product-select /><div class="experiment-product-main"><a class="experiment-product-thumb" href="/admin/products/<%= product.id %>/edit" aria-label="แก้ไข <%= product.title %>"><% if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="<%= product.title %>" loading="lazy" /><% } else { %>P<% } %></a><div class="experiment-product-copy"><a href="/admin/products/<%= product.id %>/edit"><strong><%= product.title %></strong></a><small>slug: <%= product.slug %></small><div class="experiment-product-tags"><% if (product.selectedFilterTags && product.selectedFilterTags.length) { product.selectedFilterTags.slice(0, 3).forEach(tag => { %><span class="experiment-product-tag"><%= tag.name %></span><% }) } else { %><span class="experiment-product-tag">ยังไม่ได้เลือกตัวกรอง</span><% } %></div></div></div><div class="experiment-product-price"><button type="button" data-products-price-edit data-product-id="<%= product.id %>" data-product-title="<%= product.title %>" data-price="<%= product.price %>" data-available-stock="<%= product.stockCount %>" aria-label="แก้ไขราคาของ <%= product.title %>"><strong>฿<%= product.price.toLocaleString('th-TH') %></strong></button><% if (product.originalPrice > product.price) { %><del>฿<%= product.originalPrice.toLocaleString('th-TH') %></del><% } %></div><a class="experiment-stock-link <%= product.stockCount < 1 ? 'empty' : '' %>" href="/admin/products/<%= product.id %>/stock">▧ <%= product.stockCount %> รายการ</a><span class="experiment-status"><%= product.status === 'active' ? 'เปิดขาย' : 'ซ่อนอยู่' %></span><div class="experiment-row-actions"><a class="experiment-icon-action" href="/admin/products/<%= product.id %>/stock" aria-label="จัดการสต๊อก <%= product.title %>" title="จัดการสต๊อก">▧</a><a class="experiment-icon-action" href="/admin/products/<%= product.id %>/edit" aria-label="แก้ไข <%= product.title %>" title="แก้ไข">✎</a><form method="post" action="/admin/products/<%= product.id %>/copy" data-experiment-confirm="คัดลอกสินค้านี้หรือไม่?"><button class="experiment-icon-action" type="submit" aria-label="คัดลอก <%= product.title %>" title="คัดลอก">⧉</button></form><form method="post" action="/admin/products/<%= product.id %>/delete" data-experiment-confirm="ลบสินค้า '<%= product.title %>' หรือไม่? การกระทำนี้ย้อนกลับไม่ได้"><button class="experiment-icon-action danger" type="submit" aria-label="ลบ <%= product.title %>" title="ลบ">⌫</button></form></div></article><% }) %></div><div class="experiment-empty" data-products-empty hidden>ไม่พบสินค้าที่ตรงกับคำค้นหา</div></section>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin">⌂<span>ภาพรวม</span></a><a class="active" href="/admin/products">▦<span>สินค้า</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/topups">฿<span>เติมเงิน</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>
<dialog class="experiment-modal" data-products-price-dialog><form method="dialog"><div class="experiment-modal-head"><div><h2>แก้ไขราคาสินค้า</h2><p data-products-price-title></p></div><button class="experiment-modal-close" type="submit" aria-label="ปิด">×</button></div><div class="experiment-modal-body"><label>ราคาขาย (บาท)<input type="number" min="0" step="1" required data-products-price-input /></label><p style="color:var(--ex-red);font-size:11px" data-products-price-error hidden></p><div class="experiment-modal-actions"><button class="experiment-button" type="submit">ยกเลิก</button><button class="experiment-button primary" type="button" data-products-price-save>บันทึกราคา</button></div></div></form></dialog>
<dialog class="experiment-modal" data-products-bulk-dialog><form method="post" action="/admin/products/bulk-price"><div class="experiment-modal-head"><div><h2>ปรับราคาหลายรายการ</h2><p>เลือกสินค้าจากรายการก่อนเปิดหน้าต่างนี้</p></div><button class="experiment-modal-close" type="button" data-products-bulk-close aria-label="ปิด">×</button></div><div class="experiment-modal-body"><label>รูปแบบ<select name="operation"><option value="discount">ลดราคา</option><option value="increase">เพิ่มราคา</option></select></label><label>เปอร์เซ็นต์<input name="percentage" type="number" min="0.01" max="1000" step="0.01" value="10" required /></label><input type="hidden" name="scope" value="selected" /><div data-products-bulk-inputs></div><p style="color:var(--ex-red);font-size:11px" data-products-bulk-error hidden></p><div class="experiment-modal-actions"><button class="experiment-button" type="button" data-products-bulk-close>ยกเลิก</button><button class="experiment-button primary" type="submit">ยืนยันปรับราคา</button></div></div></form></dialog>
<script>
  (function () {
    var rows = Array.from(document.querySelectorAll('[data-product-row]')), search = document.querySelector('[data-products-search]'), empty = document.querySelector('[data-products-empty]'), filter = 'all';
    function refresh() { var query = (search.value || '').toLowerCase().trim(), shown = 0; rows.forEach(function (row) { var match = (!query || row.dataset.search.includes(query)) && (filter === 'all' || row.dataset.status === filter); row.hidden = !match; if (match) shown += 1; }); empty.hidden = shown !== 0; }
    search.addEventListener('input', refresh); document.querySelectorAll('[data-products-filter]').forEach(function (button) { button.addEventListener('click', function () { filter = button.dataset.productsFilter; document.querySelectorAll('[data-products-filter]').forEach(function (item) { item.classList.toggle('active', item === button); }); refresh(); }); });
    var toggle = document.querySelector('[data-products-bulk-toggle]'), menu = document.querySelector('[data-products-bulk-menu]'); toggle.addEventListener('click', function () { menu.hidden = !menu.hidden; toggle.setAttribute('aria-expanded', String(!menu.hidden)); }); document.addEventListener('click', function (event) { if (!event.target.closest('.experiment-action-menu')) { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); } });
    var priceDialog = document.querySelector('[data-products-price-dialog]'), priceInput = document.querySelector('[data-products-price-input]'), priceTitle = document.querySelector('[data-products-price-title]'), priceError = document.querySelector('[data-products-price-error]'), activePrice;
    document.querySelectorAll('[data-products-price-edit]').forEach(function (button) { button.addEventListener('click', function () { activePrice = button; priceInput.value = button.dataset.price; priceTitle.textContent = button.dataset.productTitle; priceError.hidden = true; priceDialog.showModal(); priceInput.focus(); priceInput.select(); }); });
    document.querySelector('[data-products-price-save]').addEventListener('click', async function () { if (!activePrice) return; var button = this; button.disabled = true; try { var response = await fetch('/admin/products/' + encodeURIComponent(activePrice.dataset.productId) + '/price', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: new URLSearchParams({ price: priceInput.value }) }); var data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.message || 'บันทึกราคาไม่สำเร็จ'); activePrice.dataset.price = String(data.price); activePrice.querySelector('strong').textContent = data.formattedPrice; priceDialog.close(); if (window.showExperimentToast) window.showExperimentToast('บันทึกราคาแล้ว'); } catch (error) { priceError.textContent = error.message; priceError.hidden = false; } finally { button.disabled = false; } });
    var bulkDialog = document.querySelector('[data-products-bulk-dialog]'); document.querySelector('[data-products-bulk-price]').addEventListener('click', function () { var selected = document.querySelectorAll('[data-product-select]:checked'), holder = document.querySelector('[data-products-bulk-inputs]'), error = document.querySelector('[data-products-bulk-error]'); menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); if (!selected.length) { error.textContent = 'กรุณาเลือกสินค้าอย่างน้อย 1 รายการก่อน'; error.hidden = false; bulkDialog.showModal(); return; } error.hidden = true; holder.innerHTML = ''; selected.forEach(function (checkbox) { var input = document.createElement('input'); input.type = 'hidden'; input.name = 'productIds'; input.value = checkbox.value; holder.appendChild(input); }); bulkDialog.showModal(); }); document.querySelectorAll('[data-products-bulk-close]').forEach(function (button) { button.addEventListener('click', function () { bulkDialog.close(); }); });
    var actionIcons = [
      '<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 4.5V3h6v1.5M9 9h6M9 13h6M9 17h3"/></svg>',
      '<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m4 16.5-.7 3.2 3.2-.7L18 7.5a2.1 2.1 0 0 0-3-3L4 16.5Z"/><path d="m13.5 6.5 4 4"/></svg>',
      '<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>',
      '<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14M10 11v6M14 11v6M9 7V4h6v3m-9 0 1 13h10l1-13"/></svg>'
    ];
    document.querySelectorAll('.experiment-row-actions').forEach(function (actions) { Array.from(actions.children).forEach(function (control, index) { var button = control.matches('form') ? control.querySelector('button') : control; if (button && actionIcons[index]) button.innerHTML = actionIcons[index]; }); });
  })();
</script>
