<link rel="stylesheet" href="<%= asset('css/admin-experiment-users-v1.css') %>" />
<link rel="stylesheet" href="<%= asset('css/admin-experiment-users-wallet-v1.css') %>" />
<link rel="stylesheet" href="<%= asset('css/admin-experiment-users-api-v1.css') %>" />
<%
  const experimentHref = (overrides = {}) => {
    const values = { q, status, role, registered, pageSize, source, shop: shopFilter, ...overrides };
    const params = new URLSearchParams();
    Object.entries(values).forEach(([key, value]) => {
      if (value !== undefined && value !== null && String(value) !== '') params.set(key, String(value));
    });
    return `/admin/users?${params.toString()}`;
  };
  const roleLabel = value => value === 'admin' ? 'ผู้ดูแลระบบ' : 'สมาชิก';
  const statusLabel = value => value === 'banned' ? 'ถูกระงับ' : 'ใช้งาน';
  const initials = value => String(value || '?').trim().charAt(0).toUpperCase();
%>
<div class="experiment-app experiment-users-page">
  <div class="experiment-main">
    <header class="experiment-topbar">


      <span class="experiment-user-name">admin</span>
    </header>
    <main class="experiment-content">
      <section class="users-page-head">
        <div>
          <div class="experiment-kicker">ผู้ใช้งาน & ลูกค้า</div>
          <h1><%= source === 'api' ? 'ลูกค้าเติมเงิน API' : 'จัดการสมาชิก' %></h1>
          <p><%= source === 'api' ? 'แยกกระเป๋าสินค้า API ตามร้าน พร้อมปรับยอดและเก็บประวัติ' : 'ค้นหา ตรวจสอบสิทธิ์ และดูยอดเครดิตของสมาชิกจากพื้นที่เดียว' %></p>
        </div>
        <div class="users-head-actions">
          <span class="users-page-status"><i></i> <%= source === 'api' ? 'กระเป๋าสินค้า API' : 'ระบบสมาชิก' %></span>
          <% if (source !== 'api') { %><button class="experiment-button primary" type="button" data-users-invite>+ เพิ่มสมาชิก</button><% } %>
        </div>
      </section>

      <section class="users-kpis" aria-label="สรุปสมาชิก">
        <div class="users-kpi users-kpi-primary"><span class="users-kpi-icon">◎</span><small><%= source === 'api' ? 'ลูกค้า API ทั้งหมด' : 'สมาชิกทั้งหมด' %></small><strong><%= memberCounts.all.toLocaleString('th-TH') %></strong><em><%= source === 'api' ? 'แยกตามร้านที่เติมหรือใช้ API' : 'บัญชีในระบบ' %></em><span class="users-kpi-foot"><i></i> ข้อมูลล่าสุดจากร้าน</span></div>
        <div class="users-kpi"><span class="users-kpi-icon mint">✓</span><small>กำลังใช้งาน</small><strong><%= memberCounts.active.toLocaleString('th-TH') %></strong><em>พร้อมเข้าใช้งาน</em><span class="users-kpi-foot"><i></i> สถานะปกติ</span></div>
        <div class="users-kpi"><span class="users-kpi-icon blue">＋</span><small><%= source === 'api' ? 'ร้านที่มีลูกค้า API' : 'สมัครวันนี้' %></small><strong><%= (source === 'api' ? memberCounts.shops : memberCounts.today).toLocaleString('th-TH') %></strong><em><%= source === 'api' ? 'ร้านที่พบประวัติ API' : 'สมาชิกใหม่ในวันนี้' %></em><span class="users-kpi-foot"><i></i> <%= source === 'api' ? 'แยกกระเป๋าตามร้าน' : 'ตามเวลาไทย' %></span></div>
        <div class="users-kpi"><span class="users-kpi-icon gold">฿</span><small><%= source === 'api' ? 'ยอด API คงเหลือรวม' : 'เครดิตรวม' %></small><strong>฿<%= Number(totalWalletBalance || 0).toLocaleString('th-TH') %></strong><em><%= source === 'api' ? 'ไม่รวมเครดิตหน้าร้านปกติ' : 'ยอดเครดิตในระบบ' %></em><span class="users-kpi-foot"><i></i> <%= source === 'api' ? 'อ่านจากกระเป๋า API' : 'อ่านจาก wallet' %></span></div>
      </section>

      <section class="users-workspace experiment-card">
        <nav class="users-audience-tabs" aria-label="เลือกประเภทบัญชี">
          <a class="<%= source === 'store' ? 'active' : '' %>" href="<%= experimentHref({ source: 'store', status: '', role: '', registered: '', shop: '', page: 1 }) %>">สมาชิกหน้าร้าน <b><%= platformMemberCount.toLocaleString('th-TH') %></b></a>
          <a class="<%= source === 'api' ? 'active' : '' %>" href="<%= experimentHref({ source: 'api', status: '', role: '', registered: '', shop: '', page: 1 }) %>">ลูกค้าเติม API <b><%= source === 'api' ? memberCounts.all.toLocaleString('th-TH') : 'ดู' %></b></a>
        </nav>
        <div class="users-workspace-head"><div><h2><%= source === 'api' ? 'ลูกค้ากระเป๋าสินค้า API' : 'สมาชิกในร้าน' %></h2><p><%= matchedCount.toLocaleString('th-TH') %> รายการที่ตรงกับตัวกรอง<%= source === 'api' ? ' · คนเดียวกันคนละร้านจะแสดงแยกบัญชี' : ' · กดชื่อเพื่อเปิดรายละเอียด' %></p></div><span class="users-live-badge"><i></i> <%= source === 'api' ? 'ข้อมูลจากร้านหลักและร้าน API' : 'ข้อมูลสมาชิกจริง' %></span></div>
        <form class="users-toolbar" method="get" action="/admin/users">
          <% if (source === 'api') { %><input type="hidden" name="source" value="api" /><% } %>
          <label class="users-search-wrap"><span aria-hidden="true">⌕</span><input type="search" name="q" value="<%= q %>" placeholder="ค้นหาชื่อผู้ใช้หรืออีเมล..." aria-label="ค้นหาสมาชิก" /></label>
          <label class="users-select-wrap"><span>สถานะ</span><select name="status" aria-label="กรองสถานะสมาชิก"><option value="">ทั้งหมด</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>ใช้งาน</option><option value="banned" <%= status === 'banned' ? 'selected' : '' %>>ถูกระงับ</option></select></label>
          <% if (source === 'api') { %><label class="users-select-wrap"><span>ร้าน</span><select name="shop" aria-label="กรองตามร้าน"><option value="">ทุกร้าน</option><% apiShops.forEach(shop => { %><option value="<%= shop.id %>" <%= String(shopFilter) === String(shop.id) ? 'selected' : '' %>><%= shop.name %></option><% }) %></select></label><% } else { %><label class="users-select-wrap"><span>บทบาท</span><select name="role" aria-label="กรองบทบาทสมาชิก"><option value="">ทุกบทบาท</option><option value="customer" <%= role === 'customer' ? 'selected' : '' %>>สมาชิก</option><option value="admin" <%= role === 'admin' ? 'selected' : '' %>>ผู้ดูแลระบบ</option></select></label><% } %>
          <button class="experiment-button primary users-search-button" type="submit">ค้นหา</button>
          <% if (q || status || role || registered || shopFilter) { %><a class="users-clear-button" href="<%= experimentHref({ q: '', status: '', role: '', registered: '', shop: '', page: 1 }) %>">ล้างตัวกรอง</a><% } %>
        </form>
        <div class="users-tabs" aria-label="กรองรายชื่อ"><a class="users-tab <%= !status && !role && !registered ? 'active' : '' %>" href="<%= experimentHref({ status: '', role: '', registered: '', page: 1 }) %>">ทั้งหมด <b><%= memberCounts.all %></b></a><a class="users-tab <%= status === 'active' ? 'active' : '' %>" href="<%= experimentHref({ status: 'active', role: '', page: 1 }) %>">ใช้งาน <b><%= memberCounts.active %></b></a><a class="users-tab <%= status === 'banned' ? 'active' : '' %>" href="<%= experimentHref({ status: 'banned', role: '', page: 1 }) %>">ถูกระงับ <b><%= memberCounts.banned %></b></a><% if (source === 'store') { %><a class="users-tab <%= role === 'admin' ? 'active' : '' %>" href="<%= experimentHref({ role: 'admin', status: '', registered: '', page: 1 }) %>">ผู้ดูแลระบบ <b><%= memberCounts.admins %></b></a><% } %></div>
        <div class="users-table-wrap">
          <table class="users-table <%= source === 'api' ? 'users-api-table' : '' %>"><thead><tr><th>สมาชิก</th><% if (source === 'api') { %><th>ร้าน API</th><th>เข้าร่วมเมื่อ</th><th>ยอดกระเป๋า API</th><th>สถานะ</th><th>จัดการ</th><% } else { %><th>บทบาท</th><th>เข้าร่วมเมื่อ</th><th>เครดิต</th><th>สถานะ</th><th>จัดการ</th><% } %></tr></thead><tbody>
            <% users.forEach(user => { const userStatus = user.status || 'active'; %>
              <tr>
                <td><div class="users-person"><span class="users-avatar <%= user.role === 'admin' ? 'admin' : '' %>"><%= initials(user.username) %></span><span><% if (source === 'api') { %><strong><%= user.username %></strong><% } else { %><a href="/admin/users/<%= user.id %>"><strong><%= user.username %></strong></a><% } %><small><%= user.email || 'ไม่ระบุอีเมล' %></small></span></div></td>
                <% if (source === 'api') { %>
                  <td><span class="users-api-shop"><%= user.shopName %></span><small class="users-api-shop-slug"><%= user.shopSlug || 'หน้าร้านหลัก' %></small></td>
                  <td><% if (user.createdAt) { %><span class="users-date"><%= new Date(user.createdAt).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Bangkok' }) %></span><small class="users-time"><%= new Date(user.createdAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' }) %></small><% } else { %><span class="users-time">—</span><% } %></td>
                  <td><strong class="users-credit">฿<%= Number(user.catalogWalletBalance || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong><small class="users-time"><%= Number(user.apiTransactionCount || 0).toLocaleString('th-TH') %> รายการ API</small></td>
                <% } else { %>
                  <td><span class="users-role <%= user.role === 'admin' ? 'admin' : '' %>"><%= roleLabel(user.role) %></span></td>
                  <td><span class="users-date"><%= new Date(user.createdAt).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Bangkok' }) %></span><small class="users-time"><%= new Date(user.createdAt).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' }) %></small></td>
                  <td><strong class="users-credit">฿<%= Number(user.walletBalance || 0).toLocaleString('th-TH') %></strong></td>
                <% } %>
                <td><span class="users-status <%= userStatus === 'banned' ? 'banned' : 'active' %>"><i></i><%= statusLabel(userStatus) %></span></td>
                <td><div class="users-row-actions">
                  <% if (source === 'api') { %><button class="users-adjust-button" type="button" data-users-adjust data-wallet-scope="catalog" data-shop-id="<%= user.tenantShopId %>" data-user-id="<%= user.id %>" data-user-name="<%= user.username %>" data-user-balance="<%= Number(user.catalogWalletBalance || 0).toFixed(2) %>" data-user-shop="<%= user.shopName %>">ปรับยอด API</button><% } else { %>
                    <% if ((user.role || 'customer') === 'customer') { %><button class="users-adjust-button" type="button" data-users-adjust data-wallet-scope="store" data-user-id="<%= user.id %>" data-user-name="<%= user.username %>" data-user-balance="<%= Number(user.walletBalance || 0).toFixed(2) %>">ปรับเครดิต</button><% } %>
                    <a class="users-view-link" href="/admin/users/<%= user.id %>">รายละเอียด <span>→</span></a>
                    <% if (user.role !== 'admin') { %><form method="post" action="/admin/users/<%= user.id %>/toggle-ban" data-experiment-confirm="<%= userStatus === 'banned' ? 'ปลดระงับสมาชิกคนนี้หรือไม่?' : 'ระงับสมาชิกคนนี้หรือไม่?' %>"><button class="users-more-action" type="submit" aria-label="เปลี่ยนสถานะ <%= user.username %>">•••</button></form><% } %>
                  <% } %>
                </div></td>
              </tr>
            <% }); %>
            <% if (!users.length) { %><tr><td colspan="6"><div class="users-empty"><span>⌕</span><strong><%= source === 'api' ? 'ยังไม่พบลูกค้าที่เติมหรือใช้กระเป๋า API' : 'ไม่พบสมาชิกที่ตรงกับตัวกรอง' %></strong><p><%= source === 'api' ? 'เมื่อมีรายการเติมเงินหรือใช้สินค้า API รายชื่อจะแสดงแยกตามร้านที่นี่' : 'ลองค้นหาด้วยชื่อหรืออีเมลอื่น หรือกดล้างตัวกรอง' %></p><a class="experiment-button" href="<%= experimentHref({ q: '', status: '', role: '', registered: '', shop: '', page: 1 }) %>"><%= source === 'api' ? 'ดูรายการ API ทั้งหมด' : 'ดูสมาชิกทั้งหมด' %></a></div></td></tr><% } %>
          </tbody></table>
        </div>
        <div class="users-table-foot"><span>แสดง <b><%= users.length ? ((page - 1) * pageSize) + 1 : 0 %>–<%= Math.min(page * pageSize, matchedCount) %></b> จาก <b><%= matchedCount %></b> รายการ</span><div class="users-pagination"><% if (page > 1) { %><a href="<%= experimentHref({ page: page - 1 }) %>" aria-label="หน้าก่อนหน้า">←</a><% } else { %><span class="disabled">←</span><% } %><strong>หน้า <%= page %> / <%= totalPages %></strong><% if (page < totalPages) { %><a href="<%= experimentHref({ page: page + 1 }) %>" aria-label="หน้าถัดไป">→</a><% } else { %><span class="disabled">→</span><% } %></div></div>
      </section>
    </main>
  </div>
</div>

<dialog class="users-invite-dialog" data-users-dialog aria-labelledby="users-dialog-title">
  <form method="post" action="/admin/users/new" class="users-invite-form">
    <div class="users-dialog-head"><div><span class="users-build-kicker">จัดการสมาชิก</span><h2 id="users-dialog-title">เพิ่มสมาชิกใหม่</h2><p>สร้างบัญชีในระบบจริงและกำหนดบทบาทสำหรับการเข้าใช้งาน</p></div><button type="button" class="users-dialog-close" data-users-dialog-close aria-label="ปิดหน้าต่าง">×</button></div>
    <label>ชื่อผู้ใช้<input name="username" required maxlength="100" placeholder="เช่น team-support" /></label>
    <label>อีเมล<input name="email" type="email" required maxlength="254" placeholder="name@example.com" /></label>
    <label>รหัสผ่านเริ่มต้น<input name="password" type="password" required minlength="6" autocomplete="new-password" placeholder="อย่างน้อย 6 ตัวอักษร" /></label>
    <label>บทบาท<select name="role"><option value="customer">สมาชิก</option><option value="admin">ผู้ดูแลระบบ</option></select></label>
    <div class="users-dialog-actions"><button type="button" class="experiment-button" data-users-dialog-close>ยกเลิก</button><button type="submit" class="experiment-button primary">สร้างสมาชิก</button></div>
  </form>
</dialog>
<dialog class="users-wallet-dialog" data-users-wallet-dialog aria-labelledby="users-wallet-title" aria-describedby="users-wallet-description">
  <form method="post" action="/admin/users" class="users-wallet-form" data-users-wallet-form>
    <div class="users-dialog-head"><div><span class="users-build-kicker" data-wallet-kicker>ปรับเครดิต · บันทึกประวัติทุกครั้ง</span><h2 id="users-wallet-title" data-wallet-title>ปรับเครดิตสมาชิก</h2><p id="users-wallet-description">ตรวจสอบชื่อสมาชิก ยอดก่อนและหลัง แล้วระบุเหตุผลก่อนยืนยัน</p></div><button type="button" class="users-dialog-close" data-wallet-close aria-label="ปิดหน้าต่างปรับเครดิต">×</button></div>
    <div class="users-wallet-member"><span class="users-avatar" data-wallet-avatar aria-hidden="true">?</span><div><strong data-wallet-name>สมาชิก</strong><small><span data-wallet-balance-label>ยอดปัจจุบัน</span> <b data-wallet-current></b><span data-wallet-shop></span></small></div></div>
    <input type="hidden" name="expectedBalance" data-wallet-expected />
    <input type="hidden" name="returnTo" value="<%= experimentHref() %>" />
    <label class="users-wallet-field">รายการ<select name="operation" data-wallet-operation required><option value="add">เพิ่มเครดิต</option><option value="subtract">หักเครดิต</option></select></label>
    <label class="users-wallet-field">จำนวนเงิน<input type="number" name="amount" data-wallet-amount min="0.01" max="1000000" step="0.01" inputmode="decimal" required aria-describedby="wallet-amount-help wallet-adjustment-error" /><small id="wallet-amount-help">ระบุจำนวนตั้งแต่ ฿0.01 ถึง ฿1,000,000 ต่อครั้ง</small></label>
    <div class="users-wallet-preview" aria-live="polite" aria-atomic="true"><div><span>ยอดเดิม</span><strong data-wallet-before>฿0.00</strong></div><span class="users-wallet-arrow" aria-hidden="true">→</span><div><span>ยอดหลังปรับ</span><strong data-wallet-after>฿0.00</strong></div></div>
    <p class="users-wallet-error" id="wallet-adjustment-error" data-wallet-error role="status" aria-live="polite"></p>
    <label class="users-wallet-field">เหตุผล <span aria-hidden="true">*</span><textarea name="note" rows="3" minlength="3" maxlength="250" required placeholder="เช่น ชดเชยยอดที่ตกหล่น หรือแก้ไขรายการผิดพลาด"></textarea><small>บันทึกพร้อมประวัติเครดิต เพื่อให้ตรวจสอบย้อนหลังได้ (3–250 ตัวอักษร)</small></label>
    <div class="users-dialog-actions"><button type="button" class="experiment-button" data-wallet-close>ยกเลิก</button><button type="submit" class="experiment-button primary" data-wallet-submit disabled>ตรวจสอบและบันทึก</button></div>
  </form>
</dialog>
<script>
  (() => {
    const dialog = document.querySelector('[data-users-dialog]');
    const open = document.querySelector('[data-users-invite]');
    const closes = document.querySelectorAll('[data-users-dialog-close]');
    open?.addEventListener('click', () => dialog?.showModal());
    closes.forEach(button => button.addEventListener('click', () => dialog?.close()));
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });

    const walletDialog = document.querySelector('[data-users-wallet-dialog]');
    const walletForm = document.querySelector('[data-users-wallet-form]');
    const walletName = document.querySelector('[data-wallet-name]');
    const walletAvatar = document.querySelector('[data-wallet-avatar]');
    const walletTitle = document.querySelector('[data-wallet-title]');
    const walletKicker = document.querySelector('[data-wallet-kicker]');
    const walletBalanceLabel = document.querySelector('[data-wallet-balance-label]');
    const walletCurrent = document.querySelector('[data-wallet-current]');
    const walletShop = document.querySelector('[data-wallet-shop]');
    const walletExpected = document.querySelector('[data-wallet-expected]');
    const walletOperation = document.querySelector('[data-wallet-operation]');
    const walletAmount = document.querySelector('[data-wallet-amount]');
    const walletError = document.querySelector('[data-wallet-error]');
    const walletSubmit = document.querySelector('[data-wallet-submit]');
    let activeMember = { name: '', balance: 0, scope: 'store', shopName: '' };
    const formatMoney = value => `฿${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}`;
    const updateWalletPreview = () => {
      const amount = Number(walletAmount?.value);
      const validAmount = Number.isFinite(amount) && amount >= 0.01 && amount <= 1000000;
      const delta = validAmount ? (walletOperation?.value === 'subtract' ? -amount : amount) : 0;
      const next = activeMember.balance + delta;
      const insufficient = validAmount && next < 0;
      const before = document.querySelector('[data-wallet-before]');
      const after = document.querySelector('[data-wallet-after]');
      if (before) before.textContent = formatMoney(activeMember.balance);
      if (after) after.textContent = formatMoney(insufficient ? activeMember.balance : next);
      if (walletError) walletError.textContent = insufficient ? 'ยอดเครดิตปัจจุบันไม่พอสำหรับการหักจำนวนนี้' : '';
      walletAmount?.setCustomValidity(insufficient ? 'ยอดเครดิตปัจจุบันไม่พอสำหรับการหักจำนวนนี้' : '');
      if (walletSubmit) walletSubmit.disabled = !walletForm?.action.endsWith('/wallet') || !validAmount || insufficient;
      return { amount, next, validAmount, insufficient };
    };
    document.querySelectorAll('[data-users-adjust]').forEach(button => button.addEventListener('click', () => {
      if (!walletDialog || !walletForm) return;
      const userId = button.dataset.userId || '';
      const isCatalogWallet = button.dataset.walletScope === 'catalog';
      const shopId = button.dataset.shopId || '';
      activeMember = {
        name: button.dataset.userName || 'สมาชิก',
        balance: Number(button.dataset.userBalance) || 0,
        scope: isCatalogWallet ? 'catalog' : 'store',
        shopName: button.dataset.userShop || '',
      };
      walletForm.action = isCatalogWallet
        ? `/admin/users/api/${encodeURIComponent(shopId)}/${encodeURIComponent(userId)}/wallet`
        : `/admin/users/${encodeURIComponent(userId)}/wallet`;
      if (walletName) walletName.textContent = activeMember.name;
      if (walletAvatar) walletAvatar.textContent = activeMember.name.trim().charAt(0).toUpperCase() || '?';
      if (walletTitle) walletTitle.textContent = isCatalogWallet ? 'ปรับยอดกระเป๋า API' : 'ปรับเครดิตสมาชิก';
      if (walletKicker) walletKicker.textContent = isCatalogWallet ? 'เครดิตสินค้า API · แยกร้าน · บันทึกประวัติทุกครั้ง' : 'ปรับเครดิต · บันทึกประวัติทุกครั้ง';
      if (walletBalanceLabel) walletBalanceLabel.textContent = isCatalogWallet ? 'ยอดกระเป๋าสินค้า API' : 'ยอดปัจจุบัน';
      if (walletCurrent) walletCurrent.textContent = formatMoney(activeMember.balance);
      if (walletShop) walletShop.textContent = activeMember.shopName ? ` · ${activeMember.shopName}` : '';
      if (walletExpected) walletExpected.value = activeMember.balance.toFixed(2);
      if (walletOperation) walletOperation.value = 'add';
      if (walletAmount) walletAmount.value = '';
      if (walletError) walletError.textContent = '';
      walletDialog.showModal();
      updateWalletPreview();
      walletAmount?.focus();
    }));
    walletOperation?.addEventListener('change', updateWalletPreview);
    walletAmount?.addEventListener('input', updateWalletPreview);
    document.querySelectorAll('[data-wallet-close]').forEach(button => button.addEventListener('click', () => walletDialog?.close()));
    walletDialog?.addEventListener('click', event => { if (event.target === walletDialog) walletDialog.close(); });
    walletDialog?.addEventListener('close', () => {
      walletForm?.reset();
      if (walletForm) walletForm.action = '/admin/users';
      updateWalletPreview();
    });
    walletForm?.addEventListener('submit', event => {
      const preview = updateWalletPreview();
      if (!walletForm.reportValidity() || !preview.validAmount || preview.insufficient || !walletForm.action.endsWith('/wallet')) {
        event.preventDefault();
        return;
      }
      const operationLabel = walletOperation.value === 'subtract' ? 'หักเครดิต' : 'เพิ่มเครดิต';
      const delta = walletOperation.value === 'subtract' ? -preview.amount : preview.amount;
      const reason = walletForm.elements.note.value.trim();
      const walletNameLabel = activeMember.scope === 'catalog' ? 'เครดิตสินค้า API' : 'เครดิตหน้าร้าน';
      const shopLine = activeMember.shopName ? `\nร้าน ${activeMember.shopName}` : '';
      const summary = `ยืนยัน${operationLabel}${activeMember.scope === 'catalog' ? ' API' : ''}ให้ ${activeMember.name}?${shopLine}\nกระเป๋า ${walletNameLabel}\nยอดเดิม ${formatMoney(activeMember.balance)}\nยอดหลังปรับ ${formatMoney(activeMember.balance + delta)}\nเหตุผล: ${reason}`;
      if (!window.confirm(summary)) event.preventDefault();
      else if (walletSubmit) {
        walletSubmit.disabled = true;
        walletSubmit.textContent = 'กำลังบันทึก…';
      }
    });
  })();
</script>
