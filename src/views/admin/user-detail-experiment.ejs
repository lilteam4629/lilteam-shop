<link rel="stylesheet" href="<%= asset('css/admin-experiment-users-v1.css') %>" />
<%
  const userStatus = user.status || 'active';
  const roleLabel = user.role === 'admin' ? 'ผู้ดูแลระบบ' : 'สมาชิก';
  const initials = String(user.username || '?').trim().charAt(0).toUpperCase();
%>
<div class="experiment-app experiment-users-page">
  <div class="experiment-main">
    <header class="experiment-topbar"><div class="experiment-build-legend"><span><i></i> ใช้งานได้</span><span><i class="pending"></i> รอทำ</span></div><button class="experiment-icon-button" data-experiment-notifications type="button" aria-label="ดูการแจ้งเตือน">◌</button><span class="experiment-user-name">admin</span></header>
    <main class="experiment-content">
      <div class="users-detail-back"><a href="/admin/users?ui=experiment">← กลับรายชื่อสมาชิก</a><span>ผู้ใช้งาน & ลูกค้า · รายละเอียด</span></div>
      <section class="users-page-head"><div><div class="experiment-kicker">MEMBER PROFILE · LIVE DATA</div><h1><%= user.username %></h1><p>ตรวจสอบบัญชี เครดิต และประวัติการสั่งซื้อจากข้อมูลในฐานทดลอง</p></div><div class="users-head-actions"><span class="users-status <%= userStatus === 'banned' ? 'banned' : 'active' %>"><i></i><%= userStatus === 'banned' ? 'ถูกระงับ' : 'ใช้งาน' %></span><% if (user.role !== 'admin') { %><form method="post" action="/admin/users/<%= user.id %>/toggle-ban" data-experiment-confirm="<%= userStatus === 'banned' ? 'ปลดระงับสมาชิกคนนี้หรือไม่?' : 'ระงับสมาชิกคนนี้หรือไม่?' %>"><button class="experiment-button" type="submit"><%= userStatus === 'banned' ? 'ปลดระงับ' : 'ระงับบัญชี' %></button></form><% } %></div></section>
      <section class="users-detail-grid">
        <article class="users-profile-card experiment-card"><div class="users-profile-head"><span class="users-avatar <%= user.role === 'admin' ? 'admin' : '' %>"><%= initials %></span><div><h2><%= user.username %></h2><p><%= user.email || 'ไม่ระบุอีเมล' %></p></div></div><dl><div><dt>รหัสสมาชิก</dt><dd><%= user.id %></dd></div><div><dt>บทบาท</dt><dd><span class="users-role <%= user.role === 'admin' ? 'admin' : '' %>"><%= roleLabel %></span></dd></div><div><dt>วันที่สมัคร</dt><dd><%= new Date(user.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></dd></div><div><dt>เครดิตคงเหลือ</dt><dd class="users-credit">฿<%= Number(user.walletBalance || 0).toLocaleString('th-TH') %></dd></div></dl></article>
        <div class="users-detail-stats"><article class="users-detail-stat experiment-card"><small>คำสั่งซื้อทั้งหมด</small><strong><%= orderCount %></strong><span>รายการ</span></article><article class="users-detail-stat experiment-card"><small>ยอดซื้อรวม</small><strong>฿<%= Number(totalSpent || 0).toLocaleString('th-TH') %></strong><span>ไม่นับรายการยกเลิก</span></article><article class="users-detail-stat experiment-card"><small>รายการเติมเงิน</small><strong><%= topups.length %></strong><span>ประวัติที่แสดง</span></article><article class="users-detail-stat experiment-card"><small>ธุรกรรมเครดิต</small><strong><%= transactions.length %></strong><span>รายการล่าสุด</span></article></div>
      </section>
      <section class="users-history experiment-card"><div class="users-workspace-head"><div><h2>คำสั่งซื้อล่าสุด</h2><p>รายการที่เชื่อมกับสมาชิกคนนี้</p></div><span class="users-live-badge"><i></i> ข้อมูลจริงในฐานทดลอง</span></div><div class="users-history-list"><% orders.forEach(order => { %><a href="/admin/orders/<%= order.id %>?ui=experiment" class="users-history-row"><span><strong>#<%= order.id %></strong><small><%= new Date(order.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></small></span><span><b>฿<%= Number(order.total || 0).toLocaleString('th-TH') %></b><em class="users-status <%= order.status === 'cancelled' ? 'banned' : 'active' %>"><i></i><%= order.status === 'completed' ? 'สำเร็จ' : order.status === 'pending' ? 'รอดำเนินการ' : 'ยกเลิก' %></em></span></a><% }); %><% if (!orders.length) { %><div class="users-empty"><span>▤</span><strong>ยังไม่มีคำสั่งซื้อ</strong><p>เมื่อสมาชิกสั่งซื้อ รายการจะปรากฏที่นี่</p></div><% } %></div></section>
    </main>
  </div>
</div>
