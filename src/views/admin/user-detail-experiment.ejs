<link rel="stylesheet" href="<%= asset('css/admin-experiment-users-v1.css') %>" />
<%
  const userStatus = user.status || 'active';
  const roleLabel = user.role === 'admin' ? 'ผู้ดูแลระบบ' : 'สมาชิก';
  const initials = String(user.username || '?').trim().charAt(0).toUpperCase();
  const topupRows = Array.isArray(topups) ? topups : [];
  const transactionRows = Array.isArray(transactions) ? transactions : [];
  const topupStatusLabel = status => status === 'approved' ? 'อนุมัติแล้ว' : status === 'rejected' ? 'ปฏิเสธแล้ว' : status === 'verifying' ? 'กำลังตรวจ' : 'รอตรวจสอบ';
  const transactionLabel = type => ({ topup: 'เติมเงิน', purchase: 'ซื้อสินค้า', refund: 'คืนเครดิต', adjust: 'ปรับเครดิต', minigame: 'มินิเกม' })[type] || type || 'ธุรกรรม';
%>
<div class="experiment-app experiment-users-page">
  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name">admin</span></header>
    <main class="experiment-content">
      <div class="users-detail-back"><a href="/admin/users">← กลับรายชื่อสมาชิก</a><span>ผู้ใช้งาน & ลูกค้า · รายละเอียด</span></div>
      <section class="users-page-head"><div><div class="experiment-kicker">MEMBER PROFILE · LIVE DATA</div><h1><%= user.username %></h1><p>ตรวจสอบบัญชี เครดิต และประวัติการสั่งซื้อจากข้อมูลในฐานข้อมูลจริง</p></div><div class="users-head-actions"><span class="users-status <%= userStatus === 'banned' ? 'banned' : 'active' %>"><i></i><%= userStatus === 'banned' ? 'ถูกระงับ' : 'ใช้งาน' %></span><% if (user.role !== 'admin') { %><form method="post" action="/admin/users/<%= user.id %>/toggle-ban" data-experiment-confirm="<%= userStatus === 'banned' ? 'ปลดระงับสมาชิกคนนี้หรือไม่?' : 'ระงับสมาชิกคนนี้หรือไม่?' %>"><button class="experiment-button" type="submit"><%= userStatus === 'banned' ? 'ปลดระงับ' : 'ระงับบัญชี' %></button></form><% } %></div></section>
      <section class="users-detail-grid">
        <article class="users-profile-card experiment-card"><div class="users-profile-head"><span class="users-avatar <%= user.role === 'admin' ? 'admin' : '' %>"><%= initials %></span><div><h2><%= user.username %></h2><p><%= user.email || 'ไม่ระบุอีเมล' %></p></div></div><dl><div><dt>รหัสสมาชิก</dt><dd><%= user.id %></dd></div><div><dt>บทบาท</dt><dd><span class="users-role <%= user.role === 'admin' ? 'admin' : '' %>"><%= roleLabel %></span></dd></div><div><dt>วันที่สมัคร</dt><dd><%= new Date(user.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></dd></div><div><dt>เครดิตคงเหลือ</dt><dd class="users-credit">฿<%= Number(user.walletBalance || 0).toLocaleString('th-TH') %></dd></div></dl></article>
        <div class="users-detail-stats"><article class="users-detail-stat experiment-card"><small>คำสั่งซื้อทั้งหมด</small><strong><%= orderCount %></strong><span>รายการ</span></article><article class="users-detail-stat experiment-card"><small>ยอดซื้อรวม</small><strong>฿<%= Number(totalSpent || 0).toLocaleString('th-TH') %></strong><span>ไม่นับรายการยกเลิก</span></article><article class="users-detail-stat experiment-card"><small>รายการเติมเงิน</small><strong><%= topups.length %></strong><span>ประวัติที่แสดง</span></article><article class="users-detail-stat experiment-card"><small>ธุรกรรมเครดิต</small><strong><%= transactions.length %></strong><span>รายการล่าสุด</span></article></div>
      </section>
      <section class="users-history experiment-card"><div class="users-workspace-head"><div><h2>คำสั่งซื้อล่าสุด</h2><p>รายการที่เชื่อมกับสมาชิกคนนี้</p></div><span class="users-live-badge"><i></i> ข้อมูลคำสั่งซื้อจริง</span></div><div class="users-history-list"><% orders.forEach(order => { %><a href="/admin/orders/<%= order.id %>" class="users-history-row"><span><strong>#<%= order.id %></strong><small><%= new Date(order.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></small></span><span><b>฿<%= Number(order.total || 0).toLocaleString('th-TH') %></b><em class="users-status <%= order.status === 'cancelled' ? 'banned' : 'active' %>"><i></i><%= order.status === 'completed' ? 'สำเร็จ' : order.status === 'pending' ? 'รอดำเนินการ' : 'ยกเลิก' %></em></span></a><% }); %><% if (!orders.length) { %><div class="users-empty"><span>▤</span><strong>ยังไม่มีคำสั่งซื้อ</strong><p>เมื่อสมาชิกสั่งซื้อ รายการจะปรากฏที่นี่</p></div><% } %></div></section>
      <section class="users-history experiment-card"><div class="users-workspace-head"><div><h2>รายการเติมเงินล่าสุด</h2><p>สถานะและยอดเงินของคำขอเติมเงิน</p></div><span class="users-live-badge"><i></i> <%= topupRows.length %> รายการ</span></div><div class="users-history-list"><% topupRows.forEach(request => { %><div class="users-history-row"><span><strong>#<%= request.refCode || request.id %></strong><small><%= new Date(request.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %> · <%= request.method === 'truemoney_angpao' ? 'ซอง TrueMoney' : request.method === 'promptpay' ? 'พร้อมเพย์' : 'โอนธนาคาร' %></small></span><span><b>฿<%= Number(request.amount || 0).toLocaleString('th-TH') %></b><em class="users-status <%= request.status === 'approved' ? 'active' : request.status === 'rejected' ? 'banned' : '' %>"><i></i><%= topupStatusLabel(request.status) %></em></span></div><% }); %><% if (!topupRows.length) { %><div class="users-empty"><span>฿</span><strong>ยังไม่มีรายการเติมเงิน</strong></div><% } %></div></section>
      <section class="users-history experiment-card"><div class="users-workspace-head"><div><h2>ประวัติเครดิต</h2><p>รายการเพิ่ม หัก และเปลี่ยนแปลงเครดิตย้อนหลัง</p></div><span class="users-live-badge"><i></i> <%= transactionRows.length %> รายการ</span></div><div class="users-history-list"><% transactionRows.forEach(transaction => { const amount = Number(transaction.amount || 0); %><div class="users-history-row"><span><strong><%= transactionLabel(transaction.type) %></strong><small><%= new Date(transaction.createdAt).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %><%= transaction.note ? ` · ${String(transaction.note).slice(0, 140)}` : '' %></small></span><span><b><%= amount >= 0 ? '+' : '−' %>฿<%= Math.abs(amount).toLocaleString('th-TH') %></b><small>คงเหลือ ฿<%= Number(transaction.balanceAfter ?? user.walletBalance ?? 0).toLocaleString('th-TH') %></small></span></div><% }); %><% if (!transactionRows.length) { %><div class="users-empty"><span>◌</span><strong>ยังไม่มีประวัติเครดิต</strong></div><% } %></div></section>
    </main>
  </div>
</div>
