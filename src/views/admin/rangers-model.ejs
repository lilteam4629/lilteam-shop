<div class="studio-page-shell space-y-5">
  <div class="studio-page-head flex flex-wrap items-end justify-between gap-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6">
    <div><span class="studio-page-kicker">SYSTEM LAB · LINE RANGERS STUDIO</span><h1 class="mt-1 text-3xl font-black">ศูนย์จัดการโมเดล LINE Rangers</h1><p class="mt-2 text-sm text-[var(--text-3)]">รวมการเปิดใช้โมเดล คลังตัวละคร เกียร์ Top 100 และการจัดทีมสินค้าไว้ในหน้าเดียว</p></div>
    <div class="flex gap-2"><a href="/preview/rangers-market" target="_blank" rel="noopener" class="rounded-xl border border-[var(--border)] px-4 py-2.5 text-sm font-bold">ดูหน้าร้าน ↗</a><a href="/admin/rangers-catalog" class="rounded-xl bg-[var(--gold)] px-4 py-2.5 text-sm font-bold text-[var(--gold-contrast)]">เปิดคลังจัดทีม</a></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5"><small class="text-[var(--text-4)]">โมเดลหน้าร้าน</small><strong class="mt-2 block text-xl"><%= currentModel === 'rangers-market' ? 'Rangers Market' : currentModel %></strong><span class="mt-1 block text-xs <%= currentModel === 'rangers-market' ? 'text-emerald-500' : 'text-[var(--text-4)]' %>"><%= currentModel === 'rangers-market' ? '● กำลังใช้งาน' : 'ยังไม่ได้เลือกโมเดลนี้' %></span></div>
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5"><small class="text-[var(--text-4)]">คลังตัวละครและเกียร์</small><strong class="mt-2 block text-xl"><%= sourceCount.toLocaleString() %></strong><span class="mt-1 block text-xs text-[var(--text-3)]">รายการจาก Handbook</span></div>
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5"><small class="text-[var(--text-4)]">สินค้าในร้าน</small><strong class="mt-2 block text-xl"><%= productCount %></strong><span class="mt-1 block text-xs text-[var(--text-3)]">ผูกตัวละครแล้ว <%= assignedProductCount %> รายการ</span></div>
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5"><small class="text-[var(--text-4)]">สถานะคลังหน้าร้าน</small><strong class="mt-2 block text-xl <%= catalog.enabled ? 'text-emerald-500' : 'text-[var(--text-4)]' %>"><%= catalog.enabled ? 'เปิดใช้งาน' : 'ปิดอยู่' %></strong><span class="mt-1 block text-xs text-[var(--text-3)]">อัปเดตอัตโนมัติทุกวัน</span></div>
  </div>
  <div class="grid gap-5 lg:grid-cols-2">
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6"><span class="studio-page-kicker">01 · STOREFRONT</span><h2 class="mt-1 text-xl font-black">เลือกโมเดลหน้าร้าน</h2><p class="mt-1 text-sm text-[var(--text-3)]">เปลี่ยนเฉพาะรูปแบบหน้าร้าน ไม่กระทบสินค้า ราคา หรือข้อมูลลูกค้า</p>
      <form action="/admin/storefront-models" method="post" class="mt-5 space-y-3"><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-[var(--gold)] bg-[var(--gold)]/10 p-4"><input type="radio" name="model" value="rangers-market" <%= currentModel === 'rangers-market' ? 'checked' : '' %>><span><b class="block">Rangers Market</b><small class="text-[var(--text-3)]">หน้าคลังตัวละคร เกียร์ Top 100 และรายการไอดี</small></span></label><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-[var(--border)] p-4"><input type="radio" name="model" value="classic" <%= currentModel === 'classic' ? 'checked' : '' %>><span><b class="block">โมเดลมาตรฐาน</b><small class="text-[var(--text-3)]">กลับไปใช้หน้าร้านมาตรฐาน</small></span></label><button class="w-full rounded-xl bg-[var(--gold)] px-4 py-3 font-bold text-[var(--gold-contrast)]">บันทึกโมเดลที่เลือก</button></form>
    </section>
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6"><span class="studio-page-kicker">02 · ENGINE</span><h2 class="mt-1 text-xl font-black">ระบบ LINE Rangers</h2><p class="mt-1 text-sm text-[var(--text-3)]">ควบคุมการแสดงผลและข้อมูลของโมเดลนี้โดยเฉพาะ</p><div class="mt-5 grid gap-3 sm:grid-cols-2"><form action="/admin/rangers-catalog/toggle" method="post"><input type="hidden" name="enabled" value="<%= catalog.enabled ? '0' : '1' %>"><button class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-left font-bold"><span class="block"><%= catalog.enabled ? 'ปิดคลังหน้าร้าน' : 'เปิดคลังหน้าร้าน' %></span><small class="font-normal text-[var(--text-3)]"><%= catalog.enabled ? 'ซ่อนคลังจากลูกค้า' : 'เปิดตัวละคร/เกียร์ให้ลูกค้า' %></small></button></form><form action="/admin/rangers-catalog/refresh" method="post"><button class="w-full rounded-xl border border-[var(--border)] px-4 py-3 text-left font-bold"><span class="block">↻ อัปเดตคลังตอนนี้</span><small class="font-normal text-[var(--text-3)]">ตัวละคร เกียร์ และ Top 100</small></button></form><a href="/admin/rangers-catalog" class="rounded-xl bg-[var(--input)] px-4 py-3 font-bold"><span class="block">จัดทีมให้สินค้า</span><small class="font-normal text-[var(--text-3)]">ลากตัวละคร/เกียร์ไปผูกกับสินค้า</small></a><a href="/admin/theme" class="rounded-xl bg-[var(--input)] px-4 py-3 font-bold"><span class="block">ตั้งค่าสีและธีม</span><small class="font-normal text-[var(--text-3)]">ปรับสีของโมเดลหน้าร้าน</small></a></div></section>
  </div>
</div>
