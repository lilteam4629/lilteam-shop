<link rel="stylesheet" href="<%= asset('css/admin-experiment-orders-v1.css') %>" />
<% const buyerName = buyer?.username || 'ไม่พบข้อมูลผู้ซื้อ'; const statusLabel = order.status === 'completed' ? 'สำเร็จ' : order.status === 'pending' ? 'รอดำเนินการ' : 'ยกเลิก'; %>
<div class="experiment-app experiment-orders-page"><aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า"><div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ · รุ่นทดลอง</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู">‹</button></div><div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin?ui=experiment"><span>▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products?ui=experiment"><span>◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products?ui=experiment"><span>◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags?ui=experiment"><span>◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories?ui=experiment"><span>☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item active" href="/admin/orders?ui=experiment"><span>▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span>▭</span><span>เติมเงิน & ตรวจสอบ</span><em class="experiment-nav-status pending">รอทำ</em></a></div></div><div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span>⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div></aside><div class="experiment-main"><header class="experiment-topbar"><div class="experiment-build-legend"><span><i></i> ใช้งานได้</span><span><i class="pending"></i> รอทำ</span></div><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header><main class="experiment-content"><section class="order-detail-page"><div class="order-detail-head"><div><a class="order-detail-back" href="/admin/orders?ui=experiment">← กลับไปหน้ารวมคำสั่งซื้อ</a><h1 class="order-detail-title">คำสั่งซื้อ #<%= order.id %></h1><p class="order-detail-sub">สั่งซื้อเมื่อ <%= new Date(order.createdAt).toLocaleString('th-TH',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Bangkok'}) %></p><% if(order.salesChannel === 'catalog-api-fulfillment'){ %><span class="experiment-inline-status" style="display:inline-flex;margin-top:9px">คำสั่งซื้อ Partner · <%= order.tenantShopName || order.tenantShopId || '-' %></span><% } %></div><span class="orders-status <%= order.status %>"><i></i><%= statusLabel %></span></div><div class="order-detail-grid"><div class="order-panel"><h2>รายการสินค้าที่จัดส่ง <span style="color:var(--ex-muted);font-size:10px;font-weight:500">· <%= itemsWithCreds.length %> รายการ</span></h2><% itemsWithCreds.forEach((item,index)=>{ %><div class="order-item"><div class="order-item-image"><% if(item.productImage){ %><img src="<%= item.productImage %>" alt="รูปสินค้า <%= item.title %>" loading="lazy"><% }else{ %><span>◇</span><% } %></div><div class="order-item-copy"><strong><%= item.title %></strong><small>รหัสสินค้า: <%= item.productId %></small><% if(item.importedFileCode){ %><small>รหัสไฟล์นำเข้า: <%= item.importedFileCode %></small><% } %><% if(item.fulfillmentMode === 'contact'){ %><small style="color:#9a6412">ต้องติดต่อร้านเพื่อรับมอบสินค้า</small><% }else if(item.credentials){ %><small style="color:var(--ex-green-dark)">มีข้อมูลคีย์/บัญชีสำหรับจัดส่งแล้ว</small><% } %></div><span class="order-item-price">฿<%= Number(item.price||0).toLocaleString('th-TH') %></span></div><% }) %></div><div class="order-side-stack"><div class="order-panel"><h2>ข้อมูลผู้ซื้อ</h2><div class="order-buyer-line"><span class="orders-avatar"><%= buyerName[0].toUpperCase() %></span><span><strong><%= buyerName %></strong><small><%= buyer?.email || '-' %></small></span></div></div><div class="order-panel"><h2>สรุปการชำระเงิน</h2><div class="order-summary-row"><span>ยอดรวมสินค้า</span><span>฿<%= Number(order.subtotal || order.total || 0).toLocaleString('th-TH') %></span></div><% if(order.discount>0){ %><div class="order-summary-row"><span>ส่วนลด</span><span style="color:var(--ex-green-dark)">-฿<%= Number(order.discount).toLocaleString('th-TH') %></span></div><% } %><div class="order-summary-row total"><span>ยอดชำระสุทธิ</span><strong>฿<%= Number(order.total||0).toLocaleString('th-TH') %></strong></div><form action="/admin/orders/<%= order.id %>/status?ui=experiment" method="post" class="order-status-form"><label for="order-status">เปลี่ยนสถานะคำสั่งซื้อ</label><select id="order-status" name="status"><option value="completed" <%= order.status==='completed'?'selected':'' %>>สำเร็จ</option><option value="pending" <%= order.status==='pending'?'selected':'' %>>รอดำเนินการ</option><option value="cancelled" <%= order.status==='cancelled'?'selected':'' %>>ยกเลิก</option></select><button type="submit">บันทึกสถานะ</button></form></div></div></div></section></main></div></div>
<script>document.querySelector('[data-experiment-collapse]')?.addEventListener('click',()=>document.documentElement.classList.toggle('experiment-sidebar-collapsed'));</script>
