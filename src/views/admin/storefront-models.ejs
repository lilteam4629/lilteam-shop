<div class="studio-page-head mb-6">
  <div><span class="studio-page-kicker">STOREFRONT MODEL</span><h1>เลือกโมเดลหน้าร้าน</h1><p>เลือกหน้าตาของร้านโดยไม่เปลี่ยนสินค้า รูป ราคา สต็อก หรือข้อมูลลูกค้า</p></div>
  <a href="/" target="_blank" rel="noopener" class="studio-secondary-action">ดูหน้าร้าน ↗</a>
</div>

<p class="mb-3 rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 text-sm text-[var(--text-3)]">โมเดลจะเปลี่ยนเฉพาะหน้าตาร้าน ส่วนสินค้า ราคา สต็อก และข้อมูลลูกค้ายังคงเดิม ปรับสีเพิ่มเติมได้จาก <a href="/admin/theme" class="font-bold text-[var(--gold-text)] underline">ตั้งค่าธีมสี</a></p>
<div class="current-model-banner mb-5"><span>กำลังใช้งานอยู่</span><strong><%= currentModel === 'classic' ? 'โมเดลมาตรฐาน' : currentModel === 'rangers-market' ? 'Rangers Market' : currentModel === 'efootball' ? 'eFootball Market' : 'LINE Rangers' %></strong><small>การเลือกใหม่จะมีผลหลังจากกดปุ่มบันทึกด้านล่าง</small></div>
<form action="/admin/storefront-models" method="post" class="grid lg:grid-cols-4 gap-5 max-w-7xl">
  <label class="model-option block rounded-2xl border-2 <%= currentModel === 'classic' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="classic" class="sr-only" <%= currentModel === 'classic' ? 'checked' : '' %>>
    <div class="aspect-[16/10] rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 overflow-hidden">
      <div class="h-6 rounded-lg bg-[var(--card)] mb-4"></div><div class="h-16 rounded-xl bg-[var(--input)] mb-4"></div>
      <div class="grid grid-cols-3 gap-2"><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i></div>
    </div>
    <div class="flex items-center justify-between gap-3 mt-4"><div><b class="block">โมเดลมาตรฐาน</b><small class="text-[var(--text-4)]">รูปแบบเดิมของร้าน ใช้สีตามธีมที่ตั้งไว้</small></div><span class="model-status <%= currentModel === 'classic' ? 'is-active' : '' %>"><%= currentModel === 'classic' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
  </label>
  <% if (allowRangersMarket) { %><label class="model-option block rounded-2xl border-2 <%= currentModel === 'rangers-market' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="rangers-market" class="sr-only" <%= currentModel === 'rangers-market' ? 'checked' : '' %>>
    <div class="rangers-market-preview aspect-[16/10] rounded-xl border border-blue-400/40 p-4 overflow-hidden">
      <div class="h-6 rounded-lg bg-[#121d35] mb-3"></div><div class="h-14 rounded-xl bg-gradient-to-r from-[#24559a] to-[#293a85] mb-3"></div>
      <div class="flex gap-2"><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i></div>
    </div>
    <div class="flex items-start justify-between gap-3 mt-4"><div><b class="block">Rangers Market</b><small class="text-[var(--text-4)]">หน้าเลือกทีม ตัวกรอง และรายการไอดีรูปแบบใหม่</small></div><span class="model-status shrink-0 <%= currentModel === 'rangers-market' ? 'is-active' : '' %>"><%= currentModel === 'rangers-market' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
    <a href="/preview/rangers-market" target="_blank" rel="noopener" class="model-preview-link mt-3 inline-flex text-sm font-semibold text-[var(--gold-text)]">ดูตัวอย่างก่อนใช้ ↗</a>
  </label><% } %>

  <label class="model-option block rounded-2xl border-2 <%= currentModel === 'line-rangers' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="line-rangers" class="sr-only" <%= currentModel === 'line-rangers' ? 'checked' : '' %>>
    <div class="line-rangers-preview aspect-[16/10] rounded-xl border border-sky-400/40 p-4 overflow-hidden">
      <div class="h-7 rounded-lg bg-slate-950/80 border border-sky-400/30 mb-4"></div><div class="h-16 rounded-xl bg-gradient-to-r from-blue-950 to-sky-900 border border-cyan-400/40 mb-4"></div>
      <div class="grid grid-cols-3 gap-2"><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i></div>
    </div>
    <div class="flex items-center justify-between gap-3 mt-4"><div><b class="block">LINE Rangers</b><small class="text-[var(--text-4)]">บรรยากาศเกม สีฟ้าเข้ม การ์ดและแถบข้อมูลแบบเกม</small></div><span class="model-status <%= currentModel === 'line-rangers' ? 'is-active' : '' %>"><%= currentModel === 'line-rangers' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
  </label>
  <% if (allowEfootball) { %><label class="model-option block rounded-2xl border-2 <%= currentModel === 'efootball' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="efootball" class="sr-only" <%= currentModel === 'efootball' ? 'checked' : '' %>>
    <div class="efootball-preview aspect-[16/10] rounded-xl border border-cyan-300/40 p-4 overflow-hidden"><div class="h-6 rounded-lg bg-[#0b111d] mb-3"></div><div class="h-14 rounded-xl bg-gradient-to-r from-[#0c496e] to-[#1d6b67] mb-3"></div><div class="grid grid-cols-4 gap-2"><i class="h-16 rounded-lg bg-slate-100"></i><i class="h-16 rounded-lg bg-slate-100"></i><i class="h-16 rounded-lg bg-slate-100"></i><i class="h-16 rounded-lg bg-slate-100"></i></div></div>
    <div class="flex items-start justify-between gap-3 mt-4"><div><b class="block">eFootball Market</b><small class="text-[var(--text-4)]">หน้าร้านฟุตบอลพร้อมตัวกรองผู้เล่นจาก eFHUB</small></div><span class="model-status shrink-0 <%= currentModel === 'efootball' ? 'is-active' : '' %>"><%= currentModel === 'efootball' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
    <a href="/preview/efootball" target="_blank" rel="noopener" class="model-preview-link mt-3 inline-flex text-sm font-semibold text-[var(--gold-text)]">ดูตัวอย่างก่อนใช้ ↗</a>
  </label><% } %>
  <button data-theme-fill="accent" class="lg:col-span-2 rounded-xl bg-[var(--gold)] px-6 py-3 font-bold text-[var(--gold-contrast)]">บันทึกและใช้โมเดลที่เลือก</button>
</form>

<style>
.line-rangers-preview{background:radial-gradient(circle at 50% 20%,#145ca8 0,#071a38 42%,#030916 100%)}
.rangers-market-preview{background:linear-gradient(145deg,#0f1930,#203d75)}
.efootball-preview{background:linear-gradient(145deg,#071521,#0e4e62)}
.model-option{transition:border-color .2s,transform .2s,box-shadow .2s}.model-option:has(input:checked){box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 18%,transparent)}.model-option:hover{transform:translateY(-2px)}
.current-model-banner{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 16px;border:1px solid color-mix(in srgb,var(--gold) 55%,var(--border));border-radius:14px;background:color-mix(in srgb,var(--gold) 10%,var(--card))}.current-model-banner span{padding:4px 8px;border-radius:999px;background:var(--gold);color:var(--gold-contrast);font-size:11px;font-weight:800}.current-model-banner strong{font-size:18px;color:var(--text)}.current-model-banner small{color:var(--text-3)}.model-status{padding:6px 9px;border:1px solid var(--border);border-radius:999px;color:var(--text-3);font-size:11px;font-weight:800;white-space:nowrap}.model-status.is-active{border-color:#16a34a55;background:#16a34a16;color:#16a34a}
@media(prefers-reduced-motion:reduce){.model-option{transition:none}.model-option:hover{transform:none}}
</style>
<script>
document.querySelectorAll('.model-option input').forEach(input=>input.addEventListener('change',()=>{
  document.querySelectorAll('.model-option').forEach(label=>label.style.borderColor='var(--border)');
  input.closest('.model-option').style.borderColor='var(--gold)';
}));
document.querySelectorAll('.model-preview-link').forEach(link=>link.addEventListener('click',event=>event.stopPropagation()));
</script>
