<% if (isMainSite) { %>
<link rel="stylesheet" href="<%= asset('css/admin-experiment-storefront-models-v1.css') %>" />
<%
  const modelNames = { classic: 'โมเดลมาตรฐาน', 'line-rangers': 'LINE Rangers', 'rangers-market': 'Rangers Market' };
  const currentModelName = modelNames[currentModel] || 'โมเดลมาตรฐาน';
  const availableCurrentModel = ['classic', 'line-rangers'].includes(currentModel) ? currentModel : 'classic';
  const successMessages = messages && Array.isArray(messages.success) ? messages.success : [];
  const errorMessages = messages && Array.isArray(messages.error) ? messages.error : [];
%>
<div class="model-studio-page">
  <header class="experiment-page-head model-studio-page-head">
    <div>
      <span class="experiment-kicker">STORE RADAR · LILTEAM SHOP</span>
      <h1>เลือกสไตล์หน้าร้าน</h1>
      <p>ดูภาพรวมของแต่ละโมเดล เลือกแบบที่ชอบ แล้วบันทึกเพื่อใช้กับหน้าร้านหลัก</p>
    </div>
    <a href="/" class="experiment-button model-studio-store-link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5M5.5 9v10h13V9M9 19v-6h6v6"/></svg>
      ดูหน้าร้าน
      <span aria-hidden="true">↗</span>
    </a>
  </header>

  <div class="model-studio-safety" role="note">
    <span class="model-studio-safety-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.2c0 4.5 3.1 7.8 7.5 9.8 4.4-2 7.5-5.3 7.5-9.8V6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
    </span>
    <p><strong>เลือกสไตล์ ไม่แตะข้อมูลร้าน</strong><span>สินค้า รูป ราคา สต็อก และข้อมูลลูกค้ายังคงเดิม</span></p>
    <a href="/admin/theme">ปรับสีร้านได้ที่ธีม <span aria-hidden="true">→</span></a>
  </div>

  <% if (successMessages.length) { %>
    <div class="model-studio-feedback is-success" role="status" aria-live="polite"><span aria-hidden="true">✓</span><%= successMessages[0] %></div>
  <% } %>
  <% if (errorMessages.length) { %>
    <div class="model-studio-feedback is-error" role="alert"><span aria-hidden="true">!</span><%= errorMessages[0] %></div>
  <% } %>

  <section class="model-studio-current" aria-label="โมเดลที่กำลังใช้งาน">
    <span class="model-studio-current-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M7.5 8h9M7.5 12h9M7.5 16h5"/></svg>
    </span>
    <div class="model-studio-current-copy">
      <span>กำลังใช้งานอยู่</span>
      <strong><%= currentModelName %></strong>
    </div>
    <p data-model-studio-status aria-live="polite">การเปลี่ยนแปลงจะมีผลหลังบันทึก</p>
  </section>

  <form action="/admin/storefront-models" method="post" class="model-studio-form" data-model-studio-form data-current-model="<%= currentModel %>">
    <fieldset>
      <legend>เลือกแบบที่ใช่</legend>
      <p class="model-studio-field-hint">เลือกจาก 2 รูปแบบที่เปิดใช้งานได้จริง · สินค้าและข้อมูลร้านไม่เปลี่ยน จนกว่าจะกดบันทึก</p>

      <div class="model-studio-grid">
        <label class="model-studio-option <%= availableCurrentModel === 'classic' ? 'is-current' : '' %>" data-model-option data-model-value="classic" data-model-name="โมเดลมาตรฐาน">
          <input type="radio" name="model" value="classic" required <%= availableCurrentModel === 'classic' ? 'checked' : '' %> />
          <span class="model-studio-preview model-studio-preview-classic" aria-hidden="true">
            <span class="model-preview-paper-clips"><i></i><i></i><i></i></span>
            <span class="model-preview-model-tag">01 <b>CLASSIC SHOP</b></span>
            <span class="model-preview-window">
              <span class="model-preview-topbar"><i class="model-preview-brand-mark">L</i><b>LILTeam Shop</b><i class="model-preview-menu"></i></span>
              <span class="model-preview-search"><i></i><b></b></span>
              <span class="model-preview-hero"><span><small>ยินดีต้อนรับ</small><b>ร้านของคุณ<br />ในแบบที่คุ้นเคย</b></span><svg viewBox="0 0 120 100" fill="none"><path d="M16 78h89M26 78V45l34-22 34 22v33"/><path d="M18 45 60 18l42 27M39 78V54h17v24m15-24h15v12H71z"/><path d="M17 82c8-9 13-7 16 0m52 0c7-12 16-12 22 0"/><circle cx="93" cy="23" r="8"/></svg></span>
              <span class="model-preview-products"><i><b></b><small></small></i><i><b></b><small></small></i><i><b></b><small></small></i></span>
            </span>
            <span class="model-preview-caption">บรรยากาศเรียบง่าย · ใช้สีธีมร้าน</span>
          </span>
          <span class="model-studio-option-info">
            <span class="model-studio-option-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 10h16l-1.3-5H5.3L4 10Z"/><path d="M5 10v9h14v-9M9 19v-5h6v5M4 10a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0"/></svg>
            </span>
            <span class="model-studio-option-copy"><strong>โมเดลมาตรฐาน</strong><small>รูปแบบเดิมของร้าน ปรับโทนสีตามธีมที่ตั้งไว้</small></span>
            <span class="model-studio-option-state" data-model-state><%= availableCurrentModel === 'classic' ? 'กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span>
          </span>
        </label>

        <label class="model-studio-option model-studio-option-rangers <%= availableCurrentModel === 'line-rangers' ? 'is-current' : '' %>" data-model-option data-model-value="line-rangers" data-model-name="LINE Rangers">
          <input type="radio" name="model" value="line-rangers" <%= availableCurrentModel === 'line-rangers' ? 'checked' : '' %> />
          <span class="model-studio-preview model-studio-preview-rangers" aria-hidden="true">
            <span class="model-preview-paper-clips"><i></i><i></i><i></i></span>
            <span class="model-preview-model-tag">02 <b>RANGERS EDITION</b></span>
            <span class="model-preview-window">
              <span class="model-preview-topbar"><i class="model-preview-brand-mark">L</i><b>LILTeam Shop</b><i class="model-preview-menu"></i></span>
              <span class="model-preview-search"><i></i><b></b></span>
              <span class="model-preview-hero"><span><small>GEAR UP · SHOP ON</small><b>ไอเทมเด่น<br />พร้อมลุย!</b></span><svg viewBox="0 0 120 100" fill="none"><path d="M24 42h72l9 36H82l-10-11H49L38 78H15l9-36Z"/><path d="M39 51v15m-7-7h14m35-5h.1m11 10h.1"/><path d="m55 34 5-10 5 10 11 2-8 7 2 11-10-6-10 6 2-11-8-7 11-2Z"/><circle cx="94" cy="21" r="7"/></svg></span>
              <span class="model-preview-products"><i><b></b><small></small></i><i><b></b><small></small></i><i><b></b><small></small></i></span>
            </span>
            <span class="model-preview-caption">โทนเกมเข้ม · การ์ดสินค้าแบบ Rangers</span>
          </span>
          <span class="model-studio-option-info">
            <span class="model-studio-option-icon is-blue" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6 8h12l2 10h-4l-2-3h-4l-2 3H4L6 8Z"/><path d="M8 11v4M6 13h4M16 12h.01M18 14h.01"/></svg>
            </span>
            <span class="model-studio-option-copy"><strong>LINE Rangers</strong><small>บรรยากาศเกม สีฟ้าเข้ม และการ์ดสินค้าแบบ Rangers</small></span>
            <span class="model-studio-option-state" data-model-state><%= availableCurrentModel === 'line-rangers' ? 'กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span>
          </span>
        </label>
      </div>
    </fieldset>

    <div class="model-studio-submit-row">
      <p data-model-studio-save-status aria-live="polite">โมเดลที่ใช้อยู่จะไม่เปลี่ยนจนกว่าจะกดบันทึก</p>
      <button type="submit" class="experiment-button primary model-studio-submit" data-model-studio-submit data-theme-fill="accent">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l3 3v13H4V4h1Z"/><path d="M8 4v6h8V4M8 20v-6h8v6"/></svg>
        <span data-model-studio-submit-label>บันทึกและใช้โมเดลที่เลือก</span>
      </button>
    </div>
  </form>
</div>

<script>
(function () {
  const form = document.querySelector('[data-model-studio-form]');
  if (!form) return;
  const submit = form.querySelector('[data-model-studio-submit]');
  const submitLabel = form.querySelector('[data-model-studio-submit-label]');
  const status = document.querySelector('[data-model-studio-status]');
  const saveStatus = document.querySelector('[data-model-studio-save-status]');
  const currentModel = form.dataset.currentModel;
  const options = Array.from(form.querySelectorAll('[data-model-option]'));
  const selected = () => form.querySelector('input[name="model"]:checked');
  const update = () => {
    const radio = selected();
    if (!radio) return;
    const changed = radio.value !== currentModel;
    options.forEach((option) => {
      const isSelected = option.dataset.modelValue === radio.value;
      option.classList.toggle('is-selected', isSelected);
      option.querySelector('[data-model-state]').textContent = isSelected
        ? (changed ? 'เลือกไว้ · ยังไม่บันทึก' : 'กำลังใช้งาน')
        : 'เลือกโมเดลนี้';
    });
    if (status) status.textContent = changed
      ? `เลือก ${radio.closest('[data-model-option]').dataset.modelName} · ยังไม่เปลี่ยนหน้าร้าน`
      : 'โมเดลที่ใช้อยู่จะไม่เปลี่ยนจนกว่าจะกดบันทึก';
    if (saveStatus) saveStatus.textContent = changed
      ? 'ตรวจสอบตัวเลือกแล้ว กดบันทึกเพื่อใช้โมเดลนี้'
      : 'โมเดลนี้กำลังใช้งานอยู่';
    if (submit) {
      submit.disabled = !changed;
      if (submitLabel) submitLabel.textContent = changed ? 'บันทึกและใช้โมเดลนี้' : 'โมเดลนี้กำลังใช้งาน';
    }
  };
  form.querySelectorAll('input[name="model"]').forEach((radio) => radio.addEventListener('change', update));
  form.addEventListener('submit', () => {
    if (!submit || submit.disabled) return;
    submit.disabled = true;
    submit.dataset.saving = 'true';
    if (submitLabel) submitLabel.textContent = 'กำลังบันทึก…';
  });
  update();
})();
</script>
<% } else { %>
<div class="studio-page-head mb-6">
  <div><span class="studio-page-kicker">STOREFRONT MODEL</span><h1>เลือกโมเดลหน้าร้าน</h1><p>เลือกหน้าตาของร้านโดยไม่เปลี่ยนสินค้า รูป ราคา สต็อก หรือข้อมูลลูกค้า</p></div>
  <a href="/" target="_blank" rel="noopener" class="studio-secondary-action">ดูหน้าร้าน ↗</a>
</div>

<p class="mb-3 rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 text-sm text-[var(--text-3)]">โมเดลจะเปลี่ยนเฉพาะหน้าตาร้าน ส่วนสินค้า ราคา สต็อก และข้อมูลลูกค้ายังคงเดิม ปรับสีเพิ่มเติมได้จาก <a href="/admin/theme" class="font-bold text-[var(--gold-text)] underline">ตั้งค่าธีมสี</a></p>
<div class="current-model-banner mb-5"><span>กำลังใช้งานอยู่</span><strong><%= currentModel === 'classic' ? 'โมเดลมาตรฐาน' : currentModel === 'rangers-market' ? 'Rangers Market' : 'LINE Rangers' %></strong><small>การเลือกใหม่จะมีผลหลังจากกดปุ่มบันทึกด้านล่าง</small></div>
<form action="/admin/storefront-models" method="post" class="grid lg:grid-cols-3 gap-5 max-w-7xl">
  <label class="model-option block rounded-2xl border-2 <%= currentModel === 'classic' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="classic" class="sr-only" <%= currentModel === 'classic' ? 'checked' : '' %>>
    <div class="aspect-[16/10] rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 overflow-hidden">
      <div class="h-6 rounded-lg bg-[var(--card)] mb-4"></div><div class="h-16 rounded-xl bg-[var(--input)] mb-4"></div>
      <div class="grid grid-cols-3 gap-2"><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i><i class="h-20 rounded-lg bg-[var(--card)] border border-[var(--border)]"></i></div>
    </div>
    <div class="flex items-center justify-between gap-3 mt-4"><div><b class="block">โมเดลมาตรฐาน</b><small class="text-[var(--text-4)]">รูปแบบเดิมของร้าน ใช้สีตามธีมที่ตั้งไว้</small></div><span class="model-status <%= currentModel === 'classic' ? 'is-active' : '' %>"><%= currentModel === 'classic' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
  </label>
  <% if (allowRangersMarket) { %><label class="model-option block rounded-2xl border-2 <%= currentModel === 'rangers-market' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="rangers-market" class="sr-only" <%= currentModel === 'rangers-market' ? 'checked' : '' %>>
    <div class="rangers-market-preview aspect-[16/10] rounded-xl border border-blue-400/40 p-4 overflow-hidden">
      <div class="h-6 rounded-lg bg-[#121d35] mb-3"></div><div class="h-14 rounded-xl bg-gradient-to-r from-[#24559a] to-[#293a85] mb-3"></div>
      <div class="flex gap-2"><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i><i class="h-16 flex-1 rounded-lg bg-[#f7f8fc]"></i></div>
    </div>
    <div class="flex items-start justify-between gap-3 mt-4"><div><b class="block">Rangers Market</b><small class="text-[var(--text-4)]">หน้าเลือกทีม ตัวกรอง และรายการไอดีรูปแบบใหม่</small></div><span class="model-status shrink-0 <%= currentModel === 'rangers-market' ? 'is-active' : '' %>"><%= currentModel === 'rangers-market' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
    <a href="/preview/rangers-market" target="_blank" rel="noopener" class="model-preview-link mt-3 inline-flex text-sm font-semibold text-[var(--gold-text)]">ดูตัวอย่างก่อนใช้ ↗</a>
  </label><% } %>

  <label class="model-option block rounded-2xl border-2 <%= currentModel === 'line-rangers' ? 'border-[var(--gold)]' : 'border-[var(--border)]' %> bg-[var(--card)] p-4 cursor-pointer">
    <input type="radio" name="model" value="line-rangers" class="sr-only" <%= currentModel === 'line-rangers' ? 'checked' : '' %>>
    <div class="line-rangers-preview aspect-[16/10] rounded-xl border border-sky-400/40 p-4 overflow-hidden">
      <div class="h-7 rounded-lg bg-slate-950/80 border border-sky-400/30 mb-4"></div><div class="h-16 rounded-xl bg-gradient-to-r from-blue-950 to-sky-900 border border-cyan-400/40 mb-4"></div>
      <div class="grid grid-cols-3 gap-2"><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i><i class="h-20 rounded-lg bg-slate-950 border border-cyan-400/40"></i></div>
    </div>
    <div class="flex items-center justify-between gap-3 mt-4"><div><b class="block">LINE Rangers</b><small class="text-[var(--text-4)]">บรรยากาศเกม สีฟ้าเข้ม การ์ดและแถบข้อมูลแบบเกม</small></div><span class="model-status <%= currentModel === 'line-rangers' ? 'is-active' : '' %>"><%= currentModel === 'line-rangers' ? '✓ กำลังใช้งาน' : 'เลือกโมเดลนี้' %></span></div>
  </label>
  <button data-theme-fill="accent" class="lg:col-span-2 rounded-xl bg-[var(--gold)] px-6 py-3 font-bold text-[var(--gold-contrast)]">บันทึกและใช้โมเดลที่เลือก</button>
</form>

<style>
.line-rangers-preview{background:radial-gradient(circle at 50% 20%,#145ca8 0,#071a38 42%,#030916 100%)}
.rangers-market-preview{background:linear-gradient(145deg,#0f1930,#203d75)}
.model-option{transition:border-color .2s,transform .2s,box-shadow .2s}.model-option:has(input:checked){box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 18%,transparent)}.model-option:hover{transform:translateY(-2px)}
.current-model-banner{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 16px;border:1px solid color-mix(in srgb,var(--gold) 55%,var(--border));border-radius:14px;background:color-mix(in srgb,var(--gold) 10%,var(--card))}.current-model-banner span{padding:4px 8px;border-radius:999px;background:var(--gold);color:var(--gold-contrast);font-size:11px;font-weight:800}.current-model-banner strong{font-size:18px;color:var(--text)}.current-model-banner small{color:var(--text-3)}.model-status{padding:6px 9px;border:1px solid var(--border);border-radius:999px;color:var(--text-3);font-size:11px;font-weight:800;white-space:nowrap}.model-status.is-active{border-color:#16a34a55;background:#16a34a16;color:#16a34a}
@media(prefers-reduced-motion:reduce){.model-option{transition:none}.model-option:hover{transform:none}}
</style>
<script>
document.querySelectorAll('.model-option input').forEach(input=>input.addEventListener('change',()=>{
  document.querySelectorAll('.model-option').forEach(label=>label.style.borderColor='var(--border)');
  input.closest('.model-option').style.borderColor='var(--gold)';
}));
document.querySelectorAll('.model-preview-link').forEach(link=>link.addEventListener('click',event=>event.stopPropagation()));
</script>
<% } %>
