<!-- Scheduled Products Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">⏰ สินค้าตั้งเวลาเปิดขาย</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">สินค้าจะเปิดขายบนหน้าร้านอัตโนมัติตามเวลาประเทศไทยที่กำหนด (<%= products.length %> รายการ)</p>
  </div>
  <a href="/admin/products/new" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-4 py-2 rounded-xl text-xs shadow-md transition active:scale-95">
    + สร้างสินค้าแบบตั้งเวลา
  </a>
</div>

<!-- Scheduled Products Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <% products.forEach(product => {
    const due = new Date(product.publishAt + (/Z$|[+-]\d\d:\d\d$/.test(product.publishAt) ? '' : ':00+07:00'));
    const waiting = due.getTime() > Date.now();
  %>
    <div class="bg-[var(--card)] border border-[var(--border)] hover:border-[var(--gold)]/40 rounded-2xl p-4 sm:p-5 flex gap-4 shadow-sm transition group">

      <div class="w-20 h-24 rounded-xl overflow-hidden bg-[var(--input)] border border-[var(--border-light)] shrink-0">
        <% if (product.images && product.images[0]) { %>
          <img src="<%= product.images[0] %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-200" alt="<%= product.title %>" />
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-xl">⏰</div>
        <% } %>
      </div>

      <div class="min-w-0 flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <span class="inline-flex items-center gap-1 text-[10px] font-bold rounded-full px-2.5 py-0.5 <%= waiting ? 'bg-amber-500/10 text-amber-300 border border-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
              <span class="w-1.5 h-1.5 rounded-full <%= waiting ? 'bg-amber-300 animate-pulse' : 'bg-emerald-400' %>"></span>
              <%= waiting ? 'รอเวลาเปิดขาย' : 'เปิดขายแล้ว' %>
            </span>
            <% if (product.eventBadge) { %>
              <span class="text-[10px] font-semibold text-[var(--gold)] bg-[var(--gold)]/10 px-2 py-0.5 rounded-full">
                <%= product.eventBadge %>
              </span>
            <% } %>
          </div>

          <h3 class="font-bold text-sm text-[var(--text)] truncate"><%= product.title %></h3>
          <p class="text-xs text-[var(--text-4)] mt-1 flex items-center gap-1">
            <span>📅</span>
            <span>กำหนดเปิด: <b><%= due.toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></b></span>
          </p>
        </div>

        <div class="pt-2 flex items-center justify-between border-t border-[var(--border)] mt-2">
          <span class="text-xs font-bold text-[var(--gold)]">฿<%= product.price.toLocaleString() %></span>
          <a href="/admin/products/<%= product.id %>/edit" class="text-xs font-semibold text-[var(--gold)] hover:underline inline-flex items-center gap-1">
            <span>แก้ไขสินค้าและเวลา</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  <% }) %>

  <% if (!products.length) { %>
    <div class="md:col-span-2 text-center text-xs text-[var(--text-4)] bg-[var(--card)] border border-dashed border-[var(--border-light)] rounded-2xl py-14">
      <div class="text-3xl mb-2">⏰</div>
      <div class="text-sm font-semibold text-[var(--text-3)]">ยังไม่มีสินค้าที่ตั้งเวลาเปิดขาย</div>
      <p class="text-xs text-[var(--text-4)] mt-1">สามารถกำหนดเวลาเปิดขายล่วงหน้าได้ในขั้นตอนเพิ่มหรือแก้ไขสินค้า</p>
    </div>
  <% } %>
</div>
