<% if (licenseGateOn && licenseExpiresAt) { %>
  <div class="bg-[var(--card)] border border-[var(--gold)]/30 rounded-2xl p-4 sm:p-5 mb-6 flex items-center justify-between flex-wrap gap-4 shadow-lg backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-xl shrink-0">
        🔑
      </div>
      <div>
        <div class="text-xs text-[var(--text-4)]">อายุการใช้งานระบบ (License)</div>
        <div class="text-sm font-semibold text-[var(--text)]">
          <%= licenseLabel || 'เว็บหลัก' %>
          <form action="/admin/license-label" method="post" class="inline-flex items-center gap-1 ml-2 align-middle">
            <input name="label" value="<%= licenseLabel || '' %>" placeholder="แก้ไขชื่อ" class="w-24 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-0.5 text-xs outline-none focus:border-[var(--gold)]" />
            <button class="text-[10px] text-[var(--gold)] hover:underline border border-[var(--gold)]/30 rounded-md px-1.5 py-0.5">บันทึก</button>
          </form>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <span id="license-countdown" class="font-mono font-bold text-base sm:text-lg text-[var(--gold)] bg-[var(--input)]/60 px-3 py-1 rounded-xl border border-[var(--border-light)]" data-exp="<%= licenseExpiresAt %>">…</span>
      <a href="/license" class="text-xs font-semibold text-[var(--bg)] bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] hover:opacity-90 rounded-xl px-4 py-2 shadow-sm transition whitespace-nowrap">ต่ออายุเว็บ →</a>
    </div>
  </div>
  <script>
    (function () {
      const el = document.getElementById('license-countdown');
      if (!el) return;
      const exp = Number(el.dataset.exp);
      const tick = () => {
        const ms = exp - Date.now();
        if (ms <= 0) { el.textContent = '✕ หมดอายุแล้ว'; el.classList.add('text-rose-400'); return; }
        const s = Math.floor(ms / 1000);
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        el.textContent = `${d}วัน ${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      tick();
      setInterval(tick, 1000);
    })();
  </script>
<% } %>

<% if (shopExpiresAt) { %>
  <div class="bg-[var(--card)] border border-[var(--gold)]/30 rounded-2xl p-4 sm:p-5 mb-6 flex items-center justify-between flex-wrap gap-4 shadow-lg backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-xl shrink-0">
        🏪
      </div>
      <div>
        <div class="text-xs text-[var(--text-4)]">อายุการเช่าร้านค้า (Tenant)</div>
        <div class="text-sm font-semibold text-[var(--text)]"><%= shopName || 'ร้านค้าย่อย' %></div>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <span id="shop-countdown" class="font-mono font-bold text-base sm:text-lg text-[var(--gold)] bg-[var(--input)]/60 px-3 py-1 rounded-xl border border-[var(--border-light)]" data-exp="<%= shopExpiresAt %>">…</span>
      <% if (shopRenewUrl) { %>
        <a href="<%= shopRenewUrl %>" class="text-xs font-semibold text-[var(--bg)] bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] hover:opacity-90 rounded-xl px-4 py-2 shadow-sm transition whitespace-nowrap">ต่ออายุร้าน →</a>
      <% } %>
    </div>
  </div>
  <script>
    (function () {
      const el = document.getElementById('shop-countdown');
      if (!el) return;
      const exp = Number(el.dataset.exp);
      const tick = () => {
        const ms = exp - Date.now();
        if (ms <= 0) { el.textContent = '✕ หมดอายุแล้ว'; el.classList.add('text-rose-400'); return; }
        const s = Math.floor(ms / 1000);
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        el.textContent = `${d}วัน ${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      tick();
      setInterval(tick, 1000);
    })();
  </script>
<% } %>

<!-- Quick Action Shortcuts Bar -->
