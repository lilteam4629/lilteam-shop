      <svg class="w-4 h-4 text-[var(--text-4)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path></svg>
      <span>ตั้งค่าร้าน</span>
    </a>
  </div>
</div>

<!-- Primary Metric Cards (4 Cards) -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

  <!-- Card 1: Today's Revenue -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm hover:border-[var(--gold)]/40 transition duration-200">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium text-[var(--text-4)]">รายได้วันนี้ (Today)</span>
      <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-[var(--gold)] flex items-center justify-center text-base">
        💰
      </div>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-[var(--gold)] tracking-tight">฿<%= stats.revenueToday.toLocaleString() %></div>
    <div class="flex items-center gap-1.5 mt-2 text-[11px] text-[var(--text-4)]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span>นับตามเวลาประเทศไทย (ICT)</span>
    </div>
  </div>

  <!-- Card 2: 7 Days & 30 Days -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm hover:border-[var(--gold)]/40 transition duration-200">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium text-[var(--text-4)]">รายได้ 7 วันล่าสุด</span>
      <div class="w-9 h-9 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-base">
        📈
      </div>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-[var(--text)] tracking-tight">฿<%= stats.revenue7Days.toLocaleString() %></div>
    <div class="text-[11px] text-[var(--text-4)] mt-2">
      30 วันที่ผ่านมา: <b class="text-[var(--text-2)] font-semibold">฿<%= stats.revenue30Days.toLocaleString() %></b>
    </div>
  </div>

  <!-- Card 3: New Customers -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm hover:border-[var(--gold)]/40 transition duration-200">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium text-[var(--text-4)]">ลูกค้าใหม่ 30 วัน</span>
      <div class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-base">
        👥
      </div>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-[var(--text)] tracking-tight"><%= stats.newCustomers30Days %> <span class="text-sm font-normal text-[var(--text-4)]">คน</span></div>
    <div class="text-[11px] text-[var(--text-4)] mt-2">
      สมาชิกร้านทั้งหมด: <b class="text-[var(--text-2)] font-semibold"><%= stats.userCount %> คน</b>
    </div>
  </div>

  <!-- Card 4: Topup Success Rate -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm hover:border-[var(--gold)]/40 transition duration-200">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium text-[var(--text-4)]">ความแม่นยำตรวจสลิป</span>
      <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-base">
        ⚡
      </div>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 tracking-tight"><%= stats.topupSuccessRate %>%</div>
    <div class="text-[11px] text-[var(--text-4)] mt-2">
      จาก <%= stats.reviewedTopups %> รายการที่ตรวจสอบแล้ว
    </div>
  </div>

</div>

<!-- Secondary Stats Row (4 Mini Stats) -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <div class="bg-[var(--card)]/60 border border-[var(--border)] rounded-xl p-3.5 flex flex-col justify-between">
    <span class="text-[11px] text-[var(--text-4)]">ยอดขายรวมทั้งหมด</span>
    <b class="text-base sm:text-lg font-bold text-[var(--gold)] mt-1">฿<%= stats.revenue.toLocaleString() %></b>
  </div>
  <div class="bg-[var(--card)]/60 border border-[var(--border)] rounded-xl p-3.5 flex flex-col justify-between">
    <span class="text-[11px] text-[var(--text-4)]">คำสั่งซื้อสะสม</span>
    <b class="text-base sm:text-lg font-bold text-[var(--text)] mt-1"><%= stats.orderCount %> รายการ</b>
  </div>
  <div class="bg-[var(--card)]/60 border border-[var(--border)] rounded-xl p-3.5 flex flex-col justify-between">
    <span class="text-[11px] text-[var(--text-4)]">สินค้าในระบบ</span>
    <b class="text-base sm:text-lg font-bold text-[var(--text)] mt-1"><%= stats.productCount %> รายการ</b>
  </div>
  <div class="bg-[var(--card)]/60 border border-[var(--border)] rounded-xl p-3.5 flex flex-col justify-between">
    <span class="text-[11px] text-[var(--text-4)]">สต๊อกพร้อมส่งทันที</span>
    <b class="text-base sm:text-lg font-bold text-emerald-400 mt-1"><%= stats.availableStock %> คีย์/ไอดี</b>
  </div>
</div>

<!-- Pending Topups Alert Banner -->
<% if (stats.pendingTopups > 0) { %>
  <div class="bg-gradient-to-r from-amber-950/70 to-[var(--card)] border border-[var(--gold)]/40 rounded-2xl p-4 sm:p-5 mb-6 flex items-center justify-between flex-wrap gap-4 shadow-lg">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[var(--gold)] text-[var(--bg)] flex items-center justify-center font-bold text-lg animate-bounce">
        💳
      </div>
      <div>
        <div class="font-bold text-sm text-[var(--text)]">มีคำขอเติมเงินรอการตรวจสอบ <span class="text-[var(--gold)]"><%= stats.pendingTopups %> รายการ</span></div>
        <div class="text-xs text-[var(--text-4)] mt-0.5">ลูกค้าแนบสลิป/แจ้งเติมเงินเข้ามา กรุณาตรวจสอบและอนุมัติเครดิต</div>
      </div>
    </div>
    <a href="/admin/topups" class="inline-flex items-center gap-2 bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold px-4 py-2 rounded-xl text-xs shadow-md transition">
      <span>ไปหน้าตรวจสลิป</span>
      <span>→</span>
    </a>
  </div>
<% } %>

<!-- Low Stock Warning Banner -->
<% if (lowStockProducts.length) { %>
  <div class="bg-rose-950/40 border border-rose-500/40 text-rose-200 rounded-2xl p-4 sm:p-5 mb-6 shadow-md flex items-start gap-3.5">
    <span class="text-xl">⚠️</span>
    <div class="text-xs flex-1">
      <span class="font-semibold text-rose-100 text-sm block mb-1">สินค้าใกล้หมดสต๊อก (<%= lowStockProducts.length %> รายการ):</span>
      <div class="flex flex-wrap gap-2 mt-2">
        <% lowStockProducts.forEach(p => { %>
          <a href="/admin/products/<%= p.id %>/stock" class="inline-flex items-center gap-1.5 bg-rose-900/60 hover:bg-rose-800/80 border border-rose-500/40 text-rose-200 px-3 py-1 rounded-lg transition font-medium">
            <span><%= p.title %></span>
            <span class="bg-rose-500/30 px-1.5 py-0.2 rounded text-[10px] font-bold text-white">เหลือ 0</span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<!-- Charts & Top Products Grid -->
<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_.6fr] gap-6 mb-8">

  <!-- 7-Day Revenue Visual Chart -->
  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="font-bold text-sm sm:text-base text-[var(--text)]">กราฟยอดขาย 7 วันล่าสุด</h2>
        <p class="text-xs text-[var(--text-4)] mt-0.5">สรุปยอดขายรายวันตามเวลาประเทศไทย</p>
      </div>
      <div class="text-right">
        <span class="text-xs text-[var(--text-4)]">รวม 7 วัน</span>
        <div class="text-sm font-bold text-[var(--gold)]">฿<%= stats.revenue7Days.toLocaleString() %></div>
      </div>
    </div>

    <!-- Bar Chart Container -->
    <div class="h-52 flex items-end gap-2 sm:gap-4 border-b border-[var(--border)] pt-4 px-2">
      <% dailySales.forEach(day => {
        const height = Math.max(day.amount ? 10 : 3, Math.round((day.amount / maxDailyRevenue) * 100));
      %>
        <div class="flex-1 h-full flex flex-col justify-end items-center min-w-0 group relative">
          <!-- Hover Tooltip -->
          <div class="absolute -top-7 opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none bg-[var(--input)] border border-[var(--border-light)] text-[10px] font-bold text-[var(--gold)] px-2 py-0.5 rounded-md shadow-lg whitespace-nowrap z-10">
            ฿<%= day.amount.toLocaleString() %>
          </div>
          <!-- Bar Column -->
          <div class="w-full max-w-10 rounded-t-lg bg-gradient-to-t from-[var(--gold-dark)] to-[var(--gold)] shadow-[0_0_12px_color-mix(in_srgb,var(--gold)_20%,transparent)] group-hover:brightness-110 transition-all duration-200" style="height:<%= height %>%"></div>
          <!-- Day Label -->
          <span class="text-[10px] sm:text-xs text-[var(--text-4)] py-2.5 font-medium"><%= day.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Top Products Leaderboard -->
  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-bold text-sm sm:text-base text-[var(--text)]">🏆 สินค้าขายดี</h2>
      <a href="/admin/products" class="text-xs text-[var(--gold)] hover:underline">ดูทั้งหมด →</a>
    </div>

    <div class="space-y-3">
      <% topProducts.forEach((product, index) => { %>
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-[var(--input)]/40 border border-[var(--border-light)] text-sm">
          <span class="w-6 h-6 shrink-0 grid place-items-center rounded-lg <%= index === 0 ? 'bg-amber-500 text-[var(--bg)]' : index === 1 ? 'bg-slate-300 text-[var(--bg)]' : index === 2 ? 'bg-amber-700 text-white' : 'bg-[var(--input)] text-[var(--text-3)]' %> text-xs font-bold">
            <%= index + 1 %>
          </span>
          <span class="min-w-0 flex-1 truncate font-medium text-xs sm:text-sm text-[var(--text)]"><%= product.title %></span>
          <div class="text-right shrink-0">
            <span class="text-xs font-bold text-[var(--gold)] block"><%= product.units %> ชิ้น</span>
            <span class="text-[10px] text-[var(--text-4)]">฿<%= product.revenue.toLocaleString() %></span>
          </div>
        </div>
      <% }) %>

      <% if (!topProducts.length) { %>
        <div class="text-center py-8 text-xs text-[var(--text-4)]">
          <div class="text-2xl mb-1">📦</div>
          ยังไม่มีข้อมูลยอดขายในขณะนี้
        </div>
      <% } %>
    </div>
  </section>

</div>

<!-- Recent Orders Section -->
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
    <div>
      <h2 class="font-bold text-base text-[var(--text)]">คำสั่งซื้อล่าสุด</h2>
      <p class="text-xs text-[var(--text-4)] mt-0.5">รายการสั่งซื้อสินค้าล่าสุดของสมาชิกร้าน</p>
    </div>
    <div class="flex items-center gap-2">
      <input type="text" data-table-search="#dashboard-orders-table" placeholder="ค้นหารหัสคำสั่งซื้อ..." class="bg-[var(--input)] border border-[var(--border-light)] text-xs rounded-xl px-3 py-1.5 outline-none focus:border-[var(--gold)] w-48" />
      <a href="/admin/orders" class="text-xs font-medium text-[var(--gold)] hover:underline border border-[var(--gold)]/30 rounded-xl px-3 py-1.5 transition">ดูทั้งหมด →</a>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table id="dashboard-orders-table" class="w-full text-left text-xs sm:text-sm">
      <thead class="text-xs text-[var(--text-4)] border-b border-[var(--border)] uppercase">
        <tr>
          <th class="py-3 px-4 font-semibold">รหัสสั่งซื้อ</th>
          <th class="py-3 px-4 font-semibold">วันที่ / เวลา</th>
          <th class="py-3 px-4 font-semibold">ยอดชำระ</th>
          <th class="py-3 px-4 font-semibold">สถานะ</th>
          <th class="py-3 px-4 font-semibold text-right">การจัดการ</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% recentOrders.forEach(o => { %>
          <tr class="hover:bg-[var(--input)]/40 transition duration-150">
            <td class="py-3.5 px-4 font-mono font-bold text-[var(--gold)]">
              <a href="/admin/orders/<%= o.id %>" class="hover:underline">#<%= o.id %></a>
            </td>
            <td class="py-3.5 px-4 text-[var(--text-3)] text-xs">
              <%= new Date(o.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            </td>
            <td class="py-3.5 px-4 font-bold text-[var(--text)]">
              ฿<%= o.total.toLocaleString() %>
            </td>
            <td class="py-3.5 px-4">
              <% if (o.status === 'completed') { %>
                <span class="inline-flex items-center gap-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> สำเร็จ
                </span>
              <% } else if (o.status === 'pending') { %>
                <span class="inline-flex items-center gap-1 bg-amber-500/10 text-amber-300 border border-amber-500/20 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span> รอดำเนินการ
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 bg-rose-500/10 text-rose-400 border border-rose-500/20 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                  <%= o.status %>
                </span>
              <% } %>
            </td>
            <td class="py-3.5 px-4 text-right">
              <a href="/admin/orders/<%= o.id %>" class="text-xs font-semibold text-[var(--gold)] hover:underline inline-flex items-center gap-1">
                <span>ดูรายละเอียด</span>
                <span>→</span>
              </a>
            </td>
          </tr>
        <% }) %>
        <% if (!recentOrders.length) { %>
          <tr>
            <td class="py-8 text-center text-[var(--text-4)] text-xs" colspan="5">
              ยังไม่มีคำสั่งซื้อในระบบ
            </td>
          </tr>
        <% } %>
        <tr class="table-empty-search-row" style="display: none;">
          <td class="py-8 text-center text-[var(--text-4)] text-xs" colspan="5">
            ไม่พบคำสั่งซื้อที่ตรงกับคำค้นหา
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
