<% const isRandomBox = product.specialType === 'random-box'; const randomBoxAvailableCount = typeof randomBoxStockCount === 'undefined' ? stockItems.filter(item => item.status === 'available').length : randomBoxStockCount; const randomBoxMissMessage = String(product.randomBox?.missMessage || '').trim(); const availableStockItems = stockItems.filter(item => item.status === 'available'); const visibleStockItems = isRandomBox ? stockItems.filter(item => item.status === 'available' || item.status === 'reserved') : availableStockItems; const reservedStockCount = stockItems.filter(item => item.status === 'reserved' && (item.randomBoxReservedFor || item.randomBoxPoolId)).length; const soldStockCount = stockItems.filter(item => item.status === 'sold').length; %>
<!-- Stock Management Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-2 text-xs text-[var(--text-4)] mb-1">
      <a href="/admin/products" class="text-[var(--gold-text)] hover:underline inline-flex items-center gap-1 font-semibold">
        <span>← กลับไปหน้ารายการสินค้า</span>
      </a>
    </div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">จัดการสต็อก: <%= product.title %></h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5"><%= isRandomBox ? 'เพิ่มคีย์/ไอดีตรงเข้าสต็อก · 1 บรรทัดนับเป็น 1 ชิ้น' : 'กำหนดรูปแบบการส่งมอบและเพิ่มคีย์/ไอดีพร้อมขาย' %></p>
  </div>

  <div class="flex items-center gap-2.5">
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl px-3.5 py-1.5 text-xs text-[var(--text-3)] flex items-center gap-2 shadow-sm">
      <span>พร้อมขาย:</span>
      <b class="text-emerald-400 font-bold"><%= availableStockItems.length %> รายการ</b>
    </div>
  </div>
</div>

<% if (isRandomBox) { %>
  <section id="random-box-stock-info" class="mb-6 rounded-2xl border border-[var(--gold)]/30 bg-[var(--card)] p-4 sm:p-5 shadow-sm" aria-labelledby="random-box-stock-info-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div><h2 id="random-box-stock-info-title" class="font-bold text-sm sm:text-base text-[var(--text)]">สต็อกรางวัลกล่องสุ่ม</h2><p class="mt-1 text-xs leading-relaxed text-[var(--text-3)]">คีย์/ไอดีที่ใส่ในหน้านี้คือรางวัลทั้งหมด · 1 บรรทัดนับเป็น 1 ชิ้น · สต็อกที่เพิ่มพร้อมร่วมสุ่มทันที · เติมสต็อกแล้วบัญชีสะสมของกล่องยังคงอยู่</p></div>
      <span class="rounded-full bg-[var(--gold)]/10 px-3 py-1.5 text-xs font-bold text-[var(--gold-text)]">฿1 / ครั้ง</span>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl bg-[var(--input)] px-4 py-3"><span class="block text-[11px] text-[var(--text-4)]">จำนวนรางวัลในสต็อก</span><strong class="mt-1 block text-base font-black text-[var(--text)]"><%= randomBoxAvailablePrizeCount.toLocaleString('th-TH') %> ชิ้น</strong><span class="mt-1 block text-[11px] text-[var(--text-3)]">พร้อมสุ่ม <%= availableStockItems.length.toLocaleString('th-TH') %> ชิ้น · สต็อกจองเดิม <%= reservedStockCount.toLocaleString('th-TH') %> ชิ้น</span><% if (randomBoxPoolSummary) { %><span class="mt-1 block text-[11px] text-[var(--text-4)]">จ่ายแล้ว <%= randomBoxPoolSummary.totalPrizeItems.toLocaleString('th-TH') %> ชิ้น</span><% } %></div>
      <form action="/admin/products/<%= product.id %>/stock/random-box-message" method="post" class="rounded-xl border border-[var(--border-light)] bg-[var(--card)] p-3.5">
        <label for="random-box-miss-message" class="block text-xs font-bold text-[var(--text)]">ข้อความเมื่อสุ่มไม่ได้รางวัล</label>
        <textarea id="random-box-miss-message" name="randomBoxMissMessage" rows="2" maxlength="300" placeholder="ยังไม่ได้รับรางวัลในครั้งนี้" class="mt-2 w-full resize-y rounded-lg border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-xs leading-relaxed text-[var(--text)] outline-none transition focus:border-[var(--gold)]"><%= randomBoxMissMessage %></textarea>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
          <span class="text-[11px] text-[var(--text-4)]">จะแสดงข้อความนี้ในผลสุ่มที่ไม่ได้รางวัล</span>
          <button type="submit" class="rounded-lg bg-[var(--gold)] px-3 py-2 text-xs font-bold text-[var(--gold-contrast)] transition hover:brightness-105">บันทึกข้อความ</button>
        </div>
      </form>
    </div>
  </section>
<% } else { %>
<!-- Fulfillment Mode Configuration Card -->
<form action="/admin/products/<%= product.id %>/stock/settings" method="post" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 mb-6 space-y-4 shadow-sm">
  <div class="flex items-center gap-2 pb-3 border-b border-[var(--border)]">
    <span class="text-base">📦</span>
    <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">วิธีการส่งมอบสินค้าให้ลูกค้า</h3>
  </div>

  <div class="grid sm:grid-cols-2 gap-3.5">
    <label class="flex gap-3.5 p-4 rounded-2xl border border-[var(--border-light)] bg-[var(--input)]/40 hover:border-[var(--gold)]/50 cursor-pointer transition">
      <input type="radio" name="fulfillmentMode" value="automatic" <%= product.fulfillmentMode !== 'contact' ? 'checked' : '' %> class="accent-[var(--gold)] mt-1 w-4 h-4" />
      <div>
        <b class="block text-xs sm:text-sm text-[var(--text)]">ส่งข้อมูลไอดี/คีย์อัตโนมัติ (Instant Delivery)</b>
        <span class="text-[11px] text-[var(--text-4)] mt-0.5 block">ระบบจะตัดสต็อกและแสดงข้อมูลให้ลูกค้าเห็นทันทีหลังชำระเงิน</span>
      </div>
    </label>

    <label class="flex gap-3.5 p-4 rounded-2xl border border-[var(--border-light)] bg-[var(--input)]/40 hover:border-[var(--gold)]/50 cursor-pointer transition">
      <input type="radio" name="fulfillmentMode" value="contact" <%= product.fulfillmentMode === 'contact' ? 'checked' : '' %> class="accent-[var(--gold)] mt-1 w-4 h-4" />
      <div>
        <b class="block text-xs sm:text-sm text-[var(--text)]">ติดต่อร้านเพื่อรับสินค้า (Contact Fulfillment)</b>
        <span class="text-[11px] text-[var(--text-4)] mt-0.5 block">แสดงคำแนะนำและปุ่มติดต่อแอดมินให้ลูกค้าติดต่อส่งมอบด้วยตนเอง</span>
      </div>
    </label>
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">คำแนะนำ/รายละเอียดที่ให้ลูกค้าเตรียมก่อนติดต่อร้าน</label>
    <textarea name="fulfillmentInstructions" rows="2" placeholder="เช่น ส่งเลขคำสั่งซื้อ ชื่อในเกม และ UID ให้ทางร้านผ่านทาง Line" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition"><%= product.fulfillmentInstructions || '' %></textarea>
  </div>

  <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--gold-contrast)] font-bold rounded-xl px-5 py-2 text-xs shadow-md transition active:scale-95">
    💾 บันทึกรูปแบบการส่งมอบ
  </button>
</form>
<% } %>

<!-- Stock Items Table & Add Stock Grid -->
<div class="grid lg:grid-cols-3 gap-6">

  <!-- Left Column: Existing Stock Items Table -->
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-sm">
    <div class="p-4 border-b border-[var(--border)] flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h3 class="font-bold text-sm text-[var(--text)]"><%= isRandomBox ? 'รายการรางวัลพร้อมสุ่ม' : 'รายการคีย์ / ไอดีที่พร้อมขาย' %> (<%= isRandomBox ? visibleStockItems.length : availableStockItems.length %>)</h3>
        <span class="mt-1 flex flex-wrap gap-x-3 text-xs text-[var(--text-4)]"><% if (reservedStockCount) { %><span>จองรางวัลกล่องสุ่ม: <b class="text-amber-500"><%= reservedStockCount %></b></span><% } %><span>ขายแล้วซ่อนจากรายการ: <b class="text-rose-400"><%= soldStockCount %></b></span></span>
      </div>
      <% if (isRandomBox && visibleStockItems.length) { %>
        <form action="/admin/products/<%= product.id %>/stock/delete-all" method="post" class="shrink-0" data-confirm="ลบรางวัลที่ยังไม่ได้จ่ายทั้งหมด <%= visibleStockItems.length %> ชิ้นออกจากสต็อกใช่ไหม? ระบบจะปรับจำนวนสต็อกและเก็บบัญชีสะสมเดิมไว้ รางวัลที่จ่ายให้ลูกค้าแล้วจะยังอยู่ในประวัติ">
          <button type="submit" class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-lg border border-rose-500/30 px-3 py-2 text-xs font-bold text-rose-500 transition hover:bg-rose-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            ลบทั้งหมด
          </button>
        </form>
      <% } %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="text-xs text-[var(--text-4)] bg-[var(--input)]/40 border-b border-[var(--border)] uppercase">
          <tr>
            <th class="py-3 px-4 font-semibold w-16">ลำดับ</th>
            <th class="py-3 px-4 font-semibold">ข้อมูลบน / Username</th>
            <th class="py-3 px-4 font-semibold">ข้อมูลล่าง / Password</th>
            <th class="py-3 px-4 font-semibold">สถานะ</th>
            <th class="py-3 px-4 font-semibold text-right">การจัดการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)]">
          <% visibleStockItems.forEach((s, index) => { %>
            <tr class="hover:bg-[var(--input)]/40 transition duration-150">
              <td class="py-3 px-4 font-mono text-xs text-[var(--text-4)]"><%= index + 1 %></td>
              <td class="py-3 px-4 font-mono text-xs">
                <%= s.fulfillmentMode === 'contact' ? 'ติดต่อร้านค้า' : s.username %>
              </td>
              <td class="py-3 px-4 font-mono text-xs text-[var(--text-3)]">
                <%= s.fulfillmentMode === 'contact' ? '—' : s.password %>
              </td>
              <td class="py-3 px-4 whitespace-nowrap">
                <% if (s.status === 'available') { %>
                  <span class="inline-flex items-center gap-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> พร้อมขาย
                  </span>
                <% } else if (s.status === 'reserved') { %>
                  <span class="inline-flex items-center gap-1 bg-amber-500/10 border border-amber-500/30 text-amber-600 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> สต็อกจองเดิม
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> ขายแล้ว
                  </span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-right whitespace-nowrap">
                <% if (s.status === 'available' || (isRandomBox && s.status === 'reserved')) { %>
                  <form action="/admin/products/<%= product.id %>/stock/<%= s.id %>/delete" method="post" class="inline" data-confirm="<%= s.status === 'reserved' ? 'ลบรางวัลนี้ออกจากรอบปัจจุบันใช่ไหม? ระบบจะหักจำนวนและปรับยอดสะสมของรอบให้' : 'ต้องการลบรางวัลนี้ออกจากสต็อกใช่ไหม?' %>">
                    <button type="submit" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-500/10 transition" title="ลบรายการนี้">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>

          <% if (!visibleStockItems.length) { %>
            <tr>
              <td class="py-12 text-center text-[var(--text-4)] text-xs" colspan="5">
                <div class="text-2xl mb-1">📦</div>
                ไม่มีสินค้าเหลือพร้อมขายในสต็อก
              </td>
            </tr>
          <% } %>

        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column: Add Stock Form Card -->
  <div id="add-stock" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm sticky top-20">
    <div class="flex items-center gap-2.5 mb-3">
      <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold-text)] flex items-center justify-center font-bold text-sm">
        ➕
      </div>
      <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เพิ่มจำนวนสต็อก</h3>
    </div>

    <form action="/admin/products/<%= product.id %>/stock/add" method="post" class="space-y-3.5" data-stock-add-form>
      <% if (isRandomBox) { %>
        <div class="rounded-xl bg-[var(--input)] px-3.5 py-3">
          <p class="text-xs font-bold text-[var(--text-2)]">เพิ่มสต็อกรางวัล</p>
          <p class="mt-1 text-[11px] text-[var(--text-4)]">วางคีย์/ไอดี 1 รายการต่อบรรทัด ไม่ต้องใส่มูลค่า</p>
        </div>
        <label class="block"><span class="mb-1 block text-xs font-semibold text-[var(--text-3)]">ข้อมูลคีย์ / ไอดี *</span><textarea name="bulk" rows="8" placeholder="คีย์หรือไอดีชิ้นที่ 1&#10;คีย์หรือไอดีชิ้นที่ 2&#10;คีย์หรือไอดีชิ้นที่ 3" required data-random-box-stock-input class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs font-mono outline-none focus:border-[var(--gold)] transition"></textarea><small class="mt-1 block text-[11px] text-[var(--text-4)]">นับได้ <strong data-random-box-stock-lines>0</strong> ชิ้น · วาง 1 รายการต่อบรรทัด</small></label>
        <script>
          (() => {
            const input = document.querySelector('[data-random-box-stock-input]');
            const count = document.querySelector('[data-random-box-stock-lines]');
            if (!input || !count) return;
            const update = () => { count.textContent = input.value.split(/\r?\n/).filter(line => line.trim()).length.toLocaleString('th-TH'); };
            input.addEventListener('input', update);
            update();
          })();
        </script>
      <% } else if (product.fulfillmentMode === 'contact') { %>
        <p class="text-[11px] text-[var(--text-4)]">ระบุจำนวนสิทธิ์ที่ต้องการเปิดขาย ลูกค้าจะติดต่อร้านเพื่อรับสินค้าหลังชำระเงิน</p>
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">จำนวนสิทธิ์ที่ต้องการเพิ่ม (ชิ้น) *</label>
          <input type="number" name="quantity" min="1" max="1000" placeholder="เช่น 10 หรือ 50" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
      <% } else { %>
        <p class="text-[11px] text-[var(--text-4)] leading-relaxed">
          ใส่ข้อมูล <b>1 บรรทัดต่อ 1 สินค้า</b> ได้เลย ไม่ต้องคั่นด้วย <code>:</code><br />
          ข้อความทั้งบรรทัดจะถูกบันทึกเป็นข้อมูลสินค้า
        </p>
        <details class="text-[10px] text-[var(--text-4)]">
          <summary class="cursor-pointer">ต้องการแยก Username / Password แบบเดิม?</summary>
          <p class="mt-1">ใช้ <code class="font-mono">Username:Password:หมายเหตุ</code> ได้ โดยใส่ 1 รายการต่อ 1 บรรทัด</p>
        </details>
        <textarea name="bulk" rows="8" placeholder="ข้อมูลสินค้า/ไอดีชิ้นที่ 1&#10;ข้อมูลสินค้า/ไอดีชิ้นที่ 2&#10;ข้อมูลสินค้า/ไอดีชิ้นที่ 3" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs font-mono outline-none focus:border-[var(--gold)] transition"></textarea>
      <% } %>

      <button type="submit" class="w-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--gold-contrast)] font-bold rounded-xl py-2.5 text-xs shadow-md transition active:scale-95">
        + เพิ่มรายการเข้าสู่สต็อก
      </button>
      <p data-stock-add-error role="alert" class="text-xs text-red-600" hidden></p>
    </form>
  </div>

</div>
<script src="<%= asset('js/admin-stock-submit-v1.js') %>" defer></script>
