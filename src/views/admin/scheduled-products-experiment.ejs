<link rel="stylesheet" href="<%= asset('css/admin-experiment-scheduled-v1.css') %>" />
<%
  const now = Date.now();
  const scheduleDate = value => {
    const raw = String(value || '');
    return new Date(raw + (/Z$|[+-]\d\d:\d\d$/.test(raw) ? '' : ':00+07:00'));
  };
  const waitingCount = products.filter(product => scheduleDate(product.publishAt).getTime() > now).length;
  const releasedCount = products.length - waitingCount;
%>
<div class="experiment-app experiment-schedule-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></svg><span>รายการสินค้า</span></a><a class="experiment-nav-item active" href="/admin/scheduled-products"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 7 8-4 8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7"/></svg><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M4 12h16M4 19h16"/><path d="M7 5v14"/></svg><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg><span>เติมเงิน & ตรวจสอบ</span><% if (pendingTopupCount) { %><b class="experiment-sidebar-count"><%= pendingTopupCount %></b><% } %></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 11 8-7 8 7v8H4z"/><path d="M9 19v-5h6v5"/></svg><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">สินค้าและสต๊อก</div><h1>ตั้งเวลาเปิดขาย</h1><p>กำหนดวันและเวลาให้สินค้าเปิดขายอัตโนมัติตามเวลาประเทศไทย โดยไม่ต้องกลับมาเปิดเอง</p></div><div class="experiment-actions"><a href="/admin/products/new" class="experiment-button primary">+ สร้างสินค้าแบบตั้งเวลา</a><a href="/admin/products" class="experiment-button">ดูสินค้าทั้งหมด</a></div></div>

      <section class="experiment-schedule-summary" aria-label="สรุปสินค้าตั้งเวลา"><div class="experiment-schedule-stat"><span class="experiment-schedule-stat-icon waiting"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></span><div><small>ตั้งเวลาทั้งหมด</small><strong><%= products.length %> รายการ</strong></div></div><div class="experiment-schedule-stat"><span class="experiment-schedule-stat-icon waiting"><svg viewBox="0 0 24 24"><path d="M12 3v4M12 17v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8"/></svg></span><div><small>กำลังรอเวลา</small><strong><%= waitingCount %> รายการ</strong></div></div><div class="experiment-schedule-stat"><span class="experiment-schedule-stat-icon ready"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span><div><small>ถึงเวลาแล้ว</small><strong><%= releasedCount %> รายการ</strong></div></div><div class="experiment-schedule-note"><span class="experiment-schedule-note-icon">ICT</span><div><strong>เวลาประเทศไทย</strong><small>ระบบเปิดขายอัตโนมัติตามเวลา Asia/Bangkok</small></div></div></section>

      <section class="experiment-card experiment-schedule-toolbar"><div class="experiment-schedule-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><input type="search" placeholder="ค้นหาชื่อสินค้า..." aria-label="ค้นหาสินค้าที่ตั้งเวลา" data-schedule-search /></div><div class="experiment-filter-tabs" role="tablist" aria-label="กรองสถานะเวลาเปิดขาย"><button class="experiment-filter active" type="button" role="tab" aria-selected="true" data-schedule-filter="all">ทั้งหมด <b><%= products.length %></b></button><button class="experiment-filter" type="button" role="tab" aria-selected="false" data-schedule-filter="waiting">รอเวลา <b><%= waitingCount %></b></button><button class="experiment-filter" type="button" role="tab" aria-selected="false" data-schedule-filter="released">ถึงเวลาแล้ว <b><%= releasedCount %></b></button></div></section>

      <section class="experiment-card experiment-schedule-list"><div class="experiment-schedule-list-head"><div><h2>คิวเปิดขาย</h2><p>รายการจะเปลี่ยนสถานะตามเวลาที่กำหนดอัตโนมัติ</p></div><span class="experiment-schedule-list-count"><%= products.length %> รายการ</span></div><div class="experiment-schedule-grid" data-schedule-list>
        <% products.forEach(product => { const due = scheduleDate(product.publishAt); const waiting = due.getTime() > now; %>
          <article class="experiment-schedule-card" data-schedule-card data-status="<%= waiting ? 'waiting' : 'released' %>" data-search="<%= `${product.title} ${product.slug || ''}`.toLowerCase() %>"><div class="experiment-schedule-card-accent <%= waiting ? 'waiting' : 'released' %>"></div><div class="experiment-schedule-card-body"><div class="experiment-schedule-card-top"><div class="experiment-schedule-thumb"><% if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="<%= product.title %>" loading="lazy" /><% } else { %><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/></svg><% } %></div><div class="experiment-schedule-card-copy"><div class="experiment-schedule-badges"><span class="experiment-schedule-status <%= waiting ? 'waiting' : 'released' %>"><i></i><%= waiting ? 'รอเวลาเปิดขาย' : 'ถึงเวลาแล้ว' %></span><% if (product.eventBadge) { %><span class="experiment-schedule-event"><%= product.eventBadge %></span><% } %></div><h3><%= product.title %></h3><small>slug: <%= product.slug || '-' %></small></div></div><div class="experiment-schedule-datetime"><span class="experiment-schedule-datetime-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span><div><small>กำหนดเปิดขาย</small><strong><%= due.toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></strong></div></div><div class="experiment-schedule-card-foot"><strong>฿<%= Number(product.price || 0).toLocaleString('th-TH') %></strong><div class="experiment-schedule-actions"><a href="/admin/products/<%= product.id %>/edit" class="experiment-button compact">แก้ไขเวลา</a><form method="post" action="/admin/scheduled-products/<%= product.id %>/clear" data-experiment-confirm="ยกเลิกเวลาเปิดขายของ <%= product.title %> หรือไม่? สินค้าจะไม่ถูกซ่อนด้วยกำหนดเวลาอีกต่อไป"><button class="experiment-button compact danger" type="submit">ล้างเวลา</button></form></div></div></div></article>
        <% }) %>
        <div class="experiment-schedule-empty" data-schedule-empty><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><h3>ยังไม่มีสินค้าที่ตั้งเวลาเปิดขาย</h3><p>เริ่มจากสร้างสินค้าใหม่ แล้วกำหนดวันและเวลาในหัวข้อ EVENT UPDATE</p><a href="/admin/products/new" class="experiment-button primary">สร้างสินค้าแบบตั้งเวลา</a></div>
      </div></section>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin">⌂<span>ภาพรวม</span></a><a href="/admin/products">▦<span>สินค้า</span></a><a class="active" href="/admin/scheduled-products">◷<span>ตั้งเวลา</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>
<script>
  (function () {
    var cards = Array.from(document.querySelectorAll('[data-schedule-card]')), search = document.querySelector('[data-schedule-search]'), empty = document.querySelector('[data-schedule-empty]'), filter = 'all';
    function refresh() { var query = (search.value || '').toLowerCase().trim(), shown = 0; cards.forEach(function (card) { var matches = (!query || card.dataset.search.includes(query)) && (filter === 'all' || card.dataset.status === filter); card.hidden = !matches; if (matches) shown += 1; }); empty.hidden = shown !== 0; }
    search.addEventListener('input', refresh); document.querySelectorAll('[data-schedule-filter]').forEach(function (button) { button.addEventListener('click', function () { filter = button.dataset.scheduleFilter; document.querySelectorAll('[data-schedule-filter]').forEach(function (item) { item.classList.toggle('active', item === button); item.setAttribute('aria-selected', String(item === button)); }); refresh(); }); }); refresh();
  })();
</script>
