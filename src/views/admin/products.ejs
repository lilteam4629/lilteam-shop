<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
  <form action="/admin/products/card-style" method="post" class="flex items-center gap-2 bg-[var(--card)] border border-[var(--border)] rounded-lg p-1 text-sm">
    <span class="text-[var(--text-4)] text-xs pl-2">🃏 รูปแบบการ์ด:</span>
    <button name="productCardStyle" value="classic" class="px-3 py-1.5 rounded-md transition <%= productCardStyle === 'classic' ? 'bg-[var(--gold)] text-[var(--bg)] font-medium' : 'text-[var(--text-3)] hover:bg-[var(--input)]' %>">🎴 คลาสสิก</button>
    <button name="productCardStyle" value="natural" class="px-3 py-1.5 rounded-md transition <%= productCardStyle === 'natural' ? 'bg-[var(--gold)] text-[var(--bg)] font-medium' : 'text-[var(--text-3)] hover:bg-[var(--input)]' %>">🖼️ เต็มรูป</button>
  </form>
  <div class="flex items-center gap-2">
    <a href="/admin/products/bulk-import" class="bg-[var(--input)] border border-[var(--gold)]/40 text-[var(--gold)] hover:border-[var(--gold)] font-medium px-4 py-2 rounded-lg text-sm">📁 นำเข้าจากโฟลเดอร์</a>
    <a href="/admin/products/new" class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-4 py-2 rounded-lg text-sm">+ เพิ่มสินค้า</a>
  </div>
</div>
<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
      <tr><th class="p-3">สินค้า</th><th class="p-3">ราคา</th><th class="p-3">สต๊อก</th><th class="p-3">สถานะ</th><th class="p-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)]">
      <% products.forEach(p => { %>
        <tr class="hover:bg-[var(--input)]/50">
          <td class="p-3 flex items-center gap-2">
            <img src="<%= p.images[0] %>" class="w-10 h-8 object-cover rounded" />
            <%= p.title %>
          </td>
          <td class="p-3">
            ฿<%= p.price.toLocaleString() %>
            <% if (p.originalPrice > p.price) { %>
              <span class="text-rose-400 line-through text-xs">฿<%= p.originalPrice.toLocaleString() %></span>
            <% } %>
          </td>
          <td class="p-3">
            <a href="/admin/products/<%= p.id %>/stock" class="<%= p.stockCount < 1 ? 'text-rose-400' : 'text-emerald-400' %>"><%= p.stockCount %> รายการ</a>
          </td>
          <td class="p-3"><%= p.status === 'active' ? '🟢 เปิดขาย' : '⚪ ซ่อน' %></td>
          <td class="p-3 text-right space-x-2 whitespace-nowrap">
            <a href="/admin/products/<%= p.id %>/edit" class="text-[var(--gold)]">แก้ไข</a>
            <form action="/admin/products/<%= p.id %>/copy" method="post" class="inline" onsubmit="return confirm('คัดลอกสินค้านี้? สต๊อกไอดีจะไม่ถูกคัดลอก')">
              <button class="text-sky-400">คัดลอก</button>
            </form>
            <form action="/admin/products/<%= p.id %>/delete" method="post" class="inline" onsubmit="return confirm('ลบสินค้านี้?')">
              <button class="text-rose-400">ลบ</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!products.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="5">ยังไม่มีสินค้า</td></tr><% } %>
    </tbody>
  </table>
</div>
