<!-- Products Management Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">รายการสินค้าทั้งหมด</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">จัดการสต็อกสินค้า กำหนดราคา และตั้งค่าการขายของร้านคุณ (<%= products.length %> รายการ)</p>
  </div>

  <div class="flex items-center gap-2.5 flex-wrap">
    <!-- Card Style Toggle -->
    <form action="/admin/products/card-style" method="post" class="flex items-center gap-1 bg-[var(--card)] border border-[var(--border)] rounded-xl p-1 text-xs shadow-sm">
      <span class="text-[var(--text-4)] text-[11px] px-2 font-medium">รูปแบบการ์ด:</span>
      <button name="productCardStyle" value="classic" class="px-3 py-1.5 rounded-lg transition <%= productCardStyle === 'classic' ? 'bg-[var(--gold)] text-[var(--bg)] font-bold shadow-sm' : 'text-[var(--text-3)] hover:text-[var(--text)] hover:bg-[var(--input)]' %>">🎴 คลาสสิก</button>
      <button name="productCardStyle" value="natural" class="px-3 py-1.5 rounded-lg transition <%= productCardStyle === 'natural' ? 'bg-[var(--gold)] text-[var(--bg)] font-bold shadow-sm' : 'text-[var(--text-3)] hover:text-[var(--text)] hover:bg-[var(--input)]' %>">🖼️ เต็มรูป</button>
    </form>

    <% const zeroStockCount = products.filter(p => p.stockCount < 1).length; %>

    <!-- Bulk Actions Dropdown -->
    <% if (products.length) { %>
    <div class="relative" id="bulk-actions-dropdown">
      <button type="button" id="bulk-actions-toggle" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-4 py-2 rounded-xl text-xs shadow-md hover:shadow-lg transition active:scale-95">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
        <span>จัดการหลายรายการ</span>
        <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
      <div id="bulk-actions-menu" class="hidden absolute left-0 mt-2 w-64 max-w-[calc(100vw-2rem)] bg-[var(--card)] border border-[var(--border)] rounded-xl shadow-2xl z-30 overflow-hidden py-1.5">
        <a href="/admin/products/bulk-import" class="flex items-center gap-2 px-4 py-2.5 text-xs text-[var(--text-2)] hover:bg-[var(--input)] hover:text-[var(--gold)] transition">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          <span>นำเข้าจากโฟลเดอร์</span>
        </a>
        <% if (zeroStockCount) { %>
        <form action="/admin/products/stock/add-all" method="post" data-confirm="เพิ่มสต็อก 1 ชิ้นให้สินค้าที่สต็อกว่างทั้ง <%= zeroStockCount %> รายการ (โหมดติดต่อร้านเพื่อรับสินค้า — คุณต้องส่งไอดีให้ลูกค้าเองหลังขายผ่านแชท) ยืนยันไหม?">
          <button class="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-sky-300 hover:bg-[var(--input)] transition text-left">
            <span class="w-4 text-center shrink-0">📦</span>
            <span>เพิ่มสต็อกที่ว่างทั้งหมด (<%= zeroStockCount %>)</span>
          </button>
        </form>
        <% } %>
        <form action="/admin/products/set-status-all" method="post" data-confirm="เปิดขายสินค้าทั้งหมด <%= products.length %> รายการ?">
          <input type="hidden" name="status" value="active" />
          <button class="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-emerald-300 hover:bg-[var(--input)] transition text-left">
            <span class="w-4 text-center shrink-0">●</span>
            <span>เปิดขายทั้งหมด</span>
          </button>
        </form>
        <form action="/admin/products/set-status-all" method="post" data-confirm="ซ่อนสินค้าทั้งหมด <%= products.length %> รายการ? ลูกค้าจะมองไม่เห็นสินค้าเหล่านี้ทันที">
          <input type="hidden" name="status" value="hidden" />
          <button class="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-[var(--text-2)] hover:bg-[var(--input)] transition text-left">
            <span class="w-4 text-center shrink-0">●</span>
            <span>ซ่อนทั้งหมด</span>
          </button>
        </form>
        <div class="my-1 border-t border-[var(--border)]"></div>
        <button type="button" id="delete-all-products-btn" class="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-rose-300 hover:bg-rose-950/40 transition text-left">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          <span>ลบสินค้าทั้งหมด</span>
        </button>
      </div>
    </div>
    <script>
      (function () {
        const wrap = document.getElementById('bulk-actions-dropdown');
        const toggle = document.getElementById('bulk-actions-toggle');
        const menu = document.getElementById('bulk-actions-menu');
        if (!wrap || !toggle || !menu) return;
        toggle.addEventListener('click', function (e) {
          e.stopPropagation();
          menu.classList.toggle('hidden');
        });
        document.addEventListener('click', function (e) {
          if (!wrap.contains(e.target)) menu.classList.add('hidden');
        });
      })();
    </script>
    <% } else { %>
    <a href="/admin/products/bulk-import" class="inline-flex items-center gap-1.5 bg-[var(--input)] hover:bg-[var(--card-hover)] border border-[var(--border-light)] text-[var(--text-2)] hover:text-[var(--gold)] font-medium px-3.5 py-2 rounded-xl text-xs transition active:scale-95">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
      <span>นำเข้าโฟลเดอร์</span>
    </a>
    <% } %>

    <!-- Add Product Button -->
    <a href="/admin/products/new" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-4 py-2 rounded-xl text-xs shadow-md hover:shadow-lg transition active:scale-95">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>เพิ่มสินค้าใหม่</span>
    </a>
  </div>
</div>

<% if (products.length) { %>
<div id="delete-all-products-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-md">
  <div class="bg-[var(--card)] border border-rose-500/40 rounded-2xl p-6 max-w-md w-full shadow-2xl">
    <div class="flex items-center gap-3.5 mb-3">
      <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center shrink-0 text-xl font-bold">⚠️</div>
      <h3 class="font-bold text-base text-[var(--text)]">ลบสินค้าทั้งหมด <%= products.length %> รายการ</h3>
    </div>
    <p class="text-sm text-[var(--text-3)] mb-4 leading-relaxed">
      การลบนี้จะลบ<b>สินค้าทั้งหมด</b>และ<b>สต็อกสินค้าทั้งหมด</b>ในร้านทันที <b class="text-rose-400">กู้คืนไม่ได้</b> — คำสั่งซื้อเก่าของลูกค้ายังอยู่ตามปกติ ไม่ถูกลบ
    </p>
    <label class="block text-xs text-[var(--text-3)] mb-1">พิมพ์ <b class="font-mono text-rose-400">ลบสินค้าทั้งหมด</b> เพื่อยืนยัน</label>
    <form action="/admin/products/delete-all" method="post">
      <input name="confirmPhrase" id="delete-all-confirm-input" autocomplete="off" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm mb-4" placeholder="ลบสินค้าทั้งหมด" />
      <div class="flex items-center justify-end gap-2.5">
        <button type="button" id="delete-all-products-cancel" class="px-4 py-2 rounded-xl text-sm font-medium text-[var(--text-3)] hover:text-[var(--text)] hover:bg-[var(--input)] transition">ยกเลิก</button>
        <button type="submit" id="delete-all-products-submit" disabled class="px-5 py-2 rounded-xl text-sm font-semibold bg-rose-600 text-white shadow-lg transition disabled:opacity-40 disabled:cursor-not-allowed">ลบทั้งหมด</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function () {
    const openBtn = document.getElementById('delete-all-products-btn');
    const modal = document.getElementById('delete-all-products-modal');
    const cancelBtn = document.getElementById('delete-all-products-cancel');
    const input = document.getElementById('delete-all-confirm-input');
    const submitBtn = document.getElementById('delete-all-products-submit');
    if (!openBtn || !modal) return;
    const REQUIRED_PHRASE = 'ลบสินค้าทั้งหมด';
    openBtn.addEventListener('click', function () { modal.classList.remove('hidden'); input.value = ''; submitBtn.disabled = true; input.focus(); });
    cancelBtn.addEventListener('click', function () { modal.classList.add('hidden'); });
    input.addEventListener('input', function () { submitBtn.disabled = input.value.trim() !== REQUIRED_PHRASE; });
  })();
</script>
<% } %>

<!-- Search & Filter Bar -->
<div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-4 mb-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3">
  <div class="relative w-full sm:w-80">
    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-4)] text-sm">⌕</span>
    <input type="text" data-table-search="#admin-products-table" placeholder="ค้นหาชื่อสินค้า หมวดหมู่ หรือราคา..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl pl-9 pr-3 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
  </div>

  <div class="flex items-center gap-3 text-xs text-[var(--text-4)] w-full sm:w-auto justify-between sm:justify-end">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>เปิดขาย (<%= products.filter(p => p.status === 'active').length %>)</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-slate-500"></span>
      <span>ซ่อนอยู่ (<%= products.filter(p => p.status !== 'active').length %>)</span>
    </div>
  </div>
</div>

<!-- Products Table Card -->
<div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-sm">
  <div class="overflow-x-auto">
    <table id="admin-products-table" class="w-full text-left text-xs sm:text-sm">
      <thead class="text-xs text-[var(--text-4)] bg-[var(--input)]/40 border-b border-[var(--border)] uppercase">
        <tr>
          <th class="py-3.5 px-4 font-semibold">สินค้า</th>
          <th class="py-3.5 px-4 font-semibold">ราคาขาย</th>
          <th class="py-3.5 px-4 font-semibold">คงเหลือในสต๊อก</th>
          <th class="py-3.5 px-4 font-semibold">สถานะ</th>
          <th class="py-3.5 px-4 font-semibold text-right">การจัดการ</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% products.forEach(p => { %>
          <tr class="hover:bg-[var(--input)]/40 transition duration-150">

            <!-- Product Info -->
            <td class="py-3 px-4">
              <div class="flex items-center gap-3">
                <div class="admin-product-thumb rounded-lg overflow-hidden bg-[var(--input)] border border-[var(--border)] shrink-0 shadow-sm">
                  <% if (p.images && p.images[0]) { %>
                    <a href="<%= p.images[0] %>" target="_blank" rel="noopener" title="เปิดดูรูป <%= p.title %> ขนาดเต็ม" class="block w-full h-full">
                      <img src="<%= p.images[0] %>" class="w-full h-full object-contain" alt="<%= p.title %>" loading="lazy" />
                    </a>
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-xs text-[var(--text-4)]">🎮</div>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <div class="font-bold text-sm text-[var(--text)] hover:text-[var(--gold)] transition truncate">
                    <a href="/admin/products/<%= p.id %>/edit"><%= p.title %></a>
                  </div>
                  <div class="text-[11px] text-[var(--text-4)] font-mono truncate">slug: <%= p.slug %></div>
                  <% if (p.internalNote) { %>
                    <div class="text-[11px] text-[var(--text-3)] truncate" title="หมายเหตุภายใน (แอดมินเห็นเท่านั้น)">📝 <%= p.internalNote %></div>
                  <% } %>
                  <% if (p.selectedFilterTags && p.selectedFilterTags.length) { %>
                    <div class="flex items-center gap-1 mt-1.5" title="ตัวกรองที่เลือกไว้">
                      <% p.selectedFilterTags.slice(0, 8).forEach(tag => { %>
                        <img src="<%= tag.image %>" alt="<%= tag.name %>" title="<%= tag.name %>" class="w-6 h-6 rounded-full object-cover border border-[var(--gold)]/50 bg-[var(--card)]" />
                      <% }) %>
                      <% if (p.selectedFilterTags.length > 8) { %><span class="text-[10px] text-[var(--text-4)]">+<%= p.selectedFilterTags.length - 8 %></span><% } %>
                    </div>
                  <% } else { %>
                    <div class="text-[10px] text-[var(--text-4)] mt-1">ยังไม่ได้เลือกตัวกรอง</div>
                  <% } %>
                </div>
              </div>
            </td>

            <!-- Price -->
            <td class="py-3 px-4 whitespace-nowrap">
              <div class="font-bold text-sm text-[var(--gold)]">฿<%= p.price.toLocaleString() %></div>
              <% if (p.originalPrice > p.price) { %>
                <div class="text-[11px] text-[var(--coral)] line-through">฿<%= p.originalPrice.toLocaleString() %></div>
              <% } %>
            </td>

            <!-- Stock -->
            <td class="py-3 px-4 whitespace-nowrap">
              <a href="/admin/products/<%= p.id %>/stock" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl border font-semibold text-xs transition <%= p.stockCount < 1 ? 'bg-rose-500/10 border-rose-500/30 text-rose-400 hover:bg-rose-500/20' : (p.stockCount <= 3 ? 'bg-amber-500/10 border-amber-500/30 text-amber-400 hover:bg-amber-500/20' : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/20') %>">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                <span><%= p.stockCount %> รายการ</span>
              </a>
            </td>

            <!-- Status -->
            <td class="py-3 px-4 whitespace-nowrap">
              <% if (p.status === 'active') { %>
                <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span>เปิดขาย</span>
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 bg-[var(--input)] border border-[var(--border-light)] text-[var(--text-4)] text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                  <span>ซ่อนอยู่</span>
                </span>
              <% } %>
            </td>

            <!-- Actions -->
            <td class="py-3 px-4 text-right whitespace-nowrap">
              <div class="inline-flex items-center gap-1">
                <!-- Stock Button -->
                <a href="/admin/products/<%= p.id %>/stock" class="p-1.5 rounded-lg text-[var(--text-3)] hover:text-[var(--gold)] hover:bg-[var(--input)] transition" title="จัดการสต็อกสินค้า">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                </a>

                <!-- Edit Button -->
                <a href="/admin/products/<%= p.id %>/edit" class="p-1.5 rounded-lg text-sky-400 hover:bg-sky-500/10 transition" title="แก้ไขข้อมูลสินค้า">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                </a>

                <!-- Copy Form -->
                <form action="/admin/products/<%= p.id %>/copy" method="post" class="inline" data-confirm="ต้องการคัดลอกสินค้านี้ใช่ไหม? (ข้อมูลสต็อกไอดีจะไม่ถูกคัดลอก)">
                  <button type="submit" class="p-1.5 rounded-lg text-purple-400 hover:bg-purple-500/10 transition" title="คัดลอกสินค้า">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                  </button>
                </form>

                <!-- Delete Form -->
                <form action="/admin/products/<%= p.id %>/delete" method="post" class="inline" data-confirm="ต้องการลบสินค้า '<%= p.title %>' ใช่หรือไม่? การกระทำนี้ไม่สามารถย้อนกลับได้">
                  <button type="submit" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-500/10 transition" title="ลบสินค้า">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </form>
              </div>
            </td>

          </tr>
        <% }) %>

        <% if (!products.length) { %>
          <tr>
            <td class="py-12 text-center text-[var(--text-4)]" colspan="5">
              <div class="text-3xl mb-2">📦</div>
              <div class="text-sm font-semibold text-[var(--text-3)]">ยังไม่มีสินค้าในร้าน</div>
              <p class="text-xs text-[var(--text-4)] mt-1 mb-4">เริ่มต้นสร้างสินค้าชิ้นแรก เพื่อให้ลูกค้าสามารถสั่งซื้อได้</p>
              <a href="/admin/products/new" class="inline-flex items-center gap-1.5 bg-[var(--gold)] text-[var(--bg)] font-bold px-4 py-2 rounded-xl text-xs shadow-md">
                + เพิ่มสินค้าแรกเลย
              </a>
            </td>
          </tr>
        <% } %>

        <tr class="table-empty-search-row" style="display: none;">
          <td class="py-12 text-center text-[var(--text-4)]" colspan="5">
            <div class="text-2xl mb-1">🔍</div>
            <div class="text-xs">ไม่พบสินค้าที่ตรงกับคำค้นหา</div>
          </td>
        </tr>

      </tbody>
    </table>
  </div>
</div>

<script>
  (function () {
    var raw = sessionStorage.getItem('bulkImportSummary');
    if (!raw) return;
    sessionStorage.removeItem('bulkImportSummary');
    try {
      var summary = JSON.parse(raw);
      var names = summary.failed.map(function (f) { return f.filename; }).join(', ');
      if (window.showToast) {
        showToast('นำเข้าสำเร็จ ' + summary.createdCount + '/' + summary.total + ' รายการ — ล้มเหลว: ' + names, 'warning', 10000);
      } else {
        alert('นำเข้าสำเร็จ ' + summary.createdCount + '/' + summary.total + ' รายการ — ล้มเหลว: ' + names);
      }
    } catch (e) {}
  })();
</script>
