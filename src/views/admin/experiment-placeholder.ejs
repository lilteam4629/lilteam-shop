<link rel="stylesheet" href="<%= asset('css/admin-experiment-placeholder-v2.css') %>" />
<style>.legacy-placeholder-sidebar{display:none!important}</style>
<%
  const pathKey = experimentPath || '';
  const isAppearance = pathKey === '/appearance';
  const isTopups = pathKey === '/topups';
  const isUsers = pathKey === '/users';
  const previewKind = isAppearance ? 'ASSET STUDIO' : isTopups ? 'PAYMENT DESK' : isUsers ? 'TEAM CONTROL' : 'FEATURE PREVIEW';
%>
<div class="experiment-app experiment-pending-page">
  <%- include('../partials/admin-experiment-sidebar-effects') %>
  <aside class="experiment-sidebar legacy-placeholder-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark" aria-hidden="true"><span>L</span></div><div><div class="experiment-brand-title">LILTeam Shop</div><div class="experiment-brand-sub">ผู้ดูแลระบบ · รุ่นทดลอง</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู">‹</button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">โหมดทดลอง</div><a class="experiment-nav-item" href="/admin?ui=experiment"><span aria-hidden="true">▦</span><span>ภาพรวมแดชบอร์ด</span></a><a class="experiment-nav-item" href="/admin/products?ui=experiment"><span aria-hidden="true">◇</span><span>สินค้าและสต๊อก</span></a><a class="experiment-nav-item" href="/admin/orders?ui=experiment"><span aria-hidden="true">▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item active" href="<%= experimentPath %>?ui=experiment"><span aria-hidden="true">✦</span><span><%= experimentLabel %></span><em class="experiment-nav-status pending">รอทำ</em></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span aria-hidden="true">⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a></div>
  </aside>
  <div class="experiment-main"><header class="experiment-topbar"><div class="experiment-build-legend"><span><i class="pending"></i> รอทำ</span><span>โหมดทดลอง UI ใหม่</span></div><button class="experiment-icon-button" data-experiment-notifications type="button" aria-label="ดูการแจ้งเตือน">◌</button><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">ทดลองระบบ · <%= experimentLabel %></div><h1><%= experimentLabel %></h1><p>หน้านี้ยังอยู่ในคิวพัฒนา แต่ทำพื้นที่ตัวอย่างไว้ให้เห็นภาพและไล่รายการที่ต้องทำจริง</p></div><span class="pending-page-status"><i></i> รอทำ</span></div>
      <section class="pending-feature-hero experiment-card"><div><span class="pending-feature-kicker"><%= previewKind %> · SAMPLE WORKSPACE</span><h2>ตัวอย่างระบบ <%= experimentLabel %></h2><p>โครงนี้เป็นแบบทดลองเพื่อใช้คุยเรื่องหน้าจอและขั้นตอนการใช้งานก่อนเชื่อมข้อมูลจริง ปุ่มในหน้านี้ยังไม่บันทึกข้อมูล</p></div><div class="pending-feature-symbol"><span>✦</span><small>DEMO</small></div></section>
      <section class="pending-preview-layout">
        <div class="pending-preview-canvas experiment-card">
          <div class="pending-preview-head"><div><span>INTERACTION MOCKUP</span><h2>หน้าจอที่กำลังจะทำ</h2></div><em>ข้อมูลตัวอย่าง</em></div>
          <% if (isAppearance) { %>
            <div class="pending-asset-toolbar"><div class="pending-search-fake">⌕ ค้นหารูปและแบนเนอร์...</div><button type="button">+ เพิ่มไฟล์</button></div><div class="pending-asset-grid"><div class="pending-asset-card hero"><div class="pending-asset-art gradient-one"><span>LOGO</span></div><strong>โลโก้ร้าน</strong><small>ใช้บน Header และหน้าเช็กเอาต์</small><b>พร้อมจัดการ</b></div><div class="pending-asset-card"><div class="pending-asset-art gradient-two"><span>HERO BANNER</span></div><strong>แบนเนอร์หน้าหลัก</strong><small>ภาพโปรโมชันด้านบนร้าน</small><b>รอเชื่อมหน้าร้าน</b></div><div class="pending-asset-card"><div class="pending-asset-art gradient-three"><span>PROMO</span></div><strong>แบนเนอร์โปรโมชัน</strong><small>จัดชุดภาพตามแคมเปญ</small><b>ตัวอย่าง</b></div></div>
          <% } else if (isTopups) { %>
            <div class="pending-payment-summary"><div><small>ยอดรอตรวจสอบ</small><strong>฿1,250</strong></div><div><small>รายการวันนี้</small><strong>7</strong></div><span>ระบบตัวอย่าง</span></div><div class="pending-table"><div class="pending-table-row head"><span>รายการ</span><span>ผู้โอน</span><span>ยอดเงิน</span><span>สถานะ</span></div><div class="pending-table-row"><strong>#TOPUP-001</strong><span>ลูกค้าตัวอย่าง</span><b>฿500</b><em>รอตรวจสอบ</em></div><div class="pending-table-row"><strong>#TOPUP-002</strong><span>สมาชิกทดลอง</span><b>฿750</b><em>รอตรวจสอบ</em></div></div>
          <% } else if (isUsers) { %>
            <div class="pending-team-toolbar"><div class="pending-search-fake">⌕ ค้นหาชื่อหรืออีเมล...</div><button type="button">+ เชิญผู้ดูแล</button></div><div class="pending-member-list"><div class="pending-member"><span class="pending-avatar mint">A</span><span><strong>admin</strong><small>admin@example.com</small></span><em>เจ้าของร้าน</em><i>ใช้งาน</i></div><div class="pending-member"><span class="pending-avatar blue">T</span><span><strong>ทีมตัวอย่าง</strong><small>team@example.com</small></span><em>ผู้ดูแลสินค้า</em><i>รอเชิญ</i></div></div>
          <% } else { %>
            <div class="pending-generic-grid"><div><span>01</span><strong>ตั้งค่าหลัก</strong><small>ข้อมูลและตัวเลือกพื้นฐานของฟังก์ชัน</small></div><div><span>02</span><strong>ดูตัวอย่าง</strong><small>ตรวจหน้าตาก่อนเปิดใช้งานจริง</small></div><div><span>03</span><strong>บันทึกและติดตาม</strong><small>ประวัติและสถานะการทำงานของระบบ</small></div></div><div class="pending-generic-empty"><b>พื้นที่ทดลองพร้อมต่อยอด</b><span>เมื่อเริ่มทำจริง ส่วนนี้จะเชื่อมกับข้อมูลร้านโดยตรง</span></div>
          <% } %>
        </div>
        <aside class="pending-preview-side experiment-card"><div class="pending-side-kicker">WHAT REMAINS</div><h2>รายการที่ต้องทำ</h2><ol><li><span>01</span><div><strong>ออกแบบหน้าการทำงานจริง</strong><small>ฟอร์ม, ตาราง และสถานะของข้อมูล</small></div></li><li><span>02</span><div><strong>เชื่อมข้อมูลและสิทธิ์</strong><small>บันทึกจริงและจำกัดการเข้าถึง</small></div></li><li><span>03</span><div><strong>ทดสอบทุกขั้นตอน</strong><small>มือถือ, ข้อมูลผิดพลาด และการย้อนกลับ</small></div></li></ol><div class="pending-side-note"><i>i</i><span>ตัวอย่างนี้ใช้ข้อมูลจำลองเท่านั้น ไม่มีผลกับร้านจริง</span></div></aside>
      </section>
      <div class="pending-page-actions"><a class="experiment-button primary" href="/admin?ui=experiment">กลับแดชบอร์ดใหม่</a><a class="experiment-button" href="/admin/settings?ui=experiment">กลับหน้าตั้งค่าร้าน</a></div>
    </main>
  </div>
</div>
