<form action="<%= product ? `/admin/products/${product.id}/edit` : '/admin/products/new' %>" method="post" enctype="multipart/form-data"
  class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 max-w-3xl space-y-4">
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อเกม</label>
    <input name="title" required value="<%= product ? product.title : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ราคาขาย (บาท)</label>
      <input type="number" name="price" required value="<%= product ? product.price : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ราคาปกติ (สำหรับแสดงราคาขีดฆ่า)</label>
      <input type="number" name="originalPrice" value="<%= product ? product.originalPrice : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
  </div>

  <div class="bg-[var(--input)]/45 border border-[var(--gold)]/30 rounded-xl p-4 space-y-4">
    <div>
      <h3 class="font-medium text-[var(--gold)]">⚡ Flash Sale</h3>
      <p class="text-xs text-[var(--text-4)] mt-1">ตั้งราคาพิเศษและเวลาไทยล่วงหน้า ระบบจะเริ่มลดราคาและคืนราคาขายเดิมให้อัตโนมัติเมื่อหมดเวลา เว้นว่างทั้งหมดหากไม่ใช้</p>
    </div>
    <div class="grid sm:grid-cols-3 gap-3">
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">ราคา Flash Sale (บาท)</label>
        <input type="number" min="0" name="flashSalePrice" value="<%= product && product.flashSalePrice != null ? product.flashSalePrice : '' %>" placeholder="เช่น 49" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">เริ่มโปรโมชั่น</label>
        <input type="datetime-local" name="flashSaleStartAt" value="<%= product && product.flashSaleStartAt ? product.flashSaleStartAt : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">สิ้นสุดโปรโมชั่น</label>
        <input type="datetime-local" name="flashSaleEndAt" value="<%= product && product.flashSaleEndAt ? product.flashSaleEndAt : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
      </div>
    </div>
    <p class="text-xs text-[var(--text-4)]">ราคาพิเศษต้องต่ำกว่าราคาขาย และเวลาสิ้นสุดต้องอยู่หลังเวลาเริ่ม</p>
  </div>

  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">ตัวกรองสินค้า (สินค้านี้มีสิ่งนี้)</label>
    <% if (!filterTags.length) { %>
      <p class="text-xs text-[var(--text-4)]">ยังไม่มีตัวกรองสินค้า — ไปเพิ่มได้ที่เมนู "🏷️ ตัวกรองสินค้า"</p>
    <% } else { %>
      <div class="flex flex-wrap gap-3">
        <% filterTags.forEach(t => { %>
          <label class="flex items-center gap-2 bg-[var(--input)] border border-[var(--border-light)] rounded-lg pl-2 pr-3 py-1.5 cursor-pointer hover:border-[var(--gold)]">
            <input type="checkbox" name="filterTagIds" value="<%= t.id %>" <%= product && (product.filterTagIds || []).includes(t.id) ? 'checked':'' %> />
            <img src="<%= t.image %>" class="w-6 h-6 rounded-full object-cover" alt="<%= t.name %>" />
            <span class="text-sm"><%= t.name %></span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">รายละเอียดสั้น (แสดงในการ์ดสินค้า)</label>
    <textarea name="description" rows="2" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2"><%= product ? product.description : '' %></textarea>
  </div>
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">รายละเอียดเกม (แท็บ "รายละเอียด")</label>
    <textarea name="aboutText" rows="4" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2"><%= product ? product.aboutText : '' %></textarea>
  </div>
  <div class="bg-[var(--input)]/40 border border-[var(--border-light)] rounded-xl p-4 space-y-4">
    <div>
      <h3 class="font-medium">รูปภาพสินค้า</h3>
      <p class="text-xs text-[var(--text-4)]">รูปแรกจะใช้เป็นภาพหน้าปกในการ์ดสินค้า อัปโหลดได้สูงสุดครั้งละ 10 รูป</p>
    </div>

    <% if (product && product.images && product.images.length) { %>
      <div>
        <label class="block text-sm mb-2 text-[var(--text-3)]">รูปปัจจุบัน — ติ๊กใต้รูปที่ต้องการลบ</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          <% product.images.forEach((image, index) => { %>
            <label class="group relative rounded-xl overflow-hidden border border-[var(--border-light)] bg-[var(--card)] cursor-pointer">
              <img src="<%= image %>" alt="รูปสินค้า <%= index + 1 %>" class="w-full aspect-[4/3] object-contain" />
              <% if (index === 0) { %><span class="absolute top-2 left-2 bg-[var(--gold)] text-[var(--bg)] rounded-full px-2 py-0.5 text-[10px] font-bold">ภาพหน้าปก</span><% } %>
              <span class="flex items-center justify-center gap-1.5 p-2 text-xs text-rose-400 group-hover:bg-rose-500/10">
                <input type="checkbox" name="removeImages" value="<%= image %>" class="accent-rose-500" /> ลบรูปนี้
              </span>
            </label>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="max-w-xs"><%- include('../partials/image-placeholder', { w: 1000, h: 750, ratioClass: 'aspect-[4/3]' }) %></div>
    <% } %>

    <div>
      <label class="block text-sm mb-2 text-[var(--text-3)]">เพิ่มรูปจากเครื่องหรือโทรศัพท์</label>
      <input id="productImagesInput" type="file" name="productImages" accept="image/png,image/jpeg,image/webp,image/gif" multiple class="block w-full text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[#332b1a] file:text-[var(--gold)] file:text-sm" />
      <div id="newImagePreview" class="hidden grid grid-cols-2 sm:grid-cols-4 gap-3 mt-3"></div>
    </div>

    <label class="flex items-center gap-2 text-sm cursor-pointer w-fit">
      <input type="checkbox" name="newImagesFirst" class="accent-[var(--gold)]" />
      ใช้รูปที่อัปโหลดใหม่เป็นภาพหน้าปก
    </label>

    <details>
      <summary class="cursor-pointer text-xs text-[var(--text-3)]">หรือเพิ่มรูปด้วย URL</summary>
      <textarea name="images" rows="3" placeholder="https://...&#10;https://..." class="mt-2 w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 font-mono text-sm"></textarea>
    </details>
  </div>

  <div class="bg-[var(--input)]/45 border border-[var(--border-light)] rounded-xl p-4 space-y-3">
    <div>
      <h3 class="font-medium">⏰ EVENT UPDATE / ตั้งเวลาเปิดขาย</h3>
      <p class="text-xs text-[var(--text-4)] mt-1">เว้นวันเวลาไว้หากต้องการเปิดขายทันที หากตั้งเวลา สินค้าจะถูกซ่อนไว้และเปิดขายอัตโนมัติเมื่อถึงเวลาไทย</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">วันและเวลาเปิดขาย</label>
        <input type="datetime-local" name="publishAt" value="<%= product && product.publishAt ? product.publishAt : '' %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">ป้ายกิจกรรม</label>
        <input name="eventBadge" value="<%= product ? (product.eventBadge || '') : '' %>" placeholder="เช่น SPECIAL, LIMITED" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
      </div>
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">คำอธิบายบนการ์ดกิจกรรม</label>
      <input name="eventDescription" value="<%= product ? (product.eventDescription || '') : '' %>" placeholder="เช่น เปิดขายจำนวนจำกัด เตรียมตัวให้พร้อม!" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
  </div>

  <% if (product) { %>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">สถานะ</label>
      <select name="status" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2">
        <option value="active" <%= product.status==='active'?'selected':'' %>>เปิดขาย</option>
        <option value="hidden" <%= product.status==='hidden'?'selected':'' %>>ซ่อน</option>
      </select>
    </div>
  <% } %>

  <div class="flex gap-3">
    <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-6 py-2 rounded-lg text-sm"><%= product ? 'บันทึกการแก้ไข' : 'เพิ่มสินค้า' %></button>
    <a href="/admin/products" class="px-6 py-2 rounded-lg text-sm border border-[var(--border-light)] hover:bg-[var(--input)]">ยกเลิก</a>
  </div>
</form>

<script>
  (function () {
    const input = document.getElementById('productImagesInput');
    const preview = document.getElementById('newImagePreview');
    if (!input || !preview) return;
    input.addEventListener('change', function () {
      preview.innerHTML = '';
      const files = Array.from(input.files || []);
      preview.classList.toggle('hidden', files.length === 0);
      files.forEach(function (file, index) {
        const item = document.createElement('div');
        item.className = 'relative rounded-lg overflow-hidden border border-[var(--border-light)] bg-[var(--card)]';
        const image = document.createElement('img');
        image.className = 'w-full aspect-[4/3] object-contain';
        image.alt = 'รูปใหม่ ' + (index + 1);
        image.src = URL.createObjectURL(file);
        image.onload = function () { URL.revokeObjectURL(image.src); };
        const name = document.createElement('div');
        name.className = 'text-[10px] text-[var(--text-3)] truncate px-2 py-1.5';
        name.textContent = file.name;
        item.appendChild(image);
        item.appendChild(name);
        preview.appendChild(item);
      });
    });
  })();
</script>
