<!-- Topup & Payment Management -->
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-[var(--text-4)] mb-1">
        <a href="/admin" class="text-[var(--gold)] hover:underline font-semibold">แอดมิน</a>
        <span>/</span>
        <span>การเงิน</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)] flex items-center gap-2">
        <span>💰 จัดการเติมเงิน, บัญชีรับเงิน & ตรวจสลิป</span>
      </h1>
      <p class="text-xs text-[var(--text-4)] mt-0.5">รวมศูนย์ระบบการเงิน: รายการตรวจสอบสลิป, บัญชีธนาคาร/พร้อมเพย์, ซองของขวัญ TrueMoney และระบบตรวจสลิปอัตโนมัติ</p>
    </div>

    <div class="flex items-center gap-2.5">
      <% const pendingCount = requests.filter(r => r.status === 'pending').length; %>
      <% if (pendingCount > 0) { %>
        <div class="bg-amber-500/15 border border-amber-500/30 text-amber-400 px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 animate-pulse">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>รอตรวจสอบ <%= pendingCount %> รายการ</span>
        </div>
      <% } else { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>ไม่มีรายการค้างตรวจ</span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Subsystem Navigation Tabs -->
  <div class="flex border-b border-[var(--border)] gap-2 overflow-x-auto pb-px">
    <button type="button" onclick="switchTopupTab('requests')" id="topup-tab-btn-requests" class="topup-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-bold text-sm transition border-[var(--gold)] text-[var(--gold)] bg-[var(--gold)]/5 rounded-t-xl">
      <span class="text-base">📋</span>
      <span>รายการเติมเงิน & สลิป</span>
      <% if (pendingCount > 0) { %>
        <span class="text-[10px] bg-[var(--gold)] text-[var(--bg)] font-bold px-1.5 py-0.2 rounded-full"><%= pendingCount %></span>
      <% } %>
    </button>
    <button type="button" onclick="switchTopupTab('bank')" id="topup-tab-btn-bank" class="topup-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-semibold text-sm transition border-transparent text-[var(--text-3)] hover:text-[var(--text)] rounded-t-xl">
      <span class="text-base">💳</span>
      <span>พร้อมเพย์ & บัญชีธนาคาร</span>
    </button>
    <button type="button" onclick="switchTopupTab('truemoney')" id="topup-tab-btn-truemoney" class="topup-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-semibold text-sm transition border-transparent text-[var(--text-3)] hover:text-[var(--text)] rounded-t-xl">
      <span class="text-base">🧧</span>
      <span>ซองของขวัญ TrueMoney</span>
      <% if (payment.truemoneyEnabled !== false && payment.truemoneyPhone) { %>
        <span class="text-[10px] bg-emerald-500/20 text-emerald-400 font-bold px-1.5 py-0.5 rounded">เปิด</span>
      <% } %>
    </button>
    <button type="button" onclick="switchTopupTab('autoverify')" id="topup-tab-btn-autoverify" class="topup-tab-btn flex items-center gap-2 px-5 py-3 border-b-2 font-semibold text-sm transition border-transparent text-[var(--text-3)] hover:text-[var(--text)] rounded-t-xl">
      <span class="text-base">🤖</span>
      <span><%= isMainSite ? 'ตรวจสลิปอัตโนมัติ & แจ้งเตือน' : 'แจ้งเตือนการเติมเงิน' %></span>
    </button>
  </div>

  <!-- ========================================== -->
  <!-- TAB 1: รายการเติมเงิน & ตรวจสลิป (Requests) -->
  <!-- ========================================== -->
  <div id="topup-tab-content-requests" class="topup-tab-content space-y-6">

    <!-- Search & Filter Bar -->
    <form method="get" action="/admin/topups" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-4)] text-sm">⌕</span>
        <input name="q" value="<%= q %>" autocomplete="off" placeholder="ค้นหาชื่อผู้ใช้ อีเมล หรือรหัสอ้างอิง..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl pl-9 pr-3 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>

      <select name="status" class="bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition">
        <option value="">ทุกสถานะ</option>
        <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>🕐 รอตรวจสอบ</option>
        <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>✓ อนุมัติแล้ว</option>
        <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>✕ ปฏิเสธ</option>
      </select>

      <button type="submit" class="bg-[var(--gold)] text-[var(--bg)] font-bold rounded-xl px-5 py-2 text-xs shadow-md transition active:scale-95">
        ค้นหา
      </button>

      <% if (q || status) { %>
        <a href="/admin/topups" class="border border-[var(--border-light)] rounded-xl px-4 py-2 text-xs text-center hover:border-[var(--gold)] transition flex items-center justify-center">
          ล้างตัวกรอง
        </a>
      <% } %>
    </form>

    <%
      const pendingRequests = requests.filter(r => r.status === 'pending' || r.status === 'verifying');
      const historyRequests = requests.filter(r => r.status !== 'pending' && r.status !== 'verifying');
    %>

    <!-- Pending Approvals Section -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h2 class="font-bold text-sm sm:text-base text-[var(--text)]">🕐 รายการรอตรวจสอบ / รอดำเนินการ</h2>
          <span class="bg-[var(--gold)] text-[var(--bg)] text-[11px] font-bold rounded-full px-2 py-0.5"><%= pendingRequests.length %></span>
        </div>
      </div>

      <% if (pendingRequests.length) { %>
        <div class="space-y-3">
          <% pendingRequests.forEach(r => { %>
            <div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">

              <!-- Slip Preview & Info -->
              <div class="flex items-start gap-4">
                <% if (r.slipPath) { %>
                  <a href="<%= r.slipPath %>" target="_blank" rel="noopener" class="group relative shrink-0">
                    <img src="<%= r.slipPath %>" class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-xl border border-[var(--border)] shadow-sm group-hover:brightness-110 transition" alt="สลิปโอนเงิน" />
                    <span class="absolute bottom-1 right-1 bg-black/70 text-[9px] text-white px-1 rounded backdrop-blur-xs">🔍 ขยาย</span>
                  </a>
                <% } else { %>
                  <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-xl border border-[var(--border)] bg-[var(--input)] flex flex-col items-center justify-center text-[10px] text-[var(--text-4)] text-center p-2">
                    <span class="text-base mb-1">📄</span>
                    <span>ยังไม่แนบสลิป</span>
                  </div>
                <% } %>

                <div class="text-xs space-y-1">
                  <div class="font-bold text-sm text-[var(--text)]">
                    <%= r.buyer ? r.buyer.username : 'ไม่พบชื่อผู้ใช้' %>
                    <span class="text-[11px] font-normal text-[var(--text-4)]">(<%= r.buyer ? r.buyer.email : '-' %>)</span>
                  </div>
                  <div class="text-[var(--text-3)] font-mono text-[11px]">
                    รหัส: <b>#<%= r.refCode %></b> &middot; ช่องทาง:
                    <% if (r.method === 'truemoney_angpao') { %>
                      <span class="text-amber-400 font-semibold">🧧 ซอง TrueMoney</span>
                    <% } else if (r.method === 'promptpay') { %>
                      <span class="text-blue-400 font-semibold">💳 พร้อมเพย์</span>
                    <% } else { %>
                      <span class="text-emerald-400 font-semibold">🏦 โอนธนาคาร</span>
                    <% } %>
                  </div>
                  <div class="text-[var(--text-4)] text-[11px]">
                    เวลาแจ้ง: <%= new Date(r.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
                  </div>
                  <% if (r.slipCheck && r.slipCheck.message) { %>
                    <div class="inline-block bg-[var(--input)] border border-[var(--border-light)] text-[11px] text-[var(--text-3)] px-2.5 py-1 rounded-lg mt-1">
                      🤖 ผลตรวจอัตโนมัติ: <%= r.slipCheck.message %>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Amount & Action Buttons -->
              <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-3 border-t sm:border-t-0 pt-3 sm:pt-0 border-[var(--border)]">
                <div class="text-2xl font-black text-[var(--gold)] tracking-tight">
                  ฿<%= Number(r.amount || 0).toLocaleString() %>.00
                </div>

                <div class="flex items-center gap-2">
                  <!-- Approve Form -->
                  <form action="/admin/topups/<%= r.id %>/approve" method="post" data-confirm="ยืนยันว่าตรวจสอบสลิปแล้ว ยอดเงิน ฿<%= r.amount %> ถูกต้อง และต้องการเติมเงินเข้ากระเป๋าผู้ใช้ทันทีใช่ไหม?">
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl px-4 py-2 text-xs shadow-md transition active:scale-95 whitespace-nowrap">
                      ✓ อนุมัติและเติมเงิน
                    </button>
                  </form>

                  <!-- Reject Form -->
                  <form action="/admin/topups/<%= r.id %>/reject" method="post" data-confirm="ยืนยันปฏิเสธคำขอเติมเงินนี้?">
                    <button type="submit" class="border border-rose-500/40 text-rose-400 hover:bg-rose-500/10 font-semibold rounded-xl px-3 py-2 text-xs transition active:scale-95 whitespace-nowrap">
                      ✕ ปฏิเสธ
                    </button>
                  </form>
                </div>
              </div>

            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-[var(--card)] border border-dashed border-[var(--border-light)] rounded-2xl py-8 text-center text-xs text-[var(--text-4)]">
          <div class="text-2xl mb-1">🎉</div>
          ไม่มีรายการเติมเงินที่รอตรวจสอบในขณะนี้
        </div>
      <% } %>
    </div>

    <!-- History Section -->
    <div class="space-y-3 pt-4 border-t border-[var(--border)]">
      <h2 class="font-bold text-sm sm:text-base text-[var(--text)]">📜 ประวัติการเติมเงิน (<%= historyRequests.length %>)</h2>

      <% if (historyRequests.length) { %>
        <div class="space-y-2.5">
          <% historyRequests.forEach(r => { %>
            <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm hover:border-[var(--border-light)] transition">

              <div class="flex items-center gap-3.5">
                <% if (r.slipPath) { %>
                  <a href="<%= r.slipPath %>" target="_blank" rel="noopener">
                    <img src="<%= r.slipPath %>" class="w-12 h-12 object-cover rounded-xl border border-[var(--border)]" alt="สลิป" />
                  </a>
                <% } else { %>
                  <div class="w-12 h-12 shrink-0 rounded-xl border border-[var(--border)] bg-[var(--input)] flex items-center justify-center text-xs text-[var(--text-4)]">
                    📄
                  </div>
                <% } %>

                <div class="text-xs">
                  <div class="font-semibold text-sm text-[var(--text)]">
                    <%= r.buyer ? r.buyer.username : 'ไม่พบผู้ใช้' %>
                  </div>
                  <div class="text-[var(--text-3)] font-mono text-[11px]">
                    #<%= r.refCode %> &middot; <%= r.method === 'truemoney_angpao' ? 'ซอง TrueMoney' : (r.method === 'promptpay' ? 'พร้อมเพย์' : 'โอนธนาคาร') %>
                  </div>
                  <div class="text-[var(--text-4)] text-[10px]">
                    <%= new Date(r.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between sm:justify-end gap-4 border-t sm:border-t-0 pt-2 sm:pt-0 border-[var(--border)]">
                <div class="text-lg font-bold text-[var(--gold)]">
                  ฿<%= Number(r.amount || 0).toLocaleString() %>.00
                </div>

                <% if (r.status === 'approved') { %>
                  <span class="inline-flex items-center gap-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-semibold px-3 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>อนุมัติแล้ว</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] font-semibold px-3 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                    <span>ปฏิเสธ</span>
                  </span>
                <% } %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-[var(--card)] border border-dashed border-[var(--border-light)] rounded-2xl py-10 text-center text-xs text-[var(--text-4)]">
          ไม่พบประวัติการเติมเงินที่ตรงกับคำค้นหา
        </div>
      <% } %>
    </div>

  </div>

  <!-- ========================================== -->
  <!-- TAB 2: พร้อมเพย์ & บัญชีธนาคาร (Bank & QR)  -->
  <!-- ========================================== -->
  <div id="topup-tab-content-bank" class="topup-tab-content hidden space-y-6">
    <form action="/admin/topups/payment-settings" method="post" enctype="multipart/form-data" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6 shadow-sm space-y-6">

      <!-- Preserve Other Tab Settings as Hidden Inputs -->
      <input type="hidden" name="truemoneyPhone" value="<%= payment.truemoneyPhone || '' %>" />
      <input type="hidden" name="truemoneyEnabled" value="<%= payment.truemoneyEnabled !== false ? 'on' : 'off' %>" />
      <input type="hidden" name="topupWebhookUrl" value="<%= payment.topupWebhookUrl || '' %>" />

      <div class="flex items-center gap-3 pb-4 border-b border-[var(--border)]">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-lg">
          💳
        </div>
        <div>
          <h2 class="text-base font-bold text-[var(--text)]">ตั้งค่าบัญชีพร้อมเพย์ (PromptPay) & บัญชีธนาคาร</h2>
          <p class="text-xs text-[var(--text-4)]">ข้อมูลและ QR Code นี้จะแสดงให้ลูกค้าสแกน/โอนเงินในหน้าเติมเงินของเว็บไซต์</p>
        </div>
      </div>

      <!-- Section 1: PromptPay -->
      <div class="bg-[var(--input)]/40 border border-[var(--border-light)] rounded-2xl p-5 space-y-4">
        <h3 class="font-bold text-sm text-[var(--text)] flex items-center gap-2">
          <span>🔵 ช่องทาง พร้อมเพย์ (PromptPay)</span>
        </h3>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">เบอร์โทรศัพท์ หรือ เลขประจำตัวประชาชนพร้อมเพย์</label>
            <input name="promptpayId" value="<%= payment.promptpayId %>" placeholder="เช่น 0812345678 หรือ 1234567890123" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2.5 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">ชื่อบัญชีพร้อมเพย์</label>
            <input name="promptpayName" value="<%= payment.promptpayName %>" placeholder="เช่น นาย สมชาย ใจดี" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2.5 text-xs outline-none focus:border-[var(--gold)] transition" />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-xs mb-1 text-[var(--text)]">รูปภาพ QR Code พร้อมเพย์ (ทางเลือก)</label>
          <p class="text-[11px] text-[var(--text-4)] mb-2">หากไม่แนบรูป ระบบจะคำนวณและสร้าง QR Code พร้อมเพย์จากเบอร์ให้อัตโนมัติ</p>

          <% if (payment.promptpayQrImage) { %>
            <div class="flex items-center gap-3 mb-3 bg-[var(--card)] p-2.5 rounded-xl border border-[var(--border)] max-w-sm">
              <img src="<%= payment.promptpayQrImage %>" class="w-20 h-20 object-contain rounded-lg bg-white p-1" alt="QR พร้อมเพย์" />
              <label class="flex items-center gap-2 text-xs text-rose-400 cursor-pointer">
                <input type="checkbox" name="removePromptpayQrImage" class="accent-rose-500" /> ลบรูปปัจจุบัน
              </label>
            </div>
          <% } %>
          <input type="file" name="promptpayQrImage" accept="image/*" class="w-full text-xs text-[var(--text-3)] file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:bg-[var(--card)] file:text-[var(--gold)] file:font-semibold file:text-xs" />
        </div>
      </div>

      <!-- Section 2: Bank Transfer -->
      <%
        const promptpayBank = banks.find(b => /พร้อมเพย์|promptpay/i.test(`${b.nameTh} ${b.nameEn}`));
        const otherBanks = banks.filter(b => !promptpayBank || b.code !== promptpayBank.code);
        const primaryBank = banks.find(b => b.nameTh === payment.bankName);
      %>
      <div class="bg-[var(--input)]/40 border border-[var(--border-light)] rounded-2xl p-5 space-y-4">
        <h3 class="font-bold text-sm text-[var(--text)] flex items-center gap-2">
          <span>🏦 ช่องทาง โอนผ่านบัญชีธนาคาร</span>
        </h3>

        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">เลือกธนาคารรับเงิน</label>
            <% if (otherBanks.length) { %>
              <select name="easyslipBankCode" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2.5 text-xs outline-none focus:border-[var(--gold)] transition">
                <option value="">-- เลือกธนาคาร --</option>
                <% otherBanks.forEach(bank => { %>
                  <option value="<%= bank.code %>" <%= primaryBank && primaryBank.code === bank.code ? 'selected' : '' %>><%= bank.nameTh %></option>
                <% }) %>
              </select>
            <% } else { %>
              <p class="text-[11px] text-[var(--text-4)]">ยังโหลดรายชื่อธนาคารไม่ได้</p>
            <% } %>
          </div>

          <div>
            <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">เลขที่บัญชีธนาคาร</label>
            <input name="bankAccountNumber" value="<%= payment.bankAccountNumber %>" placeholder="เช่น 123-4-56789-0" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2.5 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
          </div>

          <div>
            <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">ชื่อบัญชีธนาคาร</label>
            <input name="bankAccountName" value="<%= payment.bankAccountName %>" placeholder="เช่น นาย สมชาย ใจดี" class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-3.5 py-2.5 text-xs outline-none focus:border-[var(--gold)] transition" />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-xs mb-1 text-[var(--text)]">รูปภาพ QR Code บัญชีธนาคาร (ทางเลือก)</label>
          <p class="text-[11px] text-[var(--text-4)] mb-2">ใช้แสดงเมื่อลูกค้าเลือกชำระผ่านช่องทางบัญชีธนาคาร</p>

          <% if (payment.bankQrImage) { %>
            <div class="flex items-center gap-3 mb-3 bg-[var(--card)] p-2.5 rounded-xl border border-[var(--border)] max-w-sm">
              <img src="<%= payment.bankQrImage %>" class="w-20 h-20 object-contain rounded-lg bg-white p-1" alt="QR ธนาคาร" />
              <label class="flex items-center gap-2 text-xs text-rose-400 cursor-pointer">
