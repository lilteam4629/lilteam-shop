      <% } %>

      <!-- Discord Webhook Box -->
      <div class="bg-[var(--input)]/40 border border-[var(--border-light)] rounded-2xl p-5 space-y-4">
        <h3 class="font-bold text-sm text-[var(--text)] flex items-center gap-2">
          <span>🔔 Discord Webhook แจ้งเตือนการเติมเงิน</span>
        </h3>
        <p class="text-xs text-[var(--text-4)]">
          วาง Webhook URL ของห้อง Discord ที่ต้องการรับการแจ้งเตือนเมื่อมีลูกค้าแจ้งโอนเงินหรือเติมเงินสำเร็จ
        </p>

        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-[var(--text-3)]">Discord Webhook URL</label>
          <input type="url" name="topupWebhookUrl" value="<%= payment.topupWebhookUrl || '' %>" placeholder="https://discord.com/api/webhooks/..." class="w-full bg-[var(--card)] border border-[var(--border-light)] rounded-xl px-4 py-2.5 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-6 py-2.5 rounded-xl text-xs shadow-md transition active:scale-95">
          💾 บันทึกการตั้งค่าการแจ้งเตือน
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  function switchTopupTab(tabId) {
    document.querySelectorAll('.topup-tab-btn').forEach(btn => {
      btn.classList.remove('border-[var(--gold)]', 'text-[var(--gold)]', 'bg-[var(--gold)]/5', 'font-bold');
      btn.classList.add('border-transparent', 'text-[var(--text-3)]', 'font-semibold');
    });
    document.querySelectorAll('.topup-tab-content').forEach(content => {
      content.classList.add('hidden');
    });

    const activeBtn = document.getElementById('topup-tab-btn-' + tabId);
    const activeContent = document.getElementById('topup-tab-content-' + tabId);

    if (activeBtn) {
      activeBtn.classList.remove('border-transparent', 'text-[var(--text-3)]', 'font-semibold');
      activeBtn.classList.add('border-[var(--gold)]', 'text-[var(--gold)]', 'bg-[var(--gold)]/5', 'font-bold');
    }
    if (activeContent) {
      activeContent.classList.remove('hidden');
    }

    if (window.location.hash !== '#' + tabId) {
      history.replaceState(null, '', '#' + tabId);
    }
  }

  function switchSlipProviderUI(providerKey) {
    document.querySelectorAll('.provider-config-box').forEach(box => box.classList.add('hidden'));
    const targetBox = document.getElementById('provider-box-' + providerKey);
    if (targetBox) targetBox.classList.remove('hidden');
  }

  async function testByshopSlipConnection() {
    const keyInput = document.getElementById('byshop_slip_api_key');
    const statusMsg = document.getElementById('byshop-slip-status-msg');
    const spinner = document.getElementById('test-slip-spinner');
    const btn = document.getElementById('btn-test-slip');
    const apiKey = keyInput ? keyInput.value.trim() : '';

    if (!apiKey) {
      alert('กรุณากรอก BYSHOP API Key ก่อนทำการทดสอบ');
      if (keyInput) keyInput.focus();
      return;
    }

    spinner.classList.remove('hidden');
    btn.disabled = true;
    statusMsg.innerHTML = '<span class="text-xs text-[var(--gold)] font-medium">กำลังทดสอบเชื่อมต่อ BYSHOP API...</span>';

    try {
      const res = await fetch('/admin/slip-verification/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ provider: 'byshop', apiKey: apiKey })
      });
      const data = await res.json();
      if (data.ok) {
        statusMsg.innerHTML = `<span class="text-xs text-emerald-400 font-bold">✓ ${data.message || 'เชื่อมต่อสำเร็จ'} (ยอดคงเหลือ ฿${Number(data.balance || 0).toLocaleString()})</span>`;
      } else {
        statusMsg.innerHTML = `<span class="text-xs text-rose-400 font-bold">✗ ${data.message || 'เชื่อมต่อล้มเหลว'}</span>`;
      }
    } catch (e) {
      statusMsg.innerHTML = '<span class="text-xs text-rose-400 font-bold">✗ เกิดข้อผิดพลาดในการเชื่อมต่อ</span>';
    } finally {
      spinner.classList.add('hidden');
      btn.disabled = false;
    }
  }

  // Restore active tab from URL hash if present
  (function () {
    const hash = (window.location.hash || '').replace('#', '');
    if (hash && document.getElementById('topup-tab-content-' + hash)) {
      switchTopupTab(hash);
    }
  })();
</script>
