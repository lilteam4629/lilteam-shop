<details class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 mb-6 max-w-xl" open>
  <summary class="font-semibold cursor-pointer">ข้อมูลบัญชีรับเงิน</summary>
  <form action="/admin/topups/payment-settings" method="post" enctype="multipart/form-data" class="space-y-4 mt-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-[var(--input)]/45 border border-[var(--border-light)] rounded-xl p-4">
        <label class="block font-medium mb-1">QR พร้อมเพย์</label>
        <p class="text-xs text-[var(--text-4)] mb-3">ถ้าไม่แนบ ระบบจะสร้าง QR จากหมายเลขพร้อมเพย์ให้อัตโนมัติ</p>
      <% if (payment.promptpayQrImage) { %>
        <div class="flex items-center gap-3 mb-2">
          <img src="<%= payment.promptpayQrImage %>" class="w-28 h-28 object-contain rounded-lg bg-white" alt="QR พร้อมเพย์ปัจจุบัน" />
          <label class="flex items-center gap-2 text-sm text-[var(--text-3)]">
            <input type="checkbox" name="removePromptpayQrImage" class="accent-[var(--gold)]" /> ลบรูปนี้
          </label>
        </div>
      <% } %>
        <input type="file" name="promptpayQrImage" accept="image/*" class="w-full text-xs text-[var(--text-3)] file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold)] file:text-xs" />
      </div>
      <div class="bg-[var(--input)]/45 border border-[var(--border-light)] rounded-xl p-4">
        <label class="block font-medium mb-1">QR โอนธนาคาร</label>
        <p class="text-xs text-[var(--text-4)] mb-3">ใช้เฉพาะเมื่อลูกค้าเลือกช่องทางโอนผ่านธนาคาร</p>
      <% if (payment.bankQrImage) { %>
        <div class="flex items-center gap-3 mb-2">
          <img src="<%= payment.bankQrImage %>" class="w-28 h-28 object-contain rounded-lg bg-white" alt="QR ธนาคารปัจจุบัน" />
          <label class="flex items-center gap-2 text-sm text-[var(--text-3)]">
            <input type="checkbox" name="removeBankQrImage" class="accent-[var(--gold)]" /> ลบรูปนี้
          </label>
        </div>
      <% } %>
        <input type="file" name="bankQrImage" accept="image/*" class="w-full text-xs text-[var(--text-3)] file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold)] file:text-xs" />
      </div>
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">เบอร์/เลขพร้อมเพย์</label>
      <input name="promptpayId" value="<%= payment.promptpayId %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อบัญชีพร้อมเพย์</label>
      <input name="promptpayName" value="<%= payment.promptpayName %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <%
      const promptpayBank = banks.find(b => /พร้อมเพย์|promptpay/i.test(`${b.nameTh} ${b.nameEn}`));
      const otherBanks = banks.filter(b => !promptpayBank || b.code !== promptpayBank.code);
      const primaryBank = banks.find(b => b.nameTh === payment.bankName);
      const promptpayConnected = payment.easyslipAccounts && promptpayBank && payment.easyslipAccounts[promptpayBank.code];
    %>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ธนาคาร</label>
      <% if (otherBanks.length) { %>
        <select name="easyslipBankCode" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2">
          <option value="">-- เลือกธนาคาร --</option>
          <% otherBanks.forEach(bank => { %>
            <option value="<%= bank.code %>" <%= primaryBank && primaryBank.code === bank.code ? 'selected' : '' %>><%= bank.nameTh %></option>
          <% }) %>
        </select>
      <% } else { %>
        <p class="text-[10px] text-[var(--text-4)]">ยังโหลดรายชื่อธนาคารไม่ได้ กรุณาลองใหม่ภายหลัง</p>
      <% } %>
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">เลขบัญชีธนาคาร</label>
      <input name="bankAccountNumber" value="<%= payment.bankAccountNumber %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อบัญชีธนาคาร</label>
      <input name="bankAccountName" value="<%= payment.bankAccountName %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <% if (promptpayBank) { %>
      <div class="bg-[var(--input)]/45 border border-[var(--border-light)] rounded-xl p-3">
        <label class="flex items-center gap-2 text-sm cursor-pointer">
          <input type="checkbox" name="registerPromptpay" id="registerPromptpay" <%= promptpayConnected ? 'checked' : '' %> onchange="document.getElementById('promptpayNumberField').classList.toggle('hidden', !this.checked)" class="accent-[var(--gold)]" />
          เชื่อมต่อพร้อมเพย์ด้วย <span class="text-[var(--text-4)]">(กันสลิปโอนข้ามธนาคารผ่านพร้อมเพย์ตรวจไม่ผ่าน)</span>
        </label>
        <div id="promptpayNumberField" class="mt-2 <%= promptpayConnected ? '' : 'hidden' %>">
          <input name="promptpayEasyslipNumber" value="<%= promptpayConnected ? payment.easyslipAccounts[promptpayBank.code].bankNumber : payment.promptpayId %>" placeholder="เลขพร้อมเพย์ เช่น 0812345678" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>
    <% } %>
    <% if (payment.easyslipStatus) { %>
      <p class="text-xs <%= payment.easyslipStatus.includes('ไม่สำเร็จ') ? 'text-[var(--coral)]' : 'text-emerald-400' %>">สถานะเชื่อมต่อ EasySlip ล่าสุด: <%= payment.easyslipStatus %></p>
    <% } %>

    <div class="bg-[var(--input)]/45 border border-[var(--border-light)] rounded-xl p-4">
      <label class="block font-medium mb-1">🔔 Webhook แจ้งเตือนเติมเงิน (ไม่บังคับ)</label>
      <p class="text-xs text-[var(--text-4)] mb-3">วาง Discord Webhook URL ของร้านคุณเอง (ไม่แชร์กับร้านอื่น) — ทุกครั้งที่มีคนแนบสลิปเติมเงิน จะแจ้งเข้าห้อง Discord ทันที พร้อมชื่อผู้ใช้ ยอดเงิน และรูปสลิป<br />วิธีสร้าง: ตั้งค่าห้อง (⚙️) → Integrations → Webhooks → New Webhook → Copy Webhook URL</p>
      <input type="url" name="topupWebhookUrl" value="<%= payment.topupWebhookUrl || '' %>" placeholder="https://discord.com/api/webhooks/..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm font-mono" />
    </div>

    <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-6 py-2 rounded-lg text-sm">บันทึกข้อมูลบัญชี</button>
  </form>
</details>

<form method="get" action="/admin/topups" class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-3 mb-4 flex flex-col sm:flex-row gap-2">
  <div class="relative flex-1">
    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-4)]">⌕</span>
    <input name="q" value="<%= q %>" autocomplete="off" placeholder="ค้นหาชื่อผู้ใช้ อีเมล หรือเลขอ้างอิง" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg pl-9 pr-3 py-2 text-sm focus:border-[var(--gold)] outline-none" />
  </div>
  <select name="status" class="bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm">
    <option value="">ทุกสถานะ</option>
    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>รอตรวจสอบ</option>
    <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>อนุมัติแล้ว</option>
    <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>ปฏิเสธ</option>
  </select>
  <button class="bg-[var(--gold)] text-[var(--bg)] font-medium rounded-lg px-5 py-2 text-sm">ค้นหาประวัติ</button>
  <% if (q || status) { %><a href="/admin/topups" class="border border-[var(--border-light)] rounded-lg px-4 py-2 text-sm text-center hover:border-[var(--gold)]">ล้าง</a><% } %>
</form>

<%
  const pendingRequests = requests.filter(r => r.status === 'pending');
  const historyRequests = requests.filter(r => r.status !== 'pending');
%>

<h2 class="font-semibold mb-3">🕐 รอตรวจสอบ / มีปัญหา (<%= pendingRequests.length %>)</h2>
<div class="space-y-3 mb-8">
  <% pendingRequests.forEach(r => { %>
    <div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-4">
      <% if (r.slipPath) { %>
        <a href="<%= r.slipPath %>" target="_blank" rel="noopener">
          <img src="<%= r.slipPath %>" class="w-20 h-20 object-cover rounded-lg border border-[var(--border)]" alt="สลิป" />
        </a>
      <% } else { %>
        <div class="w-20 h-20 shrink-0 rounded-lg border border-[var(--border)] bg-[var(--input)] flex items-center justify-center text-[10px] text-[var(--text-4)] text-center px-1">ยังไม่แนบสลิป</div>
      <% } %>

      <div class="flex-1 text-sm">
        <div class="font-medium"><%= r.buyer ? r.buyer.username : 'ไม่พบผู้ใช้' %> <span class="text-[var(--text-4)] font-normal">(<%= r.buyer ? r.buyer.email : '-' %>)</span></div>
        <div class="text-[var(--text-3)] font-mono text-xs">#<%= r.refCode %> &middot; <%= r.method === 'promptpay' ? 'พร้อมเพย์' : 'โอนธนาคาร' %></div>
        <div class="text-[var(--text-4)] text-xs"><%= new Date(r.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></div>
        <% if (r.slipCheck && r.slipCheck.message) { %>
          <div class="text-[var(--text-4)] text-xs mt-1">📋 <%= r.slipCheck.message %></div>
        <% } %>
      </div>

      <div class="text-xl font-bold text-[var(--gold)] sm:w-28 sm:text-right">฿<%= r.amount.toLocaleString() %>.00</div>

      <div class="flex sm:flex-col gap-2 shrink-0">
        <form action="/admin/topups/<%= r.id %>/approve" method="post" onsubmit="return confirm('ยืนยันว่าตรวจสลิปแล้ว ยอด ฿' + <%= r.amount %> + ' ถูกต้อง และต้องการเติมเงินให้เลยใช่ไหม?')">
          <button class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg px-4 py-2 text-xs whitespace-nowrap">✓ ตรวจแล้ว เติมเงินให้เลย</button>
        </form>
        <form action="/admin/topups/<%= r.id %>/reject" method="post" onsubmit="return confirm('ยืนยันปฏิเสธคำขอนี้?')">
          <button class="w-full border border-[var(--coral)]/50 text-[var(--coral)] hover:bg-[var(--coral)]/10 font-medium rounded-lg px-4 py-2 text-xs whitespace-nowrap">✕ ปฏิเสธ</button>
        </form>
      </div>
    </div>
  <% }) %>
  <% if (!pendingRequests.length) { %>
    <div class="bg-[var(--card)] border border-dashed border-[var(--border-light)] rounded-xl py-8 text-center text-sm text-[var(--text-4)]">ไม่มีรายการรอตรวจสอบ 🎉</div>
  <% } %>
</div>

<h2 class="font-semibold mb-3">📜 ประวัติ (<%= historyRequests.length %>)</h2>
<div class="space-y-3">
  <% historyRequests.forEach(r => { %>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-4">
      <% if (r.slipPath) { %>
        <a href="<%= r.slipPath %>" target="_blank" rel="noopener">
          <img src="<%= r.slipPath %>" class="w-20 h-20 object-cover rounded-lg border border-[var(--border)]" alt="สลิป" />
        </a>
      <% } else { %>
        <div class="w-20 h-20 shrink-0 rounded-lg border border-[var(--border)] bg-[var(--input)] flex items-center justify-center text-[10px] text-[var(--text-4)] text-center px-1">ยังไม่แนบสลิป</div>
      <% } %>

      <div class="flex-1 text-sm">
        <div class="font-medium"><%= r.buyer ? r.buyer.username : 'ไม่พบผู้ใช้' %> <span class="text-[var(--text-4)] font-normal">(<%= r.buyer ? r.buyer.email : '-' %>)</span></div>
        <div class="text-[var(--text-3)] font-mono text-xs">#<%= r.refCode %> &middot; <%= r.method === 'promptpay' ? 'พร้อมเพย์' : 'โอนธนาคาร' %></div>
        <div class="text-[var(--text-4)] text-xs"><%= new Date(r.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></div>
      </div>

      <div class="text-xl font-bold text-[var(--gold)] sm:w-32 sm:text-right">฿<%= r.amount.toLocaleString() %>.00</div>

      <% if (r.status === 'approved') { %>
        <span class="shrink-0 text-xs bg-emerald-900/40 text-emerald-400 px-3 py-1.5 rounded-full text-center">อนุมัติแล้ว</span>
      <% } else { %>
        <span class="shrink-0 text-xs bg-[var(--coral)]/15 text-[var(--coral)] px-3 py-1.5 rounded-full text-center">ปฏิเสธ</span>
      <% } %>
    </div>
  <% }) %>
  <% if (!historyRequests.length) { %>
    <div class="bg-[var(--card)] border border-dashed border-[var(--border-light)] rounded-xl py-12 text-center text-sm text-[var(--text-4)]">ไม่พบประวัติการเติมเงินที่ค้นหา</div>
  <% } %>
</div>
