<link rel="stylesheet" href="<%= asset('css/admin-experiment-orders-v1.css') %>" />
<% const completed = orders.filter(order => order.status === 'completed'); const pending = orders.filter(order => order.status === 'pending'); const cancelled = orders.filter(order => order.status === 'cancelled'); const revenue = orders.filter(order => order.status !== 'cancelled').reduce((sum, order) => sum + Number(order.total || 0), 0); %>
<div class="experiment-app experiment-orders-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า"><div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู">‹</button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><span>▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products"><span>◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><span>◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><span>◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><span>☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item active" href="/admin/orders"><span>▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span>▭</span><span>เติมเงิน & ตรวจสอบ</span></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span>⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main"><header class="experiment-topbar"><button class="experiment-icon-button" type="button" data-orders-notifications aria-label="ดูการแจ้งเตือน">◌</button><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header><main class="experiment-content">
    <section class="orders-page">
      <div class="experiment-page-head"><div><div class="experiment-kicker">การสั่งซื้อ</div><h1>คำสั่งซื้อ</h1><p>ติดตามยอดขาย ลูกค้า รายการสินค้า และสถานะการจัดส่งจากหน้าเดียว</p></div><div class="orders-actions"><a class="experiment-button" href="/admin">← กลับแดชบอร์ด</a><a class="experiment-button primary" href="/admin/orders">รีเฟรชข้อมูล ↻</a></div></div>
      <section class="orders-build-status" aria-labelledby="orders-build-status-title"><div class="orders-build-status-head"><div><span class="orders-build-kicker">BUILD STATUS</span><h2 id="orders-build-status-title">หน้านี้ทำอะไรได้แล้ว และเหลืออะไร</h2><p>รายการด้านล่างทำไว้เพื่อให้ไล่ตรวจและแก้ทีละจุดได้ทันที</p></div><span class="orders-build-progress"><b>3</b>/6 จุดพร้อมใช้</span></div><div class="orders-build-grid"><div class="orders-build-column ready"><h3><i>✓</i> ทำแล้ว · ใช้ข้อมูลจริง</h3><ul><li><span>ค้นหาและกรองคำสั่งซื้อ</span><em>พร้อมใช้</em></li><li><span>กรองทั้งหมด / รอ / สำเร็จ / ยกเลิก</span><em>พร้อมใช้</em></li><li><span>เปิดรายละเอียดและเปลี่ยนสถานะ</span><em>พร้อมใช้</em></li></ul></div><div class="orders-build-column pending"><h3><i>＋</i> เหลือทำ · มีตัวอย่างให้ดู</h3><ul><li><span>ส่งออก CSV / Excel</span><button type="button" data-orders-roadmap-demo data-demo-title="ส่งออก CSV / Excel">ดูตัวอย่าง</button></li><li><span>พิมพ์ใบเสร็จ / ใบส่งสินค้า</span><button type="button" data-orders-roadmap-demo data-demo-title="พิมพ์ใบเสร็จ / ใบส่งสินค้า">ดูตัวอย่าง</button></li><li><span>จัดการหลายรายการ / คืนเงิน</span><button type="button" data-orders-roadmap-demo data-demo-title="จัดการหลายรายการ / คืนเงิน">ดูตัวอย่าง</button></li></ul></div></div><div class="orders-build-foot"><span>ระบบเก่ายังอยู่ที่ URL เดิมและไม่ได้ถูกลบ</span><button type="button" class="orders-build-toggle" data-orders-roadmap-toggle>ซ่อนรายการนี้ ↑</button></div></section>
      <div class="orders-kpis"><div class="orders-kpi"><span class="orders-kpi-icon">฿</span><small>ยอดขายสุทธิ</small><strong>฿<%= revenue.toLocaleString('th-TH') %></strong><em>ไม่นับคำสั่งซื้อที่ยกเลิก</em><span class="orders-kpi-foot"><i></i> อัปเดตจากข้อมูลในร้าน</span></div><div class="orders-kpi"><span class="orders-kpi-icon">#</span><small>คำสั่งซื้อทั้งหมด</small><strong><%= orders.length %></strong><em>รายการในระบบ</em><span class="orders-kpi-foot"><i></i> เก็บประวัติอัตโนมัติ</span></div><div class="orders-kpi"><span class="orders-kpi-icon">◷</span><small>รอดำเนินการ</small><strong><%= pending.length %></strong><em>ต้องติดตามต่อ</em><span class="orders-kpi-foot <%= pending.length ? 'attention' : '' %>"><i></i> <%= pending.length ? 'มีรายการต้องดูแล' : 'ไม่มีรายการค้าง' %></span></div><div class="orders-kpi"><span class="orders-kpi-icon">✓</span><small>ส่งสำเร็จแล้ว</small><strong><%= completed.length %></strong><em><%= cancelled.length %> รายการถูกยกเลิก</em><span class="orders-kpi-foot"><i></i> สถานะล่าสุด</span></div></div>
      <div class="orders-workspace"><div class="orders-workspace-head"><div><h2>ศูนย์จัดการคำสั่งซื้อ</h2><p>ค้นหา ตรวจสอบ และติดตามทุกออเดอร์จากที่เดียว</p></div><span class="orders-live-badge"><i></i> ระบบพร้อมใช้งาน</span></div><div class="orders-toolbar"><input class="orders-search" type="search" placeholder="ค้นหารหัสสั่งซื้อ ผู้ซื้อ หรือชื่อสินค้า..." data-orders-search aria-label="ค้นหาคำสั่งซื้อ"><select class="orders-select" data-orders-date aria-label="ช่วงเวลา"><option value="all">ทุกช่วงเวลา</option><option value="today">วันนี้</option><option value="7">7 วันที่ผ่านมา</option><option value="30">30 วันที่ผ่านมา</option></select><span class="orders-toolbar-count"><b data-orders-visible><%= orders.length %></b> รายการ</span></div><div class="orders-tabs" role="tablist"><button class="orders-tab active" type="button" data-orders-tab="all">ทั้งหมด <b><%= orders.length %></b></button><button class="orders-tab" type="button" data-orders-tab="pending">รอดำเนินการ <b><%= pending.length %></b></button><button class="orders-tab" type="button" data-orders-tab="completed">สำเร็จ <b><%= completed.length %></b></button><button class="orders-tab" type="button" data-orders-tab="cancelled">ยกเลิก <b><%= cancelled.length %></b></button></div>
        <div class="orders-table-wrap"><table class="orders-table"><thead><tr><th>คำสั่งซื้อ</th><th>ผู้ซื้อ</th><th>สินค้า</th><th>วันที่สั่งซื้อ</th><th>ยอดรวม</th><th>สถานะ</th><th>จัดการ</th></tr></thead><tbody data-orders-body>
          <% orders.forEach(order => { const buyerName = order.buyer?.username || 'ผู้ใช้ทั่วไป'; const statusLabel = order.status === 'completed' ? 'สำเร็จ' : order.status === 'pending' ? 'รอดำเนินการ' : 'ยกเลิก'; %><tr data-order-row data-status="<%= order.status %>" data-date="<%= new Date(order.createdAt).toISOString() %>" data-search="<%= String(order.searchTerms || '').toLowerCase() %>"><td><div class="orders-id"><span class="orders-id-mark">#</span><span><strong>#<%= order.id %></strong><small><%= order.items?.length || 0 %> รายการ</small></span></div></td><td><div class="orders-buyer"><span class="orders-avatar"><%= buyerName[0].toUpperCase() %></span><span><strong><%= buyerName %></strong><small><%= order.buyer?.email || (order.salesChannel === 'catalog-api-fulfillment' ? 'Partner order' : 'ไม่ระบุอีเมล') %></small></span></div></td><td><div class="orders-items"><% (order.displayItems || []).slice(0,2).forEach(item => { %><span class="orders-item-title"><%= item.title %></span><% }); if ((order.displayItems || []).length > 2) { %><span class="orders-item-more">+<%= order.displayItems.length - 2 %> รายการ</span><% } %></div></td><td><span><%= new Date(order.createdAt).toLocaleString('th-TH',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Bangkok'}) %></span></td><td><span class="orders-total">฿<%= Number(order.total || 0).toLocaleString('th-TH') %></span></td><td><span class="orders-status <%= order.status %>"><i></i><%= statusLabel %></span></td><td><a class="orders-detail-link" href="/admin/orders/<%= order.id %>">ดูรายละเอียด <span>→</span></a></td></tr><% }); %>
          <% if (!orders.length) { %><tr><td colspan="7"><div class="orders-empty"><div class="orders-empty-visual"><svg viewBox="0 0 24 24"><path d="M5 8h14v12H5zM8 8V6a4 4 0 0 1 8 0v2M8 12h8M8 16h5"/></svg></div><span class="orders-empty-kicker">ORDER CENTER READY</span><h2>ร้านพร้อมรับคำสั่งซื้อใหม่</h2><p>เมื่อมีลูกค้าสั่งซื้อสินค้า รายการจะปรากฏที่นี่ทันที คุณสามารถค้นหาและติดตามสถานะการจัดส่งได้จากหน้านี้</p><div class="orders-empty-steps"><a href="/admin/products"><span>01</span><strong>จัดการสินค้า</strong><small>เพิ่มสินค้าและสต๊อก</small><i>→</i></a><a href="/" target="_blank" rel="noreferrer"><span>02</span><strong>ดูหน้าร้าน</strong><small>ตรวจประสบการณ์ลูกค้า</small><i>↗</i></a><div><span>03</span><strong>รับออเดอร์อัตโนมัติ</strong><small>ระบบจะแจ้งรายการให้ที่หน้านี้</small><i>✓</i></div></div><a class="experiment-button primary" href="/admin/products">ไปจัดการสินค้าต่อ →</a></div></td></tr><% } %><tr data-orders-no-results hidden><td colspan="7"><div class="orders-empty"><div class="orders-empty-visual"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4 4M8 10.5h5"/></svg></div><h2>ไม่พบคำสั่งซื้อ</h2><p>ลองเปลี่ยนคำค้นหาหรือช่วงเวลาที่เลือก</p></div></td></tr>
        </tbody></table></div></div>
    </section>
  </main></div>
</div>
<dialog class="orders-demo-dialog" data-orders-demo-dialog aria-labelledby="orders-demo-title"><div class="orders-demo-head"><div><span class="orders-build-kicker">EXAMPLE PREVIEW</span><h2 id="orders-demo-title">ตัวอย่างฟังก์ชัน</h2><p>หน้าตัวอย่างเพื่อให้เห็นตำแหน่งและรูปแบบก่อนพัฒนาจริง</p></div><button type="button" data-orders-demo-close aria-label="ปิดตัวอย่าง">×</button></div><div class="orders-demo-body"><div class="orders-demo-mock-row"><span class="orders-demo-mock-icon">#</span><div><strong>#EXAMPLE-001</strong><small>ลูกค้าตัวอย่าง · เกมตัวอย่าง</small></div><b>฿120</b><em>ตัวอย่าง</em></div><div class="orders-demo-placeholder"><span>ฟังก์ชันนี้ยังไม่เชื่อมกับระบบจริง</span><small>เมื่อเริ่มทำจริง ปุ่มจะทำงานกับคำสั่งซื้อจริงโดยไม่ใช้ข้อมูลตัวอย่างนี้</small></div></div><div class="orders-demo-actions"><button class="experiment-button" type="button" data-orders-demo-close>ปิด</button><a class="experiment-button primary" href="/admin/orders">กลับหน้าคำสั่งซื้อ</a></div></dialog>
<script>(function(){const rows=[...document.querySelectorAll('[data-order-row]')],search=document.querySelector('[data-orders-search]'),date=document.querySelector('[data-orders-date]'),visible=document.querySelector('[data-orders-visible]'),empty=document.querySelector('[data-orders-no-results]');let tab='all';const filter=()=>{const q=(search?.value||'').trim().toLowerCase(), now=Date.now(), days=Number(date?.value||0);let count=0;rows.forEach(row=>{const created=Date.parse(row.dataset.date),matchSearch=!q||row.dataset.search.includes(q),matchTab=tab==='all'||row.dataset.status===tab,matchDate=date?.value==='all'||(date?.value==='today'?new Date(created).toDateString()===new Date().toDateString():(now-created)<=days*86400000);const show=matchSearch&&matchTab&&matchDate;row.hidden=!show;if(show)count++;});if(visible)visible.textContent=count;if(empty)empty.hidden=count!==0||!rows.length;};document.querySelectorAll('[data-orders-tab]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-orders-tab]').forEach(item=>item.classList.toggle('active',item===button));tab=button.dataset.ordersTab;filter()}));search?.addEventListener('input',filter);date?.addEventListener('change',filter);document.querySelector('[data-orders-notifications]')?.addEventListener('click',()=>window.alert('ยังไม่มีการแจ้งเตือนใหม่'));const roadmap=document.querySelector('.orders-build-status'),roadmapToggle=document.querySelector('[data-orders-roadmap-toggle]');roadmapToggle?.addEventListener('click',()=>{roadmap?.classList.toggle('is-collapsed');roadmapToggle.textContent=roadmap?.classList.contains('is-collapsed')?'แสดงรายการนี้ ↓':'ซ่อนรายการนี้ ↑';});const demo=document.querySelector('[data-orders-demo-dialog]'),demoTitle=document.querySelector('#orders-demo-title');document.querySelectorAll('[data-orders-roadmap-demo]').forEach(button=>button.addEventListener('click',()=>{if(demoTitle)demoTitle.textContent=button.dataset.demoTitle||'ตัวอย่างฟังก์ชัน';demo?.showModal();}));document.querySelectorAll('[data-orders-demo-close]').forEach(button=>button.addEventListener('click',()=>demo?.close()));demo?.addEventListener('click',event=>{if(event.target===demo)demo.close();});})();</script>
