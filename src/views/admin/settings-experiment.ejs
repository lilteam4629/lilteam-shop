<link rel="stylesheet" href="<%= asset('css/admin-experiment-settings-v1.css') %>" />
<link rel="stylesheet" href="<%= asset('css/admin-experiment-settings-v3.css') %>" />
<link rel="stylesheet" href="<%= asset('css/admin-experiment-settings-v4.css') %>" />

<div class="experiment-app experiment-settings-page">
  <div class="experiment-main">
    <header class="experiment-topbar">


      <span class="experiment-user-name">admin</span>
    </header>

    <main class="experiment-content">
      <div class="experiment-page-head">
        <div>
          <div class="experiment-kicker">ตั้งค่าร้าน</div>
          <h1>ตั้งค่าร้านค้า</h1>
          <p>แก้ไขข้อมูลร้านค้าและช่องทางติดต่อ พร้อมดูตัวอย่างก่อนบันทึก</p>
        </div>
        <div class="experiment-settings-save-state" data-settings-save-state role="status" aria-live="polite"><i aria-hidden="true"></i><span>พร้อมแก้ไขข้อมูลร้าน</span></div>
      </div>

      <section class="settings-hero experiment-card" aria-labelledby="settings-hero-title">
        <div class="settings-hero-copy">
          <span class="settings-eyebrow">STORE CONTROL CENTER</span>
          <h2 id="settings-hero-title">จัดการหน้าร้านให้ครบจากที่เดียว</h2>
          <p>แก้ไขข้อมูลหน้าร้านและดูตัวอย่างการเปลี่ยนแปลงได้จากหน้านี้</p>
          <div class="settings-hero-actions">
            <a class="experiment-button primary" href="#settings-basic">แก้ข้อมูลร้าน ↓</a>
          </div>
        </div>
        <div class="settings-hero-mark" aria-hidden="true">
          <% if (settings.branding && settings.branding.logoImage) { %>
            <img src="<%= settings.branding.logoImage %>" alt="" />
          <% } else { %>
            <span><%= (settings.shopName || 'L')[0] %></span>
          <% } %>
        </div>
      </section>

      <div class="settings-layout">
        <form class="settings-form" action="/admin/settings" method="post" data-settings-live-form>
          <section class="settings-panel experiment-card" id="settings-basic" aria-labelledby="settings-basic-title">
            <div class="settings-panel-head">
              <div class="settings-panel-icon green" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 10 8.5-6 8.5 6v9.5a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1z"/><path d="M8.5 20.5v-6h7v6M7.5 10.5h.01M12 10.5h.01M16.5 10.5h.01"/></svg></div>
              <div>
                <span class="settings-section-label">ข้อมูลร้าน</span>
                <h2 id="settings-basic-title">ข้อมูลร้านและแบรนด์</h2>
                <p>ชื่อและคำโปรยที่ลูกค้าเห็นบนหน้าร้าน</p>
              </div>
              <span class="settings-ready-badge">กำลังใช้งาน</span>
            </div>
            <div class="settings-fields two-columns">
              <label>
                <span>ชื่อร้านค้า <b>*</b></span>
                <input name="shopName" value="<%= settings.shopName || '' %>" required maxlength="80" autocomplete="organization" aria-describedby="settings-shop-name-hint" data-settings-shop-name />
                <small class="settings-field-hint" id="settings-shop-name-hint">จำเป็น · ไม่เกิน 80 ตัวอักษร</small>
              </label>
              <label>
                <span>คำโปรยร้าน</span>
                <input name="tagline" value="<%= settings.tagline || '' %>" maxlength="120" placeholder="เช่น ร้านจำหน่ายเกมและไอดีแท้ 24 ชม." aria-describedby="settings-tagline-hint" data-settings-tagline />
                <small class="settings-field-hint" id="settings-tagline-hint">ไม่เกิน 120 ตัวอักษร</small>
              </label>
            </div>
          </section>

          <section class="settings-panel experiment-card" id="settings-contact" aria-labelledby="settings-contact-title">
            <div class="settings-panel-head">
              <div class="settings-panel-icon blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/><path d="M17.8 5.8 19.4 4.2"/></svg></div>
              <div>
                <span class="settings-section-label">ข้อมูลร้าน</span>
                <h2 id="settings-contact-title">เวลาและช่องทางติดต่อ</h2>
                <p>กำหนดเวลาบริการและช่องทางที่ลูกค้าใช้ติดต่อร้าน</p>
              </div>
              <span class="settings-ready-badge">กำลังใช้งาน</span>
            </div>
            <div class="settings-fields two-columns">
              <label>
                <span>เวลาเปิดบริการ</span>
                <input name="openHours" value="<%= settings.openHours || '' %>" maxlength="80" placeholder="เช่น เปิดบริการ 24 ชั่วโมง หรือ 10:00 - 22:00" data-settings-open-hours />
              </label>
              <label>
                <span>Line ID หรือ Line @</span>
                <input name="contactLine" value="<%= settings.contactLine || '' %>" maxlength="120" placeholder="เช่น @myshop" autocomplete="off" data-settings-contact-line />
              </label>
              <label>
                <span>Facebook Page URL</span>
                <input name="contactFacebook" value="<%= settings.contactFacebook || '' %>" maxlength="300" placeholder="https://facebook.com/ชื่อเพจ" spellcheck="false" />
              </label>
              <label>
                <span>Messenger URL</span>
                <input name="contactMessenger" value="<%= settings.contactMessenger || '' %>" maxlength="300" placeholder="https://m.me/ชื่อเพจ" spellcheck="false" />
              </label>
              <label>
                <span>ชื่อที่แสดงบนการ์ด Facebook</span>
                <input name="contactFacebookName" value="<%= settings.contactFacebookName || '' %>" maxlength="100" placeholder="เช่น LilTeam Official" />
              </label>
              <label>
                <span>เวลาตอบกลับโดยประมาณ</span>
                <input name="contactResponseTime" value="<%= settings.contactResponseTime || '' %>" maxlength="80" placeholder="เช่น ภายใน 5–15 นาที" data-settings-response-time />
              </label>
            </div>
            <label class="settings-toggle-row">
              <span>
                <strong>แสดงแถบเวลาเปิดบริการหน้าหลัก</strong>
                <small>แสดงสถานะร้านพร้อมเวลาและคำโปรยด้านบนสุดของหน้าร้าน</small>
              </span>
              <input type="checkbox" name="showOpenHoursBar" <%= settings.showOpenHoursBar !== false ? 'checked' : '' %> data-settings-hours-toggle role="switch" aria-label="แสดงแถบเวลาเปิดบริการหน้าหลัก" />
              <i aria-hidden="true"></i>
            </label>
          </section>

          <div class="settings-form-actions">
            <span>ระบบจะบันทึกข้อมูลเมื่อกดปุ่มบันทึกด้านขวา</span>
            <button class="experiment-button primary" type="submit">บันทึกข้อมูลร้านค้า →</button>
          </div>
        </form>

        <aside class="settings-preview-column">
          <section class="settings-preview experiment-card" aria-labelledby="settings-live-preview-title">
            <div class="settings-preview-head">
              <div>
                <span>REAL STOREFRONT · LIVE PREVIEW</span>
                <strong id="settings-live-preview-title">หน้าร้านจริงของคุณ</strong>
              </div>
              <i><b></b> ใช้หน้าแรกและข้อมูลจริง</i>
            </div>
            <div class="settings-preview-mode" role="group" aria-label="ขนาดตัวอย่างหน้าร้าน">
              <button class="is-active" type="button" data-storefront-preview-mode="wide" aria-pressed="true">หน้าจอใหญ่</button>
              <button type="button" data-storefront-preview-mode="mobile" aria-pressed="false">มือถือ</button>
            </div>
            <div class="settings-storefront-stage">
              <iframe
                class="settings-storefront-frame"
                src="/"
                title="<%= settings.shopName || 'LilTeam Shop' %> — ตัวอย่างหน้าร้านจริง"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-scripts allow-same-origin"
                data-storefront-preview-frame
                data-preview-mode="wide"></iframe>
            </div>
            <p class="settings-preview-note">แสดงหน้าแรกจริงพร้อมธีม หมวดหมู่ ประกาศ และสินค้าจากระบบร้านนี้ · แก้ชื่อร้าน คำโปรย หรือเวลาเปิดแล้วดูผลได้ทันที · กดบันทึกเพื่อเก็บค่า</p>
          </section>

        </aside>
      </div>

    </main>
  </div>
</div>

<script>
  (() => {
    const form = document.querySelector('[data-settings-live-form]');
    const name = document.querySelector('[data-settings-shop-name]');
    const tagline = document.querySelector('[data-settings-tagline]');
    const frame = document.querySelector('[data-storefront-preview-frame]');
    const hours = document.querySelector('[data-settings-open-hours]');
    const hoursToggle = document.querySelector('[data-settings-hours-toggle]');
    const saveState = document.querySelector('[data-settings-save-state] span');
    const valueOf = input => input?.value.trim() || '';
    const syncStorefront = () => {
      try {
        const previewDocument = frame?.contentDocument;
        if (!previewDocument) return;

        const shopName = valueOf(name) || 'LilTeam Shop';
        const previewValues = {
          shopName,
          tagline: valueOf(tagline),
          openHours: valueOf(hours),
        };

        Object.entries(previewValues).forEach(([key, value]) => {
          previewDocument.querySelectorAll(`[data-storefront-preview-setting="${key}"]`).forEach(element => {
            element.textContent = value;
          });
        });

        const initial = Array.from(shopName.trim())[0] || 'L';
        previewDocument.querySelectorAll('[data-storefront-preview-initial]').forEach(element => {
          element.textContent = initial.toLocaleUpperCase('th-TH');
        });
        previewDocument.querySelector('.store-nav__brand')?.setAttribute('aria-label', `หน้าแรก ${shopName}`);

        const hoursBar = previewDocument.querySelector('[data-storefront-preview-hours-bar]');
        if (hoursBar && hoursToggle) hoursBar.hidden = !hoursToggle.checked;
      } catch (error) {
        // Keep the settings form usable if a browser blocks same-origin preview access.
      }
    };
    const sync = () => syncStorefront();

    frame?.addEventListener('load', syncStorefront);
    document.querySelectorAll('[data-storefront-preview-mode]').forEach(button => {
      button.addEventListener('click', () => {
        const mode = button.dataset.storefrontPreviewMode;
        frame?.setAttribute('data-preview-mode', mode);
        document.querySelectorAll('[data-storefront-preview-mode]').forEach(option => {
          const active = option === button;
          option.classList.toggle('is-active', active);
          option.setAttribute('aria-pressed', String(active));
        });
      });
    });
    form?.addEventListener('input', event => {
      if (event.target.matches('input:not([type="checkbox"])')) {
        form.dataset.dirty = 'true';
        if (saveState) saveState.textContent = 'มีการแก้ไขที่ยังไม่บันทึก';
      }
      sync();
    });
    form?.addEventListener('change', event => {
      if (event.target.matches('input[type="checkbox"]')) {
        form.dataset.dirty = 'true';
        if (saveState) saveState.textContent = 'มีการแก้ไขที่ยังไม่บันทึก';
      }
      sync();
    });
    sync();
  })();
</script>
