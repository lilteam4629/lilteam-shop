<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-4">ตัวกรองสินค้าทั้งหมด</h3>
    <% if (!filterTags.length) { %>
      <p class="text-[var(--text-4)] text-sm">ยังไม่มีตัวกรองสินค้า เพิ่มได้จากฟอร์มด้านขวา</p>
    <% } %>
    <div class="grid grid-cols-3 sm:grid-cols-4 gap-4">
      <% filterTags.forEach(t => { %>
        <div class="bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3 text-center">
          <img src="<%= t.image %>" alt="<%= t.name %>" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 border-2 border-[#4a4028]" />
          <div class="text-sm font-medium truncate"><%= t.name %></div>
          <div class="text-xs text-[var(--text-4)] mb-2"><%= t.productCount %> สินค้า</div>
          <form action="/admin/filter-tags/<%= t.id %>/delete" method="post" onsubmit="return confirm('ลบตัวกรองนี้? (จะถูกลบออกจากสินค้าที่ผูกไว้ด้วย)')">
            <button class="text-rose-400 text-xs">ลบ</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-3">เพิ่มตัวกรองสินค้า</h3>
    <form action="/admin/filter-tags" method="post" enctype="multipart/form-data" class="space-y-3">
      <div>
        <label class="block text-xs text-[var(--text-3)] mb-1">ชื่อ (แสดงใต้รูป)</label>
        <input name="name" required placeholder="เช่น แนะนำ, ขายดี, Denuvo" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-[var(--text-3)] mb-1">แนบรูปตัวกรอง</label>
        <div class="max-w-[140px] mb-2"><%- include('../partials/image-placeholder', { w: 200, h: 200, ratioClass: 'aspect-square' }) %></div>
        <input id="filterImageInput" type="file" name="filterImage" required accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full text-xs text-[var(--text-3)] file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold)] file:text-xs" />
        <div id="filterImagePreview" class="hidden mt-3 rounded-xl overflow-hidden border border-[var(--border-light)] bg-black/20">
          <img class="w-full h-36 object-contain" alt="ตัวอย่างรูปตัวกรอง" />
        </div>
      </div>
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">เพิ่มตัวกรอง</button>
    </form>
    <p class="text-xs text-[var(--text-4)] mt-3">หลังเพิ่มแล้ว ไปที่หน้าแก้ไขสินค้าเพื่อเลือกว่าสินค้าไหนมีตัวกรองนี้บ้าง</p>
  </div>
</div>
<script>
  (function () {
    const input = document.getElementById('filterImageInput');
    const preview = document.getElementById('filterImagePreview');
    if (!input || !preview) return;
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      preview.classList.toggle('hidden', !file);
      if (!file) return;
      const image = preview.querySelector('img');
      image.src = URL.createObjectURL(file);
      image.onload = function () { URL.revokeObjectURL(image.src); };
    });
  })();
</script>
