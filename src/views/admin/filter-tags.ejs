<div class="filter-studio space-y-5">
  <section class="filter-studio-hero">
    <div><span class="filter-studio-kicker">FILTER LIBRARY</span><h1>คลังตัวกรองสินค้า</h1><p>ค้นหา แก้ไข และจัดการตัวกรองหลายรายการได้จากหน้าเดียว</p></div>
    <button type="button" id="open-filter-create" class="filter-primary-action"><span>＋</span> สร้างตัวกรอง</button>
  </section>
  <section class="filter-stats-grid">
    <div><span>ตัวกรองทั้งหมด</span><b><%= filterTags.length %></b><small>รายการ</small></div>
    <div><span>กำลังใช้งาน</span><b><%= filterTags.filter(t=>t.productCount>0).length %></b><small>รายการ</small></div>
    <div><span>ยังไม่ผูกสินค้า</span><b><%= filterTags.filter(t=>!t.productCount).length %></b><small>รายการ</small></div>
  </section>
  <section class="filter-library-panel p-4 sm:p-5"><form action="/admin/filter-tags/heading" method="post" class="flex flex-col sm:flex-row sm:items-end gap-3"><label class="flex-1"><span class="block text-sm font-semibold mb-1">หัวข้อบนตัวกรองหน้าร้าน</span><small class="block text-[10px] text-[var(--text-4)] mb-2">แก้ข้อความที่แสดงเหนือแถวรูปตัวกรองได้</small><input name="filterHeading" value="<%= settings.filterHeading || 'เลือกตัวที่ต้องการตามหา' %>" maxlength="100" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3 py-2.5 text-sm" /></label><button class="filter-primary-action justify-center">บันทึกหัวข้อ</button></form></section>
  <section class="filter-library-panel flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5"><div><span class="filter-studio-kicker">eFOOTBALL · NEW PLAYERS</span><h2 class="mt-1 text-lg font-bold">นำเข้ารูปผู้เล่นเป็นแท็กตัวกรอง</h2><p class="text-sm text-[var(--text-3)]">ใช้เฉพาะการ์ดจาก <a class="underline" href="https://efhub.com/th/new-players" target="_blank" rel="noopener">eFHUB New Players</a> กับตัวกรองเดิมได้ทันที</p></div><form action="/admin/filter-tags/efootball/import" method="post"><button class="filter-primary-action justify-center">นำเข้าการ์ด New Players ทั้งหมด</button></form></section>
  <section class="filter-library-panel">
    <div class="filter-library-toolbar">
      <div class="filter-search-box"><span>⌕</span><input id="filter-library-search" placeholder="ค้นหาชื่อตัวกรอง..." /></div>
      <div class="filter-toolbar-actions"><button type="button" id="filter-select-all">เลือกทั้งหมด</button><form id="filter-bulk-delete" action="/admin/filter-tags/bulk-delete" method="post" data-confirm="ลบตัวกรองที่เลือกทั้งหมดใช่หรือไม่?"><div id="filter-selected-inputs"></div><button id="filter-delete-selected" disabled>ลบที่เลือก <span id="filter-selected-count">0</span></button></form></div>
    </div>
    <div class="filter-order-bar" role="region" aria-label="จัดลำดับตัวกรอง">
      <div><b>จัดลำดับการแสดงผล</b><small>ลากการ์ดเพื่อย้ายตำแหน่ง หรือใช้ปุ่ม ↑ ↓ · รายการแรกจะแสดงก่อนบนหน้าร้าน</small></div>
      <div class="filter-order-actions"><span id="filter-order-status" role="status" aria-live="polite">ลำดับปัจจุบัน</span><button type="button" id="filter-save-order" disabled>บันทึกลำดับ</button></div>
    </div>
    <% if (!filterTags.length) { %><div class="filter-empty"><span>✦</span><h2>คลังตัวกรองยังว่าง</h2><p>กด “สร้างตัวกรอง” เพื่อเพิ่มรายการแรก</p></div><% } else { %>
    <div id="filter-library-grid" class="filter-library-grid">
      <% filterTags.forEach((t,index)=>{ %><article class="filter-library-card" draggable="true" data-filter-card data-name="<%= t.name.toLowerCase() %>" data-id="<%= t.id %>" data-title="<%= t.name %>" data-order-index="<%= index %>">
        <div class="filter-card-drag-tools"><button type="button" draggable="true" class="filter-card-drag-handle" data-drag-handle aria-label="ลากเพื่อย้าย <%= t.name %>" title="ลากเพื่อย้าย">⠿</button><span class="filter-order-badge" data-order-badge aria-label="ลำดับที่ <%= index + 1 %>"><%= index + 1 %></span></div>
        <button type="button" class="filter-select-toggle" aria-label="เลือก <%= t.name %>"><span>✓</span></button>
        <div class="filter-image-stage"><img src="<%= t.image %>" alt="<%= t.name %>" /></div>
        <div class="filter-card-body"><div class="filter-card-name"><b><%= t.name %></b><span><%= t.productCount %> สินค้า</span></div><div class="filter-usage"><i style="width:<%= Math.min(100,t.productCount*12) %>%"></i></div><div class="filter-card-order-row"><span>ลำดับ <b data-order-label><%= index + 1 %></b></span><div class="filter-card-move-actions"><button type="button" data-move-up aria-label="เลื่อน <%= t.name %> ขึ้น">↑</button><button type="button" data-move-down aria-label="เลื่อน <%= t.name %> ลง">↓</button></div></div>
          <button type="button" class="filter-manage-products"><span>▦</span> จัดการสินค้า</button>
          <div class="filter-card-actions"><button type="button" class="filter-edit-toggle">แก้ไขชื่อ</button><form action="/admin/filter-tags/<%= t.id %>/delete" method="post" data-confirm="ต้องการลบตัวกรอง '<%= t.name %>' ใช่หรือไม่?"><button>ลบ</button></form></div>
          <form action="/admin/filter-tags/<%= t.id %>/edit" method="post" class="filter-inline-editor hidden"><input name="name" value="<%= t.name %>" required maxlength="100" /><button>บันทึก</button></form>
        </div></article><% }) %>
    </div><div id="filter-no-result" class="filter-empty hidden"><span>⌕</span><h2>ไม่พบตัวกรอง</h2><p>ลองค้นหาด้วยคำอื่น</p></div><% } %>
  </section>
</div>
<div id="filter-create-drawer" class="filter-drawer" aria-hidden="true"><button type="button" class="filter-drawer-backdrop" id="close-filter-create"></button><aside>
  <div class="filter-drawer-head"><div><span>NEW FILTER</span><h2>สร้างตัวกรองใหม่</h2></div><button type="button" id="close-filter-create-x">✕</button></div>
  <form action="/admin/filter-tags" method="post" enctype="multipart/form-data" class="filter-create-form">
    <label><span>ชื่อตัวกรอง</span><small>ใช้เมื่อเลือกรูปเดียว</small><input name="name" placeholder="เช่น Messi, Epic, Barcelona" /></label>
    <label class="filter-drop-zone" for="filterImageInput"><input id="filterImageInput" type="file" name="filterImages" multiple required accept="image/png,image/jpeg,image/webp,image/gif" /><span class="filter-drop-icon">⬆</span><b>วางรูปที่นี่ หรือกดเลือกไฟล์</b><small>เลือกหลายรูปได้ ระบบใช้ชื่อไฟล์เป็นชื่อรายการ</small></label>
    <div id="filterImagePreview" class="filter-upload-preview hidden"></div><button class="filter-create-submit">สร้างตัวกรองที่เลือก</button>
  </form>
</aside></div>
<div id="filter-products-drawer" class="filter-drawer filter-products-drawer" aria-hidden="true"><button type="button" class="filter-drawer-backdrop" id="close-filter-products"></button><aside>
  <div class="filter-drawer-head"><div><span>PRODUCT CONNECTIONS</span><h2 id="filter-products-title">สินค้าในตัวกรอง</h2></div><button type="button" id="close-filter-products-x">✕</button></div>
  <section class="filter-drag-palette"><div><b>ลากตัวกรองไปวางบนสินค้า</b><small>ใช้บนคอม • วางแล้วบันทึกทันที</small></div><div class="filter-drag-chips"><% filterTags.forEach(t=>{ %><button type="button" draggable="true" class="filter-drag-chip" data-drag-tag="<%= t.id %>" data-drag-name="<%= t.name %>" data-drag-image="<%= t.image %>"><img src="<%= t.image %>" alt="" /><span><%= t.name %></span><i>⋮⋮</i></button><% }) %></div></section>
  <div class="filter-product-tools"><div class="filter-search-box"><span>⌕</span><input id="filter-product-search" placeholder="ค้นหาสินค้า..." /></div><div class="filter-product-summary"><b id="filter-product-count">0</b><span>รายการที่เลือก</span></div></div>
  <form id="filter-products-form" method="post" class="filter-products-form">
    <div class="filter-product-list">
      <% products.forEach(p=>{ %><label class="filter-product-row" data-product-id="<%= p.id %>" data-product-name="<%= String(p.title || '').toLowerCase() %>" data-tags='<%- JSON.stringify(p.filterTagIds || []) %>'>
        <input type="checkbox" name="productIds" value="<%= p.id %>" />
        <span class="filter-product-thumb"><% if(p.image){ %><img src="<%= p.image %>" alt="" loading="lazy" /><% } else { %>◇<% } %></span>
        <span class="filter-product-check">✓</span>
        <span class="filter-product-info"><b><%= p.title %></b><small><%= p.status === 'active' ? 'เปิดขาย' : 'ซ่อนอยู่' %></small><span class="filter-product-tags"><% filterTags.filter(t=>(p.filterTagIds||[]).map(String).includes(String(t.id))).forEach(t=>{ %><i data-linked-tag="<%= t.id %>"><img src="<%= t.image %>" alt="" /><%= t.name %></i><% }) %></span></span>
      </label><% }) %>
    </div>
    <% if(!products.length){ %><div class="filter-empty"><span>◇</span><h2>ยังไม่มีสินค้า</h2><p>เพิ่มสินค้าก่อนจึงจะผูกตัวกรองได้</p></div><% } %>
    <div class="filter-product-savebar"><button type="submit">บันทึกสินค้าที่เลือก</button></div>
  </form>
</aside></div>
<script>
(function(){const drawer=document.getElementById('filter-create-drawer'),productDrawer=document.getElementById('filter-products-drawer'),toggleDrawer=(el,o)=>{el.classList.toggle('is-open',o);el.setAttribute('aria-hidden',o?'false':'true');document.body.style.overflow=(drawer.classList.contains('is-open')||productDrawer.classList.contains('is-open'))?'hidden':''},setDrawer=o=>toggleDrawer(drawer,o),setProductDrawer=o=>toggleDrawer(productDrawer,o);document.getElementById('open-filter-create')?.addEventListener('click',()=>setDrawer(true));document.getElementById('close-filter-create')?.addEventListener('click',()=>setDrawer(false));document.getElementById('close-filter-create-x')?.addEventListener('click',()=>setDrawer(false));document.getElementById('close-filter-products')?.addEventListener('click',()=>setProductDrawer(false));document.getElementById('close-filter-products-x')?.addEventListener('click',()=>setProductDrawer(false));document.addEventListener('keydown',e=>{if(e.key==='Escape'){setDrawer(false);setProductDrawer(false)}});
const cards=[...document.querySelectorAll('[data-filter-card]')],selected=new Set(),sync=()=>{document.getElementById('filter-selected-count').textContent=selected.size;document.getElementById('filter-delete-selected').disabled=!selected.size;const holder=document.getElementById('filter-selected-inputs');holder.replaceChildren();if(selected.size){const input=document.createElement('input');input.type='hidden';input.name='tagIds';input.value=[...selected].join(',');holder.append(input)}cards.forEach(c=>c.classList.toggle('is-selected',selected.has(c.dataset.id)))};document.getElementById('filter-library-search')?.addEventListener('input',e=>{let shown=0;cards.forEach(c=>{const ok=c.dataset.name.includes(e.target.value.trim().toLowerCase());c.classList.toggle('hidden',!ok);if(ok)shown++});document.getElementById('filter-no-result')?.classList.toggle('hidden',shown!==0)});cards.forEach(c=>{c.querySelector('.filter-select-toggle').onclick=()=>{selected.has(c.dataset.id)?selected.delete(c.dataset.id):selected.add(c.dataset.id);sync()};c.querySelector('.filter-edit-toggle').onclick=()=>c.querySelector('.filter-inline-editor').classList.toggle('hidden')});document.getElementById('filter-select-all')?.addEventListener('click',()=>{const visible=cards.filter(c=>!c.classList.contains('hidden')),all=visible.every(c=>selected.has(c.dataset.id));visible.forEach(c=>all?selected.delete(c.dataset.id):selected.add(c.dataset.id));sync()});
const productRows=[...document.querySelectorAll('.filter-product-row')],productCount=document.getElementById('filter-product-count'),syncProductCount=()=>productCount.textContent=productRows.filter(r=>r.querySelector('input').checked).length;cards.forEach(card=>card.querySelector('.filter-manage-products')?.addEventListener('click',()=>{const id=card.dataset.id;document.getElementById('filter-products-title').textContent='สินค้าใน “'+card.dataset.title+'”';document.getElementById('filter-products-form').action='/admin/filter-tags/'+encodeURIComponent(id)+'/products';productRows.forEach(row=>{let tags=[];try{tags=JSON.parse(row.dataset.tags||'[]').map(String)}catch(_){ }row.querySelector('input').checked=tags.includes(String(id));row.classList.remove('hidden')});document.getElementById('filter-product-search').value='';syncProductCount();setProductDrawer(true)}));productRows.forEach(row=>row.querySelector('input').addEventListener('change',syncProductCount));document.getElementById('filter-product-search')?.addEventListener('input',e=>{const q=e.target.value.trim().toLowerCase();productRows.forEach(row=>row.classList.toggle('hidden',!row.dataset.productName.includes(q)))});
const dragTags=new Map([...document.querySelectorAll('[data-drag-tag]')].map(chip=>[String(chip.dataset.dragTag),{id:String(chip.dataset.dragTag),name:chip.dataset.dragName,image:chip.dataset.dragImage}]));let draggedTag=null;document.querySelectorAll('[data-drag-tag]').forEach(chip=>{chip.addEventListener('dragstart',e=>{draggedTag=dragTags.get(String(chip.dataset.dragTag));chip.classList.add('is-dragging');e.dataTransfer.effectAllowed='copy';e.dataTransfer.setData('text/plain',draggedTag.id)});chip.addEventListener('dragend',()=>{chip.classList.remove('is-dragging');draggedTag=null;productRows.forEach(r=>r.classList.remove('is-drop-ready'))})});productRows.forEach(row=>{row.addEventListener('dragover',e=>{const tagId=e.dataTransfer.getData('text/plain');if(!draggedTag&&!tagId)return;e.preventDefault();e.dataTransfer.dropEffect='copy';row.classList.add('is-drop-ready')});row.addEventListener('dragleave',e=>{if(!e.relatedTarget||!row.contains(e.relatedTarget))row.classList.remove('is-drop-ready')});row.addEventListener('drop',async e=>{e.preventDefault();const tagId=e.dataTransfer.getData('text/plain'),tag=dragTags.get(String(tagId))||draggedTag,box=row.querySelector('.filter-product-tags');row.classList.remove('is-drop-ready');if(!tag)return;if(box.querySelector('[data-linked-tag="'+CSS.escape(tag.id)+'"]')){row.classList.add('is-drop-success');setTimeout(()=>row.classList.remove('is-drop-success'),1000);return}row.classList.add('is-saving');try{const response=await fetch('/admin/filter-tags/'+encodeURIComponent(tag.id)+'/products/'+encodeURIComponent(row.dataset.productId)+'/add',{method:'POST',headers:{Accept:'application/json','X-Requested-With':'XMLHttpRequest'}}),data=await response.json();if(!response.ok||!data.ok)throw new Error(data.message||'บันทึกไม่สำเร็จ');const savedTag=data.tag||tag,item=document.createElement('i'),img=document.createElement('img');item.dataset.linkedTag=String(savedTag.id);img.src=savedTag.image;img.alt='';item.append(img,document.createTextNode(savedTag.name));box.append(item);row.dataset.tags=JSON.stringify((data.filterTagIds||[]).map(String));row.classList.add('is-drop-success');setTimeout(()=>row.classList.remove('is-drop-success'),1200)}catch(error){alert(error.message)}finally{row.classList.remove('is-saving')}})});
const input=document.getElementById('filterImageInput'),preview=document.getElementById('filterImagePreview');input?.addEventListener('change',()=>{preview.innerHTML='';const files=[...(input.files||[])];preview.classList.toggle('hidden',!files.length);files.forEach(file=>{const item=document.createElement('div'),img=document.createElement('img'),span=document.createElement('span');img.src=URL.createObjectURL(file);img.onload=()=>URL.revokeObjectURL(img.src);span.textContent=file.name.replace(/\.[^.]+$/,'');item.append(img,span);preview.append(item)})})})();
</script>
<script>
(function(){
  const grid=document.getElementById('filter-library-grid');
  const saveButton=document.getElementById('filter-save-order');
  const status=document.getElementById('filter-order-status');
  if(!grid||!saveButton) return;
  let dragged=null,dirty=false;
  const cards=()=>[...grid.querySelectorAll('[data-filter-card]')];
  const setStatus=(message)=>{if(status) status.textContent=message};
  const updatePositions=()=>cards().forEach((card,index)=>{
    card.dataset.orderIndex=String(index);
    const badge=card.querySelector('[data-order-badge]');
    const label=card.querySelector('[data-order-label]');
    if(badge){badge.textContent=String(index+1);badge.setAttribute('aria-label','ลำดับที่ '+(index+1));}
    if(label) label.textContent=String(index+1);
    const up=card.querySelector('[data-move-up]'),down=card.querySelector('[data-move-down]');
    if(up) up.disabled=index===0;
    if(down) down.disabled=index===cards().length-1;
  });
  const markDirty=()=>{dirty=true;saveButton.disabled=false;saveButton.classList.add('is-dirty');setStatus('มีการเปลี่ยนแปลงที่ยังไม่ได้บันทึก')};
  const move=(card,offset)=>{
    const list=cards(),index=list.indexOf(card),target=index+offset;
    if(index<0||target<0||target>=list.length) return;
    if(offset<0) grid.insertBefore(card,list[target]); else grid.insertBefore(card,list[target].nextSibling);
    updatePositions();markDirty();
  };
  // Pointer fallback keeps reordering usable on touch screens and browsers
  // where native HTML5 drag events do not fire from a button handle.
  let pointerDrag=null;
  const finishPointerDrag=()=>{
    if(!pointerDrag)return;
    pointerDrag.card.classList.remove('is-dragging');
    cards().forEach(item=>item.classList.remove('is-drop-target'));
    pointerDrag=null;
  };
  grid.addEventListener('pointerdown',event=>{
    const handle=event.target.closest('[data-drag-handle]');
    if(!handle)return;
    const card=handle.closest('[data-filter-card]');
    if(!card)return;
    pointerDrag={card,pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,moved:false};
    handle.setPointerCapture?.(event.pointerId);
    card.classList.add('is-dragging');
    event.preventDefault();
  });
  document.addEventListener('pointermove',event=>{
    if(!pointerDrag||event.pointerId!==pointerDrag.pointerId)return;
    if(!pointerDrag.moved && Math.hypot(event.clientX-pointerDrag.startX,event.clientY-pointerDrag.startY)<5)return;
    pointerDrag.moved=true;
    const target=document.elementFromPoint(event.clientX,event.clientY)?.closest('[data-filter-card]');
    if(!target||target===pointerDrag.card)return;
    const rect=target.getBoundingClientRect();
    grid.insertBefore(pointerDrag.card,event.clientY>rect.top+rect.height/2?target.nextSibling:target);
    updatePositions();markDirty();
    cards().forEach(item=>item.classList.remove('is-drop-target'));target.classList.add('is-drop-target');
  });
  document.addEventListener('pointerup',finishPointerDrag);
  document.addEventListener('pointercancel',finishPointerDrag);
  cards().forEach(card=>{
    card.querySelector('[data-move-up]')?.addEventListener('click',event=>{event.stopPropagation();move(card,-1)});
    card.querySelector('[data-move-down]')?.addEventListener('click',event=>{event.stopPropagation();move(card,1)});
    card.addEventListener('dragstart',event=>{
      if(event.target.closest('button,input,form,a')&&!event.target.closest('[data-drag-handle]')){event.preventDefault();return;}
      dragged=card;card.classList.add('is-dragging');event.dataTransfer.effectAllowed='move';event.dataTransfer.setData('text/plain',card.dataset.id);
    });
    card.addEventListener('dragover',event=>{
      if(!dragged||dragged===card)return;
      event.preventDefault();event.dataTransfer.dropEffect='move';
      const rect=card.getBoundingClientRect();
      grid.insertBefore(dragged,event.clientY>rect.top+rect.height/2?card.nextSibling:card);
      updatePositions();markDirty();
      cards().forEach(item=>item.classList.remove('is-drop-target'));card.classList.add('is-drop-target');
    });
    card.addEventListener('dragend',()=>{dragged=null;card.classList.remove('is-dragging');cards().forEach(item=>item.classList.remove('is-drop-target'))});
  });
  saveButton.addEventListener('click',async()=>{
    if(!dirty)return;
    saveButton.disabled=true;saveButton.classList.add('is-saving');setStatus('กำลังบันทึกลำดับ...');
    try{
      const response=await fetch('/admin/filter-tags/reorder',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({order:cards().map(card=>card.dataset.id)})});
      const data=await response.json();
      if(!response.ok||!data.ok) throw new Error(data.message||'บันทึกลำดับไม่สำเร็จ');
      dirty=false;saveButton.classList.remove('is-dirty');setStatus('บันทึกลำดับแล้ว');
      if(window.showToast) window.showToast('บันทึกลำดับตัวกรองแล้ว','success');
    }catch(error){saveButton.disabled=false;setStatus(error.message||'บันทึกลำดับไม่สำเร็จ');}
    finally{saveButton.classList.remove('is-saving');if(!dirty)saveButton.disabled=true;}
  });
  updatePositions();
})();
</script>
