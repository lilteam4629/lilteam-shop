<!-- Filter Tags Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">แท็กตัวกรองสินค้า</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">สร้างแท็กไอคอนทรงกลมสำหรับใช้กรองและไฮไลท์สินค้าบนหน้าแรก (<%= filterTags.length %> แท็ก)</p>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6">

  <!-- Left Main Column: Tags Grid -->
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">แท็กตัวกรองที่ใช้งานอยู่</h3>
      <span class="text-xs text-[var(--text-4)]">ทั้งหมด <%= filterTags.length %> รายการ</span>
    </div>

    <% if (!filterTags.length) { %>
      <div class="py-12 text-center text-xs text-[var(--text-4)] border border-dashed border-[var(--border-light)] rounded-2xl">
        <div class="text-3xl mb-2">🏷️</div>
        <div class="text-sm font-semibold text-[var(--text-3)]">ยังไม่มีแท็กตัวกรองสินค้า</div>
        <p class="text-xs text-[var(--text-4)] mt-1">เพิ่มแท็กใหม่ได้จากแบบฟอร์มด้านขวา</p>
      </div>
    <% } %>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3.5">
      <% filterTags.forEach(t => { %>
        <div class="bg-[var(--input)]/40 border border-[var(--border-light)] hover:border-[var(--gold)]/40 rounded-2xl p-4 text-center transition group relative shadow-sm flex flex-col items-center justify-between">
          <div class="w-16 h-16 rounded-full overflow-hidden mb-2.5 border-2 border-[var(--gold)]/40 shadow-sm p-0.5 bg-[var(--card)]">
            <img src="<%= t.image %>" alt="<%= t.name %>" class="w-full h-full rounded-full object-cover group-hover:scale-105 transition duration-200" />
          </div>

          <div class="font-bold text-xs sm:text-sm text-[var(--text)] truncate max-w-full"><%= t.name %></div>
          <div class="text-[11px] text-[var(--text-4)] mb-3"><%= t.productCount %> สินค้าที่ผูกไว้</div>

          <form action="/admin/filter-tags/<%= t.id %>/delete" method="post" data-confirm="ต้องการลบตัวกรอง '<%= t.name %>' ใช่หรือไม่? (จะถูกนำออกจากสินค้าทุกชิ้นที่ผูกไว้)">
            <button type="submit" class="border border-rose-500/30 text-rose-400 hover:bg-rose-500/10 font-semibold text-[11px] px-3 py-1 rounded-xl transition">
              ลบแท็ก
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Right Column: Add Tag Form Card -->
  <div>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm sticky top-20">
      <div class="flex items-center gap-2.5 mb-4">
        <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-sm">
          🏷️
        </div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เพิ่มตัวกรองใหม่</h3>
      </div>

      <form action="/admin/filter-tags" method="post" enctype="multipart/form-data" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ชื่อตัวกรอง (แสดงใต้รูป) *</label>
          <input name="name" required placeholder="เช่น แนะนำ, ขายดี, Denuvo, Nesta" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">รูปไอคอนตัวกรอง (แนะนำสี่เหลี่ยมจัตุรัส) *</label>
          <input id="filterImageInput" type="file" name="filterImage" required accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full text-xs text-[var(--text-3)] file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:bg-[var(--input)] file:text-[var(--gold)] file:font-semibold file:text-xs" />

          <div id="filterImagePreview" class="hidden mt-3 rounded-2xl overflow-hidden border border-[var(--border-light)] bg-black/20 p-2 text-center">
            <img class="w-20 h-20 rounded-full mx-auto object-cover border-2 border-[var(--gold)] shadow-md" alt="ตัวอย่างรูปตัวกรอง" />
          </div>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold rounded-xl py-2.5 text-xs shadow-md transition active:scale-95 mt-2">
          + เพิ่มแท็กตัวกรอง
        </button>
      </form>

      <p class="text-[11px] text-[var(--text-4)] mt-4 leading-relaxed">
        💡 หลังจากเพิ่มแล้ว สามารถเข้าไปที่หน้าแก้ไขสินค้าเพื่อติ๊กเลือกแท็กนี้ให้กับสินค้าที่ต้องการได้ทันที
      </p>
    </div>
  </div>

</div>

<script>
  (function () {
    const input = document.getElementById('filterImageInput');
    const preview = document.getElementById('filterImagePreview');
    if (!input || !preview) return;
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      preview.classList.toggle('hidden', !file);
      if (!file) return;
      const image = preview.querySelector('img');
      image.src = URL.createObjectURL(file);
      image.onload = function () { URL.revokeObjectURL(image.src); };
    });
  })();
</script>
