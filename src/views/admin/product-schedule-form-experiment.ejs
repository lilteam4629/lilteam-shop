<link rel="stylesheet" href="<%= asset('css/admin-experiment-scheduled-form-v1.css') %>" />
<%
  const editing = Boolean(product);
  const formAction = editing ? `/admin/products/${product.id}/edit` : '/admin/products/new';
  const productImages = product && Array.isArray(product.images) ? product.images : [];
  const productFilterTags = typeof filterTags === 'undefined' ? [] : filterTags;
  const selectedFilterTags = product && Array.isArray(product.filterTagIds) ? product.filterTagIds : [];
%>
<div class="experiment-app experiment-schedule-form-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'ร้านค้า')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'ร้านค้า' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><span aria-hidden="true">▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item <%= active === 'products' ? 'active' : '' %>" href="/admin/products"><span aria-hidden="true">◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><span aria-hidden="true">◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><span aria-hidden="true">◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><span aria-hidden="true">☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><span aria-hidden="true">▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span aria-hidden="true">▭</span><span>เติมเงิน & ตรวจสอบ</span></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span aria-hidden="true">⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><h1><%= editing ? 'แก้ไขสินค้า' : 'เพิ่มสินค้า' %></h1><p><%= editing ? 'แก้ข้อมูลสินค้า ตัวกรอง และรายละเอียดการซื้อได้ในหน้าเดียว' : 'กรอกข้อมูลสินค้าและรายละเอียดให้ครบ แล้วบันทึกเพื่อเปิดขาย' %></p></div><div class="experiment-actions"><a href="/admin/products" class="experiment-button">← กลับรายการสินค้า</a></div></div>
      <div class="experiment-page-status-note"><strong>ตั้งเวลาเปิดขายภายหลัง:</strong> เพิ่มสินค้าให้เสร็จก่อน จากนั้นกำหนดวันและเวลาเปิดขายได้ที่เมนู <a href="/admin/scheduled-products">ตั้งเวลาเปิดขาย</a></div>

      <form class="experiment-schedule-form" action="<%= formAction %>" method="post" enctype="multipart/form-data" data-schedule-form>
        <%- include('random-box-product-fields', { product, allowRandomBox }) %>
        <section class="experiment-card experiment-form-panel">
          <div class="experiment-form-panel-head"><div><div><h2>ข้อมูลสินค้า</h2><p>ข้อมูลที่แสดงในรายการสินค้าและหน้าร้าน</p></div></div><span class="experiment-ready-chip"><i></i> ข้อมูลสินค้า</span></div>
          <div class="experiment-form-grid">
            <label class="experiment-field full"><span>ชื่อสินค้า <b>*</b></span><input name="title" value="<%= product ? (product.title || '') : '' %>" placeholder="เช่น Shadow Realm Chronicles" required maxlength="160" /></label>
            <label class="experiment-field"><span>ราคาขาย (บาท) <b>*</b></span><input type="number" name="price" value="<%= product ? (product.price || 0) : '' %>" min="0" step="1" placeholder="0" required /></label>
            <label class="experiment-field"><span>ราคาเดิม (ถ้ามี)</span><input type="number" name="originalPrice" value="<%= product ? (product.originalPrice || '') : '' %>" min="0" step="1" placeholder="เช่น 990" /></label>
            <label class="experiment-field full"><span>คำอธิบายสั้น</span><textarea name="description" rows="3" placeholder="อธิบายสินค้าแบบสั้น ๆ ให้ลูกค้าเข้าใจทันที"><%= product ? (product.description || '') : '' %></textarea></label>
            <label class="experiment-field full"><span>รายละเอียดสินค้า</span><textarea name="aboutText" rows="4" placeholder="ข้อมูลเพิ่มเติมที่ลูกค้าควรรู้"><%= product ? (product.aboutText || '') : '' %></textarea></label>
          </div>
          <div class="experiment-subsection">
            <div class="experiment-subsection-head"><div><h3>รูปสินค้า</h3><p>เลือกได้หลายรูป และกำหนดภาพปกจากลำดับรูป</p></div><span class="experiment-muted-chip"><%= productImages.length %> รูปปัจจุบัน</span></div>
            <% if (productImages.length) { %>
              <div class="experiment-image-grid">
                <% productImages.forEach((image, index) => { %>
                  <label class="experiment-image-choice">
                    <span class="experiment-image-preview"><img src="<%= image %>" alt="รูปสินค้า <%= index + 1 %>" loading="lazy" /></span>
                    <span class="experiment-image-choice-meta"><span><%= index === 0 ? 'ภาพปก' : `รูปที่ ${index + 1}` %></span><span class="experiment-image-remove"><input type="checkbox" name="removeImages" value="<%= image %>" /> ลบรูป</span></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %><p class="experiment-inline-empty">ยังไม่มีรูปสินค้า เพิ่มรูปจากเครื่องหรือใส่ URL ด้านล่างได้</p><% } %>
            <div class="experiment-image-upload">
              <span class="experiment-upload-label">เพิ่มรูปจากเครื่องหรือโทรศัพท์</span>
              <label id="productImagesDropzone" class="experiment-image-dropzone" for="productImagesInput">
                <input id="productImagesInput" class="experiment-image-dropzone-input" type="file" name="productImages" accept="image/png,image/jpeg,image/webp,image/gif" multiple aria-describedby="productImagesHelp productImagesStatus" />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15.5v3A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5v-3" /></svg>
                <strong>ลากหลายรูปมาวางที่นี่ หรือคลิกเพื่อเลือก</strong>
                <small id="productImagesHelp">JPG, PNG, WEBP หรือ GIF · ไม่เกิน 10 รูป · รูปละไม่เกิน 8 MB</small>
              </label>
              <p id="productImagesStatus" class="experiment-upload-status" role="status" aria-live="polite">ยังไม่ได้เลือกรูปใหม่</p>
              <div id="newImagePreview" class="experiment-image-grid experiment-new-image-grid" hidden></div>
            </div>
            <label class="experiment-check-row"><input type="checkbox" name="newImagesFirst" /> ใช้รูปที่อัปโหลดใหม่เป็นภาพปก</label>
            <label class="experiment-field"><span>เพิ่มรูปด้วย URL (ใส่ได้หลายบรรทัด)</span><textarea name="images" rows="2" placeholder="https://.../image-1.jpg&#10;https://.../image-2.jpg"></textarea></label>
          </div>
          <div class="experiment-subsection">
            <div class="experiment-subsection-head"><div><h3>ตัวกรองสินค้า</h3><p>เลือกลักษณะที่ตรงกับสินค้านี้ ลูกค้าจะใช้ตัวกรองนี้ค้นหาได้</p></div></div>
            <% if (productFilterTags.length) { %>
              <div class="experiment-filter-options">
                <% productFilterTags.forEach(tag => { %>
                  <label class="experiment-filter-option"><input type="checkbox" name="filterTagIds" value="<%= tag.id %>" <%= selectedFilterTags.includes(tag.id) ? 'checked' : '' %> /><% if (tag.image) { %><img src="<%= tag.image %>" alt="" loading="lazy" /><% } %><span><strong><%= tag.name %></strong><small><%= tag.description || 'ใช้กรองสินค้าหน้าร้าน' %></small></span></label>
                <% }) %>
              </div>
            <% } else { %><p class="experiment-inline-empty">ยังไม่มีตัวกรองสินค้า ไปเพิ่มตัวเลือกได้ที่เมนู “แท็ก/จัดหมวดสินค้า”</p><% } %>
          </div>
        </section>

        <section class="experiment-card experiment-form-panel">
          <div class="experiment-form-panel-head"><div><div><h2>ยืนยันก่อนเพิ่มลงตะกร้า</h2><p>ให้ลูกค้าอ่านและยืนยันเงื่อนไขก่อนซื้อสินค้าชิ้นนี้</p></div></div><span class="experiment-muted-chip">ตัวเลือกการซื้อ</span></div>
          <label class="experiment-check-row"><input type="checkbox" name="purchaseApprovalEnabled" <%= product && product.purchaseApprovalEnabled ? 'checked' : '' %> /> ให้ลูกค้าติ๊กยืนยันก่อนเพิ่มลงตะกร้า</label>
          <p class="experiment-field-note">เมื่อเปิด ลูกค้าติ๊กยืนยันแล้วเพิ่มสินค้าเข้าตะกร้าได้ทันที ไม่ต้องรอแอดมิน</p>
          <div class="experiment-form-grid">
            <label class="experiment-field full"><span>ข้อความยืนยันจากลูกค้า</span><textarea name="purchaseConfirmationText" rows="3" placeholder="เช่น ฉันมีบัญชีเกมที่พร้อมใช้งานและตรวจสอบข้อมูลเรียบร้อยแล้ว"><%= product ? (product.purchaseConfirmationText || '') : '' %></textarea></label>
            <label class="experiment-field"><span>ชื่อปุ่มให้ลูกค้าไปทำก่อน</span><input name="purchaseActionLabel" value="<%= product ? (product.purchaseActionLabel || '') : '' %>" maxlength="80" placeholder="เช่น สมัคร Konami ID ก่อน" /></label>
            <label class="experiment-field"><span>ลิงก์ของปุ่ม</span><input type="url" name="purchaseActionUrl" value="<%= product ? (product.purchaseActionUrl || '') : '' %>" placeholder="https://..." /></label>
          </div>
          <p class="experiment-field-note">ถ้าใส่ลิงก์ ปุ่มจะเปิดหน้าใหม่ให้ลูกค้าไปทำรายการ แล้วกลับมาติ๊กยืนยันและซื้อได้</p>
        </section>

        <section class="experiment-card experiment-form-panel">
          <div class="experiment-form-panel-head"><div><div><h2>ข้อความ Messenger</h2><p>ใช้กับสินค้าที่ให้ลูกค้าติดต่อร้านเพื่อรับสินค้า</p></div></div><span class="experiment-muted-chip">ข้อความสำเร็จรูป</span></div>
          <p class="experiment-field-note">ระบบเติมหมายเลขคำสั่งซื้อ ชื่อสินค้า ชื่อลูกค้า และข้อมูลที่ต้องเตรียมให้อัตโนมัติ ส่วนที่ล็อกไว้แก้ไขไม่ได้</p>
          <label class="experiment-field"><span>คำขึ้นต้น</span><input name="contactMessageIntro" value="<%= product ? (product.contactMessageIntro || '') : '' %>" placeholder="สวัสดีครับ ต้องการติดต่อรับสินค้า" /></label>
          <div class="experiment-message-locked" aria-label="ข้อมูลที่ระบบเติมให้อัตโนมัติ"><span>🔒 หมายเลขคำสั่งซื้อ: #...</span><span>🔒 สินค้า: ...</span><span>🔒 ชื่อลูกค้า: ...</span><span>🔒 ข้อมูลที่ร้านขอให้เตรียม: ... (ถ้ามี)</span></div>
          <label class="experiment-field"><span>คำปิดท้าย</span><input name="contactMessageOutro" value="<%= product ? (product.contactMessageOutro || '') : '' %>" placeholder="กรุณาตรวจสอบออเดอร์และแจ้งขั้นตอนรับสินค้าให้ด้วยครับ" /></label>
        </section>

        <section class="experiment-card experiment-form-panel">
          <div class="experiment-form-panel-head"><div><div><h2>ข้อความในหน้าสินค้า</h2><p>ตั้งข้อความเฉพาะสินค้านี้ หรือเว้นว่างเพื่อใช้ข้อความมาตรฐานของร้าน</p></div></div><span class="experiment-muted-chip">แสดงผลหน้าร้าน</span></div>
          <div class="experiment-content-settings">
            <div><label class="experiment-check-row"><input type="checkbox" name="howToReceiveEnabled" <%= !product || product.howToReceiveEnabled !== false ? 'checked' : '' %> /> แสดงส่วน “วิธีรับสินค้า”</label><label class="experiment-field"><span>รายละเอียดวิธีรับสินค้า</span><textarea name="howToReceiveText" rows="3" placeholder="รับข้อมูลสินค้าทันทีหลังชำระเงินสำเร็จ..."><%= product ? (product.howToReceiveText || '') : '' %></textarea></label></div>
            <div><label class="experiment-check-row"><input type="checkbox" name="termsBeforeOrderEnabled" <%= !product || product.termsBeforeOrderEnabled !== false ? 'checked' : '' %> /> แสดงส่วน “เงื่อนไขก่อนสั่งซื้อ”</label><label class="experiment-field"><span>รายละเอียดเงื่อนไขก่อนสั่งซื้อ</span><textarea name="termsBeforeOrderText" rows="4" placeholder="กรุณาตรวจสอบชื่อสินค้า รายละเอียด และราคาก่อนยืนยันคำสั่งซื้อ..."><%= product ? (product.termsBeforeOrderText || '') : '' %></textarea></label></div>
            <div><label class="experiment-check-row"><input type="checkbox" name="warrantyEnabled" <%= !product || product.warrantyEnabled !== false ? 'checked' : '' %> /> แสดงส่วน “เงื่อนไขการรับประกันสินค้า”</label><label class="experiment-field"><span>รายละเอียดการรับประกัน</span><textarea name="warrantyText" rows="3" placeholder="รับประกันสินค้า 90 วันนับจากวันสั่งซื้อ..."><%= product ? (product.warrantyText || '') : '' %></textarea></label></div>
          </div>
          <% if (editing) { %><label class="experiment-field status-field"><span>สถานะสินค้า</span><select name="status"><option value="active" <%= product.status === 'active' ? 'selected' : '' %>>เปิดขาย</option><option value="hidden" <%= product.status === 'hidden' ? 'selected' : '' %>>ซ่อนอยู่</option></select></label><% } %>
        </section>

        <div class="experiment-form-actions"><a href="/admin/products" class="experiment-button">ยกเลิก</a><button type="submit" class="experiment-button primary"><%= editing ? 'บันทึกข้อมูลสินค้า' : 'เพิ่มสินค้า' %> <span aria-hidden="true">→</span></button></div>
      </form>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin">⌂<span>ภาพรวม</span></a><a class="active" href="/admin/products">▦<span>สินค้า</span></a><a href="/admin/scheduled-products">◷<span>ตั้งเวลา</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>

<script>
  (function () {
    const input = document.getElementById('productImagesInput');
    const dropzone = document.getElementById('productImagesDropzone');
    const preview = document.getElementById('newImagePreview');
    const status = document.getElementById('productImagesStatus');
    if (!input || !dropzone || !preview || !status) return;

    const maxFiles = 10;
    const maxBytes = 8 * 1024 * 1024;
    let selectedFiles = [];
    let dragDepth = 0;

    function fileKey(file) {
      return [file.name, file.size, file.lastModified].join(':');
    }

    function syncInput() {
      const transfer = new DataTransfer();
      selectedFiles.forEach(function (file) { transfer.items.add(file); });
      input.files = transfer.files;
    }

    function renderPreview() {
      preview.replaceChildren();
      preview.hidden = selectedFiles.length === 0;
      selectedFiles.forEach(function (file, index) {
        const card = document.createElement('div');
        card.className = 'experiment-image-choice experiment-new-image-choice';
        const imageFrame = document.createElement('div');
        imageFrame.className = 'experiment-image-preview';
        const image = document.createElement('img');
        const objectUrl = URL.createObjectURL(file);
        image.src = objectUrl;
        image.alt = 'รูปใหม่ ' + (index + 1) + ' ' + file.name;
        image.onload = image.onerror = function () { URL.revokeObjectURL(objectUrl); };
        imageFrame.appendChild(image);

        const meta = document.createElement('div');
        meta.className = 'experiment-image-choice-meta';
        const name = document.createElement('span');
        name.className = 'experiment-new-image-name';
        name.textContent = (index === 0 ? 'รูปแรก · ' : 'รูปที่ ' + (index + 1) + ' · ') + file.name;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'experiment-new-image-remove';
        remove.setAttribute('aria-label', 'นำรูป ' + file.name + ' ออก');
        remove.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="M5 7h14M10 11v6m4-6v6M6.5 7l.8 13h9.4l.8-13M9 7V4h6v3"/></svg>';
        remove.addEventListener('click', function () {
          selectedFiles.splice(index, 1);
          syncInput();
          renderPreview();
        });
        meta.append(name, remove);
        card.append(imageFrame, meta);
        preview.appendChild(card);
      });
      status.textContent = selectedFiles.length
        ? 'เลือกรูปใหม่ ' + selectedFiles.length + ' / ' + maxFiles + ' รูป · รูปแรกจะเป็นภาพปก เว้นแต่เลือกใช้รูปใหม่เป็นภาพปก'
        : 'ยังไม่ได้เลือกรูปใหม่';
    }

    function addFiles(fileList) {
      const incoming = Array.from(fileList || []);
      const existingKeys = new Set(selectedFiles.map(fileKey));
      let added = 0;
      let rejectedType = 0;
      let rejectedSize = 0;
      let rejectedLimit = 0;
      incoming.forEach(function (file) {
        const validMime = /^image\/(png|jpeg|webp|gif)$/i.test(file.type);
        const validExtension = /\.(png|jpe?g|webp|gif)$/i.test(file.name);
        if (!validMime && !validExtension) { rejectedType += 1; return; }
        if (file.size > maxBytes) { rejectedSize += 1; return; }
        const key = fileKey(file);
        if (existingKeys.has(key)) return;
        if (selectedFiles.length >= maxFiles) { rejectedLimit += 1; return; }
        selectedFiles.push(file);
        existingKeys.add(key);
        added += 1;
      });

      syncInput();
      renderPreview();
      const messages = [];
      if (added) messages.push('เพิ่ม ' + added + ' รูป');
      if (rejectedType) messages.push('ข้าม ' + rejectedType + ' ไฟล์ที่ไม่ใช่รูปแบบที่รองรับ');
      if (rejectedSize) messages.push('ข้าม ' + rejectedSize + ' รูปที่เกิน 8 MB');
      if (rejectedLimit) messages.push('เพิ่มได้สูงสุด ' + maxFiles + ' รูปต่อครั้ง');
      if (!messages.length && incoming.length) messages.push('รูปเหล่านี้อยู่ในรายการแล้ว');
      if (messages.length) status.textContent = messages.join(' · ') + (selectedFiles.length ? ' — รวม ' + selectedFiles.length + ' / ' + maxFiles + ' รูป' : '');
    }

    input.addEventListener('change', function () { addFiles(input.files); });
    ['dragenter', 'dragover'].forEach(function (type) {
      dropzone.addEventListener(type, function (event) {
        event.preventDefault();
        event.stopPropagation();
        dragDepth += 1;
        dropzone.classList.add('is-dragging');
        dropzone.style.borderColor = '#8c5e12';
        dropzone.style.backgroundColor = '#f4ead5';
      });
    });
    ['dragleave', 'dragend'].forEach(function (type) {
      dropzone.addEventListener(type, function (event) {
        event.preventDefault();
        event.stopPropagation();
        dragDepth = Math.max(0, dragDepth - 1);
        if (!dragDepth) clearDragState();
      });
    });
    function clearDragState() {
      dropzone.classList.remove('is-dragging');
      dropzone.style.removeProperty('border-color');
      dropzone.style.removeProperty('background-color');
    }
    dropzone.addEventListener('drop', function (event) {
      event.preventDefault();
      event.stopPropagation();
      dragDepth = 0;
      clearDragState();
      addFiles(event.dataTransfer && event.dataTransfer.files);
    });
  })();
</script>
