<link rel="stylesheet" href="<%= asset('css/admin-experiment-scheduled-form-v1.css') %>" />
<%
  const editing = Boolean(product);
  const formAction = editing ? `/admin/products/${product.id}/edit?ui=experiment` : '/admin/products/new?ui=experiment';
  const scheduleValue = product && product.publishAt ? String(product.publishAt).slice(0, 16) : '';
  const imageValue = product && product.images && product.images[0] ? product.images[0] : '';
%>
<div class="experiment-app experiment-schedule-form-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ · รุ่นทดลอง</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin?ui=experiment"><span aria-hidden="true">▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products?ui=experiment"><span aria-hidden="true">◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item active" href="/admin/scheduled-products?ui=experiment"><span aria-hidden="true">◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><span aria-hidden="true">◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item" href="/admin/recommended-categories"><span aria-hidden="true">☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><span aria-hidden="true">▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span aria-hidden="true">▭</span><span>เติมเงิน & ตรวจสอบ</span></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span aria-hidden="true">⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main">
    <header class="experiment-topbar"><button class="experiment-icon-button" data-experiment-notifications type="button" aria-label="ดูการแจ้งเตือน"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></button><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header>
    <main class="experiment-content">
      <div class="experiment-page-head"><div><div class="experiment-kicker">ทดลองหน้าตาใหม่ · ตั้งเวลาเปิดขาย</div><h1><%= editing ? 'แก้ไขเวลาขาย' : 'สร้างสินค้าแบบตั้งเวลา' %></h1><p><%= editing ? 'แก้ชื่อ ราคา และกำหนดเวลาเปิดขายจากหน้าเดียว' : 'สร้างสินค้าใหม่พร้อมกำหนดวันและเวลาเปิดขายอัตโนมัติ' %></p></div><div class="experiment-actions"><a href="/admin/scheduled-products?ui=experiment" class="experiment-button">← กลับคิวเปิดขาย</a></div></div>
      <div class="experiment-page-status-note"><strong>สถานะหน้านี้:</strong> แบบฟอร์มตั้งเวลาใช้งานได้ · เมื่อบันทึกแล้วสินค้าจะกลับไปอยู่ในคิวเปิดขายทันที</div>

      <form class="experiment-schedule-form" action="<%= formAction %>" method="post" data-schedule-form>
        <section class="experiment-card experiment-form-panel"><div class="experiment-form-panel-head"><div><span class="experiment-form-step">01</span><div><h2>ข้อมูลสินค้า</h2><p>ข้อมูลที่จะแสดงในรายการสินค้าและหน้าร้าน</p></div></div><span class="experiment-ready-chip"><i></i> ใช้งานได้</span></div><div class="experiment-form-grid"><label class="experiment-field full"><span>ชื่อสินค้า <b>*</b></span><input name="title" value="<%= product ? (product.title || '') : '' %>" placeholder="เช่น Shadow Realm Chronicles" required maxlength="160" /></label><label class="experiment-field"><span>ราคาขาย (บาท) <b>*</b></span><input type="number" name="price" value="<%= product ? (product.price || 0) : '' %>" min="0" step="1" placeholder="0" required /></label><label class="experiment-field"><span>ราคาเดิม (ถ้ามี)</span><input type="number" name="originalPrice" value="<%= product ? (product.originalPrice || '') : '' %>" min="0" step="1" placeholder="เช่น 990" /></label><label class="experiment-field full"><span>ลิงก์รูปปกสินค้า</span><input type="url" name="images" value="<%= imageValue %>" placeholder="https://.../image.jpg" /><small>ใส่ URL รูปภาพได้ทันที หรือเว้นว่างเพื่อใช้ภาพสำรองของร้าน</small></label><label class="experiment-field full"><span>คำอธิบายสั้น</span><textarea name="description" rows="3" placeholder="อธิบายสินค้าแบบสั้น ๆ ให้ลูกค้าเข้าใจทันที"><%= product ? (product.description || '') : '' %></textarea></label></div></section>

        <section class="experiment-card experiment-form-panel experiment-form-panel-highlight"><div class="experiment-form-panel-head"><div><span class="experiment-form-step green">02</span><div><h2>กำหนดเวลาเปิดขาย</h2><p>ใช้เวลาเขตประเทศไทย (Asia/Bangkok) และเปิดขายอัตโนมัติ</p></div></div><span class="experiment-ready-chip green"><i></i> ระบบอัตโนมัติ</span></div><div class="experiment-form-grid"><label class="experiment-field full"><span>วันและเวลาเปิดขาย <b>*</b></span><div class="experiment-datetime-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg><input type="datetime-local" name="publishAt" value="<%= scheduleValue %>" required /></div><small class="experiment-form-hint">เวลาที่กรอกจะตีความเป็นเวลาไทย เช่น 20:00 คือสองทุ่มประเทศไทย</small></label><label class="experiment-field"><span>ป้ายกิจกรรม</span><input name="eventBadge" value="<%= product ? (product.eventBadge || '') : '' %>" placeholder="เช่น LIMITED" maxlength="40" /></label><label class="experiment-field"><span>คำโปรยบนการ์ด</span><input name="eventDescription" value="<%= product ? (product.eventDescription || '') : '' %>" placeholder="เช่น เปิดขายจำนวนจำกัด" maxlength="160" /></label></div><div class="experiment-form-callout"><span class="experiment-callout-icon">ICT</span><div><strong>ระบบจะจัดสถานะให้เอง</strong><p>ก่อนถึงเวลา = รอเวลาเปิดขาย · หลังถึงเวลา = ถึงเวลาแล้ว และสินค้าจะเปิดขายตามระบบเดิม</p></div></div></section>

        <section class="experiment-card experiment-form-panel"><div class="experiment-form-panel-head"><div><span class="experiment-form-step muted">03</span><div><h2>ตรวจสอบก่อนบันทึก</h2><p>ข้อมูลส่วนนี้เป็นตัวเลือกเพิ่มเติมสำหรับระบบสินค้าเดิม</p></div></div><span class="experiment-muted-chip">ตัวเลือก</span></div><label class="experiment-field full"><span>รายละเอียดสินค้าเพิ่มเติม</span><textarea name="aboutText" rows="4" placeholder="ข้อมูลที่อยากให้ลูกค้าอ่านในหน้ารายละเอียดสินค้า"><%= product ? (product.aboutText || '') : '' %></textarea></label><% if (editing) { %><label class="experiment-field full"><span>สถานะสินค้า</span><select name="status"><option value="active" <%= product.status === 'active' ? 'selected' : '' %>>เปิดขาย</option><option value="hidden" <%= product.status === 'hidden' ? 'selected' : '' %>>ซ่อนอยู่</option></select></label><% } %></section>

        <div class="experiment-form-actions"><a href="/admin/scheduled-products?ui=experiment" class="experiment-button">ยกเลิก</a><button type="submit" class="experiment-button primary"><%= editing ? 'บันทึกการตั้งเวลา' : 'สร้างและตั้งเวลาเปิดขาย' %> <span aria-hidden="true">→</span></button></div>
      </form>
    </main>
  </div>
  <nav class="experiment-mobile-nav" aria-label="เมนูมือถือ"><a href="/admin?ui=experiment">⌂<span>ภาพรวม</span></a><a href="/admin/products?ui=experiment">▦<span>สินค้า</span></a><a class="active" href="/admin/scheduled-products?ui=experiment">◷<span>ตั้งเวลา</span></a><a href="/admin/orders">▤<span>คำสั่งซื้อ</span></a><a href="/admin/settings">⚙<span>ตั้งค่า</span></a></nav>
</div>
