<div class="mb-5 rounded-xl border border-[var(--border)] bg-[var(--card)] p-4">
  <h2 class="font-semibold text-[var(--text)]">ธีมเดียว อ่านชัดทั้งหน้าร้านและหลังบ้าน</h2>
  <p class="mt-1 text-sm text-[var(--text-3)]">เลือก <b>สีหลัก</b> สำหรับปุ่มและจุดเด่น แล้วเลือก <b>โทนพื้นหลัง</b> ระบบจะสร้างคู่สีข้อความที่อ่านง่ายให้ทั้งโหมดมืดและสว่างอัตโนมัติ การตั้งค่านี้มีผลกับทุกหน้า</p>
</div>

<form action="/admin/theme" method="post" class="space-y-6 w-full">
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-1">🎯 สีหลัก (ปุ่ม / ราคา / จุดเด่น)</h3>
    <p class="text-xs text-[var(--text-4)] mb-4">ใช้กับปุ่ม, ตัวหนังสือราคา, กรอบการ์ดสินค้า, ป้ายต่างๆ ทั่วเว็บ</p>
    <div class="grid grid-cols-4 sm:grid-cols-6 gap-3 mb-4">
      <% accentPresets.forEach(p => { %>
        <label class="flex flex-col items-center gap-1 cursor-pointer">
          <input type="radio" name="accent" value="<%= p.color %>" class="accent-swatch-input sr-only" <%= currentTheme.accent === p.color ? 'checked' : '' %> />
          <span class="accent-swatch w-10 h-10 rounded-full border-2 border-transparent transition" style="background: <%= p.color %>;"></span>
          <span class="text-[9px] text-[var(--text-4)] text-center leading-tight"><%= p.label %></span>
        </label>
      <% }) %>
    </div>
    <label class="flex items-center gap-3 text-sm">
      <span class="text-[var(--text-3)]">หรือเลือกสีเอง:</span>
      <input type="color" id="accentCustomInput" value="<%= currentTheme.accent %>" class="w-12 h-9 rounded-lg border border-[var(--border-light)] bg-transparent cursor-pointer" />
    </label>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-1">🌗 โทนพื้นหลัง</h3>
    <p class="text-xs text-[var(--text-4)] mb-4">คุมพื้นหลัง/การ์ด/ตัวหนังสือให้เข้ากันเป็นชุด (มีทั้งโหมดมืดและสว่างในตัว สลับได้ด้วยปุ่ม 🌙 บนเว็บ)</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
      <% bgPresets.forEach(p => { %>
        <label class="bg-preset-card relative flex flex-col gap-2 rounded-xl border-2 border-[var(--border-light)] bg-[var(--input)] p-3 cursor-pointer">
          <input type="radio" name="bgPreset" value="<%= p.key %>" class="bg-preset-input sr-only" <%= (!currentTheme.bgColor && currentTheme.bgPreset === p.key) ? 'checked' : '' %> />
          <span class="text-xs font-medium"><%= p.label %></span>
          <span class="grid grid-cols-2 gap-1" aria-hidden="true">
            <span class="rounded-md border p-2 text-center text-[9px]" style="background:<%= p.preview.dark.card %>;border-color:<%= p.preview.dark.text %>55;color:<%= p.preview.dark.text %>">มืด</span>
            <span class="rounded-md border p-2 text-center text-[9px]" style="background:<%= p.preview.light.card %>;border-color:<%= p.preview.light.text %>55;color:<%= p.preview.light.text %>">สว่าง</span>
          </span>
          <span class="bg-preset-check hidden absolute top-2 right-2 text-[var(--gold-text)] text-xs">✓</span>
        </label>
      <% }) %>
    </div>
    <label class="flex items-center gap-3 text-sm">
      <span class="text-[var(--text-3)]">หรือเลือกสีพื้นหลังเอง:</span>
      <input type="color" id="bgCustomInput" value="<%= currentTheme.bgColor || '#c8a63f' %>" class="w-12 h-9 rounded-lg border border-[var(--border-light)] bg-transparent cursor-pointer" />
    </label>
    <input type="hidden" name="bgMode" id="bgModeInput" value="<%= currentTheme.bgColor ? 'custom' : 'preset' %>" />
    <input type="hidden" name="bgColor" id="bgColorInput" value="<%= currentTheme.bgColor || '' %>" />
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-1">✨ ลูกเล่นพิเศษ</h3>
    <p class="text-xs text-[var(--text-4)] mb-4">เพิ่มลูกเล่นให้ปุ่มและจุดเด่นในเว็บ</p>
    <div class="grid grid-cols-3 gap-3">
      <% styles.forEach(s => { %>
        <label class="style-card relative flex flex-col items-center gap-1 rounded-xl border-2 border-[var(--border-light)] bg-[var(--input)] p-3 cursor-pointer text-center">
          <input type="radio" name="style" value="<%= s.key %>" class="style-input sr-only" <%= currentTheme.style === s.key ? 'checked' : '' %> />
          <span class="text-xs font-medium"><%= s.label %></span>
          <span class="style-check hidden absolute top-2 right-2 text-[var(--gold-text)] text-xs">✓</span>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="theme-live-preview rounded-xl border border-[var(--border)] bg-[var(--input)] p-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h3 class="font-semibold">ตัวอย่างสีที่ใช้งานจริง</h3>
        <p class="text-xs text-[var(--text-4)]">ลองสลับ 🌙 / ☀️ ด้านบนเพื่อตรวจทั้งสองโหมดก่อนบันทึก</p>
      </div>
      <span class="rounded-full border border-[var(--border-light)] px-2 py-1 text-[10px] text-[var(--text-3)]">Light + Dark</span>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-4">
        <div class="font-semibold text-[var(--text)]">ข้อความหลัก</div>
        <div class="mt-1 text-xs text-[var(--text-3)]">ข้อความรองยังอ่านได้ชัดบนการ์ด</div>
        <div class="mt-3 flex flex-wrap gap-2">
          <span data-theme-fill="accent" class="rounded-lg bg-[var(--gold)] px-3 py-2 text-xs font-bold">ปุ่มสีหลัก</span>
          <span class="rounded-lg border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-xs text-[var(--text)]">ปุ่มรอง</span>
        </div>
      </div>
      <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-4 text-xs">
        <div class="theme-success font-semibold">● สำเร็จ / พร้อมขาย</div>
        <div class="theme-warning mt-2 font-semibold">● รอตรวจสอบ</div>
        <div class="theme-danger mt-2 font-semibold">● ผิดพลาด / สินค้าหมด</div>
      </div>
    </div>
  </div>

  <p class="text-xs text-[var(--text-4)]">💡 อยากเปลี่ยนรูปแบบการ์ดสินค้า (คลาสสิก/เต็มรูป) ไปตั้งได้ที่หน้า <a href="/admin/products" class="text-[var(--gold-text)] underline">สินค้า</a> ด้านบนตารางเลยครับ</p>

  <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium rounded-lg py-2.5 text-sm">บันทึกธีมสี</button>
</form>

<style>
  .accent-swatch-input:checked + .accent-swatch { border-color: var(--text); box-shadow: 0 0 0 2px var(--card), 0 0 0 4px var(--gold); }
  .bg-preset-input:checked ~ .bg-preset-check { display: block; }
  .style-input:checked ~ .style-check { display: block; }
  .bg-preset-card:focus-within,.style-card:focus-within,label:has(.accent-swatch-input:focus-visible) .accent-swatch { outline: 2px solid var(--gold-text); outline-offset: 2px; }
</style>
<script>
  (function () {
    const form = document.querySelector('form[action="/admin/theme"]');
    const customInput = document.getElementById('accentCustomInput');
    const radios = document.querySelectorAll('.accent-swatch-input');
    function useCustomAccent() {
      radios.forEach(r => { r.checked = false; });
      let hidden = document.getElementById('accentCustomRadio');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'radio';
        hidden.name = 'accent';
        hidden.id = 'accentCustomRadio';
        hidden.className = 'sr-only';
        customInput.closest('form').appendChild(hidden);
      }
      hidden.value = customInput.value;
      hidden.checked = true;
    }
    customInput.addEventListener('input', useCustomAccent);
    customInput.addEventListener('change', useCustomAccent);

    const bgPresetCards = document.querySelectorAll('.bg-preset-card');
    const bgPresetInputs = document.querySelectorAll('.bg-preset-input');
    const bgCustomInput = document.getElementById('bgCustomInput');
    const bgModeInput = document.getElementById('bgModeInput');
    const bgColorInput = document.getElementById('bgColorInput');

    function syncBgCard(card) {
      const input = card.querySelector('.bg-preset-input');
      card.classList.toggle('border-[var(--gold)]', input.checked);
    }
    bgPresetCards.forEach((card) => {
      const input = card.querySelector('.bg-preset-input');
      input.addEventListener('change', () => {
        bgModeInput.value = 'preset';
        bgColorInput.value = '';
        bgPresetCards.forEach(syncBgCard);
      });
      syncBgCard(card);
    });
    function useCustomBg() {
      bgPresetInputs.forEach(r => { r.checked = false; });
      bgPresetCards.forEach(c => c.classList.remove('border-[var(--gold)]'));
      bgModeInput.value = 'custom';
      bgColorInput.value = bgCustomInput.value;
    }
    bgCustomInput.addEventListener('input', useCustomBg);
    bgCustomInput.addEventListener('change', useCustomBg);

    document.querySelectorAll('.style-card').forEach((card) => {
      const input = card.querySelector('.style-input');
      function sync() { card.classList.toggle('border-[var(--gold)]', input.checked); }
      input.addEventListener('change', () => {
        document.querySelectorAll('.style-card').forEach(c => c.classList.remove('border-[var(--gold)]'));
        sync();
      });
      sync();
    });

    // Safety net: some mobile browsers are inconsistent about firing input/change
    // on <input type="color">. Re-sync the hidden fields from the live picker
    // values right before submit so a custom pick is never silently lost.
    if (form) {
      form.addEventListener('submit', () => {
        const anyPresetChecked = Array.from(bgPresetInputs).some(r => r.checked);
        if (!anyPresetChecked) useCustomBg();
      });
    }
  })();
</script>
