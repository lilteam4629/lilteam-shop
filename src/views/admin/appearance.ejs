<div class="studio-page-head mb-6 xl:col-span-2">
  <div>
    <span class="studio-page-kicker">BRAND MEDIA</span>
    <h1>รูปและแบนเนอร์</h1>
    <p>จัดการเฉพาะโลโก้และภาพหลักของร้าน แยกจากธีมและป้ายประกาศ</p>
  </div>
  <a href="/" target="_blank" rel="noopener" class="studio-secondary-action">ดูหน้าร้าน ↗</a>
</div>
<div class="grid xl:grid-cols-2 gap-6 w-full">
  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 md:p-6">
    <div class="flex items-start gap-3 mb-5">
      <span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 text-[var(--gold-text)] flex items-center justify-center text-xl">🏷️</span>
      <div>
        <h2 class="font-semibold text-lg">โลโก้เว็บไซต์</h2>
        <p class="text-xs text-[var(--text-4)]">โลโก้จะแสดงที่แถบเมนู ส่วนท้ายเว็บ และไอคอนแท็บเบราว์เซอร์</p>
      </div>
    </div>

    <div class="rounded-xl border border-dashed border-[var(--border-light)] bg-[var(--input)] min-h-48 flex items-center justify-center p-6 mb-4">
      <% if (settings.branding && settings.branding.logoImage) { %>
        <img src="<%= settings.branding.logoImage %>" class="max-w-full max-h-40 object-contain" alt="โลโก้เว็บไซต์ปัจจุบัน" />
      <% } else { %>
        <div class="text-center text-[var(--text-4)]">
          <div class="w-20 h-20 mx-auto mb-3 rounded-2xl bg-[var(--gold)] text-[var(--gold-contrast)] flex items-center justify-center text-4xl font-bold">L</div>
          <p class="text-sm">ยังไม่ได้อัปโหลดโลโก้</p>
          <p class="text-[var(--gold-text)]/70 text-[10px] font-mono mt-1">ขนาดแนะนำ: 512 x 512</p>
        </div>
      <% } %>
    </div>

    <form action="/admin/site-logo/upload" method="post" enctype="multipart/form-data" class="space-y-3">
      <label class="block text-sm text-[var(--text-3)]">เลือกรูปโลโก้ (แนะนำ PNG พื้นหลังโปร่งใส หรือรูปสี่เหลี่ยมจัตุรัส)</label>
      <input type="file" name="logoImage" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" required class="block w-full text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold-text)] file:text-sm" />
      <button class="w-full sm:w-auto bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium px-6 py-2.5 rounded-lg text-sm">อัปโหลดโลโก้</button>
    </form>
  </section>

  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 md:p-6">
    <div class="flex items-start gap-3 mb-5">
      <span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 text-[var(--gold-text)] flex items-center justify-center text-xl">🖼️</span>
      <div>
        <h2 class="font-semibold text-lg">ภาพแบนเนอร์หน้าหลัก</h2>
        <p class="text-xs text-[var(--text-4)]">ใช้รูปภาพเต็มความกว้างแทนส่วนการ์ดเกมด้านบนของหน้าแรก</p>
      </div>
    </div>

    <% if (settings.hero.bannerImage) { %>
      <img src="<%= settings.hero.bannerImage %>" class="w-full aspect-[3/1] object-cover rounded-xl border border-[var(--border)] mb-4" alt="แบนเนอร์หน้าหลัก" />
    <% } else { %>
      <div class="mb-4"><%- include('../partials/image-placeholder', { w: 1800, h: 600, ratioClass: 'aspect-[3/1]' }) %></div>
    <% } %>

    <form action="/admin/hero-banner/upload" method="post" enctype="multipart/form-data" class="space-y-3 mb-6">
      <label class="block text-sm text-[var(--text-3)]">เลือกรูปแบนเนอร์ (แนะนำอัตราส่วน 3:1)</label>
      <input type="file" name="bannerImage" accept="image/*" required class="block w-full text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold-text)] file:text-sm" />
      <button class="w-full sm:w-auto bg-[var(--input)] hover:bg-[var(--border-light)] border border-[var(--border-light)] text-[var(--gold-text)] px-6 py-2.5 rounded-lg text-sm">อัปโหลดแบนเนอร์</button>
    </form>

    <form action="/admin/hero-banner/mode" method="post" class="space-y-4">
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">ลิงก์เมื่อคลิกแบนเนอร์ (ไม่บังคับ)</label>
        <input name="bannerLink" value="<%= settings.hero.bannerLink %>" placeholder="/products" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="flex items-center gap-2 bg-[var(--input)] border-2 <%= settings.hero.mode === 'default' ? 'border-[var(--gold)]' : 'border-[var(--border-light)]' %> rounded-xl px-4 py-3 cursor-pointer text-sm">
          <input type="radio" name="mode" value="default" <%= settings.hero.mode === 'default' ? 'checked' : '' %> class="accent-[var(--gold)]" />
          ใช้การ์ดเกมแบบเดิม
        </label>
        <label class="flex items-center gap-2 bg-[var(--input)] border-2 <%= settings.hero.mode === 'banner' ? 'border-[var(--gold)]' : 'border-[var(--border-light)]' %> rounded-xl px-4 py-3 cursor-pointer text-sm">
          <input type="radio" name="mode" value="banner" <%= settings.hero.mode === 'banner' ? 'checked' : '' %> class="accent-[var(--gold)]" />
          ใช้ภาพแบนเนอร์
        </label>
      </div>
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium px-6 py-2.5 rounded-lg text-sm">บันทึกรูปแบบหน้าแรก</button>
    </form>
  </section>

  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 md:p-6 xl:col-span-2">
    <div class="flex items-start gap-3 mb-5"><span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 text-[var(--gold-text)] flex items-center justify-center text-xl">▧</span><div><h2 class="font-semibold text-lg">ภาพพื้นหลังหน้าร้าน</h2><p class="text-xs text-[var(--text-4)]">แสดงสีจริงของรูปตั้งแต่ขอบบน กว้างพอดีหน้าจอ และรักษาสัดส่วนเดิมโดยไม่ครอป</p></div></div>
    <% const storefrontBackground = settings.storefrontAppearance && settings.storefrontAppearance.backgroundImage; %>
    <% if (storefrontBackground) { %><div class="w-full min-h-56 max-h-[440px] flex items-center justify-center overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--input)] p-3 mb-4"><img src="<%= storefrontBackground %>" class="block max-w-full max-h-[410px] object-contain" alt="ภาพพื้นหลังหน้าร้าน" /></div><% } else { %><div class="auth-background-empty mb-4"><strong>ยังไม่ได้เลือกภาพพื้นหลังหน้าร้าน</strong><span>เลือกรูปแนวตั้ง แนวนอน หรือจัตุรัสได้ ภาพจะแสดงครบทั้งใบ</span></div><% } %>
    <div class="flex flex-col sm:flex-row gap-3">
      <form action="/admin/storefront-background/upload" method="post" enctype="multipart/form-data" class="flex-1 space-y-3"><label class="block"><span class="block text-sm font-semibold text-[var(--text-2)] mb-1">เลือกรูปพื้นหลังหน้าร้าน</span><span class="block text-[11px] text-[var(--gold-text)] mb-2">ขนาดแนะนำ 1920 × 1080 px (16:9) · JPG หรือ WEBP · ไม่เกิน 10 MB</span><input type="file" name="storefrontBackgroundImage" accept="image/png,image/jpeg,image/webp" required class="block w-full text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold-text)] file:text-sm" /></label><button class="w-full sm:w-auto bg-[var(--gold)] text-[var(--gold-contrast)] font-medium px-6 py-2.5 rounded-lg text-sm">อัปโหลดพื้นหลังหน้าร้าน</button></form>
      <% if (storefrontBackground) { %><form action="/admin/storefront-background/remove" method="post" data-confirm="ลบภาพพื้นหลังหน้าร้านและกลับไปใช้พื้นธีมปกติใช่หรือไม่?"><button class="border border-[var(--coral)]/40 text-[var(--coral)] px-5 py-2.5 rounded-lg text-sm">ลบภาพพื้นหลัง</button></form><% } %>
    </div>
  </section>

  <% const heroTextStyle = (settings.hero && settings.hero.textStyle) || { textColor: '#ffffff', outlineColor: '#000000', outlineWidth: 1.5 }; %>
  <section id="hero-text-style" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 md:p-6 xl:col-span-2">
    <div class="flex items-start gap-3 mb-5">
      <span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 text-[var(--gold-text)] flex items-center justify-center text-xl">Aa</span>
      <div><h2 class="font-semibold text-lg">สีและขอบข้อความหน้าหลัก</h2><p class="text-xs text-[var(--text-4)]">ปรับข้อความบนภาพพื้นหลังให้อ่านชัด ค่าแนะนำคืออักษรขาว ขอบดำ 1.5 px</p></div>
    </div>
    <form action="/admin/hero-text-style" method="post" class="space-y-5">
      <div id="hero-text-preview" class="rounded-xl border border-[var(--border)] p-5 sm:p-7 overflow-hidden" style="background:linear-gradient(120deg,#eaf3fa 0 50%,#253448 50%);color:<%= heroTextStyle.textColor %>;">
        <strong class="block text-2xl sm:text-4xl leading-tight" style="-webkit-text-stroke:<%= heroTextStyle.outlineWidth %>px <%= heroTextStyle.outlineColor %>;paint-order:stroke fill;">ยินดีต้อนรับสู่ <%= settings.shopName %></strong>
        <span class="block mt-2 text-sm font-bold" style="-webkit-text-stroke:<%= Number(heroTextStyle.outlineWidth) * .55 %>px <%= heroTextStyle.outlineColor %>;paint-order:stroke fill;"><%= settings.tagline %></span>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <label class="block"><span class="block text-sm font-semibold text-[var(--text-2)] mb-2">สีตัวอักษร</span><input id="hero-text-color" type="color" name="textColor" value="<%= heroTextStyle.textColor %>" class="w-full h-11 rounded-lg border border-[var(--border-light)] bg-[var(--input)] p-1 cursor-pointer" /></label>
        <label class="block"><span class="block text-sm font-semibold text-[var(--text-2)] mb-2">สีขอบ</span><input id="hero-outline-color" type="color" name="outlineColor" value="<%= heroTextStyle.outlineColor %>" class="w-full h-11 rounded-lg border border-[var(--border-light)] bg-[var(--input)] p-1 cursor-pointer" /></label>
        <label class="block"><span class="flex justify-between text-sm font-semibold text-[var(--text-2)] mb-2"><span>ความหนาขอบ</span><span id="hero-outline-value"><%= heroTextStyle.outlineWidth %> px</span></span><input id="hero-outline-width" type="range" name="outlineWidth" min="0" max="4" step="0.25" value="<%= heroTextStyle.outlineWidth %>" class="w-full h-11 accent-[var(--gold)] cursor-pointer" /><span class="block text-[11px] text-[var(--text-4)]">เลือก 0 หากไม่ต้องการขอบ</span></label>
      </div>
      <button class="w-full sm:w-auto bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium px-6 py-2.5 rounded-lg text-sm">บันทึกสีและขอบข้อความ</button>
    </form>
  </section>

  <section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 md:p-6 xl:col-span-2">
    <div class="flex items-start gap-3 mb-5">
      <span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 text-[var(--gold-text)] flex items-center justify-center text-xl">▣</span>
      <div>
        <h2 class="font-semibold text-lg">พื้นหลังเข้าสู่ระบบและสมัครสมาชิก</h2>
        <p class="text-xs text-[var(--text-4)]">อัปโหลดรูปแนวตั้ง แนวนอน หรือจัตุรัสได้ ระบบจะแสดงครบทั้งภาพโดยไม่ครอป หากไม่เลือกจะใช้พื้นธีมปกติ</p>
      </div>
    </div>
    <% const authBackground = settings.authAppearance && settings.authAppearance.backgroundImage; %>
    <% if (authBackground) { %>
      <div class="auth-background-preview mb-4"><img src="<%= authBackground %>" alt="พื้นหลังหน้าเข้าสู่ระบบ" /></div>
    <% } else { %>
      <div class="auth-background-empty mb-4"><strong>ยังไม่ได้เลือกรูปพื้นหลัง</strong><span>รองรับรูปทุกสัดส่วนและจะแสดงเต็มภาพ</span></div>
    <% } %>
    <div class="flex flex-col sm:flex-row gap-3">
      <form action="/admin/auth-background/upload" method="post" enctype="multipart/form-data" class="flex-1 space-y-3">
        <input type="file" name="authBackgroundImage" accept="image/png,image/jpeg,image/webp" required class="block w-full text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold-text)] file:text-sm" />
        <button class="w-full sm:w-auto bg-[var(--gold)] text-[var(--gold-contrast)] font-medium px-6 py-2.5 rounded-lg text-sm">อัปโหลดพื้นหลัง</button>
      </form>
      <% if (authBackground) { %><form action="/admin/auth-background/remove" method="post" data-confirm="ลบรูปพื้นหลังเข้าสู่ระบบและกลับไปใช้พื้นธีมปกติใช่หรือไม่?"><button class="border border-[var(--coral)]/40 text-[var(--coral)] px-5 py-2.5 rounded-lg text-sm">ลบรูปพื้นหลัง</button></form><% } %>
    </div>
  </section>

</div>
<script>
(() => {
  const preview = document.getElementById('hero-text-preview');
  const textColor = document.getElementById('hero-text-color');
  const outlineColor = document.getElementById('hero-outline-color');
  const outlineWidth = document.getElementById('hero-outline-width');
  const value = document.getElementById('hero-outline-value');
  if (!preview || !textColor || !outlineColor || !outlineWidth) return;
  const update = () => {
    const width = Number(outlineWidth.value);
    preview.style.color = textColor.value;
    preview.querySelector('strong').style.webkitTextStroke = `${width}px ${outlineColor.value}`;
    preview.querySelector('span').style.webkitTextStroke = `${width * .55}px ${outlineColor.value}`;
    value.textContent = `${width} px`;
  };
  [textColor, outlineColor, outlineWidth].forEach(input => input.addEventListener('input', update));
  update();
})();
</script>
