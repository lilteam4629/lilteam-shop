<section class="mx-auto max-w-6xl space-y-6">
  <header class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-[var(--gold-text)]">CATALOG API</p>
        <h1 class="mt-1 text-2xl font-black text-[var(--text)]">ยิงสินค้าไปยังร้านเช่า</h1>
        <p class="mt-2 max-w-2xl text-sm text-[var(--text-3)]">ร้านเช่าจะเห็นข้อมูลสินค้าและราคาที่บวกแล้วแบบย่อ สต็อกไอดีและรหัสสินค้าไม่ถูกส่งออกจากร้านหลัก การชำระเงินจะกลับมาที่ร้านหลักเสมอ</p>
      </div>
      <span class="rounded-full border px-3 py-1 text-xs font-bold <%= tenantMode && config.enabled ? 'border-emerald-400/40 bg-emerald-500/10 text-emerald-400' : 'border-[var(--border)] text-[var(--text-3)]' %>"><%= tenantMode ? (config.enabled ? 'เปิดใช้งาน' : 'ปิดใช้งาน') : 'ร้านหลัก' %></span>
    </div>
  </header>

  <% if (tenantMode) { %>
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6">
      <form action="/admin/catalog-api/settings" method="post" class="grid gap-5 lg:grid-cols-[1.2fr_1fr_1fr_auto] lg:items-end">
        <label class="flex items-center gap-3 rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-4 py-3">
          <input type="checkbox" name="enabled" <%= config.enabled ? 'checked' : '' %> class="h-5 w-5 accent-[var(--gold)]" />
          <span><b class="block text-sm text-[var(--text)]">รับสินค้าจากร้านหลัก</b><small class="text-xs text-[var(--text-4)]">แสดงสินค้าทั้งหมดในหน้าร้านนี้</small></span>
        </label>
        <label class="text-sm font-semibold text-[var(--text-2)]">รูปแบบบวกราคา
          <select name="markupMode" class="mt-2 w-full rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2.5 text-sm"><option value="percent" <%= config.markupMode === 'percent' ? 'selected' : '' %>>เปอร์เซ็นต์ (%)</option><option value="fixed" <%= config.markupMode === 'fixed' ? 'selected' : '' %>>จำนวนเงิน (บาท)</option></select>
        </label>
        <label class="text-sm font-semibold text-[var(--text-2)]">เพิ่มราคาทุกชิ้น
          <input name="markupValue" type="number" min="0" step="0.01" value="<%= config.markupValue %>" class="mt-2 w-full rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2.5 text-sm" />
        </label>
        <div class="lg:col-span-4 rounded-xl border border-[var(--border-light)] bg-[var(--input)]/55 p-4">
          <div class="mb-3 flex flex-wrap items-end justify-between gap-2"><div><b class="block text-sm text-[var(--text)]">สินค้า Partner ที่โชว์บนหน้าหลักร้านเช่า</b><small class="text-xs text-[var(--text-4)]">แสดงเฉพาะสินค้าที่ยังมีไอดีพร้อมขาย · เลือกได้สูงสุด 5 ไอดี</small></div><span id="featuredApiCount" class="text-xs font-black text-[var(--gold-text)]"><%= config.featuredProductIds.length %>/5 รายการ</span></div>
          <div class="grid max-h-72 gap-2 overflow-y-auto sm:grid-cols-2 lg:grid-cols-3">
            <% sourceProducts.forEach(product => { const selected = config.featuredProductIds.includes(String(product.id)); %>
              <label class="featured-api-option flex cursor-pointer items-center gap-2 rounded-lg border border-[var(--border-light)] bg-[var(--card)] p-2 transition hover:border-[var(--gold)] <%= selected ? 'is-selected border-[var(--gold)]/70' : '' %>">
                <input type="checkbox" name="featuredProductIds" value="<%= product.id %>" <%= selected ? 'checked' : '' %> class="featured-api-checkbox h-4 w-4 accent-[var(--gold)]" />
                <button type="button" data-api-gallery data-title="<%= product.title %>" data-image="<%= product.images?.[0] || '' %>" class="h-10 w-14 shrink-0 cursor-zoom-in overflow-hidden rounded focus:outline-none focus:ring-2 focus:ring-[var(--gold)]" title="กดเพื่อดูรูปสินค้า <%= product.title %> ขนาดใหญ่"><img src="<%= product.images?.[0] || '' %>" alt="รูป <%= product.title %>" class="h-full w-full object-cover" /></button><span class="min-w-0"><b class="block truncate text-xs"><%= product.title %></b><small class="text-[10px] text-emerald-400">พร้อมขาย · ฿<%= Number(product.price || 0).toLocaleString() %></small></span>
              </label>
            <% }) %>
          </div>
        </div>
        <button class="rounded-xl bg-[var(--gold)] px-5 py-3 text-sm font-black text-[var(--gold-contrast)]">บันทึกการตั้งค่า</button>
      </form>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[var(--border-light)] bg-[var(--input)]/60 px-4 py-3 text-xs text-[var(--text-3)]">
        <span>ตัวอย่าง: ฿100 + <%= config.markupMode === 'percent' ? `${config.markupValue}%` : `฿${config.markupValue}` %> = <b class="text-[var(--gold-text)]">฿<%= Math.round((100 + (config.markupMode === 'percent' ? 100 * config.markupValue / 100 : config.markupValue)) * 100) / 100 %></b></span>
        <form action="/admin/catalog-api/sync" method="post"><button class="rounded-lg border border-[var(--border-light)] px-3 py-2 font-bold text-[var(--text-2)] hover:border-[var(--gold)]">ซิงก์ตอนนี้</button></form>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2"><div class="rounded-xl border border-emerald-400/20 bg-emerald-500/5 p-4"><small class="block text-xs text-[var(--text-4)]">รายได้ส่วนต่างร้านนี้</small><b class="text-xl text-emerald-400">฿<%= Number(config.tenantRevenue || 0).toLocaleString() %></b></div><div class="rounded-xl border border-[var(--border-light)] bg-[var(--input)]/50 p-4"><small class="block text-xs text-[var(--text-4)]">รูปแบบรับเงิน</small><b class="text-sm text-[var(--text-2)]">เงินเติมเข้าบัญชีร้านหลัก · ระบบบันทึกส่วนต่างให้ร้านนี้</b></div></div>
    </section>

    <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6">
      <div class="mb-4 flex items-center justify-between"><h2 class="text-lg font-black">ตัวอย่างสินค้าที่จะขึ้นหน้าร้าน</h2><span class="text-xs text-[var(--text-4)]">แสดงตามรายการที่เลือกสูงสุด 5 รายการ</span></div>
      <% if (!preview.length) { %><p class="rounded-xl border border-dashed border-[var(--border)] p-8 text-center text-sm text-[var(--text-3)]">ยังไม่ได้เปิดรับสินค้า หรือร้านหลักยังไม่มีสินค้าที่เปิดขาย</p><% } else { %>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"><% preview.forEach(product => { %><article class="overflow-hidden rounded-xl border border-[var(--border-light)] bg-[var(--input)]"><button type="button" data-api-gallery data-title="<%= product.title %>" data-image="<%= product.images[0] || '' %>" class="block w-full cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[var(--gold)]" title="กดเพื่อดูรูปสินค้า <%= product.title %> ขนาดใหญ่"><img src="<%= product.images[0] || '' %>" alt="<%= product.title %>" class="aspect-[4/3] w-full object-cover" /></button><div class="p-2"><b class="block truncate text-xs"><%= product.title %></b><span class="text-xs font-black text-[var(--gold-text)]">฿<%= Number(product.price).toLocaleString() %></span><small class="block text-[10px] text-[var(--text-4)]">เหลือ <%= product.stockCount %></small></div></article><% }) %></div>
      <% } %>
    </section>
  <% } else { %>
    <section class="rounded-2xl border border-[var(--gold)]/45 bg-[var(--card)] p-6 shadow-[0_18px_38px_-28px_color-mix(in_srgb,var(--gold)_65%,transparent)]">
      <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-lg font-black">เลือกสินค้า Partner ที่จะแสดงบนร้านเช่าทั้งหมด</h2><p class="text-sm text-[var(--text-3)]">แสดงเฉพาะสินค้าที่ยังมีไอดีพร้อมขาย · เลือกได้สูงสุด 5 ไอดี · ร้านเช่าจะอัปเดตตามรายการนี้ทันที</p></div><span id="featuredApiCount" class="text-xs font-black text-[var(--gold-text)]"><%= config.featuredProductIds.length %>/5 รายการ</span></div>
      <form action="/admin/catalog-api/settings" method="post">
        <div class="grid max-h-72 gap-2 overflow-y-auto sm:grid-cols-2 lg:grid-cols-3">
          <% sourceProducts.forEach(product => { const selected = config.featuredProductIds.includes(String(product.id)); %>
            <label class="featured-api-option flex cursor-pointer items-center gap-2 rounded-lg border border-[var(--border-light)] bg-[var(--input)] p-2 transition hover:border-[var(--gold)] <%= selected ? 'is-selected border-[var(--gold)]/70' : '' %>">
              <input type="checkbox" name="featuredProductIds" value="<%= product.id %>" <%= selected ? 'checked' : '' %> class="featured-api-checkbox h-4 w-4 accent-[var(--gold)]" />
              <button type="button" data-api-gallery data-title="<%= product.title %>" data-image="<%= product.images?.[0] || '' %>" class="h-10 w-14 shrink-0 cursor-zoom-in overflow-hidden rounded focus:outline-none focus:ring-2 focus:ring-[var(--gold)]" title="กดเพื่อดูรูปสินค้า <%= product.title %> ขนาดใหญ่"><img src="<%= product.images?.[0] || '' %>" alt="รูป <%= product.title %>" class="h-full w-full object-cover" /></button><span class="min-w-0"><b class="block truncate text-xs"><%= product.title %></b><small class="text-[10px] text-emerald-400">พร้อมขาย · ฿<%= Number(product.price || 0).toLocaleString() %></small></span>
            </label>
          <% }) %>
        </div>
        <button class="mt-4 rounded-xl bg-[var(--gold)] px-5 py-3 text-sm font-black text-[var(--gold-contrast)]">บันทึกรายการ Partner</button>
      </form>
    </section>
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6">
      <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-lg font-black">ร้านเช่าทั้งหมด</h2><p class="text-sm text-[var(--text-3)]">เปิดดูสถานะ API และยอดส่วนต่างของแต่ละร้านได้จากหน้านี้</p></div><div class="text-right"><span class="block text-sm font-bold text-[var(--gold-text)]"><%= sourceProducts.length %> สินค้าจากร้านหลัก</span><small class="block text-xs text-emerald-400">ยอดชำระเข้าร้านหลัก ฿<%= Number(config.ownerRevenue || 0).toLocaleString() %></small><small class="block text-xs text-amber-400">ส่วนต่างรอโอนทั้งหมด ฿<%= Object.values(payoutLedger.pending || {}).reduce((sum, amount) => sum + (Number(amount) || 0), 0).toLocaleString() %></small></div></div>
      <div class="overflow-x-auto"><table class="w-full min-w-[860px] text-left text-sm"><thead class="text-xs text-[var(--text-4)]"><tr><th class="px-3 py-3">ร้าน</th><th class="px-3 py-3">ลิงก์</th><th class="px-3 py-3">สถานะ</th><th class="px-3 py-3">บวกราคา</th><th class="px-3 py-3">บัญชีรับเงิน</th><th class="px-3 py-3">ส่วนต่างรอโอน</th></tr></thead><tbody><% if (!shops.length) { %><tr><td colspan="6" class="px-3 py-8 text-center text-[var(--text-3)]">ยังไม่มีร้านเช่า</td></tr><% } %><% shops.forEach(shop => { const account = shop.payoutAccount || {}; %><tr class="border-t border-[var(--border-light)]"><td class="px-3 py-3 font-bold"><%= shop.name %></td><td class="px-3 py-3 text-xs text-[var(--text-3)]"><%= shop.slug %></td><td class="px-3 py-3"><span class="rounded-full px-2 py-1 text-xs font-bold <%= shop.config.enabled ? 'bg-emerald-500/10 text-emerald-400' : 'bg-[var(--input)] text-[var(--text-4)]' %>"><%= shop.config.enabled ? 'เปิดใช้งาน' : 'ปิดอยู่' %></span></td><td class="px-3 py-3 text-xs"><%= shop.config.markupMode === 'fixed' ? `฿${shop.config.markupValue}` : `${shop.config.markupValue}%` %></td><td class="px-3 py-3 text-xs"><%= account.bankName || 'ยังไม่ตั้งค่า' %><% if (account.bankAccountNumber) { %><br><b><%= account.bankAccountNumber %></b><% } %><% if (account.bankAccountName) { %><br><span class="text-[var(--text-4)]"><%= account.bankAccountName %></span><% } %></td><td class="px-3 py-3 text-xs font-bold <%= Number(payoutByTenant[String(shop.id)] || 0) > 0 ? 'text-amber-400' : 'text-emerald-400' %>">฿<%= Number(payoutByTenant[String(shop.id)] || 0).toLocaleString() %></td></tr><% }) %></tbody></table></div>
    </section>
    <section id="catalog-payouts" class="scroll-mt-6 rounded-2xl border border-amber-400/35 bg-[var(--card)] p-6 shadow-[0_18px_38px_-28px_color-mix(in_srgb,#f59e0b_45%,transparent)]">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-[.16em] text-amber-400">PARTNER SETTLEMENT</p><h2 class="mt-1 text-xl font-black">โอนส่วนต่างให้ร้านที่เปิด API</h2><p class="mt-1 text-sm text-[var(--text-3)]">ระบบบังคับโอนยอดเต็มที่ค้างอยู่เท่านั้น แนบสลิปแล้วประวัติจะถูกบันทึกไว้ในหน้านี้</p></div><span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-black text-amber-300">ยอดค้างรวม ฿<%= Object.values(payoutLedger.pending || {}).reduce((sum, amount) => sum + (Number(amount) || 0), 0).toLocaleString() %></span></div>
      <% if (!payoutShops.length) { %><p class="rounded-xl border border-dashed border-[var(--border)] p-8 text-center text-sm text-[var(--text-3)]">ยังไม่มีร้านที่เปิดใช้งาน API</p><% } else { %>
        <div class="grid gap-4 lg:grid-cols-2">
          <% payoutShops.forEach(shop => { const account = shop.payoutAccount || {}; const hasAccount = Boolean(account.bankAccountNumber && account.bankAccountName); %>
            <article class="rounded-xl border border-[var(--border-light)] bg-[var(--input)]/45 p-4"><div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-black"><%= shop.name %></h3><p class="text-xs text-[var(--text-4)]"><%= shop.slug %> · <%= shop.config.markupMode === 'fixed' ? `บวก ฿${shop.config.markupValue}` : `บวก ${shop.config.markupValue}%` %></p></div><span class="rounded-full border px-2 py-1 text-[10px] font-black <%= hasAccount ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300' : 'border-rose-400/30 bg-rose-400/10 text-rose-300' %>"><%= hasAccount ? 'บัญชีพร้อมโอน' : 'ยังไม่มีบัญชี' %></span></div>
              <div class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto] sm:items-center"><div class="rounded-lg border border-[var(--border-light)] bg-[var(--card)] px-3 py-2"><small class="block text-[10px] text-[var(--text-4)]">ยอดเต็มที่ต้องโอน</small><b class="text-2xl text-amber-300">฿<%= Number(shop.pendingAmount || 0).toLocaleString() %></b><span class="ml-2 text-xs text-[var(--text-4)]">โอนไปแล้ว ฿<%= Number(shop.paidAmount || 0).toLocaleString() %></span></div><div class="text-right text-xs"><b><%= account.bankName || 'ไม่ระบุธนาคาร' %></b><br><span><%= account.bankAccountNumber || 'ยังไม่ตั้งเลขบัญชี' %></span><br><span class="text-[var(--text-4)]"><%= account.bankAccountName || 'ยังไม่ระบุชื่อบัญชี' %></span></div></div>
              <% if (account.bankQrImage) { %><img src="<%= account.bankQrImage %>" alt="QR รับเงิน <%= shop.name %>" class="mt-3 h-20 w-20 rounded-lg border border-[var(--border-light)] bg-white object-contain p-1" /><% } %>
              <% if (Number(shop.pendingAmount || 0) > 0 && hasAccount) { %><form action="/admin/catalog-api/payouts" method="post" enctype="multipart/form-data" class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end"><input type="hidden" name="tenantShopId" value="<%= shop.id %>" /><label class="text-xs font-bold text-[var(--text-3)]">ยอดโอนเต็ม (แก้ไขไม่ได้)<input name="amount" value="<%= Number(shop.pendingAmount || 0) %>" readonly class="mt-1 w-full rounded-lg border border-amber-400/40 bg-[var(--card)] px-3 py-2 font-black text-amber-300" /></label><label class="text-xs font-bold text-[var(--text-3)]">สลิปการโอน<input type="file" name="slip" accept="image/jpeg,image/png,image/webp,image/gif" required class="mt-1 block w-full text-xs" /></label><button class="sm:col-span-2 rounded-lg bg-amber-400 px-4 py-2.5 text-sm font-black text-black hover:bg-amber-300">โอนและบันทึกสลิป ฿<%= Number(shop.pendingAmount || 0).toLocaleString() %></button></form><% } else if (!hasAccount) { %><p class="mt-3 rounded-lg border border-rose-400/25 bg-rose-400/5 px-3 py-2 text-xs text-rose-300">ให้ร้านเช่าตั้งค่าธนาคารและชื่อบัญชีก่อน จึงจะโอนได้</p><% } else { %><p class="mt-3 rounded-lg border border-emerald-400/25 bg-emerald-400/5 px-3 py-2 text-xs text-emerald-300">ไม่มียอดค้างโอน ร้านนี้ชำระครบแล้ว</p><% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
      <div class="mt-6 border-t border-[var(--border-light)] pt-5"><div class="mb-3 flex items-center justify-between gap-3"><h3 class="font-black">ประวัติการโอนส่วนต่าง</h3><span class="text-xs text-[var(--text-4)]"><%= (payoutHistory || []).length %> รายการ</span></div><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="text-xs text-[var(--text-4)]"><tr><th class="px-3 py-2">วันที่</th><th class="px-3 py-2">ร้าน Partner</th><th class="px-3 py-2">ยอดโอน</th><th class="px-3 py-2">บัญชี</th><th class="px-3 py-2">สลิป</th></tr></thead><tbody><% if (!(payoutHistory || []).length) { %><tr><td colspan="5" class="px-3 py-6 text-center text-[var(--text-3)]">ยังไม่มีประวัติการโอน</td></tr><% } %><% [...(payoutHistory || [])].reverse().forEach(payout => { %><tr class="border-t border-[var(--border-light)]"><td class="px-3 py-2 text-xs"><%= payout.transferredAt ? new Date(payout.transferredAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) : '-' %></td><td class="px-3 py-2 font-bold"><%= payout.tenantShopName || payout.tenantShopId %></td><td class="px-3 py-2 font-black text-emerald-400">฿<%= Number(payout.amount || 0).toLocaleString() %></td><td class="px-3 py-2 text-xs"><%= payout.bankName || '-' %><br><%= payout.bankAccountNumber || '-' %><br><span class="text-[var(--text-4)]"><%= payout.bankAccountName || '-' %></span></td><td class="px-3 py-2"><% if (payout.slipStorageId) { %><button type="button" data-payout-slip data-title="สลิปโอน <%= payout.tenantShopName || payout.tenantShopId %> · ฿<%= Number(payout.amount || 0).toLocaleString() %>" data-slip-url="/admin/catalog-api/payouts/<%= payout.id %>/slip" class="rounded-lg border border-[var(--gold)]/50 px-3 py-1.5 text-xs font-bold text-[var(--gold-text)] hover:bg-[var(--gold)]/10">ดูสลิปในหน้านี้</button><% } else { %>-<% } %></td></tr><% }) %></tbody></table></div></div>
    </section>
  <% } %>
</section>
<dialog id="catalog-api-image-dialog" class="m-auto w-[min(94vw,900px)] max-h-[92vh] overflow-hidden rounded-2xl border border-[var(--gold)]/45 bg-[var(--card)] text-[var(--text)] shadow-2xl backdrop:bg-black/75">
  <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-4 py-3"><strong id="catalog-api-image-title" class="truncate text-sm"></strong><button type="button" data-api-gallery-close class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--input)] text-xl" aria-label="ปิดรูป">×</button></div>
  <div class="grid max-h-[76vh] min-h-[280px] place-items-center bg-black/90 p-4"><img id="catalog-api-image" src="" alt="" class="max-h-[72vh] max-w-full object-contain" /></div>
</dialog>
<dialog id="catalog-api-slip-dialog" class="m-auto w-[min(94vw,700px)] max-h-[92vh] overflow-hidden rounded-2xl border border-amber-400/45 bg-[var(--card)] text-[var(--text)] shadow-2xl backdrop:bg-black/75">
  <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] px-4 py-3"><strong id="catalog-api-slip-title" class="truncate text-sm">สลิปการโอนส่วนต่าง</strong><button type="button" data-payout-slip-close class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--input)] text-xl" aria-label="ปิดสลิป">×</button></div>
  <div class="grid max-h-[78vh] min-h-[280px] place-items-center bg-black/90 p-4"><img id="catalog-api-slip-image" src="" alt="สลิปการโอน" class="max-h-[74vh] max-w-full object-contain" /></div>
</dialog>
<script>
  (() => {
    const boxes = [...document.querySelectorAll('.featured-api-checkbox')];
    const count = document.getElementById('featuredApiCount');
    const sync = () => {
      const selected = boxes.filter(box => box.checked);
      if (count) count.textContent = `${selected.length}/5 รายการ`;
      boxes.forEach(box => {
        box.disabled = !box.checked && selected.length >= 5;
        box.closest('.featured-api-option')?.classList.toggle('is-selected', box.checked);
      });
    };
    boxes.forEach(box => box.addEventListener('change', sync));
    sync();
  })();
  (() => {
    const dialog = document.getElementById('catalog-api-image-dialog');
    const image = document.getElementById('catalog-api-image');
    const title = document.getElementById('catalog-api-image-title');
    if (!dialog || !image || !title) return;
    document.querySelectorAll('[data-api-gallery]').forEach(button => button.addEventListener('click', event => {
      event.preventDefault();
      event.stopPropagation();
      const src = button.dataset.image || '';
      if (!src) return;
      image.src = src;
      image.alt = button.dataset.title || 'รูปสินค้า';
      title.textContent = button.dataset.title || 'รูปสินค้า';
      dialog.showModal();
    }));
    dialog.querySelector('[data-api-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { image.src = ''; });
  })();
  (() => {
    const dialog = document.getElementById('catalog-api-slip-dialog');
    const image = document.getElementById('catalog-api-slip-image');
    const title = document.getElementById('catalog-api-slip-title');
    if (!dialog || !image || !title) return;
    document.querySelectorAll('[data-payout-slip]').forEach(button => button.addEventListener('click', () => {
      image.src = button.dataset.slipUrl || '';
      title.textContent = button.dataset.title || 'สลิปการโอนส่วนต่าง';
      if (image.src) dialog.showModal();
    }));
    dialog.querySelector('[data-payout-slip-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { image.src = ''; });
  })();
</script>
