<div class="mb-3 max-w-3xl">
  <h3 class="font-semibold">⚙️ ตั้งค่ามินิเกม</h3>
  <p class="text-xs text-[var(--text-4)] mt-1">เลือกเปิดเกมใดเกมหนึ่ง หรือเปิดทั้ง 2 เกมพร้อมกันได้</p>
  <div class="flex flex-wrap gap-2 mt-3">
    <% [['box', '🎁 เกมเปิดกล่อง', game.boxEnabled], ['rail', '🎰 เกมรางเลื่อน', game.railEnabled]].forEach(item => { %>
      <form action="/admin/minigame/toggle" method="post" class="inline">
        <input type="hidden" name="gameType" value="<%= item[0] %>" />
        <button class="text-xs px-3 py-2 rounded-full <%= item[2] ? 'bg-emerald-900/40 text-emerald-400' : 'bg-[var(--input)] text-[var(--text-4)]' %>">
          <%= item[2] ? '🟢' : '⚪' %> <%= item[1] %> — <%= item[2] ? 'เปิดอยู่' : 'ปิดอยู่' %>
        </button>
      </form>
    <% }) %>
  </div>
</div>
<details class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 mb-6 max-w-3xl" open>
  <summary class="font-semibold cursor-pointer">รายละเอียดและราคาของทั้ง 2 เกม</summary>
  <form action="/admin/minigame/settings" method="post" class="space-y-4 mt-4">
    <h4 class="text-sm font-semibold text-[var(--gold)]">🎁 เกมเปิดกล่อง</h4>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อเกม</label>
      <input name="title" value="<%= game.title %>" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">คำอธิบาย</label>
      <textarea name="description" rows="2" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2"><%= game.description %></textarea>
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ราคาต่อการเล่น 1 ครั้ง (฿)</label>
      <input type="number" min="0" name="costPerPlay" value="<%= game.costPerPlay %>" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <hr class="border-[var(--border)]" />
    <h4 class="text-sm font-semibold text-[var(--gold)]">🎰 เกมรางเลื่อน</h4>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อเกมรางเลื่อน</label>
      <input name="railTitle" value="<%= game.railTitle %>" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">คำอธิบายเกมรางเลื่อน</label>
      <textarea name="railDescription" rows="2" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2"><%= game.railDescription %></textarea>
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ราคาเกมรางเลื่อนต่อครั้ง (฿)</label>
      <input type="number" min="0" name="railCostPerPlay" value="<%= game.railCostPerPlay %>" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
    </div>
    <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-6 py-2 rounded-lg text-sm">บันทึกการตั้งค่า</button>
  </form>
</details>

<div class="grid md:grid-cols-2 gap-4 mb-6 max-w-3xl">
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-3">🎁 ทดลองเกมเปิดกล่อง</h3>
    <%- include('../partials/minigame-widget', { endpoint: '/admin/minigame/preview', cost: null, ctaLabel: '🎲 สุ่มทดสอบ', showLogin: false, balance: null }) %>
  </div>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-3">🎰 ทดลองเกมรางเลื่อน</h3>
    <%- include('../partials/minigame-rail', { endpoint: '/admin/minigame/preview?mode=rail', cost: 0, prizes: prizes.filter(p => p.active && (p.gameType || 'box') === 'rail'), showLogin: false, balance: null }) %>
  </div>
  <p class="md:col-span-2 text-xs text-[var(--text-4)]">การทดลองไม่หักเครดิตและไม่ตัดสต็อกจริง แต่ใช้รายการรางวัลของแต่ละเกม</p>
</div>

<div class="grid lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2 bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
    <div class="p-4 border-b border-[var(--border)] flex items-center justify-between">
      <h3 class="font-semibold">🎁 ของรางวัลและอัตราออก แยกตามเกม</h3>
      <div class="text-right text-xs"><div class="<%= totalPercent === 100 ? 'text-emerald-400' : 'text-amber-400' %>">กล่อง: <%= totalPercent %>%</div><div class="<%= railTotalPercent === 100 ? 'text-emerald-400' : 'text-amber-400' %>">ราง: <%= railTotalPercent %>%</div></div>
    </div>
    <table class="w-full text-sm">
      <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
        <tr>
          <th class="p-3">เกม</th><th class="p-3">รูป</th>
          <th class="p-3">ชื่อรางวัล</th>
          <th class="p-3">อัตราออก (%)</th>
          <th class="p-3">สต็อก</th>
          <th class="p-3">รางวัลจริง?</th>
          <th class="p-3">สถานะ</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        <% prizes.forEach(p => { %>
          <% const formId = 'prize-form-' + p.id; const imgFormId = 'prize-img-form-' + p.id; %>
          <tr>
            <td class="p-3 text-xs whitespace-nowrap"><%= (p.gameType || 'box') === 'rail' ? '🎰 รางเลื่อน' : '🎁 เปิดกล่อง' %></td>
            <td class="p-3">
              <% if (p.image) { %>
                <img src="<%= p.image %>" alt="<%= p.name %>" class="w-14 h-14 rounded-lg object-cover border border-[var(--border-light)] mb-1" />
              <% } else { %>
                <div class="w-10 h-10 rounded-lg border border-dashed border-[var(--border-light)] mb-1"></div>
              <% } %>
              <form id="<%= imgFormId %>" action="/admin/minigame/prizes/<%= p.id %>/image" method="post" enctype="multipart/form-data" class="hidden"></form>
              <input form="<%= imgFormId %>" type="file" name="image" accept="image/*" onchange="this.form.submit()" class="hidden" id="<%= imgFormId %>-input" />
              <label for="<%= imgFormId %>-input" class="text-[var(--gold)] text-[10px] cursor-pointer underline">เปลี่ยนรูป</label>
              <% if (p.image) { %>
                <form action="/admin/minigame/prizes/<%= p.id %>/image/remove" method="post" class="inline"><button class="text-[var(--coral)] text-[10px] underline ml-1">ลบรูป</button></form>
              <% } %>
            </td>
            <td class="p-3"><input form="<%= formId %>" name="name" value="<%= p.name %>" class="w-32 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1" /></td>
            <td class="p-3"><input form="<%= formId %>" type="number" min="0" max="100" step="0.1" name="percent" value="<%= p.percent %>" class="w-20 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1" /></td>
            <td class="p-3"><input form="<%= formId %>" type="number" min="0" name="stock" value="<%= p.stock === null ? '' : p.stock %>" placeholder="ไม่จำกัด" class="w-24 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1" /></td>
            <td class="p-3"><input form="<%= formId %>" type="checkbox" name="isPrize" value="on" <%= p.isPrize ? 'checked' : '' %> class="w-4 h-4 accent-[var(--gold)]" /></td>
            <td class="p-3"><%= p.active ? '🟢 เปิด' : '⚪ ปิด' %></td>
            <td class="p-3 text-right space-x-2 whitespace-nowrap">
              <form id="<%= formId %>" action="/admin/minigame/prizes/<%= p.id %>" method="post" class="inline"></form>
              <button form="<%= formId %>" class="text-[var(--gold)] text-xs">บันทึก</button>
              <form action="/admin/minigame/prizes/<%= p.id %>/toggle" method="post" class="inline"><button class="text-[var(--text-3)] text-xs"><%= p.active ? 'ปิด' : 'เปิด' %></button></form>
              <% if (p.stock !== null) { %>
              <form action="/admin/minigame/prizes/<%= p.id %>/restock" method="post" class="inline-flex items-center gap-1" onsubmit="return confirmRestock(this)">
                <input type="number" name="addStock" min="1" placeholder="+จำนวน" class="w-16 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-1.5 py-1 text-xs" />
                <button class="text-emerald-400 text-xs">เติมสต็อก</button>
              </form>
              <% } %>
              <form action="/admin/minigame/prizes/<%= p.id %>/delete" method="post" class="inline" onsubmit="return confirm('ลบของรางวัลนี้?')"><button class="text-rose-400 text-xs">ลบ</button></form>
            </td>
          </tr>
        <% }) %>
        <% if (!prizes.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="8">ยังไม่มีของรางวัล</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 h-fit">
    <h3 class="font-semibold mb-3">➕ เพิ่มของรางวัล</h3>
    <form action="/admin/minigame/prizes" method="post" enctype="multipart/form-data" class="space-y-3">
      <select name="gameType" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm">
        <option value="box">🎁 เกมเปิดกล่อง</option>
        <option value="rail">🎰 เกมรางเลื่อน</option>
      </select>
      <input name="name" required placeholder="ชื่อรางวัล เช่น ไอดีเกม Valorant" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <input type="number" min="0" max="100" step="0.1" name="percent" required placeholder="อัตราออก (%)" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <input type="number" min="0" name="stock" placeholder="สต็อก (เว้นว่าง = ไม่จำกัด)" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <label class="flex items-center gap-2 text-sm text-[var(--text-3)]">
        <input type="checkbox" name="isPrize" value="on" checked class="w-4 h-4 accent-[var(--gold)]" />
        เป็นของรางวัลจริง (ลูกค้าต้องทักแชทมารับ) — ไม่ติ๊กถ้าเป็นรายการ "ไม่ได้รางวัล"
      </label>
      <div>
        <label class="block text-xs mb-1 text-[var(--text-3)]">รูปของรางวัล (ไม่บังคับ ไม่ใส่จะใช้ไอคอนอัตโนมัติ)</label>
        <input type="file" name="image" accept="image/*" class="w-full text-xs text-[var(--text-3)] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold)] file:text-xs" />
      </div>
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">เพิ่มของรางวัล</button>
    </form>
    <p class="text-xs text-[var(--text-4)] mt-3">💡 อัตราออกทั้งหมดควรรวมกันเป็น 100% ลูกค้าจะเห็นอัตรานี้ที่หน้าเว็บก่อนเล่นเสมอ</p>
  </div>
</div>

<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto">
  <div class="p-4 border-b border-[var(--border)] flex flex-wrap items-center gap-3">
    <h3 class="font-semibold shrink-0">📜 ประวัติการเล่นล่าสุด</h3>
    <form method="get" action="/admin/minigame" class="flex gap-2 flex-1 min-w-[220px]">
      <input type="text" name="q" value="<%= searchQuery %>" placeholder="ค้นหาชื่อผู้เล่นหรือโค้ดรับของ..." class="flex-1 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-1.5 text-sm" />
      <button class="px-4 py-1.5 rounded-lg bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] text-xs font-semibold whitespace-nowrap">ค้นหา</button>
      <% if (searchQuery) { %><a href="/admin/minigame" class="px-3 py-1.5 rounded-lg bg-[var(--input)] border border-[var(--border-light)] text-xs text-[var(--text-3)] whitespace-nowrap">ล้าง</a><% } %>
    </form>
  </div>
  <table class="w-full text-sm">
    <thead class="text-[var(--text-4)] text-left border-b border-[var(--border)]">
      <tr><th class="p-3">ผู้เล่น</th><th class="p-3">ผลลัพธ์</th><th class="p-3">โค้ดรับของ</th><th class="p-3">สถานะ</th><th class="p-3">เวลา</th><th class="p-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-[var(--border)]">
      <% recentPlays.forEach(play => { %>
        <tr>
          <td class="p-3"><%= play.username %></td>
          <td class="p-3 <%= play.isWin ? 'text-emerald-400' : 'text-[var(--text-4)]' %>"><%= play.prizeName %></td>
          <td class="p-3 font-mono text-xs"><%= play.claimCode || '-' %></td>
          <td class="p-3">
            <% if (!play.isWin) { %>
              <span class="text-[var(--text-4)] text-xs">—</span>
            <% } else if (play.status === 'delivered') { %>
              <span class="text-emerald-400 text-xs">✓ รับแล้ว</span>
            <% } else { %>
              <span class="text-amber-400 text-xs">⏳ รอมารับ</span>
            <% } %>
          </td>
          <td class="p-3 text-[var(--text-4)] text-xs"><%= new Date(play.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></td>
          <td class="p-3 text-right whitespace-nowrap">
            <% if (play.isWin) { %>
              <form action="/admin/minigame/plays/<%= play.id %>/deliver" method="post" class="inline">
                <button class="text-[var(--gold)] text-xs"><%= play.status === 'delivered' ? 'ยกเลิกรับแล้ว' : 'ทำเครื่องหมายว่ารับแล้ว' %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!recentPlays.length) { %><tr><td class="p-3 text-[var(--text-4)]" colspan="6"><%= searchQuery ? 'ไม่พบผลลัพธ์ที่ตรงกับ "' + searchQuery + '"' : 'ยังไม่มีคนเล่น' %></td></tr><% } %>
    </tbody>
  </table>
</div>

<script>
  function confirmRestock(form) {
    const amount = form.querySelector('input[name="addStock"]').value;
    if (!amount || Number(amount) <= 0) { alert('กรุณากรอกจำนวนที่จะเติม'); return false; }
    return true;
  }
</script>
