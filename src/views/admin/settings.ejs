<!-- Settings Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">ตั้งค่าร้านค้า</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">จัดการข้อมูลพื้นฐาน ช่องทางการติดต่อ เวลาเปิดร้าน เพลงพื้นหลัง และเอฟเฟกต์หน้าเว็บ</p>
  </div>
</div>

<div class="space-y-6 max-w-4xl">

  <!-- License Status Card (If enabled) -->
  <% if (licenseEnabled) { %>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-lg">
          🔒
        </div>
        <div>
          <h3 class="font-bold text-sm text-[var(--text)]">ใบอนุญาตการใช้งานเว็บ (License)</h3>
          <% if (settings.license && settings.license.key && settings.license.expiresAt && Date.now() < settings.license.expiresAt) { %>
            <div class="text-xs text-emerald-400 font-semibold mt-0.5 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>ใช้งานได้ปกติ<% if (settings.license.label) { %> (<%= settings.license.label %>)<% } %></span>
            </div>
            <div class="text-[11px] text-[var(--text-4)] mt-0.5">หมดอายุ: <%= new Date(settings.license.expiresAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></div>
          <% } else { %>
            <div class="text-xs text-rose-400 font-semibold mt-0.5 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
              <span>ยังไม่ได้ปลดล็อก หรือหมดอายุแล้ว</span>
            </div>
          <% } %>
        </div>
      </div>
      <a href="/license" class="bg-[var(--input)] hover:bg-[var(--card-hover)] border border-[var(--gold)]/30 text-[var(--gold)] font-bold px-4 py-2 rounded-xl text-xs transition">
        จัดการคีย์ลิขสิทธิ์ →
      </a>
    </div>
  <% } %>

  <!-- General Shop Settings Card -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center gap-2.5 mb-5 pb-4 border-b border-[var(--border)]">
      <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-sm">
        🏪
      </div>
      <div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">ข้อมูลทั่วไปและช่องทางติดต่อ</h3>
        <p class="text-[11px] text-[var(--text-4)]">ข้อมูลนี้จะแสดงบน Header, Footer และหน้าติดต่อเราของร้าน</p>
      </div>
    </div>

    <form action="/admin/settings" method="post" class="space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">ชื่อร้านค้า (Shop Name) *</label>
          <input name="shopName" value="<%= settings.shopName %>" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition font-medium" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">คำโปรยร้าน (Tagline)</label>
          <input name="tagline" value="<%= settings.tagline %>" placeholder="เช่น ร้านจำหน่ายเกมและไอดีแท้ 24 ชม." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">Line ID หรือ Line @</label>
          <input name="contactLine" value="<%= settings.contactLine %>" placeholder="เช่น @myshop" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">เวลาเปิดบริการ</label>
          <input name="openHours" value="<%= settings.openHours %>" placeholder="เช่น เปิดบริการ 24 ชั่วโมง หรือ 10:00 - 22:00" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">Facebook Page URL</label>
          <input name="contactFacebook" value="<%= settings.contactFacebook %>" placeholder="https://facebook.com/เพจของคุณ" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">Messenger URL</label>
          <input name="contactMessenger" value="<%= settings.contactMessenger || '' %>" placeholder="https://m.me/ชื่อเพจ" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">ชื่อที่แสดงบนการ์ด Facebook</label>
          <input name="contactFacebookName" value="<%= settings.contactFacebookName || '' %>" placeholder="เช่น LilTeam Official" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">เวลาตอบกลับโดยประมาณ</label>
        <input name="contactResponseTime" value="<%= settings.contactResponseTime || '' %>" placeholder="เช่น ภายใน 5–15 นาที" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>

      <div class="pt-2">
        <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-6 py-2.5 rounded-xl text-xs shadow-md transition active:scale-95">
          💾 บันทึกข้อมูลร้านค้า
        </button>
      </div>
    </form>
  </div>

  <!-- Background Music Player Card -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-[var(--border)]">
      <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-sm">
        🎵
      </div>
      <div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เพลงพื้นหลังหน้าเว็บ (Background Music Player)</h3>
        <p class="text-[11px] text-[var(--text-4)]">เล่นเพลงจาก YouTube พื้นหลัง ลูกค้าสามารถปรับระดับเสียงหรือย่อเก็บได้</p>
      </div>
    </div>

    <form action="/admin/music-player" method="post" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ลิงก์วิดีโอ YouTube</label>
        <input name="youtubeUrl" value="<%= settings.music.youtubeUrl %>" placeholder="https://www.youtube.com/watch?v=..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
        <p class="text-[11px] text-[var(--text-4)] mt-1">รองรับ YouTube, YouTube Music, youtu.be, Shorts และ Live</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">เริ่มเล่นที่ (นาที:วินาที)</label>
          <input name="startTime" value="<%= Math.floor(settings.music.startSeconds/60) %>:<%= String(settings.music.startSeconds%60).padStart(2,'0') %>" placeholder="0:00" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">จบท่อนที่ (ไม่บังคับ)</label>
          <input name="endTime" value="<%= settings.music.endSeconds ? Math.floor(settings.music.endSeconds/60) + ':' + String(settings.music.endSeconds%60).padStart(2,'0') : '' %>" placeholder="0:00" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs font-mono outline-none focus:border-[var(--gold)] transition" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1.5 text-[var(--text-3)]">ระดับเสียงเริ่มต้น (<%= settings.music.defaultVolume %>%)</label>
        <input type="range" name="defaultVolume" min="0" max="100" value="<%= settings.music.defaultVolume %>" class="w-full accent-[var(--gold)] h-2 bg-[var(--input)] rounded-lg cursor-pointer" />
      </div>

      <div class="bg-[var(--input)]/40 border border-[var(--border-light)] rounded-xl p-3.5 flex items-center justify-between">
        <div>
          <div class="font-bold text-xs text-[var(--text)]">เปิดใช้งานเพลงพื้นหลัง</div>
          <div class="text-[11px] text-[var(--text-4)]">เล่นเพลงอัตโนมัติเมื่อลูกค้าเข้าสู่หน้าเว็บ</div>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="enabled" <%= settings.music.enabled ? 'checked' : '' %> class="sr-only peer" onchange="this.form.requestSubmit()" />
          <div class="w-11 h-6 bg-[var(--input)] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--gold)]"></div>
        </label>
      </div>

      <button type="submit" class="bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--bg)] font-bold px-6 py-2.5 rounded-xl text-xs shadow-md transition active:scale-95">
        💾 บันทึกการตั้งค่าเพลง
      </button>
    </form>
  </div>

  <!-- Snow Particle Effect Card -->
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center font-bold text-sm">
          ❄️
        </div>
        <div>
          <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เอฟเฟกต์หิมะตกหน้าเว็บ (Snow Particles)</h3>
          <p class="text-[11px] text-[var(--text-4)]">เพิ่มอนุภาคหิมะโปรยปรายตกแต่งบนหน้าเว็บ (ไม่บดบังหรือรบกวนการคลิกของลูกค้า)</p>
        </div>
      </div>

      <form action="/admin/snow-toggle" method="post">
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="enabled" <%= settings.snow.enabled ? 'checked' : '' %> class="sr-only peer" onchange="this.form.submit()" />
          <div class="w-11 h-6 bg-[var(--input)] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-500"></div>
        </label>
      </form>
    </div>
  </div>

</div>
