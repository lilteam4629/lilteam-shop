<form action="/admin/settings" method="post" class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 max-w-xl space-y-4">
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อร้าน</label>
    <input name="shopName" value="<%= settings.shopName %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">คำโปรย</label>
    <input name="tagline" value="<%= settings.tagline %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">Line ID</label>
    <input name="contactLine" value="<%= settings.contactLine %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">Facebook URL</label>
    <input name="contactFacebook" value="<%= settings.contactFacebook %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>
  <div>
    <label class="block text-sm mb-1 text-[var(--text-3)]">เวลาเปิดบริการ</label>
    <input name="openHours" value="<%= settings.openHours %>" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2" />
  </div>

  <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-6 py-2 rounded-lg text-sm">บันทึกการตั้งค่า</button>
</form>

<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 max-w-xl mt-6">
  <h3 class="font-semibold mb-1">เพลงหน้าเว็บ</h3>
  <p class="text-xs text-[var(--text-4)] mb-4">ใส่ลิงก์วิดีโอ YouTube เพื่อเปิดเป็นเพลงพื้นหลังของหน้าเว็บ ลูกค้าจะเห็นเป็นปุ่มเล่นเพลงเล็กๆ มุมจอ กดเล่น/หยุด/ปรับเสียงเองได้ และย่อเก็บได้</p>

  <form action="/admin/music-player" method="post" class="space-y-3">
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ลิงก์ YouTube</label>
      <input name="youtubeUrl" value="<%= settings.music.youtubeUrl %>" placeholder="https://www.youtube.com/watch?v=..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">เริ่มเล่นที่ (นาที:วินาที)</label>
        <input name="startTime" value="<%= Math.floor(settings.music.startSeconds/60) %>:<%= String(settings.music.startSeconds%60).padStart(2,'0') %>" placeholder="0:00" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-sm mb-1 text-[var(--text-3)]">จบท่อนที่ (ไม่บังคับ)</label>
        <input name="endTime" value="<%= settings.music.endSeconds ? Math.floor(settings.music.endSeconds/60) + ':' + String(settings.music.endSeconds%60).padStart(2,'0') : '' %>" placeholder="0:00" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      </div>
    </div>
    <p class="text-xs text-[var(--text-4)] -mt-1">ใส่ทั้งสองช่องเพื่อเลือกเล่นเฉพาะท่อนที่ต้องการ (จะวนซ้ำเฉพาะช่วงนั้น) หรือใส่แค่ "เริ่มเล่นที่" อย่างเดียวก็ได้</p>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ระดับเสียงเริ่มต้น (<%= settings.music.defaultVolume %>%)</label>
      <input type="range" name="defaultVolume" min="0" max="100" value="<%= settings.music.defaultVolume %>" class="w-full accent-[var(--gold)]" />
    </div>
    <label class="flex items-center gap-2 bg-[var(--input)] border-2 <%= settings.music.enabled ? 'border-[var(--gold)]' : 'border-[var(--border-light)]' %> rounded-lg px-3 py-2 cursor-pointer text-sm">
      <input type="checkbox" name="enabled" <%= settings.music.enabled ? 'checked' : '' %> class="accent-[var(--gold)]" />
      เปิดใช้งานเพลงหน้าเว็บ
    </label>
    <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-6 py-2 rounded-lg text-sm">บันทึกการตั้งค่าเพลง</button>
  </form>
</div>

<div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 max-w-xl mt-6">
  <h3 class="font-semibold mb-1">❄️ หิมะตกหน้าเว็บ</h3>
  <p class="text-xs text-[var(--text-4)] mb-4">เพิ่มเอฟเฟกต์หิมะตกตกแต่งบนหน้าเว็บ (ไม่บังการใช้งาน กดผ่านได้ปกติ)</p>
  <form action="/admin/snow-toggle" method="post">
    <label class="flex items-center gap-2 bg-[var(--input)] border-2 <%= settings.snow.enabled ? 'border-[var(--gold)]' : 'border-[var(--border-light)]' %> rounded-lg px-3 py-2 cursor-pointer text-sm w-fit">
      <input type="checkbox" name="enabled" <%= settings.snow.enabled ? 'checked' : '' %> class="accent-[var(--gold)]" onchange="this.form.submit()" />
      เปิดใช้งานหิมะตก
    </label>
  </form>
</div>
