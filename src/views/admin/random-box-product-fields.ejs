<link rel="stylesheet" href="<%= asset('css/admin-random-box-product-fields-v1.css') %>" />
<% if (allowRandomBox) { %>
  <% const isBoxProduct = Boolean(product && product.specialType === 'random-box'); %>
  <section class="random-box-product-kind" aria-labelledby="product-kind-title">
    <h2 id="product-kind-title">ประเภทสินค้า</h2>
    <p>เลือกสินค้าปกติ หรือกล่องสุ่มที่คิดเงิน 1 บาทต่อครั้ง</p>
    <div class="random-box-kind-options">
      <label><input type="radio" name="productKind" value="standard" <%= isBoxProduct ? '' : 'checked' %> /><span><strong>สินค้าปกติ</strong><small>ขายตามราคาและสต็อกสินค้าเดิม</small></span></label>
      <label><input type="radio" name="productKind" value="random-box" <%= isBoxProduct ? 'checked' : '' %> /><span><strong>กล่องสุ่ม · ฿1/ครั้ง</strong><small>สะสมยอดรวมทุกคนตามเรท แล้วสุ่มออก 1 รางวัล</small></span></label>
    </div>
  </section>

  <section class="random-box-config" data-random-box-panel <%= isBoxProduct ? '' : 'hidden' %> aria-labelledby="random-box-rate-heading">
    <div class="random-box-config-head">
      <div><h3 id="random-box-rate-heading">ตั้งค่าเรทกล่องสุ่ม</h3><p>ใส่คีย์/ไอดีในหน้าสต็อกโดยตรง · สินค้า 1 บรรทัดนับเป็น 1 ชิ้น</p></div>
      <span class="random-box-price-pill">฿1 / ครั้ง</span>
    </div>
    <label class="random-box-rate-field"><span>เรทออกรางวัล</span><input name="randomBoxRate" type="number" min="0.01" max="100" step="0.01" value="<%= Number(product?.randomBox?.rate) || 1 %>" placeholder="เช่น 1 หรือ 2" data-random-box-required /><small data-random-box-range>เรท 1 คือสินค้า 1 ชิ้นในช่วง 85–110 บาท · ครั้งละ 1 บาท</small><small>เปลี่ยนเรทแล้วเริ่มรอบรวมใหม่ · นับยอดเปิดรวมลูกค้าทุกคน</small></label>
    <div class="random-box-rule" role="note"><strong>รางวัลมาจากสต็อก</strong><span>เพิ่มคีย์หรือไอดีในหน้าสต็อกอย่างละ 1 บรรทัด ระบบสุ่มตัดและส่ง 1 ชิ้นเมื่อรอบครบโดยอัตโนมัติ</span></div>
    <% if (isBoxProduct) { %><a class="random-box-prize-add inline-flex items-center" href="/admin/products/<%= product.id %>/stock#add-stock">ไปเพิ่มคีย์/ไอดีในสต็อก →</a><% } %>
  </section>
  <script>
    (() => {
      const form = document.currentScript && document.currentScript.closest('form');
      if (!form) return;
      const panel = form.querySelector('[data-random-box-panel]');
      const typeRadios = form.querySelectorAll('input[name="productKind"]');
      const rateInput = panel?.querySelector('input[name="randomBoxRate"]');
      const rateRange = panel?.querySelector('[data-random-box-range]');
      const priceInput = form.querySelector('input[name="price"]');
      const priceLabel = priceInput && priceInput.closest('label,div');
      const priceCaption = priceLabel && priceLabel.querySelector('span');
      const normalPriceCaption = priceCaption ? priceCaption.textContent : '';
      if (!panel || !typeRadios.length) return;
      const isBox = () => form.querySelector('input[name="productKind"]:checked')?.value === 'random-box';
      const updateRateRange = () => {
        if (!rateInput || !rateRange) return;
        const rate = Number(rateInput.value);
        if (!Number.isFinite(rate) || rate < 0.01 || rate > 100) {
          rateRange.textContent = 'ใส่เรทตั้งแต่ 0.01 ถึง 100 เพื่อดูช่วงออกรางวัล';
          return;
        }
        const minTarget = rate === 100 ? 1 : Math.max(1, Math.ceil((85 / rate) / 5) * 5);
        const maxTarget = rate === 100 ? 1 : Math.max(minTarget, Math.ceil((110 / rate) / 10) * 10);
        const format = value => value.toLocaleString('th-TH', { maximumFractionDigits: 2 });
        rateRange.textContent = `เรท ${format(rate)} คือสินค้า 1 ชิ้นในช่วง ${minTarget.toLocaleString('th-TH')}–${maxTarget.toLocaleString('th-TH')} บาท · ครั้งละ 1 บาท`;
      };
      let normalPrice = priceInput ? priceInput.value : '';
      const update = () => {
        const active = isBox();
        panel.hidden = !active;
        if (priceInput) {
          if (!active && priceInput.readOnly) priceInput.value = normalPrice;
          if (active && !priceInput.readOnly) normalPrice = priceInput.value;
          priceInput.readOnly = active;
          priceInput.min = active ? '1' : '0';
          priceInput.max = active ? '1' : '';
          priceInput.value = active ? '1' : priceInput.value;
          if (priceLabel) priceLabel.classList.toggle('random-box-fixed-price', active);
          if (priceCaption) priceCaption.textContent = active ? 'ราคาต่อครั้ง · กำหนดไว้ 1 บาท' : normalPriceCaption;
        }
        form.querySelectorAll('[data-random-box-hide]').forEach(element => { element.hidden = active; });
        panel.querySelectorAll('[data-random-box-required]').forEach(input => { input.required = active; });
      };
      typeRadios.forEach(radio => radio.addEventListener('change', update));
      rateInput?.addEventListener('input', updateRateRange);
      update();
      updateRateRange();
    })();
  </script>
<% } else { %><input type="hidden" name="productKind" value="standard" /><% } %>
