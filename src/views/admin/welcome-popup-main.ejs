<%
  const popup = settings.welcomePopup || {};
  const popupImages = Array.isArray(popup.images) ? popup.images : [];
  const popupTitle = popup.title || 'ยินดีต้อนรับ!';
  const popupContent = popup.content || 'ขอบคุณที่ใช้บริการเว็บไซต์ของเรา';
%>
<link rel="stylesheet" href="<%= asset('css/admin-welcome-popup-main-v1.css') %>" />

<div class="experiment-app welcome-live-page" data-welcome-popup-page>
  <div class="experiment-main">
    <header class="experiment-topbar"><span class="experiment-user-name">admin</span></header>
    <main class="experiment-content welcome-live-content">
      <section class="welcome-live-hero">
        <div>
          <span class="experiment-kicker">STOREFRONT · WELCOME EXPERIENCE</span>
          <h1>ป๊อปอัปต้อนรับ</h1>
          <p>จัดการข้อความและภาพสไลด์ที่ลูกค้าเห็นเมื่อเข้าหน้าร้าน การเปลี่ยนแปลงจะมีผลหลังบันทึก</p>
        </div>
        <div class="welcome-live-hero-actions">
          <span class="welcome-live-status <%= popup.enabled ? 'is-active' : '' %>" data-welcome-status><i></i><span><%= popup.enabled ? 'กำลังแสดงบนหน้าร้าน' : 'ปิดการแสดงอยู่' %></span></span>
          <a class="experiment-button" href="/" target="_blank" rel="noopener">ดูหน้าร้าน <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="welcome-live-stats" aria-label="สรุปป๊อปอัปต้อนรับ">
        <article><span class="welcome-live-stat-icon" aria-hidden="true">◉</span><div><small>สถานะ</small><strong data-welcome-stat-status><%= popup.enabled ? 'เปิดใช้งาน' : 'ปิดไว้' %></strong></div></article>
        <article><span class="welcome-live-stat-icon" aria-hidden="true">▧</span><div><small>ภาพสไลด์ที่บันทึก</small><strong><%= popupImages.length %> รูป</strong></div></article>
        <article><span class="welcome-live-stat-icon" aria-hidden="true">Aa</span><div><small>ข้อความที่แสดง</small><strong><%= (popup.showTitle !== false ? 1 : 0) + (popup.showContent !== false ? 1 : 0) %> ส่วน</strong></div></article>
      </section>

      <form action="/admin/welcome-popup" method="post" enctype="multipart/form-data" class="welcome-live-form" data-welcome-form>
        <div class="welcome-live-grid">
          <section class="welcome-live-card welcome-live-editor" aria-labelledby="welcome-live-editor-title">
            <header class="welcome-live-card-head">
              <span class="welcome-live-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42m-9.88 9.88-1.42 1.42"/><circle cx="12" cy="12" r="5"/></svg></span>
              <div><span class="welcome-live-eyebrow">CONTENT & DISPLAY</span><h2 id="welcome-live-editor-title">ตั้งค่าข้อความ</h2><p>เลือกเปิดป๊อปอัปและแก้ข้อความที่ลูกค้าจะเห็น</p></div>
            </header>

            <label class="welcome-live-switch-row" for="welcome-live-enabled">
              <span><strong>เปิดป๊อปอัปต้อนรับ</strong><small>แสดงเมื่อมีคนเข้าหน้าร้าน</small></span>
              <input id="welcome-live-enabled" type="checkbox" name="enabled" role="switch" data-welcome-enabled <%= popup.enabled ? 'checked' : '' %> />
              <i aria-hidden="true"></i>
            </label>

            <fieldset class="welcome-live-fieldset">
              <legend>การแสดงข้อความ</legend>
              <div class="welcome-live-visibility">
                <label for="welcome-live-show-title"><input id="welcome-live-show-title" type="checkbox" name="showTitle" data-welcome-show-title <%= popup.showTitle !== false ? 'checked' : '' %> /><span><strong>แสดงหัวข้อ</strong><small>เปิด/ปิดหัวข้อบนป๊อปอัป</small></span></label>
                <label for="welcome-live-show-content"><input id="welcome-live-show-content" type="checkbox" name="showContent" data-welcome-show-content <%= popup.showContent !== false ? 'checked' : '' %> /><span><strong>แสดงเนื้อหา</strong><small>เปิด/ปิดข้อความต้อนรับ</small></span></label>
              </div>
            </fieldset>

            <label class="welcome-live-field" for="welcome-live-title"><span>หัวข้อป๊อปอัป</span><input id="welcome-live-title" type="text" name="title" maxlength="200" value="<%= popupTitle %>" data-welcome-title autocomplete="off" /></label>
            <label class="welcome-live-field" for="welcome-live-content"><span>ข้อความประชาสัมพันธ์</span><textarea id="welcome-live-content" name="content" rows="5" maxlength="5000" data-welcome-content><%= popupContent %></textarea><small>ข้อความจะแสดงใต้หัวข้อในหน้าต่างต้อนรับ</small></label>

          </section>

          <section class="welcome-live-card welcome-live-media" aria-labelledby="welcome-live-media-title">
            <header class="welcome-live-card-head">
              <span class="welcome-live-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></svg></span>
              <div><span class="welcome-live-eyebrow">SLIDE GALLERY</span><h2 id="welcome-live-media-title">รูปภาพสไลด์</h2><p>เพิ่มได้หลายรูป ภาพจะหมุนสลับบนป๊อปอัปของหน้าร้าน</p></div>
              <span class="welcome-live-count" data-welcome-image-count><%= popupImages.length %> รูป</span>
            </header>

            <label class="welcome-live-upload" for="welcome-live-files">
              <span class="welcome-live-upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m-5 5 5-5 5 5M4 16v4h16v-4"/></svg></span>
              <span><strong>คลิกเพื่อเลือกรูป หรือลากไฟล์มาวาง</strong><small>JPG, PNG หรือ WEBP · ไม่เกิน 20 รูป · 8 MB ต่อรูป</small></span>
              <input id="welcome-live-files" type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple data-welcome-files />
            </label>
            <div class="welcome-live-file-summary" data-welcome-file-summary aria-live="polite">ยังไม่ได้เลือกไฟล์ใหม่</div>

            <div class="welcome-live-gallery-head"><div><h3>รูปที่บันทึกไว้</h3><p>เลือกรูปที่ต้องการนำออก แล้วบันทึกเพื่อยืนยัน</p></div><span data-welcome-kept-count><%= popupImages.length %> รูป</span></div>
            <% if (popupImages.length) { %>
              <div class="welcome-live-gallery" data-welcome-gallery>
                <% popupImages.forEach((image, index) => { %>
                  <label class="welcome-live-image-card" for="welcome-live-remove-<%= index %>">
                    <img src="<%= image %>" alt="รูปสไลด์ที่ <%= index + 1 %>" loading="lazy" data-welcome-existing-image />
                    <span class="welcome-live-image-label"><span>รูปที่ <%= index + 1 %></span><span class="welcome-live-remove-label"><input id="welcome-live-remove-<%= index %>" type="checkbox" name="removeImages" value="<%= image %>" data-welcome-remove /> นำออก</span></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <p class="welcome-live-gallery-empty" data-welcome-gallery-empty>ยังไม่มีรูปที่บันทึกไว้ เลือกรูปด้านบนเพื่อเพิ่มสไลด์แรก</p>
              <div class="welcome-live-gallery" data-welcome-gallery hidden></div>
            <% } %>

          </section>
        </div>

        <footer class="welcome-live-savebar">
          <div><span class="welcome-live-save-indicator" data-welcome-save-indicator></span><span data-welcome-save-state role="status" aria-live="polite">ยังไม่มีการเปลี่ยนแปลง</span></div>
          <button class="experiment-button primary welcome-live-save" type="submit" data-welcome-save><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l3 3v13H4V4h1Z"/><path d="M8 4v6h8V4M8 20v-6h8v6"/></svg><span>บันทึกการเปลี่ยนแปลง</span></button>
        </footer>
      </form>
    </main>
  </div>
</div>

<script>
(function () {
  var page = document.querySelector('[data-welcome-popup-page]');
  var form = page && page.querySelector('[data-welcome-form]');
  if (!form) return;

  var enabled = form.querySelector('[data-welcome-enabled]');
  var fileInput = form.querySelector('[data-welcome-files]');
  var pageStatus = page.querySelector('[data-welcome-status]');
  var statStatus = page.querySelector('[data-welcome-stat-status]');
  var fileSummary = form.querySelector('[data-welcome-file-summary]');
  var imageCount = form.querySelector('[data-welcome-image-count]');
  var keptCount = form.querySelector('[data-welcome-kept-count]');
  var gallery = form.querySelector('[data-welcome-gallery]');
  var galleryEmpty = form.querySelector('[data-welcome-gallery-empty]');
  var saveState = form.querySelector('[data-welcome-save-state]');
  var saveIndicator = form.querySelector('[data-welcome-save-indicator]');
  var saveButton = form.querySelector('[data-welcome-save]');
  var selectedFiles = [];

  function render() {
    var isEnabled = enabled.checked;
    pageStatus.classList.toggle('is-active', isEnabled);
    pageStatus.querySelector('span').textContent = isEnabled ? 'กำลังแสดงบนหน้าร้าน' : 'ปิดการแสดงอยู่';
    statStatus.textContent = isEnabled ? 'เปิดใช้งาน' : 'ปิดไว้';
    var imageTotal = form.querySelectorAll('[data-welcome-remove]:not(:checked)').length + selectedFiles.length;
    imageCount.textContent = imageTotal + ' รูป';
    if (keptCount) keptCount.textContent = form.querySelectorAll('[data-welcome-remove]:not(:checked)').length + ' รูป';
    if (galleryEmpty) galleryEmpty.hidden = imageTotal > 0;
    if (gallery) gallery.classList.toggle('has-removals', !!form.querySelector('[data-welcome-remove]:checked'));
  }
  function markDirty() {
    saveState.textContent = 'มีการแก้ไขที่ยังไม่ได้บันทึก';
    saveIndicator.classList.add('is-dirty');
  }
  form.addEventListener('input', function () { render(); markDirty(); });
  form.addEventListener('change', function () { render(); markDirty(); });
  if (fileInput) fileInput.addEventListener('change', function () {
    selectedFiles = Array.from(fileInput.files || []);
    var invalid = selectedFiles.length > 20 || selectedFiles.some(function (file) { return file.size > 8 * 1024 * 1024; });
    fileInput.setCustomValidity(selectedFiles.length > 20 ? 'เลือกภาพได้สูงสุด 20 รูปต่อครั้ง' : selectedFiles.some(function (file) { return file.size > 8 * 1024 * 1024; }) ? 'แต่ละรูปต้องมีขนาดไม่เกิน 8 MB' : '');
    if (selectedFiles.length) {
      var names = selectedFiles.slice(0, 3).map(function (file) { return file.name; });
      fileSummary.textContent = invalid ? (selectedFiles.length > 20 ? 'เลือกเกิน 20 รูป กรุณาเลือกใหม่' : 'มีไฟล์ขนาดเกิน 8 MB กรุณาเลือกใหม่') : selectedFiles.length + ' รูปที่เลือก' + (names.length ? ' · ' + names.join(', ') : '') + (selectedFiles.length > 3 ? ' และอีก ' + (selectedFiles.length - 3) + ' รูป' : '');
      fileSummary.classList.toggle('is-error', invalid);
    } else {
      fileSummary.textContent = 'ยังไม่ได้เลือกไฟล์ใหม่';
      fileSummary.classList.remove('is-error');
    }
    render();
    markDirty();
  });

  var uploadLabel = form.querySelector('.welcome-live-upload');
  if (uploadLabel) {
    ['dragenter', 'dragover'].forEach(function (name) { uploadLabel.addEventListener(name, function (event) { event.preventDefault(); uploadLabel.classList.add('is-dragging'); }); });
    ['dragleave', 'drop'].forEach(function (name) { uploadLabel.addEventListener(name, function (event) { event.preventDefault(); uploadLabel.classList.remove('is-dragging'); }); });
    uploadLabel.addEventListener('drop', function (event) {
      if (!event.dataTransfer?.files?.length) return;
      var transfer = new DataTransfer();
      Array.from(event.dataTransfer.files).filter(function (file) { return /^image\/(jpeg|png|webp)$/.test(file.type); }).forEach(function (file) { transfer.items.add(file); });
      fileInput.files = transfer.files;
      fileInput.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }
  form.addEventListener('submit', function (event) {
    if (!form.reportValidity()) { event.preventDefault(); return; }
    saveState.textContent = 'กำลังบันทึกการเปลี่ยนแปลง…';
    saveIndicator.classList.remove('is-dirty');
    saveButton.disabled = true;
    saveButton.setAttribute('aria-busy', 'true');
    saveButton.querySelector('span').textContent = 'กำลังบันทึก…';
  });
  render();
})();
</script>
