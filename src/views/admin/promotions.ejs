<link rel="stylesheet" href="<%= asset('css/promotions-v1.css') %>" />
<link rel="stylesheet" href="<%= asset('css/admin-promotions-v1.css') %>" />
<% const ref = config.referral || {}; const datetime = value => value ? new Date(Date.parse(value)+7*3600000).toISOString().slice(0,16) : ''; %>
<div class="experiment-app"><div class="experiment-main"><main class="experiment-content"><section class="promo-page promo-admin">
<% ['success','error'].forEach(kind => { (messages[kind] || []).forEach(message => { %><div class="promo-notice" role="status"><%= message %></div><% }); }); %>
<header class="promo-hero experiment-page-head"><div><div class="experiment-kicker">โปรโมชั่น & สมาชิก</div><h1>โปรโมชั่นและแนะนำเพื่อน</h1><p>ตั้งพ้อย เวลารับสิทธิ์ และจำนวนผู้รับของร้านนี้ · พ้อยเข้ากระเป๋าซื้อสินค้าโดยตรง</p></div><a class="experiment-button" href="/promotions">ดูหน้าลูกค้า →</a></header>
<section class="promo-admin-stats" aria-label="สรุปโปรโมชั่น">
<article><span>โปรโมชั่นทั้งหมด</span><strong><%= (config.campaigns || []).length.toLocaleString('th-TH') %></strong><small>รายการในร้านนี้</small></article>
<article><span>เปิดรับสิทธิ์</span><strong><%= (config.campaigns || []).filter(c => c.enabled).length.toLocaleString('th-TH') %></strong><small>รายการที่เปิดใช้งาน</small></article>
<article><span>รับสิทธิ์แล้ว</span><strong><%= claims.length.toLocaleString('th-TH') %></strong><small>ครั้งสะสมในร้านนี้</small></article>
</section>
<% if (isMainSite) { %><div class="promo-notice">โปรโมชั่นแสดงบนเว็บหลักของคุณอยู่แล้ว เว็บร้านเช่าสามารถเปิดใช้เองจากหลังบ้านของแต่ละร้าน</div><% } else { %><article class="promo-card promo-storefront-control"><h2>แสดงโปรโมชั่นบนหน้าเว็บร้าน</h2><p>ตั้งค่าเริ่มต้นปิดไว้ เจ้าของร้านเลือกเปิดเมื่อพร้อมใช้งาน หน้าหลักและหน้าลูกค้าจะใช้สถานะเดียวกัน</p><form action="/admin/promotions/storefront" method="post" class="promo-form"><input type="hidden" name="csrf" value="<%= csrf %>"/><label class="promo-check"><input type="checkbox" name="enabled" <%= storefrontEnabled ? 'checked' : '' %>/> เปิดหมวดโปรโมชั่นสำหรับลูกค้า</label><button class="promo-button"><%= storefrontEnabled ? 'บันทึกและแสดงบนหน้าร้าน' : 'บันทึกสถานะปิด' %></button></form><p class="promo-state"><%= storefrontEnabled ? 'สถานะ: เปิดให้ลูกค้าเห็น' : 'สถานะ: ซ่อนจากลูกค้า' %></p></article><% } %>
<div class="promo-notice"><strong>1 พ้อย = ฿1 ในกระเป๋าร้านนี้</strong><p>โปรโมชั่นใหม่ปิดไว้จนกว่าจะเลือกเปิดใช้งาน สมาชิกต้องเข้าสู่ระบบและรับด้วยชื่อบัญชีตัวเอง</p><a class="promo-link" href="/admin/coupons">จัดการคูปองส่วนลด →</a></div>
<div class="promo-grid"><article class="promo-card"><h2>สร้างโปรโมชั่นรับพ้อย</h2><form action="/admin/promotions/campaign" method="post" class="promo-form"><input type="hidden" name="csrf" value="<%= csrf %>"/>
<label>ชื่อโปรโมชั่น<input name="title" maxlength="120" required placeholder="เช่น ต้อนรับสมาชิกใหม่"/></label><label>รายละเอียด<textarea name="description" maxlength="500" rows="3" placeholder="เงื่อนไขและข้อความแนะนำ"></textarea></label><div class="promo-grid"><label>พ้อยต่อคน<input name="amount" type="number" min="0.01" max="100000" step="0.01" required/></label><label>จำกัดจำนวนสิทธิ์<input name="maxClaims" type="number" min="0" max="1000000" value="0"/><small>0 = ไม่จำกัด</small></label></div><label>เริ่ม (เวลาประเทศไทย)<input name="startsAt" type="datetime-local"/></label><label>สิ้นสุด (เวลาประเทศไทย)<input name="endsAt" type="datetime-local"/></label><label class="promo-check"><input type="checkbox" name="newMembersOnly"/> เฉพาะสมาชิกที่สมัครตั้งแต่เวลาเริ่ม</label><label class="promo-check"><input type="checkbox" name="enabled"/> เปิดรับสิทธิ์และแสดงหน้าหลัก</label><button class="promo-button">สร้างโปรโมชั่น</button></form></article>
<article class="promo-card"><h2>ตั้งรางวัลแนะนำเพื่อน</h2><p>เพื่อนต้องสมัครผ่านลิงก์สมาชิกก่อน และมีคำสั่งซื้อที่ชำระจริงสำเร็จอย่างน้อยหนึ่งรายการ</p><form action="/admin/promotions/referral" method="post" class="promo-form"><input type="hidden" name="csrf" value="<%= csrf %>"/><label>พ้อยผู้แนะนำ<input name="referrerAmount" type="number" min="0" max="100000" step="0.01" value="<%= ref.referrerAmount || 0 %>" required/></label><label>พ้อยเพื่อนใหม่<input name="friendAmount" type="number" min="0" max="100000" step="0.01" value="<%= ref.friendAmount || 0 %>" required/></label><label>เริ่ม (เวลาประเทศไทย)<input name="startsAt" type="datetime-local" value="<%= datetime(ref.startsAt) %>"/></label><label>สิ้นสุด (เวลาประเทศไทย)<input name="endsAt" type="datetime-local" value="<%= datetime(ref.endsAt) %>"/></label><label class="promo-check"><input type="checkbox" name="enabled" <%= ref.enabled ? 'checked' : '' %>/> เปิดระบบแนะนำเพื่อน</label><button class="promo-button">บันทึกรางวัลแนะนำเพื่อน</button></form><small>ตั้งฝ่ายใดเป็น 0 ได้หากไม่ต้องการแจกฝ่ายนั้น · เปลี่ยนยอดมีผลกับรางวัลที่ยังไม่ได้รับ</small></article></div>
<div class="promo-heading"><h2>โปรโมชั่นทั้งหมด</h2><p>สร้างแล้วแก้ยอดย้อนหลังไม่ได้ เพื่อรักษาประวัติรางวัล ปิดรายการเดิมและสร้างรายการใหม่เมื่อต้องการเปลี่ยนเงื่อนไข</p></div><div class="promo-grid"><% if (!(config.campaigns || []).length) { %><div class="promo-empty"><h3>ยังไม่มีโปรโมชั่น</h3><p>สร้างโปรโมชั่นรับพ้อยจากแบบฟอร์มด้านบน แล้วเปิดรับสิทธิ์เมื่อพร้อม</p></div><% } %><% (config.campaigns || []).forEach(c => { %><article class="promo-card"><span class="promo-tag"><%= c.enabled ? 'เปิด' : 'ปิด' %></span><h3><%= c.title %></h3><strong class="promo-amount"><%= c.amount %><small>พ้อยต่อคน</small></strong><p>รับแล้ว <%= claims.filter(x=>x.campaignId===c.id).length %> คน<%= c.maxClaims ? ' / '+c.maxClaims+' สิทธิ์' : '' %></p><p><%= c.startsAt ? new Date(c.startsAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่จำกัดเวลาเริ่ม' %> — <%= c.endsAt ? new Date(c.endsAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่จำกัดเวลาสิ้นสุด' %></p><form action="/admin/promotions/campaign/<%= c.id %>/toggle" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"/><button class="promo-button secondary"><%= c.enabled ? 'ปิดรับสิทธิ์' : 'เปิดรับสิทธิ์' %></button></form></article><% }) %></div>
</section></main></div></div>
