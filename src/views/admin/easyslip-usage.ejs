          </div>
          <p class="text-xs text-[var(--text-4)]">เชื่อมต่อเซิร์ฟเวอร์ตรวจสลิปภายนอกของคุณเอง</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">Custom Slip Endpoint URL</label>
          <input type="url" name="customSlipEndpoint" value="<%= payment.customSlipEndpoint || '' %>" placeholder="https://your-api.com/verify-slip" class="w-full bg-[var(--input)] border border-[var(--border)] rounded-xl px-3.5 py-2.5 text-xs text-[var(--text)] focus:outline-none focus:border-[var(--gold)] font-mono transition">
        </div>

        <div>
          <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">Custom API Secret / Key</label>
          <input type="password" name="customSlipApiKey" value="<%= payment.customSlipApiKey || '' %>" placeholder="Secret Token สำหรับตรวจสลิป" class="w-full bg-[var(--input)] border border-[var(--border)] rounded-xl px-3.5 py-2.5 text-xs text-[var(--text)] focus:outline-none focus:border-[var(--gold)] font-mono transition">
        </div>
      </div>
    </div>

    <!-- Discord Webhook Settings Card -->
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-4 pb-3 border-b border-[var(--border)]">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl">
          🔔
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-sm text-[var(--text)]">Discord Webhook แจ้งเตือนการเติมเงิน</h3>
            <span class="px-2 py-0.5 text-[10px] font-bold bg-indigo-500/20 text-indigo-400 rounded">Notification</span>
          </div>
          <p class="text-xs text-[var(--text-4)]">ส่งการแจ้งเตือนเข้าห้อง Discord ทันทีเมื่อมีลูกค้าแจ้งโอนเงินหรือตรวจสลิปสำเร็จ</p>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">Discord Webhook URL</label>
        <input type="url" name="topupWebhookUrl" value="<%= payment.topupWebhookUrl || '' %>" placeholder="https://discord.com/api/webhooks/..." class="w-full bg-[var(--input)] border border-[var(--border)] rounded-xl px-3.5 py-2.5 text-xs text-[var(--text)] focus:outline-none focus:border-[var(--gold)] font-mono transition">
      </div>
    </div>

  </div>

  <!-- Save Button Bar -->
  <div class="sticky bottom-4 z-20 bg-[var(--card)]/90 backdrop-blur-md border border-[var(--border)] rounded-2xl p-4 shadow-xl flex items-center justify-between gap-4">
    <div class="text-xs text-[var(--text-4)] hidden sm:block">
      อย่าลืมกด <b>"บันทึกการตั้งค่าระบบตรวจสลิป"</b> เพื่อให้ระบบเริ่มใช้ค่าย API ที่คุณเลือก
    </div>
    <div class="flex items-center gap-3 ml-auto">
      <button type="submit" class="px-6 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--gold-contrast)] hover:brightness-110 active:scale-95 transition shadow-lg shadow-[var(--gold)]/20">
        💾 บันทึกการตั้งค่าระบบตรวจสลิป
      </button>
    </div>
  </div>

</form>

<script>
function onProviderChanged(provider) {
  document.querySelectorAll('input[name="slipProvider"]').forEach(radio => {
    const parent = radio.closest('label');
    if (radio.checked) {
      parent.classList.add('bg-[var(--gold)]/10', 'border-[var(--gold)]', 'shadow-md');
      parent.classList.remove('bg-[var(--card)]', 'border-[var(--border)]');
    } else {
      parent.classList.remove('bg-[var(--gold)]/10', 'border-[var(--gold)]', 'shadow-md');
      parent.classList.add('bg-[var(--card)]', 'border-[var(--border)]');
    }
  });
}

function togglePasswordVisibility(inputId) {
  const el = document.getElementById(inputId);
  if (el) {
    el.type = el.type === 'password' ? 'text' : 'password';
  }
}

async function testProviderConnection(provider) {
  let resultEl = document.getElementById(`${provider}-test-result`);
  if (!resultEl) return;

  resultEl.classList.remove('hidden');
  resultEl.innerHTML = `
    <div class="p-3.5 rounded-xl bg-[var(--input)] border border-[var(--border)] text-xs text-[var(--text-3)] flex items-center gap-2 animate-pulse">
      <div class="w-3.5 h-3.5 border-2 border-[var(--gold)] border-t-transparent rounded-full animate-spin"></div>
      <span>กำลังทดสอบการเชื่อมต่อ ${provider.toUpperCase()} API...</span>
    </div>
  `;

  let payload = { provider };

  if (provider === 'slipok') {
    payload.branchId = document.getElementById('slipok-branch-input')?.value || '';
    payload.apiKey = document.getElementById('slipok-key-input')?.value || '';
  } else if (provider === 'slip2go') {
    payload.apiKey = document.getElementById('slip2go-key-input')?.value || '';
    payload.endpoint = document.querySelector('input[name="slip2goEndpoint"]')?.value || '';
  }

  try {
    const res = await fetch('/admin/slip-verification/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (data.ok) {
      let extraInfo = '';
      if (data.balance !== undefined) extraInfo += ` • ยอดคงเหลือ: ฿${Number(data.balance).toLocaleString()}`;
      if (data.quota !== undefined) extraInfo += ` • โควตา: ${data.quota} ครั้ง`;
      if (data.isDemo) extraInfo += ` (โหมดจำลอง Test/Demo)`;

      resultEl.innerHTML = `
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-400 flex items-start gap-2.5">
          <span class="text-base">✅</span>
          <div>
            <b class="text-emerald-300 block mb-0.5">เชื่อมต่อสำเร็จ!</b>
            <span>${data.message || 'API ตอบสนองปกติ พร้อมใช้งานตรวจสลิป'}${extraInfo}</span>
          </div>
        </div>
      `;
    } else {
      resultEl.innerHTML = `
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-400 flex items-start gap-2.5">
          <span class="text-base">❌</span>
          <div>
            <b class="text-rose-300 block mb-0.5">เชื่อมต่อไม่สำเร็จ</b>
            <span>${data.message || 'โปรดตรวจสอบความถูกต้องของ API Key และ Endpoint'}</span>
          </div>
        </div>
      `;
    }
  } catch (err) {
    resultEl.innerHTML = `
      <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-400 flex items-start gap-2.5">
        <span class="text-base">❌</span>
        <div>
          <b class="text-rose-300 block mb-0.5">เกิดข้อผิดพลาดในการเชื่อมต่อ</b>
          <span>${err.message}</span>
        </div>
      </div>
    `;
  }
}
</script>
