        </div>

        <button type="button" onclick="testProviderConnection('slip2go')" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 hover:bg-amber-500/20 transition active:scale-95 shadow-sm">
          <span>⚡ ทดสอบเชื่อมต่อ Slip2Go</span>
        </button>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">Slip2Go API Key</label>
          <div class="relative">
            <input type="password" id="slip2go-key-input" name="slip2goApiKey" value="<%= payment.slip2goApiKey || '' %>" placeholder="ใส่ Slip2Go API Key" class="w-full bg-[var(--input)] border border-[var(--border)] rounded-xl px-3.5 py-2.5 text-xs text-[var(--text)] focus:outline-none focus:border-[var(--gold)] font-mono transition">
            <button type="button" onclick="togglePasswordVisibility('slip2go-key-input')" class="absolute right-3 top-2.5 text-xs text-[var(--text-4)] hover:text-[var(--text)]">👁️</button>
          </div>
          <p class="text-[11px] text-[var(--text-4)] mt-1">💡 ใส่ <code class="bg-[var(--input)] px-1 rounded text-amber-400 font-mono">test_demo</code> เพื่อทดสอบระบบจำลอง</p>
        </div>

        <div>
