<!-- Slip Verification API Provider Hub Header -->
<p class="mb-4 rounded-xl border p-4">การตรวจสลิปใช้ EasySlip/SlipOK และคีย์เดิมของระบบ ส่วนฟังก์ชันอื่นคงตามรุ่นที่ปรับปรุงใหม่</p>
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">🧾 ระบบตรวจสอบสลิปด้วย API</h1>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        Multi-Provider
      </span>
    </div>
    <p class="text-xs text-[var(--text-4)] mt-1">ตั้งค่าและเลือกค่าย API สำหรับตรวจสอบสลิปธนาคารและพร้อมเพย์อัตโนมัติ เพื่ออนุมัติยอดเงินทันที 24 ชม.</p>
  </div>

  <div class="flex items-center gap-2">
    <a href="/admin/topups" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[var(--card)] border border-[var(--border)] text-[var(--text-3)] hover:text-[var(--text)] hover:bg-[var(--input)] transition shadow-sm">
      <svg class="w-4 h-4 text-[var(--gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
      <span>จัดการเติมเงิน & รายการสลิป</span>
    </a>
  </div>
</div>

<!-- Active Provider Notification Card -->
<div class="bg-gradient-to-r from-[var(--gold)]/10 via-[var(--card)] to-[var(--card)] border border-[var(--gold)]/30 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div class="flex items-center gap-3.5">
    <div class="w-12 h-12 rounded-xl bg-[var(--gold)]/20 text-[var(--gold)] flex items-center justify-center text-2xl shrink-0 shadow-inner">
      <% if (!payment.slipProvider || payment.slipProvider === 'auto') { %>⚡
      <% } else if (payment.slipProvider === 'byshop') { %>🚀
      <% } else if (payment.slipProvider === 'slipok') { %>🛡️
      <% } else if (payment.slipProvider === 'easyslip') { %>⚡
      <% } else if (payment.slipProvider === 'slip2go') { %>⚠️
      <% } else { %>🔌<% } %>
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span class="text-xs text-[var(--text-4)]">ผู้ให้บริการหลักที่ใช้งานอยู่:</span>
        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-[var(--gold)] text-[var(--bg)]">
          <% if (!payment.slipProvider || payment.slipProvider === 'auto') { %>EasySlip/SlipOK อัตโนมัติ
          <% } else if (payment.slipProvider === 'byshop') { %>⭐ BYSHOP API (แนะนำ)
          <% } else if (payment.slipProvider === 'slipok') { %>⭐ SlipOK API (แนะนำ)
          <% } else if (payment.slipProvider === 'easyslip') { %>EasySlip API (มาตรฐาน)
          <% } else if (payment.slipProvider === 'slip2go') { %>Slip2Go API
          <% } else { %>Custom Slip API<% } %>
        </span>
      </div>
      <div class="text-sm font-semibold text-[var(--text)] mt-0.5">
        <% if (!payment.slipProvider || payment.slipProvider === 'auto') { %>
          ระบบเลือก EasySlip หรือ SlipOK จากการตั้งค่าที่เชื่อมต่อไว้โดยอัตโนมัติ
        <% } else if (payment.slipProvider === 'byshop') { %>
          ระบบตรวจสลิปอัตโนมัติผ่าน BYSHOP API (ความเร็วสูง ดักสลิปซ้ำแม่นยำ)
        <% } else if (payment.slipProvider === 'slipok') { %>
          ระบบตรวจสลิปอัตโนมัติผ่าน SlipOK API (Branch: <%= payment.slipokBranchId || 'ยังไม่ระบุ' %>)
        <% } else if (payment.slipProvider === 'easyslip') { %>
          ระบบตรวจสลิปอัตโนมัติผ่าน EasySlip Platform
        <% } else if (payment.slipProvider === 'slip2go') { %>
          ระบบตรวจสลิปอัตโนมัติผ่าน Slip2Go API
        <% } else { %>
          ระบบตรวจสลิปผ่าน Custom Endpoint / Webhook
        <% } %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 shrink-0">
    <button type="button" onclick="document.getElementById('slip-provider-form').scrollIntoView({ behavior: 'smooth' })" class="px-4 py-2 rounded-xl text-xs font-bold bg-[var(--input)] text-[var(--text)] hover:bg-[var(--gold)] hover:text-[var(--bg)] transition border border-[var(--border)]">
      ⚙️ ปรับเปลี่ยนค่าย API
    </button>
  </div>
</div>

<!-- EasySlip Live Status Bar (if EasySlip is configured) -->
<% if (info && info.ok) { %>
  <div class="grid sm:grid-cols-2 gap-4 mb-6">
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[var(--text-4)]">โควตาตรวจสลิป EasySlip คงเหลือ</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-emerald-500/10 text-emerald-400">Online</span>
        </div>
        <div class="text-3xl font-extrabold text-[var(--gold)] tracking-tight">
          <%= info.quota.remaining === null ? 'ไม่จำกัด' : Number(info.quota.remaining).toLocaleString() %>
          <span class="text-xs font-normal text-[var(--text-4)]">ครั้ง</span>
        </div>
      </div>
      <% if (info.quota.max !== null) { %>
        <div class="mt-3 pt-3 border-t border-[var(--border)]">
          <div class="flex justify-between text-xs text-[var(--text-4)] mb-1">
            <span>ใช้ไป <%= Number(info.quota.used || 0).toLocaleString() %> ครั้ง</span>
            <span>ทั้งหมด <%= Number(info.quota.max).toLocaleString() %></span>
          </div>
          <div class="w-full h-2 rounded-full bg-[var(--input)] overflow-hidden">
            <div class="h-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] rounded-full transition-all" style="width: <%= Math.min(100, Math.round((info.quota.used || 0) / info.quota.max * 100)) %>%"></div>
          </div>
        </div>
      <% } %>
    </div>

    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[var(--text-4)]">เครดิตบัญชี EasySlip</span>
          <span class="text-xs font-bold text-[var(--gold)]"><%= info.planName || 'Standard' %></span>
        </div>
        <div class="text-3xl font-extrabold text-[var(--text)] tracking-tight">
          ฿<%= info.credit === null ? '-' : Number(info.credit).toLocaleString() %>
        </div>
      </div>
      <div class="mt-3 pt-3 border-t border-[var(--border)] flex items-center justify-between text-xs">
        <span class="text-[var(--text-4)]">เติมเครดิตเพิ่มเติม:</span>
        <a href="https://developer.easyslip.com" target="_blank" rel="noopener" class="text-[var(--gold)] hover:underline font-semibold inline-flex items-center gap-1">
          <span>EasySlip Dashboard</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>
<% } %>

<!-- Main-site monthly operating costs (not tenant/rented shop expenses) -->
<div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 shadow-sm mb-6">
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-5">
    <div>
      <h2 class="text-lg font-bold text-[var(--text)]">💳 ค่าใช้จ่ายเว็บไซต์ของฉัน</h2>
      <p class="text-xs text-[var(--text-4)] mt-1">รวมเฉพาะเว็บหลัก: VPS และระบบตรวจสลิป EasySlip ไม่รวมค่าใช้จ่ายของร้านเช่า</p>
    </div>
    <div class="sm:text-right">
      <div class="text-xs text-[var(--text-4)]">ควรเตรียมต่อเดือน</div>
      <div class="text-3xl font-extrabold text-[var(--gold)]">฿<%= Number(ownerCostSummary.totalMonthly).toLocaleString('th-TH') %></div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-3 mb-5">
    <div class="rounded-xl border border-[var(--border)] bg-[var(--input)]/40 p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="font-semibold text-sm">🖥️ VPS ReadyIDC</div>
          <div class="text-xs text-[var(--text-4)] mt-1">รอบชำระรายเดือน</div>
        </div>
        <div class="text-right">
          <div class="font-bold text-lg">฿<%= Number(ownerCostSummary.vpsAmount).toLocaleString('th-TH') %></div>
          <div class="text-xs text-[var(--gold)]">จ่ายวันที่ <%= ownerCostSummary.vpsBillingDay %></div>
        </div>
      </div>
      <div class="mt-3 pt-3 border-t border-[var(--border)] text-xs text-[var(--text-3)]">
        รอบถัดไป: <b class="text-[var(--text)]"><%= ownerCostSummary.vpsNextDue.toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Bangkok' }) %></b>
      </div>
    </div>

    <div class="rounded-xl border border-[var(--border)] bg-[var(--input)]/40 p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="font-semibold text-sm">⚡ EasySlip <%= info && info.planName ? info.planName : 'Start' %></div>
          <div class="text-xs text-[var(--text-4)] mt-1"><%= info && info.quota && info.quota.max !== null ? Number(info.quota.max).toLocaleString('th-TH') + ' ครั้ง / 30 วัน' : 'ระบบตรวจสลิปอัตโนมัติ' %></div>
        </div>
        <div class="text-right">
          <div class="font-bold text-lg">฿<%= Number(ownerCostSummary.easyslipAmount).toLocaleString('th-TH') %></div>
          <div class="text-xs text-[var(--gold)]">จ่ายวันที่ <%= ownerCostSummary.easyslipBillingDay %></div>
        </div>
      </div>
      <div class="mt-3 pt-3 border-t border-[var(--border)] text-xs text-[var(--text-3)]">
        รอบถัดไป: <b class="text-[var(--text)]"><%= ownerCostSummary.easyslipNextDue.toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Bangkok' }) %></b>
      </div>
    </div>
  </div>

  <details class="group rounded-xl border border-[var(--border)] bg-[var(--input)]/20">
    <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between text-sm font-semibold">
      <span>แก้ไขค่าใช้จ่ายหรือวันจ่าย</span>
      <span class="text-[var(--text-4)] group-open:rotate-180 transition">⌄</span>
    </summary>
    <form action="/admin/easyslip-usage/billing" method="POST" class="grid sm:grid-cols-2 gap-4 p-4 pt-1 border-t border-[var(--border)]">
      <div class="grid grid-cols-2 gap-2">
        <label class="text-xs text-[var(--text-3)]">ค่า VPS/เดือน
          <input type="number" name="vpsAmount" min="0" step="0.01" value="<%= ownerCostSummary.vpsAmount %>" class="mt-1 w-full bg-[var(--card)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </label>
        <label class="text-xs text-[var(--text-3)]">วันที่จ่าย VPS
          <input type="number" name="vpsBillingDay" min="1" max="28" value="<%= ownerCostSummary.vpsBillingDay %>" class="mt-1 w-full bg-[var(--card)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </label>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <label class="text-xs text-[var(--text-3)]">ค่า EasySlip/เดือน
          <input type="number" name="easyslipAmount" min="0" step="0.01" value="<%= ownerCostSummary.easyslipAmount %>" class="mt-1 w-full bg-[var(--card)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </label>
        <label class="text-xs text-[var(--text-3)]">วันที่จ่าย EasySlip
          <input type="number" name="easyslipBillingDay" min="1" max="28" value="<%= ownerCostSummary.easyslipBillingDay %>" class="mt-1 w-full bg-[var(--card)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </label>
      </div>
      <div class="sm:col-span-2 flex items-center justify-between gap-3">
        <p class="text-[10px] text-[var(--text-4)]">วันจ่ายจำกัดวันที่ 1–28 เพื่อให้มีวันดังกล่าวทุกเดือน</p>
        <button class="px-4 py-2 rounded-xl bg-[var(--gold)] text-[var(--bg)] text-xs font-bold">บันทึก</button>
      </div>
    </form>
  </details>
</div>

<!-- Main Provider Configuration Form -->
<form id="slip-provider-form" action="/admin/slip-verification" method="POST" class="space-y-6">
  <div class="rounded-xl border p-4 space-y-2">
    <label class="block"><input type="radio" name="slipProvider" value="auto" <%= !payment.slipProvider || payment.slipProvider === 'auto' ? 'checked' : '' %>> ใช้การตั้งค่าเดิม (EasySlip/SlipOK)</label>
    <label class="block"><input type="radio" name="slipProvider" value="none" <%= payment.slipProvider === 'none' ? 'checked' : '' %>> ให้แอดมินตรวจสลิปด้วยตนเอง</label>
  </div>

  <!-- Provider Selection Grid -->
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <label class="text-sm font-bold text-[var(--text)] flex items-center gap-2">
        <span>เลือกผู้ให้บริการตรวจสอบสลิป (Active Slip Provider)</span>
        <span class="text-rose-400">*</span>
      </label>
      <span class="text-xs text-[var(--text-4)]">คลิกเลือกค่ายที่คุณต้องการให้ระบบใช้งาน</span>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5">

      <!-- Option 1: BYSHOP (⭐ Recommended 1) -->
      <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition-all duration-200 select-none <%= payment.slipProvider === 'byshop' ? 'bg-[var(--gold)]/10 border-[var(--gold)] shadow-md' : 'bg-[var(--card)] border-[var(--border)] hover:border-[var(--border-hover)]' %>">
        <input type="radio" name="slipProvider" value="byshop" disabled title="ระบบนี้ใช้ EasySlip/SlipOK สำหรับตรวจสลิป" class="sr-only" <%= payment.slipProvider === 'byshop' ? 'checked' : '' %> onchange="onProviderChanged('byshop')">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">🚀</span>
            <div>
              <div class="font-bold text-sm text-[var(--text)]">BYSHOP API</div>
              <div class="text-[11px] text-[var(--text-4)]">api.byshop.me</div>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">⭐ แนะนำอันดับ 1</span>
        </div>
        <p class="text-xs text-[var(--text-3)] mb-3 leading-relaxed">ระบบตรวจสลิปรวดเร็วแม่นยำสูง ดักสลิปซ้ำ เช็คได้ทุกธนาคาร พร้อมเพย์ และทรูมันนี่</p>
        <div class="mt-auto pt-2 border-t border-[var(--border)]/50 flex items-center justify-between text-[11px]">
          <span class="text-emerald-400 font-semibold">● เสถียรสูง 99.9%</span>
          <span class="text-[var(--text-4)]">ความเร็ว 0.5s</span>
        </div>
      </label>

      <!-- Option 2: SlipOK (⭐ Recommended) -->
      <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition-all duration-200 select-none <%= payment.slipProvider === 'slipok' ? 'bg-[var(--gold)]/10 border-[var(--gold)] shadow-md' : 'bg-[var(--card)] border-[var(--border)] hover:border-[var(--border-hover)]' %>">
        <input type="radio" name="slipProvider" value="slipok" class="sr-only" <%= payment.slipProvider === 'slipok' ? 'checked' : '' %> onchange="onProviderChanged('slipok')">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">🛡️</span>
            <div>
              <div class="font-bold text-sm text-[var(--text)]">SlipOK API</div>
              <div class="text-[11px] text-[var(--text-4)]">slipok.com</div>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">⭐ แนะนำ</span>
        </div>
        <p class="text-xs text-[var(--text-3)] mb-3 leading-relaxed">ตรวจสลิปยอดนิยม แยกสาขา Branch ID ได้ ตรวจสอบบัญชีผู้รับและเวลาโอนแม่นยำ</p>
        <div class="mt-auto pt-2 border-t border-[var(--border)]/50 flex items-center justify-between text-[11px]">
          <span class="text-emerald-400 font-semibold">● ยอดนิยม</span>
          <span class="text-[var(--text-4)]">Branch Mode</span>
        </div>
      </label>

      <!-- Option 3: EasySlip -->
      <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition-all duration-200 select-none <%= payment.slipProvider === 'easyslip' ? 'bg-[var(--gold)]/10 border-[var(--gold)] shadow-md' : 'bg-[var(--card)] border-[var(--border)] hover:border-[var(--border-hover)]' %>">
        <input type="radio" name="slipProvider" value="easyslip" class="sr-only" <%= payment.slipProvider === 'easyslip' ? 'checked' : '' %> onchange="onProviderChanged('easyslip')">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">⚡</span>
            <div>
              <div class="font-bold text-sm text-[var(--text)]">EasySlip API</div>
              <div class="text-[11px] text-[var(--text-4)]">easyslip.com</div>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-500/20 text-sky-400 border border-sky-500/30">มาตรฐาน</span>
        </div>
        <p class="text-xs text-[var(--text-3)] mb-3 leading-relaxed">ค่ายมาตรฐาน เชื่อมต่อบัญชีธนาคารรายร้าน และดึงโควตาคงเหลือแบบเรียลไทม์</p>
        <div class="mt-auto pt-2 border-t border-[var(--border)]/50 flex items-center justify-between text-[11px]">
          <span class="text-sky-400 font-semibold">● โควตากลาง</span>
          <span class="text-[var(--text-4)]">Platform Shared</span>
        </div>
      </label>

      <!-- Option 4: Slip2Go (⚠️ Not Recommended) -->
      <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition-all duration-200 select-none <%= payment.slipProvider === 'slip2go' ? 'bg-[var(--gold)]/10 border-[var(--gold)] shadow-md' : 'bg-[var(--card)] border-[var(--border)] hover:border-[var(--border-hover)]' %>">
        <input type="radio" name="slipProvider" value="slip2go" disabled title="ระบบนี้ใช้ EasySlip/SlipOK สำหรับตรวจสลิป" class="sr-only" <%= payment.slipProvider === 'slip2go' ? 'checked' : '' %> onchange="onProviderChanged('slip2go')">
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl">⚠️</span>
            <div>
              <div class="font-bold text-sm text-[var(--text)]">Slip2Go API</div>
              <div class="text-[11px] text-[var(--text-4)]">slip2go.com</div>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">ไม่ค่อยแนะนำ</span>
        </div>
        <p class="text-xs text-[var(--text-3)] mb-3 leading-relaxed">ค่ายสำรอง (แนะนำให้เลือกใช้ BYSHOP หรือ SlipOK เป็นหลักเพื่อความเสถียร)</p>
        <div class="mt-auto pt-2 border-t border-[var(--border)]/50 flex items-center justify-between text-[11px]">
          <span class="text-amber-400 font-semibold">● ค่ายสำรอง</span>
          <span class="text-[var(--text-4)]">Backup API</span>
        </div>
      </label>

      <!-- Option 5: Custom API / Webhook -->
      <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition-all duration-200 select-none <%= payment.slipProvider === 'custom' ? 'bg-[var(--gold)]/10 border-[var(--gold)] shadow-md' : 'bg-[var(--card)] border-[var(--border)] hover:border-[var(--border-hover)]' %>">
