<script>
function onProviderChanged(provider) {
  document.querySelectorAll('input[name="slipProvider"]').forEach(radio => {
    const parent = radio.closest('label');
    if (radio.checked) {
      parent.classList.add('bg-[var(--gold)]/10', 'border-[var(--gold)]', 'shadow-md');
      parent.classList.remove('bg-[var(--card)]', 'border-[var(--border)]');
    } else {
      parent.classList.remove('bg-[var(--gold)]/10', 'border-[var(--gold)]', 'shadow-md');
      parent.classList.add('bg-[var(--card)]', 'border-[var(--border)]');
    }
  });
}

function togglePasswordVisibility(inputId) {
  const el = document.getElementById(inputId);
  if (el) {
    el.type = el.type === 'password' ? 'text' : 'password';
  }
}

async function testProviderConnection(provider) {
  let resultEl = document.getElementById(`${provider}-test-result`);
  if (!resultEl) return;

  resultEl.classList.remove('hidden');
  resultEl.innerHTML = `
    <div class="p-3.5 rounded-xl bg-[var(--input)] border border-[var(--border)] text-xs text-[var(--text-3)] flex items-center gap-2 animate-pulse">
      <div class="w-3.5 h-3.5 border-2 border-[var(--gold)] border-t-transparent rounded-full animate-spin"></div>
      <span>กำลังทดสอบการเชื่อมต่อ ${provider.toUpperCase()} API...</span>
    </div>
  `;

  let payload = { provider };

  if (provider === 'byshop') {
    payload.apiKey = document.getElementById('byshop-key-input')?.value || '';
    payload.endpoint = document.querySelector('input[name="byshopEndpoint"]')?.value || '';
  } else if (provider === 'slipok') {
    payload.branchId = document.getElementById('slipok-branch-input')?.value || '';
    payload.apiKey = document.getElementById('slipok-key-input')?.value || '';
  } else if (provider === 'slip2go') {
    payload.apiKey = document.getElementById('slip2go-key-input')?.value || '';
    payload.endpoint = document.querySelector('input[name="slip2goEndpoint"]')?.value || '';
  }

  try {
    const res = await fetch('/admin/slip-verification/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (data.ok) {
      let extraInfo = '';
      if (data.balance !== undefined) extraInfo += ` • ยอดคงเหลือ: ฿${Number(data.balance).toLocaleString()}`;
      if (data.quota !== undefined) extraInfo += ` • โควตา: ${data.quota} ครั้ง`;
      if (data.isDemo) extraInfo += ` (โหมดจำลอง Test/Demo)`;

      resultEl.innerHTML = `
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-400 flex items-start gap-2.5">
          <span class="text-base">✅</span>
          <div>
            <b class="text-emerald-300 block mb-0.5">เชื่อมต่อสำเร็จ!</b>
            <span>${data.message || 'API ตอบสนองปกติ พร้อมใช้งานตรวจสลิป'}${extraInfo}</span>
          </div>
        </div>
      `;
    } else {
      resultEl.innerHTML = `
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-400 flex items-start gap-2.5">
          <span class="text-base">❌</span>
          <div>
            <b class="text-rose-300 block mb-0.5">เชื่อมต่อไม่สำเร็จ</b>
            <span>${data.message || 'โปรดตรวจสอบความถูกต้องของ API Key และ Endpoint'}</span>
          </div>
        </div>
      `;
    }
  } catch (err) {
    resultEl.innerHTML = `
      <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-400 flex items-start gap-2.5">
        <span class="text-base">❌</span>
        <div>
          <b class="text-rose-300 block mb-0.5">เกิดข้อผิดพลาดในการเชื่อมต่อ</b>
          <span>${err.message}</span>
        </div>
      </div>
    `;
  }
}
</script>
