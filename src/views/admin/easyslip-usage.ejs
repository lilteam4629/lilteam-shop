          <label class="block text-xs font-semibold text-[var(--text-3)] mb-1.5">Custom Slip Endpoint URL</label>
          <input type="url" name="customSlipEndpoint" value="<%= payment.customSlipEndpoint || '' %>" placeholder="https://your-api.com/verify-slip" class="w-full bg-[var(--input)] border border-[var(--border)] rounded-xl px-3.5 py-2.5 text-xs text-[var(--text)] focus:outline-none focus:border-[var(--gold)] font-mono transition">
