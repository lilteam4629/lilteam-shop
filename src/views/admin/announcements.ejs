<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-3">
    <% announcements.forEach(a => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4">
        <div class="flex justify-between items-start mb-1">
          <span class="font-medium"><%= a.title %></span>
          <span class="text-xs text-[var(--text-4)]"><%= a.active ? '🟢 แสดงอยู่' : '⚪ ซ่อน' %></span>
        </div>
        <p class="text-sm text-[var(--text-3)] mb-3"><%= a.body %></p>
        <div class="space-x-2">
          <form action="/admin/announcements/<%= a.id %>/toggle" method="post" class="inline"><button class="text-[var(--gold)] text-xs"><%= a.active ? 'ซ่อน' : 'แสดง' %></button></form>
          <form action="/admin/announcements/<%= a.id %>/delete" method="post" class="inline" onsubmit="return confirm('ลบประกาศนี้?')"><button class="text-rose-400 text-xs">ลบ</button></form>
        </div>
      </div>
    <% }) %>
    <% if (!announcements.length) { %><p class="text-[var(--text-4)] text-sm">ยังไม่มีประกาศ</p><% } %>
  </div>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5">
    <h3 class="font-semibold mb-3">เพิ่มประกาศ</h3>
    <form action="/admin/announcements" method="post" class="space-y-3">
      <input name="title" required placeholder="หัวข้อ" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
      <textarea name="body" required rows="3" placeholder="เนื้อหาประกาศ" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm"></textarea>
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium rounded-lg py-2 text-sm">เพิ่มประกาศ</button>
    </form>
  </div>
</div>
