<section class="space-y-5"><header><p class="text-[10px] tracking-[.2em] text-[var(--gold-text)]">RECOMMENDED CATEGORIES</p><h1 class="text-2xl font-black">หมวดหมู่แนะนำ</h1><p class="text-xs text-[var(--text-4)]">การ์ดภาพใต้แบนเนอร์ เพิ่มรูปและเลือกสินค้าเข้าหมวดได้</p></header>
<form action="/admin/recommended-categories" method="post" enctype="multipart/form-data" class="grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 sm:grid-cols-2"><input required name="title" placeholder="ชื่อหมวด" class="rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm"><label class="rounded-xl border border-dashed border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm">รูปปก 600×200 <input required name="image" type="file" accept="image/*" class="mt-1 block w-full text-xs"></label><button class="rounded-xl bg-[var(--gold)] px-4 py-2 text-sm font-bold text-[var(--gold-contrast)] sm:col-span-2">+ เพิ่มหมวด</button></form>
<% categories.forEach(c=>{ const selected=new Set((c.productIds||[]).map(String)); %><article class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)]"><div class="flex items-center gap-3 border-b border-[var(--border)] p-3"><% if(c.imageUrl){ %><img src="<%=c.imageUrl%>" class="h-14 w-32 rounded-lg object-cover" alt=""><% } %><div><b><%=c.title%></b><p class="text-xs text-[var(--text-4)]"><%=selected.size%> สินค้า · <%=c.enabled === false ? 'ปิดอยู่' : 'กำลังแสดง'%></p></div><div class="ml-auto flex gap-2"><form action="/admin/recommended-categories/<%=c.id%>/toggle" method="post"><button class="rounded-lg border border-[var(--border-light)] px-2 py-1 text-xs"><%=c.enabled === false ? 'เปิด' : 'ปิด'%></button></form><form action="/admin/recommended-categories/<%=c.id%>/delete" method="post" data-confirm="ลบหมวดนี้ใช่หรือไม่?"><button class="rounded-lg border border-rose-400/40 px-2 py-1 text-xs text-rose-400">ลบ</button></form></div></div><form action="/admin/recommended-categories/<%=c.id%>/products" method="post" class="p-3"><p class="mb-2 text-xs font-bold">สินค้าในหมวด (เลือกหลายรายการได้ — ระบบกันซ้ำ)</p><div class="grid max-h-72 gap-2 overflow-y-auto sm:grid-cols-2 lg:grid-cols-3"><% products.forEach(p=>{ %><label draggable="true" class="flex cursor-grab items-center gap-2 rounded-lg border border-[var(--border-light)] p-2 text-xs"><input type="checkbox" name="productIds" value="<%=p.id%>" <%=selected.has(String(p.id))?'checked':''%>><% if(p.images&&p.images[0]){ %><img src="<%=p.images[0]%>" class="h-9 w-12 rounded object-cover" alt=""><% } %><span class="truncate"><%=p.title%></span></label><% }) %></div><button class="mt-3 rounded-lg bg-[var(--gold)] px-3 py-2 text-xs font-bold text-[var(--gold-contrast)]">บันทึกสินค้าในหมวดนี้</button></form></article><% }) %></section>
