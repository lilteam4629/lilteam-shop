<section class="space-y-5"><header><p class="text-[10px] tracking-[.2em] text-[var(--gold-text)]">RECOMMENDED CATEGORIES</p><h1 class="text-2xl font-black">หมวดหมู่แนะนำ</h1><p class="text-xs text-[var(--text-4)]">การ์ดภาพใต้แบนเนอร์หน้าหลัก</p></header><form action="/admin/recommended-categories" method="post" class="grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 sm:grid-cols-[1fr_1fr_120px_auto]"><input required name="title" placeholder="ชื่อหมวด" class="rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm"><input name="imageUrl" type="url" placeholder="ลิงก์รูป 600×200" class="rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm"><input name="count" type="number" min="0" placeholder="จำนวนสินค้า" class="rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm"><button class="rounded-xl bg-[var(--gold)] px-4 py-2 text-sm font-bold text-[var(--gold-contrast)]">+ เพิ่มหมวด</button></form><div class="grid gap-4 sm:grid-cols-2"><% categories.forEach(c=>{ %><article class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)]"><div class="aspect-[3/1] bg-[var(--input)]"><% if(c.imageUrl){ %><img src="<%=c.imageUrl%>" class="h-full w-full object-cover" alt=""><% } %></div><div class="flex items-center justify-between gap-3 p-4"><div><b><%=c.title%></b><p class="text-xs text-[var(--text-4)]"><%=c.count%> รายการ · <%=c.enabled === false ? 'ปิดอยู่' : 'กำลังแสดง'%></p></div><div class="flex gap-2"><form action="/admin/recommended-categories/<%=c.id%>/toggle" method="post"><button class="rounded-lg border border-[var(--border-light)] px-2 py-1 text-xs"><%=c.enabled === false ? 'เปิด' : 'ปิด'%></button></form><form action="/admin/recommended-categories/<%=c.id%>/delete" method="post" data-confirm="ลบหมวดนี้ใช่หรือไม่?"><button class="rounded-lg border border-rose-400/40 px-2 py-1 text-xs text-rose-400">ลบ</button></form></div></div></article><% }) %></div></section>
