<style>
.rc-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}.rc-card{display:grid;grid-template-columns:auto 92px minmax(0,1fr) auto;align-items:center;gap:10px;min-height:78px;padding:8px;border:1px solid var(--border-light);border-radius:12px;background:var(--card);cursor:grab}.rc-card:has(input:checked){border-color:var(--gold);background:color-mix(in srgb,var(--gold) 7%,var(--card))}.rc-card.is-dragging{opacity:.45}.rc-thumb{display:grid;place-items:center;width:92px;height:62px;border-radius:9px;background:var(--input);overflow:hidden}.rc-thumb img{display:block;width:100%;height:100%;object-fit:contain}.rc-thumb span{font-size:22px;color:var(--text-4)}.rc-selected{min-height:112px;padding:12px;border:2px dashed color-mix(in srgb,var(--gold) 42%,var(--border));border-radius:14px;background:color-mix(in srgb,var(--gold) 4%,var(--input));transition:.15s}.rc-selected.is-drop-ready{border-color:var(--gold);background:color-mix(in srgb,var(--gold) 12%,var(--input));transform:scale(1.002)}.rc-selected .rc-card{grid-template-columns:92px minmax(0,1fr) auto;cursor:default}.rc-selected .rc-card>input{display:none}.rc-remove{display:grid;place-items:center;width:30px;height:30px!important;min-height:30px!important;border-radius:50%;background:var(--input);color:#ef476f;font-size:18px}.rc-empty{grid-column:1/-1;display:grid;min-height:84px;place-items:center;color:var(--text-4);font-size:12px}.rc-toolbar{position:sticky;z-index:5;top:58px;display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px;border:1px solid var(--border);border-radius:12px;background:color-mix(in srgb,var(--card) 96%,transparent);backdrop-filter:blur(10px)}.rc-toolbar input{min-width:0;flex:1}.rc-add,.rc-save{min-height:42px;padding:0 16px;border-radius:10px;background:var(--gold)!important;color:var(--gold-contrast);font-size:12px;font-weight:800;white-space:nowrap}.rc-add:disabled{opacity:.45}.rc-count{font-size:11px;color:var(--text-4);white-space:nowrap}@media(max-width:700px){.rc-list{grid-template-columns:1fr}.rc-toolbar{top:60px;flex-wrap:wrap}.rc-toolbar input{flex-basis:100%}.rc-add,.rc-save{flex:1}.rc-card{grid-template-columns:auto 78px minmax(0,1fr) auto}.rc-thumb{width:78px;height:56px}.rc-selected .rc-card{grid-template-columns:78px minmax(0,1fr) auto}}
</style>
<section class="space-y-5">
  <header><p class="text-[10px] tracking-[.2em] text-[var(--gold-text)]">RECOMMENDED CATEGORIES</p><h1 class="text-2xl font-black">หมวดหมู่แนะนำ</h1><p class="text-xs text-[var(--text-4)]">การ์ดภาพใต้แบนเนอร์ เพิ่มรูปและเลือกสินค้าเข้าหมวดได้</p></header>
  <form action="/admin/recommended-categories" method="post" enctype="multipart/form-data" class="grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 sm:grid-cols-2"><input required name="title" placeholder="ชื่อหมวด" class="rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm"><label class="rounded-xl border border-dashed border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm">รูปปก 600×200 <input required name="image" type="file" accept="image/*" class="mt-1 block w-full text-xs"></label><button class="rounded-xl bg-[var(--gold)] px-4 py-2 text-sm font-bold text-[var(--gold-contrast)] sm:col-span-2">+ เพิ่มหมวด</button></form>
  <% categories.forEach(c=>{ const selected=new Set((c.productIds||[]).map(String)); %>
  <article class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)]">
    <div class="flex items-center gap-3 border-b border-[var(--border)] p-3"><% if(c.imageUrl){ %><img src="<%=c.imageUrl%>" class="h-14 w-32 rounded-lg object-cover" alt=""><% } %><div><b><%=c.title%></b><p class="text-xs text-[var(--text-4)]"><%=selected.size%> สินค้า · <%=c.enabled === false ? 'ปิดอยู่' : 'กำลังแสดง'%></p></div><div class="ml-auto flex gap-2"><form action="/admin/recommended-categories/<%=c.id%>/toggle" method="post"><button class="rounded-lg border border-[var(--border-light)] px-2 py-1 text-xs"><%=c.enabled === false ? 'เปิด' : 'ปิด'%></button></form><form action="/admin/recommended-categories/<%=c.id%>/delete" method="post" data-confirm="ลบหมวดนี้ใช่หรือไม่?"><button class="rounded-lg border border-rose-400/40 px-2 py-1 text-xs text-rose-400">ลบ</button></form></div></div>
    <form action="/admin/recommended-categories/<%=c.id%>/products" method="post" class="p-3" data-category-products>
      <div class="rc-toolbar"><input type="search" placeholder="ค้นหาสินค้า..." class="rounded-lg border border-[var(--border-light)] bg-[var(--input)] px-3 py-2 text-sm" data-product-search><span class="rc-count" data-pick-count>เลือก 0 รายการ</span><button type="button" class="rc-add" data-add-selected disabled>＋ เพิ่มสินค้าที่เลือก</button><button type="submit" class="rc-save">บันทึกสินค้า</button></div>
      <p class="mb-2 text-xs font-bold">สินค้าที่เลือก <span class="font-normal text-[var(--text-4)]">— ลากสินค้าจากด้านล่างมาวางได้</span></p>
      <div class="rc-selected rc-list" data-selected-zone>
        <% products.filter(p=>selected.has(String(p.id))).forEach(p=>{ %><label class="rc-card" draggable="false" data-product-card data-id="<%=p.id%>" data-name="<%=String(p.title).toLowerCase()%>"><input type="checkbox" name="productIds" value="<%=p.id%>" checked><span class="rc-thumb"><% if(p.images&&p.images[0]){ %><img src="<%=p.images[0]%>" alt="<%=p.title%>" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span hidden>◇</span><% }else{ %><span>◇</span><% } %></span><b class="truncate text-xs"><%=p.title%></b><button type="button" class="rc-remove" data-remove-product aria-label="นำ <%=p.title%> ออกจากหมวด">×</button></label><% }) %>
        <p class="rc-empty" data-empty-selected <%=selected.size?'hidden':''%>>ยังไม่มีสินค้า — เลือกหลายรายการด้านล่างแล้วกดเพิ่ม หรือลากมาวางที่นี่</p>
      </div>
      <p class="mb-2 mt-4 text-xs font-bold">สินค้าทั้งหมด</p>
      <div class="rc-list max-h-[440px] overflow-y-auto" data-available-zone>
        <% products.filter(p=>!selected.has(String(p.id))).forEach(p=>{ %><label class="rc-card" draggable="true" data-product-card data-id="<%=p.id%>" data-name="<%=String(p.title).toLowerCase()%>"><input type="checkbox" value="<%=p.id%>" data-pick><span class="rc-thumb"><% if(p.images&&p.images[0]){ %><img src="<%=p.images[0]%>" alt="<%=p.title%>" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span hidden>◇</span><% }else{ %><span>◇</span><% } %></span><b class="truncate text-xs"><%=p.title%></b><span class="text-[10px] text-[var(--text-4)]">ลากได้</span></label><% }) %>
      </div>
    </form>
  </article>
  <% }) %>
</section>
<script>(function(){document.querySelectorAll('[data-category-products]').forEach(form=>{const available=form.querySelector('[data-available-zone]'),selected=form.querySelector('[data-selected-zone]'),empty=form.querySelector('[data-empty-selected]'),addButton=form.querySelector('[data-add-selected]'),pickCount=form.querySelector('[data-pick-count]'),search=form.querySelector('[data-product-search]');let dragged=null;function refresh(){const picks=[...available.querySelectorAll('[data-pick]:checked')];pickCount.textContent='เลือก '+picks.length+' รายการ';addButton.disabled=!picks.length;empty.hidden=!!selected.querySelector('[data-product-card]')}function addCard(card){if(!card||card.parentElement===selected)return;const input=card.querySelector('input');input.checked=true;input.name='productIds';input.removeAttribute('data-pick');card.draggable=false;card.querySelector(':scope > span:last-child')?.remove();const remove=document.createElement('button');remove.type='button';remove.className='rc-remove';remove.dataset.removeProduct='';remove.setAttribute('aria-label','นำสินค้าออกจากหมวด');remove.textContent='×';card.append(remove);selected.append(card);refresh()}function removeCard(card){if(!card)return;const input=card.querySelector('input');input.checked=false;input.removeAttribute('name');input.dataset.pick='';card.draggable=true;card.querySelector('[data-remove-product]')?.remove();const hint=document.createElement('span');hint.className='text-[10px] text-[var(--text-4)]';hint.textContent='ลากได้';card.append(hint);available.prepend(card);refresh()}available.addEventListener('change',refresh);addButton.addEventListener('click',()=>[...available.querySelectorAll('[data-pick]:checked')].forEach(input=>addCard(input.closest('[data-product-card]'))));form.addEventListener('click',event=>{const button=event.target.closest('[data-remove-product]');if(button){event.preventDefault();removeCard(button.closest('[data-product-card]'))}});available.addEventListener('dragstart',event=>{dragged=event.target.closest('[data-product-card]');if(!dragged)return;dragged.classList.add('is-dragging');event.dataTransfer.effectAllowed='move';event.dataTransfer.setData('text/plain',dragged.dataset.id)});available.addEventListener('dragend',()=>{dragged?.classList.remove('is-dragging');dragged=null;selected.classList.remove('is-drop-ready')});selected.addEventListener('dragover',event=>{if(!dragged)return;event.preventDefault();event.dataTransfer.dropEffect='move';selected.classList.add('is-drop-ready')});selected.addEventListener('dragleave',event=>{if(!selected.contains(event.relatedTarget))selected.classList.remove('is-drop-ready')});selected.addEventListener('drop',event=>{event.preventDefault();selected.classList.remove('is-drop-ready');addCard(dragged)});search.addEventListener('input',()=>{const query=search.value.trim().toLowerCase();available.querySelectorAll('[data-product-card]').forEach(card=>card.hidden=!card.dataset.name.includes(query))});refresh()})})();</script>
