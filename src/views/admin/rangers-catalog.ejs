<div class="studio-page-head mb-6">
  <div><span class="studio-page-kicker">SYSTEM LAB · RANGER WORKBENCH</span><h1>สตูดิโอจัดทีม LINE Rangers</h1><p>ค้นหาจาก <%= sourceCount.toLocaleString() %> ตัวละคร แยก Top 100 แล้วลากไปใส่สินค้าได้</p></div>
  <a href="https://rangers.lerico.net/en/rangers-book" target="_blank" rel="noopener" class="studio-secondary-action">แหล่งข้อมูล Handbook ↗</a>
</div>
<section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div><h2 class="text-xl font-bold">สถานะหน้าร้านทดลอง</h2><p class="text-sm text-[var(--text-4)]">เมื่อปิด หน้าร้านจะไม่เรียก API หรือโหลดรูปตัวละคร</p></div>
  <form action="/admin/rangers-catalog/toggle" method="post" class="flex items-center gap-3"><span class="font-bold <%= catalog.enabled ? 'text-emerald-500' : 'text-[var(--text-4)]' %>"><%= catalog.enabled ? '● เปิดใช้งาน' : '● ปิดอยู่' %></span><input type="hidden" name="enabled" value="<%= catalog.enabled ? '0' : '1' %>"><button class="rounded-xl bg-[var(--gold)] text-[var(--gold-contrast)] px-5 py-2.5 font-bold"><%= catalog.enabled ? 'ปิดระบบ' : 'เปิดระบบ' %></button></form>
</section>
<div class="grid xl:grid-cols-[minmax(0,1fr)_420px] gap-5" data-ranger-studio>
  <section class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 min-w-0">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-4"><div><h2 class="text-xl font-bold">คลังตัวละคร</h2><p id="ranger-result-count" class="text-sm text-[var(--text-4)]">กำลังโหลดข้อมูล…</p></div><div class="flex flex-wrap gap-2"><button type="button" class="ranger-tab rounded-xl px-4 py-2 font-bold bg-[var(--gold)] text-[var(--gold-contrast)]" data-view="all">ทั้งหมด</button><button type="button" class="ranger-tab rounded-xl px-4 py-2 font-bold border border-[var(--border)]" data-view="top100">Top 100</button><input id="ranger-search" type="search" placeholder="ค้นหาชื่อหรือรหัส" class="rounded-xl border border-[var(--border)] bg-[var(--input)] px-4 py-2 min-w-56"></div></div>
    <div id="ranger-source-grid" class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-7 2xl:grid-cols-9 gap-2 min-h-72" aria-live="polite"></div>
    <div class="flex items-center justify-center gap-3 mt-5"><button id="ranger-prev" type="button" class="rounded-xl border border-[var(--border)] px-4 py-2">← ก่อนหน้า</button><span id="ranger-page" class="text-sm font-bold"></span><button id="ranger-next" type="button" class="rounded-xl border border-[var(--border)] px-4 py-2">ถัดไป →</button></div>
  </section>
  <aside class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 h-fit xl:sticky xl:top-5">
    <h2 class="text-xl font-bold">จัดตัวละครลงสินค้า</h2><p class="text-sm text-[var(--text-4)] mb-4">ลากการ์ดมาวาง หรือแตะการ์ดเพื่อเพิ่ม สูงสุด 20 ตัว</p>
    <% if (products.length) { %><form action="/admin/rangers-catalog/assign" method="post" id="ranger-assign-form"><label class="block text-sm font-semibold mb-3">สินค้า<select name="productId" id="ranger-product" class="mt-1 w-full rounded-xl border border-[var(--border)] bg-[var(--input)] px-3 py-3"><% products.forEach(product => { %><option value="<%= product.id %>" <%= selectedProductId === product.id ? 'selected' : '' %>><%= product.title %></option><% }) %></select></label><div id="ranger-drop-zone" class="min-h-64 rounded-2xl border-2 border-dashed border-[var(--border)] bg-[var(--input)] p-3 grid grid-cols-3 gap-2 content-start"><p class="col-span-3 text-center text-sm text-[var(--text-4)] py-20">วางตัวละครตรงนี้</p></div><input type="hidden" name="rangerCodes" id="ranger-codes" value="[]"><div class="flex gap-2 mt-4"><button type="button" id="ranger-clear" class="rounded-xl border border-[var(--border)] px-4 py-3">ล้างทีม</button><button class="flex-1 rounded-xl bg-[var(--gold)] text-[var(--gold-contrast)] px-4 py-3 font-bold">บันทึกลงสินค้า</button></div></form><% } else { %><div class="rounded-xl bg-[var(--input)] p-8 text-center text-[var(--text-4)]">เพิ่มสินค้าก่อนจึงจะจัดทีมได้</div><% } %>
  </aside>
</div>
<script type="application/json" id="ranger-assignments"><%- JSON.stringify(productAssignments).replace(/</g,'\\u003c') %></script>
<script>
(()=>{const root=document.querySelector('[data-ranger-studio]');if(!root)return;const grid=document.getElementById('ranger-source-grid'),search=document.getElementById('ranger-search'),count=document.getElementById('ranger-result-count'),pageLabel=document.getElementById('ranger-page'),drop=document.getElementById('ranger-drop-zone'),codesInput=document.getElementById('ranger-codes'),product=document.getElementById('ranger-product');const assignments=JSON.parse(document.getElementById('ranger-assignments').textContent||'{}');let view='all',page=1,pages=1,timer,selected=[];const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function card(r,chosen=false){return `<article class="relative rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2 text-center cursor-grab" draggable="${chosen?'false':'true'}" data-code="${esc(r.code)}" data-name="${esc(r.name)}" data-image="${esc(r.imageUrl)}"><img src="${esc(r.imageUrl)}" alt="${esc(r.name)}" loading="lazy" class="w-full aspect-square object-contain rounded-lg bg-white" onerror="this.closest('article').classList.add('opacity-40')"><b class="absolute top-3 left-3 rounded-md bg-amber-100 text-amber-800 px-1 text-xs">${r.grade||''}★</b><span class="block mt-1 text-xs font-semibold truncate">${esc(r.name)}</span>${chosen?'<button type="button" class="absolute -top-1 -right-1 w-6 h-6 rounded-full bg-red-500 text-white">×</button>':''}</article>`}async function load(){grid.innerHTML='<p class="col-span-full text-center py-20">กำลังโหลด…</p>';const q=new URLSearchParams({view,page:String(page),limit:'63',q:search.value});const response=await fetch('/admin/rangers-catalog/source?'+q);if(!response.ok)throw Error('catalog');const data=await response.json();pages=data.pages;grid.innerHTML=data.items.map(r=>card(r)).join('')||'<p class="col-span-full text-center py-20">ไม่พบตัวละคร</p>';count.textContent=`พบ ${data.total.toLocaleString()} ตัวละคร`;pageLabel.textContent=`หน้า ${data.page} / ${data.pages}`;document.getElementById('ranger-prev').disabled=page<=1;document.getElementById('ranger-next').disabled=page>=pages}function sync(){codesInput.value=JSON.stringify(selected.map(r=>r.code));drop.innerHTML=selected.length?selected.map(r=>card(r,true)).join(''):'<p class="col-span-3 text-center text-sm text-[var(--text-4)] py-20">วางตัวละครตรงนี้</p>'}function add(r){if(r&&selected.length<20&&!selected.some(x=>x.code===r.code)){selected.push(r);sync()}}function from(el){return el&&{code:el.dataset.code,name:el.dataset.name,imageUrl:el.dataset.image,grade:(el.querySelector('b')?.textContent||'').replace('★','')}}grid.addEventListener('dragstart',e=>{const r=from(e.target.closest('[data-code]'));if(r)e.dataTransfer.setData('text/plain',JSON.stringify(r))});grid.addEventListener('click',e=>add(from(e.target.closest('[data-code]'))));drop?.addEventListener('dragover',e=>e.preventDefault());drop?.addEventListener('drop',e=>{e.preventDefault();try{add(JSON.parse(e.dataTransfer.getData('text/plain')))}catch{}});drop?.addEventListener('click',e=>{const el=e.target.closest('[data-code]');if(el){selected=selected.filter(r=>r.code!==el.dataset.code);sync()}});document.querySelectorAll('.ranger-tab').forEach(btn=>btn.addEventListener('click',()=>{view=btn.dataset.view;page=1;document.querySelectorAll('.ranger-tab').forEach(x=>{x.classList.toggle('bg-[var(--gold)]',x===btn);x.classList.toggle('text-[var(--gold-contrast)]',x===btn)});load()}));search.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{page=1;load()},250)});document.getElementById('ranger-prev').onclick=()=>{if(page>1){page--;load()}};document.getElementById('ranger-next').onclick=()=>{if(page<pages){page++;load()}};document.getElementById('ranger-clear')?.addEventListener('click',()=>{selected=[];sync()});function loadProduct(){selected=(assignments[product?.value]||[]).map(item=>({...item}));sync()}product?.addEventListener('change',loadProduct);loadProduct();load().catch(()=>{grid.innerHTML='<p class="col-span-full text-center text-red-500 py-20">โหลดคลังไม่สำเร็จ กรุณาลองใหม่</p>'})})();
</script>
