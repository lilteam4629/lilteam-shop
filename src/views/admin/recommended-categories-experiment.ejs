<link rel="stylesheet" href="<%= asset('css/admin-experiment-recommended-v1.css') %>" />
<% const activeProducts = products || []; const categoryProductIds = new Set(categories.flatMap(category => (category.productIds || []).map(String))); const enabledCount = categories.filter(category => category.enabled !== false).length; const coveredCount = activeProducts.filter(product => categoryProductIds.has(String(product.id))).length; %>
<div class="experiment-app experiment-recommended-categories-page">
  <aside class="experiment-sidebar" data-experiment-sidebar aria-label="เมนูร้านค้า">
    <div class="experiment-brand"><div class="experiment-brand-mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName || 'ร้านค้า' %>" /><% } else { %><span aria-hidden="true"><%= (settings.shopName || 'L')[0] %></span><% } %></div><div><div class="experiment-brand-title"><%= settings.shopName || 'LILTeam Shop' %></div><div class="experiment-brand-sub">ผู้ดูแลระบบ</div></div><button class="experiment-collapse" data-experiment-collapse type="button" aria-label="ย่อหรือขยายเมนู"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button></div>
    <div class="experiment-sidebar-scroll"><div class="experiment-nav-group"><div class="experiment-nav-label">ภาพรวม</div><a class="experiment-nav-item" href="/admin"><span aria-hidden="true">▦</span><span>แดชบอร์ด</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">สินค้าและสต๊อก</div><a class="experiment-nav-item" href="/admin/products"><span aria-hidden="true">◇</span><span>รายการสินค้า</span></a><a class="experiment-nav-item" href="/admin/scheduled-products"><span aria-hidden="true">◷</span><span>ตั้งเวลาเปิดขาย</span></a><a class="experiment-nav-item" href="/admin/filter-tags"><span aria-hidden="true">◈</span><span>แท็ก/จัดหมวดสินค้า</span></a><a class="experiment-nav-item active" href="/admin/recommended-categories"><span aria-hidden="true">☷</span><span>หมวดหมู่แนะนำ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">การสั่งซื้อ & การเงิน</div><a class="experiment-nav-item" href="/admin/orders"><span aria-hidden="true">▤</span><span>คำสั่งซื้อ</span></a><a class="experiment-nav-item" href="/admin/topups"><span aria-hidden="true">▭</span><span>เติมเงิน & ตรวจสอบ</span></a></div><div class="experiment-nav-group"><div class="experiment-nav-label">โปรโมชัน & สมาชิก</div><a class="experiment-nav-item" href="/admin/coupons"><span aria-hidden="true">◇</span><span>คูปองส่วนลด</span></a><a class="experiment-nav-item" href="/admin/users"><span aria-hidden="true">♙</span><span>จัดการสมาชิก</span></a></div></div>
    <div class="experiment-sidebar-bottom"><a class="experiment-nav-item" href="/"><span aria-hidden="true">⌂</span><span>กลับหน้าร้าน</span><span style="margin-left:auto">→</span></a><div class="experiment-profile"><div class="experiment-avatar">A</div><div><strong>admin</strong><small>แอดมินสูงสุด</small></div></div></div>
  </aside>
  <div class="experiment-main"><header class="experiment-topbar"><button class="experiment-icon-button" type="button" aria-label="ดูการแจ้งเตือน" data-recommended-notifications>◌</button><span class="experiment-user-name" style="font-size:12px;font-weight:700">admin</span></header><main class="experiment-content">
<section class="recommended-page">
  <div class="experiment-page-head">
    <div><div class="experiment-kicker">หน้าร้าน</div><h1>หมวดหมู่แนะนำ</h1><p>จัดกลุ่มสินค้าเด่นให้ลูกค้าเห็นง่ายบนหน้าร้าน พร้อมเลือกสินค้าและเปิด/ปิดการแสดงผลได้จากจุดเดียว</p></div>
    <div class="recommended-actions"><a class="experiment-button" href="/">ดูหน้าร้าน ↗</a><button class="experiment-button primary" type="button" data-recommended-open-create>＋ สร้างหมวดหมู่</button></div>
  </div>

  <div class="recommended-stats">
    <div class="recommended-stat accent"><small>หมวดหมู่ทั้งหมด</small><strong><%= categories.length %></strong><em>กลุ่มที่ตั้งค่าไว้ในร้าน</em></div>
    <div class="recommended-stat"><small>กำลังแสดง</small><strong><%= enabledCount %></strong><em>พร้อมแสดงบนหน้าร้าน</em></div>
    <div class="recommended-stat"><small>สินค้าที่ถูกจัดกลุ่ม</small><strong><%= coveredCount %></strong><em>จาก <%= activeProducts.length %> สินค้าที่เปิดขาย</em></div>
    <div class="recommended-stat"><small>สินค้ายังไม่อยู่ในหมวด</small><strong><%= Math.max(activeProducts.length - coveredCount, 0) %></strong><em>เลือกไปจัดหมวดได้ทันที</em></div>
  </div>

  <div class="recommended-list-heading"><div><span class="recommended-list-kicker">STOREFRONT DISPLAY</span><h2>ชั้นวางหมวดหมู่หน้าร้าน</h2><p>ตรวจดูสินค้าและสถานะของแต่ละหมวด แล้วจัดการการแสดงผลได้จากรายการนี้</p></div><span class="recommended-list-total"><b data-recommended-visible-count><%= categories.length %></b> หมวด</span></div>
  <div class="recommended-toolbar">
    <input class="recommended-search" type="search" placeholder="ค้นหาชื่อหมวดหมู่..." aria-label="ค้นหาหมวดหมู่" data-recommended-search>
    <select class="recommended-select" aria-label="กรองสถานะ" data-recommended-status><option value="all">ทุกสถานะ</option><option value="enabled">กำลังแสดง</option><option value="disabled">ปิดการแสดง</option></select>
    <span class="recommended-toolbar-note">ค้นหาและกรองรายการ</span>
  </div>

  <div class="recommended-grid" data-recommended-grid>
    <% if (!categories.length) { %>
      <div class="recommended-empty recommended-empty-studio" data-recommended-empty>
        <div class="recommended-empty-visual" aria-hidden="true"><div class="recommended-empty-orbit orbit-one"></div><div class="recommended-empty-orbit orbit-two"></div><div class="recommended-empty-shelf"><span class="recommended-empty-ribbon"></span><div class="recommended-empty-mini mini-green"><i></i><b>มาใหม่</b><small>สินค้าเด่น</small></div><div class="recommended-empty-mini mini-gold"><i></i><b>ขายดี</b><small>ยอดนิยม</small></div><div class="recommended-empty-mini mini-rose"><i></i><b>แนะนำ</b><small>คัดสรรแล้ว</small></div></div><div class="recommended-empty-spark spark-a">✦</div><div class="recommended-empty-spark spark-b">✦</div></div>
        <div class="recommended-empty-copy"><span class="recommended-empty-kicker">STOREFRONT CATEGORY STUDIO</span><h2>เริ่มจัดชั้นวางสินค้าของคุณ</h2><p>สร้างหมวดหมู่เพื่อจัดกลุ่มสินค้าเด่นให้ลูกค้าหาเจอง่าย เลือกเทมเพลตด้านล่างเพื่อเริ่มต้นได้ทันที</p><div class="recommended-template-grid"><button type="button" class="recommended-template" data-recommended-template="มาใหม่"><span class="template-icon green">↗</span><span><b>มาใหม่</b><small>สินค้าเพิ่งเข้าร้าน</small></span><i>→</i></button><button type="button" class="recommended-template" data-recommended-template="ขายดี"><span class="template-icon gold">★</span><span><b>ขายดี</b><small>สินค้ายอดนิยม</small></span><i>→</i></button><button type="button" class="recommended-template" data-recommended-template="เกมแนะนำ"><span class="template-icon rose">◇</span><span><b>เกมแนะนำ</b><small>คัดสรรสำหรับลูกค้า</small></span><i>→</i></button></div><button class="experiment-button primary" type="button" data-recommended-open-create>＋ สร้างหมวดหมู่เอง</button></div>
      </div>
    <% } else { categories.forEach((category, index) => { const ids = new Set((category.productIds || []).map(String)); const categoryProducts = activeProducts.filter(product => ids.has(String(product.id))); const shelfNumber = String(index + 1).padStart(2, '0'); %>
      <article class="recommended-card" data-recommended-card data-name="<%= String(category.title || '').toLowerCase() %>" data-status="<%= category.enabled === false ? 'disabled' : 'enabled' %>">
        <div class="recommended-card-index" aria-label="ลำดับที่ <%= index + 1 %>"><span><%= shelfNumber %></span><small>ชั้นวาง</small></div>
        <div class="recommended-card-cover <%= category.imageUrl ? '' : 'is-empty' %>"><% if (category.imageUrl) { %><img src="<%= category.imageUrl %>" alt="" loading="lazy" decoding="async" onerror="this.hidden=true"><% } else { %><span aria-hidden="true">✦</span><% } %></div>
        <div class="recommended-card-body"><div class="recommended-card-head"><div class="recommended-card-name"><span class="recommended-card-kicker">หมวดหมู่แนะนำ</span><h2><%= category.title %></h2></div><div class="recommended-card-meta"><span class="recommended-card-status <%= category.enabled === false ? 'off' : '' %>"><i aria-hidden="true"></i><%= category.enabled === false ? 'ปิดการแสดง' : 'กำลังแสดง' %></span><span class="recommended-card-count"><b><%= categoryProducts.length %></b> สินค้า</span></div></div><p class="recommended-card-copy"><%= categoryProducts.length ? 'สินค้าที่เลือกจะแสดงตามลำดับในหมวดนี้' : 'ยังไม่มีสินค้าในหมวดนี้' %></p>
          <div class="recommended-card-products"><span>สินค้าในชั้นนี้</span><div class="recommended-product-preview"><% categoryProducts.slice(0,6).forEach(product => { if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="" loading="lazy" decoding="async" title="<%= product.title %>" onerror="this.hidden=true"><% } else { %><span class="recommended-product-placeholder" title="<%= product.title %>">◇</span><% } }); if (categoryProducts.length > 6) { %><span class="recommended-product-more">+<%= categoryProducts.length - 6 %></span><% } else if (!categoryProducts.length) { %><span class="recommended-product-more">ยังไม่มีสินค้าในหมวดนี้</span><% } %></div></div>
          <div class="recommended-card-actions"><button type="button" class="experiment-button ghost" data-recommended-open-products data-category-id="<%= category.id %>" data-category-title="<%= category.title %>">จัดการสินค้า <span>→</span></button><form action="/admin/recommended-categories/<%= category.id %>/toggle" method="post"><button class="experiment-button recommended-icon-button" type="submit" title="<%= category.enabled === false ? 'เปิดการแสดง' : 'ปิดการแสดง' %>"><%= category.enabled === false ? 'เปิด' : 'ปิด' %></button></form><form action="/admin/recommended-categories/<%= category.id %>/delete" method="post" data-experiment-confirm="ลบหมวดหมู่ <%= category.title %> ใช่หรือไม่? รายการสินค้าในหมวดนี้จะถูกยกเลิกการจัดกลุ่ม แต่สินค้าไม่ถูกลบ"><button class="experiment-button recommended-icon-button danger" type="submit" title="ลบหมวดหมู่">ลบ</button></form></div>
        </div>
      </article>
    <% }); } %>
    <p class="recommended-empty recommended-hidden" data-recommended-no-results>ไม่พบหมวดหมู่ที่ตรงกับคำค้นหานี้</p>
  </div>
</section>
</main></div></div>

<dialog class="recommended-dialog recommended-create-dialog" data-recommended-create-dialog aria-labelledby="recommended-create-title"><div class="recommended-dialog-head"><div class="recommended-dialog-heading"><span class="recommended-step">ขั้นตอนที่ 1 <i></i> 2</span><div class="experiment-kicker">สร้างหมวดหมู่ใหม่</div><h2 id="recommended-create-title">ตั้งค่ากลุ่มสินค้าแนะนำ</h2><p>จัดชื่อและภาพปกให้พร้อมก่อนนำกลุ่มนี้ไปใช้บนหน้าร้าน</p></div><button class="recommended-dialog-close" type="button" data-recommended-close aria-label="ปิดหน้าต่าง">×</button></div><div class="recommended-dialog-body"><form action="/admin/recommended-categories" method="post" enctype="multipart/form-data" class="recommended-create-form"><div class="recommended-create-fields"><label class="recommended-field"><span>ชื่อหมวดหมู่ <b>*</b></span><small>ใช้คำสั้น ๆ ที่ลูกค้าเข้าใจทันที เช่น “มาใหม่” หรือ “ขายดี”</small><input required name="title" placeholder="พิมพ์ชื่อหมวดหมู่" data-recommended-title-input maxlength="60"><em class="recommended-field-hint"><b data-recommended-title-count>0</b>/60 ตัวอักษร</em></label><div class="recommended-field"><span>รูปปกหมวดหมู่</span><small>แนะนำภาพแนวนอน ระบบจะแสดงรูปเต็มโดยไม่ตัด</small><label class="recommended-upload-zone" data-recommended-image-drop><input name="image" type="file" accept="image/*" data-recommended-image-input><span class="recommended-upload-icon" aria-hidden="true">↑</span><strong>วางไฟล์รูปที่นี่ หรือเลือกไฟล์</strong><small>PNG, JPG หรือ WEBP · ไม่เกิน 10 MB</small><em data-recommended-file-name>ยังไม่ได้เลือกไฟล์</em></label></div><label class="recommended-field"><span>หรือใช้ลิงก์รูปภาพ</span><small>เหมาะสำหรับรูปที่อัปโหลดไว้แล้ว</small><input name="imageUrl" type="url" placeholder="https://..." data-recommended-image-url></label></div><aside class="recommended-create-preview" aria-label="ตัวอย่างหมวดหมู่"><div class="recommended-preview-label"><span>LIVE PREVIEW</span><i>ตัวอย่าง</i></div><div class="recommended-preview-card"><div class="recommended-preview-cover"><img alt="" data-recommended-preview-image hidden><span data-recommended-preview-placeholder>ภาพปกหมวดหมู่</span></div><div class="recommended-preview-copy"><span>หมวดหมู่แนะนำ</span><strong data-recommended-preview-title>ชื่อหมวดหมู่</strong><small>แสดงสินค้าเด่นของคุณในกลุ่มเดียว</small></div></div><p>ภาพจะปรากฏเต็มพื้นที่โดยรักษาสัดส่วนเดิมของไฟล์</p></aside><div class="recommended-form-actions"><button class="experiment-button" type="button" data-recommended-close>ยกเลิก</button><button class="experiment-button primary" type="submit">สร้างหมวดหมู่ <span aria-hidden="true">→</span></button></div></form></div></dialog>

<dialog class="recommended-dialog recommended-product-picker-dialog" data-recommended-products-dialog aria-labelledby="recommended-products-title"><div class="recommended-dialog-head"><div><div class="experiment-kicker">PRODUCT CONNECTIONS</div><h2 id="recommended-products-title" data-recommended-products-title>เลือกสินค้าเข้าหมวด</h2><p>ค้นหาและเลือกสินค้าจากรายการเปิดขายของร้าน</p></div><button class="recommended-dialog-close" type="button" data-recommended-close aria-label="ปิดหน้าต่าง">×</button></div><div class="recommended-dialog-body recommended-product-picker-body"><form method="post" class="recommended-product-picker-form" data-recommended-products-form><div class="recommended-picker-controls"><input class="recommended-product-search" type="search" aria-label="ค้นหาสินค้าในหมวด" placeholder="ค้นหาชื่อสินค้า..." data-recommended-product-search><div class="recommended-picker-actions"><button class="experiment-button recommended-picker-action" type="button" data-recommended-select-visible>✓ <span>เลือกทั้งหมดที่พบ</span></button><button class="experiment-button recommended-picker-action" type="button" data-recommended-clear-selection>ล้างการเลือก</button></div><div class="recommended-picker-summary" aria-live="polite"><span><strong data-recommended-picked>0</strong> / <strong><%= activeProducts.length %></strong> รายการที่เลือก</span><span>พบ <strong data-recommended-visible-products><%= activeProducts.length %></strong> จาก <%= activeProducts.length %> สินค้า</span></div></div><div class="recommended-product-list" data-recommended-product-list role="group" aria-label="รายการสินค้าเปิดขาย"><% activeProducts.forEach(product => { %><label class="recommended-product-row" data-recommended-product-row data-product-name="<%= String(product.title || '').toLowerCase() %>"><input type="checkbox" name="productIds" value="<%= product.id %>" aria-label="เลือก <%= product.title %>"><span class="recommended-product-media"><% if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="" loading="lazy" decoding="async" onerror="this.hidden=true"><span class="recommended-product-placeholder" aria-hidden="true">◇</span><% } else { %><span class="recommended-product-placeholder" aria-hidden="true">◇</span><% } %></span><span class="recommended-product-copy"><strong><%= product.title %></strong><span class="recommended-product-meta"><span class="recommended-product-status">เปิดขาย</span><b>฿<%= Number(product.price || 0).toLocaleString('th-TH') %></b></span></span></label><% }) %><p class="recommended-product-empty <%= activeProducts.length ? 'recommended-hidden' : '' %>" data-recommended-product-empty>ยังไม่มีสินค้าเปิดขายให้เลือก</p></div><div class="recommended-form-actions"><button class="experiment-button" type="button" data-recommended-close>ยกเลิก</button><button class="experiment-button primary" type="submit">บันทึกสินค้าในหมวด</button></div></form></div></dialog>

<script>
(() => {
  document.querySelector('[data-recommended-notifications]')?.addEventListener('click', () => window.alert('ยังไม่มีการแจ้งเตือนใหม่'));
  const createDialog = document.querySelector('[data-recommended-create-dialog]');
  const productsDialog = document.querySelector('[data-recommended-products-dialog]');
  const open = dialog => dialog?.showModal();
  const titleInput = document.querySelector('[data-recommended-title-input]'); const titleCount = document.querySelector('[data-recommended-title-count]'); const previewTitle = document.querySelector('[data-recommended-preview-title]'); const imageInput = document.querySelector('[data-recommended-image-input]'); const imageUrlInput = document.querySelector('[data-recommended-image-url]'); const previewImage = document.querySelector('[data-recommended-preview-image]'); const previewPlaceholder = document.querySelector('[data-recommended-preview-placeholder]'); const fileName = document.querySelector('[data-recommended-file-name]'); const imageDrop = document.querySelector('[data-recommended-image-drop]');
  const setPreviewImage = source => { if (!previewImage || !previewPlaceholder) return; if (!source) { previewImage.hidden = true; previewImage.removeAttribute('src'); previewPlaceholder.hidden = false; return; } previewImage.src = source; previewImage.hidden = false; previewPlaceholder.hidden = true; previewImage.onerror = () => { previewImage.hidden = true; previewPlaceholder.hidden = false; }; };
  titleInput?.addEventListener('input', () => { if (titleCount) titleCount.textContent = titleInput.value.length; if (previewTitle) previewTitle.textContent = titleInput.value.trim() || 'ชื่อหมวดหมู่'; });
  imageInput?.addEventListener('change', () => { const file = imageInput.files?.[0]; if (!file) return; if (fileName) fileName.textContent = file.name; const reader = new FileReader(); reader.onload = event => setPreviewImage(event.target.result); reader.readAsDataURL(file); });
  imageUrlInput?.addEventListener('input', () => { if (!imageInput?.files?.length) setPreviewImage(imageUrlInput.value.trim()); });
  imageDrop?.addEventListener('dragover', event => { event.preventDefault(); imageDrop.classList.add('is-dragging'); }); imageDrop?.addEventListener('dragleave', () => imageDrop.classList.remove('is-dragging')); imageDrop?.addEventListener('drop', event => { event.preventDefault(); imageDrop.classList.remove('is-dragging'); if (event.dataTransfer.files?.length && imageInput) { imageInput.files = event.dataTransfer.files; imageInput.dispatchEvent(new Event('change', { bubbles: true })); } });
  document.querySelectorAll('[data-recommended-open-create]').forEach(button => button.addEventListener('click', () => open(createDialog)));
  document.querySelectorAll('[data-recommended-template]').forEach(button => button.addEventListener('click', () => { if (titleInput) { titleInput.value = button.dataset.recommendedTemplate || ''; titleInput.dispatchEvent(new Event('input', { bubbles: true })); } open(createDialog); }));
  document.querySelectorAll('[data-recommended-close]').forEach(button => button.addEventListener('click', () => button.closest('dialog')?.close()));
  document.querySelectorAll('dialog.recommended-dialog').forEach(dialog => dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); }));
  const search = document.querySelector('[data-recommended-search]'); const status = document.querySelector('[data-recommended-status]'); const cards = [...document.querySelectorAll('[data-recommended-card]')]; const count = document.querySelector('[data-recommended-visible-count]'); const empty = document.querySelector('[data-recommended-no-results]');
  const filter = () => { const query = (search?.value || '').trim().toLowerCase(); const selectedStatus = status?.value || 'all'; let visible = 0; cards.forEach(card => { const match = card.dataset.name.includes(query) && (selectedStatus === 'all' || card.dataset.status === selectedStatus); card.hidden = !match; if (match) visible += 1; }); if (count) count.textContent = visible; if (empty) empty.classList.toggle('recommended-hidden', visible !== 0 || cards.length === 0); };
  search?.addEventListener('input', filter); status?.addEventListener('change', filter);
  const productForm = document.querySelector('[data-recommended-products-form]'); const productSearch = document.querySelector('[data-recommended-product-search]'); const picked = document.querySelector('[data-recommended-picked]'); const visibleProducts = document.querySelector('[data-recommended-visible-products]'); const productEmpty = document.querySelector('[data-recommended-product-empty]'); const selectVisible = document.querySelector('[data-recommended-select-visible]'); const clearSelection = document.querySelector('[data-recommended-clear-selection]'); const rows = [...document.querySelectorAll('[data-recommended-product-row]')];
  const syncPicked = () => { if (picked) picked.textContent = rows.filter(row => row.querySelector('input')?.checked).length; };
  const filterProducts = () => { const query = (productSearch?.value || '').trim().toLowerCase(); let visible = 0; rows.forEach(row => { const match = (row.dataset.productName || '').includes(query); row.hidden = !match; if (match) visible += 1; }); if (visibleProducts) visibleProducts.textContent = visible; if (productEmpty) { productEmpty.textContent = rows.length ? 'ไม่พบสินค้าที่ตรงกับคำค้น ลองใช้คำอื่นได้เลย' : 'ยังไม่มีสินค้าเปิดขายให้เลือก'; productEmpty.classList.toggle('recommended-hidden', visible > 0); } syncPicked(); };
  productForm?.addEventListener('change', syncPicked); productSearch?.addEventListener('input', filterProducts);
  selectVisible?.addEventListener('click', () => { rows.filter(row => !row.hidden).forEach(row => { const input = row.querySelector('input'); if (input) input.checked = true; }); syncPicked(); });
  clearSelection?.addEventListener('click', () => { rows.forEach(row => { const input = row.querySelector('input'); if (input) input.checked = false; }); syncPicked(); });
  document.querySelectorAll('[data-recommended-open-products]').forEach(button => button.addEventListener('click', () => { const id = button.dataset.categoryId; const form = document.querySelector('[data-recommended-products-form]'); if (!form) return; form.action = `/admin/recommended-categories/${encodeURIComponent(id)}/products`; document.querySelector('[data-recommended-products-title]').textContent = `สินค้าใน “${button.dataset.categoryTitle}”`; const selected = new Set(<%- JSON.stringify(Object.fromEntries(categories.map(category => [category.id, (category.productIds || []).map(String)]))) %>[id] || []); rows.forEach(row => { const input = row.querySelector('input'); if (input) input.checked = selected.has(String(input.value)); }); if (productSearch) productSearch.value = ''; filterProducts(); open(productsDialog); }));
})();
</script>
