<!-- Users Management Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-[var(--gold)]/10 text-[var(--gold-text)] flex items-center justify-center text-lg shrink-0">👥</div>
    <div>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">จัดการสมาชิก & ผู้ใช้งาน</h1>
      <p class="text-xs text-[var(--text-4)] mt-0.5">รายชื่อสมาชิกและจัดการสิทธิ์การใช้งาน</p>
    </div>
  </div>
  <button type="button" id="add-user-open-btn" class="inline-flex items-center gap-1.5 bg-[var(--gold)] text-[var(--gold-contrast)] font-bold rounded-xl px-4 py-2.5 text-xs shadow-md transition active:scale-95 shrink-0">
    👤+ เพิ่มผู้ใช้
  </button>
</div>

<!-- Add User Modal -->
<div id="add-user-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-md">
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6 max-w-md w-full shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-base text-[var(--text)]">เพิ่มสมาชิก / แอดมินใหม่</h3>
      <button type="button" id="add-user-close-btn" class="w-7 h-7 rounded-lg flex items-center justify-center text-[var(--text-4)] hover:text-[var(--text)] hover:bg-[var(--input)] transition">✕</button>
    </div>

    <form action="/admin/users/new" method="post" class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ชื่อผู้ใช้ (Username) *</label>
        <input name="username" required placeholder="เช่น user123" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">อีเมล (Email) *</label>
        <input name="email" type="email" required placeholder="user@example.com" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">รหัสผ่าน (Password)</label>
        <input name="password" type="password" placeholder="อย่างน้อย 6 ตัวอักษร" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ระดับสิทธิ์ (Role)</label>
        <select name="role" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition">
          <option value="customer">ลูกค้าทั่วไป (Customer)</option>
          <option value="admin">ผู้ดูแลระบบ (Admin)</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button type="button" id="add-user-cancel-btn" class="px-4 py-2 rounded-xl text-xs font-medium text-[var(--text-3)] hover:text-[var(--text)] hover:bg-[var(--input)] transition">ยกเลิก</button>
        <button type="submit" class="px-5 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] text-[var(--gold-contrast)] shadow-md transition active:scale-95">+ สร้างบัญชีผู้ใช้</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function () {
    const openBtn = document.getElementById('add-user-open-btn');
    const modal = document.getElementById('add-user-modal');
    const closeBtn = document.getElementById('add-user-close-btn');
    const cancelBtn = document.getElementById('add-user-cancel-btn');
    if (!openBtn || !modal) return;
    const open = () => modal.classList.remove('hidden');
    const close = () => modal.classList.add('hidden');
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    cancelBtn.addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
  })();
</script>

<!-- Stat Cards -->
<div class="grid sm:grid-cols-2 gap-4 mb-6">
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm flex items-center justify-between">
    <div>
      <div class="text-xs text-[var(--text-4)] font-medium">ผู้ใช้ทั้งหมด</div>
      <div class="text-2xl font-bold text-[var(--text)] mt-1"><%= totalUsers.toLocaleString() %></div>
    </div>
    <div class="w-11 h-11 rounded-xl bg-[var(--gold)]/10 text-[var(--gold-text)] flex items-center justify-center text-lg">👥</div>
  </div>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm flex items-center justify-between">
    <div>
      <div class="text-xs text-[var(--text-4)] font-medium">ยอดเงินรวมในระบบ</div>
      <div class="text-2xl font-bold text-[var(--gold-text)] mt-1">฿<%= totalWalletBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) %></div>
    </div>
    <div class="w-11 h-11 rounded-xl bg-[var(--gold)]/10 text-[var(--gold-text)] flex items-center justify-center text-lg">💰</div>
  </div>
</div>

<div class="space-y-4">

    <!-- Table Panel Header: title + page-size + search -->
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-4 shadow-sm space-y-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold-text)] flex items-center justify-center text-sm shrink-0">▦</div>
        <div>
          <h3 class="font-bold text-sm text-[var(--text)]">จัดการผู้ใช้งาน</h3>
          <p class="text-[11px] text-[var(--text-4)]">ตารางแสดงรายชื่อสมาชิกและข้อมูลต่างๆ</p>
        </div>
      </div>

      <form method="get" action="/admin/users" class="flex flex-col sm:flex-row sm:items-center gap-2.5">
        <% if (registered) { %><input type="hidden" name="registered" value="today" /><% } %>
        <label class="flex items-center gap-1.5 text-xs text-[var(--text-4)] shrink-0">
          แสดง
          <select name="pageSize" onchange="this.form.requestSubmit()" class="bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1.5 text-xs outline-none focus:border-[var(--gold)] transition">
            <% pageSizeOptions.forEach(n => { %>
              <option value="<%= n %>" <%= pageSize === n ? 'selected' : '' %>><%= n %></option>
            <% }) %>
          </select>
          รายการ (จากทั้งหมด <%= matchedCount %> คน)
        </label>
        <div class="relative flex-1">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-4)] text-sm">⌕</span>
          <input name="q" value="<%= q %>" autocomplete="off" placeholder="ค้นหา Username หรือ Email..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl pl-9 pr-3 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>
        <button type="submit" class="bg-[var(--gold)] text-[var(--gold-contrast)] font-bold rounded-xl px-5 py-2 text-xs shadow-md transition active:scale-95 shrink-0">
          ค้นหา
        </button>
        <% if (q || registered) { %>
          <a href="/admin/users" class="border border-[var(--border-light)] rounded-xl px-4 py-2 text-xs text-center hover:border-[var(--gold)] transition shrink-0">
            ล้าง
          </a>
        <% } %>
      </form>
      <% if (registered === 'today') { %>
        <div class="flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/30 bg-[var(--gold)]/10 px-3.5 py-2 text-xs">
          <span class="font-semibold text-[var(--gold-text)]">กำลังแสดงลูกค้าที่สมัครวันนี้ <%= matchedCount %> คน</span>
          <a href="/admin/users" class="text-[var(--text-3)] hover:text-[var(--text)]">ดูสมาชิกทั้งหมด</a>
        </div>
      <% } %>
    </div>

    <!-- Mobile User Cards -->
    <div class="md:hidden space-y-3">
      <% users.forEach(u => { %>
        <article class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-sm">
          <div class="flex items-start gap-3.5 p-4">
            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-tr from-[var(--gold)] to-[var(--gold-hover)] text-base font-black text-[var(--gold-contrast)] shadow-sm">
              <%= String(u.username || '?').charAt(0).toUpperCase() %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <a href="/admin/users/<%= u.id %>" class="block truncate font-bold text-sm text-[var(--text)] hover:text-[var(--gold-text)]"><%= u.username %></a>
                  <p class="truncate text-xs text-[var(--text-4)]"><%= u.email %></p>
                </div>
                <span class="shrink-0 rounded-full px-2.5 py-0.5 text-[10px] font-semibold <%= u.status === 'banned' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
                  <%= u.status === 'banned' ? '● ระงับบัญชี' : '● ปกติ' %>
                </span>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <div class="rounded-xl bg-[var(--input)]/50 border border-[var(--border-light)] px-3 py-2">
                  <div class="text-[10px] text-[var(--text-4)] font-medium">สิทธิ์การใช้งาน</div>
                  <div class="mt-0.5 text-xs font-semibold <%= u.role === 'admin' ? 'text-[var(--gold-text)]' : 'text-[var(--text)]' %>">
                    <%= u.role === 'admin' ? '⭐ ผู้ดูแลระบบ' : 'ลูกค้าทั่วไป' %>
                  </div>
                </div>
                <div class="rounded-xl bg-[var(--input)]/50 border border-[var(--border-light)] px-3 py-2">
                  <div class="text-[10px] text-[var(--text-4)] font-medium">ยอดเครดิต</div>
                  <div class="mt-0.5 text-xs font-bold text-[var(--gold-text)]">฿<%= u.walletBalance.toLocaleString() %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="border-t border-[var(--border)] bg-[var(--input)]/30 p-3 space-y-2">
            <!-- Adjust Balance Form -->
            <form action="/admin/users/<%= u.id %>/wallet" method="post" class="flex gap-2">
              <input type="number" name="amount" min="0" step="0.01" required placeholder="ใส่ยอดใหม่ เช่น 500" class="flex-1 rounded-xl border border-[var(--border-light)] bg-[var(--card)] px-3 py-1.5 text-xs outline-none focus:border-[var(--gold)]" />
              <button type="submit" class="rounded-xl bg-[var(--gold)] px-3 py-1.5 text-xs font-bold text-[var(--gold-contrast)] active:scale-95 transition whitespace-nowrap">
                บันทึกยอด
              </button>
            </form>

            <div class="grid <%= u.role !== 'admin' ? 'grid-cols-3' : 'grid-cols-2' %> gap-2">
              <a href="/admin/users/<%= u.id %>" class="rounded-xl border border-[var(--gold)]/30 bg-[var(--gold)]/10 px-3 py-1.5 text-center text-xs font-semibold text-[var(--gold-text)] transition">ดูข้อมูล</a>
              <a href="/admin/topups?q=<%= encodeURIComponent(u.username) %>" class="rounded-xl border border-[var(--border-light)] bg-[var(--card)] px-3 py-1.5 text-center text-xs font-semibold text-sky-400 hover:bg-[var(--input)] transition">
                🧾 ประวัติเติมเงิน
              </a>
              <% if (u.role !== 'admin') { %>
                <form action="/admin/users/<%= u.id %>/toggle-ban" method="post" data-confirm="ต้องการ<%= u.status==='banned' ? 'ปลดระงับ' : 'ระงับการใช้งาน' %> บัญชีนี้ใช่ไหม?">
                  <button type="submit" class="w-full rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-rose-400 hover:bg-rose-500/20 transition">
                    <%= u.status==='banned' ? '✓ ปลดระงับ' : '⊘ ระงับบัญชี' %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!users.length) { %>
        <div class="rounded-2xl border border-dashed border-[var(--border-light)] py-12 text-center text-xs text-[var(--text-4)]">
          ไม่พบสมาชิกที่ตรงกับคำค้นหา “<%= q %>”
        </div>
      <% } %>
    </div>

    <!-- Desktop User Table -->
    <div class="hidden md:block bg-[var(--card)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="text-xs text-[var(--text-4)] bg-[var(--input)]/40 border-b border-[var(--border)] uppercase">
            <tr>
              <th class="py-3.5 px-4 font-semibold">ID</th>
              <th class="py-3.5 px-4 font-semibold">ผู้ใช้งาน</th>
              <th class="py-3.5 px-4 font-semibold">สิทธิ์</th>
              <th class="py-3.5 px-4 font-semibold">ยอดเครดิต</th>
              <th class="py-3.5 px-4 font-semibold">สถานะ</th>
              <th class="py-3.5 px-4 font-semibold text-right">การจัดการ</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]">
            <% users.forEach((u, i) => { %>
              <tr class="hover:bg-[var(--input)]/40 transition duration-150">

                <!-- Row Number -->
                <td class="py-3 px-4 text-[var(--text-4)] font-mono text-[11px]">#<%= (page - 1) * pageSize + i + 1 %></td>

                <!-- User Info -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-[var(--input)] border border-[var(--border-light)] flex items-center justify-center font-bold text-xs text-[var(--gold-text)] shrink-0">
                      <%= String(u.username || '?').charAt(0).toUpperCase() %>
                    </div>
                    <div class="min-w-0">
                      <a href="/admin/users/<%= u.id %>" class="block font-bold text-xs sm:text-sm text-[var(--text)] hover:text-[var(--gold-text)] truncate"><%= u.username %></a>
                      <div class="text-[11px] text-[var(--text-4)] truncate"><%= u.email %></div>
                    </div>
                  </div>
                </td>

                <!-- Role -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (u.role === 'admin') { %>
                    <span class="inline-flex items-center gap-1 bg-purple-500/10 border border-purple-500/30 text-purple-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      ⭐ แอดมิน
                    </span>
                  <% } else { %>
                    <span class="text-xs text-[var(--text-3)] font-medium">ลูกค้า</span>
                  <% } %>
                </td>

                <!-- Balance -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="font-bold text-sm text-[var(--gold-text)]">฿<%= u.walletBalance.toLocaleString() %></span>
                </td>

                <!-- Status -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (u.status === 'banned') { %>
                    <span class="inline-flex items-center gap-1 bg-rose-500/10 border border-rose-500/30 text-rose-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> ระงับ
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ปกติ
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <a href="/admin/users/<%= u.id %>" class="rounded-lg border border-[var(--gold)]/30 bg-[var(--gold)]/10 px-2 py-1 text-xs font-semibold text-[var(--gold-text)] hover:bg-[var(--gold)]/20 transition">ดูข้อมูล</a>

                    <!-- Adjust Balance Form -->
                    <form action="/admin/users/<%= u.id %>/wallet" method="post" class="inline-flex items-center gap-1">
                      <input type="number" name="amount" min="0" step="0.01" required placeholder="ยอดใหม่" class="w-20 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1 text-xs outline-none focus:border-[var(--gold)]" />
                      <button type="submit" class="bg-[var(--gold)] text-[var(--gold-contrast)] font-bold px-2 py-1 rounded-lg text-xs hover:bg-[var(--gold-hover)] transition" title="ปรับยอดเงินในกระเป๋า">
                        ตั้งยอด
                      </button>
                    </form>

                    <!-- Topup History Link -->
                    <a href="/admin/topups?q=<%= encodeURIComponent(u.username) %>" class="p-1.5 rounded-lg text-sky-400 hover:bg-sky-500/10 transition text-xs" title="ดูประวัติการเติมเงิน">
                      🧾
                    </a>

                    <!-- Ban Toggle Button -->
                    <% if (u.role !== 'admin') { %>
                      <form action="/admin/users/<%= u.id %>/toggle-ban" method="post" class="inline" data-confirm="ต้องการ<%= u.status==='banned' ? 'ปลดระงับ' : 'ระงับการใช้งาน' %> บัญชีนี้ใช่ไหม?">
                        <button type="submit" class="p-1.5 rounded-lg <%= u.status==='banned' ? 'text-emerald-400 hover:bg-emerald-500/10' : 'text-rose-400 hover:bg-rose-500/10' %> transition text-xs" title="<%= u.status==='banned' ? 'ปลดระงับบัญชี' : 'ระงับบัญชี' %>">
                          <%= u.status==='banned' ? '✓ ปลด' : '⊘ แบน' %>
                        </button>
                      </form>
                    <% } %>

                  </div>
                </td>

              </tr>
            <% }) %>

            <% if (!users.length) { %>
              <tr>
                <td class="py-12 text-center text-[var(--text-4)] text-xs" colspan="6">
                  ไม่พบสมาชิกที่ตรงกับคำค้นหา “<%= q %>”
                </td>
              </tr>
            <% } %>

          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-between gap-3 border-t border-[var(--border)] px-4 py-3 text-xs text-[var(--text-4)]">
          <span>หน้า <%= page %> จาก <%= totalPages %></span>
          <div class="flex items-center gap-1.5">
            <% const qs = (p) => `?q=${encodeURIComponent(q)}&registered=${encodeURIComponent(registered)}&pageSize=${pageSize}&page=${p}`; %>
            <a href="<%= qs(Math.max(1, page - 1)) %>" class="px-3 py-1.5 rounded-lg border border-[var(--border-light)] <%= page <= 1 ? 'opacity-40 pointer-events-none' : 'hover:border-[var(--gold)]' %> transition">‹ ก่อนหน้า</a>
            <a href="<%= qs(Math.min(totalPages, page + 1)) %>" class="px-3 py-1.5 rounded-lg border border-[var(--border-light)] <%= page >= totalPages ? 'opacity-40 pointer-events-none' : 'hover:border-[var(--gold)]' %> transition">ถัดไป ›</a>
          </div>
        </div>
      <% } %>
    </div>

</div>
