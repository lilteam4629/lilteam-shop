<!-- Users Management Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">จัดการสมาชิก & ผู้ใช้งาน</h1>
    <p class="text-xs text-[var(--text-4)] mt-0.5">ค้นหา ปรับยอดเครดิตกระเป๋าเงิน และจัดการสิทธิ์การใช้งานของผู้ใช้ทั้งหมดในระบบ (<%= totalUsers %> บัญชี)</p>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6">

  <!-- Left Main Column: Users Table & Search -->
  <div class="lg:col-span-2 min-w-0 space-y-4">

    <!-- Search Form -->
    <form method="get" action="/admin/users" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row gap-2.5">
      <div class="relative flex-1">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-4)] text-sm">⌕</span>
        <input name="q" value="<%= q %>" autocomplete="off" placeholder="ค้นหาชื่อผู้ใช้ (Username) หรืออีเมล..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl pl-9 pr-3 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
      </div>
      <button type="submit" class="bg-[var(--gold)] text-[var(--bg)] font-bold rounded-xl px-5 py-2 text-xs shadow-md transition active:scale-95">
        ค้นหา
      </button>
      <% if (q) { %>
        <a href="/admin/users" class="border border-[var(--border-light)] rounded-xl px-4 py-2 text-xs text-center hover:border-[var(--gold)] transition">
          ล้าง
        </a>
      <% } %>
    </form>

    <div class="text-xs text-[var(--text-4)] px-1">
      <%= q ? `ผลการค้นหา: พบ ${users.length} จากทั้งหมด ${totalUsers} บัญชี` : `แสดงทั้งหมด ${users.length} บัญชี` %>
    </div>

    <!-- Mobile User Cards -->
    <div class="md:hidden space-y-3">
      <% users.forEach(u => { %>
        <article class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-sm">
          <div class="flex items-start gap-3.5 p-4">
            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-tr from-[var(--gold)] to-[var(--gold-hover)] text-base font-black text-[var(--bg)] shadow-sm">
              <%= String(u.username || '?').charAt(0).toUpperCase() %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <h3 class="truncate font-bold text-sm text-[var(--text)]"><%= u.username %></h3>
                  <p class="truncate text-xs text-[var(--text-4)]"><%= u.email %></p>
                </div>
                <span class="shrink-0 rounded-full px-2.5 py-0.5 text-[10px] font-semibold <%= u.status === 'banned' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
                  <%= u.status === 'banned' ? '● ระงับบัญชี' : '● ปกติ' %>
                </span>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <div class="rounded-xl bg-[var(--input)]/50 border border-[var(--border-light)] px-3 py-2">
                  <div class="text-[10px] text-[var(--text-4)] font-medium">สิทธิ์การใช้งาน</div>
                  <div class="mt-0.5 text-xs font-semibold <%= u.role === 'admin' ? 'text-[var(--gold)]' : 'text-[var(--text)]' %>">
                    <%= u.role === 'admin' ? '⭐ ผู้ดูแลระบบ' : 'ลูกค้าทั่วไป' %>
                  </div>
                </div>
                <div class="rounded-xl bg-[var(--input)]/50 border border-[var(--border-light)] px-3 py-2">
                  <div class="text-[10px] text-[var(--text-4)] font-medium">ยอดเครดิต</div>
                  <div class="mt-0.5 text-xs font-bold text-[var(--gold)]">฿<%= u.walletBalance.toLocaleString() %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="border-t border-[var(--border)] bg-[var(--input)]/30 p-3 space-y-2">
            <!-- Adjust Balance Form -->
            <form action="/admin/users/<%= u.id %>/wallet" method="post" class="flex gap-2">
              <input type="number" name="amount" required placeholder="ปรับยอด เช่น 100 หรือ -50" class="flex-1 rounded-xl border border-[var(--border-light)] bg-[var(--card)] px-3 py-1.5 text-xs outline-none focus:border-[var(--gold)]" />
              <button type="submit" class="rounded-xl bg-[var(--gold)] px-3 py-1.5 text-xs font-bold text-[var(--bg)] active:scale-95 transition whitespace-nowrap">
                บันทึกยอด
              </button>
            </form>

            <div class="grid <%= u.role !== 'admin' ? 'grid-cols-2' : 'grid-cols-1' %> gap-2">
              <a href="/admin/topups?q=<%= encodeURIComponent(u.username) %>" class="rounded-xl border border-[var(--border-light)] bg-[var(--card)] px-3 py-1.5 text-center text-xs font-semibold text-sky-400 hover:bg-[var(--input)] transition">
                🧾 ประวัติเติมเงิน
              </a>
              <% if (u.role !== 'admin') { %>
                <form action="/admin/users/<%= u.id %>/toggle-ban" method="post" data-confirm="ต้องการ<%= u.status==='banned' ? 'ปลดระงับ' : 'ระงับการใช้งาน' %> บัญชีนี้ใช่ไหม?">
                  <button type="submit" class="w-full rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-rose-400 hover:bg-rose-500/20 transition">
                    <%= u.status==='banned' ? '✓ ปลดระงับ' : '⊘ ระงับบัญชี' %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!users.length) { %>
        <div class="rounded-2xl border border-dashed border-[var(--border-light)] py-12 text-center text-xs text-[var(--text-4)]">
          ไม่พบสมาชิกที่ตรงกับคำค้นหา “<%= q %>”
        </div>
      <% } %>
    </div>

    <!-- Desktop User Table -->
    <div class="hidden md:block bg-[var(--card)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="text-xs text-[var(--text-4)] bg-[var(--input)]/40 border-b border-[var(--border)] uppercase">
            <tr>
              <th class="py-3.5 px-4 font-semibold">ผู้ใช้งาน</th>
              <th class="py-3.5 px-4 font-semibold">สิทธิ์</th>
              <th class="py-3.5 px-4 font-semibold">ยอดเครดิต</th>
              <th class="py-3.5 px-4 font-semibold">สถานะ</th>
              <th class="py-3.5 px-4 font-semibold text-right">การจัดการ</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]">
            <% users.forEach(u => { %>
              <tr class="hover:bg-[var(--input)]/40 transition duration-150">

                <!-- User Info -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-[var(--input)] border border-[var(--border-light)] flex items-center justify-center font-bold text-xs text-[var(--gold)] shrink-0">
                      <%= String(u.username || '?').charAt(0).toUpperCase() %>
                    </div>
                    <div class="min-w-0">
                      <div class="font-bold text-xs sm:text-sm text-[var(--text)] truncate"><%= u.username %></div>
                      <div class="text-[11px] text-[var(--text-4)] truncate"><%= u.email %></div>
                    </div>
                  </div>
                </td>

                <!-- Role -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (u.role === 'admin') { %>
                    <span class="inline-flex items-center gap-1 bg-purple-500/10 border border-purple-500/30 text-purple-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      ⭐ แอดมิน
                    </span>
                  <% } else { %>
                    <span class="text-xs text-[var(--text-3)] font-medium">ลูกค้า</span>
                  <% } %>
                </td>

                <!-- Balance -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="font-bold text-sm text-[var(--gold)]">฿<%= u.walletBalance.toLocaleString() %></span>
                </td>

                <!-- Status -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <% if (u.status === 'banned') { %>
                    <span class="inline-flex items-center gap-1 bg-rose-500/10 border border-rose-500/30 text-rose-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> ระงับ
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-2.5 py-0.5 rounded-full text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ปกติ
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">

                    <!-- Adjust Balance Form -->
                    <form action="/admin/users/<%= u.id %>/wallet" method="post" class="inline-flex items-center gap-1">
                      <input type="number" name="amount" required placeholder="+/-" class="w-16 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1 text-xs outline-none focus:border-[var(--gold)]" />
                      <button type="submit" class="bg-[var(--gold)] text-[var(--bg)] font-bold px-2 py-1 rounded-lg text-xs hover:bg-[var(--gold-hover)] transition" title="ปรับยอดเงินในกระเป๋า">
                        ปรับ
                      </button>
                    </form>

                    <!-- Topup History Link -->
                    <a href="/admin/topups?q=<%= encodeURIComponent(u.username) %>" class="p-1.5 rounded-lg text-sky-400 hover:bg-sky-500/10 transition text-xs" title="ดูประวัติการเติมเงิน">
                      🧾
                    </a>

                    <!-- Ban Toggle Button -->
                    <% if (u.role !== 'admin') { %>
                      <form action="/admin/users/<%= u.id %>/toggle-ban" method="post" class="inline" data-confirm="ต้องการ<%= u.status==='banned' ? 'ปลดระงับ' : 'ระงับการใช้งาน' %> บัญชีนี้ใช่ไหม?">
                        <button type="submit" class="p-1.5 rounded-lg <%= u.status==='banned' ? 'text-emerald-400 hover:bg-emerald-500/10' : 'text-rose-400 hover:bg-rose-500/10' %> transition text-xs" title="<%= u.status==='banned' ? 'ปลดระงับบัญชี' : 'ระงับบัญชี' %>">
                          <%= u.status==='banned' ? '✓ ปลด' : '⊘ แบน' %>
                        </button>
                      </form>
                    <% } %>

                  </div>
                </td>

              </tr>
            <% }) %>

            <% if (!users.length) { %>
              <tr>
                <td class="py-12 text-center text-[var(--text-4)] text-xs" colspan="5">
                  ไม่พบสมาชิกที่ตรงกับคำค้นหา “<%= q %>”
                </td>
              </tr>
            <% } %>

          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Right Column: Add New User Form Card -->
  <div>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 shadow-sm sticky top-20">
      <div class="flex items-center gap-2.5 mb-4">
        <div class="w-8 h-8 rounded-xl bg-[var(--gold)]/10 text-[var(--gold)] flex items-center justify-center font-bold text-sm">
          👤
        </div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text)]">เพิ่มสมาชิก / แอดมินใหม่</h3>
      </div>

      <form action="/admin/users/new" method="post" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ชื่อผู้ใช้ (Username) *</label>
          <input name="username" required placeholder="เช่น user123" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">อีเมล (Email) *</label>
          <input name="email" type="email" required placeholder="user@example.com" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">รหัสผ่าน (Password)</label>
          <input name="password" type="password" placeholder="อย่างน้อย 6 ตัวอักษร" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition" />
        </div>

        <div>
          <label class="block text-xs font-semibold mb-1 text-[var(--text-3)]">ระดับสิทธิ์ (Role)</label>
          <select name="role" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl px-3.5 py-2 text-xs outline-none focus:border-[var(--gold)] transition">
            <option value="customer">ลูกค้าทั่วไป (Customer)</option>
            <option value="admin">ผู้ดูแลระบบ (Admin)</option>
          </select>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-[var(--gold)] to-[var(--gold-hover)] hover:opacity-90 text-[var(--bg)] font-bold rounded-xl py-2.5 text-xs shadow-md transition active:scale-95 mt-2">
          + สร้างบัญชีผู้ใช้
        </button>
      </form>
    </div>
  </div>

</div>
