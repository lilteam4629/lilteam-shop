<% const v6Categories = (Array.isArray(recommendedCategories) ? recommendedCategories : []).slice(0, 6); %>
<% const v6Banner = settings.hero && settings.hero.bannerImage ? settings.hero.bannerImage : (settings.storefrontAppearance && settings.storefrontAppearance.backgroundImage ? settings.storefrontAppearance.backgroundImage : ''); %>
<main class="owner-v6-home">
  <section class="v6-banner" aria-labelledby="v6-title">
    <% if (v6Banner) { %><img class="v6-banner__image" src="<%= v6Banner %>" alt="<%= settings.shopName %>" fetchpriority="high" decoding="async" /><% } %>
    <div class="v6-banner__shade"></div>
    <div class="v6-banner__content"><div class="v6-banner__top"><span>LILTEAM · DIGITAL GAME STORE</span><span><i></i> เปิดให้บริการ 24 ชั่วโมง</span></div><div class="v6-banner__copy"><span class="v6-kicker">ยินดีต้อนรับ</span><h1 id="v6-title"><%= settings.shopName %></h1><p><%= settings.tagline || 'เลือกสินค้า เติมเงิน และรับของได้ในระบบเดียว' %></p><div class="v6-actions"><a href="/products" class="v6-button v6-button--light">เลือกสินค้า <b>↗</b></a><a href="/account/topup" class="v6-button v6-button--ghost">เติมเงิน</a></div></div><div class="v6-banner__bottom"><span>ภาพสินค้าเต็มใบ · ตรวจสอบรายการได้ · รับของหลังชำระเงิน</span><a href="#v6-catalog">เลื่อนดูสินค้า ↓</a></div></div>
  </section>

<nav class="v6-quick" aria-label="ทางลัดร้าน"><a href="#v6-catalog"><b>01</b><span>สินค้าทั้งหมด<small><%= Number(productTotal || 0).toLocaleString() %> รายการ</small></span><em>↘</em></a><a href="#v6Filters"><b>02</b><span>ตัวกรองผู้เล่น<small><%= Number(filterTags ? filterTags.length : 0).toLocaleString() %> ตัวกรอง</small></span><em>↘</em></a><a href="/help"><b>03</b><span>วิธีสั่งซื้อ<small>ขั้นตอนสั้น เข้าใจง่าย</small></span><em>↗</em></a><% if (isMainSite) { %><a href="/contact"><b>04</b><span>ติดต่อร้าน<small>มีทีมงานดูแล</small></span><em>↗</em></a><% } %></nav>

  <% if (announcements && announcements.length) { %><section class="v6-announcement" aria-label="ประกาศร้าน"><b>ประกาศ</b><div><strong><%= announcements[0].title %></strong><span><%= announcements[0].body %></span></div></section><% } %>

  <% if (v6Categories.length) { %><section class="v6-section v6-categories"><header class="v6-section-head"><div><span class="v6-label">BROWSE</span><h2>เลือกจากหมวดที่สนใจ</h2></div><a href="/products">ดูทั้งหมด ↗</a></header><div class="v6-category-row"><% v6Categories.forEach((category, i) => { %><a href="/products?recommended=<%= encodeURIComponent(category.id) %>" class="v6-category"><div><% if (category.imageUrl) { %><img src="<%= category.imageUrl %>" alt="<%= category.title %>" loading="lazy" /><% } else { %><span><%= String(i + 1).padStart(2, '0') %></span><% } %></div><b><%= category.title %></b><small><%= Number(category.count || 0).toLocaleString() %> รายการ</small></a><% }) %></div></section><% } %>

  <% if (filterTags && filterTags.length) { %><section class="v6-section v6-filter-section" id="v6Filters"><header class="v6-section-head"><div><span class="v6-label">FILTER</span><h2>ค้นหาตัวที่ต้องการ</h2></div><a href="/products">เปิดหน้าค้นหา ↗</a></header><div class="v6-filter-box"><%- include('../partials/filter-panel', { filterTags }) %></div></section><% } %>

  <section class="v6-section v6-catalog" id="v6-catalog" aria-labelledby="v6-catalog-title"><header class="v6-section-head v6-catalog-head"><div><span class="v6-label">SHOP</span><h2 id="v6-catalog-title">สินค้าทั้งหมด</h2><small><%= Number(productTotal || 0).toLocaleString() %> รายการจากระบบหลังบ้าน</small></div><div class="v6-catalog-tools"><label><span>⌕</span><input id="v6Search" type="search" placeholder="ค้นหาชื่อสินค้า..." autocomplete="off" /></label><div><button type="button" class="is-active" data-v6-stock="all">ทั้งหมด</button><button type="button" data-v6-stock="available">พร้อมขาย</button><button type="button" data-v6-stock="sold">หมด</button></div></div></header>
    <% if (homeSections && homeSections.length) { %><% homeSections.slice(0, 1).forEach(section => { %><section class="v6-managed-section"><header><h3><%= section.title %></h3><span>จัดการจากหลังบ้าน</span></header><div class="v6-product-grid"><% section.products.forEach(p => { %><%- include('../partials/product-card-v6', { p }) %><% }) %></div></section><% }) %><% } %>
    <section class="v6-managed-section"><header><h3>รายการทั้งหมด</h3><span>หน้า <%= productPage %> / <%= productTotalPages %></span></header><div class="v6-product-grid" id="v6ProductGrid"><% if (products && products.length) { %><% products.forEach(p => { %><%- include('../partials/product-card-v6', { p }) %><% }) %><% } else { %><div class="v6-empty">ยังไม่มีสินค้าในระบบ</div><% } %></div><% if (productTotalPages > 1) { %><div class="v6-pagination"><a href="/?page=<%= Math.max(1, productPage - 1) %>">← ก่อนหน้า</a><span>หน้า <b><%= productPage %></b> / <%= productTotalPages %></span><a href="/?page=<%= Math.min(productTotalPages, productPage + 1) %>">ถัดไป →</a></div><% } %></section>
  </section>

  <section class="v6-footer-cta"><div><span class="v6-label">LILTEAM SHOP</span><h2>เลือกได้เลย<br>พร้อมส่งทุกวัน</h2></div><a href="/products" class="v6-button v6-button--dark">เข้าร้านค้า ↗</a></section>
</main>
<script>
(function(){const grid=document.getElementById('v6ProductGrid'),search=document.getElementById('v6Search'),buttons=[...document.querySelectorAll('[data-v6-stock]')];if(grid){const cards=[...grid.querySelectorAll('[data-v6-product]')];let stock='all';const apply=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('th-TH');cards.forEach(card=>card.hidden=!!((q&&!card.dataset.title.includes(q))||(stock!=='all'&&card.dataset.stock!==stock)))};search?.addEventListener('input',apply);buttons.forEach(b=>b.addEventListener('click',()=>{stock=b.dataset.v6Stock;buttons.forEach(x=>x.classList.toggle('is-active',x===b));apply()}));apply()} })();
</script>
