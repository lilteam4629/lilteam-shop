<section id="home-catalog" class="store-product-gallery w-full max-w-[1800px] px-1 sm:px-4 lg:w-[85%] lg:px-0 mx-auto py-8">
  <% if (homeSections.length) { %>
    <% homeSections.forEach(section => { %>
      <section id="home-section-<%= section.id %>" class="scroll-mt-28">
      <%- include('../partials/section-hud-header', { icon: '✨', title: section.title, subtitle: '', href: null }) %>
