<% const storefrontBackground = settings.storefrontAppearance && settings.storefrontAppearance.backgroundImage; %>
<% const heroTextColor = '#ffffff'; %>
<% const heroOutlineColor = 'transparent'; %>
<% const heroOutlineWidth = 0; %>
<% if (storefrontBackground) { %>
<style>
  .storefront-hero-banner{--hero-text-color:<%= heroTextColor %>;--hero-outline-color:<%= heroOutlineColor %>;--hero-outline-width:<%= heroOutlineWidth %>px}
  /* Keep the owner's home footer attached to the catalog. The body artwork
     is decorative and must not leak into a blank margin above the footer. */
  body.storefront-owner-lilteam > div > footer { margin-top:0!important; }
  .storefront-hero-banner { background:transparent!important;background-image:none!important; }
  .storefront-hero-banner::before,.storefront-hero-banner::after { display:none!important;content:none!important; }
  .storefront-hero-banner>.banner-hero-shell { background:transparent!important; }
  .modern-fan-hero{border:0!important;background:transparent!important;background-image:none!important}
  .modern-fan-hero::before,.modern-fan-hero::after{display:none!important;content:none!important}
  @media(min-width:901px){
    .storefront-hero-banner .lilteam-hero-command{position:relative!important;isolation:isolate!important}
    .storefront-hero-banner .lilteam-hero-command::before{display:none!important;content:none!important}
    .storefront-hero-banner .lilteam-hero-command__copy{position:relative!important;z-index:1!important;width:min(820px,100%)!important;max-width:820px!important;padding:28px 32px 30px!important;border:0!important;border-radius:0!important;background:linear-gradient(90deg,color-mix(in srgb,var(--hero-outline-color) 28%,transparent),transparent 88%)!important;box-shadow:none!important;backdrop-filter:none!important}
    .storefront-hero-banner .lilteam-hero-command__copy:before,.storefront-hero-banner .lilteam-hero-command__copy:after{display:none!important;content:none!important}
    .storefront-hero-banner .lilteam-hero-command h1{max-width:760px;color:var(--hero-text-color)!important;white-space:normal!important;font-size:clamp(34px,3.5vw,52px)!important;font-weight:950!important;line-height:1.08!important;letter-spacing:-.045em!important;-webkit-text-stroke:0!important;paint-order:normal!important;text-shadow:0 3px 14px color-mix(in srgb,var(--hero-outline-color) 42%,transparent)!important;filter:none!important}
    .storefront-hero-banner .lilteam-hero-command h1 em{display:inline;color:var(--hero-text-color)!important;background:none!important}
    .storefront-hero-banner .lilteam-hero-command__copy>p{max-width:680px!important;color:var(--hero-text-color)!important;font-size:15px!important;font-weight:700!important;line-height:1.6!important;-webkit-text-stroke:0!important;paint-order:normal!important;text-shadow:0 2px 9px color-mix(in srgb,var(--hero-outline-color) 38%,transparent)!important;filter:none!important}
    .storefront-hero-banner .lilteam-hero-command__copy>p span{color:var(--hero-text-color)!important;text-shadow:none!important;filter:none!important}
    .storefront-hero-banner .lilteam-hero-command__eyebrow{color:var(--hero-text-color)!important;font-size:12px!important;font-weight:950!important;-webkit-text-stroke:calc(var(--hero-outline-width) * .45) var(--hero-outline-color)!important;paint-order:stroke fill!important;text-shadow:none!important;filter:none!important}.storefront-hero-banner .lilteam-hero-command h1 em{color:var(--hero-text-color)!important;-webkit-text-stroke:var(--hero-outline-width) var(--hero-outline-color)!important;text-shadow:none!important;filter:none!important}
    .latest-orders-heading h2,.latest-orders-heading p,.home-catalog-title h2,.home-catalog-title p{color:var(--text)!important;text-shadow:0 2px 5px color-mix(in srgb,var(--gold-dark) 75%,transparent)!important}
  }
  /* Keep the copy treatment consistent when the banner is viewed at tablet
     widths too; the older mobile stylesheet otherwise restores the oversized
     text treatment shown in the previous design. */
  .storefront-hero-banner .lilteam-hero-command__copy{position:relative!important;z-index:1!important;width:min(820px,100%)!important;max-width:820px!important;padding:24px 26px 26px!important;border:0!important;border-radius:0!important;background:linear-gradient(90deg,color-mix(in srgb,var(--hero-outline-color) 28%,transparent),transparent 88%)!important;box-shadow:none!important;backdrop-filter:none!important}
  .storefront-hero-banner .lilteam-hero-command{border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
  .storefront-hero-banner .lilteam-hero-command h1{max-width:760px!important;color:var(--hero-text-color)!important;white-space:normal!important;font-size:clamp(30px,5.5vw,52px)!important;font-weight:950!important;line-height:1.08!important;letter-spacing:-.045em!important;-webkit-text-stroke:0!important;text-shadow:0 3px 14px color-mix(in srgb,var(--hero-outline-color) 42%,transparent)!important}
  .storefront-hero-banner .lilteam-hero-command h1 em{display:inline!important;padding:0!important;border-radius:0!important;background:none!important;color:var(--hero-text-color)!important;-webkit-text-stroke:0!important}
  .storefront-hero-banner .lilteam-hero-command__copy>p{max-width:680px!important;color:var(--hero-text-color)!important;font-size:14px!important;font-weight:700!important;line-height:1.6!important;-webkit-text-stroke:0!important;text-shadow:0 2px 9px color-mix(in srgb,var(--hero-outline-color) 38%,transparent)!important}
  .storefront-hero-banner .lilteam-hero-command__copy>p span{color:var(--hero-text-color)!important;text-shadow:none!important}
  .storefront-hero-banner .lilteam-hero-command__eyebrow{color:var(--hero-text-color)!important;font-size:11px!important;font-weight:950!important;-webkit-text-stroke:0!important;text-shadow:0 2px 8px color-mix(in srgb,var(--hero-outline-color) 36%,transparent)!important}
  @media(max-width:640px){.storefront-hero-banner .lilteam-hero-command__copy{padding:18px!important}.storefront-hero-banner .lilteam-hero-command h1{font-size:clamp(26px,8vw,36px)!important}.storefront-hero-banner .lilteam-hero-command__copy>p{font-size:12px!important}.storefront-hero-banner .lilteam-hero-command__eyebrow{font-size:9px!important}}
  @media(max-width:700px){.storefront-hero-banner{padding-top:14px!important}.storefront-hero-banner>.banner-hero-shell{width:calc(100% - 24px)!important;margin:12px auto 0!important;padding:0!important;border-radius:16px!important;overflow:hidden!important}.storefront-hero-banner .banner-sparkle{border-radius:16px!important;overflow:hidden!important}.storefront-hero-banner .banner-sparkle img{display:block!important;width:100%!important;height:auto!important}}
</style>
<style>
/* Category banners mirror the storefront reference: wide 600x200 artwork with metadata below. */
.home-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:14px!important}
.home-category-card{display:block!important;padding:0!important;overflow:hidden!important}
.home-category-image{width:100%!important;height:auto!important;aspect-ratio:3/1!important}
.home-category-copy{padding:9px 12px 11px!important}
.home-category-image img{object-fit:contain!important;object-position:center!important;background:var(--input)!important}
.home-category-image{aspect-ratio:auto!important;height:auto!important;min-height:0!important}.home-category-image img{display:block!important;width:100%!important;height:auto!important;max-height:260px!important;object-fit:contain!important}
.home-category-heading{display:flex;align-items:center;gap:9px}.home-category-heading>b,.home-category-heading>span:last-child{display:flex;flex-direction:column}.home-category-heading b{color:var(--text);font-size:17px;line-height:1.1}.home-category-heading small{margin-top:3px;color:var(--text-4);font-size:9px}.home-category-icon{display:grid;place-items:center;width:25px;height:25px;border:1px solid var(--border-light);border-radius:6px;color:var(--text-2);font-size:15px}.home-category-head>a{padding:8px 17px;border-radius:7px;background:var(--text);color:var(--bg)!important;font-size:10px;font-weight:800}
@media(max-width:640px){.home-category-grid{grid-template-columns:1fr!important;gap:10px!important}.home-category-image{aspect-ratio:auto!important;height:auto!important}}
</style>
<% } %>

<% const ownerHomeV14 = typeof isMainSite !== 'undefined' && isMainSite; %>
<% if (ownerHomeV14) { %><div class="owner-home-v14-layout" data-owner-home-layout="matchday-game-world"><% } %>

<% if (typeof heroPreviewV2 !== 'undefined' && heroPreviewV2) { %>
  <%- include('../partials/locker-hero', { newest, stats, settings, filterTags, publicPreview: typeof publicPreview !== 'undefined' ? publicPreview : false }) %>
<% } else if (settings.hero.mode === 'banner' && settings.hero.bannerImage) { %>
  <section class="storefront-hero-banner">
    <% if (ownerHomeV14) { %>
    <div class="owner-home-v14-hero">
      <div class="owner-home-v14-hero-copy">
        <span class="owner-home-v14-eyebrow">MAIN STORE <i></i> MATCHDAY EDITION</span>
        <h1><%= settings.shopName || 'LILTeam Shop' %></h1>
        <p><%= settings.tagline || 'เลือกชมสินค้าและข้อเสนอจากร้านได้ที่นี่' %></p>
        <div class="owner-home-v14-hero-count"><strong><%= productTotal %></strong><span>รายการในร้าน</span></div>
        <a class="owner-home-v14-hero-link" href="#home-catalog">เลือกดูสินค้า <span aria-hidden="true">↘</span></a>
      </div>
    <% } %>
    <div class="banner-hero-shell w-full max-w-[1800px] px-0 sm:px-4 lg:w-[85%] lg:px-0 mx-auto py-0 sm:py-6">
      <% if (settings.hero.bannerLink) { %>
        <a href="<%= settings.hero.bannerLink %>"
          class="banner-sparkle group block overflow-hidden rounded-none sm:rounded-2xl border-0 sm:border border-[var(--border)] shadow-none sm:shadow-[0_0_40px_-14px_color-mix(in_srgb,var(--gold)_35%,transparent)]
                 transition-all duration-300 hover:border-[var(--gold)]/60 hover:shadow-[0_0_50px_-10px_color-mix(in_srgb,var(--gold)_50%,transparent)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>" fetchpriority="high" decoding="async"
            class="w-full object-cover transition duration-500 group-hover:scale-[1.02] group-hover:brightness-105" />
        </a>
      <% } else { %>
        <div class="banner-sparkle overflow-hidden rounded-none sm:rounded-2xl border-0 sm:border border-[var(--border)] shadow-none sm:shadow-[0_0_40px_-14px_color-mix(in_srgb,var(--gold)_35%,transparent)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>" fetchpriority="high" decoding="async" class="w-full object-cover" />
        </div>
      <% } %>
    </div>
    <% if (ownerHomeV14) { %></div><% } %>
  </section>
<% } else { %>
<section class="modern-fan-hero border-b border-[var(--border)] overflow-hidden">
  <div class="modern-fan-heading w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-10 pb-6 text-center">
    <p class="text-[var(--gold-text)] text-xs sm:text-sm mb-2 px-2 flex flex-wrap items-center justify-center gap-1.5">
      <span>🎮</span><%= stats.gameCount %> สินค้า — พร้อมส่งทันทีหลังชำระเงิน
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
      <span class="bg-gradient-to-r from-[var(--gold)] via-[var(--text)] to-[var(--gold)] bg-clip-text text-transparent" data-storefront-preview-setting="shopName"><%= settings.shopName %></span>
    </h1>
    <p class="text-[var(--text-3)] max-w-xl mx-auto" data-storefront-preview-setting="tagline"><%= settings.tagline %></p>
  </div>

  <% if (newest.length) { %>
  <!-- Compact 3-card fan for mobile -->
  <div class="modern-fan-stage modern-fan-mobile sm:hidden relative w-[92vw] max-w-[420px] mx-auto mb-6" style="height: clamp(230px, 68vw, 290px);">
    <%
      const mobileNewest = newest.slice(0,3);
      const mobileLayouts = {
        1: [{ left: '50%', width: '48%', y: '0vw', rotate: 0 }],
        2: [
          { left: '34%', width: '43%', y: '4vw', rotate: -5 },
          { left: '66%', width: '43%', y: '4vw', rotate: 5 },
        ],
        3: [
          { left: '22%', width: '36%', y: '8vw', rotate: -7 },
          { left: '50%', width: '48%', y: '0vw', rotate: 0 },
          { left: '78%', width: '36%', y: '8vw', rotate: 7 },
        ],
      };
      const mobileLayout = mobileLayouts[mobileNewest.length];
    %>
    <% mobileNewest.forEach((p, i) => { const layout = mobileLayout[i]; %>
      <div class="modern-fan-card absolute top-0 aspect-[3/4]"
        style="--fan-left:<%= layout.left %>; --fan-width:<%= layout.width %>; --fan-y:<%= layout.y %>; --fan-rotate:<%= layout.rotate %>deg; left:var(--fan-left); width:var(--fan-width); transform:translateX(-50%) translateY(var(--fan-y)) rotate(var(--fan-rotate)); z-index:<%= 10 - Math.abs((mobileNewest.length - 1) / 2 - i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>

  <!-- Full 5-card fan for tablet/desktop -->
  <div class="modern-fan-stage modern-fan-desktop hidden sm:block relative max-w-6xl mx-auto mb-6" style="height: clamp(295px, 42vw, 405px);">
    <%
      const rot = [-10, -5, 0, 5, 10];
      const tx = ['-40%', '-20%', '0%', '20%', '40%'];
      const ty = [58, 24, 0, 24, 58];
      const widths = ['clamp(150px,18vw,200px)', 'clamp(172px,21vw,230px)', 'clamp(198px,24vw,265px)', 'clamp(172px,21vw,230px)', 'clamp(150px,18vw,200px)'];
    %>
    <% newest.slice(0,5).forEach((p, i) => { %>
      <div class="modern-fan-card absolute top-0 left-1/2 aspect-[3/4] hover:z-30"
        style="--fan-width:<%= widths[i] %>; --fan-x:<%= tx[i] %>; --fan-y:<%= ty[i] %>px; --fan-rotate:<%= rot[i] %>deg; width:var(--fan-width); margin-left:calc(var(--fan-x) - var(--fan-width) / 2); transform:translateY(var(--fan-y)) rotate(var(--fan-rotate)); z-index:<%= 10 - Math.abs(2-i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>
  <% } %>
</section>
<% } %>

<style>
.banner-sparkle{position:relative;isolation:isolate}
.banner-sparkle:after{content:'';position:absolute;z-index:20;top:-28%;bottom:-28%;left:-18%;width:9%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.58),transparent);transform:skewX(-16deg);pointer-events:none;animation:banner-sparkle-sweep 8s ease-in-out 1 both;animation-play-state:paused}
.banner-sparkle.perf-visible:after{animation-play-state:running}
@keyframes banner-sparkle-sweep{0%,18%{left:-18%;opacity:0}23%{opacity:.72}55%{left:112%;opacity:.62}61%,100%{left:112%;opacity:0}}
@keyframes storefront-product-sweep{0%,20%{transform:translateX(-180%) skewX(-16deg);opacity:0}25%{opacity:.6}53%{transform:translateX(720%) skewX(-16deg);opacity:.5}59%,100%{transform:translateX(720%) skewX(-16deg);opacity:0}}
.store-product-gallery .product-shimmer{width:16%!important;background:linear-gradient(90deg,transparent,rgba(255,255,255,.62),transparent)!important;filter:none!important;mix-blend-mode:normal!important;animation-name:storefront-product-sweep!important;animation-duration:8.5s!important;animation-timing-function:ease-in-out!important;animation-iteration-count:1!important;animation-fill-mode:both!important;animation-play-state:paused!important}
.store-product-gallery .premium-product-card.perf-visible .product-shimmer{animation-play-state:running!important}
.store-product-gallery .product-grid>.premium-product-card:nth-child(4n+1) .product-shimmer{animation-delay:-.2s}.store-product-gallery .product-grid>.premium-product-card:nth-child(4n+2) .product-shimmer{animation-delay:-1.1s}.store-product-gallery .product-grid>.premium-product-card:nth-child(4n+3) .product-shimmer{animation-delay:-2s}.store-product-gallery .product-grid>.premium-product-card:nth-child(4n) .product-shimmer{animation-delay:-2.9s}
/* Long product grids must stay on the browser's normal paint layer. Combining
   image filters, transforms and one compositor animation per card caused
   Chromium to evict random image tiles until a hover forced a repaint. */
.store-product-gallery .product-grid>.premium-product-card{transform:none!important;contain:none!important;will-change:auto!important;transition:border-color .2s ease!important}
.store-product-gallery .product-grid>.premium-product-card:hover{transform:none!important}
.store-product-gallery .product-grid>.premium-product-card img{transform:none!important;filter:none!important;backface-visibility:visible!important;will-change:auto!important;transition:none!important}
.store-product-gallery .product-grid>.premium-product-card .product-shimmer{display:none!important;animation:none!important}
.modern-fan-hero{position:relative;isolation:isolate;background:radial-gradient(ellipse at 50% 62%,color-mix(in srgb,var(--gold) 16%,transparent),transparent 38%),linear-gradient(180deg,color-mix(in srgb,var(--gold) 4%,var(--bg)),var(--bg))}.modern-fan-hero:before{content:'';position:absolute;z-index:-2;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--gold) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--gold) 5%,transparent) 1px,transparent 1px);background-size:4.5rem 4.5rem;mask-image:linear-gradient(transparent 2%,#000 34%,transparent 92%)}.modern-fan-hero:after{content:'';position:absolute;z-index:-1;bottom:-18rem;left:50%;width:min(76rem,96vw);height:29rem;border:1px solid color-mix(in srgb,var(--gold) 16%,transparent);border-radius:50%;background:radial-gradient(ellipse,color-mix(in srgb,var(--gold) 10%,transparent),transparent 66%);box-shadow:0 -20px 70px color-mix(in srgb,var(--gold) 8%,transparent);transform:translateX(-50%);pointer-events:none}.modern-fan-heading{position:relative;z-index:20}.modern-fan-heading>p:first-child{display:inline-flex;width:auto;align-items:center;padding:.38rem .72rem;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border));border-radius:999px;background:color-mix(in srgb,var(--gold) 6%,var(--card));box-shadow:inset 0 1px color-mix(in srgb,#fff 16%,transparent)}.modern-fan-heading h1{line-height:1.15;letter-spacing:-.06em;padding-block:.1em}.modern-fan-heading h1 span{filter:drop-shadow(0 8px 24px color-mix(in srgb,var(--gold) 12%,transparent))}.modern-fan-stage{perspective:1200px}.modern-fan-card{transform-origin:50% 82%;transition:transform .42s cubic-bezier(.2,.85,.2,1),filter .32s,opacity .32s}.modern-fan-card:before{content:'';position:absolute;z-index:-1;inset:-.42rem;border:1px solid color-mix(in srgb,var(--gold) 22%,var(--border));border-radius:1rem;background:linear-gradient(145deg,color-mix(in srgb,var(--gold) 7%,var(--card)),transparent 58%);box-shadow:0 25px 40px rgba(0,0,0,.18),0 0 30px color-mix(in srgb,var(--gold) 8%,transparent);opacity:.82;transition:border-color .3s,box-shadow .3s}.modern-fan-card:after{content:'';position:absolute;z-index:15;right:18%;bottom:-.65rem;left:18%;height:.22rem;border-radius:99px;background:linear-gradient(90deg,transparent,var(--gold),transparent);box-shadow:0 0 12px color-mix(in srgb,var(--gold) 55%,transparent);opacity:.55;transition:opacity .3s,transform .3s}.modern-fan-card:hover,.modern-fan-card:focus-within{transform:translateY(calc(var(--fan-y) - 18px)) rotate(0deg) scale(1.045)!important}.modern-fan-card:hover:before,.modern-fan-card:focus-within:before{border-color:color-mix(in srgb,var(--gold) 58%,var(--border));box-shadow:0 34px 52px rgba(0,0,0,.24),0 0 36px color-mix(in srgb,var(--gold) 20%,transparent)}.modern-fan-card:hover:after,.modern-fan-card:focus-within:after{opacity:1;transform:scaleX(1.2)}.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:brightness(.72) saturate(.82);opacity:.78}.modern-fan-card>a,.modern-fan-card>div{height:100%}.modern-fan-card img{backface-visibility:hidden}@media(max-width:640px){.modern-fan-hero:before{background-size:3.5rem 3.5rem}.modern-fan-hero:after{bottom:-13rem;height:21rem}.modern-fan-heading{padding-top:1.7rem!important;padding-bottom:1rem!important}.modern-fan-heading>p:first-child{font-size:.66rem}.modern-fan-heading h1{font-size:2.35rem}.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) rotate(0deg) scale(1.025)!important}.modern-fan-card:before{inset:-.28rem;border-radius:.7rem}.modern-fan-card:after{bottom:-.45rem}}@media(hover:none){.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:none;opacity:1}}@media(prefers-reduced-motion:reduce){.modern-fan-card,.modern-fan-card:before,.modern-fan-card:after{transition:none!important}}
/* Luxury Card Vault */
.modern-fan-hero{background:radial-gradient(ellipse at 50% 72%,color-mix(in srgb,var(--gold) 11%,transparent),transparent 42%),linear-gradient(180deg,var(--card),var(--bg))}.modern-fan-hero:before{background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--gold) 5%,transparent) 28%,transparent 28.2% 71.8%,color-mix(in srgb,var(--gold) 5%,transparent) 72%,transparent);mask-image:linear-gradient(#000,transparent 86%)}.modern-fan-hero:after{bottom:-15rem;width:min(82rem,105vw);height:25rem;border-color:color-mix(in srgb,var(--gold) 22%,var(--border));background:radial-gradient(ellipse,color-mix(in srgb,var(--gold) 12%,var(--input)),transparent 67%);box-shadow:0 -10px 55px color-mix(in srgb,var(--gold) 9%,transparent)}.modern-fan-heading>p:first-child{border-color:color-mix(in srgb,var(--gold) 22%,var(--border));background:var(--card);box-shadow:0 8px 24px rgba(0,0,0,.06)}.modern-fan-desktop .modern-fan-card:nth-child(n){transform:translateY(var(--fan-y)) rotate(0deg)!important}.modern-fan-card:before{inset:-.5rem;border-color:color-mix(in srgb,var(--gold) 22%,var(--border));border-radius:.75rem;background:linear-gradient(145deg,color-mix(in srgb,#fff 10%,var(--card)),color-mix(in srgb,var(--gold) 5%,var(--input)));box-shadow:0 22px 38px rgba(0,0,0,.16),inset 0 1px color-mix(in srgb,#fff 26%,transparent);opacity:1}.modern-fan-card:after{right:8%;bottom:-1.05rem;left:8%;height:1rem;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border));border-radius:50%;background:radial-gradient(ellipse,var(--gold),color-mix(in srgb,var(--gold) 18%,transparent) 55%,transparent 72%);box-shadow:0 8px 25px color-mix(in srgb,var(--gold) 18%,transparent);opacity:.58}.modern-fan-card:hover,.modern-fan-card:focus-within{transform:translateY(calc(var(--fan-y) - 20px)) scale(1.035)!important}.modern-fan-card:hover:after,.modern-fan-card:focus-within:after{opacity:1;transform:scaleX(1.12)}.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:brightness(.84) saturate(.9);opacity:.88}@media(max-width:640px){.modern-fan-hero:before{background:none}.modern-fan-hero:after{bottom:-11rem;height:18rem}.modern-fan-mobile .modern-fan-card:nth-child(n){transform:translateX(-50%) translateY(var(--fan-y)) rotate(0deg)!important}.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) scale(1.02)!important}.modern-fan-card:after{bottom:-.7rem;height:.72rem}}
.modern-fan-desktop .modern-fan-card:nth-child(n){transform:translateY(var(--fan-y)) rotate(var(--fan-rotate))!important}.modern-fan-desktop .modern-fan-card:nth-child(1),.modern-fan-desktop .modern-fan-card:nth-child(5){transform-origin:50% 88%}.modern-fan-desktop .modern-fan-card:nth-child(2),.modern-fan-desktop .modern-fan-card:nth-child(4){transform-origin:50% 84%}.modern-fan-desktop .modern-fan-card:nth-child(3){transform-origin:50% 78%}.modern-fan-mobile .modern-fan-card:nth-child(n){transform:translateX(-50%) translateY(var(--fan-y)) rotate(var(--fan-rotate))!important}@media(max-width:640px){.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) rotate(0) scale(1.025)!important}}
.modern-fan-desktop .modern-fan-card:nth-child(n):hover,.modern-fan-desktop .modern-fan-card:nth-child(n):focus-within{transform:translateY(calc(var(--fan-y) - 20px)) rotate(0) scale(1.035)!important}
</style>

