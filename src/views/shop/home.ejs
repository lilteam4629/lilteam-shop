      <% if (catalogApiProductCount) { %><small>หน้าหลักคัดมาโชว์ <b><%= catalogApiFeaturedProducts.length %></b> รายการ · มีสินค้า Partner ทั้งหมด <b><%= catalogApiProductCount %></b> รายการ</small><% } %>
