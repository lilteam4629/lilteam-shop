    background: linear-gradient(145deg, var(--gold-light), var(--gold-dark));
    border: 1px solid color-mix(in srgb, var(--gold-light) 55%, transparent);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 8px 24px -10px color-mix(in srgb, var(--gold) 80%, transparent);
  }
  .mg-kicker { color: var(--gold); font-size: .7rem; font-weight: 700; letter-spacing: .04em; }
