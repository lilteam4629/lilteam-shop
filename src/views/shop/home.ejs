  </div>
</section>
<style>
  .api-product-shelf{width:min(1320px,calc(100% - 48px));margin:18px auto 4px;padding:16px;border:1px solid color-mix(in srgb,var(--gold) 48%,var(--border));border-radius:16px;background:linear-gradient(140deg,color-mix(in srgb,var(--gold) 7%,var(--card)),var(--card));box-shadow:0 16px 34px -28px color-mix(in srgb,var(--gold) 90%,transparent)}.api-product-shelf-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:13px}.api-product-shelf-brand{display:flex;align-items:center;min-width:0;gap:10px}.api-product-shelf-brand>img,.api-product-shelf-logo-fallback{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:11px;object-fit:contain;background:var(--input);border:1px solid color-mix(in srgb,var(--gold) 45%,var(--border));color:var(--gold-text);font-size:20px;font-weight:950}.api-product-shelf-brand>div>span{color:var(--gold-text);font-size:9px;font-weight:950;letter-spacing:.18em}.api-product-shelf-head h2{margin-top:4px;color:var(--text);font-size:20px;font-weight:950;line-height:1.2}.api-product-shelf-head p{margin-top:4px;color:var(--text-2);font-size:11px}.api-product-shelf-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px}.api-product-shelf-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:7px 11px;border-radius:8px;background:var(--gold);color:var(--gold-contrast);font-size:10px;font-weight:900;white-space:nowrap}.api-product-shelf-actions a+a{border:1px solid var(--border-light);background:var(--input);color:var(--text)}
  @media(max-width:640px){.api-product-shelf{width:calc(100% - 24px);padding:12px;border-radius:13px}.api-product-shelf-head{align-items:flex-start;flex-direction:column}.api-product-shelf-head h2{font-size:17px}.api-product-shelf-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}.api-product-shelf-actions a{font-size:10px}}
</style>
<% } %>

<% if (recommendedCategories && recommendedCategories.length) { %>
<section class="home-category-rail" aria-label="หมวดหมู่สินค้า">
  <div class="home-category-head"><div class="home-category-heading"><span class="home-category-icon">◇</span><span><b>หมวดหมู่แนะนำ</b><small>Recommended Categories</small></span></div><a href="<%= (typeof isAdmin !== 'undefined' && isAdmin) ? '/admin/home-sections?ui=experiment' : '/products' %>"><%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'เพิ่มหมวด ›' : 'ดูทั้งหมด ›' %></a></div>
  <div class="home-category-grid">
    <% recommendedCategories.forEach(category => { %>
      <a class="home-category-card" href="/products?recommended=<%= encodeURIComponent(category.id) %>">
        <span class="home-category-image"><% if (category.imageUrl) { %><img src="<%= category.imageUrl %>" alt="<%= category.title %>" loading="lazy" decoding="async" /><% } else { %><span>600 × 200</span><% } %></span>
        <span class="home-category-copy"><b><%= category.title %></b><small>สินค้าทั้งหมด <%= category.count %> รายการ</small></span><span class="home-category-arrow">↗</span>
      </a>
    <% }) %>
  </div>
</section>
<style>
.home-category-rail{width:min(1320px,calc(100% - 48px));margin:0 auto;padding:18px 0 4px}.home-category-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:12px}.home-category-head span{color:var(--gold-text);font:700 9px/1 'JetBrains Mono',monospace;letter-spacing:.18em}.home-category-head h2{margin-top:5px;color:var(--text);font-size:18px;font-weight:850}.home-category-head a{color:var(--gold-text);font-size:11px;font-weight:700}.home-category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.home-category-card{position:relative;display:flex;align-items:center;gap:12px;min-width:0;padding:9px;border:1px solid var(--border);border-radius:14px;background:var(--card);color:var(--text);transition:border-color .18s,transform .18s}.home-category-card:hover{border-color:var(--gold);transform:translateY(-2px)}.home-category-image{display:grid;place-items:center;width:72px;height:54px;flex:none;overflow:hidden;border-radius:9px;background:var(--input);color:var(--gold);font-size:22px}.home-category-image img{width:100%;height:100%;object-fit:cover}.home-category-copy{min-width:0}.home-category-copy b,.home-category-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.home-category-copy b{font-size:12px}.home-category-copy small{margin-top:3px;color:var(--text-4);font-size:10px}.home-category-arrow{margin-left:auto;color:var(--gold-text);font-size:16px}@media(max-width:640px){.home-category-rail{width:calc(100% - 24px);padding-top:12px}.home-category-grid{display:flex;overflow-x:auto;gap:8px;padding-bottom:4px;scroll-snap-type:x proximity}.home-category-card{flex:0 0 190px;scroll-snap-align:start}.home-category-head h2{font-size:15px}.home-category-head a{font-size:10px}}
</style>
<style>
@media(max-width:640px){.home-category-grid{display:grid!important;grid-template-columns:1fr!important;gap:12px!important;overflow:visible!important;padding-bottom:0}.home-category-card{display:block!important;width:100%!important;flex:none!important;scroll-snap-align:none}.home-category-image{width:100%!important}}
</style>
<% } %>
<style>
/* Keep recommended category banners full-width on phones, regardless of background setting. */
@media(max-width:640px){.home-category-grid{display:grid!important;grid-template-columns:1fr!important;gap:12px!important;overflow:visible!important;padding-bottom:0}.home-category-card{display:block!important;width:100%!important;flex:none!important;scroll-snap-align:none}.home-category-image{width:100%!important}}
</style>

<section class="store-status-section w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6" data-storefront-preview-hours-bar <%= settings.showOpenHoursBar === false ? 'hidden' : '' %>>
  <div class="hud-bar relative flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm text-[var(--text-2)] overflow-hidden">
    <div class="hud-bar-glow"></div>
    <div class="hud-bar-scan"></div>
    <span class="hud-icon hidden sm:flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[13px]">🕐</span>
    <div class="flex-1 relative h-5 overflow-hidden min-w-0 z-[1]">
      <span class="marquee-track flex items-center gap-2 font-mono tracking-tight"><span class="sm:hidden">🕐</span> <span data-storefront-preview-setting="openHours"><%= settings.openHours %></span> &nbsp;&nbsp;<span class="text-[var(--gold-text)]">◆</span>&nbsp;&nbsp; <span data-storefront-preview-setting="tagline"><%= settings.tagline %></span></span>
    </div>
    <span class="hud-status inline-flex items-center gap-1.5 shrink-0 ml-2 pl-2.5 pr-3 py-1 rounded-full text-[11px] font-bold text-emerald-300 z-[1]">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      เปิดให้บริการ
    </span>
  </div>
</section>

<% if (announcements.length) { %>
<div class="store-announcements w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-2 space-y-2">
  <% announcements.forEach(a => { %>
    <div class="announce-hud relative flex items-start gap-3 rounded-xl px-4 py-3 text-[var(--text)] text-sm overflow-hidden">
      <div class="announce-hud-glow"></div>
      <span class="announce-hud-icon relative z-[1] flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"><svg><use href="#ui-megaphone"/></svg></span>
      <p class="relative z-[1] min-w-0 leading-relaxed"><b class="text-[var(--gold-text)]"><%= a.title %></b> — <%= a.body %></p>
    </div>
  <% }) %>
</div>
<% } %>

<style>
.hud-bar{background:color-mix(in srgb,var(--bg) 78%,black 8%);backdrop-filter:blur(10px);border:1px solid color-mix(in srgb,var(--gold) 30%,var(--border));box-shadow:0 0 0 1px color-mix(in srgb,var(--gold) 10%,transparent) inset,0 12px 30px -18px color-mix(in srgb,var(--gold) 65%,transparent)}
.hud-bar-glow{position:absolute;inset:-1px;z-index:0;padding:1px;border-radius:inherit;background:conic-gradient(from var(--hud-angle,0deg),transparent 0 65%,var(--gold) 78%,transparent 90%);-webkit-mask:linear-gradient(#000,#000) content-box,linear-gradient(#000,#000);-webkit-mask-composite:xor;mask-composite:exclude;animation:hud-rotate 5s linear infinite;opacity:.85}
.hud-bar-scan{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.hud-bar-scan:before{content:'';position:absolute;top:0;bottom:0;width:35%;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--gold) 16%,transparent),transparent);animation:hud-sweep 3.2s ease-in-out infinite}
.hud-icon{background:color-mix(in srgb,var(--gold) 14%,transparent);box-shadow:0 0 12px color-mix(in srgb,var(--gold) 35%,transparent);position:relative;z-index:1}
.hud-status{background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.45);box-shadow:0 0 14px rgba(52,211,153,.25)}
@keyframes hud-rotate{to{--hud-angle:360deg}}
@property --hud-angle{syntax:'<angle>';inherits:false;initial-value:0deg}
@keyframes hud-sweep{0%{transform:translateX(-120%)}50%{transform:translateX(340%)}100%{transform:translateX(340%)}}
.announce-hud{background:color-mix(in srgb,var(--bg) 80%,black 6%);backdrop-filter:blur(10px);border:1px solid color-mix(in srgb,var(--gold) 32%,transparent);box-shadow:0 12px 28px -20px color-mix(in srgb,var(--gold) 70%,transparent)}
.announce-hud-glow{position:absolute;inset:0;z-index:0;background:linear-gradient(90deg,color-mix(in srgb,var(--gold) 14%,transparent),transparent 55%)}
.announce-hud-icon{background:linear-gradient(145deg,var(--gold-light),var(--gold-dark));color:#171207;box-shadow:0 0 16px color-mix(in srgb,var(--gold) 45%,transparent)}
@media(prefers-reduced-motion:reduce){.hud-bar-glow,.hud-bar-scan:before{animation:none!important}}
</style>

<%
  const welcomePopup = settings.welcomePopup || {};
  const welcomePopupImages = Array.isArray(welcomePopup.images) ? welcomePopup.images : [];
  const showWelcomePopupRedesign = Boolean(welcomePopupRedesign || welcomePopupExperiment);
  const welcomePopupTitle = welcomePopup.showTitle !== false
    ? (welcomePopup.title || (welcomePopupExperiment ? 'ยินดีต้อนรับ!' : ''))
    : '';
  const welcomePopupContent = welcomePopup.showContent !== false
    ? (welcomePopup.content || (welcomePopupExperiment ? 'ขอบคุณที่ใช้บริการเว็บไซต์ของเรา' : ''))
    : '';
  const welcomePopupHasContent = welcomePopupImages.length || welcomePopupTitle || welcomePopupContent;
%>
<% if (showWelcomePopupRedesign) { %><link rel="stylesheet" href="<%= asset('css/storefront-welcome-popup-experiment-v1.css') %>" /><% } %>
<% if ((welcomePopup.enabled && welcomePopupHasContent) || welcomePopupExperiment) { %>
<div id="welcome-popup" class="hidden fixed inset-0 z-[9998] items-center justify-center bg-black/70 backdrop-blur-sm p-4<%= showWelcomePopupRedesign ? ' welcome-popup-redesign' : '' %>" data-popup-id="<%= welcomePopupImages.join('|') %>|<%= welcomePopupTitle %>|<%= welcomePopupContent %>" data-shop-name="<%= settings.shopName || 'LilTeam Shop' %>" data-shop-logo="<%= settings.branding && settings.branding.logoImage ? settings.branding.logoImage : '' %>"<% if (showWelcomePopupRedesign) { %> role="dialog" aria-modal="true"<% if (welcomePopupTitle) { %> aria-labelledby="welcome-popup-title"<% } else { %> aria-label="ป๊อปอัปต้อนรับ"<% } %><% if (welcomePopupContent) { %> aria-describedby="welcome-popup-description"<% } %> tabindex="-1"<% } %>>
  <div class="relative w-full max-w-md bg-[var(--card)] border border-[var(--gold)]/40 rounded-2xl overflow-hidden shadow-2xl welcome-popup-dialog">
    <% if (showWelcomePopupRedesign) { %><button type="button" class="welcome-popup-dismiss" data-welcome-popup-dismiss aria-label="ปิดป๊อปอัปต้อนรับ">×</button><% } %>
    <% if (welcomePopupImages.length) { %>
      <div class="welcome-popup-slider relative w-full aspect-square bg-[var(--input)] overflow-hidden">
        <% welcomePopupImages.forEach((image, index) => { %>
          <img src="<%= image %>" alt="" class="welcome-popup-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-500 <%= index === 0 ? 'opacity-100' : 'opacity-0' %>" data-index="<%= index %>" />
        <% }) %>
        <% if (welcomePopupImages.length > 1) { %>
          <div class="absolute bottom-2.5 left-0 right-0 flex items-center justify-center gap-1.5 z-10">
            <% welcomePopupImages.forEach((image, index) => { %>
              <span class="welcome-popup-dot w-1.5 h-1.5 rounded-full <%= index === 0 ? 'bg-white' : 'bg-white/40' %> transition" data-index="<%= index %>"></span>
            <% }) %>
          </div>
          <% if (showWelcomePopupRedesign) { %>
            <button type="button" class="welcome-popup-carousel-toggle" data-welcome-popup-carousel-toggle aria-label="หยุดสลับรูปภาพ">
              <svg data-carousel-pause viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
              <svg data-carousel-play viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m8 5 12 7-12 7z" /></svg>
            </button>
          <% } %>
        <% } %>
      </div>
    <% } %>
    <% if (welcomePopupTitle || welcomePopupContent) { %>
      <div class="p-5 text-center border-t border-[var(--border)] welcome-popup-copy<%= welcomePopupImages.length ? '' : ' welcome-popup-no-image' %>">
        <% if (showWelcomePopupRedesign) { %><div class="welcome-popup-brand" aria-hidden="true"><span class="welcome-popup-brand-mark<%= settings.branding && settings.branding.logoImage ? ' has-logo' : '' %>"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="" /><% } else { %>L<% } %></span><span><%= settings.shopName || 'LilTeam Shop' %></span></div><% } %>
        <% if (welcomePopupTitle) { %><h3 id="welcome-popup-title" class="font-bold text-base text-[var(--text)] mb-1"><%= welcomePopupTitle %></h3><% } %>
        <% if (welcomePopupContent) { %><p id="welcome-popup-description" class="text-sm text-[var(--text-3)] leading-relaxed"><%= welcomePopupContent %></p><% } %>
      </div>
    <% } %>
    <div class="flex divide-x divide-[var(--border)] border-t border-[var(--border)] welcome-popup-actions">
      <button type="button" id="welcome-popup-close" class="flex-1 py-3 text-sm font-medium text-[var(--text-2)] hover:bg-[var(--input)]"><% if (showWelcomePopupRedesign) { %><svg class="welcome-popup-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><% } else { %>✕ <% } %>เข้าสู่เว็บไซต์</button>
      <button type="button" id="welcome-popup-mute" class="flex-1 py-3 text-sm font-medium text-[var(--coral)] hover:bg-[var(--input)]"><% if (showWelcomePopupRedesign) { %><svg class="welcome-popup-action-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><% } else { %>🕐 <% } %>ไม่แสดงผลอีกครั้งใน 1 วัน</button>
    </div>
  </div>
</div>
<script>
  (async function () {
    const modal = document.getElementById('welcome-popup');
    if (!modal) return;
    const hostname = window.location.hostname;
    const localHost = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
    const experimentPreview = modal.classList.contains('welcome-popup-redesign')
      && localHost
      && new URLSearchParams(window.location.search).get('welcomePopupExperiment') === '1';
    const previewImageUrls = [];
    if (experimentPreview) {
      try {
        const draft = JSON.parse(localStorage.getItem('lilteam_welcome_popup_experiment_v1') || 'null');
        if (draft && draft.version >= 2) {
          if (!draft.enabled) {
            modal.remove();
            return;
          }

          const references = Array.isArray(draft.images) ? draft.images : [];
          const images = [];
          const localReferences = references.filter((image) => image.source === 'local' && image.key);
          if (localReferences.length && window.indexedDB) {
            const database = await new Promise((resolve, reject) => {
              const request = indexedDB.open('lilteam_welcome_popup_experiment', 1);
              request.onupgradeneeded = () => {
                if (!request.result.objectStoreNames.contains('images')) request.result.createObjectStore('images');
              };
              request.onsuccess = () => resolve(request.result);
              request.onerror = () => reject(request.error);
            });
            try {
              for (const reference of references) {
                if (reference.source === 'local' && reference.key) {
                  const blob = await new Promise((resolve, reject) => {
                    const transaction = database.transaction('images', 'readonly');
                    const request = transaction.objectStore('images').get(reference.key);
                    request.onsuccess = () => resolve(request.result || null);
                    request.onerror = () => reject(request.error);
                  });
                  if (blob) {
                    const src = URL.createObjectURL(blob);
                    previewImageUrls.push(src);
                    images.push({ src, key: reference.key, name: reference.name || 'รูปทดลอง' });
                  }
                } else if (reference.source === 'url' && reference.src) {
                  images.push({ src: reference.src, key: reference.src, name: reference.name || 'รูปหน้าร้าน' });
                }
              }
            } finally {
              database.close();
            }
          } else {
            for (const reference of references) {
              if (reference.source === 'url' && reference.src) images.push({ src: reference.src, key: reference.src, name: reference.name || 'รูปหน้าร้าน' });
            }
          }

          const dialog = modal.querySelector('.welcome-popup-dialog');
          const actions = modal.querySelector('.welcome-popup-actions');
          let copy = modal.querySelector('.welcome-popup-copy');
          if (!copy) {
            copy = document.createElement('div');
            copy.className = 'welcome-popup-copy';
            dialog.insertBefore(copy, actions);
          }
          let brand = copy.querySelector('.welcome-popup-brand');
          if (!brand) {
            brand = document.createElement('div');
            brand.className = 'welcome-popup-brand';
            brand.setAttribute('aria-hidden', 'true');
            const mark = document.createElement('span');
            mark.className = 'welcome-popup-brand-mark';
            if (modal.dataset.shopLogo) {
              mark.classList.add('has-logo');
              const logo = document.createElement('img');
              logo.src = modal.dataset.shopLogo;
              logo.alt = '';
              mark.appendChild(logo);
            } else {
              mark.textContent = (modal.dataset.shopName || 'L').trim().charAt(0) || 'L';
            }
            const name = document.createElement('span');
            name.textContent = modal.dataset.shopName || 'LilTeam Shop';
            brand.append(mark, name);
            copy.prepend(brand);
          }
          brand.querySelectorAll('.welcome-popup-brand-mark img').forEach((logo) => {
            const useInitialFallback = () => {
              const mark = logo.closest('.welcome-popup-brand-mark');
              if (!mark) return;
              mark.classList.remove('has-logo');
              mark.replaceChildren(document.createTextNode((modal.dataset.shopName || 'L').trim().charAt(0) || 'L'));
            };
            logo.addEventListener('error', useInitialFallback, { once: true });
            if (logo.complete && !logo.naturalWidth) useInitialFallback();
          });

          const title = draft.showTitle ? String(draft.title || '').trim() : '';
          const content = draft.showContent ? String(draft.content || '').trim() : '';
          let titleElement = copy.querySelector('#welcome-popup-title');
          if (title && !titleElement) {
            titleElement = document.createElement('h3');
            titleElement.id = 'welcome-popup-title';
            titleElement.className = 'font-bold text-base text-[var(--text)] mb-1';
            copy.appendChild(titleElement);
          }
          if (titleElement) {
            titleElement.textContent = title;
            titleElement.hidden = !title;
          }
          let contentElement = copy.querySelector('#welcome-popup-description');
          if (content && !contentElement) {
            contentElement = document.createElement('p');
            contentElement.id = 'welcome-popup-description';
            contentElement.className = 'text-sm text-[var(--text-3)] leading-relaxed';
            copy.appendChild(contentElement);
          }
          if (contentElement) {
            contentElement.textContent = content;
            contentElement.hidden = !content;
          }
          copy.classList.toggle('welcome-popup-no-image', images.length === 0);
          if (title) modal.setAttribute('aria-labelledby', 'welcome-popup-title');
          else {
            modal.removeAttribute('aria-labelledby');
            modal.setAttribute('aria-label', 'ป๊อปอัปต้อนรับ');
          }
          if (content) modal.setAttribute('aria-describedby', 'welcome-popup-description');
          else modal.removeAttribute('aria-describedby');

          let slider = modal.querySelector('.welcome-popup-slider');
          if (!images.length) {
            slider?.remove();
          } else {
            if (!slider) {
              slider = document.createElement('div');
              slider.className = 'welcome-popup-slider relative w-full aspect-square bg-[var(--input)] overflow-hidden';
              dialog.insertBefore(slider, copy);
            }
            slider.replaceChildren();
            images.forEach((image, index) => {
              const slide = document.createElement('img');
              slide.src = image.src;
              slide.alt = '';
              slide.className = `welcome-popup-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${index === 0 ? 'opacity-100' : 'opacity-0'}`;
              slide.dataset.index = String(index);
              slider.appendChild(slide);
            });
            if (images.length > 1) {
              const dots = document.createElement('div');
              dots.className = 'absolute bottom-2.5 left-0 right-0 flex items-center justify-center gap-1.5 z-10';
              images.forEach((_, index) => {
                const dot = document.createElement('span');
                dot.className = `welcome-popup-dot w-1.5 h-1.5 rounded-full ${index === 0 ? 'bg-white' : 'bg-white/40'} transition`;
                dot.dataset.index = String(index);
                dots.appendChild(dot);
              });
              slider.appendChild(dots);
              const toggle = document.createElement('button');
              toggle.type = 'button';
              toggle.className = 'welcome-popup-carousel-toggle';
              toggle.dataset.welcomePopupCarouselToggle = '';
              toggle.setAttribute('aria-label', 'หยุดสลับรูปภาพ');
              toggle.innerHTML = '<svg data-carousel-pause viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg><svg data-carousel-play viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m8 5 12 7-12 7z" /></svg>';
              slider.appendChild(toggle);
            }
          }
          modal.dataset.popupId = JSON.stringify({ title, content, images: images.map((image) => image.key) });
        }
      } catch (_) {
        // If local draft storage is unavailable, keep the server-rendered preview usable.
      }
      window.addEventListener('pagehide', () => previewImageUrls.forEach((src) => URL.revokeObjectURL(src)), { once: true });
    }
    const storageKey = (experimentPreview ? 'lilteam_welcome_popup_experiment_mute_' : 'lilteam_welcome_popup_mute_')
      + encodeURIComponent(modal.dataset.popupId).slice(0, 120);
    try {
      const mutedUntil = Number(localStorage.getItem(storageKey) || 0);
      if (Date.now() < mutedUntil) return;
    } catch (e) {}
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    const close = document.getElementById('welcome-popup-close');
    const mute = document.getElementById('welcome-popup-mute');
    const dismissButton = modal.querySelector('[data-welcome-popup-dismiss]');
    const isRedesign = modal.classList.contains('welcome-popup-redesign');
    const previousBodyOverflow = document.body.style.overflow;
    const previousFocus = document.activeElement;
    if (isRedesign) document.body.style.overflow = 'hidden';
    const dismiss = function () {
      modal.remove();
      document.removeEventListener('keydown', handlePopupKeydown);
      if (isRedesign) {
        document.body.style.overflow = previousBodyOverflow;
        if (previousFocus && previousFocus !== document.body && previousFocus.isConnected && typeof previousFocus.focus === 'function') {
          previousFocus.focus({ preventScroll: true });
        }
      }
    };
    const handlePopupKeydown = function (event) {
      if (!modal.isConnected) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        dismiss();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = Array.from(modal.querySelectorAll('button:not([disabled]),a[href],input:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])'))
        .filter(element => element.getClientRects().length);
      if (!focusable.length) {
        event.preventDefault();
        modal.focus();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };
    if (close) close.addEventListener('click', dismiss);
    if (dismissButton) dismissButton.addEventListener('click', dismiss);
    if (mute) mute.addEventListener('click', function () {
      try { localStorage.setItem(storageKey, String(Date.now() + 24 * 60 * 60 * 1000)); } catch (e) {}
      dismiss();
    });
    modal.addEventListener('click', function (e) { if (e.target === modal) dismiss(); });
    if (dismissButton && isRedesign) {
      document.addEventListener('keydown', handlePopupKeydown);
      dismissButton.focus();
    }

    const slides = modal.querySelectorAll('.welcome-popup-slide');
    const dots = modal.querySelectorAll('.welcome-popup-dot');
    if (slides.length > 1) {
      let current = 0;
      const carouselToggle = modal.querySelector('[data-welcome-popup-carousel-toggle]');
      const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let isPlaying = !reducedMotion;
      let pointerInside = false;
      let focusInside = isRedesign && modal.contains(document.activeElement);
      let popupTimer = null;
      const showNextSlide = function () {
        if (!modal.isConnected) { clearInterval(popupTimer); return; }
        if (!isPlaying || pointerInside || focusInside) return;
        slides[current].classList.replace('opacity-100', 'opacity-0');
        if (dots[current]) dots[current].classList.replace('bg-white', 'bg-white/40');
        current = (current + 1) % slides.length;
        slides[current].classList.replace('opacity-0', 'opacity-100');
        if (dots[current]) dots[current].classList.replace('bg-white/40', 'bg-white');
      };
      const syncCarouselToggle = function () {
        if (!carouselToggle) return;
        carouselToggle.setAttribute('aria-label', isPlaying ? 'หยุดสลับรูปภาพ' : 'เล่นสลับรูปภาพ');
        const pauseIcon = carouselToggle.querySelector('[data-carousel-pause]');
        const playIcon = carouselToggle.querySelector('[data-carousel-play]');
        if (pauseIcon) pauseIcon.hidden = !isPlaying;
        if (playIcon) playIcon.hidden = isPlaying;
      };
      const startCarousel = function () {
        if (popupTimer) clearInterval(popupTimer);
        isPlaying = true;
        focusInside = false;
        popupTimer = setInterval(showNextSlide, 3500);
        syncCarouselToggle();
      };
      const pauseCarousel = function () {
        if (popupTimer) clearInterval(popupTimer);
        popupTimer = null;
        isPlaying = false;
        syncCarouselToggle();
      };
      if (isPlaying) popupTimer = setInterval(showNextSlide, 3500);
      syncCarouselToggle();
      if (carouselToggle) {
        carouselToggle.addEventListener('click', function () {
          if (isPlaying) pauseCarousel();
          else startCarousel();
        });
        modal.addEventListener('pointerenter', function () { pointerInside = true; });
        modal.addEventListener('pointerleave', function () { pointerInside = false; });
        modal.addEventListener('focusin', function () { focusInside = true; });
        modal.addEventListener('focusout', function (event) {
          if (!modal.contains(event.relatedTarget)) focusInside = false;
        });
      }
      document.addEventListener('lilteam:page-unloading', function () { if (popupTimer) clearInterval(popupTimer); }, { once: true });
    }
  })();
</script>
<% } %>

<% if (scheduledProducts && scheduledProducts.length) { %>
<section class="event-update w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-5">
  <div class="mb-3">
    <h2 class="text-lg sm:text-xl font-extrabold flex items-center gap-2"><span class="event-clock">◷</span> EVENT UPDATE</h2>
    <p class="text-xs text-[var(--text-4)] mt-1">สินค้าใหม่กำลังจะเปิดขาย เตรียมตัวให้พร้อม!</p>
  </div>
  <div class="grid lg:grid-cols-2 gap-3">
    <% scheduledProducts.forEach(product => { %>
      <article class="event-card" data-event-start="<%= product.publishAt %>">
