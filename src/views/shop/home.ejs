  .mg-prize-chip {
    display: flex; align-items: center; gap: .75rem;
    padding: .65rem .85rem;
    border-radius: .8rem;
    border: 1px solid var(--border-light);
    background: var(--input);
    transition: border-color .2s, transform .2s;
  }
  .mg-prize-chip:hover { transform: translateY(-1px); }
  .mg-prize-image-link {
