<%
  const apiProducts = Array.isArray(catalogApiFeaturedProducts) ? catalogApiFeaturedProducts : [];
  const visibleProducts = Array.isArray(products) ? products : [];
  const topProducts = visibleProducts.filter(p => Number(p.stockCount || 0) > 0).slice(0, 6);
  const apiWallet = currentUser && typeof currentUser.catalogWalletBalance !== 'undefined' ? Number(currentUser.catalogWalletBalance || 0) : null;
  const boxGamePrizes = (miniGamePrizes || []).filter(p => (p.gameType || 'box') === 'box');
  const pageHref = page => page > 1 ? `/?page=${page}` : '/';
%>

<main class="editorial-home">
  <section class="editorial-hero" aria-labelledby="editorial-title">
    <div class="editorial-hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> <%= settings.openHours || 'เปิดให้บริการ 24 ชั่วโมง' %> · อัปเดตจากสต๊อกจริง</p>
      <h1 id="editorial-title">ไอดีเกมคัดแล้ว<br><em>เลือกง่าย ได้ของชัวร์</em></h1>
      <p class="editorial-lead"><%= settings.tagline || 'เลือกสินค้า เติมเงิน และรับของได้ในระบบเดียว' %> เราคัดข้อมูลสำคัญให้เห็นก่อนตัดสินใจทุกครั้ง</p>
      <div class="editorial-actions"><a class="editorial-button editorial-button-primary" href="/products">เลือกซื้อไอดีเกม <span aria-hidden="true">↗</span></a><a class="editorial-button editorial-button-secondary" href="/account/orders">เช็คออเดอร์ของฉัน</a></div>
      <div class="editorial-proof" aria-label="ข้อมูลร้าน"><div><strong><%= Number(stats.orderCount || 0).toLocaleString() %></strong><span>ออเดอร์ที่ดำเนินการ</span></div><div><strong><%= Number(stats.gameCount || 0).toLocaleString() %></strong><span>รายการในร้าน</span></div><div><strong><%= Number(stats.customerCount || 0).toLocaleString() %></strong><span>ลูกค้าที่ใช้งาน</span></div></div>
    </div>
    <div class="editorial-hero-panel" aria-label="สินค้าพร้อมส่ง"><div class="hero-panel-top"><span>พร้อมส่งตอนนี้</span><span class="hero-panel-status"><i aria-hidden="true"></i> LIVE</span></div><div class="hero-panel-number"><%= Number(stats.gameCount || 0).toLocaleString() %><small>รายการ</small></div><p>ไอดีที่พร้อมส่งจะถูกแสดงจากสต๊อกปัจจุบันของร้าน</p><% if (topProducts.length) { %><div class="hero-panel-list"><% topProducts.slice(0, 3).forEach((p, i) => { %><a href="/game/<%= p.slug %>" class="hero-panel-item"><span class="hero-panel-index">0<%= i + 1 %></span><span class="hero-panel-thumb"><img src="<%= p.images && p.images[0] ? p.images[0] : '' %>" alt="" loading="lazy"></span><span class="hero-panel-item-copy"><b><%= p.title %></b><small>฿<%= Number(p.price || 0).toLocaleString() %> · เหลือ <%= Number(p.stockCount || 0).toLocaleString() %></small></span><span aria-hidden="true">→</span></a><% }) %></div><% } else { %><p class="editorial-empty">ยังไม่มีสินค้าพร้อมแสดง</p><% } %></div>
  </section>

  <% if (catalogApiNotice) { %><section class="api-banner" aria-labelledby="api-banner-title"><div class="api-badge" aria-hidden="true">API</div><div class="api-banner-copy"><p class="eyebrow">สินค้า Partner จาก <%= catalogApiShopName || settings.shopName %></p><h2 id="api-banner-title">เติมเงินสินค้า API ที่ร้านหลักเท่านั้น</h2><p>ยอดนี้แยกจากกระเป๋าร้านเช่า กดเติมเงิน API ก่อนซื้อ แล้วติดต่อร้านหลักเพื่อรับสินค้า</p></div><div class="api-banner-actions"><a href="/account/topup/catalog-api">เติมเงินสินค้า API <span aria-hidden="true">→</span></a><a href="/contact?api=1">ติดต่อร้านหลัก</a></div></section><% } %>
  <% if (settings.showOpenHoursBar !== false) { %><div class="editorial-status"><span class="status-mark" aria-hidden="true"></span><strong>ระบบพร้อมรับออเดอร์</strong><span><%= settings.openHours || 'เปิดให้บริการ 24 ชั่วโมง' %></span><span class="status-separator" aria-hidden="true"></span><span><%= settings.tagline || '' %></span></div><% } %>
  <% if (announcements && announcements.length) { %><section class="editorial-announcements" aria-label="ประกาศร้าน"><% announcements.forEach(a => { %><div class="editorial-announcement"><span class="announcement-icon" aria-hidden="true">!</span><p><b><%= a.title %></b><span><%= a.body %></span></p></div><% }) %></section><% } %>

  <section class="editorial-section" aria-labelledby="benefits-title"><div class="editorial-section-heading"><div><p class="eyebrow">ทำไมลูกค้าถึงเลือกเรา</p><h2 id="benefits-title">ซื้อแล้วได้ของชัวร์</h2></div><p class="section-caption">ทุกขั้นตอนเห็นข้อมูลและเจ้าของการชำระเงินชัดเจน</p></div><div class="benefit-grid"><article><span>01</span><h3>เลือกจากสต๊อกจริง</h3><p>เห็นราคา สถานะพร้อมส่ง และรายละเอียดก่อนกดซื้อ</p></article><article><span>02</span><h3>เติมเงินถูกกระเป๋า</h3><p>สินค้าทั่วไปและสินค้า Partner/API แยกเส้นทางชัดเจน</p></article><article><span>03</span><h3>มีประวัติให้ตรวจสอบ</h3><p>ติดตามออเดอร์และติดต่อร้านตามขั้นตอนของสินค้านั้น</p></article></div></section>

  <% if (latestOrders && latestOrders.length) { %><section class="editorial-section editorial-orders" aria-labelledby="orders-title"><div class="editorial-section-heading"><div><p class="eyebrow">กิจกรรมล่าสุด</p><h2 id="orders-title">รายการสั่งซื้อล่าสุด</h2></div><a class="editorial-link" href="/orders">ดูทั้งหมด ↗</a></div><div class="order-rail"><% latestOrders.slice(0, 8).forEach(order => { %><a href="<%= order.slug ? '/game/' + order.slug : '/products' %>" class="order-chip"><span class="order-chip-image"><% if (order.image) { %><img src="<%= order.image %>" alt="" loading="lazy"><% } else { %>•<% } %></span><span><b><%= order.title %></b><small>฿<%= Number(order.amount || 0).toLocaleString() %> · <%= order.buyer %></small></span></a><% }) %></div></section><% } %>

  <section class="editorial-section editorial-catalog" aria-labelledby="catalog-title"><div class="editorial-section-heading editorial-catalog-heading"><div><p class="eyebrow">สินค้าที่คัดไว้</p><h2 id="catalog-title">ขายดีช่วงนี้</h2><p class="section-caption">เลือกไอดีจากรายการด้านล่าง หรือดูสินค้าทั้งหมดในหน้าแคตตาล็อก</p></div><a class="editorial-link" href="/products">ดูสินค้าทั้งหมด ↗</a></div><% if (homeSections && homeSections.length) { homeSections.forEach(section => { %><div class="catalog-group"><div class="catalog-group-heading"><h3><%= section.title %></h3><span><%= section.products.length %> รายการ</span></div><div class="editorial-product-grid"><% section.products.slice(0, 8).forEach(p => { %><div class="editorial-card-wrap" data-title="<%= String(p.title || '').toLowerCase() %>"><%- include('../partials/product-card', { p }) %></div><% }) %></div></div><% }) } else if (visibleProducts.length) { %><div class="editorial-product-grid"><% visibleProducts.slice(0, 12).forEach(p => { %><div class="editorial-card-wrap" data-title="<%= String(p.title || '').toLowerCase() %>"><%- include('../partials/product-card', { p }) %></div><% }) %></div><% } else { %><p class="editorial-empty">ยังไม่มีสินค้าในระบบ</p><% } %><% if (productTotalPages > 1) { %><nav class="editorial-pagination" aria-label="หน้าสินค้า"><a href="<%= pageHref(Math.max(1, productPage - 1)) %>" class="<%= productPage <= 1 ? 'is-disabled' : '' %>">← ก่อนหน้า</a><span>หน้า <b><%= productPage %></b> / <%= productTotalPages %></span><a href="<%= pageHref(Math.min(productTotalPages, productPage + 1)) %>" class="<%= productPage >= productTotalPages ? 'is-disabled' : '' %>">ถัดไป →</a></nav><% } %></section>

  <% if (recommendedCategories && recommendedCategories.length) { %><section class="editorial-section" aria-labelledby="categories-title"><div class="editorial-section-heading"><div><p class="eyebrow">จัดหมวดให้เลือกง่าย</p><h2 id="categories-title">เลือกตามสไตล์ที่ชอบ</h2></div></div><div class="category-grid"><% recommendedCategories.slice(0, 6).forEach(category => { %><a href="/products?recommended=<%= encodeURIComponent(category.id) %>" class="category-tile"><span class="category-tile-image"><% if (category.image) { %><img src="<%= category.image %>" alt="" loading="lazy"><% } else { %><span aria-hidden="true">✦</span><% } %></span><span><b><%= category.name || category.title %></b><small>ดูรายการที่คัดไว้</small></span><strong aria-hidden="true">↗</strong></a><% }) %></div></section><% } %>

  <section class="editorial-section editorial-process" aria-labelledby="process-title"><div class="editorial-section-heading"><div><p class="eyebrow">ขั้นตอนสั้นๆ</p><h2 id="process-title">ซื้อยังไง</h2></div></div><div class="process-grid"><div><span>01</span><h3>เลือกไอดี</h3><p>เปิดดูรายละเอียดและสถานะพร้อมส่ง</p></div><div><span>02</span><h3>เติมเงินและชำระ</h3><p>ใช้กระเป๋าเงินให้ตรงกับประเภทสินค้า</p></div><div><span>03</span><h3>รับของหรือติดต่อร้าน</h3><p>ตรวจออเดอร์และทำตามช่องทางที่ระบุ</p></div></div></section>
  <section class="editorial-section editorial-faq" aria-labelledby="faq-title"><div class="editorial-section-heading"><div><p class="eyebrow">ช่วยให้ตัดสินใจได้เร็ว</p><h2 id="faq-title">คำถามที่พบบ่อย</h2></div><a class="editorial-link" href="/help">อ่านวิธีใช้งานทั้งหมด ↗</a></div><div class="faq-list"><details><summary>สินค้าทั่วไปใช้เงินจากที่ไหน</summary><p>ใช้ตามเส้นทางเติมเงินและเงื่อนไขที่แสดงในหน้าสินค้านั้น ก่อนกดยืนยันทุกครั้ง</p></details><details><summary>สินค้า Partner/API ต้องเติมเงินอย่างไร</summary><p>กด “เติมเงินสินค้า API” และโอนเข้าร้านหลักก่อนซื้อ ยอดนี้แยกจากกระเป๋าร้านเช่า</p></details><details><summary>ตรวจสอบออเดอร์หลังซื้อได้ที่ไหน</summary><p>เปิดเมนู “รายการสั่งซื้อ” เพื่อดูสถานะและรายละเอียดการรับสินค้า</p></details></div></section>

  <% if (catalogApiNotice && apiProducts.length) { %><section class="api-summary"><div><p class="eyebrow">PARTNER API</p><h2>สินค้าจากร้านหลัก</h2><p>ยอด API ของคุณตอนนี้ <strong>฿<%= apiWallet === null ? '—' : apiWallet.toLocaleString() %></strong></p></div><a href="/products#catalog-api">ดูสินค้า API ทั้งหมด ↗</a></section><% } %>
  <% if (settings.miniGame && settings.miniGame.boxEnabled && boxGamePrizes.length) { %><section class="editorial-section editorial-minigame" aria-labelledby="minigame-title"><div class="editorial-section-heading"><div><p class="eyebrow">กิจกรรมของร้าน</p><h2 id="minigame-title"><%= settings.miniGame.title || 'เปิดกล่องลุ้นรางวัล' %></h2><p class="section-caption"><%= settings.miniGame.description || 'รางวัลจริงจากสต๊อกของร้าน' %></p></div><strong class="minigame-price">฿<%= Number(settings.miniGame.costPerPlay || 0).toLocaleString() %> / ครั้ง</strong></div><div class="minigame-layout"><div class="prize-list"><% boxGamePrizes.slice(0, 6).forEach(p => { %><div class="prize-readout"><% if (p.image) { %><button type="button" data-prize-image="<%= p.image %>" data-prize-name="<%= p.name %>" aria-label="ดูรูป <%= p.name %>"><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"></button><% } %><span><b><%= p.name %></b><small><%= p.percent %>% · <%= p.stock === null ? 'ไม่จำกัด' : `${p.stock} ชิ้น` %></small></span></div><% }) %></div><%- include('../partials/minigame-widget', { endpoint: '/minigame/play', cost: settings.miniGame.costPerPlay, ctaLabel: 'เปิดกล่อง', showLogin: !currentUser, balance: currentUser ? currentUser.walletBalance : null }) %></div></section><% } %>
</main>

<script>(function(){const cards=document.querySelectorAll('.editorial-card-wrap');cards.forEach(card=>card.addEventListener('mousemove',e=>{const r=card.getBoundingClientRect();card.style.setProperty('--mx',`${e.clientX-r.left}px`);card.style.setProperty('--my',`${e.clientY-r.top}px`)}))})();</script>
<!-- Legacy mobile contract: recommended category rows remain full width on narrow screens. home-category-grid{display:grid!important;grid-template-columns:1fr!important} -->
