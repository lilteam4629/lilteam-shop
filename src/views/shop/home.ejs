<% if (settings.hero.mode === 'banner' && settings.hero.bannerImage) { %>
  <section class="border-b border-[var(--border)]">
    <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6">
      <% if (settings.hero.bannerLink) { %>
        <a href="<%= settings.hero.bannerLink %>"
          class="group block rounded-2xl overflow-hidden border border-[var(--border)] shadow-[0_0_40px_-14px_rgba(200,166,63,0.35)]
                 transition-all duration-300 hover:border-[var(--gold)]/60 hover:shadow-[0_0_50px_-10px_rgba(200,166,63,0.5)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>"
            class="w-full object-cover transition duration-500 group-hover:scale-[1.02] group-hover:brightness-105" />
        </a>
      <% } else { %>
        <div class="rounded-2xl overflow-hidden border border-[var(--border)] shadow-[0_0_40px_-14px_rgba(200,166,63,0.35)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>" class="w-full object-cover" />
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
<section class="border-b border-[var(--border)] overflow-hidden">
  <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-10 pb-6 text-center">
    <p class="text-[var(--gold)] text-xs sm:text-sm mb-2 px-2 flex flex-wrap items-center justify-center gap-1.5">
      <span>🎮</span><%= stats.gameCount %> เกม — พร้อมส่งทันทีหลังชำระเงิน
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
      <span class="bg-gradient-to-r from-[var(--gold)] via-[var(--text)] to-[var(--gold)] bg-clip-text text-transparent"><%= settings.shopName %></span>
    </h1>
    <p class="text-[var(--text-3)] max-w-xl mx-auto"><%= settings.tagline %></p>
  </div>

  <% if (newest.length) { %>
  <!-- Compact 3-card fan for mobile -->
  <div class="sm:hidden relative w-[92vw] max-w-[420px] mx-auto mb-6" style="height: clamp(210px, 62vw, 270px);">
    <%
      const mobileNewest = newest.slice(0,3);
      const mobileLayouts = {
        1: [{ left: '50%', width: '48%', y: '0vw', rotate: 0 }],
        2: [
          { left: '34%', width: '43%', y: '4vw', rotate: -5 },
          { left: '66%', width: '43%', y: '4vw', rotate: 5 },
        ],
        3: [
          { left: '22%', width: '36%', y: '8vw', rotate: -7 },
          { left: '50%', width: '48%', y: '0vw', rotate: 0 },
          { left: '78%', width: '36%', y: '8vw', rotate: 7 },
        ],
      };
      const mobileLayout = mobileLayouts[mobileNewest.length];
    %>
    <% mobileNewest.forEach((p, i) => { const layout = mobileLayout[i]; %>
      <div class="absolute top-0 aspect-[3/4]"
        style="left:<%= layout.left %>; width:<%= layout.width %>; transform:translateX(-50%) translateY(<%= layout.y %>) rotate(<%= layout.rotate %>deg); z-index:<%= 10 - Math.abs((mobileNewest.length - 1) / 2 - i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>

  <!-- Full 5-card fan for tablet/desktop -->
  <div class="hidden sm:block relative max-w-6xl mx-auto mb-6" style="height: clamp(275px, 40vw, 385px);">
    <%
      const rot = [-10, -5, 0, 5, 10];
      const tx = ['-40%', '-20%', '0%', '20%', '40%'];
      const ty = [58, 24, 0, 24, 58];
      const widths = ['clamp(150px,18vw,200px)', 'clamp(172px,21vw,230px)', 'clamp(198px,24vw,265px)', 'clamp(172px,21vw,230px)', 'clamp(150px,18vw,200px)'];
    %>
    <% newest.slice(0,5).forEach((p, i) => { %>
      <div class="absolute top-0 left-1/2 aspect-[3/4] hover:z-30"
        style="width: <%= widths[i] %>; margin-left: calc(<%= tx[i] %> - <%= widths[i] %> / 2); transform: translateY(<%= ty[i] %>px) rotate(<%= rot[i] %>deg); z-index: <%= 10 - Math.abs(2-i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>
  <% } %>
</section>
<% } %>

<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6">
  <div class="flex items-center gap-2 bg-[var(--card)] border border-[var(--border)] rounded-xl px-4 py-2.5 text-sm text-[var(--text-2)] overflow-hidden">
    <span class="relative flex h-2.5 w-2.5 shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
    </span>
    <div class="flex-1 relative h-5 overflow-hidden">
      <span class="marquee-track flex items-center gap-2">🕐 <%= settings.openHours %> &nbsp;&nbsp;•&nbsp;&nbsp; <%= settings.tagline %></span>
    </div>
    <span class="text-emerald-400 text-xs shrink-0 ml-2">เปิดให้บริการ</span>
  </div>
</section>

<% if (announcements.length) { %>
<div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-2">
  <% announcements.forEach(a => { %>
    <div class="bg-[var(--gold)]/10 border border-[var(--gold)]/40 text-[var(--gold-hover)] text-sm rounded-lg px-4 py-3 mb-2">
      <b>📢 <%= a.title %></b> — <%= a.body %>
    </div>
  <% }) %>
</div>
<% } %>

<% if (scheduledProducts && scheduledProducts.length) { %>
<section class="event-update w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-5">
  <div class="mb-3">
    <h2 class="text-lg sm:text-xl font-extrabold flex items-center gap-2"><span class="event-clock">◷</span> EVENT UPDATE</h2>
    <p class="text-xs text-[var(--text-4)] mt-1">สินค้าใหม่กำลังจะเปิดขาย เตรียมตัวให้พร้อม!</p>
  </div>
  <div class="grid lg:grid-cols-2 gap-3">
    <% scheduledProducts.forEach(product => { %>
      <article class="event-card" data-event-start="<%= product.publishAt %>">
        <div class="event-image-wrap"><img src="<%= product.images[0] %>" alt="<%= product.title %>" class="event-image" /></div>
        <div class="event-copy min-w-0 flex-1">
          <span class="event-badge">⏱ <%= product.eventBadge || 'COMING SOON' %></span>
          <h3 class="event-title"><%= product.title %></h3>
          <p class="event-description"><%= product.eventDescription || 'เปิดขายอัตโนมัติเมื่อหมดเวลานับถอยหลัง' %></p>
        </div>
        <div class="event-countdown-wrap">
          <span>เหลือเวลา</span>
          <strong class="event-countdown">--:--:--</strong>
        </div>
        <button type="button" class="event-arrow" aria-label="ยังไม่ถึงเวลาเปิดขาย" disabled>›</button>
      </article>
    <% }) %>
  </div>
</section>

<style>
  .event-clock{display:grid;place-items:center;width:1.35rem;height:1.35rem;border-radius:99px;background:linear-gradient(145deg,#e5c65f,#9a721b);color:#171207;font-size:.8rem;box-shadow:0 0 14px rgba(200,166,63,.4)}
  .event-card{position:relative;display:flex;align-items:center;gap:1rem;min-width:0;padding:.8rem 1rem;border-radius:1rem;border:1px solid rgba(200,166,63,.38);border-top:2px solid var(--gold);background:linear-gradient(110deg,var(--card),var(--input));box-shadow:0 12px 30px -24px rgba(200,166,63,.85);overflow:hidden}
  .event-card:before{content:'';position:absolute;inset:auto -3rem -4rem auto;width:10rem;height:10rem;border-radius:99px;background:rgba(200,166,63,.08);filter:blur(10px)}
  .event-image-wrap{width:5rem;height:5.5rem;flex:0 0 auto;display:grid;place-items:center}.event-image{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 10px rgba(0,0,0,.25))}
  .event-badge{display:inline-flex;padding:.2rem .55rem;border-radius:99px;background:linear-gradient(135deg,#dfbd4e,#9d751c);color:#171207;font-size:.58rem;font-weight:800;box-shadow:inset 0 1px 0 rgba(255,255,255,.35)}.event-title{font-size:.95rem;font-weight:800;line-height:1.25;margin-top:.35rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-description{font-size:.7rem;color:var(--text-4);margin-top:.2rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .event-countdown-wrap{width:9.5rem;flex:0 0 auto;text-align:center;padding:.55rem .7rem;border-radius:.8rem;border:1px solid rgba(200,166,63,.5);background:rgba(200,166,63,.09)}.event-countdown-wrap span{display:block;color:var(--text-4);font-size:.58rem}.event-countdown{display:block;color:var(--gold);font-size:1.25rem;line-height:1.25;font-variant-numeric:tabular-nums;text-shadow:0 0 14px rgba(200,166,63,.25)}
  .event-arrow{position:relative;width:2.35rem;height:2.35rem;flex:0 0 auto;border-radius:.7rem;background:linear-gradient(145deg,#dfbd4e,#98701b);color:#171207;font-size:1.7rem;font-weight:800;box-shadow:0 8px 16px -8px rgba(200,166,63,.9),inset 0 1px 0 rgba(255,255,255,.35);opacity:.9}
  @media(max-width:639px){.event-card{display:grid;grid-template-columns:3.75rem minmax(0,1fr) auto;gap:.65rem;padding:.7rem}.event-image-wrap{width:3.75rem;height:4.5rem;grid-row:1 / span 2}.event-countdown-wrap{grid-column:2;width:100%;padding:.4rem .55rem;text-align:left;display:flex;align-items:center;justify-content:space-between}.event-countdown{font-size:1rem}.event-arrow{grid-column:3;grid-row:1 / span 2;align-self:center;width:2rem;height:2rem;font-size:1.35rem}.event-title{font-size:.82rem}.event-description{font-size:.62rem}}
</style>
<script>
  (function(){
    const cards=document.querySelectorAll('[data-event-start]');
    if(!cards.length)return;
    function timeOf(value){return Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(value)?value:value+':00+07:00');}
    function update(){let expired=false;cards.forEach(card=>{const left=timeOf(card.dataset.eventStart)-Date.now();if(left<=0){expired=true;return;}const total=Math.floor(left/1000),days=Math.floor(total/86400),hours=Math.floor(total%86400/3600),minutes=Math.floor(total%3600/60),seconds=total%60;card.querySelector('.event-countdown').textContent=(days?days+' วัน ':'')+[hours,minutes,seconds].map(n=>String(n).padStart(2,'0')).join(':');});if(expired)location.reload();}
    update();setInterval(update,1000);
  })();
</script>
<% } %>

<% if (latestOrders && latestOrders.length) { %>
<section class="latest-orders-section w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-5">
  <div class="flex items-end justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg sm:text-xl font-bold flex items-center gap-2"><span class="latest-orders-live"></span>รายการสั่งซื้อล่าสุด</h2>
      <p class="text-[10px] sm:text-xs text-[var(--text-4)] mt-0.5">อัปเดตคำสั่งซื้อจากลูกค้าของร้าน</p>
    </div>
    <span class="text-[10px] text-emerald-400 border border-emerald-400/25 bg-emerald-400/10 rounded-full px-2.5 py-1">LIVE</span>
  </div>
  <div class="latest-orders-shell">
    <div class="latest-orders-track">
      <% for (let duplicate = 0; duplicate < 2; duplicate++) { %>
        <div class="latest-orders-group" <%- duplicate ? 'aria-hidden="true"' : '' %>>
          <% latestOrders.forEach(order => { %>
            <a href="<%= order.slug ? '/game/' + order.slug : '/products' %>" class="latest-order-card">
              <span class="latest-order-image-wrap">
                <% if (order.image) { %><img src="<%= order.image %>" alt="<%= order.title %>" class="latest-order-image" /><% } else { %><span>🎮</span><% } %>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs sm:text-sm font-semibold truncate text-[var(--text)]"><%= order.title %><%= order.extraItems ? ' +' + order.extraItems + ' รายการ' : '' %></span>
                <span class="block text-xs sm:text-sm font-bold text-[var(--gold)] mt-1">฿<%= order.amount.toLocaleString() %>.00</span>
                <span class="flex items-center gap-1 text-[9px] sm:text-[10px] text-[var(--text-4)] mt-1 truncate">
                  <span>◷</span><%= new Date(order.createdAt).toLocaleString('th-TH', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' }) %> <span>•</span> <%= order.buyer %>
                </span>
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<style>
  .latest-orders-live { width: .55rem; height: .55rem; border-radius: 999px; background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.1), 0 0 14px rgba(52,211,153,.7); }
  .latest-orders-shell {
    overflow: hidden; padding: .75rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--card) 96%, transparent), color-mix(in srgb, var(--input) 90%, transparent));
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
  }
  .latest-orders-track { display: flex; width: max-content; gap: .75rem; animation: latest-orders-scroll 28s linear infinite; will-change: transform; }
  .latest-orders-shell:active .latest-orders-track { animation-play-state: paused; }
  .latest-orders-group { display: flex; gap: .75rem; }
  .latest-order-card {
    width: 20rem; min-height: 5.5rem; flex: 0 0 auto;
    display: flex; align-items: center; gap: .8rem;
    padding: .65rem .75rem;
    border-radius: .85rem;
    border: 1px solid var(--border-light);
    background: color-mix(in srgb, var(--bg) 48%, var(--card));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    transition: border-color .2s, transform .2s, background .2s;
  }
  .latest-order-card:hover { border-color: rgba(200,166,63,.65); transform: translateY(-1px); background: var(--input); }
  .latest-order-image-wrap {
    width: 3.6rem; height: 4.25rem; flex: 0 0 auto;
    display: grid; place-items: center; overflow: hidden;
    border-radius: .65rem; background: var(--input);
  }
  .latest-order-image { width: 100%; height: 100%; object-fit: contain; }
  @keyframes latest-orders-scroll { to { transform: translateX(calc(-50% - .375rem)); } }
  @media (max-width: 639px) {
    .latest-orders-section { padding-top: 1rem; }
    .latest-orders-shell { padding: .55rem; border-radius: .85rem; }
    .latest-orders-track, .latest-orders-group { gap: .55rem; }
    .latest-orders-track { animation-duration: 24s; }
    .latest-order-card { width: 15.5rem; min-height: 4.75rem; padding: .5rem .6rem; gap: .6rem; border-radius: .75rem; }
    .latest-order-image-wrap { width: 3rem; height: 3.65rem; border-radius: .55rem; }
    @keyframes latest-orders-scroll { to { transform: translateX(calc(-50% - .275rem)); } }
  }
</style>
<% } %>

<% if (filterTags && filterTags.length) { %>
<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-4">
  <%- include('../partials/filter-panel', { filterTags }) %>
</section>
<% } %>

<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-8">
  <h2 class="text-xl font-semibold mb-4 flex items-center gap-1.5"><span>✨</span>เกมมาใหม่</h2>
  <div class="product-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 2xl:grid-cols-5 gap-4 mb-10">
    <% newest.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %>
  </div>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-semibold">สินค้าเกมทั้งหมด</h2>
    <a href="/products" class="text-sm text-[var(--gold)]">เปิดหน้ารวม →</a>
  </div>
  <div class="product-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
    <% products.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %>
  </div>
  <p class="text-center text-[var(--text-4)] text-xs mt-6">แสดง <%= products.length %> จาก <%= productTotal %> รายการ</p>
</section>

<% if (settings.miniGame && settings.miniGame.enabled && miniGamePrizes.length) { %>
<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-10">
  <div class="mg-panel relative overflow-hidden rounded-2xl border border-[var(--gold)]/40 p-6 sm:p-10">
    <div class="mg-sparkle-field absolute inset-0 pointer-events-none overflow-hidden">
      <% for (let i = 0; i < 14; i++) { %>
        <span class="mg-sparkle" style="top:<%= Math.round(Math.random()*100) %>%; left:<%= Math.round(Math.random()*100) %>%; animation-delay:<%= (Math.random()*4).toFixed(2) %>s;"></span>
      <% } %>
    </div>

    <div class="mg-heading relative mb-8">
      <div class="mg-heading-copy">
        <div class="mg-heading-icon" aria-hidden="true">🎁</div>
        <div class="min-w-0">
          <p class="mg-kicker">🎰 มินิเกมลุ้นรางวัล</p>
          <h2 class="mg-title"><%= settings.miniGame.title || 'เปิดกล่องลุ้นรางวัล' %></h2>
          <p class="mg-description"><%= settings.miniGame.description || 'เปิดกล่องเพื่อลุ้นรับรางวัลจากสต๊อกจริงของร้าน' %></p>
        </div>
      </div>
      <div class="mg-highlights" aria-label="จุดเด่นของมินิเกม">
        <span><b>✓</b> รางวัลจริง</span>
        <span><b>100%</b> โปร่งใส</span>
        <span><b>⚡</b> รู้ผลทันที</span>
      </div>
      <div class="mg-price">
        <div class="mg-price-label">เริ่มลุ้นเพียง</div>
        <div class="mg-price-value">฿<%= settings.miniGame.costPerPlay.toLocaleString() %></div>
        <div class="mg-price-suffix">ต่อครั้ง</div>
      </div>
    </div>

    <div class="relative grid lg:grid-cols-[1fr_360px] gap-8 items-start">
      <div>
        <h3 class="text-sm font-semibold text-[var(--text-2)] mb-3 flex items-center gap-1.5">📋 อัตราการออกรางวัลทั้งหมด (เปิดเผย 100% โปร่งใส)</h3>
        <div class="grid sm:grid-cols-2 gap-3">
          <% miniGamePrizes.forEach(p => {
               const tier = !p.isPrize ? 'none' : p.percent <= 5 ? 'legendary' : p.percent <= 15 ? 'rare' : 'common';
               const tierIcon = { legendary: '💎', rare: '🌟', common: '🎁', none: '💨' }[tier];
               const tierLabel = { legendary: 'ตำนาน', rare: 'หายาก', common: 'ทั่วไป', none: 'เสียใจด้วย' }[tier];
               const outOfStock = p.stock !== null && p.stock <= 0;
          %>
            <div class="mg-prize-chip mg-tier-<%= tier %> <%= outOfStock ? 'opacity-50' : '' %>">
              <% if (p.image) { %>
                <a href="<%= p.image %>" target="_blank" rel="noopener" class="mg-prize-image-link" title="กดเพื่อดูรูป <%= p.name %> ขนาดเต็ม" aria-label="ดูรูป <%= p.name %> ขนาดเต็ม">
                  <img src="<%= p.image %>" alt="<%= p.name %>" class="mg-prize-image" />
                  <span class="mg-prize-zoom" aria-hidden="true">⌕</span>
                </a>
              <% } else { %>
                <div class="text-2xl leading-none"><%= tierIcon %></div>
              <% } %>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold truncate"><%= p.name %></div>
                <div class="text-[10px] text-[var(--text-4)]"><%= tierLabel %> · <%= outOfStock ? 'หมดชั่วคราว' : (p.stock === null ? 'ไม่จำกัด' : p.stock + ' ชิ้นคงเหลือ') %></div>
              </div>
              <div class="text-lg font-bold shrink-0"><%= p.percent %>%</div>
            </div>
          <% }) %>
        </div>
        <p class="text-[10px] text-[var(--text-4)] mt-3">* นี่คืออัตราจริงที่ระบบใช้สุ่ม ตรวจสอบได้ทุกครั้งก่อนเล่น รางวัลที่หมดสต็อกจะถูกงดจ่ายชั่วคราวจนกว่าจะเติมสต็อก · ถูกรางวัลแล้วให้ทักแชท "ติดต่อร้าน" พร้อมแจ้งโค้ดที่ได้รับเพื่อขอรับของ</p>
      </div>

      <%- include('../partials/minigame-widget', {
        endpoint: '/minigame/play',
        cost: settings.miniGame.costPerPlay,
        ctaLabel: '🎲 เปิดกล่อง',
        showLogin: !currentUser,
        balance: currentUser ? currentUser.walletBalance : null,
      }) %>
    </div>
  </div>
</section>

<style>
  .mg-panel {
    background:
      radial-gradient(circle at 15% 15%, rgba(200,166,63,.20), transparent 55%),
      radial-gradient(circle at 85% 85%, rgba(200,166,63,.14), transparent 50%),
      linear-gradient(150deg, rgba(0,0,0,0), rgba(0,0,0,.25)), var(--card);
    box-shadow: 0 0 0 1px rgba(200,166,63,.08), 0 20px 50px -20px rgba(0,0,0,.6);
  }
  .mg-heading {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto auto;
