    padding: .45rem .65rem;
    border-radius: 999px;
    border: 1px solid var(--border-light);
    background: color-mix(in srgb, var(--bg) 35%, transparent);
    color: var(--text-3); font-size: .68rem; white-space: nowrap;
  }
  .mg-highlights b { color: var(--gold); font-weight: 800; }
  .mg-price {
    min-width: 8.5rem;
    text-align: center;
    padding: .7rem 1rem;
    border-radius: 1rem;
    background: linear-gradient(145deg, var(--gold-light), var(--gold-dark));
