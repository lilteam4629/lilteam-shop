  }
  .mg-price-label { color: rgba(23,18,7,.68); font-size: .62rem; font-weight: 600; }
  .mg-price-value { color: #171207; font-size: 2rem; line-height: 1; font-weight: 900; }
  .mg-price-suffix { color: rgba(23,18,7,.62); font-size: .58rem; margin-top: .15rem; }
  @media (max-width: 1023px) {
    .mg-heading { grid-template-columns: 1fr auto; }
    .mg-highlights { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (max-width: 639px) {
    .mg-panel { padding: 1rem; }
