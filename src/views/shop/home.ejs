    .mg-heading-copy { gap: .65rem; }
    .mg-heading-icon { width: 3rem; height: 3rem; border-radius: .8rem; font-size: 1.4rem; }
    .mg-description { font-size: .7rem; }
    .mg-highlights { gap: .35rem; overflow-x: auto; padding-bottom: .1rem; }
    .mg-highlights span { padding: .35rem .5rem; font-size: .6rem; }
    .mg-price { min-width: 5.25rem; padding: .55rem .6rem; border-radius: .8rem; }
