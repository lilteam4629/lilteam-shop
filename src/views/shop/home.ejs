  .mg-prize-image-link:hover { border-color: var(--gold); }
  .mg-prize-image-link:hover .mg-prize-zoom { opacity: 1; }
  .mg-tier-legendary { border-color: color-mix(in srgb, var(--gold) 55%, transparent); box-shadow: 0 0 16px -6px color-mix(in srgb, var(--gold) 60%, transparent); }
  .mg-tier-legendary .text-lg { color: var(--gold); }
  .mg-tier-rare { border-color: rgba(147,140,255,.4); }
  .mg-tier-rare .text-lg { color: #a89aff; }
  .mg-tier-common .text-lg { color: var(--text-2); }
  .mg-tier-none { opacity: .75; }
  .mg-tier-none .text-lg { color: var(--text-4); }

  @media (prefers-reduced-motion: reduce) {
    .mg-sparkle { animation: none; }
  }
</style>
<% } %>

