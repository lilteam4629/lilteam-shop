<% if (typeof heroPreviewV2 !== 'undefined' && heroPreviewV2) { %>
  <%- include('../partials/locker-hero', { newest, stats, settings, filterTags, publicPreview: typeof publicPreview !== 'undefined' ? publicPreview : false }) %>
<% } else if (settings.hero.mode === 'banner' && settings.hero.bannerImage) { %>
  <section class="border-b border-[var(--border)]">
    <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6">
      <% if (settings.hero.bannerLink) { %>
        <a href="<%= settings.hero.bannerLink %>"
          class="group block rounded-2xl overflow-hidden border border-[var(--border)] shadow-[0_0_40px_-14px_color-mix(in_srgb,var(--gold)_35%,transparent)]
                 transition-all duration-300 hover:border-[var(--gold)]/60 hover:shadow-[0_0_50px_-10px_color-mix(in_srgb,var(--gold)_50%,transparent)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>"
            class="w-full object-cover transition duration-500 group-hover:scale-[1.02] group-hover:brightness-105" />
        </a>
      <% } else { %>
        <div class="rounded-2xl overflow-hidden border border-[var(--border)] shadow-[0_0_40px_-14px_color-mix(in_srgb,var(--gold)_35%,transparent)]">
          <img src="<%= settings.hero.bannerImage %>" alt="<%= settings.shopName %>" class="w-full object-cover" />
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
<section class="modern-fan-hero border-b border-[var(--border)] overflow-hidden">
  <div class="modern-fan-heading w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-10 pb-6 text-center">
    <p class="text-[var(--gold)] text-xs sm:text-sm mb-2 px-2 flex flex-wrap items-center justify-center gap-1.5">
      <span>🎮</span><%= stats.gameCount %> สินค้า — พร้อมส่งทันทีหลังชำระเงิน
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
      <span class="bg-gradient-to-r from-[var(--gold)] via-[var(--text)] to-[var(--gold)] bg-clip-text text-transparent"><%= settings.shopName %></span>
    </h1>
    <p class="text-[var(--text-3)] max-w-xl mx-auto"><%= settings.tagline %></p>
  </div>

  <% if (newest.length) { %>
  <!-- Compact 3-card fan for mobile -->
  <div class="modern-fan-stage modern-fan-mobile sm:hidden relative w-[92vw] max-w-[420px] mx-auto mb-6" style="height: clamp(230px, 68vw, 290px);">
    <%
      const mobileNewest = newest.slice(0,3);
      const mobileLayouts = {
        1: [{ left: '50%', width: '48%', y: '0vw', rotate: 0 }],
        2: [
          { left: '34%', width: '43%', y: '4vw', rotate: -5 },
          { left: '66%', width: '43%', y: '4vw', rotate: 5 },
        ],
        3: [
          { left: '22%', width: '36%', y: '8vw', rotate: -7 },
          { left: '50%', width: '48%', y: '0vw', rotate: 0 },
          { left: '78%', width: '36%', y: '8vw', rotate: 7 },
        ],
      };
      const mobileLayout = mobileLayouts[mobileNewest.length];
    %>
    <% mobileNewest.forEach((p, i) => { const layout = mobileLayout[i]; %>
      <div class="modern-fan-card absolute top-0 aspect-[3/4]"
        style="--fan-left:<%= layout.left %>; --fan-width:<%= layout.width %>; --fan-y:<%= layout.y %>; --fan-rotate:<%= layout.rotate %>deg; left:var(--fan-left); width:var(--fan-width); transform:translateX(-50%) translateY(var(--fan-y)) rotate(var(--fan-rotate)); z-index:<%= 10 - Math.abs((mobileNewest.length - 1) / 2 - i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>

  <!-- Full 5-card fan for tablet/desktop -->
  <div class="modern-fan-stage modern-fan-desktop hidden sm:block relative max-w-6xl mx-auto mb-6" style="height: clamp(295px, 42vw, 405px);">
    <%
      const rot = [-10, -5, 0, 5, 10];
      const tx = ['-40%', '-20%', '0%', '20%', '40%'];
      const ty = [58, 24, 0, 24, 58];
      const widths = ['clamp(150px,18vw,200px)', 'clamp(172px,21vw,230px)', 'clamp(198px,24vw,265px)', 'clamp(172px,21vw,230px)', 'clamp(150px,18vw,200px)'];
    %>
    <% newest.slice(0,5).forEach((p, i) => { %>
      <div class="modern-fan-card absolute top-0 left-1/2 aspect-[3/4] hover:z-30"
        style="--fan-width:<%= widths[i] %>; --fan-x:<%= tx[i] %>; --fan-y:<%= ty[i] %>px; --fan-rotate:<%= rot[i] %>deg; width:var(--fan-width); margin-left:calc(var(--fan-x) - var(--fan-width) / 2); transform:translateY(var(--fan-y)) rotate(var(--fan-rotate)); z-index:<%= 10 - Math.abs(2-i) %>;">
        <%- include('../partials/product-card', { p, compact: true }) %>
      </div>
    <% }) %>
  </div>
  <% } %>
</section>
<% } %>

<style>
.modern-fan-hero{position:relative;isolation:isolate;background:radial-gradient(ellipse at 50% 62%,color-mix(in srgb,var(--gold) 16%,transparent),transparent 38%),linear-gradient(180deg,color-mix(in srgb,var(--gold) 4%,var(--bg)),var(--bg))}.modern-fan-hero:before{content:'';position:absolute;z-index:-2;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--gold) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--gold) 5%,transparent) 1px,transparent 1px);background-size:4.5rem 4.5rem;mask-image:linear-gradient(transparent 2%,#000 34%,transparent 92%)}.modern-fan-hero:after{content:'';position:absolute;z-index:-1;bottom:-18rem;left:50%;width:min(76rem,96vw);height:29rem;border:1px solid color-mix(in srgb,var(--gold) 16%,transparent);border-radius:50%;background:radial-gradient(ellipse,color-mix(in srgb,var(--gold) 10%,transparent),transparent 66%);box-shadow:0 -20px 70px color-mix(in srgb,var(--gold) 8%,transparent);transform:translateX(-50%);pointer-events:none}.modern-fan-heading{position:relative;z-index:20}.modern-fan-heading>p:first-child{display:inline-flex;width:auto;align-items:center;padding:.38rem .72rem;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border));border-radius:999px;background:color-mix(in srgb,var(--gold) 6%,var(--card));box-shadow:inset 0 1px color-mix(in srgb,#fff 16%,transparent)}.modern-fan-heading h1{line-height:.95;letter-spacing:-.06em}.modern-fan-heading h1 span{filter:drop-shadow(0 8px 24px color-mix(in srgb,var(--gold) 12%,transparent))}.modern-fan-stage{perspective:1200px}.modern-fan-card{transform-origin:50% 82%;transition:transform .42s cubic-bezier(.2,.85,.2,1),filter .32s,opacity .32s}.modern-fan-card:before{content:'';position:absolute;z-index:-1;inset:-.42rem;border:1px solid color-mix(in srgb,var(--gold) 22%,var(--border));border-radius:1rem;background:linear-gradient(145deg,color-mix(in srgb,var(--gold) 7%,var(--card)),transparent 58%);box-shadow:0 25px 40px rgba(0,0,0,.18),0 0 30px color-mix(in srgb,var(--gold) 8%,transparent);opacity:.82;transition:border-color .3s,box-shadow .3s}.modern-fan-card:after{content:'';position:absolute;z-index:15;right:18%;bottom:-.65rem;left:18%;height:.22rem;border-radius:99px;background:linear-gradient(90deg,transparent,var(--gold),transparent);box-shadow:0 0 12px color-mix(in srgb,var(--gold) 55%,transparent);opacity:.55;transition:opacity .3s,transform .3s}.modern-fan-card:hover,.modern-fan-card:focus-within{transform:translateY(calc(var(--fan-y) - 18px)) rotate(0deg) scale(1.045)!important}.modern-fan-card:hover:before,.modern-fan-card:focus-within:before{border-color:color-mix(in srgb,var(--gold) 58%,var(--border));box-shadow:0 34px 52px rgba(0,0,0,.24),0 0 36px color-mix(in srgb,var(--gold) 20%,transparent)}.modern-fan-card:hover:after,.modern-fan-card:focus-within:after{opacity:1;transform:scaleX(1.2)}.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:brightness(.72) saturate(.82);opacity:.78}.modern-fan-card>a,.modern-fan-card>div{height:100%}.modern-fan-card img{backface-visibility:hidden}@media(max-width:640px){.modern-fan-hero:before{background-size:3.5rem 3.5rem}.modern-fan-hero:after{bottom:-13rem;height:21rem}.modern-fan-heading{padding-top:1.7rem!important;padding-bottom:1rem!important}.modern-fan-heading>p:first-child{font-size:.66rem}.modern-fan-heading h1{font-size:2.35rem}.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) rotate(0deg) scale(1.025)!important}.modern-fan-card:before{inset:-.28rem;border-radius:.7rem}.modern-fan-card:after{bottom:-.45rem}}@media(hover:none){.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:none;opacity:1}}@media(prefers-reduced-motion:reduce){.modern-fan-card,.modern-fan-card:before,.modern-fan-card:after{transition:none!important}}
/* Luxury Card Vault */
.modern-fan-hero{background:radial-gradient(ellipse at 50% 72%,color-mix(in srgb,var(--gold) 11%,transparent),transparent 42%),linear-gradient(180deg,var(--card),var(--bg))}.modern-fan-hero:before{background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--gold) 5%,transparent) 28%,transparent 28.2% 71.8%,color-mix(in srgb,var(--gold) 5%,transparent) 72%,transparent);mask-image:linear-gradient(#000,transparent 86%)}.modern-fan-hero:after{bottom:-15rem;width:min(82rem,105vw);height:25rem;border-color:color-mix(in srgb,var(--gold) 22%,var(--border));background:radial-gradient(ellipse,color-mix(in srgb,var(--gold) 12%,var(--input)),transparent 67%);box-shadow:0 -10px 55px color-mix(in srgb,var(--gold) 9%,transparent)}.modern-fan-heading>p:first-child{border-color:color-mix(in srgb,var(--gold) 22%,var(--border));background:var(--card);box-shadow:0 8px 24px rgba(0,0,0,.06)}.modern-fan-desktop .modern-fan-card:nth-child(n){transform:translateY(var(--fan-y)) rotate(0deg)!important}.modern-fan-card:before{inset:-.5rem;border-color:color-mix(in srgb,var(--gold) 22%,var(--border));border-radius:.75rem;background:linear-gradient(145deg,color-mix(in srgb,#fff 10%,var(--card)),color-mix(in srgb,var(--gold) 5%,var(--input)));box-shadow:0 22px 38px rgba(0,0,0,.16),inset 0 1px color-mix(in srgb,#fff 26%,transparent);opacity:1}.modern-fan-card:after{right:8%;bottom:-1.05rem;left:8%;height:1rem;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border));border-radius:50%;background:radial-gradient(ellipse,var(--gold),color-mix(in srgb,var(--gold) 18%,transparent) 55%,transparent 72%);box-shadow:0 8px 25px color-mix(in srgb,var(--gold) 18%,transparent);opacity:.58}.modern-fan-card:hover,.modern-fan-card:focus-within{transform:translateY(calc(var(--fan-y) - 20px)) scale(1.035)!important}.modern-fan-card:hover:after,.modern-fan-card:focus-within:after{opacity:1;transform:scaleX(1.12)}.modern-fan-desktop:has(.modern-fan-card:hover) .modern-fan-card:not(:hover){filter:brightness(.84) saturate(.9);opacity:.88}@media(max-width:640px){.modern-fan-hero:before{background:none}.modern-fan-hero:after{bottom:-11rem;height:18rem}.modern-fan-mobile .modern-fan-card:nth-child(n){transform:translateX(-50%) translateY(var(--fan-y)) rotate(0deg)!important}.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) scale(1.02)!important}.modern-fan-card:after{bottom:-.7rem;height:.72rem}}
.modern-fan-desktop .modern-fan-card:nth-child(n){transform:translateY(var(--fan-y)) rotate(var(--fan-rotate))!important}.modern-fan-desktop .modern-fan-card:nth-child(1),.modern-fan-desktop .modern-fan-card:nth-child(5){transform-origin:50% 88%}.modern-fan-desktop .modern-fan-card:nth-child(2),.modern-fan-desktop .modern-fan-card:nth-child(4){transform-origin:50% 84%}.modern-fan-desktop .modern-fan-card:nth-child(3){transform-origin:50% 78%}.modern-fan-mobile .modern-fan-card:nth-child(n){transform:translateX(-50%) translateY(var(--fan-y)) rotate(var(--fan-rotate))!important}@media(max-width:640px){.modern-fan-mobile .modern-fan-card:hover,.modern-fan-mobile .modern-fan-card:focus-within{transform:translateX(-50%) translateY(calc(var(--fan-y) - 7px)) rotate(0) scale(1.025)!important}}
.modern-fan-desktop .modern-fan-card:nth-child(n):hover,.modern-fan-desktop .modern-fan-card:nth-child(n):focus-within{transform:translateY(calc(var(--fan-y) - 20px)) rotate(0) scale(1.035)!important}
</style>

<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6">
  <div class="flex items-center gap-2 bg-[var(--card)] border border-[var(--border)] rounded-xl px-4 py-2.5 text-sm text-[var(--text-2)] overflow-hidden">
    <span class="relative flex h-2.5 w-2.5 shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
    </span>
    <div class="flex-1 relative h-5 overflow-hidden">
      <span class="marquee-track flex items-center gap-2">🕐 <%= settings.openHours %> &nbsp;&nbsp;•&nbsp;&nbsp; <%= settings.tagline %></span>
    </div>
    <span class="text-emerald-400 text-xs shrink-0 ml-2">เปิดให้บริการ</span>
  </div>
</section>

<% if (announcements.length) { %>
<div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-2">
  <% announcements.forEach(a => { %>
    <div class="bg-[var(--card)] border border-[var(--gold)]/40 border-l-4 border-l-[var(--gold)] text-[var(--text)] text-sm rounded-lg px-4 py-3 mb-2">
      <b class="text-[var(--gold)]">📢 <%= a.title %></b> — <%= a.body %>
    </div>
  <% }) %>
</div>
<% } %>

<% const popupAnnouncement = [...announcements].filter(a => a.popup).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))[0]; %>
<% if (popupAnnouncement) { %>
<div id="announcement-popup" class="hidden fixed inset-0 z-[9998] items-center justify-center bg-black/70 backdrop-blur-sm p-4" data-announcement-id="<%= popupAnnouncement.id %>">
  <div class="relative w-full max-w-md bg-[var(--card)] border border-[var(--gold)]/40 rounded-2xl overflow-hidden shadow-2xl">
    <% if (popupAnnouncement.image) { %>
      <% if (popupAnnouncement.link) { %><a href="<%= popupAnnouncement.link %>" target="_blank" rel="noopener"><% } %>
        <img src="<%= popupAnnouncement.image %>" alt="<%= popupAnnouncement.title %>" class="w-full object-contain" />
      <% if (popupAnnouncement.link) { %></a><% } %>
    <% } %>
    <div class="flex divide-x divide-[var(--border)] border-t border-[var(--border)]">
      <button type="button" id="announcement-popup-close" class="flex-1 py-3 text-sm font-medium text-[var(--text-2)] hover:bg-[var(--input)]">✕ เข้าสู่เว็บไซต์</button>
      <button type="button" id="announcement-popup-mute" class="flex-1 py-3 text-sm font-medium text-[var(--coral)] hover:bg-[var(--input)]">🕐 ไม่แสดงผลอีกครั้งใน 1 วัน</button>
    </div>
  </div>
</div>
<script>
  (function () {
    const modal = document.getElementById('announcement-popup');
    if (!modal) return;
    const storageKey = 'lilteam_announcement_mute_' + modal.dataset.announcementId;
    try {
      const mutedUntil = Number(localStorage.getItem(storageKey) || 0);
      if (Date.now() < mutedUntil) return;
    } catch (e) {}
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    const close = document.getElementById('announcement-popup-close');
    const mute = document.getElementById('announcement-popup-mute');
    if (close) close.addEventListener('click', function () { modal.remove(); });
    if (mute) mute.addEventListener('click', function () {
      try { localStorage.setItem(storageKey, String(Date.now() + 24 * 60 * 60 * 1000)); } catch (e) {}
      modal.remove();
    });
    modal.addEventListener('click', function (e) { if (e.target === modal) modal.remove(); });
  })();
</script>
<% } %>

<% if (scheduledProducts && scheduledProducts.length) { %>
<section class="event-update w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-5">
  <div class="mb-3">
    <h2 class="text-lg sm:text-xl font-extrabold flex items-center gap-2"><span class="event-clock">◷</span> EVENT UPDATE</h2>
    <p class="text-xs text-[var(--text-4)] mt-1">สินค้าใหม่กำลังจะเปิดขาย เตรียมตัวให้พร้อม!</p>
  </div>
  <div class="grid lg:grid-cols-2 gap-3">
    <% scheduledProducts.forEach(product => { %>
      <article class="event-card" data-event-start="<%= product.publishAt %>">
        <div class="event-image-wrap"><img src="<%= product.images[0] %>" alt="<%= product.title %>" class="event-image" /></div>
        <div class="event-copy min-w-0 flex-1">
          <span class="event-badge">⏱ <%= product.eventBadge || 'COMING SOON' %></span>
          <h3 class="event-title"><%= product.title %></h3>
          <p class="event-description"><%= product.eventDescription || 'เปิดขายอัตโนมัติเมื่อหมดเวลานับถอยหลัง' %></p>
        </div>
        <div class="event-countdown-wrap">
          <span>เหลือเวลา</span>
          <strong class="event-countdown">--:--:--</strong>
        </div>
        <button type="button" class="event-arrow" aria-label="ยังไม่ถึงเวลาเปิดขาย" disabled>›</button>
      </article>
    <% }) %>
  </div>
</section>

<style>
  .event-clock{display:grid;place-items:center;width:1.35rem;height:1.35rem;border-radius:99px;background:linear-gradient(145deg,var(--gold-light),var(--gold-dark));color:#171207;font-size:.8rem;box-shadow:0 0 14px color-mix(in srgb, var(--gold) 40%, transparent)}
  .event-card{position:relative;display:flex;align-items:center;gap:1rem;min-width:0;padding:.8rem 1rem;border-radius:1rem;border:1px solid color-mix(in srgb, var(--gold) 38%, transparent);border-top:2px solid var(--gold);background:linear-gradient(110deg,var(--card),var(--input));box-shadow:0 12px 30px -24px color-mix(in srgb, var(--gold) 85%, transparent);overflow:hidden}
  .event-card:before{content:'';position:absolute;inset:auto -3rem -4rem auto;width:10rem;height:10rem;border-radius:99px;background:color-mix(in srgb, var(--gold) 8%, transparent);filter:blur(10px)}
  .event-image-wrap{width:5rem;height:5.5rem;flex:0 0 auto;display:grid;place-items:center}.event-image{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 10px rgba(0,0,0,.25))}
  .event-badge{display:inline-flex;padding:.2rem .55rem;border-radius:99px;background:linear-gradient(135deg,var(--gold-light),var(--gold-dark));color:#171207;font-size:.58rem;font-weight:800;box-shadow:inset 0 1px 0 rgba(255,255,255,.35)}.event-title{font-size:.95rem;font-weight:800;line-height:1.25;margin-top:.35rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-description{font-size:.7rem;color:var(--text-4);margin-top:.2rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .event-countdown-wrap{width:9.5rem;flex:0 0 auto;text-align:center;padding:.55rem .7rem;border-radius:.8rem;border:1px solid color-mix(in srgb, var(--gold) 50%, transparent);background:color-mix(in srgb, var(--gold) 9%, transparent)}.event-countdown-wrap span{display:block;color:var(--text-4);font-size:.58rem}.event-countdown{display:block;color:var(--gold);font-size:1.25rem;line-height:1.25;font-variant-numeric:tabular-nums;text-shadow:0 0 14px color-mix(in srgb, var(--gold) 25%, transparent)}
  .event-arrow{position:relative;width:2.35rem;height:2.35rem;flex:0 0 auto;border-radius:.7rem;background:linear-gradient(145deg,var(--gold-light),var(--gold-dark));color:#171207;font-size:1.7rem;font-weight:800;box-shadow:0 8px 16px -8px color-mix(in srgb, var(--gold) 90%, transparent),inset 0 1px 0 rgba(255,255,255,.35);opacity:.9}
  @media(max-width:639px){.event-card{display:grid;grid-template-columns:3.75rem minmax(0,1fr) auto;gap:.65rem;padding:.7rem}.event-image-wrap{width:3.75rem;height:4.5rem;grid-row:1 / span 2}.event-countdown-wrap{grid-column:2;width:100%;padding:.4rem .55rem;text-align:left;display:flex;align-items:center;justify-content:space-between}.event-countdown{font-size:1rem}.event-arrow{grid-column:3;grid-row:1 / span 2;align-self:center;width:2rem;height:2rem;font-size:1.35rem}.event-title{font-size:.82rem}.event-description{font-size:.62rem}}
</style>
<script>
  (function(){
    const cards=document.querySelectorAll('[data-event-start]');
    if(!cards.length)return;
    function timeOf(value){return Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(value)?value:value+':00+07:00');}
    function update(){let expired=false;cards.forEach(card=>{const left=timeOf(card.dataset.eventStart)-Date.now();if(left<=0){expired=true;return;}const total=Math.floor(left/1000),days=Math.floor(total/86400),hours=Math.floor(total%86400/3600),minutes=Math.floor(total%3600/60),seconds=total%60;card.querySelector('.event-countdown').textContent=(days?days+' วัน ':'')+[hours,minutes,seconds].map(n=>String(n).padStart(2,'0')).join(':');});if(expired)location.reload();}
    update();setInterval(update,1000);
  })();
</script>
<% } %>

<% if (latestOrders && latestOrders.length) { %>
<section class="latest-orders-section w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto pt-5">
  <div class="flex items-end justify-between gap-3 mb-3">
    <div>
      <h2 class="text-lg sm:text-xl font-bold flex items-center gap-2"><span class="latest-orders-live"></span>รายการสั่งซื้อล่าสุด</h2>
      <p class="text-[10px] sm:text-xs text-[var(--text-4)] mt-0.5">อัปเดตคำสั่งซื้อจากลูกค้าของร้าน</p>
    </div>
    <span class="text-[10px] text-emerald-400 border border-emerald-400/25 bg-emerald-400/10 rounded-full px-2.5 py-1">LIVE</span>
  </div>
  <div class="latest-orders-shell">
    <div class="latest-orders-track">
      <% for (let duplicate = 0; duplicate < 2; duplicate++) { %>
        <div class="latest-orders-group" <%- duplicate ? 'aria-hidden="true"' : '' %>>
          <% latestOrders.forEach(order => { %>
            <a href="<%= order.slug ? '/game/' + order.slug : '/products' %>" class="latest-order-card">
              <span class="latest-order-image-wrap">
                <% if (order.image) { %><img src="<%= order.image %>" alt="<%= order.title %>" class="latest-order-image" /><% } else { %><span>🎮</span><% } %>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs sm:text-sm font-semibold truncate text-[var(--text)]"><%= order.title %><%= order.extraItems ? ' +' + order.extraItems + ' รายการ' : '' %></span>
                <span class="block text-xs sm:text-sm font-bold text-[var(--gold)] mt-1">฿<%= order.amount.toLocaleString() %>.00</span>
                <span class="flex items-center gap-1 text-[9px] sm:text-[10px] text-[var(--text-4)] mt-1 truncate">
                  <span>◷</span><%= new Date(order.createdAt).toLocaleString('th-TH', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' }) %> <span>•</span> <%= order.buyer %>
                </span>
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<style>
  .latest-orders-live { width: .55rem; height: .55rem; border-radius: 999px; background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.1), 0 0 14px rgba(52,211,153,.7); }
