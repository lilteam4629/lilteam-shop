        <p class="mg-kicker">🎰 มินิเกมรางเลื่อน</p>
        <h2 class="mg-title"><%= settings.miniGame.railTitle || 'รางเลื่อนลุ้นรางวัล' %></h2>
        <p class="mg-description"><%= settings.miniGame.railDescription || 'รางวัลจะเลื่อนและหยุดตรงช่องกลาง' %></p>
      </div>
      <div class="mg-price">
        <div class="mg-price-label">เริ่มลุ้นเพียง</div>
        <div class="mg-price-value">฿<%= Number(settings.miniGame.railCostPerPlay || 0).toLocaleString() %></div>
        <div class="mg-price-suffix">ต่อครั้ง</div>
      </div>
    </div>
    <%- include('../partials/minigame-rail', {
      endpoint: '/minigame/play?mode=rail',
      cost: settings.miniGame.railCostPerPlay,
      prizes: railGamePrizes,
      showLogin: !currentUser,
      balance: currentUser ? currentUser.walletBalance : null,
      mainSiteExperience: typeof isMainSite !== 'undefined' && isMainSite,
    }) %>
    <div class="mt-6">
      <h3 class="text-sm font-semibold text-[var(--text-2)] mb-3">🎁 รางวัลที่มีโอกาสได้รับ</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <% railGamePrizes.forEach(p => { %>
          <div class="mg-prize-chip <%= p.stock !== null && p.stock <= 0 ? 'opacity-50' : '' %>">
            <% if (p.image) { %>
              <button type="button" class="mg-prize-image-link" data-prize-image="<%= p.image %>" data-prize-name="<%= p.name %>" title="กดเพื่อดูรูป <%= p.name %> ขนาดใหญ่" aria-label="ดูรูป <%= p.name %> ขนาดใหญ่">
                <img src="<%= p.image %>" alt="<%= p.name %>" class="mg-prize-image" />
                <span class="mg-prize-zoom" aria-hidden="true">⌕</span>
              </button>
            <% } else { %><div class="text-2xl"><%= p.isPrize ? '🎁' : '💨' %></div><% } %>
            <div class="flex-1 min-w-0"><div class="text-sm font-semibold truncate"><%= p.name %></div><div class="text-[10px] text-[var(--text-4)]">โอกาส <%= p.percent %>%</div></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if ((settings.miniGame && settings.miniGame.boxEnabled && boxGamePrizes.length) || (settings.miniGame && settings.miniGame.railEnabled && railGamePrizes.length)) { %>
<div id="prizeImageModal" class="mg-image-modal" hidden role="dialog" aria-modal="true" aria-labelledby="prizeImageModalTitle">
  <button type="button" class="mg-image-modal-backdrop" data-prize-modal-close aria-label="ปิดรูป"></button>
  <div class="mg-image-modal-card" role="document">
    <div class="mg-image-modal-head">
      <h3 id="prizeImageModalTitle">ดูรูปรางวัล</h3>
      <button type="button" class="mg-image-modal-close" data-prize-modal-close aria-label="ปิด">×</button>
    </div>
    <div class="mg-image-modal-stage"><img src="" alt="" /></div>
    <p class="mg-image-modal-name"></p>
  </div>
</div>
<style>
  .mg-image-modal[hidden]{display:none!important}.mg-image-modal{position:fixed;z-index:10050;inset:0;display:grid;place-items:center;padding:18px}.mg-image-modal-backdrop{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgba(3,7,18,.82);backdrop-filter:blur(9px)}.mg-image-modal-card{position:relative;width:min(92vw,760px);max-height:92dvh;overflow:auto;border:1px solid color-mix(in srgb,var(--gold) 55%,var(--border-light));border-radius:18px;background:var(--card);box-shadow:0 28px 90px rgba(0,0,0,.55)}.mg-image-modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid var(--border-light)}.mg-image-modal-head h3{font-size:14px;font-weight:800;color:var(--text)}.mg-image-modal-close{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--border-light);border-radius:50%;background:var(--input);color:var(--text);font-size:24px;line-height:1}.mg-image-modal-stage{display:grid;place-items:center;min-height:260px;height:min(68vh,680px);padding:14px;background:color-mix(in srgb,var(--bg) 80%,black 8%)}.mg-image-modal-stage img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}.mg-image-modal-name{padding:11px 14px;text-align:center;color:var(--text);font-size:13px;font-weight:700}@media(max-width:640px){.mg-prize-image-link{width:4rem;height:4.8rem}.mg-image-modal{padding:10px}.mg-image-modal-card{width:100%;border-radius:14px}.mg-image-modal-stage{height:68dvh;min-height:240px;padding:8px}}
</style>
<script>
  (function(){
    const modal=document.getElementById('prizeImageModal');
    if(!modal||modal.dataset.bound==='1')return;
    modal.dataset.bound='1';
    const image=modal.querySelector('.mg-image-modal-stage img');
    const name=modal.querySelector('.mg-image-modal-name');
    let opener=null;
    function closeModal(){modal.hidden=true;document.documentElement.style.overflow='';image.src='';if(opener)opener.focus()}
    const pageController=new AbortController(),pageEvents={signal:pageController.signal};
    document.addEventListener('lilteam:page-unloading',function(){pageController.abort()},{once:true,signal:pageController.signal});
    document.addEventListener('click',function(event){
      const trigger=event.target.closest('[data-prize-image]');
      if(trigger){event.preventDefault();opener=trigger;image.src=trigger.dataset.prizeImage;image.alt=trigger.dataset.prizeName||'รูปรางวัล';name.textContent=trigger.dataset.prizeName||'';modal.hidden=false;document.documentElement.style.overflow='hidden';modal.querySelector('.mg-image-modal-close').focus();return}
      if(event.target.closest('[data-prize-modal-close]'))closeModal();
    },pageEvents);
    document.addEventListener('keydown',function(event){if(event.key==='Escape'&&!modal.hidden)closeModal()},pageEvents);
  })();
</script>
<% } %>
