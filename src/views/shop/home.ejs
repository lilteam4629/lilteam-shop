</section>
<style>
  .api-funding-notice{width:min(1320px,calc(100% - 48px));margin:18px auto 4px;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"head actions" "steps actions";align-items:center;gap:18px 24px;padding:20px 22px;border:1px solid color-mix(in srgb,var(--gold) 58%,var(--border));border-left:6px solid var(--gold);border-radius:18px;background:radial-gradient(circle at 8% 35%,color-mix(in srgb,var(--gold) 16%,transparent),transparent 32%),linear-gradient(110deg,color-mix(in srgb,var(--gold) 12%,var(--card)),var(--card) 58%,color-mix(in srgb,var(--gold) 6%,var(--bg)));box-shadow:0 20px 42px -27px color-mix(in srgb,var(--gold) 95%,transparent)}
  .api-funding-notice-head{grid-area:head;display:flex;align-items:center;gap:15px;min-width:0}.api-funding-notice-mark{display:flex;flex:0 0 auto;width:68px;height:68px;flex-direction:column;align-items:center;justify-content:center;border-radius:17px;background:linear-gradient(145deg,var(--gold),color-mix(in srgb,var(--gold) 70%,#8d6b12));color:var(--gold-contrast);box-shadow:0 12px 22px -12px var(--gold)}.api-funding-notice-mark strong{font-size:17px;font-weight:950;letter-spacing:.06em;line-height:1}.api-funding-notice-mark small{margin-top:5px;color:inherit;font-size:8px;font-weight:950;letter-spacing:.12em}.api-funding-notice-copy{min-width:0}.api-funding-notice-kicker{font-size:10px;font-weight:950;letter-spacing:.12em;color:var(--gold-text);text-transform:uppercase}.api-funding-notice h2{margin-top:4px;color:var(--text);font-size:clamp(22px,3vw,32px);font-weight:950;letter-spacing:-.035em;line-height:1.12}.api-funding-notice p{max-width:850px;margin-top:7px;color:var(--text-2);font-size:13px;font-weight:650;line-height:1.55}.api-funding-notice p b{color:var(--coral)}.api-funding-notice-copy small{display:block;margin-top:7px;color:var(--text-3);font-size:10px}.api-funding-notice-copy small b{color:var(--gold-text)}.api-funding-notice-steps{grid-area:steps;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;max-width:850px}.api-funding-notice-steps>div{display:grid;grid-template-columns:auto 1fr;column-gap:8px;align-items:center;padding:9px 10px;border:1px solid color-mix(in srgb,var(--gold) 22%,var(--border));border-radius:11px;background:color-mix(in srgb,var(--card) 75%,transparent)}.api-funding-notice-steps b{grid-row:span 2;display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:color-mix(in srgb,var(--gold) 24%,var(--input));color:var(--gold-text);font-size:10px}.api-funding-notice-steps span{color:var(--text);font-size:11px;font-weight:950;line-height:1.2}.api-funding-notice-steps small{color:var(--text-3);font-size:9px;line-height:1.2}.api-funding-notice-actions{grid-area:actions;display:flex;flex:0 0 auto;flex-direction:column;gap:8px;min-width:170px}.api-funding-notice-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 14px;border-radius:10px;border:1px solid color-mix(in srgb,var(--gold) 65%,var(--border));background:var(--gold);color:var(--gold-contrast);font-size:12px;font-weight:950;text-align:center;box-shadow:0 8px 18px -14px var(--gold)}.api-funding-notice-actions a+ a{background:var(--input);color:var(--text);border-color:var(--border-light);box-shadow:none}
  @media(max-width:760px){.api-funding-notice{width:calc(100% - 24px);grid-template-columns:1fr;grid-template-areas:"head" "steps" "actions";gap:14px;margin-top:12px;padding:15px;border-radius:15px}.api-funding-notice-head{align-items:flex-start;gap:11px}.api-funding-notice-mark{width:54px;height:54px;border-radius:14px}.api-funding-notice-mark strong{font-size:14px}.api-funding-notice-mark small{font-size:7px}.api-funding-notice-kicker{font-size:8px}.api-funding-notice h2{font-size:22px}.api-funding-notice p{font-size:11px;line-height:1.5}.api-funding-notice-copy small{font-size:9px}.api-funding-notice-steps{max-width:none;gap:6px}.api-funding-notice-steps>div{grid-template-columns:1fr;padding:8px 7px;row-gap:4px;text-align:center}.api-funding-notice-steps b{grid-row:auto;margin:0 auto;width:25px;height:25px}.api-funding-notice-steps span{font-size:10px}.api-funding-notice-steps small{font-size:8px}.api-funding-notice-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;min-width:0}.api-funding-notice-actions a{font-size:11px}}
</style>
<% } %>

<% if (catalogApiFeaturedProducts && catalogApiFeaturedProducts.length) { %>
<section class="api-product-shelf" aria-label="สินค้า API จากร้านหลัก">
  <div class="api-product-shelf-head"><div class="api-product-shelf-brand"><% if (catalogApiLogo) { %><img src="<%= catalogApiLogo %>" alt="<%= catalogApiShopName %>" /><% } else { %><span class="api-product-shelf-logo-fallback">L</span><% } %><div><span>MAIN SHOP API</span><h2>สินค้า Partner <%= catalogApiShopName %></h2><p>รายการนี้แยกจากสินค้าร้านเช่า · ต้องเติมเงินสินค้า API ก่อนซื้อเท่านั้น</p></div></div><div class="api-product-shelf-actions"><a href="/products#catalog-api">ดูสินค้า API ทั้งหมด</a><a href="/account/topup/catalog-api">เติมเงิน API →</a><a href="/contact?api=1">ติดต่อร้านหลัก</a></div></div>
  <div class="api-product-shelf-grid product-grid grid items-start grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-1 sm:gap-4">
