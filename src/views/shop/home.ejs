        <% section.products.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %>
      </div>
      </section>
    <% }) %>
  <% } else if (!products.length) { %>
    <%- include('../partials/section-hud-header', { icon: '✨', title: 'เกมมาใหม่', subtitle: 'New Arrivals', href: null }) %>
    <div class="product-grid grid items-start grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-5 gap-1 sm:gap-4 mb-10">
      <% [1,2,3,4,5].forEach(n => { %><%- include('../partials/example-product-card', { n }) %><% }) %>
    </div>
  <% } %>

  <div class="home-catalog-head">
    <div class="home-catalog-title"><span><svg><use href="#ui-box"/></svg></span><div><h2>สินค้าทั้งหมด</h2><p>All Products&nbsp; • &nbsp;<%= productTotal %> รายการ</p></div></div>
    <label class="home-catalog-search"><svg><use href="#ui-search"/></svg><input id="homeCatalogSearch" type="search" placeholder="ค้นหาสินค้า เช่น lilteam-001, นักเตะ, ไอดี..." autocomplete="off"></label>
    <div class="home-catalog-filters" aria-label="กรองสินค้า"><button type="button" class="is-active" data-home-stock="all">ทั้งหมด</button><button type="button" data-home-stock="available"><i></i> พร้อมขาย</button><button type="button" data-home-stock="sold"><i></i> สินค้าหมด</button></div>
  </div>
  <div class="all-products-grid product-grid grid items-start grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-5 gap-1 sm:gap-4">
    <% if (products.length) { %>
      <% products.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %>
    <% } else { %>
      <% [1,2,3,4,5].forEach(n => { %><%- include('../partials/example-product-card', { n }) %><% }) %>
    <% } %>
  </div>
  <% if (products.length) { %>
    <p class="text-center text-[var(--text-4)] text-xs mt-6">
      หน้า <%= productPage %> จาก <%= productTotalPages %> &nbsp;•&nbsp; แสดง <%= products.length %> จากทั้งหมด <%= productTotal %> รายการ
    </p>
    <% if (productTotalPages > 1) { %>
      <div class="flex items-center justify-center gap-1.5 mt-3 flex-wrap">
        <% const pageHref = (p) => '/?page=' + p; %>
        <a href="<%= pageHref(Math.max(1, productPage - 1)) %>" class="px-3 py-1.5 rounded-lg border border-[var(--border-light)] text-xs <%= productPage <= 1 ? 'opacity-40 pointer-events-none' : 'hover:border-[var(--gold)]' %> transition">‹ ก่อนหน้า</a>
        <% for (let p = 1; p <= productTotalPages; p++) { %>
          <% if (p === 1 || p === productTotalPages || Math.abs(p - productPage) <= 1) { %>
            <a href="<%= pageHref(p) %>" class="w-8 h-8 grid place-items-center rounded-lg border text-xs transition <%= p === productPage ? 'border-[var(--gold)] bg-[var(--gold)] text-[var(--gold-contrast)] font-bold' : 'border-[var(--border-light)] hover:border-[var(--gold)]' %>"><%= p %></a>
          <% } else if (p === 2 || p === productTotalPages - 1) { %>
            <span class="text-[var(--text-4)] text-xs px-1">…</span>
          <% } %>
        <% } %>
        <a href="<%= pageHref(Math.min(productTotalPages, productPage + 1)) %>" class="px-3 py-1.5 rounded-lg border border-[var(--border-light)] text-xs <%= productPage >= productTotalPages ? 'opacity-40 pointer-events-none' : 'hover:border-[var(--gold)]' %> transition">ถัดไป ›</a>
      </div>
    <% } %>
  <% } else { %>
    <p class="text-center text-[var(--text-4)] text-xs mt-6">ยังไม่มีสินค้า — เพิ่มสินค้าได้ที่หน้าแอดมิน (รูปด้านบนเป็นแค่ตัวอย่าง)</p>
  <% } %>
</section>
<script>(function(){const grid=document.querySelector('.all-products-grid'),search=document.getElementById('homeCatalogSearch'),buttons=[...document.querySelectorAll('[data-home-stock]')];if(!grid)return;let stock='all';const cards=[...grid.querySelectorAll('.filterable-card')];function apply(){const term=(search?.value||'').trim().toLocaleLowerCase('th-TH');cards.forEach(card=>{const matchesText=!term||(card.dataset.title||'').toLocaleLowerCase('th-TH').includes(term);const matchesStock=stock==='all'||card.dataset.stock===stock;card.toggleAttribute('hidden',!(matchesText&&matchesStock));});}search?.addEventListener('input',apply);buttons.forEach(button=>button.addEventListener('click',()=>{stock=button.dataset.homeStock||'all';buttons.forEach(item=>{const active=item===button;item.classList.toggle('is-active',active);item.setAttribute('aria-pressed',String(active));});apply();}));buttons.forEach(item=>item.setAttribute('aria-pressed',String(item.classList.contains('is-active'))));apply();})();</script>

