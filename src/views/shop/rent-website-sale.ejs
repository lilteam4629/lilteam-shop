<section class="max-w-lg mx-auto px-4 py-10">
  <a href="/rent-website" class="text-sm text-[var(--gold)]">← กลับไปหน้าเช่าเว็บ</a>
  <h1 class="text-2xl font-bold mt-2 mb-1">✅ ซื้อสำเร็จ</h1>
  <p class="text-sm text-[var(--text-3)] mb-6">
    <% if (sale.type === 'new_site') { %>
      คีย์และเว็บใหม่นี้ใช้ได้ <%= sale.days %> วัน
    <% } else { %>
      คีย์นี้ใช้ได้ <%= sale.days %> วัน — เอาไปกรอกที่หน้า <span class="font-mono">/license</span> ของเว็บที่ต้องการปลดล็อกหรือต่ออายุ
    <% } %>
  </p>

  <% if (sale.type === 'new_site') { %>
    <div id="provisioning-panel" class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-6 mb-6" data-sale-id="<%= sale.id %>">
      <div id="provisioning-loading" class="text-center <%= sale.provisioning && sale.provisioning.status !== 'creating' ? 'hidden' : '' %>">
        <div class="animate-spin w-8 h-8 border-2 border-[var(--gold)] border-t-transparent rounded-full mx-auto mb-3"></div>
        <p class="text-sm text-[var(--text-2)]">กำลังสร้างเว็บใหม่ให้อัตโนมัติ...</p>
        <p class="text-xs text-[var(--text-4)] mt-1">ใช้เวลาประมาณ 1-3 นาที ไม่ต้องปิดหน้านี้</p>
      </div>

      <div id="provisioning-success" class="text-center <%= sale.provisioning && sale.provisioning.status === 'success' ? '' : 'hidden' %>">
        <div class="text-3xl mb-2">🎉</div>
        <p class="text-emerald-400 font-semibold mb-4">สร้างเว็บใหม่สำเร็จแล้ว!</p>
        <div class="space-y-3 text-left text-sm">
          <div>
            <div class="text-xs text-[var(--text-4)] mb-1">ลิงก์เว็บของคุณ</div>
            <a id="site-url" href="<%= sale.provisioning ? sale.provisioning.url : '#' %>" target="_blank" class="font-mono text-[var(--gold)] break-all underline"><%= sale.provisioning ? sale.provisioning.url : '' %></a>
          </div>
          <div>
            <div class="text-xs text-[var(--text-4)] mb-1">ชื่อผู้ใช้แอดมิน</div>
            <div id="site-admin-user" class="font-mono select-all"><%= sale.provisioning ? sale.provisioning.adminUsername : '' %></div>
          </div>
          <div>
            <div class="text-xs text-[var(--text-4)] mb-1">รหัสผ่านแอดมิน</div>
            <div id="site-admin-pass" class="font-mono select-all"><%= sale.provisioning ? sale.provisioning.adminPassword : '' %></div>
          </div>
        </div>
        <p class="text-xs text-[var(--text-4)] mt-4">💡 เข้า <span class="font-mono">/admin</span> ของเว็บใหม่ด้วยข้อมูลด้านบน แล้วตั้งค่าร้านของคุณต่อได้เลย</p>

        <div class="border-t border-[var(--border)] mt-4 pt-4 text-left">
          <p class="text-xs text-[var(--text-3)] mb-2">🔄 ปกติเว็บนี้จะอัพเดตเองอัตโนมัติทุกครั้งที่ร้านมีเวอร์ชันใหม่ ไม่ต้องทำอะไร แต่ถ้าอยากสั่งอัพเดตเองตอนนี้เลยก็ทำได้:</p>
          <form action="/rent-website/sale/<%= sale.id %>/sync" method="post" class="flex gap-2">
            <input name="railwayToken" required placeholder="วาง Railway API Token ของคุณอีกครั้ง" class="flex-1 min-w-0 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-xs font-mono" />
            <button class="shrink-0 bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg px-3 py-2 text-xs">ซิงค์ตอนนี้</button>
          </form>
          <p class="text-[10px] text-[var(--text-4)] mt-1">Token ใช้แค่ครั้งนี้ครั้งเดียว ระบบไม่บันทึกเก็บไว้ (เหมือนตอนสร้างเว็บ)</p>

          <p class="text-[10px] text-[var(--text-4)] mt-2">⚠️ ถ้าเผลอกด "Disconnect" source ใน Railway settings แล้วหา repo เชื่อมกลับไม่เจอ — วิธีเชื่อมต่อใหม่ผ่านปุ่มยังไม่เสถียร แนะนำให้ซื้อ "เปิดเว็บใหม่" อีกรอบด้วยบัญชี Railway เดิม (ไม่ต้องสมัครบัญชี/อีเมลใหม่) จะเร็วและชัวร์กว่า</p>
        </div>
      </div>

      <div id="provisioning-failed" class="text-center <%= sale.provisioning && sale.provisioning.status === 'failed' ? '' : 'hidden' %>">
        <div class="text-3xl mb-2">⚠️</div>
        <p class="text-[var(--coral)] font-semibold mb-2">สร้างเว็บใหม่ไม่สำเร็จ</p>
        <p id="provisioning-error" class="text-xs text-[var(--text-3)] mb-3"><%= sale.provisioning ? sale.provisioning.error : '' %></p>
        <p class="text-xs text-[var(--text-4)]">คีย์ที่ซื้อยังใช้ได้ปกติ — ทักแชท "ติดต่อร้าน" แจ้งรหัสอ้างอิง <span class="font-mono"><%= sale.id %></span> เพื่อให้แอดมินช่วยตั้งเว็บให้ด้วยมือแทน</p>
      </div>
    </div>
  <% } %>

  <div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-6 text-center mb-6">
    <div class="text-xs text-[var(--text-4)] mb-2">คีย์เปิดใช้งาน</div>
    <div id="sale-key" class="font-mono text-lg font-bold text-[var(--gold)] break-all select-all mb-4"><%= sale.key %></div>
    <button id="copy-key-btn" data-key="<%= sale.key %>" class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg px-6 py-2 text-sm">📋 คัดลอกคีย์</button>
    <p id="copy-key-msg" class="text-xs text-emerald-400 mt-2 hidden">คัดลอกแล้ว!</p>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 text-sm space-y-2">
    <div class="flex justify-between"><span class="text-[var(--text-3)]">จำนวนวัน</span><span><%= sale.days %> วัน</span></div>
    <div class="flex justify-between"><span class="text-[var(--text-3)]">ราคา</span><span class="text-[var(--gold)] font-semibold">฿<%= sale.price.toLocaleString() %></span></div>
    <div class="flex justify-between"><span class="text-[var(--text-3)]">เวลาที่ซื้อ</span><span><%= new Date(sale.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></span></div>
    <% if (exp) { %>
      <div class="flex justify-between"><span class="text-[var(--text-3)]">เหลือเวลา</span><span id="sale-countdown" class="font-mono font-semibold" data-exp="<%= exp %>">…</span></div>
    <% } %>
  </div>

  <% if (sale.type !== 'new_site') { %>
    <p class="text-xs text-[var(--text-4)] mt-4 text-center">💡 วิธีใช้: เปิดเว็บที่ต้องการปลดล็อก → เข้าหน้า /license → วางคีย์นี้ → กดปลดล็อก</p>
  <% } %>
</section>

<script>
  (function () {
    const btn = document.getElementById('copy-key-btn');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const key = btn.dataset.key;
      try {
        await navigator.clipboard.writeText(key);
      } catch (err) {
        const range = document.createRange();
        range.selectNode(document.getElementById('sale-key'));
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        window.getSelection().removeAllRanges();
      }
      const msg = document.getElementById('copy-key-msg');
      msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 2000);
    });
  })();

  (function () {
    const panel = document.getElementById('provisioning-panel');
    if (!panel) return;
    const loadingEl = document.getElementById('provisioning-loading');
    const successEl = document.getElementById('provisioning-success');
    const failedEl = document.getElementById('provisioning-failed');
    if (loadingEl.classList.contains('hidden')) return;

    const saleId = panel.dataset.saleId;
    const poll = async () => {
      try {
        const res = await fetch('/rent-website/sale/' + saleId + '/status', { credentials: 'same-origin' });
        const data = await res.json();
        const p = data.provisioning;
        if (!p || p.status === 'creating') {
          setTimeout(poll, 4000);
          return;
        }
        loadingEl.classList.add('hidden');
        if (p.status === 'success') {
          document.getElementById('site-url').href = p.url;
          document.getElementById('site-url').textContent = p.url;
          document.getElementById('site-admin-user').textContent = p.adminUsername;
          document.getElementById('site-admin-pass').textContent = p.adminPassword;
          successEl.classList.remove('hidden');
        } else {
          document.getElementById('provisioning-error').textContent = p.error || 'เกิดข้อผิดพลาดไม่ทราบสาเหตุ';
          failedEl.classList.remove('hidden');
        }
      } catch (err) {
        setTimeout(poll, 5000);
      }
    };
    setTimeout(poll, 3000);
  })();

  (function () {
    const el = document.getElementById('sale-countdown');
    if (!el) return;
    const exp = Number(el.dataset.exp);
    const tick = () => {
      const ms = exp - Date.now();
      if (ms <= 0) { el.textContent = '✕ หมดอายุแล้ว'; el.classList.add('text-[var(--coral)]'); return; }
      const s = Math.floor(ms / 1000);
      const d = Math.floor(s / 86400);
      const h = Math.floor((s % 86400) / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      el.textContent = `${d} วัน ${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>
