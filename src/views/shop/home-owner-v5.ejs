<% const v5Newest = (Array.isArray(newest) ? newest : []).slice(0, 5); %>
<% const v5Categories = (Array.isArray(recommendedCategories) ? recommendedCategories : []).slice(0, 8); %>
<% const v5BoxPrizes = (Array.isArray(miniGamePrizes) ? miniGamePrizes : []).filter(p => (p.gameType || 'box') === 'box'); %>
<main class="owner-v5-home">
  <div class="v5-topline"><span><b class="v5-live-dot"></b> LILTEAM / DIGITAL MARKET</span><span>อัปเดตจากระบบหลังบ้าน <strong><%= Number(productTotal || 0).toLocaleString() %> รายการ</strong></span></div>

  <section class="v5-command" aria-labelledby="v5-command-title">
    <div class="v5-command__copy">
      <span class="v5-eyebrow">THE PLAYER INDEX <i>2026</i></span>
      <h1 id="v5-command-title">เลือกไอดีที่<br><mark>เข้ากับคุณ</mark></h1>
      <p><%= settings.tagline || 'ค้นหาไอดีเกมที่ใช่ ดูรายละเอียดเต็มภาพ แล้วรับของได้ทันทีหลังชำระเงิน' %></p>
      <div class="v5-command__actions"><button type="button" class="v5-search-trigger" id="v5QuickSearch"><span>⌕</span> ค้นหาชื่อสินค้าหรือผู้เล่น <kbd>/</kbd></button><a href="/account/topup" class="v5-topup-link">เติมเงิน <span>＋</span></a></div>
      <div class="v5-command__meta"><span><b>01</b> เลือกจากตัวกรอง</span><span><b>02</b> ดูรูปเต็มใบ</span><span><b>03</b> รับสินค้าอัตโนมัติ</span></div>
    </div>
    <div class="v5-command__telemetry">
      <div class="v5-system-card"><span class="v5-eyebrow">STORE TELEMETRY</span><strong><i></i> ONLINE</strong><small>ระบบร้านพร้อมให้บริการตลอด 24 ชั่วโมง</small><div class="v5-scanline"></div></div>
      <div class="v5-stat-row"><div><b><%= Number(productTotal || 0).toLocaleString() %></b><span>สินค้าในระบบ</span></div><div><b><%= Number(filterTags ? filterTags.length : 0).toLocaleString() %></b><span>ตัวกรองผู้เล่น</span></div><div><b><%= Number(v5Newest.length).toLocaleString() %></b><span>รายการใหม่</span></div></div>
      <div class="v5-signal"><span>QUICK ACCESS</span><a href="#v5Catalog">ดูสินค้าทั้งหมด <b>↘</b></a><a href="#v5Filters">เปิดตัวกรอง <b>↘</b></a></div>
    </div>
  </section>

  <% if (announcements && announcements.length) { %><section class="v5-broadcast" aria-label="ประกาศร้าน"><span class="v5-broadcast__label">BROADCAST</span><div><% announcements.slice(0, 3).forEach(a => { %><p><b>✳</b> <strong><%= a.title %></strong> <span><%= a.body %></span></p><% }) %></div></section><% } %>

  <% if (v5Newest.length) { %><section class="v5-section v5-spotlight" aria-labelledby="v5-spotlight-title"><div class="v5-spotlight__hero"><div class="v5-spotlight__media"><img src="<%= v5Newest[0].images && v5Newest[0].images[0] ? v5Newest[0].images[0] : '' %>" alt="<%= v5Newest[0].title %>" loading="eager" decoding="async" /><span>01 / FEATURED DROP</span></div><div class="v5-spotlight__copy"><span class="v5-eyebrow">SPOTLIGHT DROP</span><h2 id="v5-spotlight-title"><%= v5Newest[0].title %></h2><p>รายการล่าสุดจากคลังสินค้า ดูรายละเอียดได้ทุกมุมก่อนตัดสินใจ</p><strong>฿<%= Number(v5Newest[0].price || 0).toLocaleString() %></strong><a href="/game/<%= v5Newest[0].slug %>" class="v5-dark-button">ดูรายละเอียด <span>↗</span></a></div></div><div class="v5-spotlight__queue"><header><span class="v5-eyebrow">NEXT IN QUEUE</span><a href="/products">ดูทั้งหมด ↗</a></header><% v5Newest.slice(1, 5).forEach((p, i) => { %><a class="v5-queue-item" href="/game/<%= p.slug %>"><span class="v5-queue-no">0<%= i + 2 %></span><span class="v5-queue-image"><img src="<%= p.images && p.images[0] ? p.images[0] : '' %>" alt="<%= p.title %>" loading="lazy" /></span><span><b><%= p.title %></b><small>฿<%= Number(p.price || 0).toLocaleString() %> · <%= Number(p.stockCount || 0) > 0 ? 'พร้อมส่ง' : 'หมดชั่วคราว' %></small></span><em>→</em></a><% }) %></div></section><% } %>

  <% if (v5Categories.length) { %><section class="v5-section v5-launchpad"><header class="v5-section-head"><div><span class="v5-eyebrow">LAUNCHPAD</span><h2>เริ่มจากสิ่งที่คุณชอบ</h2></div><span>หมวดหมู่ที่ตั้งค่าจากหลังบ้าน</span></header><div class="v5-launchpad__grid"><% v5Categories.forEach((category, i) => { %><a href="/products?recommended=<%= encodeURIComponent(category.id) %>" class="v5-launch-card"><span class="v5-launch-card__number">0<%= i + 1 %></span><div class="v5-launch-card__image"><% if (category.imageUrl) { %><img src="<%= category.imageUrl %>" alt="<%= category.title %>" loading="lazy" /><% } else { %><span><%= String(category.title || '').slice(0, 1) %></span><% } %></div><div><b><%= category.title %></b><small><%= Number(category.count || 0).toLocaleString() %> รายการ</small></div><strong>↗</strong></a><% }) %></div></section><% } %>

  <% if (scheduledProducts && scheduledProducts.length) { %><section class="v5-section v5-next-drop"><header class="v5-section-head"><div><span class="v5-eyebrow">DROP RADAR</span><h2>กำลังจะเข้าเร็ว ๆ นี้</h2></div><span>ตั้งเวลาโดยระบบหลังบ้าน</span></header><div class="v5-next-drop__rail"><% scheduledProducts.slice(0, 4).forEach(product => { %><article class="v5-radar-card" data-v5-event="<%= product.publishAt %>"><div><img src="<%= product.images && product.images[0] ? product.images[0] : '' %>" alt="<%= product.title %>" loading="lazy" /></div><span>UP NEXT</span><h3><%= product.title %></h3><strong class="v5-event-countdown">--:--:--</strong></article><% }) %></div></section><% } %>

  <% if (filterTags && filterTags.length) { %><section class="v5-section v5-filters" id="v5Filters"><header class="v5-section-head"><div><span class="v5-eyebrow">BUILD YOUR LOADOUT</span><h2>เลือกตัวกรองที่ต้องการ</h2></div><a href="/products">ค้นหาแบบเต็ม ↗</a></header><div class="v5-filter-frame"><div class="v5-filter-frame__rail"><span>FILTER LIBRARY</span><b><%= Number(filterTags.length).toLocaleString() %> TAGS</b><small>เลือกได้หลายรายการ</small></div><%- include('../partials/filter-panel', { filterTags }) %></div></section><% } %>

  <section class="v5-section v5-catalog" id="v5Catalog" aria-labelledby="v5-catalog-title"><header class="v5-section-head v5-catalog-head"><div><span class="v5-eyebrow">THE INVENTORY</span><h2 id="v5-catalog-title">คลังสินค้าทั้งหมด</h2><span><%= Number(productTotal || 0).toLocaleString() %> รายการ · แสดงจากระบบจริง</span></div><div class="v5-catalog-tools"><label><span>⌕</span><input id="v5Search" type="search" placeholder="ค้นหาในหน้านี้..." autocomplete="off" /></label><div><button type="button" class="is-active" data-v5-stock="all">ทั้งหมด</button><button type="button" data-v5-stock="available">พร้อมขาย</button><button type="button" data-v5-stock="sold">หมด</button></div></div></header>
    <% if (homeSections && homeSections.length) { %><% homeSections.forEach(section => { %><section class="v5-managed-section"><header><h3><%= section.title %></h3><span>CURATED BY ADMIN</span></header><div class="v5-product-grid"><% section.products.forEach(p => { %><%- include('../partials/product-card-v5', { p }) %><% }) %></div></section><% }) %><% } %>
    <section class="v5-managed-section v5-managed-section--all"><header><h3>รายการทั้งหมด</h3><span>หน้า <%= productPage %> / <%= productTotalPages %></span></header><div class="v5-product-grid" id="v5ProductGrid"><% if (products && products.length) { %><% products.forEach(p => { %><%- include('../partials/product-card-v5', { p }) %><% }) %><% } else { %><div class="v5-empty">ยังไม่มีสินค้าในระบบ</div><% } %></div><% if (productTotalPages > 1) { %><div class="v5-pagination"><a href="/?page=<%= Math.max(1, productPage - 1) %>">← ก่อนหน้า</a><span>หน้า <b><%= productPage %></b> / <%= productTotalPages %></span><a href="/?page=<%= Math.min(productTotalPages, productPage + 1) %>">ถัดไป →</a></div><% } %></section>
  </section>

  <% if (settings.miniGame && settings.miniGame.boxEnabled && v5BoxPrizes.length) { %><section class="v5-section v5-play"><header class="v5-section-head"><div><span class="v5-eyebrow">SIDE QUEST</span><h2><%= settings.miniGame.title || 'เปิดกล่องลุ้นรางวัล' %></h2><p><%= settings.miniGame.description || 'รางวัลจริงจากสต็อกของร้าน' %></p></div><strong>฿<%= Number(settings.miniGame.costPerPlay || 0).toLocaleString() %> / PLAY</strong></header><div class="v5-prize-strip"><% v5BoxPrizes.slice(0, 6).forEach(prize => { %><div><% if (prize.image) { %><img src="<%= prize.image %>" alt="<%= prize.name %>" loading="lazy" /><% } else { %><span>?</span><% } %><b><%= prize.name %></b></div><% }) %></div><%- include('../partials/minigame-widget', { endpoint: '/minigame/play', cost: settings.miniGame.costPerPlay, ctaLabel: 'เริ่มเล่น', showLogin: !currentUser, balance: currentUser ? currentUser.walletBalance : null }) %></section><% } %>

  <section class="v5-bottom-cta"><span class="v5-eyebrow">READY WHEN YOU ARE</span><h2>เจอไอดีที่ใช่แล้ว?</h2><p>เติมเงินครั้งเดียว แล้วเลือกซื้อได้จากระบบเดียว</p><div><a href="/products" class="v5-dark-button">เข้าคลังสินค้า ↗</a><a href="/help">วิธีสั่งซื้อ</a></div></section>
</main>
<script>
(function(){
  const grid=document.getElementById('v5ProductGrid'), search=document.getElementById('v5Search'), buttons=[...document.querySelectorAll('[data-v5-stock]')];
  if(grid){const cards=[...grid.querySelectorAll('[data-v5-product]')];let stock='all';const apply=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('th-TH');cards.forEach(card=>card.hidden=!!((q&&!card.dataset.title.includes(q))||(stock!=='all'&&card.dataset.stock!==stock)))};search?.addEventListener('input',apply);buttons.forEach(b=>b.addEventListener('click',()=>{stock=b.dataset.v5Stock;buttons.forEach(x=>x.classList.toggle('is-active',x===b));apply()}));apply()}
  const quick=document.getElementById('v5QuickSearch');quick?.addEventListener('click',()=>{document.getElementById('v5Catalog')?.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(()=>document.getElementById('v5Search')?.focus(),350)});document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)){e.preventDefault();quick?.click()}});
  const events=[...document.querySelectorAll('[data-v5-event]')];if(events.length){const parse=v=>Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(v)?v:v+':00+07:00');const tick=()=>events.forEach(e=>{const left=parse(e.dataset.v5Event)-Date.now();if(left<=0){e.querySelector('.v5-event-countdown').textContent='เปิดแล้ว';return}const s=Math.floor(left/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),sec=s%60;e.querySelector('.v5-event-countdown').textContent=(d?d+' วัน ':'')+[h,m,sec].map(n=>String(n).padStart(2,'0')).join(':')});tick();setInterval(tick,1000)}
})();
</script>
