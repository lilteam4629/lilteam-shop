<section class="max-w-lg mx-auto px-4 py-24 text-center">
  <div class="text-6xl mb-4 text-[var(--gold-text)]"><%= typeof statusCode === 'number' ? statusCode : 404 %></div>
  <p class="text-[var(--text-3)] mb-6"><%= typeof message === 'string' && message ? message : 'ไม่พบหน้าที่คุณต้องการ' %></p>
  <a href="<%= typeof backPath === 'string' && backPath ? backPath : '/' %>" class="text-[var(--gold-text)]"><%= typeof backLabel === 'string' && backLabel ? backLabel : 'กลับหน้าแรก' %> →</a>
</section>
