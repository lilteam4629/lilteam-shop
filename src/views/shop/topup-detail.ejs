<% const publicSlipMessage = (message) => String(message || '')
  .replace(/Slip\s*XEPHT/gi, 'ระบบตรวจสอบ')
  .replace(/slip\.xepht\.com/gi, 'ระบบภายนอก')
  .replace(/XEPHT/gi, 'ระบบตรวจสอบ'); %>
<style>
  <% if (typeof storefrontCustomerRefresh !== 'undefined' && storefrontCustomerRefresh) { %>
  body:has(.topup-detail-page) #store-rain{display:none!important}
  .topup-detail-page{width:min(1100px,calc(100% - 32px));max-width:none;margin:0 auto;padding:34px 0 64px;color:var(--text)}
  .topup-detail-head{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"back back" "title amount";align-items:end;gap:5px 24px;margin-bottom:24px}
  .topup-detail-head>a{grid-area:back;width:max-content;margin-bottom:7px;color:var(--gold-text);font-size:12px;font-weight:600;text-decoration:none}
  .topup-detail-head>a:hover{text-decoration:underline;text-underline-offset:4px}
  .topup-detail-head-row{display:contents}
  .topup-detail-heading{grid-area:title;min-width:0}
  .topup-detail-head h1{margin:0;font-size:clamp(24px,3vw,32px);font-weight:750;letter-spacing:-.025em;line-height:1.2}
  .topup-detail-head p{margin:5px 0 0;color:var(--text-3);font-size:12px;line-height:1.6}
  .topup-detail-amount{grid-area:amount;display:grid;gap:3px;min-width:172px;padding:12px 17px;border:1px solid var(--border);border-radius:14px;background:color-mix(in srgb,var(--gold) 9%,var(--card));text-align:right}
  .topup-detail-amount span{color:var(--text-3);font-size:11px}
  .topup-detail-amount strong{color:var(--gold-text);font-size:26px;font-variant-numeric:tabular-nums;line-height:1.2}
  .topup-detail-api-note{margin:0 0 14px!important;padding:14px 17px!important;border:1px solid color-mix(in srgb,var(--gold) 35%,var(--border))!important;border-radius:14px!important;background:color-mix(in srgb,var(--gold) 8%,var(--card))!important;color:var(--text-2);font-size:12px!important}
  .topup-detail-api-note>div{color:var(--gold-text);font-size:13px}
  .topup-detail-api-note p{margin-top:4px!important;color:var(--text-2)!important;line-height:1.65}
  .topup-detail-status{grid-column:1/-1;margin:0 0 14px!important;border-radius:13px!important;padding:13px 16px!important;font-size:12px!important;line-height:1.65}
  .topup-detail-awaiting{display:flex;align-items:center;gap:10px;text-align:left!important;color:var(--text-2)!important;background:color-mix(in srgb,var(--gold) 9%,var(--card))!important;border-color:color-mix(in srgb,var(--gold) 34%,var(--border))!important}
  .topup-detail-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);align-items:start;gap:16px}
  .topup-detail-grid:not(:has(.topup-detail-upload)){grid-template-columns:minmax(0,760px);justify-content:center}
  .topup-detail-summary,.topup-detail-upload{min-width:0;margin:0!important;padding:23px!important;border:1px solid var(--border)!important;border-radius:16px!important;background:var(--card)!important;box-shadow:none!important}
  .topup-detail-summary>div:first-child{align-items:center;padding-bottom:14px;border-bottom:1px solid var(--border);font-size:13px}
  .topup-detail-summary>div:first-child>span:last-child{color:var(--text);font-weight:600}
  .topup-detail-summary>div:nth-child(2){color:var(--text-2)}
  .topup-detail-summary>div.border-t{padding-top:15px;border-color:var(--border)}
  .topup-detail-summary .text-sm.space-y-1{display:grid;gap:6px;font-size:12px}
  .topup-detail-summary .text-sm.space-y-1>div{display:flex;justify-content:space-between;gap:18px;line-height:1.55}
  .topup-detail-summary .text-sm.space-y-1>div>span:last-child{text-align:right;overflow-wrap:anywhere}
  .topup-detail-summary .bg-white.rounded-lg{margin:0 auto 14px;padding:12px;border:1px solid var(--border);border-radius:13px}
  .topup-detail-summary .bg-white.rounded-lg img{width:min(100%,220px);height:220px}
  .topup-detail-summary .bg-white.rounded-lg p{color:#454542}
  .topup-detail-summary .flex.items-start.gap-2\.5{margin-top:16px;padding:13px 14px;border:1px solid color-mix(in srgb,var(--gold) 30%,var(--border));border-radius:12px;background:color-mix(in srgb,var(--gold) 8%,var(--card));font-size:12px;line-height:1.7}
  .topup-detail-upload h2{margin:0 0 14px;font-size:16px;font-weight:700}
  .topup-detail-upload #slipDeadline{margin-bottom:15px;border-radius:13px}
  .topup-detail-upload #slipCountdown{font-size:30px}
  .topup-detail-upload #slipUploadForm{align-items:center;margin-top:10px}
  .topup-detail-upload input[type=file]{min-height:44px;max-width:100%;color:var(--text-2);font-size:12px}
  .topup-detail-upload input[type=file]::file-selector-button{min-height:38px;margin-right:10px;padding:0 13px;border:1px solid var(--border);border-radius:9px;background:var(--input);color:var(--text);font:inherit;font-weight:600;font-size:12px;cursor:pointer}
  .topup-detail-upload #slipUploadForm button{min-height:42px;border-radius:10px;padding:0 17px}
  .topup-detail-upload>p:last-child{margin-top:12px;line-height:1.6}
  .topup-detail-page a:focus-visible,.topup-detail-page button:focus-visible,.topup-detail-page input:focus-visible{outline:3px solid color-mix(in srgb,var(--gold) 40%,transparent);outline-offset:3px}
  @media(max-width:900px){.topup-detail-page{width:min(calc(100% - 28px),700px);padding:26px 0 48px}.topup-detail-head{margin-bottom:19px}.topup-detail-grid,.topup-detail-grid:has(.topup-detail-upload){grid-template-columns:1fr;gap:12px}}
  @media(max-width:540px){.topup-detail-page{width:calc(100% - 24px);padding-top:20px}.topup-detail-head{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"back back" "title title" "amount amount";gap:4px}.topup-detail-head h1{font-size:24px;overflow-wrap:anywhere}.topup-detail-amount{min-width:0;width:max-content;max-width:100%;margin-top:10px;padding:9px 13px;text-align:left}.topup-detail-amount strong{font-size:22px}.topup-detail-summary,.topup-detail-upload{padding:16px!important}.topup-detail-summary .text-sm.space-y-1>div{gap:10px}.topup-detail-awaiting{align-items:flex-start}}
  @media(prefers-reduced-motion:reduce){.topup-detail-page *{scroll-behavior:auto!important;transition:none!important}}
  <% } %>
  html.slip-verification-active,body.slip-verification-active{overflow:hidden!important;overscroll-behavior:none!important}
  body.slip-verification-active{position:fixed!important;inset-inline:0!important;width:100%!important;touch-action:none!important}
  #slipUploadOverlay{position:fixed!important;inset:0!important;z-index:2147483000!important;display:grid;place-items:center;overflow:hidden;overscroll-behavior:contain;touch-action:none;background:color-mix(in srgb,var(--bg) 94%,#050505 6%);color:var(--text);padding:24px}
  #slipUploadOverlay.hidden{display:none!important}
  .slip-check-card{position:relative;width:min(100%,430px);overflow:hidden;padding:30px 26px 24px;border:1px solid color-mix(in srgb,var(--gold) 34%,var(--border));border-radius:26px;background:color-mix(in srgb,var(--card) 96%,var(--gold) 4%);box-shadow:0 28px 90px color-mix(in srgb,#000 42%,transparent),0 0 0 1px color-mix(in srgb,var(--gold) 9%,transparent) inset;text-align:center}
  .slip-check-card:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 20%,color-mix(in srgb,var(--gold) 12%,transparent) 48%,transparent 70%);transform:translateX(-120%);animation:slip-check-sweep 2.8s ease-in-out infinite;pointer-events:none}
  .slip-check-mark{position:relative;display:grid;place-items:center;width:76px;height:76px;margin:0 auto 19px;border:1px solid color-mix(in srgb,var(--gold) 46%,transparent);border-radius:24px;background:color-mix(in srgb,var(--gold) 12%,var(--card));color:var(--gold-text);box-shadow:0 0 34px color-mix(in srgb,var(--gold) 20%,transparent)}
  .slip-check-mark:before,.slip-check-mark:after{content:"";position:absolute;border-radius:50%;border:1px solid color-mix(in srgb,var(--gold) 35%,transparent);animation:slip-check-pulse 2s ease-out infinite}
  .slip-check-mark:before{inset:-10px}.slip-check-mark:after{inset:-19px;animation-delay:.45s;opacity:.55}
  .slip-check-mark svg{position:relative;z-index:1;width:34px;height:34px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .slip-check-spinner{width:18px;height:18px;margin:0 auto 14px;border:2px solid color-mix(in srgb,var(--gold) 22%,transparent);border-top-color:var(--gold);border-radius:50%;animation:slip-check-spin .85s linear infinite}
  .slip-check-title{position:relative;margin:0;font-size:clamp(20px,5vw,25px);font-weight:800;letter-spacing:-.02em;line-height:1.25}
  .slip-check-message{position:relative;margin:9px auto 0;max-width:32ch;color:var(--text-3);font-size:13px;line-height:1.7}
  .slip-check-dots{display:inline-flex;gap:4px;margin-left:4px;vertical-align:middle}
  .slip-check-dots i{width:4px;height:4px;border-radius:50%;background:var(--gold);animation:slip-check-dot 1.2s ease-in-out infinite}
  .slip-check-dots i:nth-child(2){animation-delay:.15s}.slip-check-dots i:nth-child(3){animation-delay:.3s}
  #slipStatusReturn{position:relative;margin-top:18px;min-height:44px;align-items:center;justify-content:center;padding:0 18px;border:1px solid var(--border-light);border-radius:999px;background:var(--input);color:var(--text);text-decoration:none}
  #slipStatusReturn:not(.hidden){display:inline-flex}
  @keyframes slip-check-spin{to{transform:rotate(360deg)}}
  @keyframes slip-check-pulse{0%{transform:scale(.78);opacity:.7}70%,100%{transform:scale(1.16);opacity:0}}
  @keyframes slip-check-sweep{0%,25%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}
  @keyframes slip-check-dot{0%,60%,100%{transform:translateY(0);opacity:.35}30%{transform:translateY(-4px);opacity:1}}
  @media(prefers-reduced-motion:reduce){.slip-check-card:before,.slip-check-mark:before,.slip-check-mark:after,.slip-check-spinner,.slip-check-dots i{animation:none!important}}

</style>
<section class="topup-detail-page max-w-lg mx-auto px-4 py-10">
  <header class="topup-detail-head">
    <a href="/account" class="text-sm text-[var(--gold-text)]">← กลับไปหน้าบัญชี</a>
    <div class="topup-detail-head-row">
      <div class="topup-detail-heading">
        <h1 class="text-2xl font-bold mt-2 mb-1">คำขอเติมเงิน #<%= request.refCode %></h1>
        <p class="text-sm text-[var(--text-3)] mb-6"><%= new Date(request.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>
      </div>
      <div class="topup-detail-amount"><span>ยอดที่ต้องโอน</span><strong>฿<%= Number(request.amount || 0).toLocaleString('th-TH') %>.00</strong></div>
    </div>
  </header>
  <% if (catalogApiTopup) { %>
    <div class="topup-detail-api-note mb-5 rounded-2xl border-2 border-[var(--gold)]/60 bg-[var(--gold)]/10 p-4 text-sm">
      <div class="font-black text-[var(--gold-text)]">🔒 ยอดเติมเงินสินค้า API โอนเข้าบัญชีร้านหลัก: <%= settlementShopName %></div>
      <p class="mt-1 text-xs leading-relaxed text-[var(--text-2)]">ยอดนี้แยกจากเงินเติมร้านเช่า เมื่ออนุมัติแล้วใช้ซื้อสินค้า API เท่านั้น หลังซื้อสำเร็จให้กดติดต่อร้านหลักจากหน้าออเดอร์เพื่อรับไอดี</p>
    </div>
  <% } %>

  <% if (request.status === 'approved') { %>
    <div class="topup-detail-status bg-emerald-900/30 border border-emerald-700 rounded-xl p-5 text-center mb-6">
      <div class="text-3xl mb-2">✅</div>
      <div class="text-emerald-300 font-semibold mb-1">อนุมัติแล้ว เติมเงินสำเร็จ</div>
      <div class="text-2xl font-bold text-[var(--gold-text)]">฿<%= request.amount.toLocaleString() %>.00</div>
      <% if (request.slipCheck && request.slipCheck.verified) { %>
        <p class="text-xs text-emerald-400 mt-2">⚡ ตรวจสอบและอนุมัติอัตโนมัติแล้ว</p>
      <% } %>
    </div>
  <% } else if (request.status === 'rejected') { %>
    <div class="topup-detail-status bg-[var(--coral)]/10 border border-[var(--coral)]/40 rounded-xl p-5 text-center mb-6">
      <div class="text-3xl mb-2">✕</div>
      <div class="text-[var(--coral)] font-semibold mb-1">คำขอนี้ถูกปฏิเสธ</div>
      <% if (request.reviewNote) { %><p class="text-sm text-[var(--text-3)]"><%= request.reviewNote %></p><% } %>
    </div>
  <% } else if (request.slipPath && request.slipCheck && request.slipCheck.checked && !request.slipCheck.verified) { %>
    <div class="topup-detail-status bg-[var(--coral)]/10 border border-[var(--coral)]/40 rounded-2xl p-5 text-center mb-6">
      <div class="text-2xl mb-2">✕</div>
      <div class="text-[var(--coral)] font-semibold mb-1">ตรวจสอบสลิปไม่สำเร็จ</div>
      <p class="text-sm text-[var(--text-3)]"><%= publicSlipMessage(request.slipCheck.message) || 'ระบบตรวจสอบไม่สามารถยืนยันรายการนี้ได้' %></p>
      <p class="text-xs text-[var(--gold-light)] mt-2">รายการยังไม่ถูกปฏิเสธถาวร คุณสามารถแนบสลิปใหม่หรือติดต่อแอดมินได้</p>
    </div>
  <% } else if (request.status === 'verifying' && request.slipPath && automaticSlipCheck) { %>
    <div class="topup-detail-status bg-sky-500/10 border border-sky-500/30 rounded-2xl p-4 mb-6 flex items-center gap-3 text-sm">
      <span class="relative flex h-3 w-3 shrink-0"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-400 opacity-60"></span><span class="relative inline-flex h-3 w-3 rounded-full bg-sky-500"></span></span>
      <div><div class="font-semibold text-[var(--text)]">กำลังตรวจสลิปให้คุณ</div><div class="text-xs text-[var(--text-3)] mt-0.5">ระบบกำลังตรวจด้วยคีย์ปัจจุบัน และจะเติมเงินให้ทันทีเมื่อตรวจผ่าน</div></div>
    </div>
  <% } else if (request.slipPath && request.slipCheck && (request.slipCheck.rateLimited || request.slipCheck.quotaMismatch || request.slipCheck.retryable || request.slipCheck.providerCode === 'verify_failed')) { %>
    <div class="topup-detail-status bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 mb-6 text-sm text-amber-300">
      ระบบตรวจสลิปยังไม่พร้อมรับคำขอในขณะนี้ สลิปถูกเก็บไว้แล้วและสามารถกดตรวจรูปเดิมได้โดยไม่ต้องแนบซ้ำ
    </div>
  <% } else if (!request.slipPath && automaticSlipCheck) { %>
    <div class="topup-detail-status topup-detail-awaiting bg-[var(--gold)]/10 border border-[var(--gold)]/40 rounded-xl p-4 text-center mb-6 text-sm text-[var(--gold-light)]">
      ⏳ โอนเงินแล้วแนบสลิปด้านล่าง ระบบจะตรวจสอบและเติมเงินให้อัตโนมัติทันที
    </div>
  <% } else { %>
    <div class="topup-detail-status topup-detail-awaiting bg-[var(--gold)]/10 border border-[var(--gold)]/40 rounded-xl p-4 text-center mb-6 text-sm text-[var(--gold-light)]">
      ⏳ แนบสลิปแล้วรอแอดมินร้านตรวจสอบและอนุมัติยอดเงิน
    </div>
  <% } %>

  <div class="topup-detail-grid">
  <div class="topup-detail-summary bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 space-y-4 mb-6">
    <div class="flex justify-between text-sm"><span class="text-[var(--text-3)]">ช่องทาง</span><span><%= request.method === 'truemoney_angpao' ? 'ซองของขวัญ TrueMoney' : (request.method === 'promptpay' ? 'พร้อมเพย์ (PromptPay)' : 'โอนผ่านธนาคาร') %></span></div>

    <div class="border-t border-[var(--border)] pt-4">
      <% if (request.method === 'truemoney_angpao') { %>
        <div class="bg-emerald-900/20 border border-emerald-700/50 rounded-xl px-4 py-4 text-center">
          <div class="text-2xl mb-2">🧧</div>
          <div class="font-semibold text-emerald-300">รับเงินจากซองของขวัญเรียบร้อยแล้ว</div>
          <p class="text-xs text-[var(--text-3)] mt-1">ยอดเงินถูกเพิ่มเข้ากระเป๋าในเว็บไซต์อัตโนมัติ</p>
        </div>
      <% } else { %>
        <% if (payment.bankQrImage) { %>
          <div class="bg-white rounded-lg p-4 flex flex-col items-center mb-3">
            <img src="<%= payment.bankQrImage %>" class="w-56 h-56 object-contain" alt="QR โอนธนาคาร" />
            <p class="text-gray-600 text-xs mt-2 text-center">สแกนด้วยแอปธนาคารเพื่อชำระ ฿<%= request.amount.toLocaleString() %>.00</p>
          </div>
        <% } %>
        <div class="text-sm space-y-1">
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ธนาคาร</span><span><%= payment.bankName %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">เลขบัญชี</span><span class="font-mono"><%= payment.bankAccountNumber %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ชื่อบัญชี</span><span><%= payment.bankAccountName %></span></div>
        </div>
      <% } %>
      <% if (request.method !== 'truemoney_angpao') { %>
        <div class="flex items-start gap-2.5 topup-detail-warning bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-xl px-4 py-3 mt-4 text-sm">
          <span class="shrink-0 text-lg">⚠️</span>
          <span class="text-[var(--text)]">โอนแล้วกรุณาระบุจำนวนเงินให้ตรงเป๊ะ <b class="text-[var(--gold-text)]">(฿<%= request.amount.toLocaleString() %>.00)</b><%= automaticSlipCheck ? ' เพื่อให้ระบบตรวจสอบอัตโนมัติผ่านและเติมเงินได้ทันที' : ' จากนั้นแอดมินร้านจะตรวจสอบและอนุมัติให้' %></span>
        </div>
      <% } %>
    </div>
  </div>

  <% if (request.status === 'pending' || request.status === 'verifying') { %>
    <div class="topup-detail-upload bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
      <h2 class="font-semibold mb-3">แนบสลิปการโอนเงิน</h2>
      <% if (automaticSlipCheck) { %>
        <div id="slipDeadline" data-deadline="<%= new Date(request.createdAt).getTime() + (5 * 60 * 1000) %>" class="mb-4 rounded-xl border border-amber-500/50 bg-amber-500/10 px-4 py-3 text-center">
          <p class="text-xs text-[var(--text-3)]">กรุณาโอนและแนบสลิปภายใน</p>
          <p id="slipCountdown" class="mt-1 font-mono text-3xl font-bold tabular-nums text-amber-400">05:00</p>
          <p id="slipDeadlineHint" class="mt-1 text-[11px] text-[var(--text-4)]">ระบบนับถอยหลังให้ทุกวินาที</p>
        </div>
      <% } %>
      <% if (request.slipPath) { %>
        <div class="mb-3">
          <img src="<%= request.slipPath %>" class="max-w-full rounded-lg border border-[var(--border)]" alt="สลิปที่แนบ" />
          <% if (request.slipCheck && request.slipCheck.checked && !request.slipCheck.verified) { %>
            <% if (request.slipCheck.quotaExhausted) { %>
              <p class="text-sm font-semibold text-amber-300 mt-2">⚠️ โควตาตรวจสลิปหมดแล้ว — ระบบยังไม่สามารถเติมเงินอัตโนมัติได้ กรุณาแจ้งแอดมินให้เติมโควตาหรือตรวจสอบยอดด้วยตนเอง</p>
            <% } else if (request.slipCheck.rateLimited || request.slipCheck.quotaMismatch || request.slipCheck.retryable || request.slipCheck.providerCode === 'verify_failed') { %>
              <div class="mt-3 rounded-xl border border-amber-500/30 bg-amber-500/10 p-3">
                <p class="text-xs text-amber-300"><%= publicSlipMessage(request.slipCheck.message) %>. สลิปถูกเก็บไว้แล้ว กดตรวจรูปเดิมซ้ำได้โดยไม่ต้องแนบใหม่</p>
                <form action="/account/topup/<%= request.id %>/retry-slip" method="post" class="mt-2">
                  <button type="submit" class="w-full rounded-lg bg-amber-400 px-3 py-2 text-xs font-bold text-amber-950">ลองตรวจสลิปเดิมอีกครั้ง</button>
                </form>
              </div>
            <% } else { %>
              <p class="text-xs text-[var(--coral)] mt-2">✕ ตรวจสอบอัตโนมัติไม่ผ่าน: <%= publicSlipMessage(request.slipCheck.message) %> — กรุณาตรวจสอบยอดเงิน/สลิปแล้วลองแนบใหม่อีกครั้ง</p>
            <% } %>
            <p class="text-xs text-[var(--gold-light)] mt-1">⏳ คำขอนี้ยังอยู่ระหว่างรอแอดมินตรวจสอบด้วยตนเอง ไม่ได้ถูกปฏิเสธ</p>
          <% } else { %>
            <p class="text-xs text-emerald-400 mt-2">✓ แนบสลิปแล้ว รอการตรวจสอบ</p>
          <% } %>
        </div>
      <% } %>
      <form id="slipUploadForm" action="/account/topup/<%= request.id %>/slip" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-2">
        <input type="file" name="slip" accept="image/*" required class="min-w-0 flex-1 text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[var(--input)] file:text-[var(--gold-text)] file:text-sm" />
        <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium px-4 py-2 sm:py-0 rounded-lg text-sm whitespace-nowrap"><%= request.slipPath ? 'แนบใหม่' : 'แนบสลิป' %></button>
      </form>
      <p class="text-[10px] text-[var(--text-4)] mt-2">⚠️ สลิปต้องเป็นรายการโอนภายใน 5 นาทีล่าสุด และใช้ยืนยันได้ครั้งเดียวเท่านั้น (สลิปเก่าเกิน 5 นาที หรือสลิปที่เคยใช้แล้วจะไม่ผ่านการตรวจสอบ)</p>
    </div>
  <% } %>
  </div>
</section>

<div id="slipUploadOverlay" class="hidden" role="dialog" aria-modal="true" aria-labelledby="slipStatusTitle" aria-describedby="slipStatusMessage">
  <div class="slip-check-card">
    <div class="slip-check-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.4 2.7 8.4 7 10 4.3-1.6 7-5.6 7-10V6l-7-3Z"/><path d="m8.8 12 2.1 2.1 4.5-4.5"/></svg>
    </div>
    <div class="slip-check-spinner" aria-hidden="true"></div>
    <h2 id="slipStatusTitle" class="slip-check-title"><%= automaticSlipCheck ? 'กำลังตรวจสอบสลิป' : 'กำลังบันทึกสลิป' %><span class="slip-check-dots" aria-hidden="true"><i></i><i></i><i></i></span></h2>
    <p id="slipStatusMessage" class="slip-check-message" aria-live="polite"><%= automaticSlipCheck ? 'ระบบกำลังตรวจสอบรายการให้คุณ กรุณาอย่าปิดหรือย้อนกลับหน้านี้' : 'กำลังบันทึกสลิปของคุณ กรุณารอสักครู่' %></p>
    <a id="slipStatusReturn" data-slip-verification-allow href="/account/topup" class="hidden">กลับหน้ารายการเติมเงิน</a>
  </div>
</div>
<script>
  (function () {
    var box = document.getElementById('slipDeadline');
    var countdown = document.getElementById('slipCountdown');
    var hint = document.getElementById('slipDeadlineHint');
    if (!box || !countdown) return;
    var deadline = Number(box.dataset.deadline);
    var timer = null;
    function updateCountdown() {
      var remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
      var minutes = Math.floor(remaining / 60);
      var seconds = remaining % 60;
      countdown.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
      if (remaining <= 0) {
        box.classList.remove('border-amber-500/50', 'bg-amber-500/10');
        box.classList.add('border-[var(--coral)]/50', 'bg-[var(--coral)]/10');
        countdown.classList.remove('text-amber-400');
        countdown.classList.add('text-[var(--coral)]');
        if (hint) hint.textContent = 'หมดเวลาแล้ว กรุณาตรวจสอบให้แน่ใจว่าสลิปเป็นรายการล่าสุด';
        return false;
      }
      if (hint) hint.textContent = 'เหลือ ' + remaining + ' วินาทีสำหรับโอนและแนบสลิป';
      return true;
    }
    if (updateCountdown()) {
      timer = setInterval(function () {
        if (!updateCountdown()) clearInterval(timer);
      }, 1000);
      document.addEventListener('lilteam:page-unloading', function () {
        if (timer) clearInterval(timer);
      }, { once: true });
    }
  })();
  (function () {
    var root = document.documentElement;
    var body = document.body;
    var form = document.getElementById('slipUploadForm');
    var overlay = document.getElementById('slipUploadOverlay');
    var title = document.getElementById('slipStatusTitle');
    var message = document.getElementById('slipStatusMessage');
    var returnLink = document.getElementById('slipStatusReturn');
    var locked = false;
    var allowUnloadOnce = false;
    var lockedScrollY = 0;
    var previousBodyStyles = null;
    var historyPushed = false;
    if (!overlay) return;

    function setCopy(nextTitle, nextMessage, showReturn) {
      if (title && nextTitle) title.textContent = nextTitle;
      if (message && nextMessage) message.textContent = nextMessage;
      if (returnLink) returnLink.classList.toggle('hidden', !showReturn);
      var spinner = overlay.querySelector('.slip-check-spinner');
      if (spinner) spinner.classList.toggle('hidden', Boolean(showReturn));
    }

    function unlockPage() {
      if (!locked) return;
      locked = false;
      delete root.dataset.slipVerificationLocked;
      root.classList.remove('slip-verification-active');
      body.classList.remove('slip-verification-active');
      if (previousBodyStyles) {
        body.style.position = previousBodyStyles.position;
        body.style.top = previousBodyStyles.top;
        body.style.left = previousBodyStyles.left;
        body.style.right = previousBodyStyles.right;
        body.style.width = previousBodyStyles.width;
        body.style.touchAction = previousBodyStyles.touchAction;
      }
      window.scrollTo(0, lockedScrollY);
      if (overlay) overlay.classList.add('hidden');
      window.__lilteamSlipVerificationUnlock = null;
    }

    function lockPage(allowUnload) {
      if (locked) return;
      locked = true;
      allowUnloadOnce = Boolean(allowUnload);
      lockedScrollY = window.scrollY || window.pageYOffset || 0;
      previousBodyStyles = {
        position: body.style.position,
        top: body.style.top,
        left: body.style.left,
        right: body.style.right,
        width: body.style.width,
        touchAction: body.style.touchAction,
      };
      root.dataset.slipVerificationLocked = 'true';
      root.classList.add('slip-verification-active');
      body.classList.add('slip-verification-active');
      body.style.position = 'fixed';
      body.style.top = '-' + lockedScrollY + 'px';
      body.style.left = '0';
      body.style.right = '0';
      body.style.width = '100%';
      body.style.touchAction = 'none';
      if (!historyPushed) {
        historyPushed = true;
        history.pushState(Object.assign({}, history.state || {}, {
          lilteamNavigation: true,
          slipVerificationLock: true,
          scrollX: window.scrollX,
          scrollY: lockedScrollY,
        }), '', window.location.href);
      }
      overlay.classList.remove('hidden');
      window.__lilteamSlipVerificationUnlock = unlockPage;
    }

    function guardPointer(event) {
      if (!locked) return;
      var allowed = event.target && event.target.closest ? event.target.closest('#slipStatusReturn') : null;
      if (allowed) {
        event.preventDefault();
        event.stopImmediatePropagation();
        unlockPage();
        allowUnloadOnce = true;
        window.location.assign(allowed.href);
        return;
      }
      event.preventDefault();
      event.stopImmediatePropagation();
    }
    function guardScroll(event) {
      if (!locked) return;
      event.preventDefault();
      window.scrollTo(0, lockedScrollY);
    }
    function guardKeys(event) {
      if (!locked) return;
      var keys = [' ', 'PageUp', 'PageDown', 'Home', 'End', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'];
      if (keys.indexOf(event.key) !== -1) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    }
    document.addEventListener('click', guardPointer, true);
    document.addEventListener('wheel', guardScroll, { capture: true, passive: false });
    document.addEventListener('touchmove', guardScroll, { capture: true, passive: false });
    document.addEventListener('keydown', guardKeys, true);
    window.addEventListener('beforeunload', function (event) {
      if (!locked || allowUnloadOnce) return;
      event.preventDefault();
      event.returnValue = '';
    });

    if (form) {
      form.setAttribute('data-slip-verification-allow', '');
      form.addEventListener('submit', function (event) {
        if (locked) {
          event.preventDefault();
          return;
        }
        lockPage(true);
        setCopy(<%- JSON.stringify(automaticSlipCheck ? 'กำลังตรวจสอบสลิป' : 'กำลังบันทึกสลิป') %>, <%- JSON.stringify(automaticSlipCheck ? 'ระบบกำลังตรวจสอบรายการให้คุณ กรุณาอย่าปิดหรือย้อนกลับหน้านี้' : 'กำลังบันทึกสลิปของคุณ กรุณารอสักครู่') %>, false);
      });
    }

    <% if (automaticSlipCheck && request.status === 'verifying' && request.slipPath) { %>
    lockPage(false);
    setCopy('กำลังตรวจสอบสลิป', 'ระบบกำลังเลือกคีย์ที่พร้อมใช้งาน แล้วจะแสดงผลทันทีเมื่อการตรวจเสร็จ', false);
    var statusUrl = '/account/topup/<%= request.id %>/status';
    var detailUrl = '/account/topup/<%= request.id %>';
    var attempts = 0;
    var pollingStartedAt = Date.now();
    var pollDeadlineMs = 90000;
    var pageActive = true;
    var stopped = false;
    document.addEventListener('lilteam:page-unloading', function () { pageActive = false; }, { once: true });

    function stopPolling(stopTitle, stopMessage) {
      stopped = true;
      setCopy(stopTitle, stopMessage, true);
    }

    function checkStatus() {
      if (!pageActive || stopped) return;
      if (Date.now() - pollingStartedAt >= pollDeadlineMs) {
        stopPolling('การตรวจใช้เวลานานกว่าปกติ', 'บันทึกสลิปแล้ว ระบบยังตรวจต่ออยู่ คุณกลับมาตรวจสถานะได้จากรายการเติมเงิน');
        return;
      }
      var controller = typeof AbortController === 'function' ? new AbortController() : null;
      var requestTimeout = controller ? window.setTimeout(function () { controller.abort(); }, 8000) : null;
      fetch(statusUrl, { headers: { Accept: 'application/json' }, cache: 'no-store', signal: controller ? controller.signal : undefined })
        .then(function (response) {
          if (requestTimeout) window.clearTimeout(requestTimeout);
          if (!response.ok) throw new Error('status request failed');
          return response.json();
        })
        .then(function (result) {
          if (!pageActive) return;
          if (result.finished === true || (result.status && result.status !== 'verifying')) {
            allowUnloadOnce = true;
            unlockPage();
            window.location.replace(detailUrl);
            return;
          }
          attempts += 1;
          if (attempts >= 50) {
            stopPolling('การตรวจใช้เวลานานกว่าปกติ', 'บันทึกสลิปแล้ว ระบบยังตรวจต่ออยู่ คุณกลับมาตรวจสถานะได้จากรายการเติมเงิน');
            return;
          }
          setTimeout(checkStatus, attempts < 10 ? 1200 : 2000);
        })
        .catch(function () {
          if (requestTimeout) window.clearTimeout(requestTimeout);
          if (!pageActive) return;
          attempts += 1;
          if (attempts >= 50 || Date.now() - pollingStartedAt >= pollDeadlineMs) {
            stopPolling('ระบบตรวจสอบยังไม่ตอบสนอง', 'สลิปถูกบันทึกแล้ว กรุณากลับมาตรวจสถานะอีกครั้งในรายการเติมเงิน');
            return;
          }
          setTimeout(checkStatus, attempts < 10 ? 1500 : 3000);
        });
    }

    checkStatus();
    <% } %>
  })();
</script>
