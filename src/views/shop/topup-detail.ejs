<section class="max-w-lg mx-auto px-4 py-10">
  <a href="/account" class="text-sm text-[var(--gold)]">← กลับไปหน้าบัญชี</a>
  <h1 class="text-2xl font-bold mt-2 mb-1">คำขอเติมเงิน #<%= request.refCode %></h1>
  <p class="text-sm text-[var(--text-3)] mb-6"><%= new Date(request.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>

  <% if (request.status === 'approved') { %>
    <div class="bg-emerald-900/30 border border-emerald-700 rounded-xl p-5 text-center mb-6">
      <div class="text-3xl mb-2">✅</div>
      <div class="text-emerald-300 font-semibold mb-1">อนุมัติแล้ว เติมเงินสำเร็จ</div>
      <div class="text-2xl font-bold text-[var(--gold)]">฿<%= request.amount.toLocaleString() %>.00</div>
      <% if (request.slipCheck && request.slipCheck.verified) { %>
        <p class="text-xs text-emerald-400 mt-2">⚡ ตรวจสอบและอนุมัติอัตโนมัติผ่าน SlipOK</p>
      <% } %>
    </div>
  <% } else if (request.status === 'rejected') { %>
    <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/40 rounded-xl p-5 text-center mb-6">
      <div class="text-3xl mb-2">✕</div>
      <div class="text-[var(--coral)] font-semibold mb-1">คำขอนี้ถูกปฏิเสธ</div>
      <% if (request.reviewNote) { %><p class="text-sm text-[var(--text-3)]"><%= request.reviewNote %></p><% } %>
    </div>
  <% } else if (request.slipPath) { %>
    <div class="bg-[var(--gold)]/10 border border-[var(--gold)]/40 rounded-xl p-4 text-center mb-6 text-sm text-[#e2c084]">
      ⏳ ระบบกำลังตรวจสอบสลิปโดยอัตโนมัติ — เติมเงินให้ทันทีถ้ายอดถูกต้อง
    </div>
  <% } else { %>
    <div class="bg-[var(--gold)]/10 border border-[var(--gold)]/40 rounded-xl p-4 text-center mb-6 text-sm text-[#e2c084]">
      ⏳ โอนเงินแล้วแนบสลิปด้านล่าง ระบบจะตรวจสอบและเติมเงินให้อัตโนมัติทันที
    </div>
  <% } %>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 space-y-4 mb-6">
    <div class="flex justify-between text-sm"><span class="text-[var(--text-3)]">จำนวนเงิน</span><span class="text-[var(--gold)] font-bold text-lg">฿<%= request.amount.toLocaleString() %>.00</span></div>
    <div class="flex justify-between text-sm"><span class="text-[var(--text-3)]">ช่องทาง</span><span><%= request.method === 'promptpay' ? 'พร้อมเพย์ (PromptPay)' : 'โอนผ่านธนาคาร' %></span></div>

    <div class="border-t border-[var(--border)] pt-4">
      <% if (request.method === 'promptpay' && (payment.promptpayQrImage || qrDataUrl)) { %>
        <div class="bg-white rounded-lg p-4 flex flex-col items-center mb-3">
          <img src="<%= payment.promptpayQrImage || qrDataUrl %>" class="w-56 h-56 object-contain" alt="พร้อมเพย์ QR" />
          <p class="text-[var(--bg)] text-xs mt-2 text-center">สแกนด้วยแอปธนาคารเพื่อชำระ ฿<%= request.amount.toLocaleString() %>.00</p>
        </div>
        <div class="text-sm space-y-1">
          <div class="flex justify-between"><span class="text-[var(--text-3)]">พร้อมเพย์</span><span class="font-mono"><%= payment.promptpayId %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ชื่อบัญชี</span><span><%= payment.promptpayName %></span></div>
        </div>
      <% } else if (request.method === 'promptpay') { %>
        <div class="text-sm space-y-1">
          <div class="flex justify-between"><span class="text-[var(--text-3)]">พร้อมเพย์</span><span class="font-mono"><%= payment.promptpayId %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ชื่อบัญชี</span><span><%= payment.promptpayName %></span></div>
        </div>
      <% } else { %>
        <% if (payment.bankQrImage) { %>
          <div class="bg-white rounded-lg p-4 flex flex-col items-center mb-3">
            <img src="<%= payment.bankQrImage %>" class="w-56 h-56 object-contain" alt="QR โอนธนาคาร" />
            <p class="text-[var(--bg)] text-xs mt-2 text-center">สแกนด้วยแอปธนาคารเพื่อชำระ ฿<%= request.amount.toLocaleString() %>.00</p>
          </div>
        <% } %>
        <div class="text-sm space-y-1">
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ธนาคาร</span><span><%= payment.bankName %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">เลขบัญชี</span><span class="font-mono"><%= payment.bankAccountNumber %></span></div>
          <div class="flex justify-between"><span class="text-[var(--text-3)]">ชื่อบัญชี</span><span><%= payment.bankAccountName %></span></div>
        </div>
      <% } %>
      <p class="text-xs text-[var(--text-4)] mt-3">โอนแล้วกรุณาระบุจำนวนเงินให้ตรงเป๊ะ (฿<%= request.amount.toLocaleString() %>.00) เพื่อให้ระบบตรวจสอบอัตโนมัติผ่านและเติมเงินได้ทันที</p>
    </div>
  </div>

  <% if (request.status === 'pending') { %>
    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
      <h2 class="font-semibold mb-3">แนบสลิปการโอนเงิน</h2>
      <% if (request.slipPath) { %>
        <div class="mb-3">
          <img src="<%= request.slipPath %>" class="max-w-full rounded-lg border border-[var(--border)]" alt="สลิปที่แนบ" />
          <% if (request.slipCheck && request.slipCheck.checked && !request.slipCheck.verified) { %>
            <p class="text-xs text-[var(--coral)] mt-2">✕ ตรวจสอบอัตโนมัติไม่ผ่าน: <%= request.slipCheck.message %> — กรุณาตรวจสอบยอดเงิน/สลิปแล้วลองแนบใหม่อีกครั้ง</p>
            <p class="text-xs text-[#e2c084] mt-1">⏳ คำขอนี้ยังอยู่ระหว่างรอแอดมินตรวจสอบด้วยตนเอง ไม่ได้ถูกปฏิเสธ</p>
          <% } else { %>
            <p class="text-xs text-emerald-400 mt-2">✓ แนบสลิปแล้ว รอการตรวจสอบ</p>
          <% } %>
        </div>
      <% } %>
      <form action="/account/topup/<%= request.id %>/slip" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-2">
        <input type="file" name="slip" accept="image/*" required class="min-w-0 flex-1 text-sm text-[var(--text-3)] file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[#332b1a] file:text-[var(--gold)] file:text-sm" />
        <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-4 py-2 sm:py-0 rounded-lg text-sm whitespace-nowrap"><%= request.slipPath ? 'แนบใหม่' : 'แนบสลิป' %></button>
      </form>
      <p class="text-[10px] text-[var(--text-4)] mt-2">⚠️ สลิปต้องเป็นรายการโอนภายใน 5 นาทีล่าสุด และใช้ยืนยันได้ครั้งเดียวเท่านั้น (สลิปเก่าเกิน 5 นาที หรือสลิปที่เคยใช้แล้วจะไม่ผ่านการตรวจสอบ)</p>
    </div>
  <% } %>
</section>
