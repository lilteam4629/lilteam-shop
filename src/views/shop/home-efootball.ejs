<% const available = products.filter(p => p.stockCount > 0); %>
<div class="ef-page" data-efootball-store>
  <section class="ef-hero">
    <div class="ef-hero-copy"><span class="ef-kicker">LILTEAM · eFOOTBALL MARKET</span><h1>สร้างทีม<br><em>ในแบบของคุณ</em></h1><p>เลือกไอดี eFootball จากสินค้าที่มีในร้าน พร้อมตัวกรองผู้เล่นที่ค้นหาได้ทันที</p><div class="ef-stats"><b><%= productTotal %></b><span>ไอดีในร้าน</span><i></i><b><%= available.length %></b><span>พร้อมขาย</span></div></div>
    <div class="ef-hero-cards" aria-label="ผู้เล่นเด่นจาก eFHUB">
      <% efootballFeatured.slice(0, 4).forEach((player, index) => { %><article class="ef-player-card" style="--ef-i:<%= index %>"><img src="<%= player.imageUrl %>" alt="<%= player.name %>" loading="eager"><span class="ef-rating"><%= player.rating %></span><small><%= player.position %></small><b><%= player.name %></b></article><% }) %>
    </div>
  </section>

  <section class="ef-player-index" aria-labelledby="ef-index-title">
    <header class="ef-section-head"><div><span class="ef-kicker">PLAYER FILTER</span><h2 id="ef-index-title">ค้นหาผู้เล่นจาก eFHUB</h2><p>เลือกการ์ดเพื่อกรองไอดีที่ตรงกับผู้เล่นที่คุณต้องการ</p></div><span class="ef-source-badge"><%= efootballFeatured.length %> การ์ด</span></header>
    <div class="ef-controls"><label><span>ค้นหาชื่อผู้เล่น</span><input type="search" data-ef-search placeholder="เช่น Messi, CF, 90"></label><label><span>ตำแหน่ง</span><select data-ef-position><option value="all">ทุกตำแหน่ง</option><% [...new Set(efootballFeatured.map(p => p.position))].sort().forEach(position => { %><option value="<%= position %>"><%= position %></option><% }) %></select></label><label><span>เรตติ้งขั้นต่ำ</span><select data-ef-rating><option value="0">ทั้งหมด</option><option value="86">86+</option><option value="87">87+</option><option value="89">89+</option></select></label><button type="button" data-ef-clear>ล้างตัวกรอง</button></div>
    <div class="ef-filter-summary"><span>เลือกแล้ว <strong data-ef-selected>ทั้งหมด</strong></span><span data-ef-count><%= efootballFeatured.length %> การ์ด</span></div>
    <div class="ef-player-grid" data-ef-grid>
      <% efootballFeatured.forEach(player => { %><button type="button" class="ef-filter-card" data-ef-player data-name="<%= player.name.toLowerCase() %>" data-position="<%= player.position %>" data-rating="<%= player.rating %>" data-id="<%= player.id %>"><span class="ef-card-image"><img src="<%= player.imageUrl %>" alt="<%= player.name %>" loading="lazy"><i><%= player.rating %></i></span><span class="ef-card-copy"><b><%= player.name %></b><small><%= player.position %> · eFootball</small></span></button><% }) %>
    </div>
    <p class="ef-empty" data-ef-empty hidden>ไม่พบผู้เล่นที่ตรงกับตัวกรอง</p>
  </section>

  <section class="ef-products" aria-labelledby="ef-products-title"><header class="ef-section-head"><div><span class="ef-kicker">SHOP INVENTORY</span><h2 id="ef-products-title">ไอดี eFootball ในร้าน</h2><p>ข้อมูลสินค้า ราคา และสต็อกยังใช้ระบบร้านเดิม</p></div><a href="/products" class="ef-all-link">ดูสินค้าทั้งหมด ↗</a></header><div class="ef-product-grid"><% products.forEach(p => { %><article class="ef-product-card <%= p.stockCount ? '' : 'is-sold' %>"><div class="ef-product-image"><% if (p.images && p.images[0]) { %><img src="<%= p.images[0] %>" alt="<%= p.title %>" loading="lazy"><% } else { %><span>eF</span><% } %></div><div class="ef-product-body"><div><small><%= p.stockCount ? 'พร้อมขาย' : 'สินค้าหมด' %></small><h3><%= p.title %></h3></div><strong>฿<%= Number(p.price).toLocaleString() %></strong><a href="/game/<%= p.slug %>"><%= p.stockCount ? 'ดูรายละเอียด' : 'ดูสินค้า' %> ↗</a></div></article><% }) %></div></section>
  <footer class="ef-credit">รูปการ์ดผู้เล่นอ้างอิงจาก <a href="https://efhub.com/th" target="_blank" rel="noopener">eFHUB ↗</a> · สินค้าและสต็อกเป็นข้อมูลของร้านนี้</footer>
</div>
<style>
body.storefront-model-efootball{--ef-bg:#07090e;--ef-panel:#111620;--ef-panel-2:#171e2d;--ef-line:#8ea3c533;--ef-text:#f5f8ff;--ef-muted:#9caaca;--ef-cyan:#8ce7ff;--ef-lime:#cfff64;background:radial-gradient(circle at 78% 2%,#153753 0,transparent 35%),var(--ef-bg)!important;color:var(--ef-text)!important}body.storefront-model-efootball #site-page-shell{background:transparent!important}.ef-page{width:min(1240px,calc(100% - 32px));margin:auto;padding:28px 0 65px;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.ef-hero,.ef-player-index,.ef-products{border:1px solid var(--ef-line);border-radius:24px;background:linear-gradient(145deg,#131a28f2,#0d121df2);box-shadow:0 25px 80px #0008}.ef-hero{display:grid;grid-template-columns:1fr 1fr;min-height:350px;overflow:hidden;position:relative}.ef-hero:after{content:'';position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:56px 56px}.ef-hero-copy{padding:58px 48px;position:relative;z-index:1}.ef-kicker{font-size:11px;letter-spacing:.18em;color:var(--ef-cyan);font-weight:900}.ef-hero h1{font-size:clamp(46px,6vw,78px);line-height:.93;letter-spacing:-.07em;margin:18px 0;font-weight:950}.ef-hero h1 em{color:var(--ef-lime);font-style:normal}.ef-hero-copy p{max-width:480px;color:#c4cede;font-size:17px;line-height:1.65}.ef-stats{display:flex;align-items:baseline;gap:8px;margin-top:26px;color:var(--ef-muted)}.ef-stats b{color:var(--ef-lime);font-size:27px}.ef-stats i{height:22px;width:1px;background:#fff3;margin:0 13px}.ef-hero-cards{display:flex;align-items:center;justify-content:center;padding:35px 38px;position:relative;z-index:1}.ef-player-card{width:25%;max-width:150px;margin-left:-5%;background:#f5f7fb;color:#1a2534;border-radius:16px;padding:8px;box-shadow:0 24px 40px #0008;transform:rotate(calc((var(--ef-i) - 1.5)*6deg)) translateY(calc(abs(var(--ef-i) - 1.5)*14px));position:relative;overflow:hidden}.ef-player-card:first-child{margin-left:0}.ef-player-card img{display:block;width:100%;aspect-ratio:4/5.7;object-fit:cover;border-radius:10px}.ef-player-card .ef-rating{position:absolute;top:13px;left:14px;font-weight:950;font-size:20px;color:#fff;text-shadow:0 2px 5px #000}.ef-player-card>small{display:block;color:#4b5d78;font-size:10px;font-weight:900;margin-top:4px}.ef-player-card>b{display:block;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ef-player-index,.ef-products{margin-top:24px;padding:28px}.ef-section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.ef-section-head h2{font-size:27px;line-height:1.05;margin-top:8px;font-weight:950;letter-spacing:-.04em}.ef-section-head p{color:var(--ef-muted);margin-top:7px}.ef-source-badge,.ef-all-link{border:1px solid var(--ef-line);border-radius:999px;padding:9px 13px;color:var(--ef-cyan);font-size:12px;font-weight:800;white-space:nowrap}.ef-all-link{color:var(--ef-lime)}.ef-controls{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:11px;align-items:end}.ef-controls label span{display:block;color:var(--ef-muted);font-size:12px;margin:0 0 6px 3px}.ef-controls input,.ef-controls select,.ef-controls button{height:46px;width:100%;border:1px solid var(--ef-line);border-radius:11px;background:#090e18;color:var(--ef-text);padding:0 13px}.ef-controls button{width:auto;padding:0 16px;cursor:pointer;font-weight:800}.ef-filter-summary{display:flex;justify-content:space-between;gap:12px;margin:15px 0;padding:10px 13px;background:#0a101b;border-radius:10px;color:var(--ef-muted);font-size:12px}.ef-filter-summary strong{color:var(--ef-lime)}.ef-player-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}.ef-filter-card{border:1px solid var(--ef-line);border-radius:12px;background:#f4f7fb;color:#172235;padding:6px;text-align:left;cursor:pointer;transition:transform .18s,border-color .18s,box-shadow .18s}.ef-filter-card:hover,.ef-filter-card.is-selected{transform:translateY(-3px);border-color:var(--ef-cyan);box-shadow:0 10px 22px #0006}.ef-card-image{display:block;position:relative}.ef-card-image img{display:block;width:100%;aspect-ratio:4/5.7;object-fit:cover;border-radius:8px}.ef-card-image i{position:absolute;top:5px;left:6px;color:#fff;font-size:12px;font-style:normal;font-weight:950;text-shadow:0 1px 4px #000}.ef-card-copy{display:block;min-width:0;margin-top:6px}.ef-card-copy b,.ef-card-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ef-card-copy b{font-size:11px}.ef-card-copy small{font-size:9px;color:#60718a;margin-top:2px}.ef-empty{text-align:center;color:var(--ef-muted);padding:30px}.ef-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.ef-product-card{border:1px solid var(--ef-line);border-radius:14px;background:#0d131f;overflow:hidden;transition:transform .2s,border-color .2s}.ef-product-card:hover{transform:translateY(-3px);border-color:#cfff6488}.ef-product-card.is-sold{opacity:.58}.ef-product-image{height:145px;background:#070c15;display:grid;place-items:center;overflow:hidden}.ef-product-image img{width:100%;height:100%;object-fit:cover}.ef-product-image span{font-size:38px;color:var(--ef-cyan);font-weight:950}.ef-product-body{display:grid;grid-template-columns:1fr auto;gap:8px;padding:14px}.ef-product-body small{color:var(--ef-cyan);font-size:10px}.ef-product-body h3{font-size:16px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ef-product-body>strong{color:var(--ef-lime);font-size:20px}.ef-product-body>a{grid-column:1/-1;border-radius:9px;background:var(--ef-lime);color:#0b1018!important;text-align:center;padding:9px;font-size:12px;font-weight:900}.ef-credit{text-align:center;color:#7f8da4;font-size:12px;margin-top:22px}.ef-credit a{color:var(--ef-cyan)!important}@media(max-width:900px){.ef-player-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.ef-controls{grid-template-columns:1.5fr 1fr 1fr}.ef-controls button{grid-column:1/-1}.ef-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.ef-page{width:min(100% - 18px,620px);padding:14px 0 46px}.ef-hero{display:block}.ef-hero-copy{padding:34px 24px 16px}.ef-hero h1{font-size:49px}.ef-hero-cards{padding:18px 17px 30px}.ef-player-card{width:24%;padding:5px;border-radius:11px}.ef-player-card .ef-rating{top:9px;left:9px;font-size:14px}.ef-player-card>small{font-size:8px}.ef-player-card>b{font-size:8px}.ef-player-index,.ef-products{padding:20px 15px;border-radius:18px}.ef-section-head{align-items:flex-start;flex-direction:column;gap:10px}.ef-section-head h2{font-size:23px}.ef-controls{grid-template-columns:1fr 1fr}.ef-controls label:first-child{grid-column:1/-1}.ef-player-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.ef-product-grid{grid-template-columns:1fr}.ef-product-image{height:180px}}
</style>
<script>
(() => { const root=document.querySelector('[data-efootball-store]'); if(!root)return; const cards=[...root.querySelectorAll('[data-ef-player]')],search=root.querySelector('[data-ef-search]'),position=root.querySelector('[data-ef-position]'),rating=root.querySelector('[data-ef-rating]'),clear=root.querySelector('[data-ef-clear]'),count=root.querySelector('[data-ef-count]'),selected=root.querySelector('[data-ef-selected]'),empty=root.querySelector('[data-ef-empty]'); let chosen=new Set(); function render(){const q=(search.value||'').trim().toLowerCase(),pos=position.value,min=Number(rating.value||0);let visible=0;cards.forEach(card=>{const ok=(!q||card.dataset.name.includes(q)||card.dataset.position.toLowerCase().includes(q)||card.dataset.rating.includes(q))&&(pos==='all'||card.dataset.position===pos)&&Number(card.dataset.rating)>=min;card.hidden=!ok;if(ok)visible++;card.classList.toggle('is-selected',chosen.has(card.dataset.id));});count.textContent=`${visible} การ์ด`;selected.textContent=chosen.size?`${chosen.size} ผู้เล่น`:'ทั้งหมด';empty.hidden=visible>0;}cards.forEach(card=>card.addEventListener('click',()=>{const id=card.dataset.id;if(chosen.has(id))chosen.delete(id);else chosen.add(id);render();}));[search,position,rating].forEach(el=>el.addEventListener('input',render));clear.addEventListener('click',()=>{search.value='';position.value='all';rating.value='0';chosen.clear();render();});render(); })();
</script>
