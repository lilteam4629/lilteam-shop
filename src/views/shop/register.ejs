<section class="max-w-md mx-auto px-4 py-14">
  <h1 class="text-2xl font-bold mb-6 text-center">สมัครสมาชิก</h1>
  <form action="/register" method="post" class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 space-y-4">
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ชื่อผู้ใช้</label>
      <input name="username" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--gold)]" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">อีเมล</label>
      <input type="email" name="email" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--gold)]" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">รหัสผ่าน</label>
      <input type="password" name="password" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--gold)]" />
    </div>
    <div>
      <label class="block text-sm mb-1 text-[var(--text-3)]">ยืนยันรหัสผ่าน</label>
      <input type="password" name="confirmPassword" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--gold)]" />
    </div>
    <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] rounded-lg py-2.5 font-medium">สมัครสมาชิก</button>
  </form>
  <p class="text-center text-sm text-[var(--text-3)] mt-4">มีบัญชีอยู่แล้ว? <a href="/login" class="text-[var(--gold)]">เข้าสู่ระบบ</a></p>
</section>
