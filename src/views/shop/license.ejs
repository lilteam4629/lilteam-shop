<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ปลดล็อกระบบ | <%= settings.shopName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Kanit', sans-serif; background: #100e08; color: #f3ecd8; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-[#1a160d] border border-[#3a3220] rounded-2xl p-6">
    <h1 class="text-xl font-bold mb-1 text-center">🔒 ปลดล็อกระบบ</h1>
    <p class="text-sm text-[#a89a6c] text-center mb-5"><%= settings.shopName %></p>

    <% if (messages.error && messages.error.length) { %>
      <% messages.error.forEach(m => { %>
        <div class="bg-[#e2836f]/10 border border-[#e2836f]/50 text-[#e2836f] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>
    <% if (messages.success && messages.success.length) { %>
      <% messages.success.forEach(m => { %>
        <div class="bg-emerald-900/40 border border-emerald-700 text-emerald-300 px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
      <% }) %>
    <% } %>

    <% if (active) { %>
      <div class="bg-emerald-900/30 border border-emerald-700 text-emerald-300 px-4 py-3 rounded-lg mb-4 text-sm text-center">
        ✓ ใช้งานอยู่<% if (label) { %> — <%= label %><% } %><br />
        หมดอายุ: <%= new Date(expiresAt).toLocaleDateString('th-TH') %>
      </div>
      <a href="/" class="block text-center bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-2.5 text-sm mb-4">กลับหน้าร้าน →</a>
      <p class="text-xs text-[#7a6f47] text-center mb-2">มีคีย์ต่ออายุใหม่? กรอกที่นี่เพื่อเพิ่มเวลา (จะบวกเพิ่มจากเวลาที่เหลืออยู่ ไม่เสียเวลาเดิม)</p>
      <form action="/license" method="post" class="space-y-3">
        <input name="key" required placeholder="กรอกคีย์ต่ออายุที่นี่" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm text-center font-mono" />
        <button class="w-full bg-[#443a22] hover:bg-[#544824] text-[#f3ecd8] font-semibold rounded-lg py-2.5 text-sm">ต่ออายุ</button>
      </form>
    <% } else { %>
      <form action="/license" method="post" class="space-y-3">
        <input name="key" required placeholder="กรอกคีย์เปิดใช้งานที่นี่" class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm text-center font-mono" />
        <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-2.5 text-sm">ปลดล็อก</button>
      </form>
      <p class="text-xs text-[#7a6f47] text-center mt-4">ไม่มีคีย์? ติดต่อผู้ให้บริการที่คุณเช่าระบบนี้มา</p>
    <% } %>
  </div>
</body>
</html>
