<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-8">
  <a href="javascript:history.back()" class="text-sm text-[var(--gold)]">← กลับหน้าร้าน</a>

  <div class="grid md:grid-cols-2 gap-8 mt-4">
    <div>
      <div class="w-fit max-w-full mx-auto overflow-hidden rounded-2xl mb-3">
        <img src="<%= product.images[0] %>" class="block w-auto max-w-full h-auto max-h-[75vh] object-contain" alt="<%= product.title %>" />
      </div>
      <% if (product.images.length > 1) { %>
        <div class="grid grid-cols-4 gap-2">
          <% product.images.slice(1).forEach(img => { %>
            <div class="aspect-video rounded-lg overflow-hidden border border-[var(--border)]">
              <img src="<%= img %>" class="w-full h-full object-contain bg-black" />
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-[var(--gold)]/10 border border-[var(--gold)]/30 text-[var(--gold)] text-xs px-2 py-1 rounded">สินค้าเกม</span>
        <% if (product.stockCount > 0) { %>
          <span class="text-emerald-400 text-xs">พร้อมส่งทันที</span>
        <% } else { %>
          <span class="text-[var(--coral)] text-xs">สินค้าหมด</span>
        <% } %>
        <button onclick="navigator.clipboard && navigator.clipboard.writeText(window.location.href); this.textContent='คัดลอกแล้ว'"
          class="ml-auto text-xs text-[var(--text-3)] hover:text-[var(--gold)] border border-[var(--border-light)] rounded-lg px-2 py-1">คัดลอกลิงก์</button>
      </div>

      <h1 class="text-2xl font-bold mb-2"><%= product.title %></h1>
      <% if (product.flashSaleActive || product.flashSaleUpcoming) { %>
        <% const detailFlashTarget = product.flashSaleActive ? product.flashSaleEndsAt : product.flashSaleStartsAt; const detailFlashSeconds = Math.max(0, Math.floor((detailFlashTarget - Date.now()) / 1000)); const detailFlashInitial = (Math.floor(detailFlashSeconds / 86400) ? Math.floor(detailFlashSeconds / 86400) + ' วัน ' : '') + [Math.floor((detailFlashSeconds % 86400) / 3600), Math.floor((detailFlashSeconds % 3600) / 60), detailFlashSeconds % 60].map(n => String(n).padStart(2, '0')).join(':'); %>
        <div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/55 bg-gradient-to-r from-[var(--input)] to-[var(--card)] px-4 py-3">
          <div><div class="font-black text-[var(--gold)]">⚡ FLASH SALE</div><div class="text-xs text-[var(--text-3)]"><%= product.flashSaleActive ? 'ราคาพิเศษกำลังเปิดขาย' : 'เตรียมพบราคาพิเศษ' %></div></div>
          <div class="min-w-[7.5rem] rounded-lg border border-[var(--gold)]/45 bg-black/35 px-3 py-2 text-center"><div class="text-[10px] font-medium text-[var(--gold)]"><%= product.flashSaleActive ? 'เหลือเวลา' : 'เริ่มใน' %></div><div class="flash-countdown mt-0.5 whitespace-nowrap font-mono text-xl sm:text-2xl font-black tracking-wide text-[var(--gold-light)]" <% if (product.flashSaleActive) { %>data-flash-end="<%= product.flashSaleEndsAt %>"<% } else { %>data-flash-start="<%= product.flashSaleStartsAt %>"<% } %>><%= detailFlashInitial %></div></div>
        </div>
      <% } %>
      <div class="flex flex-wrap gap-2 mb-3">
        <% genreNames.forEach(g => { %>
          <span class="text-xs bg-[var(--input)] border border-[var(--border-light)] text-[var(--text-2)] px-2 py-1 rounded-full"><%= g %></span>
        <% }) %>
      </div>
      <% const qtyTiers = (product.priceOptions || []).slice().sort((a, b) => a.minQty - b.minQty); %>
      <% if (qtyTiers.length) { %>
        <div class="mb-1 text-xs text-[var(--text-3)]">ราคา</div>
        <div class="flex items-baseline gap-2 mb-3">
          <span class="text-3xl font-bold text-[var(--gold)]">฿<span data-unit-price><%= product.price.toLocaleString() %></span></span>
          <span class="text-sm text-[var(--text-3)]">/ ชิ้น</span>
        </div>
        <div class="mb-5">
          <div class="text-xs font-semibold text-[var(--gold)] flex items-center gap-1.5 mb-2">
            <% if (settings.branding && settings.branding.logoImage) { %>
              <img src="<%= settings.branding.logoImage %>" alt="" class="w-4 h-4 rounded object-contain" />
            <% } else { %>📦<% } %>
            ซื้อเยอะยิ่งถูก — กดเลือกจำนวนได้เลย
          </div>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" class="qty-tier-btn" data-tier-min="1">
              <div class="qty-tier-btn-qty">1 ชิ้น</div>
              <div class="qty-tier-btn-price">฿<%= product.price.toLocaleString() %></div>
              <div class="qty-tier-btn-unit">/ชิ้น</div>
            </button>
            <% qtyTiers.forEach((opt, i) => { %>
              <button type="button" class="qty-tier-btn <%= i === qtyTiers.length - 1 ? 'is-best' : '' %>" data-tier-min="<%= opt.minQty %>">
                <% if (i === qtyTiers.length - 1) { %><span class="qty-tier-badge">คุ้มสุด</span><% } %>
                <div class="qty-tier-btn-qty"><%= opt.minQty %> ชิ้น</div>
                <div class="qty-tier-btn-price">฿<%= (opt.minQty * opt.price).toLocaleString() %></div>
                <div class="qty-tier-btn-unit">฿<%= opt.price.toLocaleString() %>/ชิ้น</div>
              </button>
            <% }) %>
          </div>
        </div>
        <style>
          .qty-tier-btn{position:relative;display:flex;flex-direction:column;align-items:center;gap:.15rem;padding:.75rem .5rem;border-radius:1rem;border:1px solid var(--border-light);background:linear-gradient(160deg,var(--card),var(--input));cursor:pointer;transition:transform .15s,border-color .15s,box-shadow .15s}
          .qty-tier-btn:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--gold) 60%,var(--border-light))}
          .qty-tier-btn.is-active{border-color:var(--gold);background:linear-gradient(160deg,color-mix(in srgb,var(--gold) 18%,var(--card)),color-mix(in srgb,var(--gold) 10%,var(--input)));box-shadow:0 0 0 1px var(--gold),0 10px 24px -14px color-mix(in srgb,var(--gold) 70%,transparent)}
          .qty-tier-btn-qty{font-size:.78rem;font-weight:700;color:var(--text-2)}
          .qty-tier-btn.is-active .qty-tier-btn-qty{color:var(--gold)}
          .qty-tier-btn-price{font-size:1.05rem;font-weight:900;color:var(--gold)}
          .qty-tier-btn-unit{font-size:.65rem;color:var(--text-4)}
          .qty-tier-badge{position:absolute;top:-.55rem;left:50%;transform:translateX(-50%);font-size:.6rem;font-weight:800;background:var(--gold);color:var(--bg);border-radius:999px;padding:.1rem .5rem;white-space:nowrap;box-shadow:0 4px 10px -4px rgba(0,0,0,.5)}
          .qty-stepper-btn{width:2.5rem;height:2.5rem;display:grid;place-items:center;font-weight:800;font-size:1.1rem;border:1px solid var(--border-light);background:var(--input);color:var(--text-2);transition:background .15s,color .15s}
          .qty-stepper-btn:hover{background:var(--gold);color:var(--bg);border-color:var(--gold)}
          .qty-stepper-btn:first-child{border-radius:.7rem 0 0 .7rem}
          .qty-stepper-btn:last-child{border-radius:0 .7rem .7rem 0}
          #qty-input{-moz-appearance:textfield}
          #qty-input::-webkit-outer-spin-button,#qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
        </style>
      <% } else { %>
        <div class="mb-1 text-xs text-[var(--text-3)]">ราคา</div>
        <div class="flex items-baseline gap-2 mb-5">
          <span class="text-3xl font-bold text-[var(--gold)]">฿<%= product.price.toLocaleString() %>.00</span>
          <% const crossedPrice = product.flashSaleActive ? product.regularPrice : product.originalPrice; %>
          <% if (crossedPrice > product.price) { %>
            <span class="text-[var(--coral)] line-through text-sm">฿<%= crossedPrice.toLocaleString() %>.00</span>
          <% } %>
        </div>
      <% } %>

      <% if (product.stockCount > 0) { %>
        <form action="/cart/add/<%= product.id %>" method="post" <%= product.purchaseApprovalEnabled ? 'class="relative overflow-hidden rounded-2xl border border-[var(--gold)]/40 bg-gradient-to-br from-[var(--card)] to-[var(--input)] p-5 shadow-lg"' : '' %>>
          <% if (qtyTiers.length) { %>
            <div class="flex flex-wrap items-center gap-4 mb-4" data-qty-wrap data-base-price="<%= product.price %>" data-tiers='<%- JSON.stringify(qtyTiers) %>'>
              <div>
                <label class="block text-xs text-[var(--text-3)] mb-1" for="qty-input">จำนวน</label>
                <div class="flex items-stretch">
                  <button type="button" class="qty-stepper-btn" data-qty-step="-1" aria-label="ลดจำนวน">−</button>
                  <input type="number" id="qty-input" name="qty" value="1" min="1" class="w-16 text-center bg-[var(--input)] border-y border-[var(--border-light)] text-sm font-semibold" data-qty-input />
                  <button type="button" class="qty-stepper-btn" data-qty-step="1" aria-label="เพิ่มจำนวน">+</button>
                </div>
              </div>
              <div>
                <div class="text-xs text-[var(--text-3)] mb-1">ยอดรวม</div>
                <div class="text-xl font-black text-[var(--gold)]" data-subtotal>฿<%= product.price.toLocaleString() %></div>
              </div>
            </div>
            <script>
              document.querySelectorAll('[data-qty-wrap]').forEach(function(wrap){
                const basePrice = Number(wrap.dataset.basePrice);
                const tiers = JSON.parse(wrap.dataset.tiers || '[]');
                const input = wrap.querySelector('[data-qty-input]');
                function resolveTierMin(qty){
                  let min = 1;
                  tiers.forEach(function(t){ if (qty >= t.minQty) min = t.minQty; });
                  return min;
                }
                function resolvePrice(qty){
                  let price = basePrice;
                  tiers.forEach(function(t){ if (qty >= t.minQty) price = t.price; });
                  return price;
                }
                function update(){
                  const qty = Math.max(1, parseInt(input.value, 10) || 1);
                  const unit = resolvePrice(qty);
                  const activeMin = resolveTierMin(qty);
                  const unitEl = document.querySelector('[data-unit-price]');
                  const subEl = wrap.querySelector('[data-subtotal]');
                  if (unitEl) unitEl.textContent = unit.toLocaleString();
                  if (subEl) subEl.textContent = '฿' + (unit * qty).toLocaleString();
                  document.querySelectorAll('.qty-tier-btn').forEach(function(btn){
                    btn.classList.toggle('is-active', Number(btn.dataset.tierMin) === activeMin);
                  });
                }
                input.addEventListener('input', update);
                wrap.querySelectorAll('[data-qty-step]').forEach(function(btn){
                  btn.addEventListener('click', function(){
                    const current = Math.max(1, parseInt(input.value, 10) || 1);
                    input.value = Math.max(1, current + Number(btn.dataset.qtyStep));
                    update();
                  });
                });
                document.querySelectorAll('.qty-tier-btn').forEach(function(btn){
                  btn.addEventListener('click', function(){
                    input.value = Number(btn.dataset.tierMin);
                    update();
                  });
                });
                update();
              });
            </script>
          <% } %>
          <% if (product.purchaseApprovalEnabled) { %>
            <div class="relative flex items-center gap-3 mb-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[var(--gold)] text-[var(--bg)] font-black">1</span>
              <div><div class="font-semibold text-[var(--gold)]">เตรียมให้พร้อมก่อนซื้อ</div><div class="text-xs text-[var(--text-4)]">ทำตามขั้นตอน แล้วติ๊กเพื่อยืนยัน</div></div>
            </div>
            <label class="relative flex items-start gap-3 rounded-xl border border-[var(--border-light)] bg-[var(--bg)]/55 p-4 cursor-pointer transition hover:border-[var(--gold)]/60">
              <input data-purchase-confirm type="checkbox" name="purchaseConfirmed" value="yes" required class="peer mt-0.5 h-6 w-6 shrink-0 accent-[var(--gold)]" />
              <span class="text-sm font-medium leading-relaxed peer-checked:text-[var(--gold-light)]"><%= product.purchaseConfirmationText || 'ฉันตรวจสอบข้อมูลและยืนยันว่าพร้อมทำตามเงื่อนไขของสินค้านี้' %></span>
            </label>
            <div class="relative mt-4 grid gap-2 sm:grid-cols-2">
              <% if (product.purchaseActionUrl) { %>
                <a href="<%= product.purchaseActionUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[var(--gold)]/50 bg-[var(--input)] px-5 py-3 text-center text-sm font-semibold text-[var(--gold)] transition hover:-translate-y-0.5 hover:border-[var(--gold)] hover:bg-[var(--gold)]/10">↗ <%= product.purchaseActionLabel || 'ไปทำขั้นตอนนี้ก่อน' %></a>
              <% } %>
              <button data-purchase-submit disabled class="min-h-12 rounded-xl bg-[var(--gold)] px-6 py-3 text-sm font-bold text-[var(--bg)] opacity-50 transition enabled:hover:-translate-y-0.5 enabled:hover:bg-[var(--gold-hover)] disabled:cursor-not-allowed <%= product.purchaseActionUrl ? '' : 'sm:col-span-2' %>">✓ ยืนยันและเพิ่มลงตะกร้า</button>
            </div>
          <% } %>
          <% if (!product.purchaseApprovalEnabled) { %><button class="w-full sm:w-auto px-8 py-3 rounded-lg font-medium bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)]">เพิ่มลงตะกร้า</button><% } %>
        </form>
      <% } else { %>
        <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/40 text-[var(--coral)] text-sm rounded-lg px-4 py-3">สินค้าหมด กรุณาเลือกสินค้าอื่น</div>
      <% } %>
      <a href="/contact" class="inline-flex mt-2 w-full sm:w-auto px-6 py-3 rounded-lg font-medium justify-center bg-[var(--input)] border border-[var(--border-light)] hover:border-[var(--gold)] hover:text-[var(--gold)]">💬 ติดต่อร้าน</a>

      <% if (product.fulfillmentMode === 'contact' && product.fulfillmentInstructions) { %>
        <div class="mt-4 bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-xl p-4 text-sm">
          <div class="font-medium text-[var(--gold)] mb-1">ข้อมูลที่ต้องเตรียมสำหรับรับสินค้า</div>
          <div class="text-[var(--text-2)] whitespace-pre-line"><%= product.fulfillmentInstructions %></div>
        </div>
      <% } %>

      <% if (product.howToReceiveEnabled !== false) { %>
        <% const howToReceiveText = product.howToReceiveText || 'รับข้อมูลสินค้าทันทีหลังชำระเงินสำเร็จ ตรวจสอบได้ที่หน้าคำสั่งซื้อของคุณ\nระบบส่งมอบอัตโนมัติตลอด 24 ชั่วโมง\nหากติดปัญหาแจ้งทางร้านได้ที่หน้าติดต่อร้าน'; %>
        <div class="mt-6 bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 text-sm space-y-2">
          <div class="font-medium text-[var(--gold)] mb-1">วิธีรับสินค้า</div>
          <% howToReceiveText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
            <p class="text-[var(--text-2)]">✅ <%= line %></p>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="mt-10">
    <div class="flex gap-1 border-b border-[var(--border)] text-sm overflow-x-auto" id="tabbar">
      <button data-tab="terms" class="tab-btn px-4 py-2 border-b-2 border-[var(--gold)] text-[var(--gold)] whitespace-nowrap">เงื่อนไข</button>
      <button data-tab="gallery" class="tab-btn px-4 py-2 border-b-2 border-transparent text-[var(--text-3)] hover:text-[var(--text-2)] whitespace-nowrap">ภาพเกม</button>
      <button data-tab="about" class="tab-btn px-4 py-2 border-b-2 border-transparent text-[var(--text-3)] hover:text-[var(--text-2)] whitespace-nowrap">รายละเอียด</button>
    </div>

    <div id="tab-terms" class="tab-panel py-6 text-sm text-[var(--text-2)] space-y-4">
      <% if (product.termsBeforeOrderEnabled !== false) { %>
        <% const termsBeforeOrderText = product.termsBeforeOrderText || 'กรุณาตรวจสอบชื่อสินค้า รายละเอียด และราคาก่อนยืนยันคำสั่งซื้อ\nข้อมูลสินค้าจะปรากฏในหน้าคำสั่งซื้อหลังชำระเงินสำเร็จ\nห้ามเผยแพร่หรือส่งต่อข้อมูลสินค้าที่ได้รับจากร้าน\nหากพบปัญหา กรุณาติดต่อร้านพร้อมหมายเลขคำสั่งซื้อ'; %>
        <div>
          <div class="font-medium text-[var(--text)] mb-2">เงื่อนไขก่อนสั่งซื้อ</div>
          <ul class="list-disc pl-5 space-y-1">
            <% termsBeforeOrderText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
              <li><%= line %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <% if (product.warrantyEnabled !== false) { %>
        <% const warrantyText = product.warrantyText || 'รับประกันสินค้า 90 วันนับจากวันสั่งซื้อ\nการรับประกันเป็นไปตามรายละเอียดที่ระบุไว้ในสินค้านั้น\nกรุณาเก็บหลักฐานและหมายเลขคำสั่งซื้อไว้สำหรับติดต่อร้าน'; %>
        <div>
          <div class="font-medium text-[var(--text)] mb-2">เงื่อนไขการรับประกันสินค้า</div>
          <ul class="list-disc pl-5 space-y-1">
            <% warrantyText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
              <li><%= line %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <div id="tab-gallery" class="tab-panel py-6 hidden">
      <div class="grid sm:grid-cols-3 gap-3">
        <% product.images.forEach(img => { %>
          <div class="aspect-video rounded-lg overflow-hidden border border-[var(--border)] bg-black"><img src="<%= img %>" class="w-full h-full object-contain" /></div>
        <% }) %>
      </div>
    </div>

    <div id="tab-about" class="tab-panel py-6 hidden text-sm text-[var(--text-2)] leading-relaxed whitespace-pre-line"><%= product.aboutText %></div>
  </div>
</section>

<script>
  (function () {
    const checkbox = document.querySelector('[data-purchase-confirm]');
    const submit = document.querySelector('[data-purchase-submit]');
    if (!checkbox || !submit) return;
    function syncConfirmation() {
      submit.disabled = !checkbox.checked;
      submit.classList.toggle('opacity-50', !checkbox.checked);
      submit.classList.toggle('shadow-lg', checkbox.checked);
    }
    checkbox.addEventListener('change', syncConfirmation);
    syncConfirmation();
  })();

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('border-[var(--gold)]', 'text-[var(--gold)]');
        b.classList.add('border-transparent', 'text-[var(--text-3)]');
      });
      btn.classList.add('border-[var(--gold)]', 'text-[var(--gold)]');
      btn.classList.remove('border-transparent', 'text-[var(--text-3)]');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
    });
  });
</script>
