<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-8">
  <a href="javascript:history.back()" class="text-sm text-[var(--gold)]">← กลับหน้าร้าน</a>

  <div class="grid md:grid-cols-2 gap-8 mt-4">
    <div>
      <div class="w-fit max-w-full mx-auto overflow-hidden rounded-2xl mb-3">
        <img src="<%= product.images[0] %>" class="block w-auto max-w-full h-auto max-h-[75vh] object-contain" alt="<%= product.title %>" />
      </div>
      <% if (product.images.length > 1) { %>
        <div class="grid grid-cols-4 gap-2">
          <% product.images.slice(1).forEach(img => { %>
            <div class="aspect-video rounded-lg overflow-hidden border border-[var(--border)]">
              <img src="<%= img %>" class="w-full h-full object-contain bg-black" />
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-[var(--gold)]/10 border border-[var(--gold)]/30 text-[var(--gold)] text-xs px-2 py-1 rounded">สินค้าเกม</span>
        <% if (product.stockCount > 0) { %>
          <span class="text-emerald-400 text-xs">พร้อมส่งทันที</span>
        <% } else { %>
          <span class="text-[var(--coral)] text-xs">สินค้าหมด</span>
        <% } %>
        <button onclick="navigator.clipboard && navigator.clipboard.writeText(window.location.href); this.textContent='คัดลอกแล้ว'"
          class="ml-auto text-xs text-[var(--text-3)] hover:text-[var(--gold)] border border-[var(--border-light)] rounded-lg px-2 py-1">คัดลอกลิงก์</button>
      </div>

      <h1 class="text-2xl font-bold mb-2"><%= product.title %></h1>
      <% if (product.flashSaleActive || product.flashSaleUpcoming) { %>
        <% const detailFlashTarget = product.flashSaleActive ? product.flashSaleEndsAt : product.flashSaleStartsAt; const detailFlashSeconds = Math.max(0, Math.floor((detailFlashTarget - Date.now()) / 1000)); const detailFlashInitial = (Math.floor(detailFlashSeconds / 86400) ? Math.floor(detailFlashSeconds / 86400) + ' วัน ' : '') + [Math.floor((detailFlashSeconds % 86400) / 3600), Math.floor((detailFlashSeconds % 3600) / 60), detailFlashSeconds % 60].map(n => String(n).padStart(2, '0')).join(':'); %>
        <div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/55 bg-gradient-to-r from-[var(--input)] to-[var(--card)] px-4 py-3">
          <div><div class="font-black text-[var(--gold)]">⚡ FLASH SALE</div><div class="text-xs text-[var(--text-3)]"><%= product.flashSaleActive ? 'ราคาพิเศษกำลังเปิดขาย' : 'เตรียมพบราคาพิเศษ' %></div></div>
          <div class="min-w-[7.5rem] rounded-lg border border-[var(--gold)]/45 bg-black/35 px-3 py-2 text-center"><div class="text-[10px] font-medium text-[var(--gold)]"><%= product.flashSaleActive ? 'เหลือเวลา' : 'เริ่มใน' %></div><div class="flash-countdown mt-0.5 whitespace-nowrap font-mono text-xl sm:text-2xl font-black tracking-wide text-[var(--gold-light)]" <% if (product.flashSaleActive) { %>data-flash-end="<%= product.flashSaleEndsAt %>"<% } else { %>data-flash-start="<%= product.flashSaleStartsAt %>"<% } %>><%= detailFlashInitial %></div></div>
        </div>
      <% } %>
      <div class="flex flex-wrap gap-2 mb-3">
        <% genreNames.forEach(g => { %>
          <span class="text-xs bg-[var(--input)] border border-[var(--border-light)] text-[var(--text-2)] px-2 py-1 rounded-full"><%= g %></span>
        <% }) %>
      </div>
      <div class="mb-1 text-xs text-[var(--text-3)]">ราคา</div>
      <div class="flex items-baseline gap-2 mb-5">
        <span class="text-3xl font-bold text-[var(--gold)]">฿<%= product.price.toLocaleString() %>.00</span>
        <% const crossedPrice = product.flashSaleActive ? product.regularPrice : product.originalPrice; %>
        <% if (crossedPrice > product.price) { %>
          <span class="text-[var(--coral)] line-through text-sm">฿<%= crossedPrice.toLocaleString() %>.00</span>
        <% } %>
      </div>

      <% if (product.stockCount > 0) { %>
        <form action="/cart/add/<%= product.id %>" method="post" <%= product.purchaseApprovalEnabled ? 'class="rounded-2xl border border-[var(--gold)]/35 bg-[var(--card)] p-5"' : '' %>>
          <% if (product.purchaseApprovalEnabled) { %>
            <div class="font-semibold text-[var(--gold)] mb-3">✓ ยืนยันก่อนเพิ่มลงตะกร้า</div>
            <label class="flex items-start gap-3 rounded-xl border border-[var(--border-light)] bg-[var(--input)] p-4 cursor-pointer">
              <input type="checkbox" name="purchaseConfirmed" value="yes" required class="mt-1 h-5 w-5 shrink-0 accent-[var(--gold)]" />
              <span class="text-sm leading-relaxed"><%= product.purchaseConfirmationText || 'ฉันตรวจสอบข้อมูลและยืนยันว่าพร้อมทำตามเงื่อนไขของสินค้านี้' %></span>
            </label>
          <% } %>
          <button class="<%= product.purchaseApprovalEnabled ? 'mt-4 ' : '' %>w-full sm:w-auto px-8 py-3 rounded-lg font-medium bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)]"><%= product.purchaseApprovalEnabled ? 'ยืนยันและเพิ่มลงตะกร้า' : 'เพิ่มลงตะกร้า' %></button>
        </form>
      <% } else { %>
        <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/40 text-[var(--coral)] text-sm rounded-lg px-4 py-3">สินค้าหมด กรุณาเลือกสินค้าอื่น</div>
      <% } %>
      <a href="/contact" class="inline-flex mt-2 w-full sm:w-auto px-6 py-3 rounded-lg font-medium justify-center bg-[var(--input)] border border-[var(--border-light)] hover:border-[var(--gold)] hover:text-[var(--gold)]">💬 ติดต่อร้าน</a>

      <% if (product.fulfillmentMode === 'contact' && product.fulfillmentInstructions) { %>
        <div class="mt-4 bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-xl p-4 text-sm">
          <div class="font-medium text-[var(--gold)] mb-1">ข้อมูลที่ต้องเตรียมสำหรับรับสินค้า</div>
          <div class="text-[var(--text-2)] whitespace-pre-line"><%= product.fulfillmentInstructions %></div>
        </div>
      <% } %>

      <% if (product.howToReceiveEnabled !== false) { %>
        <% const howToReceiveText = product.howToReceiveText || 'รับข้อมูลสินค้าทันทีหลังชำระเงินสำเร็จ ตรวจสอบได้ที่หน้าคำสั่งซื้อของคุณ\nระบบส่งมอบอัตโนมัติตลอด 24 ชั่วโมง\nหากติดปัญหาแจ้งทางร้านได้ที่หน้าติดต่อร้าน'; %>
        <div class="mt-6 bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 text-sm space-y-2">
          <div class="font-medium text-[var(--gold)] mb-1">วิธีรับสินค้า</div>
          <% howToReceiveText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
            <p class="text-[var(--text-2)]">✅ <%= line %></p>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="mt-10">
    <div class="flex gap-1 border-b border-[var(--border)] text-sm overflow-x-auto" id="tabbar">
      <button data-tab="terms" class="tab-btn px-4 py-2 border-b-2 border-[var(--gold)] text-[var(--gold)] whitespace-nowrap">เงื่อนไข</button>
      <button data-tab="gallery" class="tab-btn px-4 py-2 border-b-2 border-transparent text-[var(--text-3)] hover:text-[var(--text-2)] whitespace-nowrap">ภาพเกม</button>
      <button data-tab="about" class="tab-btn px-4 py-2 border-b-2 border-transparent text-[var(--text-3)] hover:text-[var(--text-2)] whitespace-nowrap">รายละเอียด</button>
    </div>

    <div id="tab-terms" class="tab-panel py-6 text-sm text-[var(--text-2)] space-y-4">
      <% if (product.termsBeforeOrderEnabled !== false) { %>
        <% const termsBeforeOrderText = product.termsBeforeOrderText || 'กรุณาตรวจสอบชื่อสินค้า รายละเอียด และราคาก่อนยืนยันคำสั่งซื้อ\nข้อมูลสินค้าจะปรากฏในหน้าคำสั่งซื้อหลังชำระเงินสำเร็จ\nห้ามเผยแพร่หรือส่งต่อข้อมูลสินค้าที่ได้รับจากร้าน\nหากพบปัญหา กรุณาติดต่อร้านพร้อมหมายเลขคำสั่งซื้อ'; %>
        <div>
          <div class="font-medium text-[var(--text)] mb-2">เงื่อนไขก่อนสั่งซื้อ</div>
          <ul class="list-disc pl-5 space-y-1">
            <% termsBeforeOrderText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
              <li><%= line %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <% if (product.warrantyEnabled !== false) { %>
        <% const warrantyText = product.warrantyText || 'รับประกันสินค้า 90 วันนับจากวันสั่งซื้อ\nการรับประกันเป็นไปตามรายละเอียดที่ระบุไว้ในสินค้านั้น\nกรุณาเก็บหลักฐานและหมายเลขคำสั่งซื้อไว้สำหรับติดต่อร้าน'; %>
        <div>
          <div class="font-medium text-[var(--text)] mb-2">เงื่อนไขการรับประกันสินค้า</div>
          <ul class="list-disc pl-5 space-y-1">
            <% warrantyText.split('\n').map(l => l.trim()).filter(Boolean).forEach(line => { %>
              <li><%= line %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <div id="tab-gallery" class="tab-panel py-6 hidden">
      <div class="grid sm:grid-cols-3 gap-3">
        <% product.images.forEach(img => { %>
          <div class="aspect-video rounded-lg overflow-hidden border border-[var(--border)] bg-black"><img src="<%= img %>" class="w-full h-full object-contain" /></div>
        <% }) %>
      </div>
    </div>

    <div id="tab-about" class="tab-panel py-6 hidden text-sm text-[var(--text-2)] leading-relaxed whitespace-pre-line"><%= product.aboutText %></div>
  </div>
</section>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('border-[var(--gold)]', 'text-[var(--gold)]');
        b.classList.add('border-transparent', 'text-[var(--text-3)]');
      });
      btn.classList.add('border-[var(--gold)]', 'text-[var(--gold)]');
      btn.classList.remove('border-transparent', 'text-[var(--text-3)]');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
    });
  });
</script>
