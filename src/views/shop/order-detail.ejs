<% const contactSettings = orderContactSettings || settings; %>
<section class="max-w-3xl mx-auto px-4 py-8">
  <a href="/account/orders" class="text-sm text-[var(--gold-text)]">← กลับไปหน้าคำสั่งซื้อ</a>
  <h1 class="text-2xl font-bold mt-2 mb-1">คำสั่งซื้อ #<%= order.id %></h1>
  <p class="text-[var(--text-3)] text-sm mb-6"><%= new Date(order.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %> &middot; สถานะ: <span class="text-emerald-400"><%= order.randomBoxOrder && order.status === 'completed' ? 'บันทึกผลสุ่มแล้ว' : order.status %></span></p>
  <% if (order.salesChannel === 'catalog-api') { %>
    <div class="mb-6 rounded-2xl border-2 border-[var(--gold)]/60 bg-[var(--gold)]/10 p-4">
      <div class="font-black text-[var(--gold-text)]">🔒 รับสินค้าที่ร้านหลักเท่านั้น</div>
      <p class="mt-1 text-sm leading-relaxed text-[var(--text-2)]">ออเดอร์นี้ชำระเงินเข้าร้านหลักแล้ว กรุณาติดต่อร้านหลักเพื่อรับไอดีและสินค้า ระบบจะไม่ส่งไอดีไปยังร้านเช่า</p>
    </div>
  <% } %>

  <% if (order.randomBoxOrder) { const boxProduct = itemsWithCreds[0] || {}; const winCount = itemsWithCreds.filter(item => item.randomBoxDraw?.isWin).length; %>
    <section class="mb-6 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)]" data-random-box-product>
      <div class="flex items-center gap-4 p-4 sm:p-5">
        <div class="relative flex w-28 shrink-0 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--input)] p-1 sm:w-36">
          <span class="absolute inset-0 grid place-items-center text-2xl text-[var(--text-4)]" aria-hidden="true">▧</span>
          <% if (boxProduct.productImage) { %><img data-random-box-product-image src="<%= boxProduct.productImage %>" alt="รูปสินค้า <%= boxProduct.productTitle %>" loading="eager" decoding="async" class="relative z-[1] block h-auto max-h-32 w-full bg-[var(--input)] object-contain object-center" onerror="this.hidden=true" /><% } %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs text-[var(--text-3)]">กล่องสุ่ม · สุ่ม <%= itemsWithCreds.length.toLocaleString('th-TH') %> ครั้ง</div>
          <h2 class="mt-1 break-words text-base font-bold sm:text-lg"><%= boxProduct.productTitle || 'กล่องสุ่ม' %></h2>
          <% if (Number(order.randomBoxRequestedDrawCount) > itemsWithCreds.length) { %><div class="mt-1 text-xs text-[var(--text-3)]">หยุดสุ่มเมื่อรางวัลในสต็อกหมด</div><% } %>
        </div>
        <span class="self-start whitespace-nowrap font-bold text-[var(--gold-text)]">฿<%= Number(order.total || 0).toLocaleString('th-TH') %>.00</span>
      </div>
      <div class="overflow-x-auto border-t border-[var(--border)]">
        <table class="w-full table-fixed text-sm" data-random-box-purchase-list>
          <thead class="bg-[var(--input)]/70 text-left text-xs text-[var(--text-3)]">
            <tr><th scope="col" class="w-[34%] px-4 py-3 font-semibold sm:w-[30%]">ชื่อรายการ</th><th scope="col" class="px-4 py-3 text-right font-semibold">ของรางวัล</th></tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)]">
            <% itemsWithCreds.forEach((i, drawIndex) => { const isWin = Boolean(i.randomBoxDraw?.isWin); %>
              <tr data-random-box-draw-row="<%= drawIndex + 1 %>">
                <th scope="row" class="px-4 py-4 text-left align-top font-medium">
                  <div class="break-words text-[var(--text)]">กล่องสุ่ม</div>
                  <div class="mt-1 text-xs text-[var(--text-3)]">ครั้งที่ <%= (drawIndex + 1).toLocaleString('th-TH') %></div>
                </th>
                <td class="px-4 py-4 text-right align-top" data-random-box-result-status="<%= isWin ? 'win' : 'miss' %>" role="status">
                  <span class="inline-flex min-h-7 items-center rounded-full border px-3 py-1 text-xs font-bold <%= isWin ? 'border-[var(--gold)]/30 bg-[var(--gold)]/10 text-[var(--gold-text)]' : 'border-[var(--border)] bg-[var(--input)]/60 text-[var(--text-2)]' %>"><%= isWin ? 'ได้รับรางวัล' : 'ไม่ได้รับรางวัล' %></span>
                  <% if (isWin) { %>
                    <div class="mt-2 break-words font-bold text-[var(--gold-text)]">🎉 <%= i.randomBoxDraw.prizeName || 'รางวัลจากสต็อก' %></div>
                    <% if (i.credentials) { %>
                      <div class="mt-2 rounded-lg border border-[var(--border-light)] bg-[var(--bg)] p-3 text-left font-mono text-xs">
                        <div class="break-all">ข้อมูลบน: <strong class="text-emerald-500"><%= i.credentials.username %></strong></div>
                        <% if (i.credentials.password) { %><div class="mt-1 break-all">ข้อมูลล่าง: <strong class="text-emerald-500"><%= i.credentials.password %></strong></div><% } %>
                        <% if (i.credentials.extra) { %><div class="mt-1 break-words font-sans text-[var(--text-3)]"><%= i.credentials.extra %></div><% } %>
                      </div>
                    <% } else { %><div class="mt-2 text-left text-xs text-[var(--coral)]">รางวัลนี้ยังไม่มีคีย์/ไอดีในสต็อก กรุณาติดต่อร้าน</div><% } %>
                  <% } else { %>
                    <div class="mt-2 text-xs text-[var(--text-3)]">ข้อความจากร้าน</div>
                    <div class="mt-0.5 whitespace-pre-line break-words font-semibold text-[var(--text)]"><%= i.randomBoxDraw.missMessage || 'ยังไม่ได้รับรางวัลในครั้งนี้' %></div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="flex flex-wrap justify-between gap-2 border-t border-[var(--border)] px-4 py-3 text-sm">
        <span class="text-[var(--text-3)]">สุ่ม <%= itemsWithCreds.length.toLocaleString('th-TH') %> ครั้ง · ได้รับรางวัล <%= winCount.toLocaleString('th-TH') %> ชิ้น</span>
        <strong class="text-[var(--gold-text)]">รวม ฿<%= Number(order.total || 0).toLocaleString('th-TH') %>.00</strong>
      </div>
    </section>
  <% } else { %>
    <div class="space-y-3 mb-6">
    <% itemsWithCreds.forEach((i, drawIndex) => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4">
        <div class="flex items-start gap-3 sm:gap-4 mb-4">
          <div class="relative w-28 sm:w-36 shrink-0 rounded-xl border border-[var(--border)] bg-[var(--input)] p-1 grid place-items-center">
            <span class="absolute inset-0 grid place-items-center text-2xl text-[var(--text-4)]" aria-hidden="true">▧</span>
            <% if (i.productImage) { %><img src="<%= i.productImage %>" alt="รูปสินค้า <%= i.productTitle %>" loading="eager" decoding="async" class="relative z-[1] block h-auto max-h-32 w-full object-contain object-center bg-[var(--input)]" onerror="this.hidden=true" /><% } %>
          </div>
          <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1.5">
            <div class="min-w-0"><div class="text-[10px] text-[var(--text-4)] mb-0.5"><%= i.randomBoxDraw ? `ผลสุ่มครั้งที่ ${drawIndex + 1}` : 'สินค้า' %></div><h2 class="font-bold text-base sm:text-lg leading-snug break-words"><%= i.productTitle %></h2></div>
            <span class="text-[var(--gold-text)] font-bold whitespace-nowrap">฿<%= i.price.toLocaleString() %>.00</span>
          </div>
        </div>
        <% if (i.randomBoxDraw) { %>
          <div class="mb-3 rounded-xl border <%= i.randomBoxDraw.isWin ? 'border-[var(--gold)]/30 bg-[var(--gold)]/5' : 'border-[var(--border)] bg-[var(--input)]/60' %> p-4 text-sm" data-random-box-result-status="<%= i.randomBoxDraw.isWin ? 'win' : 'miss' %>" role="status">
            <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
              <span class="inline-flex min-h-7 items-center rounded-full px-3 py-1 text-xs font-black <%= i.randomBoxDraw.isWin ? 'bg-[var(--gold)]/10 text-[var(--gold-text)]' : 'bg-[var(--card)] text-[var(--text-2)] border border-[var(--border)]' %>"><%= i.randomBoxDraw.isWin ? 'ได้รับรางวัล' : 'ไม่ได้รับรางวัล' %></span>
              <span class="text-[11px] text-[var(--text-3)]">฿<%= i.price.toLocaleString() %> / ครั้ง</span>
            </div>
            <% if (i.randomBoxDraw.isWin) { %>
              <div class="font-black text-[var(--gold-text)] break-words">🎉 คุณได้รับ <%= i.randomBoxDraw.prizeName || 'รางวัลจากสต็อก' %></div>
              <% if (i.credentials) { %>
                <div class="mt-3 rounded-lg border border-[var(--border-light)] bg-[var(--bg)] p-3 font-mono text-xs">
                  <div>ข้อมูลบน: <strong class="text-emerald-500"><%= i.credentials.username %></strong></div>
                  <% if (i.credentials.password) { %><div class="mt-1">ข้อมูลล่าง: <strong class="text-emerald-500"><%= i.credentials.password %></strong></div><% } %>
                  <% if (i.credentials.extra) { %><div class="mt-1 font-sans text-[var(--text-3)]"><%= i.credentials.extra %></div><% } %>
                </div>
              <% } else { %><div class="mt-1 text-[var(--coral)]">รางวัลนี้ยังไม่มีคีย์/ไอดีในสต็อก กรุณาติดต่อร้าน</div><% } %>
            <% } else { %>
              <div class="text-[10px] font-bold text-[var(--text-3)]">ข้อความจากร้าน</div>
              <div class="mt-0.5 font-bold text-[var(--text)] whitespace-pre-line break-words"><%= i.randomBoxDraw.missMessage || 'ยังไม่ได้รับรางวัลในครั้งนี้' %></div>
            <% } %>
          </div>
        <% } else if (i.fulfillmentMode === 'contact') { %>
          <div class="bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-xl p-4 text-sm">
            <div class="font-semibold text-[var(--gold-text)] mb-1">กรุณาติดต่อร้านเพื่อรับสินค้า</div>
            <% if (i.fulfillmentInstructions) { %><div class="text-[var(--text-2)] whitespace-pre-line mb-3"><%= i.fulfillmentInstructions %></div><% } %>
            <textarea class="contact-order-message hidden"><%= i.contactMessageIntro || 'สวัสดีครับ ต้องการติดต่อรับสินค้า' %>
หมายเลขคำสั่งซื้อ: #<%= order.id %>
สินค้า: <%= i.productTitle %>
ชื่อลูกค้า: <%= currentUser.username %>
<% if (i.fulfillmentInstructions) { %>ข้อมูลที่ร้านขอให้เตรียม: <%= i.fulfillmentInstructions %>
<% } %><%= i.contactMessageOutro || 'กรุณาตรวจสอบออเดอร์และแจ้งขั้นตอนรับสินค้าให้ด้วยครับ' %></textarea>
            <button type="button" data-contact-url="<%= contactSettings.contactMessenger || contactSettings.contactFacebook || '/contact' %>" class="contact-order-btn inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-lg bg-[var(--gold)] text-[var(--gold-contrast)] font-black"><%= order.salesChannel === 'catalog-api' ? '📩 ติดต่อร้านหลักเพื่อรับสินค้า' : '💬 คัดลอกข้อความและเปิด Messenger' %></button>
            <div class="contact-order-status text-[10px] text-[var(--text-4)] mt-2"></div>
          </div>
        <% } else if (i.credentials) { %>
          <div class="bg-[var(--bg)] border border-[var(--border)] rounded-lg p-3 text-sm font-mono space-y-1 mb-3">
            <div>ข้อมูลบน: <span class="text-emerald-400"><%= i.credentials.username %></span></div>
            <div>ข้อมูลล่าง: <span class="text-emerald-400"><%= i.credentials.password %></span></div>
            <div class="text-[var(--text-3)] font-sans text-xs mt-1"><%= i.credentials.extra %></div>
          </div>
        <% } %>
      </div>
    <% }) %>
    </div>
  <% } %>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 space-y-1 text-sm">
    <div class="flex justify-between"><span class="text-[var(--text-3)]">ยอดรวมสินค้า</span><span>฿<%= order.subtotal.toLocaleString() %>.00</span></div>
    <% if (order.discount > 0) { %>
      <div class="flex justify-between text-emerald-400"><span>ส่วนลด <%= order.couponCode ? '('+order.couponCode+')' : '' %></span><span>-฿<%= order.discount.toLocaleString() %>.00</span></div>
    <% } %>
    <div class="flex justify-between text-lg font-bold pt-2 border-t border-[var(--border)] mt-2"><span>ยอดชำระ</span><span class="text-[var(--gold-text)]">฿<%= order.total.toLocaleString() %>.00</span></div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.contact-order-btn').forEach(function (button) {
      if (button.dataset.bound === '1') return;
      button.dataset.bound = '1';
      button.addEventListener('click', function () {
        const box = button.closest('.rounded-xl');
        const source = box && box.querySelector('.contact-order-message');
        const status = box && box.querySelector('.contact-order-status');
        const message = source ? source.value.trim() : '';
        const chatWindow = window.open(button.dataset.contactUrl || '/contact', '_blank');
        if (chatWindow) chatWindow.opener = null;
        const fallbackCopy = function () {
          const temp = document.createElement('textarea');
          temp.value = message; temp.style.position = 'fixed'; temp.style.opacity = '0';
          document.body.appendChild(temp); temp.select(); document.execCommand('copy'); temp.remove();
        };
        const copied = navigator.clipboard && window.isSecureContext
          ? navigator.clipboard.writeText(message).catch(fallbackCopy)
          : Promise.resolve(fallbackCopy());
        Promise.resolve(copied).finally(function () {
          if (status) status.textContent = '✓ คัดลอกข้อความแล้ว ให้วางข้อความใน Messenger และกดส่ง';
          if (!chatWindow) window.location.href = button.dataset.contactUrl || '/contact';
        });
      });
    });
  })();
</script>
