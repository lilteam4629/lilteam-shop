<section class="max-w-3xl mx-auto px-4 py-8">
  <a href="/account/orders" class="text-sm text-[var(--gold)]">← กลับไปหน้าคำสั่งซื้อ</a>
  <h1 class="text-2xl font-bold mt-2 mb-1">คำสั่งซื้อ #<%= order.id %></h1>
  <p class="text-[var(--text-3)] text-sm mb-6"><%= new Date(order.createdAt).toLocaleString('th-TH') %> &middot; สถานะ: <span class="text-emerald-400"><%= order.status %></span></p>

  <div class="space-y-3 mb-6">
    <% itemsWithCreds.forEach(i => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-medium"><%= i.title %></span>
          <span class="text-[var(--gold)]">฿<%= i.price.toLocaleString() %>.00</span>
        </div>
        <% if (i.credentials) { %>
          <div class="bg-[var(--bg)] border border-[var(--border)] rounded-lg p-3 text-sm font-mono space-y-1 mb-3">
            <div>Username: <span class="text-emerald-400"><%= i.credentials.username %></span></div>
            <div>Password: <span class="text-emerald-400"><%= i.credentials.password %></span></div>
            <div class="text-[var(--text-3)] font-sans text-xs mt-1"><%= i.credentials.extra %></div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 space-y-1 text-sm">
    <div class="flex justify-between"><span class="text-[var(--text-3)]">ยอดรวมสินค้า</span><span>฿<%= order.subtotal.toLocaleString() %>.00</span></div>
    <% if (order.discount > 0) { %>
      <div class="flex justify-between text-emerald-400"><span>ส่วนลด <%= order.couponCode ? '('+order.couponCode+')' : '' %></span><span>-฿<%= order.discount.toLocaleString() %>.00</span></div>
    <% } %>
    <div class="flex justify-between text-lg font-bold pt-2 border-t border-[var(--border)] mt-2"><span>ยอดชำระ</span><span class="text-[var(--gold)]">฿<%= order.total.toLocaleString() %>.00</span></div>
  </div>
</section>
