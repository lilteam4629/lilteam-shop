<link rel="stylesheet" href="<%= asset('css/promotions-v1.css') %>" />
<link rel="stylesheet" href="<%= asset('css/storefront-member-benefits-v1.css') %>" />
<section class="promo-page promo-member-page">
  <header class="member-benefits-hero">
    <div class="member-benefits-intro"><span class="member-benefits-eyebrow">MEMBER BENEFITS</span><h1>สิทธิ์ดี ๆ<br><span>สำหรับสมาชิก</span></h1><p>รับพ้อย เก็บคูปอง และชวนเพื่อนมาเลือกไอดีที่ชอบ<br>สิทธิพิเศษของคุณ รวมไว้ที่นี่</p><nav class="member-benefits-nav" aria-label="เลือกสิทธิสมาชิก"><a href="#member-campaigns">รับพ้อย <span>↗</span></a><a href="#member-tools">คูปองและชวนเพื่อน <span>↗</span></a></nav><a href="/" class="member-store-back">← กลับหน้าร้าน</a></div>
    <div class="member-benefits-pass"><div class="member-pass-top"><span>MEMBER CLUB</span><span aria-hidden="true">✦</span></div><p>ทุกพ้อยมีค่า<br>กับไอดีที่คุณชอบ</p><div class="member-pass-value"><strong>1 <small>พ้อย</small></strong><span>=</span><strong>฿1</strong></div><div class="member-pass-bottom"><span>ใช้ซื้อสินค้าในร้านนี้</span><span aria-hidden="true">↗</span></div></div>
  </header>
  <% if (!currentUser) { %><div class="promo-notice"><strong>เริ่มต้นด้วยบัญชีของคุณ</strong><p>สมัครสมาชิกหรือเข้าสู่ระบบก่อนรับพ้อยและเก็บคูปอง</p><div class="promo-inline"><a class="promo-button" href="/register">สมัครสมาชิก</a><a class="promo-button secondary" href="/login">เข้าสู่ระบบ</a></div></div><% } %>
  <% if (currentUser && currentUser.role === 'customer') { %><div class="promo-balance"><span>พ้อยในกระเป๋า ใช้ซื้อสินค้าได้</span><strong><%= Number(currentUser.walletBalance || 0).toLocaleString('th-TH', {minimumFractionDigits:2}) %></strong><small>1 พ้อย = ฿1 · รวมกับยอดเติมเงินในกระเป๋าร้านนี้</small></div><% } %>
  <div class="promo-heading" id="member-campaigns"><span class="member-benefits-eyebrow">YOUR REWARDS</span><h2>โปรโมชั่นรับพ้อย</h2><p>รับได้หนึ่งครั้งต่อบัญชีในแต่ละโปรโมชั่น เวลาทั้งหมดเป็นเวลาประเทศไทย</p></div>
  <div class="promo-grid">
    <% const visibleCampaigns = campaigns.filter(c => c.enabled); if (!visibleCampaigns.length) { %><div class="promo-empty"><h3>เตรียมพบโปรโมชั่นใหม่</h3><p>ร้านยังไม่มีโปรโมชั่นรับพ้อยที่เปิดอยู่ ลองดูคูปองหรือกลับมาใหม่อีกครั้ง</p></div><% } %>
    <% visibleCampaigns.forEach(c => { const received = claims.some(x => x.campaignId === c.id); const activeNow = inWindow(c); %>
    <article class="promo-card"><div class="promo-card-top"><span class="promo-tag"><%= received ? 'รับแล้ว' : activeNow ? 'เปิดรับสิทธิ์' : 'นอกช่วงโปรโมชั่น' %></span><strong class="promo-amount"><%= Number(c.amount).toLocaleString() %><small>พ้อย</small></strong></div><h3><%= c.title %></h3><p><%= c.description || 'สมัครสมาชิกและยืนยันชื่อผู้ใช้เพื่อรับสิทธิ์' %></p><div class="promo-period"><span>เริ่ม: <%= c.startsAt ? new Date(c.startsAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่จำกัด' %></span><span>สิ้นสุด: <%= c.endsAt ? new Date(c.endsAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่จำกัด' %></span></div><small><%= c.newMembersOnly ? 'สมาชิกที่สมัครตั้งแต่วันเริ่มโปรโมชั่น' : 'สมาชิกทุกคน' %><%= c.maxClaims ? ' · จำกัด ' + c.maxClaims + ' สิทธิ์' : '' %></small>
    <% if (currentUser?.role === 'customer') { %><form action="/promotions/claim" method="post" class="promo-form"><input type="hidden" name="csrf" value="<%= csrf %>"/><input type="hidden" name="campaignId" value="<%= c.id %>"/><label>ชื่อผู้ใช้ที่สมัคร<input name="username" autocomplete="username" placeholder="กรอกชื่อผู้ใช้ของคุณ" value="<%= currentUser.username %>" required maxlength="100" <%= received || !activeNow ? 'disabled' : '' %>/></label><button class="promo-button" <%= received || !activeNow ? 'disabled' : '' %>><%= received ? 'รับสิทธิ์แล้ว' : 'ยืนยันและรับพ้อย' %></button></form><% } else { %><a href="/register" class="promo-button">สมัครสมาชิกเพื่อรับสิทธิ์</a><% } %></article>
    <% }) %>
  </div>
  <div class="promo-grid promo-tools" id="member-tools">
    <article class="promo-card member-coupon-card"><span class="member-tool-icon" aria-hidden="true">◇</span><span class="promo-tag">คูปองส่วนลด</span><h2>มีโค้ดดี ๆ เก็บไว้ใช้ได้เลย</h2><p>ใช้คูปองจากร้าน ส่วนลดจะคำนวณในตะกร้าก่อนชำระเงิน</p><% if (coupon) { %><div class="promo-notice">คูปองที่เลือก: <strong><%= coupon.code %></strong><a class="promo-link" href="/cart">ไปตะกร้า →</a></div><% } %><form action="/promotions/coupon" method="post" class="promo-form"><input type="hidden" name="csrf" value="<%= csrf %>"/><label>รหัสคูปอง<input name="code" maxlength="100" placeholder="กรอกโค้ดส่วนลด" autocomplete="off" required/></label><button class="promo-button" <%= currentUser ? '' : 'disabled' %>>เก็บคูปองส่วนลด</button></form></article>
    <article class="promo-card member-referral-card"><span class="member-tool-icon" aria-hidden="true">↗</span><span class="promo-tag">แนะนำเพื่อน</span><h2>ชวนเพื่อนมา รับพ้อยด้วยกัน</h2><ol class="promo-steps"><li>แชร์ลิงก์ของคุณให้เพื่อน</li><li>เพื่อนสมัครบัญชีใหม่ผ่านลิงก์</li><li>เพื่อนซื้อสินค้าและคำสั่งซื้อสำเร็จครั้งแรก</li></ol><% if (referral && inWindow(referral)) { %><p>ผู้แนะนำรับ <strong><%= Number(referral.referrerAmount).toLocaleString() %> พ้อย</strong> · เพื่อนรับ <strong><%= Number(referral.friendAmount).toLocaleString() %> พ้อย</strong></p><% if (referral.endsAt) { %><small>สิ้นสุด <%= new Date(referral.endsAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %></small><% } %><% if (referralPath) { %><label class="promo-form">ลิงก์แนะนำเพื่อน<input data-referral-link value="<%= referralPath %>" readonly aria-label="ลิงก์แนะนำเพื่อน"/></label><button type="button" class="promo-button" data-copy-referral>คัดลอกลิงก์</button><p><%= referralCount %> คนสมัคร · <%= referralCompleted %> คนรับรางวัลแล้ว</p><form action="/promotions/referral-check" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"/><button class="promo-button secondary">ตรวจสถานะรางวัล</button></form><% } else { %><a class="promo-button" href="/register">สมัครสมาชิกก่อนชวนเพื่อน</a><% } %><% } else { %><div class="promo-notice">กิจกรรมแนะนำเพื่อนยังไม่เปิด หรืออยู่นอกช่วงเวลา</div><% } %><small>รับรางวัลหนึ่งครั้งต่อเพื่อนใหม่ · คำสั่งซื้อฟรี ยกเลิก หรือรอดำเนินการยังไม่เข้าเงื่อนไข</small></article>
  </div>
</section>
<script>
(function(){const input=document.querySelector('[data-referral-link]'),button=document.querySelector('[data-copy-referral]');if(!input)return;input.value=new URL(input.value,location.origin).href;button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(input.value);button.textContent='คัดลอกแล้ว';}catch(_){input.focus();input.select();button.textContent='เลือกลิงก์แล้ว กรุณาคัดลอก';}});})();
</script>
