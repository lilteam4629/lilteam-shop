<section class="max-w-xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-1">🌐 เช่าเว็บ / ต่ออายุคีย์</h1>
  <p class="text-sm text-[var(--text-3)] mb-6">ซื้อคีย์เปิดใช้งาน/ต่ออายุเว็บที่คุณเช่าไว้ ได้คีย์ทันทีหลังชำระเงิน เอาไปกรอกที่หน้า <span class="font-mono">/license</span> ของเว็บนั้นได้เลย</p>

  <% if (!licenseReady) { %>
    <div class="bg-amber-900/30 border border-amber-600/50 text-amber-300 rounded-xl p-4 text-sm mb-6">
      ระบบขายคีย์ยังไม่เปิดใช้งานในขณะนี้ กรุณาติดต่อร้านค้า
    </div>
  <% } %>

  <div class="grid sm:grid-cols-3 gap-4 mb-8">
    <% plans.forEach(plan => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] hover:border-[var(--gold)]/60 rounded-xl p-5 text-center flex flex-col items-center gap-2">
        <div class="text-3xl font-extrabold text-[var(--gold)]"><%= plan.days %></div>
        <div class="text-xs text-[var(--text-4)] -mt-1">วัน</div>
        <div class="text-lg font-semibold mt-2 mb-1">฿<%= plan.price.toLocaleString() %></div>
        <form action="/rent-website/buy" method="post" class="w-full">
          <input type="hidden" name="planId" value="<%= plan.id %>" />
          <input type="hidden" name="type" value="renewal" />
          <button <%= licenseReady ? '' : 'disabled' %> class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] disabled:opacity-40 text-[var(--bg)] font-semibold rounded-lg py-2 text-sm">🔄 ต่ออายุ (รับคีย์)</button>
        </form>
      </div>
    <% }) %>
    <% if (!plans.length) { %>
      <p class="text-sm text-[var(--text-4)] col-span-full text-center py-8">ยังไม่มีแพ็กเกจให้ซื้อในขณะนี้</p>
    <% } %>
  </div>

  <div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-5 mb-8">
    <h2 class="text-lg font-semibold mb-1">🆕 เปิดร้านใหม่ของคุณเอง</h2>
    <p class="text-xs text-[var(--text-4)] mb-4">ได้ร้านทันที พร้อมระบบสินค้า/สต๊อก/ออเดอร์/กระเป๋าเงินครบเหมือนร้านนี้ทุกอย่าง — ไม่ต้องสมัคร Railway ไม่ต้องมี GitHub เลย</p>
    <a href="/start" class="block text-center bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg py-2.5 text-sm">🚀 เปิดร้านตอนนี้ →</a>
    <a href="/my-shops" class="block text-center text-xs text-[var(--text-4)] mt-2 underline">มีร้านอยู่แล้ว? ดู/ต่ออายุร้านของฉัน →</a>
  </div>

  <h2 class="text-lg font-semibold mb-3">ประวัติการซื้อของคุณ</h2>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl divide-y divide-[#241f13]">
    <% if (!mySales.length) { %>
      <div class="p-4 text-[var(--text-3)] text-sm">ยังไม่มีประวัติการซื้อ</div>
    <% } %>
    <% mySales.forEach(sale => { %>
      <a href="/rent-website/sale/<%= sale.id %>" class="p-4 flex items-center justify-between text-sm hover:bg-[var(--input)]">
        <div>
          <div><%= sale.days %> วัน — ฿<%= sale.price.toLocaleString() %> <% if (sale.type === 'new_site') { %><span class="text-[10px] text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-1.5 py-0.5 ml-1">เว็บใหม่</span><% } %></div>
          <div class="text-[var(--text-4)] text-xs"><%= new Date(sale.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></div>
          <% if (sale.exp) { %>
            <div class="countdown text-xs font-mono mt-0.5" data-exp="<%= sale.exp %>">…</div>
          <% } %>
        </div>
        <span class="text-[var(--gold)] text-xs">ดู →</span>
      </a>
    <% }) %>
  </div>
</section>

<script>
  function fmtCountdown(ms) {
    if (ms <= 0) return '✕ หมดอายุแล้ว';
    const s = Math.floor(ms / 1000);
    const d = Math.floor(s / 86400);
    const h = Math.floor((s % 86400) / 3600);
    const m = Math.floor((s % 3600) / 60);
    if (d > 0) return `เหลือ ${d} วัน ${h} ชม.`;
    if (h > 0) return `เหลือ ${h} ชม. ${m} นาที`;
    return `เหลือ ${m} นาที`;
  }
  function tickCountdowns() {
    document.querySelectorAll('.countdown[data-exp]').forEach(el => {
      const ms = Number(el.dataset.exp) - Date.now();
      el.textContent = fmtCountdown(ms);
      el.classList.toggle('text-[var(--coral)]', ms <= 0);
      el.classList.toggle('text-emerald-400', ms > 0);
    });
  }
  tickCountdowns();
  setInterval(tickCountdowns, 30000);
</script>
