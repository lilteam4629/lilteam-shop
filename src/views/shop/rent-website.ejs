<section class="max-w-xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-1">🌐 เช่าเว็บ / ต่ออายุคีย์</h1>
  <p class="text-sm text-[var(--text-3)] mb-6">ซื้อคีย์เปิดใช้งาน/ต่ออายุเว็บที่คุณเช่าไว้ ได้คีย์ทันทีหลังชำระเงิน เอาไปกรอกที่หน้า <span class="font-mono">/license</span> ของเว็บนั้นได้เลย</p>

  <% if (!licenseReady) { %>
    <div class="bg-amber-900/30 border border-amber-600/50 text-amber-300 rounded-xl p-4 text-sm mb-6">
      ระบบขายคีย์ยังไม่เปิดใช้งานในขณะนี้ กรุณาติดต่อร้านค้า
    </div>
  <% } %>

  <div class="grid sm:grid-cols-3 gap-4 mb-8">
    <% plans.forEach(plan => { %>
      <div class="bg-[var(--card)] border border-[var(--border)] hover:border-[var(--gold)]/60 rounded-xl p-5 text-center flex flex-col items-center gap-2">
        <div class="text-3xl font-extrabold text-[var(--gold)]"><%= plan.days %></div>
        <div class="text-xs text-[var(--text-4)] -mt-1">วัน</div>
        <div class="text-lg font-semibold mt-2 mb-1">฿<%= plan.price.toLocaleString() %></div>
        <form action="/rent-website/buy" method="post" class="w-full">
          <input type="hidden" name="planId" value="<%= plan.id %>" />
          <input type="hidden" name="type" value="renewal" />
          <button <%= licenseReady ? '' : 'disabled' %> class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] disabled:opacity-40 text-[var(--bg)] font-semibold rounded-lg py-2 text-sm">🔄 ต่ออายุ (รับคีย์)</button>
        </form>
      </div>
    <% }) %>
    <% if (!plans.length) { %>
      <p class="text-sm text-[var(--text-4)] col-span-full text-center py-8">ยังไม่มีแพ็กเกจให้ซื้อในขณะนี้</p>
    <% } %>
  </div>

  <% if (newSiteReady && plans.length) { %>
    <div class="bg-[var(--card)] border border-[var(--gold)]/40 rounded-xl p-5 mb-8">
      <div class="flex items-center justify-between gap-2 mb-1">
        <h2 class="text-lg font-semibold">🆕 เปิดเว็บใหม่ของคุณเอง</h2>
        <a href="/rent-website/guide" class="shrink-0 text-xs text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-3 py-1 whitespace-nowrap">📖 ดูวิธีทำแบบละเอียด</a>
      </div>
      <p class="text-xs text-[var(--text-4)] mb-4">ระบบจะสร้างเว็บใหม่ให้อัตโนมัติ พร้อมตั้งชื่อผู้ใช้/รหัสผ่านแอดมินตามที่คุณกำหนดเอง — ทำไม่เป็น? กดปุ่ม "ดูวิธีทำแบบละเอียด" ด้านบนได้เลย มีสอนทีละขั้นตอน</p>
      <form action="/rent-website/buy" method="post" class="space-y-3">
        <input type="hidden" name="type" value="new_site" />
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">เลือกแพ็กเกจ</label>
          <select name="planId" required class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm">
            <% plans.forEach(plan => { %>
              <option value="<%= plan.id %>"><%= plan.days %> วัน — ฿<%= plan.price.toLocaleString() %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">ชื่อผู้ใช้แอดมิน (สำหรับเข้า /admin ของเว็บใหม่)</label>
          <input name="adminUsername" required pattern="[a-zA-Z0-9_]{3,20}" title="ตัวอักษร a-z, 0-9 และ _ เท่านั้น ยาว 3-20 ตัว" placeholder="เช่น myshop_admin" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs mb-1 text-[var(--text-3)]">รหัสผ่านแอดมิน (อย่างน้อย 8 ตัว)</label>
          <input name="adminPassword" type="text" required minlength="8" placeholder="ตั้งรหัสผ่านที่จำได้" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm font-mono" />
        </div>

        <div class="border-t border-[var(--border)] pt-3">
          <div class="flex items-center justify-between mb-1 flex-wrap gap-1">
            <label class="text-xs text-[var(--text-3)]">Railway API Token (ของคุณเอง)</label>
            <div class="flex gap-1.5">
              <a href="https://railway.com/login" target="_blank" rel="noopener" class="text-[10px] text-[var(--text-3)] border border-[var(--border-light)] rounded-full px-2 py-1 whitespace-nowrap">🚂 สมัคร Railway</a>
              <a href="https://railway.com/account/tokens" target="_blank" rel="noopener" class="text-[10px] text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-2 py-1 whitespace-nowrap">🔑 ไปสร้าง Token →</a>
            </div>
          </div>
          <input name="railwayToken" required placeholder="วางโทเค็นที่คัดลอกมาที่นี่" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm font-mono" />
          <p class="text-[10px] text-[var(--text-4)] mt-1">ยังไม่มีบัญชี? กด "สมัคร Railway" ก่อน แล้วค่อยกด "ไปสร้าง Token" → ตั้งชื่ออะไรก็ได้ → เลือก Workspace → กด Create → คัดลอกค่าที่ได้มาวางที่ช่องนี้ (<a href="/rent-website/guide" class="underline text-[var(--gold)]">ดูวิธีแบบละเอียด</a>)</p>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs text-[var(--text-3)]">MongoDB URI (ฟรี ของคุณเอง)</label>
            <a href="https://cloud.mongodb.com" target="_blank" rel="noopener" class="text-[10px] text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-2 py-1 whitespace-nowrap">🍃 ไปสมัคร MongoDB →</a>
          </div>
          <input name="mongodbUri" required placeholder="mongodb+srv://..." class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm font-mono" />
          <p class="text-[10px] text-[var(--text-4)] mt-1">กดปุ่มด้านบน → สมัครฟรี → สร้าง Free cluster (M0) → Database Access ตั้ง user/password → Network Access เลือก Allow from anywhere → Connect → Drivers → คัดลอก connection string มาวางที่ช่องนี้</p>
        </div>

        <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg py-2.5 text-sm">🆕 สร้างเว็บใหม่</button>
        <p class="text-[10px] text-[var(--text-4)] text-center">Token และ URI จะถูกใช้แค่ตอนสร้างเว็บครั้งนี้เท่านั้น ระบบไม่บันทึกเก็บไว้</p>
      </form>
    </div>
  <% } else if (!newSiteReady) { %>
    <p class="text-xs text-[var(--text-4)] -mt-5 mb-8">💡 "เปิดเว็บใหม่อัตโนมัติ" ยังไม่เปิดใช้งาน — ซื้อได้เฉพาะคีย์ต่ออายุตอนนี้</p>
  <% } %>

  <h2 class="text-lg font-semibold mb-3">ประวัติการซื้อของคุณ</h2>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl divide-y divide-[#241f13]">
    <% if (!mySales.length) { %>
      <div class="p-4 text-[var(--text-3)] text-sm">ยังไม่มีประวัติการซื้อ</div>
    <% } %>
    <% mySales.forEach(sale => { %>
      <a href="/rent-website/sale/<%= sale.id %>" class="p-4 flex items-center justify-between text-sm hover:bg-[var(--input)]">
        <div>
          <div><%= sale.days %> วัน — ฿<%= sale.price.toLocaleString() %> <% if (sale.type === 'new_site') { %><span class="text-[10px] text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-1.5 py-0.5 ml-1">เว็บใหม่</span><% } %></div>
          <div class="text-[var(--text-4)] text-xs"><%= new Date(sale.createdAt).toLocaleString('th-TH') %></div>
        </div>
        <span class="text-[var(--gold)] text-xs">ดู →</span>
      </a>
    <% }) %>
  </div>
</section>
