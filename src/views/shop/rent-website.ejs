<section class="max-w-xl mx-auto px-4 py-10">

  <% if (promoPlans.length) { %>
    <div class="relative overflow-hidden rounded-2xl border border-[#e7bb36]/50 bg-gradient-to-br from-[#2a2107] via-[#1a160d] to-[#100e08] p-4 mb-5">
      <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#e7bb36]/15 blur-2xl pointer-events-none"></div>
      <h2 class="relative flex items-center gap-1.5 font-bold text-[#ffe487] text-sm mb-3">🔥 โปรโมชั่นตอนนี้</h2>
      <div class="relative flex flex-col gap-2">
        <% promoPlans.forEach(plan => { %>
          <a href="/start?plan=<%= plan.id %>" class="flex items-center justify-between gap-2 bg-black/25 hover:bg-black/40 border border-[#e7bb36]/30 rounded-xl px-3.5 py-2.5 transition">
            <div>
              <div class="text-sm font-semibold text-white"><%= plan.days %> วัน</div>
              <div class="text-[10px] text-[#c9b98a]">
                <% if (plan.promoLimit) { %>เหลือ <%= Math.max(0, plan.promoLimit - (plan.promoUsedCount || 0)) %>/<%= plan.promoLimit %> สิทธิ์<% } %>
                <% if (plan.promoLimit && plan.promoExpiresAt) { %> · <% } %>
                <% if (plan.promoExpiresAt) { %>หมดเขต <%= new Date(plan.promoExpiresAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', dateStyle: 'short', timeStyle: 'short' }) %><% } %>
              </div>
            </div>
            <div class="text-base font-bold text-[#ffe487]">฿<%= plan.price.toLocaleString() %></div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <h1 class="text-lg font-bold mb-1">เปิดร้านใหม่ของคุณเอง</h1>
  <p class="text-xs text-[var(--text-3)] mb-4">ได้ร้านทันที พร้อมระบบสินค้า/สต๊อก/ออเดอร์/กระเป๋าเงินครบเหมือนร้านนี้ทุกอย่าง — เลือกแพ็กเกจที่ต้องการ</p>

  <div class="grid grid-cols-2 gap-4 mb-3">
    <% plans.forEach(plan => { %>
      <a href="/start?plan=<%= plan.id %>" class="group relative flex w-full aspect-[3/4] rounded-2xl overflow-hidden border border-[#8c7430]/55 transition-all duration-300 hover:border-[#f0cf64]/80">
        <% if (settings.branding && settings.branding.logoImage) { %>
          <div class="absolute inset-0 bg-gradient-to-br from-[#fff0ae] via-[#d8b84e] to-[#8d6818] flex items-center justify-center p-8">
            <img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName %>"
              class="max-w-full max-h-full object-contain transition duration-500 group-hover:scale-[1.055]" />
          </div>
        <% } else { %>
          <div class="absolute inset-0 flex items-center justify-center text-5xl bg-gradient-to-br from-[#fff0ae] via-[#d8b84e] to-[#8d6818]">🌐</div>
        <% } %>
        <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/55 to-transparent"></div>
        <div class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-[#f6d66c]/25 group-hover:ring-[#ffe487]/60 transition"></div>

        <span class="ready-glow absolute top-2 left-2 z-10 bg-emerald-950/80 border border-emerald-400/70 text-emerald-300 font-medium text-[10px] px-2.5 py-1 rounded-full backdrop-blur-sm">● เปิดได้ทันที</span>

        <div class="absolute inset-x-0 bottom-0 p-3 flex flex-col gap-1">
          <h3 class="font-semibold text-sm text-white [text-shadow:0_2px_8px_rgba(0,0,0,.95)]">แพ็กเกจ <%= plan.days %> วัน</h3>
          <span class="text-[#f2cc4d] font-bold text-[15px] [text-shadow:0_0_12px_rgba(242,204,77,.5)]">฿<%= plan.price.toLocaleString() %></span>
        </div>
      </a>
    <% }) %>
  </div>
  <% if (!plans.length) { %>
    <p class="text-[var(--text-4)] text-xs mb-3">ยังไม่มีแพ็กเกจให้เลือก กรุณาติดต่อผู้ดูแลเว็บ</p>
  <% } %>
  <a href="/my-shops" class="block text-center text-xs text-[var(--text-4)] mb-8 underline">มีร้านอยู่แล้ว? ดู/ต่ออายุร้านของฉัน →</a>

  <h2 class="text-lg font-semibold mb-3">ประวัติการซื้อของคุณ</h2>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl divide-y divide-[#241f13]">
    <% if (!mySales.length) { %>
      <div class="p-4 text-[var(--text-3)] text-sm">ยังไม่มีประวัติการซื้อ</div>
    <% } %>
    <% mySales.forEach(sale => { %>
      <a href="/rent-website/sale/<%= sale.id %>" class="p-4 flex items-center justify-between text-sm hover:bg-[var(--input)]">
        <div>
          <div><%= sale.days %> วัน — ฿<%= sale.price.toLocaleString() %> <% if (sale.type === 'new_site') { %><span class="text-[10px] text-[var(--gold)] border border-[var(--gold)]/40 rounded-full px-1.5 py-0.5 ml-1">เว็บใหม่</span><% } %></div>
          <div class="text-[var(--text-4)] text-xs"><%= new Date(sale.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></div>
          <% if (sale.exp) { %>
            <div class="countdown text-xs font-mono mt-0.5" data-exp="<%= sale.exp %>">…</div>
          <% } %>
        </div>
        <span class="text-[var(--gold)] text-xs">ดู →</span>
      </a>
    <% }) %>
  </div>
</section>

<script>
  function fmtCountdown(ms) {
    if (ms <= 0) return '✕ หมดอายุแล้ว';
    const s = Math.floor(ms / 1000);
    const d = Math.floor(s / 86400);
    const h = Math.floor((s % 86400) / 3600);
    const m = Math.floor((s % 3600) / 60);
    if (d > 0) return `เหลือ ${d} วัน ${h} ชม.`;
    if (h > 0) return `เหลือ ${h} ชม. ${m} นาที`;
    return `เหลือ ${m} นาที`;
  }
  function tickCountdowns() {
    document.querySelectorAll('.countdown[data-exp]').forEach(el => {
      const ms = Number(el.dataset.exp) - Date.now();
      el.textContent = fmtCountdown(ms);
      el.classList.toggle('text-[var(--coral)]', ms <= 0);
      el.classList.toggle('text-emerald-400', ms > 0);
    });
  }
  tickCountdowns();
  setInterval(tickCountdowns, 30000);
</script>
