<% const v4Newest = (Array.isArray(newest) ? newest : []).slice(0, 5); %>
<% const v4Categories = (Array.isArray(recommendedCategories) ? recommendedCategories : []).slice(0, 6); %>
<% const v4BoxPrizes = (Array.isArray(miniGamePrizes) ? miniGamePrizes : []).filter(p => (p.gameType || 'box') === 'box'); %>
<% const v4RailPrizes = (Array.isArray(miniGamePrizes) ? miniGamePrizes : []).filter(p => p.gameType === 'rail'); %>
<main class="owner-v4-home">
  <section class="v4-hero" aria-labelledby="v4-hero-title">
    <div class="v4-hero__copy"><span class="v4-kicker">LILTEAM / CURATED DIGITAL STORE</span><h1 id="v4-hero-title">ของที่คุณอยากได้<br><em>จัดไว้ให้แล้ว</em></h1><p><%= settings.tagline || 'เลือกสินค้าได้ง่าย ภาพชัดทุกใบ พร้อมส่งหลังชำระเงิน' %></p><div class="v4-hero__actions"><a href="/products" class="v4-btn v4-btn--dark">เลือกสินค้า <span>→</span></a><a href="/account/topup" class="v4-btn v4-btn--gold">เติมเงิน <span>+</span></a></div><div class="v4-hero__notes"><span><i>✓</i> ตรวจสอบสถานะได้</span><span><i>✓</i> ดูรูปสินค้าเต็มใบ</span></div></div>
    <div class="v4-hero__showcase"><div class="v4-hero__backdrop"></div><div class="v4-hero__label"><b></b> เปิดให้บริการ <span>24 ชั่วโมง</span></div><div class="v4-hero__cards"><% v4Newest.slice(0, 3).forEach((p, i) => { %><a href="/game/<%= p.slug %>" class="v4-hero-card v4-hero-card--<%= i + 1 %>"><img src="<%= p.images && p.images[0] ? p.images[0] : '' %>" alt="<%= p.title %>" loading="eager" decoding="async" /><span><%= p.title %></span></a><% }) %></div><div class="v4-hero__showcase-foot"><span>NEW ARRIVALS</span><strong><%= Number(v4Newest.length).toLocaleString() %> รายการแนะนำ</strong></div></div>
  </section>

  <section class="v4-trustbar" aria-label="จุดเด่นของร้าน"><div><b>01</b><span><strong>เลือกง่าย</strong><small>หมวดหมู่และตัวกรองจากหลังบ้าน</small></span></div><div><b>02</b><span><strong>ภาพเต็มใบ</strong><small>เห็นรายละเอียดสินค้าก่อนตัดสินใจ</small></span></div><div><b>03</b><span><strong>รับของเร็ว</strong><small>พร้อมส่งเมื่อรายการสำเร็จ</small></span></div><div><b>04</b><span><strong>ดูแลต่อเนื่อง</strong><small>ตรวจสอบคำสั่งซื้อได้ทุกเวลา</small></span></div></section>

  <% if (announcements && announcements.length) { %><section class="v4-announcements" aria-label="ประกาศร้าน"><span class="v4-section-label">ประกาศล่าสุด</span><div class="v4-announcement-track"><% announcements.slice(0, 3).forEach(a => { %><article><b>●</b><strong><%= a.title %></strong><span><%= a.body %></span></article><% }) %></div></section><% } %>

  <% if (v4Categories.length) { %><section class="v4-section v4-categories"><header class="v4-section-head"><div><span class="v4-section-label">BROWSE COLLECTIONS</span><h2>หมวดหมู่ที่คุณตามหา</h2></div><a href="/products">ดูทั้งหมด <span>→</span></a></header><div class="v4-category-grid"><% v4Categories.forEach((category, i) => { %><a href="/products?recommended=<%= encodeURIComponent(category.id) %>" class="v4-category-card"><div class="v4-category-card__image"><% if (category.imageUrl) { %><img src="<%= category.imageUrl %>" alt="<%= category.title %>" loading="lazy" decoding="async" /><% } else { %><span><%= String(i + 1).padStart(2, '0') %></span><% } %></div><div><b><%= category.title %></b><small><%= Number(category.count || 0).toLocaleString() %> รายการ</small></div><em>↗</em></a><% }) %></div></section><% } %>

  <% if (scheduledProducts && scheduledProducts.length) { %><section class="v4-section v4-events"><header class="v4-section-head"><div><span class="v4-section-label">COMING SOON</span><h2>กำลังจะเข้าในร้าน</h2></div><span class="v4-section-note">เปิดขายตามเวลาที่ตั้งไว้</span></header><div class="v4-event-grid"><% scheduledProducts.slice(0, 4).forEach(product => { %><article class="v4-event-card" data-v4-event="<%= product.publishAt %>"><div class="v4-event-card__image"><img src="<%= product.images && product.images[0] ? product.images[0] : '' %>" alt="<%= product.title %>" loading="lazy" decoding="async" /></div><div><span>กำลังเตรียมเปิดขาย</span><h3><%= product.title %></h3><p><%= product.eventDescription || 'เตรียมตัวให้พร้อมสำหรับรายการใหม่' %></p></div><strong class="v4-event-countdown">--:--:--</strong></article><% }) %></div></section><% } %>

  <% if (latestOrders && latestOrders.length) { %><section class="v4-section v4-latest"><header class="v4-section-head"><div><span class="v4-section-label">LIVE STORE ACTIVITY</span><h2>รายการล่าสุดจากหน้าร้าน</h2></div><span class="v4-section-note">อัปเดตแบบเรียลไทม์</span></header><div class="v4-latest-rail"><div><% latestOrders.slice(0, 8).forEach(order => { %><a href="<%= order.slug ? '/game/' + order.slug : '/products' %>"><span class="v4-latest-rail__image"><% if (order.image) { %><img src="<%= order.image %>" alt="" loading="lazy" decoding="async" /><% } %></span><span><b><%= order.title %></b><small>฿<%= order.amount.toLocaleString() %> · <%= order.buyer %></small></span><em>ดู</em></a><% }) %></div></div></section><% } %>

  <% if (filterTags && filterTags.length) { %><section class="v4-section v4-filters"><header class="v4-section-head"><div><span class="v4-section-label">FIND YOUR PLAYER</span><h2>เลือกตัวกรองสินค้า</h2></div><a href="/products">เปิดหน้าค้นหาเต็มรูปแบบ <span>→</span></a></header><%- include('../partials/filter-panel', { filterTags }) %></section><% } %>

  <section class="v4-section v4-catalog" aria-labelledby="v4-catalog-title"><header class="v4-catalog-head"><div><span class="v4-section-label">THE FULL CATALOG</span><h2 id="v4-catalog-title">สินค้าทั้งหมด</h2><p><%= productTotal %> รายการจากระบบหลังบ้าน</p></div><div class="v4-catalog-tools"><label><span>⌕</span><input id="v4Search" type="search" placeholder="ค้นหาชื่อสินค้า..." autocomplete="off" /></label><div><button type="button" class="is-active" data-v4-stock="all">ทั้งหมด</button><button type="button" data-v4-stock="available">พร้อมขาย</button><button type="button" data-v4-stock="sold">หมด</button></div></div></header>
    <% if (homeSections && homeSections.length) { %><% homeSections.forEach(section => { %><section class="v4-managed-section" id="home-section-<%= section.id %>"><header><h3><%= section.title %></h3><span>จัดการจากหลังบ้าน</span></header><div class="v4-product-grid"> <% section.products.forEach(p => { %><%- include('../partials/product-card-v4', { p }) %><% }) %></div></section><% }) %><% } %>
    <div class="v4-managed-section v4-managed-section--all"><header><h3>รายการทั้งหมด</h3><span><%= productTotal %> รายการ</span></header><div class="v4-product-grid" id="v4ProductGrid"><% if (products && products.length) { %><% products.forEach(p => { %><%- include('../partials/product-card-v4', { p }) %><% }) %><% } else { %><div class="v4-empty">ยังไม่มีสินค้าในระบบ</div><% } %></div><% if (productTotalPages > 1) { %><div class="v4-pagination"><span>หน้า <%= productPage %> / <%= productTotalPages %></span><a href="/?page=<%= Math.max(1, productPage - 1) %>">‹ ก่อนหน้า</a><a href="/?page=<%= Math.min(productTotalPages, productPage + 1) %>">ถัดไป ›</a></div><% } %></div>
  </section>

  <% if (settings.miniGame && settings.miniGame.boxEnabled && v4BoxPrizes.length) { %><section class="v4-section v4-minigame"><header class="v4-section-head"><div><span class="v4-section-label">PLAY & WIN</span><h2><%= settings.miniGame.title || 'เปิดกล่องลุ้นรางวัล' %></h2><p><%= settings.miniGame.description || 'รางวัลจริงจากสต็อกของร้าน' %></p></div><strong>เริ่ม ฿<%= Number(settings.miniGame.costPerPlay || 0).toLocaleString() %></strong></header><div class="v4-prize-grid"><% v4BoxPrizes.slice(0, 6).forEach(prize => { %><div><% if (prize.image) { %><img src="<%= prize.image %>" alt="<%= prize.name %>" loading="lazy" decoding="async" /><% } else { %><span>?</span><% } %><b><%= prize.name %></b><small>โอกาส <%= prize.percent %>%</small></div><% }) %></div><%- include('../partials/minigame-widget', { endpoint: '/minigame/play', cost: settings.miniGame.costPerPlay, ctaLabel: 'เปิดกล่อง', showLogin: !currentUser, balance: currentUser ? currentUser.walletBalance : null }) %></section><% } %>

  <section class="v4-final-cta"><div><span class="v4-section-label">LILTEAM SHOP</span><h2>พร้อมเลือกสินค้าของคุณแล้วหรือยัง?</h2><p>ทุกอย่างจัดไว้ให้ดูง่ายจากระบบเดียว</p></div><div><a href="/products" class="v4-btn v4-btn--dark">ไปที่ร้านค้า <span>→</span></a><a href="/help" class="v4-text-link">ดูวิธีสั่งซื้อ</a></div></section>
</main>
<script>
(function(){
  const grid=document.getElementById('v4ProductGrid'), search=document.getElementById('v4Search'), buttons=[...document.querySelectorAll('[data-v4-stock]')]; if(grid){const cards=[...grid.querySelectorAll('[data-v4-product]')];let stock='all';const apply=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('th-TH');cards.forEach(card=>card.hidden=!!((q&&!card.dataset.title.includes(q))||(stock!=='all'&&card.dataset.stock!==stock)))};search?.addEventListener('input',apply);buttons.forEach(b=>b.addEventListener('click',()=>{stock=b.dataset.v4Stock;buttons.forEach(x=>x.classList.toggle('is-active',x===b));apply()}));apply()}
  const events=[...document.querySelectorAll('[data-v4-event]')];if(events.length){const parse=v=>Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(v)?v:v+':00+07:00');const tick=()=>events.forEach(e=>{const left=parse(e.dataset.v4Event)-Date.now();if(left<=0){e.querySelector('.v4-event-countdown').textContent='เปิดแล้ว';return}const s=Math.floor(left/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),sec=s%60;e.querySelector('.v4-event-countdown').textContent=(d?d+' วัน ':'')+[h,m,sec].map(n=>String(n).padStart(2,'0')).join(':')});tick();setInterval(tick,1000)}
})();
</script>
