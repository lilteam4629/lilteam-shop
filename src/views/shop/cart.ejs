<section class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">ตะกร้าสินค้า</h1>

  <% if (!items.length) { %>
    <div class="text-center py-16 text-[var(--text-3)]">
      <p class="mb-4">ตะกร้าของคุณว่างเปล่า</p>
      <a href="/products" class="text-[var(--gold-text)]">เลือกซื้อสินค้า →</a>
    </div>
  <% } else { %>
    <% const ownerPickupOnly = items.some(i => i.federatedTenantId); %>
    <% const tenantOwnerBlocked = ownerPickupOnly && !isMainSite && currentUser && currentUser.role === 'admin'; %>
    <% if (ownerPickupOnly) { %>
      <div class="mb-5 rounded-2xl border-2 border-[var(--gold)]/60 bg-[var(--gold)]/10 p-4 shadow-sm">
        <div class="font-black text-[var(--gold-text)]">🔒 เติมเงินในร้านนี้ก่อนซื้อ · รับสินค้าที่ร้านหลักเท่านั้น</div>
        <p class="mt-1 text-sm leading-relaxed text-[var(--text-2)]"><%= tenantOwnerBlocked ? 'บัญชีเจ้าของร้านเช่าไม่สามารถใช้เงินของร้านเช่าซื้อรายการนี้ได้' : 'เงินเติมเข้าบัญชีร้านหลักของเรา ยอดจะถูกใช้ซื้อผ่านร้านนี้ หลังซื้อสำเร็จเท่านั้นให้กดติดต่อร้านหลักจากหน้าออเดอร์เพื่อรับไอดี' %></p>
        <% if (!tenantOwnerBlocked) { %><a href="/account/topup" class="mt-3 inline-flex items-center justify-center rounded-lg border border-[var(--gold)]/45 bg-[var(--card)] px-4 py-2 text-xs font-black text-[var(--gold-text)]">เติมเงินเข้าบัญชีร้านหลักก่อนซื้อ →</a><% } %>
      </div>
    <% } %>
    <div class="space-y-3 mb-6">
      <% items.forEach(i => { %>
        <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 flex flex-col sm:flex-row gap-4">
          <a href="/game/<%= i.product.slug %>" class="shrink-0 w-full sm:w-28 aspect-[4/3] sm:aspect-square rounded-xl overflow-hidden bg-[var(--input)] border border-[var(--border-light)] flex items-center justify-center">
            <img src="<%= i.product.images[0] %>" alt="<%= i.product.title %>" class="w-full h-full object-contain" />
          </a>
          <div class="flex-1 min-w-0 flex flex-col gap-2">
            <div>
              <a href="/game/<%= i.product.slug %>" class="font-medium hover:text-[var(--gold-text)] line-clamp-2"><%= i.product.title %></a>
              <div class="text-sm text-[var(--text-3)] mt-0.5">
                <% if (i.product.flashSaleActive) { %><span class="font-bold text-[var(--gold-text)]">⚡ Flash Sale</span> · <% } %>
                ฿<%= i.unitPrice.toLocaleString() %>.00 / รายการ &middot; คงเหลือ <%= i.stock %>
                <% if (i.product.priceOptions && i.product.priceOptions.length) { %><span class="text-[10px]">(ราคาลดตามจำนวน — อัปเดตจำนวนเพื่อดูราคาที่ถูกลง)</span><% } %>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 mt-auto">
              <form action="/cart/update/<%= i.product.id %>" method="post" class="flex items-center gap-2">
                <input type="number" name="qty" value="<%= i.qty %>" min="1" max="<%= i.stock %>" class="w-16 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1.5 text-sm" />
                <button class="text-xs text-[var(--gold-text)] hover:text-[var(--gold-hover)]">อัปเดต</button>
              </form>
              <div class="flex items-center gap-4">
                <span class="font-semibold text-[var(--gold-text)]">฿<%= i.subtotal.toLocaleString() %>.00</span>
                <form action="/cart/remove/<%= i.product.id %>" method="post">
                  <button class="text-[var(--coral)] text-sm hover:underline">ลบ</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 space-y-3">
      <% if (coupon) { %>
        <div class="flex items-center justify-between text-sm">
          <span class="text-emerald-400">ใช้โค้ด "<%= coupon.code %>" แล้ว</span>
          <form action="/cart/coupon/remove" method="post"><button class="text-[var(--coral)]">ลบโค้ด</button></form>
        </div>
      <% } else { %>
        <form action="/cart/coupon" method="post" class="flex gap-2">
          <input name="code" placeholder="โค้ดส่วนลด" class="flex-1 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
          <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--gold-contrast)] font-medium px-4 rounded-lg text-sm">ใช้โค้ด</button>
        </form>
      <% } %>
      <div class="flex items-center justify-between text-lg font-bold pt-2 border-t border-[var(--border)]">
        <span>ยอดรวม</span>
        <span class="text-[var(--gold-text)]">฿<%= total.toLocaleString() %>.00</span>
      </div>
      <form action="/cart/checkout" method="post">
        <button <%= tenantOwnerBlocked ? 'disabled' : '' %> class="w-full rounded-lg py-3 font-medium <%= tenantOwnerBlocked ? 'cursor-not-allowed bg-[var(--input)] text-[var(--text-4)]' : 'bg-[var(--gold)] text-[var(--gold-contrast)] hover:bg-[var(--gold-hover)]' %>"><%= tenantOwnerBlocked ? 'เจ้าของร้านเช่าไม่สามารถซื้อรายการนี้' : (ownerPickupOnly ? 'ชำระเงินผ่านบัญชีร้านหลักและยืนยันออเดอร์' : 'ชำระเงินด้วยกระเป๋าเงิน (Demo)') %></button>
      </form>
    </div>
  <% } %>
</section>
