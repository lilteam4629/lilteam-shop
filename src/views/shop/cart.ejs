<section class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">ตะกร้าสินค้า</h1>

  <% if (!items.length) { %>
    <div class="text-center py-16 text-[var(--text-3)]">
      <p class="mb-4">ตะกร้าของคุณว่างเปล่า</p>
      <a href="/products" class="text-[var(--gold)]">เลือกซื้อสินค้า →</a>
    </div>
  <% } else { %>
    <div class="space-y-3 mb-6">
      <% items.forEach(i => { %>
        <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4 flex flex-col sm:flex-row gap-4">
          <a href="/game/<%= i.product.slug %>" class="shrink-0 w-full sm:w-28 aspect-[4/3] sm:aspect-square rounded-xl overflow-hidden bg-[var(--input)] border border-[var(--border-light)] flex items-center justify-center">
            <img src="<%= i.product.images[0] %>" alt="<%= i.product.title %>" class="w-full h-full object-contain" />
          </a>
          <div class="flex-1 min-w-0 flex flex-col gap-2">
            <div>
              <a href="/game/<%= i.product.slug %>" class="font-medium hover:text-[var(--gold)] line-clamp-2"><%= i.product.title %><% if (i.optionLabel) { %> <span class="text-xs font-normal text-[var(--text-3)]">(<%= i.optionLabel %>)</span><% } %></a>
              <div class="text-sm text-[var(--text-3)] mt-0.5">
                <% if (!i.optionLabel && i.product.flashSaleActive) { %><span class="font-bold text-[var(--gold)]">⚡ Flash Sale</span> · <% } %>
                ฿<%= i.unitPrice.toLocaleString() %>.00 / รายการ &middot; คงเหลือ <%= i.stock %>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 mt-auto">
              <form action="/cart/update/<%= i.product.id %>" method="post" class="flex items-center gap-2">
                <input type="hidden" name="optionId" value="<%= i.optionId || '' %>" />
                <input type="number" name="qty" value="<%= i.qty %>" min="1" max="<%= i.stock %>" class="w-16 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-2 py-1.5 text-sm" />
                <button class="text-xs text-[var(--gold)] hover:text-[var(--gold-hover)]">อัปเดต</button>
              </form>
              <div class="flex items-center gap-4">
                <span class="font-semibold text-[var(--gold)]">฿<%= i.subtotal.toLocaleString() %>.00</span>
                <form action="/cart/remove/<%= i.product.id %>" method="post">
                  <input type="hidden" name="optionId" value="<%= i.optionId || '' %>" />
                  <button class="text-[var(--coral)] text-sm hover:underline">ลบ</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 space-y-3">
      <% if (coupon) { %>
        <div class="flex items-center justify-between text-sm">
          <span class="text-emerald-400">ใช้โค้ด "<%= coupon.code %>" แล้ว</span>
          <form action="/cart/coupon/remove" method="post"><button class="text-[var(--coral)]">ลบโค้ด</button></form>
        </div>
      <% } else { %>
        <form action="/cart/coupon" method="post" class="flex gap-2">
          <input name="code" placeholder="โค้ดส่วนลด" class="flex-1 bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2 text-sm" />
          <button class="bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-4 rounded-lg text-sm">ใช้โค้ด</button>
        </form>
      <% } %>
      <div class="flex items-center justify-between text-lg font-bold pt-2 border-t border-[var(--border)]">
        <span>ยอดรวม</span>
        <span class="text-[var(--gold)]">฿<%= total.toLocaleString() %>.00</span>
      </div>
      <form action="/cart/checkout" method="post">
        <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] rounded-lg py-3 font-medium">ชำระเงินด้วยกระเป๋าเงิน (Demo)</button>
      </form>
    </div>
  <% } %>
</section>
