<section class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-6">ติดต่อร้าน</h1>
  <div class="bg-[#1a160d] border border-[#3a3220] rounded-xl p-6 space-y-3 text-sm">
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[#a89a6c]">ชื่อร้าน</span><span><%= settings.shopName %></span></div>
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[#a89a6c]">Line</span><span class="text-[#c8a63f]"><%= settings.contactLine %></span></div>
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[#a89a6c]">Facebook</span><a href="<%= settings.contactFacebook %>" class="text-[#c8a63f]" target="_blank" rel="noopener">แฟนเพจร้านค้า</a></div>
    <div class="flex justify-between"><span class="text-[#a89a6c]">เวลาเปิดบริการ</span><span><%= settings.openHours %></span></div>
  </div>
</section>
