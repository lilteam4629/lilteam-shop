<section class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-6">ติดต่อร้าน</h1>
  <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6 space-y-3 text-sm">
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[var(--text-3)]">ชื่อร้าน</span><span><%= settings.shopName %></span></div>
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[var(--text-3)]">Line</span><span class="text-[var(--gold)]"><%= settings.contactLine %></span></div>
    <div class="flex justify-between border-b border-[#241f13] pb-3"><span class="text-[var(--text-3)]">Facebook</span><a href="<%= settings.contactFacebook %>" class="text-[var(--gold)]" target="_blank" rel="noopener">แฟนเพจร้านค้า</a></div>
    <div class="flex justify-between"><span class="text-[var(--text-3)]">เวลาเปิดบริการ</span><span><%= settings.openHours %></span></div>
  </div>
</section>
