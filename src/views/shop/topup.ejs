<section class="max-w-lg mx-auto px-4 py-10">
  <a href="/account" class="text-sm text-[#c8a63f]">← กลับไปหน้าบัญชี</a>
  <h1 class="text-2xl font-bold mt-2 mb-6">เติมเงินเข้ากระเป๋า</h1>

  <form action="/account/topup" method="post" class="bg-[#1a160d] border border-[#3a3220] rounded-xl p-6 space-y-5">
    <div>
      <label class="block text-sm mb-2 text-[#a89a6c]">เลือกจำนวนเงิน</label>
      <div class="grid grid-cols-3 gap-2 mb-2" id="amountPresets">
        <% [100, 300, 500, 1000, 2000, 5000].forEach(v => { %>
          <button type="button" data-amount="<%= v %>"
            class="amount-btn bg-[#211c11] border border-[#443a22] hover:border-[#c8a63f]/60 rounded-lg py-2.5 text-sm font-medium transition-colors">
            ฿<%= v.toLocaleString() %>
          </button>
        <% }) %>
      </div>
      <input type="number" name="amount" id="amountInput" min="20" step="1" required placeholder="หรือระบุจำนวนเงินเอง (ขั้นต่ำ 20 บาท)"
        class="w-full bg-[#211c11] border border-[#443a22] rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-[#c8a63f]" />
    </div>

    <div>
      <label class="block text-sm mb-2 text-[#a89a6c]">ช่องทางชำระเงิน</label>
      <div class="grid grid-cols-2 gap-2">
        <label class="method-option flex items-center gap-2 bg-[#211c11] border-2 border-[#c8a63f] rounded-lg px-3 py-2.5 cursor-pointer text-sm">
          <input type="radio" name="method" value="promptpay" checked class="accent-[#c8a63f]" />
          พร้อมเพย์ (PromptPay)
        </label>
        <label class="method-option flex items-center gap-2 bg-[#211c11] border-2 border-[#443a22] rounded-lg px-3 py-2.5 cursor-pointer text-sm">
          <input type="radio" name="method" value="bank_transfer" class="accent-[#c8a63f]" />
          โอนผ่านธนาคาร
        </label>
      </div>
    </div>

    <button class="w-full bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-semibold rounded-lg py-3">
      ดำเนินการต่อ
    </button>
  </form>

  <p class="text-xs text-[#7a6f47] mt-4 text-center">
    หลังโอนเงินแล้วให้แนบสลิปในหน้าถัดไป ทีมงานจะตรวจสอบและเติมเงินให้ภายในไม่กี่นาที
  </p>
</section>

<script>
  document.querySelectorAll('.amount-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('amountInput').value = btn.dataset.amount;
      document.querySelectorAll('.amount-btn').forEach((b) => b.classList.remove('border-[#c8a63f]', 'bg-[#c8a63f]/10'));
      btn.classList.add('border-[#c8a63f]', 'bg-[#c8a63f]/10');
    });
  });
  document.querySelectorAll('input[name="method"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.method-option').forEach((el) => {
        const active = el.querySelector('input').checked;
        el.classList.toggle('border-[#c8a63f]', active);
        el.classList.toggle('border-[#443a22]', !active);
      });
    });
  });
</script>
