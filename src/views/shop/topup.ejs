<section class="max-w-lg mx-auto px-4 py-10">
  <a href="/account" class="text-sm text-[var(--gold)] hover:text-[var(--gold-hover)]">← กลับไปหน้าบัญชี</a>

  <div class="flex items-center gap-3 mt-3 mb-6">
    <span class="w-12 h-12 shrink-0 rounded-2xl bg-gradient-to-br from-[var(--gold-light)] to-[var(--gold-dark)] text-[var(--bg)] flex items-center justify-center text-2xl shadow-[0_6px_18px_-6px_color-mix(in_srgb,var(--gold)_70%,transparent)]">💰</span>
    <div>
      <h1 class="text-2xl font-bold leading-tight">เติมเงินเข้ากระเป๋า</h1>
      <p class="text-xs text-[var(--text-4)]">เติมปุ๊บ ใช้ซื้อสินค้าได้ทันที</p>
    </div>
  </div>

  <form action="/account/topup" method="post" class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 sm:p-6 space-y-6 shadow-[0_18px_40px_-24px_rgba(0,0,0,.5)]">
    <div>
      <label class="block text-sm font-medium mb-3">เลือกจำนวนเงิน</label>
      <div class="grid grid-cols-3 gap-2.5 mb-3" id="amountPresets">
        <% [100, 300, 500, 1000, 2000, 5000].forEach(v => { %>
          <button type="button" data-amount="<%= v %>"
            class="amount-btn relative bg-[var(--input)] border-2 border-[var(--border-light)] hover:border-[var(--gold)]/60 hover:-translate-y-0.5 rounded-xl py-3 text-sm font-semibold transition-all">
            ฿<%= v.toLocaleString() %>
          </button>
        <% }) %>
      </div>
      <div class="relative">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-4)] text-sm">฿</span>
        <input type="number" name="amount" id="amountInput" min="1" step="1" required placeholder="หรือระบุจำนวนเงินเอง (ขั้นต่ำ 1 บาท)"
          class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl pl-8 pr-3 py-3 text-sm focus:outline-none focus:border-[var(--gold)] transition-colors" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium mb-3">ช่องทางชำระเงิน</label>
      <div class="grid grid-cols-2 gap-2.5">
        <label class="method-option relative flex flex-col items-center gap-1.5 bg-[var(--input)] border-2 border-[var(--gold)] rounded-xl px-3 py-4 cursor-pointer text-center transition-colors">
          <input type="radio" name="method" value="promptpay" checked class="peer sr-only" />
          <span class="method-check hidden absolute top-2 right-2 w-4 h-4 rounded-full bg-[var(--gold)] text-[var(--bg)] text-[10px] items-center justify-center">✓</span>
          <span class="text-2xl">📱</span>
          <span class="text-sm font-medium leading-tight">พร้อมเพย์<br />(PromptPay)</span>
        </label>
        <label class="method-option relative flex flex-col items-center gap-1.5 bg-[var(--input)] border-2 border-[var(--border-light)] rounded-xl px-3 py-4 cursor-pointer text-center transition-colors">
          <input type="radio" name="method" value="bank_transfer" class="peer sr-only" />
          <span class="method-check hidden absolute top-2 right-2 w-4 h-4 rounded-full bg-[var(--gold)] text-[var(--bg)] text-[10px] items-center justify-center">✓</span>
          <span class="text-2xl">🏦</span>
          <span class="text-sm font-medium leading-tight">โอนผ่าน<br />ธนาคาร</span>
        </label>
      </div>
    </div>

    <button class="group relative w-full overflow-hidden bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-xl py-3.5 text-sm transition-colors">
      <span class="relative">ดำเนินการต่อ →</span>
    </button>
  </form>

  <div class="flex items-start gap-2.5 bg-[var(--gold)]/10 border border-[var(--gold)]/25 rounded-xl px-4 py-3 mt-4 text-xs text-[var(--text-2)]">
    <span class="shrink-0">💡</span>
    <span>หลังโอนเงินแล้วให้แนบสลิปในหน้าถัดไป ทีมงานจะตรวจสอบและเติมเงินให้ภายในไม่กี่นาที</span>
  </div>
</section>

<script>
  document.querySelectorAll('.amount-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('amountInput').value = btn.dataset.amount;
      document.querySelectorAll('.amount-btn').forEach((b) => b.classList.remove('border-[var(--gold)]', 'bg-[var(--gold)]/10'));
      btn.classList.add('border-[var(--gold)]', 'bg-[var(--gold)]/10');
    });
  });
  document.querySelectorAll('input[name="method"]').forEach((radio) => {
    radio.addEventListener('change', syncMethodOptions);
  });
  function syncMethodOptions() {
    document.querySelectorAll('.method-option').forEach((el) => {
      const active = el.querySelector('input').checked;
      el.classList.toggle('border-[var(--gold)]', active);
      el.classList.toggle('border-[var(--border-light)]', !active);
      el.classList.toggle('bg-[var(--gold)]/10', active);
      const check = el.querySelector('.method-check');
      check.classList.toggle('hidden', !active);
      check.classList.toggle('flex', active);
    });
  }
  syncMethodOptions();
</script>
