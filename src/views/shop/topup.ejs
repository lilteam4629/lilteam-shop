<% if (!catalogApiTopup) { %>
<script>
  function switchTab(tab) {
    const tabTm = document.getElementById('tabTruemoney');
    const tabBk = document.getElementById('tabBank');
    const secTm = document.getElementById('sectionTruemoney');
    const secBk = document.getElementById('sectionBank');

    if (tab === 'truemoney') {
      tabTm.className = 'flex items-center justify-center gap-2 py-3 px-4 rounded-xl border-2 font-medium text-sm transition-all border-[var(--gold)] bg-[var(--gold)]/10 text-[var(--gold-text)]';
      tabBk.className = 'flex items-center justify-center gap-2 py-3 px-4 rounded-xl border-2 font-medium text-sm transition-all border-[var(--border-light)] bg-[var(--card)] text-[var(--text-3)] hover:border-[var(--gold)]/50';
      secTm.classList.remove('hidden');
      secBk.classList.add('hidden');
    } else {
      tabBk.className = 'flex items-center justify-center gap-2 py-3 px-4 rounded-xl border-2 font-medium text-sm transition-all border-[var(--gold)] bg-[var(--gold)]/10 text-[var(--gold-text)]';
      tabTm.className = 'flex items-center justify-center gap-2 py-3 px-4 rounded-xl border-2 font-medium text-sm transition-all border-[var(--border-light)] bg-[var(--card)] text-[var(--text-3)] hover:border-[var(--gold)]/50';
      secBk.classList.remove('hidden');
      secTm.classList.add('hidden');
    }
  }
  document.querySelectorAll('.amount-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('amountInput').value = btn.dataset.amount;
      document.getElementById('amountError').classList.add('hidden');
      document.querySelectorAll('.amount-btn').forEach((b) => b.classList.remove('border-[var(--gold)]', 'bg-[var(--gold)]/10'));
      btn.classList.add('border-[var(--gold)]', 'bg-[var(--gold)]/10');
    });
  });
  (function () {
    const amountInput = document.getElementById('amountInput');
    const amountError = document.getElementById('amountError');
    // type="number" silently blocks submission (no visible error) in some
    // in-app browsers (Instagram/Facebook/TikTok webviews) whenever the
    // native constraint validation fails — e.g. a stray decimal point from
    // a numeric keypad. Using a plain text input + our own validation here
    // means typing an amount behaves the same as tapping a preset button.
    amountInput.addEventListener('input', () => {
      const digitsOnly = amountInput.value.replace(/[^0-9]/g, '');
      if (digitsOnly !== amountInput.value) amountInput.value = digitsOnly;
      amountError.classList.add('hidden');
    });
    amountInput.closest('form').addEventListener('submit', (event) => {
      const amount = parseInt(amountInput.value, 10);
      if (!amount || amount < 1) {
        event.preventDefault();
        amountError.classList.remove('hidden');
        amountInput.focus();
      }
    });
  })();
  document.querySelectorAll('input[name="method"]').forEach((radio) => {
    radio.addEventListener('change', syncMethodOptions);
  });
  function syncMethodOptions() {
    document.querySelectorAll('.method-option').forEach((el) => {
      const active = el.querySelector('input').checked;
      el.classList.toggle('border-[var(--gold)]', active);
      el.classList.toggle('border-[var(--border-light)]', !active);
      el.classList.toggle('bg-[var(--gold)]/10', active);
      const check = el.querySelector('.method-check');
      check.classList.toggle('hidden', !active);
      check.classList.toggle('flex', active);
    });
  }
  syncMethodOptions();
</script>
<% } %>

<% } %>
