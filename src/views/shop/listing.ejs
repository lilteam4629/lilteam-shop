<section class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl font-bold"><%= title %></h1>
    <% if (listType) { %>
      <form method="get" class="flex items-center gap-2 text-sm">
        <% if (typeof activeFilterTags !== 'undefined' && activeFilterTags.length) { %><input type="hidden" name="tags" value="<%= activeFilterTags.map(t => t.id).join(',') %>" /><% } %>
        <label class="text-[var(--text-3)]">เรียงตาม</label>
        <select name="sort" onchange="this.form.submit()" class="bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2">
          <option value="" <%= sort==='' ? 'selected':'' %>>ยอดนิยม</option>
          <option value="newest" <%= sort==='newest' ? 'selected':'' %>>มาใหม่ล่าสุด</option>
          <option value="price_asc" <%= sort==='price_asc' ? 'selected':'' %>>ราคาน้อย → มาก</option>
          <option value="price_desc" <%= sort==='price_desc' ? 'selected':'' %>>ราคามาก → น้อย</option>
          <option value="discount" <%= sort==='discount' ? 'selected':'' %>>ส่วนลดมากสุด</option>
          <option value="name" <%= sort==='name' ? 'selected':'' %>>ชื่อ ก-ฮ / A-Z</option>
        </select>
      </form>
    <% } %>
  </div>

  <% if (listType && filterTags && filterTags.length) { %>
    <%- include('../partials/filter-panel', { filterTags }) %>
  <% } %>

  <% if (typeof activeFilterTags !== 'undefined' && activeFilterTags.length) { %>
    <div class="flex items-center justify-between gap-3 bg-[var(--gold)]/10 border border-[var(--gold)]/30 rounded-xl px-4 py-3 mb-5">
      <div class="text-sm">กำลังแสดงเฉพาะ <b class="text-[var(--gold)]"><%= activeFilterTags.map(t => t.name).join(' + ') %></b></div>
      <a href="/products" class="text-xs text-[var(--coral)] hover:underline whitespace-nowrap">ดูสินค้าทั้งหมด</a>
    </div>
  <% } %>

  <% if (!products.length) { %>
    <p class="text-[var(--text-3)]">ไม่พบสินค้าที่ค้นหา</p>
  <% } else { %>
    <div id="filterResults" class="product-grid grid items-start grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 2xl:grid-cols-5 gap-4">
      <% products.forEach(p => { %>
        <%- include('../partials/product-card', { p }) %>
      <% }) %>
    </div>
    <p class="text-center text-[var(--text-4)] text-xs mt-8">แสดง <%= products.length %> รายการ</p>
  <% } %>
</section>
<style>.product-grid > *{content-visibility:auto;contain-intrinsic-size:auto 420px}</style>
