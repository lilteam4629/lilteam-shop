<% const isMainStorefrontListing = typeof isMainSite !== 'undefined' && isMainSite; %>
<% if (isMainStorefrontListing) { %><link rel="stylesheet" href="<%= asset('css/storefront-catalog-main-v2.css') %>" /><% } %>
<style>.catalog-card[hidden]{display:none!important}</style>
<section class="catalog-page w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-8<%= isMainStorefrontListing ? ' main-storefront-catalog-page' : '' %>">
  <header class="catalog-head">
    <div class="catalog-title"><span class="catalog-title-icon"><svg><use href="#ui-box"/></svg></span><span><h1><%= title %></h1><small>All Products <i>•</i> <b id="catalogVisibleCount"><%= products.length %></b> รายการ</small></span></div>
    <label class="catalog-search"><svg><use href="#ui-search"/></svg><input id="catalogSearch" type="search" placeholder="ค้นหาสินค้า เช่น lilteam-001, นักเตะ, ไอดี..." autocomplete="off" /></label>
    <div class="catalog-status-tabs" role="group" aria-label="กรองสถานะสินค้า"><button type="button" class="active" data-stock-filter="all">ทั้งหมด</button><button type="button" data-stock-filter="available"><i class="available"></i>พร้อมขาย</button><button type="button" data-stock-filter="sold"><i></i>สินค้าหมด</button></div>
  </header>
  <% if (catalogApiNotice) { %>
    <aside class="catalog-api-callout" aria-label="วิธีชำระเงินสินค้า API">
      <div class="catalog-api-callout-icon">API</div>
      <div class="catalog-api-callout-copy"><strong>สินค้า Partner <%= catalogApiShopName %> = เติมเงินผ่าน Partner ก่อนซื้อ</strong><span>ห้ามใช้เงินเติมร้านเช่าซื้อรายการนี้ · กดปุ่มเติมเงินสินค้า API ก่อนสั่งซื้อ · หลังซื้อสำเร็จติดต่อร้านหลักเพื่อรับสินค้า</span></div>
      <div class="catalog-api-callout-actions"><a href="/account/topup/catalog-api">เติมเงินสินค้า API</a><a href="/contact?api=1">ติดต่อร้านหลัก</a></div>
    </aside>
  <% } %>
  <% if (catalogApiProducts && catalogApiProducts.length) { %>
    <section id="catalog-api" class="catalog-api-shelf" aria-label="สินค้า API จากร้านหลัก">
      <header><div class="catalog-api-shelf-brand"><% if (catalogApiLogo) { %><img src="<%= catalogApiLogo %>" alt="<%= catalogApiShopName %>" /><% } else { %><span class="catalog-api-shelf-logo-fallback">L</span><% } %><div><small>MAIN SHOP API</small><h2>สินค้า Partner <%= catalogApiShopName %></h2><p>แยกจากสินค้าร้านเช่า · ต้องเติมเงินสินค้า API ก่อนซื้อเท่านั้น</p></div></div><div><a href="/account/topup/catalog-api">เติมเงิน API →</a><a href="/contact?api=1">ติดต่อร้านหลัก</a></div></header>
      <div class="catalog-api-shelf-grid"><% catalogApiProducts.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %></div>
    </section>
  <% } %>
  <% if (listType) { %><div class="catalog-sort-row"><span>พบสินค้า <b><%= products.length %></b> รายการ</span><form method="get"><% if (typeof activeFilterTags !== 'undefined' && activeFilterTags.length) { %><input type="hidden" name="tags" value="<%= activeFilterTags.map(t => t.id).join(',') %>" /><% } %><label>เรียงตาม</label><select name="sort" onchange="this.form.submit()"><option value="" <%= sort==='' ? 'selected':'' %>>ยอดนิยม</option><option value="newest" <%= sort==='newest' ? 'selected':'' %>>มาใหม่ล่าสุด</option><option value="price_asc" <%= sort==='price_asc' ? 'selected':'' %>>ราคาน้อย → มาก</option><option value="price_desc" <%= sort==='price_desc' ? 'selected':'' %>>ราคามาก → น้อย</option><option value="discount" <%= sort==='discount' ? 'selected':'' %>>ส่วนลดมากสุด</option><option value="name" <%= sort==='name' ? 'selected':'' %>>ชื่อ ก-ฮ / A-Z</option></select></form></div><% } %>
  <% if (listType && filterTags && filterTags.length) { %><details class="catalog-advanced-filter" <%= typeof activeFilterTags !== 'undefined' && activeFilterTags.length ? 'open' : '' %>><summary><span><svg><use href="#ui-tag"/></svg>ตัวกรองเพิ่มเติม</span><small>เลือกประเภทสินค้า</small></summary><div><%- include('../partials/filter-panel', { filterTags }) %></div></details><% } %>
  <% if (typeof activeFilterTags !== 'undefined' && activeFilterTags.length) { %><div class="catalog-active-tags"><span>กำลังแสดงเฉพาะ <b><%= activeFilterTags.map(t => t.name).join(' + ') %></b></span><a href="/products">ล้างตัวกรอง</a></div><% } %>
  <% if (!products.length && !(catalogApiProducts && catalogApiProducts.length)) { %><div class="catalog-empty"><svg><use href="#ui-search"/></svg><h2>ไม่พบสินค้า</h2><p>ลองเปลี่ยนคำค้นหาหรือตัวกรองสินค้า</p></div><% } else if (products.length) { %>
    <div id="catalogGrid" class="catalog-grid">
      <% products.forEach(p => { const soldOut = p.stockCount < 1; const crossedPrice = p.flashSaleActive ? p.regularPrice : p.originalPrice; %>
        <article class="catalog-card <%= isMainStorefrontListing ? 'main-store-product-card' : '' %> <%= p.isSyndicated ? 'catalog-card-api' : '' %>" data-stock="<%= soldOut ? 'sold' : 'available' %>" data-search="<%= String(p.title || '').toLowerCase() %> <%= String(p.slug || '').toLowerCase() %> <%= (p.genres || []).join(' ').toLowerCase() %>">
          <a href="/game/<%= p.slug %>" class="catalog-image">
            <img src="<%= p.images[0] || '' %>" alt="<%= p.title %>" width="960" height="540" loading="lazy" decoding="async" />
            <% if (!isMainStorefrontListing) { %>
              <% if (p.isSyndicated) { %><span class="catalog-stock ready">Partner</span><% } else { %><span class="catalog-stock <%= soldOut ? 'sold' : 'ready' %>"><%= soldOut ? 'สินค้าหมด' : 'พร้อมขาย' %></span><% } %>
            <% } else if (p.isSyndicated) { %>
              <span class="catalog-stock ready">Partner</span>
            <% } %>
          </a>
          <div class="catalog-card-body">
            <% if (isMainStorefrontListing) { %>
              <div class="catalog-card-title-row main-store-product-title-row">
                <a href="/game/<%= p.slug %>" class="catalog-card-title"><%= p.title %></a>
                <span class="main-store-product-stock" data-stock-state="<%= soldOut ? 'sold' : 'available' %>"><i aria-hidden="true"></i><span><%= soldOut ? 'หมด' : `พร้อมส่ง ${p.stockCount.toLocaleString()}` %></span></span>
              </div>
            <% } else { %>
              <a href="/game/<%= p.slug %>" class="catalog-card-title"><%= p.title %></a>
            <% } %>
            <% if (p.isSyndicated) { %><div class="catalog-api-rule">ต้องเติมเงิน Partner ที่ร้านหลักเท่านั้น</div><% } %>
            <div class="catalog-price"><b>฿<%= p.price.toLocaleString() %>.00</b><% if (crossedPrice > p.price) { %><del>฿<%= crossedPrice.toLocaleString() %>.00</del><% } %></div>
            <a href="<%= soldOut ? '/contact' : '/game/' + p.slug %>" class="catalog-cta <%= soldOut ? 'sold' : '' %>"><svg><use href="#<%= soldOut ? 'ui-clock' : 'ui-cart' %>"/></svg><%= p.isSyndicated ? 'ดูสินค้า Partner · เติมเงินก่อนซื้อ' : (soldOut ? 'สอบถามสินค้าเข้าใหม่' : 'ดูรายละเอียดสินค้า') %></a>
          </div>
        </article>
      <% }) %>
    </div>
    <div id="catalogNoResults" class="catalog-empty hidden"><svg><use href="#ui-search"/></svg><h2>ไม่พบสินค้าที่ตรงกัน</h2><p>ลองใช้คำค้นหาอื่นหรือเลือกสถานะทั้งหมด</p></div>
  <% } %>
</section>
<style>
  .catalog-api-callout{display:flex;align-items:center;gap:13px;margin:14px 0 18px;padding:13px 15px;border:1px solid color-mix(in srgb,var(--gold) 58%,var(--border));border-left:5px solid var(--gold);border-radius:14px;background:linear-gradient(110deg,color-mix(in srgb,var(--gold) 13%,var(--card)),var(--card) 60%);box-shadow:0 14px 30px -24px color-mix(in srgb,var(--gold) 90%,transparent)}
  .catalog-api-callout-icon{display:grid;place-items:center;flex:0 0 auto;width:45px;height:45px;border-radius:11px;background:var(--gold);color:var(--gold-contrast);font-size:10px;font-weight:950;letter-spacing:.08em}.catalog-api-callout-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}.catalog-api-callout-copy strong{color:var(--text);font-size:13px;line-height:1.35}.catalog-api-callout-copy span{color:var(--text-2);font-size:11px;line-height:1.45}.catalog-api-callout-actions{display:flex;flex:0 0 auto;gap:6px}.catalog-api-callout-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:7px 10px;border-radius:8px;background:var(--gold);color:var(--gold-contrast);font-size:10px;font-weight:900;white-space:nowrap}.catalog-api-callout-actions a+a{border:1px solid var(--border-light);background:var(--input);color:var(--text)}.catalog-card-api{border-color:color-mix(in srgb,var(--gold) 60%,var(--border))!important;box-shadow:0 8px 22px -18px color-mix(in srgb,var(--gold) 80%,transparent)}.catalog-api-rule{margin-top:4px;color:var(--coral);font-size:9px;font-weight:900;line-height:1.3}
  .catalog-api-shelf-brand{display:flex;align-items:center;min-width:0;gap:10px}.catalog-api-shelf-brand img,.catalog-api-shelf-logo-fallback{display:grid;place-items:center;width:42px;height:42px;flex:0 0 auto;border-radius:11px;object-fit:contain;background:var(--input);border:1px solid color-mix(in srgb,var(--gold) 45%,var(--border));color:var(--gold-text);font-size:20px;font-weight:950}.catalog-api-shelf-brand>div{min-width:0}
  .catalog-api-shelf{margin:18px 0 22px;padding:15px;border:1px solid color-mix(in srgb,var(--gold) 48%,var(--border));border-radius:15px;background:linear-gradient(140deg,color-mix(in srgb,var(--gold) 7%,var(--card)),var(--card));box-shadow:0 14px 30px -24px color-mix(in srgb,var(--gold) 90%,transparent)}.catalog-api-shelf>header{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:12px}.catalog-api-shelf>header small{color:var(--gold-text);font-size:9px;font-weight:950;letter-spacing:.16em}.catalog-api-shelf>header h2{margin-top:4px;color:var(--text);font-size:19px;font-weight:950;line-height:1.2}.catalog-api-shelf>header p{margin-top:3px;color:var(--text-2);font-size:11px}.catalog-api-shelf>header>div:last-child{display:flex;gap:6px}.catalog-api-shelf>header a{display:inline-flex;align-items:center;justify-content:center;min-height:33px;padding:7px 10px;border-radius:8px;background:var(--gold);color:var(--gold-contrast);font-size:10px;font-weight:900;white-space:nowrap}.catalog-api-shelf>header a+a{border:1px solid var(--border-light);background:var(--input);color:var(--text)}.catalog-api-shelf-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.catalog-api-shelf-grid .premium-product-card{min-width:0}@media(min-width:640px){.catalog-api-shelf-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}}@media(min-width:1024px){.catalog-api-shelf-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:640px){.catalog-api-shelf{padding:12px;border-radius:13px}.catalog-api-shelf>header{align-items:flex-start;flex-direction:column}.catalog-api-shelf>header h2{font-size:17px}.catalog-api-shelf>header>div:last-child{width:100%;display:grid;grid-template-columns:1fr 1fr}.catalog-api-shelf>header a{font-size:10px}}
  @media(max-width:640px){.catalog-api-callout{align-items:flex-start;flex-wrap:wrap;padding:12px}.catalog-api-callout-copy{flex-basis:calc(100% - 58px)}.catalog-api-callout-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}.catalog-api-callout-actions a{font-size:10px}.catalog-api-callout-copy strong{font-size:12px}}
</style>
<script>(()=>{const search=document.getElementById('catalogSearch'),cards=[...document.querySelectorAll('.catalog-card')];if(!search||!cards.length)return;const tabs=[...document.querySelectorAll('[data-stock-filter]')],count=document.getElementById('catalogVisibleCount'),empty=document.getElementById('catalogNoResults');let stock='all';const normal=value=>String(value||'').normalize('NFKC').trim().toLocaleLowerCase('th-TH');const apply=()=>{const query=normal(search.value);let visible=0;cards.forEach(card=>{const show=(!query||normal(card.dataset.search).includes(query))&&(stock==='all'||card.dataset.stock===stock);card.hidden=!show;if(show)visible++});if(count)count.textContent=visible;if(empty)empty.classList.toggle('hidden',visible!==0)};search.addEventListener('input',apply);tabs.forEach(tab=>tab.addEventListener('click',()=>{stock=tab.dataset.stockFilter;tabs.forEach(item=>item.classList.toggle('active',item===tab));apply()}))})();</script>
