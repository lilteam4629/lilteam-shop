<% const sharedHero = typeof storefrontHero !== 'undefined' ? storefrontHero : { bannerImage: settings.hero?.mode === 'none' ? null : settings.hero?.bannerImage, bannerLink: settings.hero?.bannerLink || '' }; %>
<% if (typeof isMainSite !== 'undefined' && isMainSite) { %>
<section class="main-welcome-stage" id="home-top" aria-label="ยินดีต้อนรับสู่ร้าน">
  <div class="main-welcome-crystal-scene" aria-hidden="true">
    <svg class="main-welcome-crystal main-welcome-crystal--left" viewBox="0 0 420 360" fill="none"><g class="main-crystal-facets"><path d="m80 40 125 40 50 115-155 85-65-140Z"/><path d="m80 40 20 240 105-200-170 60 220 55-175-155Z"/><path d="m280 30 80 60-30 85-60-70Z"/><path d="m280 30 50 145 30-85-90 15Z"/></g><path class="main-crystal-energy" d="M-20 300 100 280 255 195 330 175 440 240"/><circle cx="100" cy="280" r="4"/><circle cx="255" cy="195" r="3"/></svg>
    <svg class="main-welcome-crystal main-welcome-crystal--right" viewBox="0 0 420 360" fill="none"><g class="main-crystal-facets"><path d="m80 40 125 40 50 115-155 85-65-140Z"/><path d="m80 40 20 240 105-200-170 60 220 55-175-155Z"/><path d="m280 30 80 60-30 85-60-70Z"/><path d="m280 30 50 145 30-85-90 15Z"/></g><path class="main-crystal-energy" d="M-20 300 100 280 255 195 330 175 440 240"/><circle cx="100" cy="280" r="4"/><circle cx="255" cy="195" r="3"/></svg>
  </div>
  <% const welcomeProducts = typeof products !== 'undefined' ? products.filter(p => p.images && p.images[0]).slice(0, 4) : []; %>
  <% if (welcomeProducts.length) { %>
  <div class="main-welcome-showcase" aria-label="เลือกชมสินค้าในร้าน">
    <% welcomeProducts.forEach((p, index) => { %>
    <a class="main-welcome-tile main-welcome-tile--<%= index %>" href="/game/<%= p.slug %>" aria-label="ดูสินค้า <%= p.title %>"><img src="<%= p.images[0] %>" alt="" width="160" height="160" decoding="async"/><span><%= p.title %></span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
    <% }) %>
  </div>
  <% } %>
  <div class="main-welcome-content">
    <h1>ยินดีต้อนรับสู่ <span><%= settings.shopName %></span></h1>
    <% if (settings.tagline) { %><p><%= settings.tagline %></p><% } %>
    <form class="main-welcome-search" action="/search" method="get" role="search">
      <label class="main-welcome-search-label" for="welcome-search">ค้นหาสินค้าในร้าน</label>
      <input id="welcome-search" type="search" name="q" placeholder="ค้นหาเกมหรือสินค้าที่ต้องการ…" required maxlength="120"/>
      <button type="submit" aria-label="ค้นหาสินค้า"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></button>
    </form>
    <% if (typeof recommendedCategories !== 'undefined' && recommendedCategories.length) { %>
    <nav class="main-welcome-shortcuts" aria-label="หมวดหมู่สินค้า"><% recommendedCategories.slice(0, 3).forEach(category => { %><a href="/products?recommended=<%= encodeURIComponent(category.id) %>"><%= category.title %><span aria-hidden="true">↗</span></a><% }) %></nav>
    <% } %>
    <div class="main-welcome-actions">
      <a class="main-welcome-primary" href="/products">เลือกดูสินค้า<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
      <a class="main-welcome-contact" href="/contact" aria-label="ติดต่อร้าน"><svg width="19" height="19" aria-hidden="true"><use href="#ui-megaphone"/></svg></a>
    </div>
  </div>
</section>
<% } else if (sharedHero.bannerImage) { %>
<section class="owner-home-v20-hero owner-home-v23-hero owner-home-v20-hero--banner owner-home-v20-hero--banner-only" id="home-top" aria-label="แบนเนอร์ร้าน <%= settings.shopName %>">
  <div class="owner-home-v20-artwork">
    <% if (sharedHero.bannerLink) { %>
      <a href="<%= sharedHero.bannerLink %>" aria-label="เปิดแบนเนอร์ร้าน <%= settings.shopName %>"><img src="<%= sharedHero.bannerImage %>" alt="แบนเนอร์ร้าน <%= settings.shopName %>" width="1200" height="400" fetchpriority="high" decoding="async" /></a>
    <% } else { %>
      <img src="<%= sharedHero.bannerImage %>" alt="แบนเนอร์ร้าน <%= settings.shopName %>" width="1200" height="400" fetchpriority="high" decoding="async" />
    <% } %>
  </div>
</section>

<% } %>
