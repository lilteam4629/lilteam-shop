<% const sharedHero = typeof storefrontHero !== 'undefined' ? storefrontHero : { bannerImage: settings.hero?.mode === 'none' ? null : settings.hero?.bannerImage, bannerLink: settings.hero?.bannerLink || '' }; %>
<% if (typeof isMainSite !== 'undefined' && isMainSite) { %>
<section class="main-welcome-stage" id="home-top" aria-label="ยินดีต้อนรับสู่ร้าน">
  <% if (sharedHero.bannerImage) { %><img class="main-welcome-background" src="<%= sharedHero.bannerImage %>" alt="" aria-hidden="true" decoding="async"/><% } %>
  <div class="main-welcome-veil" aria-hidden="true"></div>
  <svg class="main-welcome-ribbons" viewBox="0 0 1300 300" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true"><path d="M-80 270C150 280 110 25 350 65S650 330 900 195s210-170 480-80"/><path d="M-90 295C180 310 130 55 365 88S680 350 915 218s235-190 480-80"/><path d="M-100 245C120 250 95 0 335 42S630 310 885 172s195-150 475-80"/><path class="main-welcome-tracer" d="M-80 270C150 280 110 25 350 65S650 330 900 195s210-170 480-80"/></svg>
  <div class="main-welcome-light" aria-hidden="true"></div>
  <div class="main-welcome-content">
    <h1>ยินดีต้อนรับสู่ <span><%= settings.shopName %></span></h1>
    <% if (settings.tagline) { %><p><%= settings.tagline %></p><% } %>
    <div class="main-welcome-actions">
      <a class="main-welcome-primary" href="/products">เลือกดูสินค้า<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
      <a class="main-welcome-contact" href="/contact" aria-label="ติดต่อร้าน"><svg width="19" height="19" aria-hidden="true"><use href="#ui-megaphone"/></svg></a>
    </div>
  </div>
</section>
<% } else if (sharedHero.bannerImage) { %>
<section class="owner-home-v20-hero owner-home-v23-hero owner-home-v20-hero--banner owner-home-v20-hero--banner-only" id="home-top" aria-label="แบนเนอร์ร้าน <%= settings.shopName %>">
  <div class="owner-home-v20-artwork">
    <% if (sharedHero.bannerLink) { %>
      <a href="<%= sharedHero.bannerLink %>" aria-label="เปิดแบนเนอร์ร้าน <%= settings.shopName %>"><img src="<%= sharedHero.bannerImage %>" alt="แบนเนอร์ร้าน <%= settings.shopName %>" width="1200" height="400" fetchpriority="high" decoding="async" /></a>
    <% } else { %>
      <img src="<%= sharedHero.bannerImage %>" alt="แบนเนอร์ร้าน <%= settings.shopName %>" width="1200" height="400" fetchpriority="high" decoding="async" />
    <% } %>
  </div>
</section>

<% } %>
