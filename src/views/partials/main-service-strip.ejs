<div class="main-service-strip" data-main-service-strip>
  <div class="main-service-hours">
    <span class="main-service-clock" aria-hidden="true"><svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-linecap="round"><circle class="main-service-clock__dial" cx="30" cy="30" r="24" stroke-width="2" stroke-dasharray="1 11.56"/><circle cx="30" cy="30" r="18" stroke-width="1" opacity=".2"/><path class="main-service-clock__hand" data-service-hour d="M30 30V19" stroke-width="3"/><path class="main-service-clock__hand" data-service-minute d="M30 30V13" stroke-width="2"/><path class="main-service-clock__hand main-service-clock__second" data-service-second d="M30 34V11" stroke-width="1.2"/><circle cx="30" cy="30" r="2.5" fill="currentColor" stroke="none"/></svg></span>
    <div><span class="main-service-label">เวลาบริการ</span><strong data-storefront-preview-setting="openHours"><%= settings.openHours %></strong></div>
  </div>
  <div class="main-service-message"><strong class="main-service-shopname"><%= settings.shopName %></strong><span data-storefront-preview-setting="tagline"><%= settings.tagline %></span></div>
  <div class="main-service-now"><span class="main-service-label">เวลาประเทศไทย</span><time data-main-service-time><%= new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Bangkok', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).format(new Date()) %></time></div>
  <div class="main-service-actions"><span class="main-service-status"><span aria-hidden="true"></span>เปิดให้บริการ</span><a class="main-service-contact" href="/contact">ติดต่อร้าน<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a></div>
</div>
