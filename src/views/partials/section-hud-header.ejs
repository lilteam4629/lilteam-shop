<%
  const hudHref = typeof href !== 'undefined' ? href : null;
  const hudSubtitle = typeof subtitle !== 'undefined' ? subtitle : '';
  const hudIcon = typeof icon !== 'undefined' ? icon : '✨';
%>
<div class="section-hud-header relative overflow-hidden rounded-xl px-4 py-3 flex items-center justify-between gap-3 mb-4">
  <div class="relative z-[1] flex items-center gap-3 min-w-0">
    <span class="section-hud-icon shrink-0"><%= hudIcon %></span>
    <div class="min-w-0">
      <h2 class="font-bold text-base sm:text-lg text-white truncate"><%= title %></h2>
      <% if (hudSubtitle) { %>
        <p class="text-[11px] text-white/45 truncate"><%= hudSubtitle %></p>
      <% } %>
    </div>
  </div>
  <% if (hudHref) { %>
    <a href="<%= hudHref %>" class="section-hud-more relative z-[1] shrink-0">ดูเพิ่มเติม <span aria-hidden="true">›</span></a>
  <% } %>
</div>

<style>
.section-hud-header{background:linear-gradient(90deg,color-mix(in srgb,var(--gold) 20%,#170b24) 0%,color-mix(in srgb,var(--gold) 7%,#1d1029) 55%,transparent 100%);border:1px solid color-mix(in srgb,var(--gold) 24%,transparent)}
.section-hud-header:before{content:'';position:absolute;inset:0;background-image:repeating-linear-gradient(90deg,color-mix(in srgb,var(--gold) 18%,transparent) 0 18px,transparent 18px 36px);mask-image:linear-gradient(90deg,transparent,#000 30%,#000 60%,transparent);opacity:.5}
.section-hud-icon{width:2.25rem;height:2.25rem;display:grid;place-items:center;border-radius:.65rem;background:rgba(0,0,0,.35);color:var(--gold);font-size:1rem;border:1px solid color-mix(in srgb,var(--gold) 30%,transparent)}
.section-hud-more{display:inline-flex;align-items:center;gap:.3rem;background:#fff;color:#171207;font-size:.72rem;font-weight:700;padding:.5rem 1rem;border-radius:999px;white-space:nowrap;transition:transform .2s}
.section-hud-more:hover{transform:translateX(2px)}
</style>
