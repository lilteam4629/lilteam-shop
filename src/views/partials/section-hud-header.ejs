<%
  const hudHref = typeof href !== 'undefined' ? href : null;
  const hudSubtitle = typeof subtitle !== 'undefined' ? subtitle : '';
  const hudIcon = typeof icon !== 'undefined' ? icon : '✨';
%>
<div class="section-hud-header flex items-center justify-between gap-3 mb-4">
  <div class="flex items-center gap-3 min-w-0">
    <span class="section-hud-icon shrink-0"><%= hudIcon %></span>
    <div class="min-w-0">
      <h2 class="font-bold text-base sm:text-lg text-[var(--text)] truncate"><%= title %></h2>
      <% if (hudSubtitle) { %>
        <p class="text-[11px] text-[var(--text-4)] truncate"><%= hudSubtitle %></p>
      <% } %>
    </div>
  </div>
  <% if (hudHref) { %>
    <a href="<%= hudHref %>" class="section-hud-more shrink-0">ดูเพิ่มเติม <span aria-hidden="true">›</span></a>
  <% } %>
</div>

<style>
.section-hud-icon{width:2.25rem;height:2.25rem;display:grid;place-items:center;border-radius:.65rem;background:color-mix(in srgb,var(--gold) 14%,transparent);color:var(--gold-text);font-size:1rem;border:1px solid color-mix(in srgb,var(--gold) 30%,transparent)}
.section-hud-more{display:inline-flex;align-items:center;gap:.3rem;background:var(--gold);color:var(--gold-contrast);font-size:.72rem;font-weight:700;padding:.5rem 1rem;border-radius:999px;white-space:nowrap;transition:transform .2s}
.section-hud-more:hover{transform:translateX(2px);background:var(--gold-hover)}
</style>
