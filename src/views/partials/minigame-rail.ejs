<%
  const railCost = typeof cost === 'number' && Number.isFinite(cost) ? cost : null;
  const railBalance = typeof balance === 'number' && Number.isFinite(balance) ? balance : null;
  const railPrizes = (prizes || []).map(p => ({ name: p.name, image: p.image || null, isPrize: Boolean(p.isPrize) }));
  const railCatalogEndpoint = typeof catalogEndpoint === 'undefined' ? '' : catalogEndpoint;
  const railMainSiteExperience = typeof mainSiteExperience !== 'undefined' && mainSiteExperience === true;
%>
<div class="rail-game<%= railMainSiteExperience ? ' rail-game--main-site' : '' %>" data-prizes="<%= JSON.stringify(railPrizes) %>"<% if (railCatalogEndpoint) { %> data-catalog-endpoint="<%= railCatalogEndpoint %>"<% } %>>
  <div class="rail-window">
    <div class="rail-pointer rail-pointer-top" aria-hidden="true">▼</div>
    <div class="rail-pointer rail-pointer-bottom" aria-hidden="true">▲</div>
    <div class="rail-track" aria-hidden="true"></div>
    <div class="rail-center" aria-hidden="true"></div>
  </div>
  <div class="rail-result text-sm text-center" role="status" aria-live="polite" aria-atomic="true"></div>
  <% if (showLogin) { %>
    <a href="/login" class="rail-button block text-center">เข้าสู่ระบบเพื่อเล่น</a>
  <% } else { %>
    <button type="button" class="rail-button rail-play w-full" data-endpoint="<%= endpoint %>"<% if (railCatalogEndpoint) { %> data-catalog-endpoint="<%= railCatalogEndpoint %>" disabled aria-describedby="mgx-live-catalog-status"<% } %>><% if (railMainSiteExperience) { %><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h.01M12 8h.01M16 8h.01M8 12h.01M12 12h.01M16 12h.01M9 17h6"/></svg> เริ่มเลื่อน<% } else { %>🎰 เริ่มเลื่อน<% } %><% if (railCost !== null) { %> (฿<%= railCost.toLocaleString() %>)<% } %></button>
    <% if (railBalance !== null) { %><p class="text-xs text-[var(--text-4)] text-center mt-2">เครดิตคงเหลือ: ฿<span class="rail-balance"><%= railBalance.toLocaleString() %></span></p><% } %>
  <% } %>
</div>

<style>
  .rail-game{position:relative;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border-light));border-radius:1.1rem;padding:1.25rem;background:linear-gradient(160deg,var(--input),var(--card));overflow:hidden}
  .rail-game:before{content:"";position:absolute;inset:0;background:radial-gradient(80% 100% at 50% 0%,color-mix(in srgb,var(--gold) 8%,transparent),transparent 60%);pointer-events:none}

  .rail-window{position:relative;overflow:hidden;height:172px;border-radius:1rem;border:1px solid color-mix(in srgb,var(--gold) 45%,var(--border));background:
    repeating-linear-gradient(90deg,color-mix(in srgb,var(--text) 3%,transparent) 0 1px,transparent 1px 144px),
    color-mix(in srgb,var(--bg) 88%,transparent);
    box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--border-light) 70%,transparent)}
  .rail-window:before,.rail-window:after{content:"";position:absolute;z-index:4;top:0;bottom:0;width:16%;pointer-events:none}
  .rail-window:before{left:0;background:linear-gradient(90deg,var(--bg),transparent)}
  .rail-window:after{right:0;background:linear-gradient(-90deg,var(--bg),transparent)}

  .rail-pointer{position:absolute;z-index:6;left:50%;transform:translateX(-50%);color:var(--gold-text);font-size:1.15rem;line-height:1;filter:drop-shadow(0 2px 6px rgba(0,0,0,.85));animation:rail-blink 1.6s ease-in-out infinite}
  .rail-pointer-top{top:2px}
  .rail-pointer-bottom{bottom:2px}
  @keyframes rail-blink{0%,100%{opacity:1}50%{opacity:.55}}

  .rail-center{position:absolute;z-index:3;left:50%;top:12px;bottom:12px;width:150px;transform:translateX(-50%);border-radius:.9rem;border:2px solid var(--gold);box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 16%,transparent),0 0 26px color-mix(in srgb,var(--gold) 45%,transparent);pointer-events:none;animation:rail-pulse 1.8s ease-in-out infinite}
  @keyframes rail-pulse{0%,100%{box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 16%,transparent),0 0 20px color-mix(in srgb,var(--gold) 38%,transparent)}50%{box-shadow:0 0 0 5px color-mix(in srgb,var(--gold) 24%,transparent),0 0 32px color-mix(in srgb,var(--gold) 60%,transparent)}}

  .rail-track{height:100%;display:flex;align-items:center;gap:14px;padding:16px 0;transform:translate3d(0,0,0);will-change:transform;backface-visibility:hidden}
  .rail-item{width:130px;height:136px;flex:0 0 130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.4rem;padding:.6rem;border-radius:.9rem;border:1px solid var(--border-light);background:linear-gradient(160deg,color-mix(in srgb,var(--card) 92%,white 6%),var(--card));text-align:center;box-shadow:0 6px 14px -8px rgba(0,0,0,.45);contain:layout paint}
  .rail-item img{width:82px;height:82px;object-fit:contain;border-radius:.55rem;filter:drop-shadow(0 4px 10px rgba(0,0,0,.3))}
  .rail-game--main-site .rail-item img{background:color-mix(in srgb,var(--card) 82%,white);filter:drop-shadow(0 4px 10px rgba(0,0,0,.22))}
  .rail-item-icon{font-size:2.7rem;line-height:1}
  .rail-game--main-site .rail-item-icon{display:grid;place-items:center;width:64px;height:64px;color:var(--gold-text)}
  .rail-game--main-site .rail-item-icon svg{width:48px;height:48px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .rail-item-name{width:100%;font-size:.72rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text-2)}

  .rail-button{margin-top:1.1rem;padding:.8rem 1rem;border-radius:.8rem;background:linear-gradient(135deg,var(--gold),var(--gold-hover));color:var(--gold-contrast);font-weight:800;font-size:.95rem;box-shadow:0 10px 24px -10px color-mix(in srgb,var(--gold) 75%,transparent);transition:transform .15s,box-shadow .15s,opacity .15s}
  .rail-game--main-site .rail-button{display:flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px}
  .rail-game--main-site .rail-button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .rail-button:hover{transform:translateY(-1px);box-shadow:0 14px 30px -12px color-mix(in srgb,var(--gold) 85%,transparent)}
  .rail-button:disabled{opacity:.55;cursor:not-allowed;transform:none}
  .rail-game.is-spinning .rail-pointer,.rail-game.is-spinning .rail-center{animation:none}
  .rail-game.is-spinning .rail-item img{filter:none}
  .rail-result{margin-top:.85rem;min-height:1.5rem}
  .rail-game--main-site.is-spinning .rail-track{filter:saturate(1.08)}
  .rail-game--main-site.is-spinning .rail-window{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--gold) 35%,transparent),0 0 22px color-mix(in srgb,var(--gold) 18%,transparent)}
  .rail-claim{margin-top:.5rem;padding:.55rem;border:1px solid color-mix(in srgb,var(--gold) 40%,transparent);border-radius:.65rem;background:color-mix(in srgb,var(--gold) 12%,transparent);color:var(--gold-text);font-size:1.25rem;font-weight:800;letter-spacing:.1em}
  .rail-contact-btn{display:flex;align-items:center;justify-content:center;gap:.45rem;width:100%;margin-top:.65rem;padding:.65rem .85rem;border-radius:.7rem;color:var(--text);background:var(--input);border:1px solid var(--border-light);font-size:.8rem;font-weight:700;transition:border-color .2s,color .2s,transform .15s}
  .rail-contact-btn:hover{color:var(--gold-text);border-color:var(--gold);transform:translateY(-1px)}

  @media (max-width: 639px){
    .rail-window{height:140px}
    .rail-center{width:110px}
    .rail-item{width:98px;height:110px;flex-basis:98px}
    .rail-item img{width:60px;height:60px}
    .rail-game--main-site .rail-item-icon{width:52px;height:52px}
    .rail-game--main-site .rail-item-icon svg{width:40px;height:40px}
    .rail-item-icon{font-size:2.1rem}
  }
  @media (prefers-reduced-motion: reduce){.rail-game--main-site .rail-pointer,.rail-game--main-site .rail-center{animation:none!important}.rail-game--main-site .rail-button{transition:none}}
</style>

<script>
  document.querySelectorAll('.rail-game').forEach(function(game){
    if(game.dataset.bound==='1') return;
    game.dataset.bound='1';
    const mainSiteExperience=game.classList.contains('rail-game--main-site');
    const catalogEndpoint=game.dataset.catalogEndpoint||'';
    let prizes=JSON.parse(game.dataset.prizes||'[]');
    if(catalogEndpoint)prizes=[];
    const track=game.querySelector('.rail-track');
    const button=game.querySelector('.rail-play');
    const result=game.querySelector('.rail-result');
    const balance=game.querySelector('.rail-balance');
    function iconForItem(){
      const ns='http://www.w3.org/2000/svg';
      const svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 48 48');svg.setAttribute('aria-hidden','true');
      const path=document.createElementNS(ns,'path');path.setAttribute('d','M7 20h34v22H7zM4 13h40v9H4zM24 13v29M24 13c-2-7-11-11-14-6-3 5 5 9 14 6Zm0 0c2-7 11-11 14-6 3 5-5 9-14 6Z');svg.appendChild(path);return svg;
    }
    function item(p){
      const el=document.createElement('div');el.className='rail-item';
      if(p.image){
        if(!mainSiteExperience){const img=document.createElement('img');img.src=p.image;img.alt=p.name;el.appendChild(img)}
        else {
        const img=document.createElement('img');img.src=p.image;img.alt='';img.loading='eager';img.decoding='async';img.addEventListener('error',function(){const fallback=document.createElement('div');fallback.className='rail-item-icon';fallback.appendChild(iconForItem());img.replaceWith(fallback)},{once:true});el.appendChild(img);
        }
      } else if(mainSiteExperience){const icon=document.createElement('div');icon.className='rail-item-icon';icon.appendChild(iconForItem());el.appendChild(icon)}
      else {const icon=document.createElement('div');icon.className='rail-item-icon';icon.textContent=p.isPrize?'🎁':'💨';el.appendChild(icon)}
      const name=document.createElement('div');name.className='rail-item-name';name.textContent=p.name;el.appendChild(name);return el;
    }
    let spinning=false,activeController=null,requestTimer=0,spinTimer=0;
    function centerIndexAt(index){
      const el=track.children[index];
      if(!el)return;
      const itemWidth=el.getBoundingClientRect().width;
      const gap=parseFloat(getComputedStyle(track).gap)||14;
      const step=itemWidth+gap;
      const windowCenter=game.querySelector('.rail-window').clientWidth/2;
      return windowCenter-(index*step+itemWidth/2);
    }
    function seed(){
      track.innerHTML='';
      const count=16;
      for(let i=0;i<count;i++)track.appendChild(item(prizes.length ? (mainSiteExperience ? prizes[Math.floor(Math.random()*prizes.length)] : prizes[i%prizes.length]) : {name:catalogEndpoint?'กำลังโหลดสินค้าจริง…':'ยังไม่มีรางวัล'}));
      track.style.transition='none';
      track.style.transform='translate3d('+(centerIndexAt(Math.floor(count/2))||0)+'px,0,0)';
      if(mainSiteExperience)void track.offsetWidth;
    }
    function releaseSpin(message,resetTrack){
      clearTimeout(requestTimer);clearTimeout(spinTimer);requestTimer=0;spinTimer=0;
      if(activeController)activeController.abort();activeController=null;
      spinning=false;game.classList.remove('is-spinning');
      if(button){button.disabled=false;button.removeAttribute('aria-busy')}
      if(resetTrack)seed();
      if(message)result.textContent=message;
    }
    seed();
    if(catalogEndpoint&&button){
      const catalogPreview=window.lilteamLiveCatalogPreview;
      if(catalogPreview){
        catalogPreview.load(catalogEndpoint).then(function(catalog){
          if(!game.isConnected||!Array.isArray(catalog.products))return;
          prizes=catalog.products.map(function(product){return {name:product.title,image:product.image||null,isPrize:true,productId:product.id,price:product.price,availableStock:product.availableStock}});
          seed();button.disabled=!prizes.length;
          if(result)result.textContent=prizes.length?'พร้อมทดลองจากสินค้าจริง '+prizes.length+' รายการ · ไม่ตัดสต็อก':'เว็บจริงไม่มีสินค้าพร้อมทดลอง';
        }).catch(function(error){if(result)result.textContent=error.message||'อ่านสินค้าจริงไม่สำเร็จ';});
      }else if(result){result.textContent='ตัวเชื่อมแค็ตตาล็อกจริงยังไม่พร้อม';}
    }
    function handleRailResize(){if(!spinning&&game.isConnected)seed()}
    window.addEventListener('resize',handleRailResize);
    window.addEventListener('pageshow',function(event){if(event.persisted||(button&&button.disabled))releaseSpin('พร้อมเริ่มเลื่อนอีกครั้ง',true)});
    document.addEventListener('lilteam:page-unloading',function(){window.removeEventListener('resize',handleRailResize);releaseSpin()},{once:true});
    if(!button)return;
    button.addEventListener('click',async function(){
      if(spinning||button.disabled)return;
      spinning=true;game.classList.add('is-spinning');button.disabled=true;button.setAttribute('aria-busy','true');result.textContent='กำลังสุ่ม...';seed();
      let response,data;if(catalogEndpoint){try{const catalog=await window.lilteamLiveCatalogPreview.load(catalogEndpoint);if(!Array.isArray(catalog.products)||!catalog.products.length)throw new Error('เว็บจริงไม่มีสินค้าพร้อมทดลอง');const product=window.lilteamLiveCatalogPreview.pick(catalog.products);if(!product)throw new Error('ไม่มีสินค้าจริงพร้อมทดลอง');response={ok:true};data={prizeName:product.title,image:product.image,productId:product.id,price:product.price,availableStock:product.availableStock,isWin:true,isPreview:true,fromLiveCatalog:true}}catch(e){response={ok:false};data={error:e.message||'อ่านสินค้าจริงไม่สำเร็จ'}}}else{activeController=new AbortController();requestTimer=setTimeout(function(){activeController&&activeController.abort()},10000);try{response=await fetch(button.dataset.endpoint,{method:'POST',credentials:'same-origin',signal:activeController.signal});data=await response.json()}catch(e){data=null}finally{clearTimeout(requestTimer);requestTimer=0;activeController=null}}
      if(!response||!response.ok||!data){releaseSpin((data&&data.error)||'ระบบตอบช้า กรุณากดลองใหม่',false);return}
      const winner={name:data.prizeName,image:data.image||null,isPrize:data.isWin};
      const winnerIndex=20;const total=24;
      const sequence=[];for(let i=0;i<total;i++)sequence.push(i===winnerIndex?winner:(prizes[Math.floor(Math.random()*prizes.length)]||winner));
      track.innerHTML='';sequence.forEach(p=>track.appendChild(item(p)));
      const reduceMotion=mainSiteExperience&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const duration=mainSiteExperience?(reduceMotion?120:3600):3600;
      const start=centerIndexAt(8);
      const target=centerIndexAt(winnerIndex);
      track.style.transition='none';track.style.transform='translate3d('+start+'px,0,0)';void track.offsetWidth;
      requestAnimationFrame(function(){
        if(!game.isConnected||!spinning)return;
        track.style.transition='transform '+duration+'ms cubic-bezier(.12,.72,.08,1)';
        void track.getBoundingClientRect();
        requestAnimationFrame(function(){if(game.isConnected&&spinning)track.style.transform='translate3d('+target+'px,0,0)'})
      });
      let completed=false;
      function completeSpin(){
        if(completed)return;completed=true;clearTimeout(spinTimer);spinTimer=0;
        spinning=false;game.classList.remove('is-spinning');
        result.innerHTML='';const line=document.createElement('div');line.className=data.isWin?'text-emerald-400 font-medium':'text-[var(--text-3)]';line.textContent=data.fromLiveCatalog?'ตัวอย่างสินค้าจริง: '+data.prizeName+' · มีในสต็อก '+Number(data.availableStock||0).toLocaleString()+' (ไม่ตัดสต็อก)':data.isPreview?'ตัวอย่างผลสุ่ม: '+data.prizeName:(data.isWin?'ยินดีด้วย! ได้รับ '+data.prizeName:'ผลลัพธ์: '+data.prizeName);result.appendChild(line);
        if(data.isWin&&data.claimCode){const claim=document.createElement('div');claim.className='rail-claim';claim.textContent=data.claimCode;result.appendChild(claim)}
        if(data.isWin&&!data.isPreview){const contactBtn=document.createElement('a');contactBtn.href='/contact';contactBtn.className='rail-contact-btn';contactBtn.textContent='💬 ติดต่อร้านเพื่อรับรางวัล';result.appendChild(contactBtn)}
        if(balance&&typeof data.walletBalance==='number')balance.textContent=data.walletBalance.toLocaleString();button.disabled=false;button.removeAttribute('aria-busy');
      }
      const onTransitionEnd=event=>{if(event.target===track&&event.propertyName==='transform')completeSpin()};
      track.addEventListener('transitionend',onTransitionEnd,{once:true});
      spinTimer=setTimeout(completeSpin,mainSiteExperience?duration+450:3800);
    });
  });
</script>
