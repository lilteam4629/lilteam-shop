<%
  // locals: endpoint (string, required), cost (number|null — null hides the
  // cost/balance display for a free preview), ctaLabel (string), showLogin
  // (bool — show a login link instead of a play button), balance (number|null)
  const mgCost = typeof cost === 'undefined' ? null : cost;
  const mgBalance = typeof balance === 'undefined' ? null : balance;
  const mgShowLogin = typeof showLogin !== 'undefined' && showLogin;
  const mgMainSiteExperience = typeof mainSiteExperience !== 'undefined' && mainSiteExperience === true;
  const mgAdminPreview = typeof adminPreview !== 'undefined' && adminPreview === true;
  const mgBoxIllustration = mgMainSiteExperience;
  const mgPreviewPrizes = mgAdminPreview && Array.isArray(previewPrizes) ? previewPrizes : [];
%>
<div class="mg-play-panel relative rounded-2xl p-6 flex flex-col items-center text-center gap-4<%= mgMainSiteExperience ? ' mg-play-panel--main-site' : '' %><%= mgAdminPreview ? ' mg-play-panel--admin-preview' : '' %>">
  <div class="mg-stage">
    <% if (mgBoxIllustration) { %>
    <div class="mg-box-scene mg-box-scene-el" aria-hidden="true">
      <span class="mg-box-aura"></span>
      <div class="mg-box mg-box-el">
        <span class="mg-box-lid"><i class="mg-box-bow"></i></span>
        <span class="mg-box-body"><i class="mg-box-band-v"></i><i class="mg-box-band-h"></i></span>
      </div>
    </div>
    <% } else { %>
      <div class="mg-box mg-box-el">🎁</div>
    <% } %>
    <div class="mg-card mg-card-el" aria-hidden="true">
      <% if (mgBoxIllustration) { %>
      <div class="mg-card-icon mg-card-icon-el" aria-hidden="true">
        <svg class="mg-result-gift" viewBox="0 0 48 48"><path d="M7 20h34v22H7zM4 13h40v9H4zM24 13v29M24 13c-2-7-11-11-14-6-3 5 5 9 14 6Zm0 0c2-7 11-11 14-6 3 5-5 9-14 6Z"/></svg>
        <svg class="mg-result-miss" viewBox="0 0 48 48"><path d="M24 5v8m0 22v8M5 24h8m22 0h8M10.5 10.5l5.7 5.7m15.6 15.6 5.7 5.7m0-27-5.7 5.7m-15.6 15.6-5.7 5.7"/><circle cx="24" cy="24" r="9"/></svg>
      </div>
      <% } else { %>
        <div class="mg-card-icon mg-card-icon-el">🎉</div>
      <% } %>
      <img class="mg-card-image mg-card-image-el hidden" alt="" />
      <div class="mg-card-name mg-card-name-el"></div>
    </div>
    <div class="mg-confetti mg-confetti-el"></div>
  </div>
  <div class="mg-result-el text-sm min-h-[1.5rem]"></div>
  <% if (mgShowLogin) { %>
    <a href="/login" class="mg-play-btn w-full block">เข้าสู่ระบบเพื่อเล่น</a>
  <% } else { %>
    <button type="button" class="mg-play-btn mg-play-btn-el w-full" data-endpoint="<%= endpoint %>"<% if (mgAdminPreview && !mgPreviewPrizes.length) { %> disabled data-preview-unavailable="true" aria-describedby="mg-preview-empty-box"<% } %>>
      <%= ctaLabel %><% if (mgCost !== null) { %> (฿<%= mgCost.toLocaleString() %>)<% } %>
    </button>
    <% if (mgBalance !== null) { %>
      <p class="text-xs text-[var(--text-4)]">เครดิตคงเหลือ: ฿<span class="mg-balance-el"><%= mgBalance.toLocaleString() %></span></p>
    <% } %>
  <% } %>
  <% if (mgAdminPreview) { %>
    <section class="mg-preview-prizes" aria-label="รางวัลในเกมที่นำมาทดลอง">
      <div class="mg-preview-prizes-head"><strong>รางวัลที่อยู่ในกล่อง</strong><span><%= mgPreviewPrizes.length.toLocaleString('th-TH') %> รายการ · ใช้เรทจริง</span></div>
      <% if (mgPreviewPrizes.length) { %>
        <div class="mg-preview-prize-list">
          <% mgPreviewPrizes.slice(0, 8).forEach(prize => { %>
            <article class="mg-preview-prize">
              <% if (prize.resolvedImage || prize.image) { %><img src="<%= prize.resolvedImage || prize.image %>" alt="" loading="lazy" /><% } else { %><span class="mg-preview-prize-placeholder" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 8 9-5 9 5v9l-9 5-9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v9"/></svg></span><% } %>
              <span class="mg-preview-prize-copy"><strong><%= prize.name %></strong><small><%= Number(prize.percent || 0).toLocaleString('th-TH') %>% · <%= prize.isPrize ? 'มีรางวัล' : 'ไม่มีรางวัล' %></small></span>
            </article>
          <% }) %>
          <% if (mgPreviewPrizes.length > 8) { %><span class="mg-preview-prize-more">+<%= (mgPreviewPrizes.length - 8).toLocaleString('th-TH') %></span><% } %>
        </div>
      <% } else { %>
        <p class="mg-preview-empty" id="mg-preview-empty-box">เพิ่มรางวัลที่เปิดใช้งาน มีเรทมากกว่า 0% และมีสต็อกก่อนทดลองสุ่ม</p>
      <% } %>
    </section>
  <% } %>
</div>

<style>
  .mg-play-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 1rem;
    text-align: center;
    background: linear-gradient(160deg, var(--input), var(--card));
  }
  .mg-play-panel .hidden { display: none !important; }
  .mg-stage { position: relative; width: 100%; height: 220px; display: flex; align-items: center; justify-content: center; }
  .mg-play-panel--main-site .mg-stage { perspective: 900px; }
  .mg-box-scene { position: relative; display: grid; place-items: center; width: 142px; height: 126px; transform-style: preserve-3d; animation: mg-float 2.6s ease-in-out infinite; }
  .mg-box-aura { position: absolute; inset: 18px 12px 6px; border-radius: 50%; background: color-mix(in srgb, var(--gold) 22%, transparent); filter: blur(22px); opacity: .55; transform: scale(.78); transition: opacity .3s ease, transform .3s ease; }
  .mg-box { font-size: 4.5rem; line-height: 1; cursor: default; filter: drop-shadow(0 0 18px color-mix(in srgb, var(--gold) 45%, transparent)); animation: mg-float 2.6s ease-in-out infinite; }
  .mg-play-panel--main-site .mg-box { position: relative; width: 112px; height: 96px; transform-style: preserve-3d; filter: drop-shadow(0 12px 13px color-mix(in srgb, var(--gold) 32%, transparent)); animation: none; }
  .mg-box-body { position: absolute; inset: 27px 5px 2px; overflow: visible; border: 2px solid color-mix(in srgb, var(--gold) 72%, #fff); border-radius: 8px 8px 13px 13px; background: linear-gradient(145deg, color-mix(in srgb, var(--gold) 84%, #fff), var(--gold-hover)); box-shadow: inset 0 2px 4px #fff8; }
  .mg-box-band-v { position: absolute; top: 0; bottom: 0; left: calc(50% - 8px); width: 16px; background: color-mix(in srgb, var(--gold-contrast) 24%, var(--gold)); box-shadow: inset 1px 0 #fff5, inset -1px 0 #0002; }
  .mg-box-band-h { position: absolute; top: 19px; left: 0; right: 0; height: 13px; background: color-mix(in srgb, var(--gold-contrast) 20%, var(--gold)); box-shadow: inset 0 1px #fff5, inset 0 -1px #0002; }
  .mg-box-lid { position: absolute; z-index: 2; top: 17px; left: 0; right: 0; height: 20px; border: 2px solid color-mix(in srgb, var(--gold) 78%, #fff); border-radius: 8px; background: linear-gradient(180deg, color-mix(in srgb, var(--gold) 75%, #fff), var(--gold)); transform-origin: 50% 90%; backface-visibility: visible; box-shadow: 0 3px 6px #0002; }
  .mg-box-bow { position: absolute; z-index: 3; top: -6px; left: 50%; width: 8px; height: 14px; border-radius: 50%; background: var(--gold-contrast); transform: translateX(-50%); box-shadow: -10px 0 0 -1px color-mix(in srgb, var(--gold-contrast) 75%, transparent), 10px 0 0 -1px color-mix(in srgb, var(--gold-contrast) 75%, transparent); }
  .mg-box-scene.is-shaking .mg-box-aura { opacity: .9; animation: mg-aura-pulse .85s ease-in-out infinite; }
  .mg-box-scene.is-opening .mg-box-aura { opacity: 1; transform: scale(1.28); animation: none; }
  .mg-box-scene.is-opening { animation: mg-scene-burst .9s cubic-bezier(.2,.75,.25,1) both; }
  @keyframes mg-aura-pulse { 0%,100% { transform: scale(.78); opacity: .55; } 50% { transform: scale(1.15); opacity: .96; } }
  @keyframes mg-scene-burst { 0% { transform: scale(1); } 45% { transform: scale(1.14); } 100% { transform: scale(.92); } }
  @keyframes mg-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-6px) scale(1.03); }
  }
  .mg-box.mg-shaking { animation: mg-shake .6s ease-in-out 2; }
  .mg-play-panel--main-site .mg-box.mg-shaking { animation: mg-shake .62s ease-in-out infinite; }
  @keyframes mg-shake {
    0%, 100% { transform: translate(0, 0) rotate(0); }
    20% { transform: translate(-6px, 0) rotate(-8deg); }
    40% { transform: translate(6px, 0) rotate(8deg); }
    60% { transform: translate(-5px, -3px) rotate(-6deg); }
    80% { transform: translate(5px, -3px) rotate(6deg); }
  }
  .mg-play-panel--main-site .mg-box.mg-opening { animation: mg-box-pop .9s cubic-bezier(.16,1,.3,1) both; }
  .mg-play-panel--main-site .mg-box.mg-opening .mg-box-lid { animation: mg-lid-open .9s cubic-bezier(.16,1,.3,1) both; }
  @keyframes mg-box-pop { 0% { transform: translateY(0) scale(1); } 35% { transform: translateY(6px) scale(.96); } 100% { transform: translateY(15px) scale(.8); } }
  @keyframes mg-lid-open { 0% { transform: translateY(0) rotateX(0) rotateZ(0); } 65% { transform: translateY(-18px) rotateX(-115deg) rotateZ(-7deg); } 100% { transform: translateY(-14px) rotateX(-105deg) rotateZ(-5deg); } }
  .mg-box.mg-hidden { opacity: 0; transform: scale(.4); transition: opacity .25s, transform .25s; }
  .mg-play-panel--main-site .mg-box.mg-hidden { opacity: 0; transform: translateY(22px) scale(.48); transition: opacity .24s ease, transform .24s ease; }

  .mg-card {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem;
    visibility: hidden; opacity: 0; transform: scale(.6) rotateY(90deg);
    pointer-events: none;
  }
  .mg-card.mg-revealed {
    visibility: visible; opacity: 1; transform: scale(1) rotateY(0deg);
    transition: opacity .32s ease, transform .42s cubic-bezier(.16,1,.3,1);
  }
  .mg-card-icon { font-size: 3.4rem; line-height: 1; filter: drop-shadow(0 0 14px color-mix(in srgb, var(--gold) 50%, transparent)); }
  .mg-play-panel--main-site .mg-card-icon { display: grid; place-items: center; width: 64px; height: 64px; color: var(--gold-text); }
  .mg-card-icon svg { display: block; width: 56px; height: 56px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .mg-card-icon .mg-result-miss { display: none; opacity: .7; }
  .mg-card-icon.is-miss .mg-result-gift { display: none; }
  .mg-card-icon.is-miss .mg-result-miss { display: block; }
  .mg-card-image {
    width: auto; height: auto;
    max-width: min(100%, 14rem); max-height: 11.5rem;
    object-fit: contain;
    border: 0; border-radius: 0;
    filter: drop-shadow(0 8px 18px color-mix(in srgb, var(--gold) 32%, transparent));
  }
  .mg-card-name { font-weight: 700; font-size: .95rem; max-width: 220px; }

  .mg-confetti { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .mg-confetti-piece {
    position: absolute; top: 50%; left: 50%;
    width: 6px; height: 10px;
    animation: mg-confetti-burst .9s ease-out forwards;
  }
  @keyframes mg-confetti-burst {
    0% { transform: translate(-50%, -50%) rotate(0deg); opacity: 1; }
    100% { transform: translate(var(--mgx), var(--mgy)) rotate(var(--mgr)); opacity: 0; }
  }

  .mg-play-btn {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, var(--gold), var(--gold-hover));
    color: var(--gold-contrast); font-weight: 700; border-radius: .75rem;
    padding: .7rem 1rem; font-size: .9rem;
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--gold) 70%, transparent);
    transition: transform .15s, box-shadow .15s, opacity .15s;
  }
  .mg-play-btn:hover { transform: translateY(-1px); box-shadow: 0 12px 26px -10px color-mix(in srgb, var(--gold) 85%, transparent); }
  .mg-play-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }

  .mg-claim-box {
    margin-top: .4rem;
    padding: .5rem .75rem;
    border-radius: .6rem;
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
  }
  .mg-claim-code {
    font-family: 'Kanit', monospace;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: .12em;
    color:var(--gold-text);
  }
  .mg-contact-btn {
    display: flex; align-items: center; justify-content: center; gap: .45rem;
    width: 100%; margin-top: .65rem; padding: .65rem .85rem;
    border-radius: .7rem;
    color: var(--text); background: var(--input);
    border: 1px solid var(--border-light);
    font-size: .8rem; font-weight: 700;
    transition: border-color .2s, color .2s, transform .15s;
  }
  .mg-contact-btn:hover { color:var(--gold-text); border-color:var(--gold); transform: translateY(-1px); }

  /* The play surface uses the same core layout in the storefront and preview. */
  .mg-result-el { width:100%; min-height:1.5rem; }
  .mg-preview-prizes { width:min(100%,760px); text-align:left; }
  .mg-preview-prizes-head { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:8px; color:var(--text-2); font-size:.75rem; }
  .mg-preview-prizes-head span { color:var(--text-4); font-size:.68rem; }
  .mg-preview-prize-list { display:flex; gap:8px; overflow-x:auto; padding:2px 1px 7px; scrollbar-width:thin; scrollbar-color:var(--gold) var(--input); }
  .mg-preview-prize { display:flex; align-items:center; gap:8px; min-width:168px; max-width:220px; padding:7px; border:1px solid var(--border-light); border-radius:11px; background:var(--card); }
  .mg-preview-prize img,.mg-preview-prize-placeholder { display:grid; place-items:center; width:38px; height:38px; flex:0 0 38px; overflow:hidden; border-radius:8px; background:var(--input); object-fit:contain; }
  .mg-preview-prize-placeholder { color:var(--gold-text); }
  .mg-preview-prize-placeholder svg { width:21px; height:21px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .mg-preview-prize-copy { display:grid; gap:2px; min-width:0; }
  .mg-preview-prize-copy strong { overflow:hidden; color:var(--text); font-size:.7rem; text-overflow:ellipsis; white-space:nowrap; }
  .mg-preview-prize-copy small { color:var(--text-4); font-size:.62rem; }
  .mg-preview-prize-more { align-self:center; flex:0 0 auto; color:var(--text-3); font-size:.75rem; }
  .mg-preview-empty { margin:0; color:var(--text-3); font-size:.76rem; line-height:1.5; }

  @media (max-width: 639px) {
    .mg-stage { height: 205px; }
    .mg-card-image { max-width: min(100%, 12rem); max-height: 10.5rem; }
    .mg-preview-prizes-head { align-items:flex-start; flex-direction:column; gap:2px; }
    .mg-preview-prize { min-width:148px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-play-panel--main-site .mg-box-scene, .mg-play-panel--main-site .mg-box, .mg-play-panel--main-site .mg-box.mg-shaking, .mg-play-panel--main-site .mg-box.mg-opening, .mg-play-panel--main-site .mg-box.mg-opening .mg-box-lid, .mg-play-panel--main-site .mg-box-scene.is-opening, .mg-play-panel--main-site .mg-box-scene.is-shaking .mg-box-aura { animation:none!important; transition-duration:.01ms!important; }
    .mg-play-panel:not(.mg-play-panel--main-site) .mg-box, .mg-play-panel:not(.mg-play-panel--main-site) .mg-box.mg-shaking, .mg-play-panel:not(.mg-play-panel--main-site) .mg-box-scene.is-shaking .mg-box-aura { animation: none; }
  }
</style>

<script>
  document.querySelectorAll('.mg-play-btn-el').forEach(function (btn) {
    const panel = btn.closest('.mg-play-panel');
    if (!panel || panel.dataset.mgBound === '1') return;
    panel.dataset.mgBound = '1';

    const box = panel.querySelector('.mg-box-el');
    const boxScene = panel.querySelector('.mg-box-scene-el');
    const adminPreview = panel.classList.contains('mg-play-panel--admin-preview');
    const mainSiteExperience = panel.classList.contains('mg-play-panel--main-site');
    const visualExperience = mainSiteExperience;
    const card = panel.querySelector('.mg-card-el');
    const cardIcon = panel.querySelector('.mg-card-icon-el');
    const cardImage = panel.querySelector('.mg-card-image-el');
    const cardName = panel.querySelector('.mg-card-name-el');
    const confettiWrap = panel.querySelector('.mg-confetti-el');
    const resultEl = panel.querySelector('.mg-result-el');
    const balanceEl = panel.querySelector('.mg-balance-el');
    const confettiColors = ['#c8a63f', '#e2836f', '#93bfff', '#8fe3a3', '#f3ecd8'];
    let activeController = null;
    let requestTimer = 0;
    let revealTimer = 0;

    function burstConfetti() {
      confettiWrap.innerHTML = '';
      for (let i = 0; i < 26; i++) {
        const piece = document.createElement('span');
        piece.className = 'mg-confetti-piece';
        const angle = Math.random() * Math.PI * 2;
        const dist = 60 + Math.random() * 70;
        piece.style.setProperty('--mgx', (Math.cos(angle) * dist) + 'px');
        piece.style.setProperty('--mgy', (Math.sin(angle) * dist) + 'px');
        piece.style.setProperty('--mgr', (Math.random() * 720 - 360) + 'deg');
        piece.style.background = confettiColors[i % confettiColors.length];
        piece.style.animationDelay = (Math.random() * 0.15) + 's';
        confettiWrap.appendChild(piece);
      }
      setTimeout(() => { confettiWrap.innerHTML = ''; }, 1100);
    }

    function resetStage() {
      card.classList.remove('mg-revealed');
      card.setAttribute('aria-hidden', 'true');
      box.classList.remove('mg-hidden');
      box.classList.remove('mg-shaking', 'mg-opening');
      if (boxScene) boxScene.classList.remove('is-opening', 'is-shaking');
      if (visualExperience) cardIcon.classList.remove('is-miss');
      cardIcon.classList.remove('hidden');
      cardImage.classList.add('hidden');
      cardImage.onerror = null;
      cardImage.removeAttribute('src');
      cardImage.alt = '';
      cardName.textContent = '';
    }

    function releaseBusyState(message) {
      clearTimeout(requestTimer);
      clearTimeout(revealTimer);
      requestTimer = 0;
      revealTimer = 0;
      if (activeController) activeController.abort();
      activeController = null;
      box.classList.remove('mg-shaking', 'mg-opening');
      if (boxScene) boxScene.classList.remove('is-opening', 'is-shaking');
      btn.disabled = btn.dataset.previewUnavailable === 'true';
      btn.removeAttribute('aria-busy');
      if (message) resultEl.textContent = message;
    }

    function resetAdminPreviewState() {
      releaseBusyState();
      resetStage();
      confettiWrap.innerHTML = '';
      resultEl.textContent = btn.dataset.previewUnavailable === 'true'
        ? 'เพิ่มรางวัลที่พร้อมใช้เพื่อเริ่มทดลอง'
        : 'พร้อมเปิดกล่อง';
    }

    window.addEventListener('pageshow', function (event) {
      if (adminPreview) resetAdminPreviewState();
      else if ((event.persisted || btn.hasAttribute('aria-busy')) && btn.dataset.previewUnavailable !== 'true') releaseBusyState('พร้อมสุ่มทดสอบอีกครั้ง');
    });
    if (adminPreview) document.addEventListener('mgx:preview-tab-change', function (event) {
      if (event.detail && event.detail.from !== event.detail.to) resetAdminPreviewState();
    });
    document.addEventListener('lilteam:page-unloading', function () {
      releaseBusyState();
    }, { once: true });

    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      resultEl.textContent = '';
      resetStage();
      box.classList.add('mg-shaking');
      if (boxScene) boxScene.classList.add('is-shaking');
      resultEl.textContent = visualExperience ? 'กำลังเขย่ากล่อง...' : 'กำลังสุ่ม...';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const minShakeMs = visualExperience ? (reduceMotion ? 80 : 1400) : 900;
      const started = Date.now();

      let response, data;
      activeController = new AbortController();
      requestTimer = setTimeout(function () { activeController && activeController.abort(); }, 10000);
      try {
        response = await fetch(btn.dataset.endpoint, { method: 'POST', credentials: 'same-origin', signal: activeController.signal });
        data = await response.json();
      } catch (err) {
        data = null;
      } finally {
        clearTimeout(requestTimer);
        requestTimer = 0;
        activeController = null;
      }

      if (adminPreview && !btn.hasAttribute('aria-busy')) return;

      const elapsed = Date.now() - started;
      revealTimer = setTimeout(() => {
        revealTimer = 0;
        if (!response || !response.ok || !data) {
          releaseBusyState((data && data.error) || 'ระบบตอบช้า กรุณากดลองใหม่');
          return;
        }

        box.classList.remove('mg-shaking');
        if (boxScene) boxScene.classList.remove('is-shaking');
        if (visualExperience) resultEl.textContent = 'กำลังเปิดกล่อง...';
        const finishReveal = () => {
          revealTimer = 0;
          if (visualExperience) {
            box.classList.remove('mg-opening');
            boxScene.classList.remove('is-opening');
          }
          box.classList.add('mg-hidden');
        if (visualExperience) cardIcon.classList.toggle('is-miss', !data.isWin);
        else cardIcon.textContent = data.isWin ? '🎁' : '💨';
        if (data.image) {
          cardImage.src = data.image;
          cardImage.alt = 'รูปของรางวัล ' + data.prizeName;
          cardImage.onerror = () => {
            cardImage.classList.add('hidden');
            cardIcon.classList.remove('hidden');
          };
          cardImage.classList.remove('hidden');
          cardIcon.classList.add('hidden');
        } else {
          if (visualExperience) cardIcon.classList.toggle('is-miss', !data.isWin);
          else cardIcon.textContent = data.isWin ? '🎁' : '💨';
          cardIcon.classList.remove('hidden');
          cardImage.classList.add('hidden');
        }
        cardName.textContent = data.prizeName;
        card.classList.add('mg-revealed');
        card.setAttribute('aria-hidden', 'false');
        if (data.isWin) burstConfetti();

        resultEl.textContent = '';
        const resultLine = document.createElement('div');
        resultLine.className = 'mg-result-message' + (data.isWin ? ' is-win' : '');
        resultLine.textContent = data.isPreview
          ? ('ตัวอย่างผลสุ่มจากเรทที่ตั้งไว้: ' + data.prizeName)
          : (data.isWin ? ('ยินดีด้วย! ได้รับ ' + data.prizeName) : ('ผลลัพธ์: ' + data.prizeName));
        resultEl.appendChild(resultLine);
        if (data.isWin && data.claimCode) {
          const claimBox = document.createElement('div');
          claimBox.className = 'mg-claim-box';
          const claimCodeEl = document.createElement('div');
          claimCodeEl.className = 'mg-claim-code';
          claimCodeEl.textContent = data.claimCode;
          const claimNote = document.createElement('div');
          claimNote.className = 'text-[11px] text-[var(--text-3)] mt-1';
          claimNote.textContent = 'ทักแชท "ติดต่อร้าน" แจ้งโค้ดนี้เพื่อขอรับของรางวัล';
          claimBox.appendChild(claimCodeEl);
          claimBox.appendChild(claimNote);
          resultEl.appendChild(claimBox);
        }
        if (data.isWin && !data.isPreview) {
          const contactBtn = document.createElement('a');
          contactBtn.href = '/contact';
          contactBtn.className = 'mg-contact-btn';
          contactBtn.textContent = '💬 ติดต่อร้านเพื่อรับรางวัล';
          resultEl.appendChild(contactBtn);
        }
        if (balanceEl && typeof data.walletBalance === 'number') balanceEl.textContent = data.walletBalance.toLocaleString();
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
        };
        if (visualExperience) {
          box.classList.add('mg-opening');
          boxScene.classList.add('is-opening');
          revealTimer = setTimeout(finishReveal, reduceMotion ? 0 : 900);
        } else {
          box.classList.add('mg-hidden');
          finishReveal();
        }
      }, Math.max(0, minShakeMs - elapsed));
    });
  });
</script>
