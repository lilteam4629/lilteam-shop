<%
  const soldOut = Number(p.stockCount || 0) < 1;
  const flashTarget = p.flashSaleActive ? p.flashSaleEndsAt : p.flashSaleStartsAt;
  const flashSeconds = Math.max(0, Math.floor((flashTarget - Date.now()) / 1000));
  const flashInitial = (Math.floor(flashSeconds / 86400) ? Math.floor(flashSeconds / 86400) + 'ว ' : '') + [Math.floor((flashSeconds % 86400) / 3600), Math.floor((flashSeconds % 3600) / 60), flashSeconds % 60].map(n => String(n).padStart(2, '0')).join(':');
  const crossedPrice = p.flashSaleActive ? p.regularPrice : p.originalPrice;
  const isFan = typeof compact !== 'undefined' && compact;
  const cardClasses = ['new-product-card', 'premium-product-card', 'spotlight-card', 'filterable-card', 'group', 'catalog-card'];
  if (isFan) cardClasses.push('new-product-card--compact');
  if (soldOut) cardClasses.push('is-sold');
  if (p.isSyndicated) cardClasses.push('is-partner');
%>
<a href="/game/<%= p.slug %>" class="<%= cardClasses.join(' ') %>" style="--mx:50%;--my:50%;" data-product-id="<%= p.id %>" data-stock="<%= soldOut ? 'sold' : 'available' %>" data-title="<%= String(p.title || '').toLowerCase() %>" data-genres="<%= (p.genres || []).join(',') %>" data-tags="<%= (p.filterTagIds || []).join(',') %>">
  <span class="new-product-card__media">
    <img src="<%= p.images && p.images[0] ? p.images[0] : '' %>" alt="<%= p.title %>" width="960" height="540" loading="<%= isFan ? 'eager' : 'lazy' %>" decoding="async" fetchpriority="<%= isFan ? 'high' : 'low' %>">
    <span class="new-product-card__shade" aria-hidden="true"></span>
    <span class="new-product-card__index">ID <%= String(p.id || '').slice(-4).toUpperCase() %></span>
    <span class="new-product-card__status <%= soldOut ? 'is-sold' : '' %>"><i aria-hidden="true"></i><%= soldOut ? 'สินค้าหมด' : 'พร้อมส่ง' %></span>
    <% if (p.isSyndicated) { %><span class="new-product-card__partner">PARTNER</span><% } %>
    <% if (p.flashSaleActive || p.flashSaleUpcoming) { %><span class="new-product-card__sale"><b>⚡</b> <%= p.flashSaleActive ? 'FLASH' : 'เร็วๆ นี้' %></span><% } %>
    <span class="new-product-card__media-mark" aria-hidden="true">↗</span>
  </span>
  <span class="new-product-card__body">
    <span class="new-product-card__eyebrow"><%= p.isSyndicated ? 'สินค้า Partner จากร้านหลัก' : 'LILTEAM SHOP' %></span>
    <strong class="new-product-card__title"><%= p.title %></strong>
    <% if (p.flashSaleActive || p.flashSaleUpcoming) { %><span class="new-product-card__countdown"><span><%= p.flashSaleActive ? 'เหลือเวลา' : 'เริ่มใน' %></span><b class="flash-countdown" data-flash-compact="1" <% if (p.flashSaleActive) { %>data-flash-end="<%= p.flashSaleEndsAt %>"<% } else { %>data-flash-start="<%= p.flashSaleStartsAt %>"<% } %>><%= flashInitial %></b></span><% } %>
    <span class="new-product-card__meta"><span class="new-product-card__price">฿<%= Number(p.price || 0).toLocaleString() %><small>.00</small></span><% if (crossedPrice > p.price) { %><del>฿<%= Number(crossedPrice).toLocaleString() %></del><% } %><span class="new-product-card__stock"><%= soldOut ? 'รอเติมสต็อก' : `เหลือ ${Number(p.stockCount || 0).toLocaleString()} ชิ้น` %></span></span>
    <span class="new-product-card__action"><%= soldOut ? 'ดูรายละเอียด' : (p.isSyndicated ? 'ดูสินค้า Partner' : 'ดูรายละเอียด') %><span aria-hidden="true">→</span></span>
  </span>
</a>
