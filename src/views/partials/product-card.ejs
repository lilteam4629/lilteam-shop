<a href="/game/<%= p.slug %>" style="--mx:50%;--my:50%;" data-product-id="<%= p.id %>" data-genres="<%= (p.genres || []).join(',') %>" data-tags="<%= (p.filterTagIds || []).join(',') %>"
  class="spotlight-card filterable-card group relative flex w-full h-full aspect-[3/4] rounded-2xl overflow-hidden border border-[var(--border)]
         transition-all duration-300 hover:border-[var(--gold)]/50">

  <% const soldOut = p.stockCount < 1; %>
  <img src="<%= p.images[0] %>" alt="<%= p.title %>"
    class="absolute inset-0 w-full h-full object-cover transition duration-500
           <%= soldOut
             ? 'grayscale-[70%] brightness-[0.35] contrast-[1.05] group-hover:brightness-[0.45]'
             : 'grayscale-[25%] brightness-[0.8] contrast-[1.05] group-hover:scale-105 group-hover:brightness-[0.9]' %>" />
  <% if (soldOut) { %>
    <div class="absolute inset-0 bg-black/35"></div>
  <% } %>

  <!-- bottom scrim for text legibility -->
  <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/60 to-transparent"></div>

  <% if (soldOut) { %>
    <span class="absolute top-2 left-2 z-10 bg-black/70 border border-[#e2836f]/50 text-[#e2836f] text-[10px] px-2 py-0.5 rounded-full">สินค้าหมด</span>
  <% } else { %>
    <span class="absolute top-2 left-2 z-10 bg-black/70 border border-emerald-700/60 text-emerald-400 text-[10px] px-2 py-0.5 rounded-full">พร้อมส่ง</span>
  <% } %>

  <div class="absolute inset-x-0 bottom-0 p-3 flex flex-col gap-1 min-w-0">
    <h3 class="font-medium text-sm line-clamp-2 text-white drop-shadow"><%= p.title %></h3>
    <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0 min-w-0">
      <% if (p.type === 'rental') { %>
        <span class="text-[10px] text-white/70">เริ่ม</span>
      <% } %>
      <span class="text-[#c8a63f] font-bold text-sm whitespace-nowrap">฿<%= p.price.toLocaleString() %>.00</span>
      <% if (p.type === 'offline' && p.originalPrice > p.price) { %>
        <span class="text-[#e2836f] text-[11px] line-through whitespace-nowrap">฿<%= p.originalPrice.toLocaleString() %>.00</span>
      <% } %>
    </div>
    <span class="text-[10px] text-white/70 truncate"><%= p.type === 'offline' ? 'ไอดี Offline Steam' : 'ไอดีเช่ารายวัน' %></span>
  </div>

  <!-- mouse-tracking spotlight -->
  <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style="background: radial-gradient(220px circle at var(--mx) var(--my), rgba(230,196,132,0.35), transparent 70%);"></div>
</a>
