<% const compactCard = typeof compact !== 'undefined' && compact; %>
<a href="/game/<%= p.slug %>" style="--mx:50%;--my:50%;" data-genres="<%= (p.genres || []).join(',') %>" data-tags="<%= (p.filterTagIds || []).join(',') %>"
  class="spotlight-card filterable-card group relative flex w-full h-full aspect-[3/4] rounded-2xl overflow-hidden border border-[var(--border)]
         transition-all duration-300 hover:border-[var(--gold)]/50">

  <% const soldOut = p.stockCount < 1; %>
  <img src="<%= p.images[0] %>" alt="<%= p.title %>"
    class="absolute inset-0 w-full h-full object-cover transition duration-500
           <%= soldOut
             ? 'grayscale-[70%] brightness-[0.35] contrast-[1.05] group-hover:brightness-[0.45]'
             : 'grayscale-[25%] brightness-[0.8] contrast-[1.05] group-hover:scale-105 group-hover:brightness-[0.9]' %>" />
  <% if (soldOut) { %>
    <div class="absolute inset-0 bg-black/35"></div>
  <% } %>

  <!-- bottom scrim for text legibility -->
  <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/60 to-transparent"></div>

  <% if (soldOut) { %>
    <span class="absolute z-10 bg-black/75 border border-[#e2836f]/50 text-[#e2836f] rounded-full <%= compactCard ? 'top-2 left-2 text-[10px] px-2 py-0.5' : 'top-4 left-4 min-[480px]:top-2 min-[480px]:left-2 text-xs min-[480px]:text-[10px] px-3 min-[480px]:px-2 py-1 min-[480px]:py-0.5' %>">สินค้าหมด</span>
  <% } else { %>
    <span class="absolute z-10 bg-black/75 border border-emerald-700/60 text-emerald-400 rounded-full <%= compactCard ? 'top-2 left-2 text-[10px] px-2 py-0.5' : 'top-4 left-4 min-[480px]:top-2 min-[480px]:left-2 text-xs min-[480px]:text-[10px] px-3 min-[480px]:px-2 py-1 min-[480px]:py-0.5' %>">พร้อมส่ง</span>
  <% } %>

  <div class="absolute inset-x-0 bottom-0 flex flex-col min-w-0 <%= compactCard ? 'p-3 gap-1' : 'p-5 min-[480px]:p-3 gap-2 min-[480px]:gap-1' %>">
    <h3 class="font-semibold line-clamp-2 text-white drop-shadow <%= compactCard ? 'text-sm' : 'text-xl min-[480px]:text-sm' %>"><%= p.title %></h3>
    <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0 min-w-0">
      <% if (p.type === 'rental') { %>
        <span class="text-white/70 <%= compactCard ? 'text-[10px]' : 'text-sm min-[480px]:text-[10px]' %>">เริ่ม</span>
      <% } %>
      <span class="text-[#c8a63f] font-bold whitespace-nowrap <%= compactCard ? 'text-sm' : 'text-xl min-[480px]:text-sm' %>">฿<%= p.price.toLocaleString() %>.00</span>
      <% if (p.type === 'offline' && p.originalPrice > p.price) { %>
        <span class="text-[#e2836f] line-through whitespace-nowrap <%= compactCard ? 'text-[11px]' : 'text-sm min-[480px]:text-[11px]' %>">฿<%= p.originalPrice.toLocaleString() %>.00</span>
      <% } %>
    </div>
    <span class="text-white/70 truncate <%= compactCard ? 'text-[10px]' : 'text-sm min-[480px]:text-[10px]' %>"><%= p.type === 'offline' ? 'ไอดี Offline Steam' : 'ไอดีเช่ารายวัน' %></span>
  </div>

  <!-- mouse-tracking spotlight -->
  <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style="background: radial-gradient(220px circle at var(--mx) var(--my), rgba(230,196,132,0.35), transparent 70%);"></div>
</a>
