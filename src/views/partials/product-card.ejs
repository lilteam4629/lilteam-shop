<a href="/game/<%= p.slug %>" style="--mx:50%;--my:50%;" data-product-id="<%= p.id %>" data-title="<%= String(p.title || '').toLowerCase() %>" data-genres="<%= (p.genres || []).join(',') %>" data-tags="<%= (p.filterTagIds || []).join(',') %>"
  class="premium-product-card spotlight-card filterable-card group relative flex w-full h-full aspect-[3/4] rounded-2xl overflow-hidden border <%= p.flashSaleActive ? 'flash-sale-card border-[#f3ca45]' : 'border-[#8c7430]/55' %>
         transition-all duration-300 hover:border-[#f0cf64]/80">

  <% const soldOut = p.stockCount < 1; %>
  <img src="<%= p.images[0] %>" alt="<%= p.title %>"
    class="absolute inset-0 w-full h-full object-cover transition duration-500
           <%= soldOut
             ? 'grayscale-[70%] brightness-[0.35] contrast-[1.05] group-hover:brightness-[0.45]'
             : 'brightness-[0.98] contrast-[1.1] saturate-[1.16] group-hover:scale-[1.055] group-hover:brightness-[1.08] group-hover:saturate-[1.28]' %>" />
  <% if (soldOut) { %>
    <div class="absolute inset-0 bg-black/35"></div>
  <% } %>

  <% if (p.flashSaleActive) { %>
    <div class="flash-sale-chip absolute top-2 right-2 z-20 flex items-center gap-1.5 rounded-xl border border-[#f5d05d]/65 bg-[#0c0d0b]/85 py-1.5 pl-1.5 pr-2.5 text-[#ffe27a] shadow-[0_5px_20px_rgba(0,0,0,.4)] backdrop-blur-md">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-[#ffe47c] to-[#b97608] text-[14px] text-[#171207] shadow-[0_0_14px_rgba(245,208,93,.45)]">⚡</span>
      <span class="flash-chip-copy leading-none"><b class="block text-[9px] font-black tracking-[.12em]">FLASH</b><small class="mt-0.5 block text-[7px] font-bold tracking-[.22em] text-white/70">SALE</small></span>
    </div>
  <% } else if (p.flashSaleUpcoming) { %>
    <div class="absolute top-2 right-2 z-20 flex items-center gap-1.5 rounded-xl border border-[#d7b84c]/50 bg-[#0c0d0b]/85 py-1.5 pl-1.5 pr-2.5 text-[#ffe27a] shadow-[0_5px_20px_rgba(0,0,0,.4)] backdrop-blur-md">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-[#332b16] text-[13px]">⚡</span>
      <span class="flash-chip-copy leading-none"><b class="block text-[8px] font-black tracking-wider">เร็วๆ นี้</b><small class="mt-1 block text-[6px] tracking-wider text-white/60">FLASH SALE</small></span>
    </div>
  <% } %>

  <!-- bottom scrim for text legibility -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#ffe995]/10 via-transparent to-emerald-400/10"></div>
  <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white/10 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/55 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-[#f6d66c]/25 group-hover:ring-[#ffe487]/60 transition"></div>
  <% if (!soldOut) { %>
    <div class="product-shimmer pointer-events-none absolute -inset-y-1 left-0 w-1/3 bg-gradient-to-r from-transparent via-white/30 to-transparent blur-[1px]"></div>
  <% } %>

  <% if (soldOut) { %>
    <span class="absolute top-2 left-2 z-10 bg-black/70 border border-[#e2836f]/50 text-[#e2836f] text-[10px] px-2 py-0.5 rounded-full">สินค้าหมด</span>
  <% } else { %>
    <span class="ready-glow absolute top-2 left-2 z-10 bg-emerald-950/80 border border-emerald-400/70 text-emerald-300 font-medium text-[10px] px-2.5 py-1 rounded-full backdrop-blur-sm">● พร้อมส่ง</span>
  <% } %>

  <div class="absolute inset-x-0 bottom-0 p-3 flex flex-col gap-1 min-w-0">
    <% if (p.flashSaleActive || p.flashSaleUpcoming) { %>
      <div class="flash-timer-hud relative mb-0.5 flex h-6 min-w-0 items-center justify-between gap-1.5 overflow-hidden rounded-lg border border-[#e6bd42]/40 bg-black/65 px-2 backdrop-blur-md">
        <span class="truncate text-[7px] font-bold uppercase tracking-wider text-[#f7d66b]"><%= p.flashSaleActive ? 'ดีลสิ้นสุดใน' : 'เริ่มโปรโมชั่นใน' %></span>
        <span class="flash-countdown shrink-0 font-mono text-[9px] font-black text-white" data-flash-compact="1" <%= p.flashSaleActive ? `data-flash-end="${p.flashSaleEndsAt}"` : `data-flash-start="${p.flashSaleStartsAt}"` %>></span>
      </div>
    <% } %>
    <h3 class="font-semibold text-sm line-clamp-2 text-white [text-shadow:0_2px_8px_rgba(0,0,0,.95)] group-hover:text-[#fff6d4] transition-colors"><%= p.title %></h3>
    <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0 min-w-0">
      <span class="text-[#f2cc4d] font-bold text-[15px] whitespace-nowrap [text-shadow:0_0_12px_rgba(242,204,77,.5)]">฿<%= p.price.toLocaleString() %>.00</span>
      <% const crossedPrice = p.flashSaleActive ? p.regularPrice : p.originalPrice; %>
      <% if (crossedPrice > p.price) { %>
        <span class="text-[#e2836f] text-[11px] line-through whitespace-nowrap">฿<%= crossedPrice.toLocaleString() %>.00</span>
      <% } %>
    </div>
    <span class="text-[10px] text-white/85 truncate">สินค้าเกมพร้อมส่ง</span>
  </div>

  <!-- mouse-tracking spotlight -->
  <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style="background: radial-gradient(220px circle at var(--mx) var(--my), rgba(230,196,132,0.35), transparent 70%);"></div>
</a>
