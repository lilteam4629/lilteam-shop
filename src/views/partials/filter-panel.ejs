<% const _activeIds=(typeof activeFilterTags!=='undefined'?activeFilterTags:[]).map(t=>String(t.id)); %>
<div id="filterWidget" class="simple-filter-widget"><h2 class="simple-filter-heading"><%= (settings.filterHeading || 'เลือกตัวที่ต้องการตามหา') %></h2><div id="filterTags" class="simple-filter-grid" aria-label="เลือกตัวกรองสินค้า">
<% filterTags.forEach(t=>{ const active=_activeIds.includes(String(t.id)); %><button type="button" class="filter-chip <%= active?'active':'' %>" data-tag-id="<%= t.id %>" aria-pressed="<%= active?'true':'false' %>"><span class="simple-filter-image"><img src="<%= t.image %>" alt="<%= t.name %>" /></span><span class="simple-filter-name"><%= t.name %></span><span class="check-badge" aria-hidden="true">✓</span></button><% }) %>
</div></div>
<style>
.simple-filter-widget{margin-bottom:18px!important;padding:12px!important;border:1px solid var(--border-light)!important;border-radius:15px!important;background:var(--card)!important;background-image:none!important;box-shadow:0 10px 28px -24px rgba(0,0,0,.45)!important}
.simple-filter-grid{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(76px,1fr))!important;gap:10px!important;width:100%!important;overflow:visible!important}.simple-filter-grid .filter-chip{position:relative!important;display:grid!important;grid-template-rows:auto 24px!important;width:100%!important;height:auto!important;min-width:0!important;min-height:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;text-align:center!important}.simple-filter-image{display:grid!important;place-items:center!important;width:100%!important;height:auto!important;aspect-ratio:1/1!important;padding:4px!important;overflow:hidden!important;border:1.5px solid var(--border-light)!important;border-radius:12px!important;background:var(--input)!important;transition:.16s}.simple-filter-image img{display:block!important;width:100%!important;height:100%!important;object-fit:contain!important;object-position:center!important;border-radius:8px!important}.simple-filter-name{display:block!important;overflow:hidden!important;padding:5px 2px 0!important;color:var(--text-2)!important;font-size:10px!important;font-weight:750!important;line-height:1.2!important;text-align:center!important;text-overflow:ellipsis!important;white-space:nowrap!important}.simple-filter-grid .filter-chip:hover .simple-filter-image,.simple-filter-grid .filter-chip.active .simple-filter-image{border-color:var(--gold)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 16%,transparent)!important}.simple-filter-grid .filter-chip.active .simple-filter-name{color:var(--gold)!important}.simple-filter-grid .check-badge{position:absolute!important;display:none!important;top:4px!important;right:4px!important;width:19px!important;height:19px!important;place-items:center!important;border-radius:50%!important;background:var(--gold)!important;color:var(--bg)!important;font-size:10px!important;font-weight:900!important}.simple-filter-grid .filter-chip.active .check-badge{display:grid!important}@media(max-width:640px){.simple-filter-widget{padding:8px;border-radius:12px}.simple-filter-grid{grid-template-columns:repeat(auto-fill,minmax(54px,1fr))!important;gap:7px!important}.simple-filter-name{height:20px!important;padding-top:4px!important;font-size:8px!important}.simple-filter-image{padding:3px!important;border-radius:9px!important}}
#filterWidget #filterTags .filter-chip{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:auto 24px!important;background:transparent!important}
#filterWidget.simple-filter-widget{background:var(--card)!important;background-image:none!important}
#filterWidget #filterTags .filter-chip>.simple-filter-image{grid-column:1!important;grid-row:1!important;width:auto!important;height:86px!important;aspect-ratio:auto!important;background:var(--input)!important}
#filterWidget #filterTags .filter-chip>.simple-filter-name{grid-column:1!important;grid-row:2!important;display:block!important;width:100%!important;padding:5px 2px 0!important;background:transparent!important;text-align:center!important}
#filterWidget #filterTags .filter-chip.active>.simple-filter-image{border-color:var(--gold)!important;background:var(--input)!important}
.simple-filter-heading{margin:0 0 10px!important;color:var(--text)!important;font-size:16px!important;font-weight:800!important;line-height:1.25!important}.simple-filter-grid{display:flex!important;flex-wrap:nowrap!important;align-items:flex-start!important;overflow-x:auto!important;overflow-y:hidden!important;padding:2px 1px 7px!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important}.simple-filter-grid::-webkit-scrollbar{display:none!important}.simple-filter-grid .filter-chip{display:flex!important;flex:0 0 auto!important;flex-direction:column!important;width:auto!important;scroll-snap-align:start!important}.simple-filter-image{width:auto!important;height:86px!important;aspect-ratio:auto!important}.simple-filter-image img{width:auto!important;height:100%!important;max-width:none!important;object-fit:contain!important}.simple-filter-name{width:100%!important;max-width:104px!important;margin:auto!important}
#filterWidget #filterTags .filter-chip>.simple-filter-image>img{display:block!important;width:auto!important;height:100%!important;max-width:none!important;max-height:100%!important;object-fit:contain!important;object-position:center!important}
@media(max-width:640px){.simple-filter-heading{margin-bottom:8px!important;font-size:13px!important}.simple-filter-grid{display:flex!important;flex-wrap:nowrap!important;gap:8px!important;overflow-x:auto!important;overflow-y:hidden!important;padding:2px 1px 6px!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important}.simple-filter-grid::-webkit-scrollbar{display:none!important}.simple-filter-grid .filter-chip{flex:0 0 auto!important;width:auto!important;scroll-snap-align:start!important}#filterWidget #filterTags .filter-chip>.simple-filter-image{width:auto!important;height:76px!important;aspect-ratio:auto!important}.simple-filter-image img{width:auto!important;height:100%!important;max-width:none!important}.simple-filter-name{max-width:92px!important}}
</style>
<script>(function(){const widget=document.getElementById('filterWidget');if(!widget||widget.dataset.ready==='true')return;widget.dataset.ready='true';const buttons=[...widget.querySelectorAll('.filter-chip')],selected=new Set(<%- JSON.stringify(_activeIds) %>),cards=[...document.querySelectorAll('.store-product-gallery .filterable-card')];function apply(){cards.forEach(card=>{const tags=String(card.dataset.tags||'').split(',').filter(Boolean);card.hidden=selected.size>0&&![...selected].every(id=>tags.includes(id))})}buttons.forEach(button=>button.addEventListener('click',()=>{const id=String(button.dataset.tagId);selected.has(id)?selected.delete(id):selected.add(id);button.classList.toggle('active',selected.has(id));button.setAttribute('aria-pressed',selected.has(id)?'true':'false');if(cards.length){apply();return}window.location.href=selected.size?'/products?tags='+[...selected].map(encodeURIComponent).join(','):'/products'}));if(cards.length)apply()})();</script>
