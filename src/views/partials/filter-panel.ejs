<%
  const _activeFilterTags = typeof activeFilterTags !== 'undefined' ? activeFilterTags : [];
  const _activeIds = _activeFilterTags.map(t => t.id);
%>
<div class="relative overflow-hidden bg-gradient-to-br from-[var(--card)] to-[var(--input)] border border-[var(--border)] rounded-2xl p-3 sm:p-5 mb-6" id="filterWidget">
  <div class="relative flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-3">
      <span class="filter-title-icon"><svg><use href="#ui-tag"/></svg></span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-sm sm:text-base font-semibold text-[var(--text)]">เลือกประเภทที่สนใจ</h2>
          <% _activeFilterTags.forEach(t => { %><span class="bg-[var(--gold)] text-[var(--bg)] text-[10px] font-bold rounded-full px-2 py-0.5"><%= t.name %></span><% }) %>
        </div>
        <p class="text-[11px] sm:text-xs text-[var(--text-4)]">เลือกได้หลายประเภท — สินค้าต้องมีครบทุกประเภทที่เลือก</p>
      </div>
    </div>
    <div class="filter-live-summary flex items-center gap-2">
      <span id="filterSelectionCount" class="filter-selection-count hidden"><b>0</b> เลือกแล้ว</span>
      <button type="button" id="filterClearBtn" class="filter-clear-btn hidden">ล้าง</button>
      <p class="text-xs sm:text-sm text-[var(--text-3)] whitespace-nowrap"><b class="text-[var(--gold)] text-sm sm:text-base"><%= typeof filterProductCount !== 'undefined' ? filterProductCount : 0 %></b> สินค้า</p>
      <% if (_activeFilterTags.length) { %><a href="/products" class="text-xs text-[var(--coral)] border border-[var(--coral)]/30 hover:bg-[var(--coral)]/10 rounded-lg px-2.5 py-1.5 whitespace-nowrap transition">ล้างตัวกรอง</a><% } %>
    </div>
  </div>
  <div class="filter-control-row">
    <label class="filter-search-control"><svg><use href="#ui-search"/></svg><input id="filterSearch" type="search" autocomplete="off" placeholder="ค้นหาตัวกรอง เช่น Messi, Denuvo..." /></label>
    <label class="filter-select-control"><svg><use href="#ui-grid"/></svg><select id="filterView"><option value="all">ทุกตัวกรอง</option><option value="selected">เลือกแล้ว</option><option value="unselected">ยังไม่ได้เลือก</option></select></label>
    <label class="filter-select-control"><svg><use href="#ui-tag"/></svg><select id="filterSort"><option value="default">เรียงตามค่าเริ่มต้น</option><option value="name-asc">ชื่อ ก–ฮ</option><option value="name-desc">ชื่อ ฮ–ก</option></select></label>
  </div>
  <div class="relative flex items-center gap-2">
    <button type="button" id="scrollLeftBtn" aria-label="เลื่อนตัวกรองไปทางซ้าย" class="hidden shrink-0 w-9 h-9 items-center justify-center rounded-full bg-[var(--card)] border border-[var(--border-light)] text-[var(--text-3)] hover:text-[var(--gold)] hover:border-[var(--gold)]/50 transition">‹</button>
    <div id="filterTags" class="filter-scroll flex flex-1 min-w-0 items-start gap-2 sm:gap-2.5 overflow-x-auto overflow-y-hidden sm:scroll-smooth py-1 snap-x snap-mandatory sm:snap-none">
      <% filterTags.forEach(t => { %>
        <button type="button" data-tag-id="<%= t.id %>" data-name="<%= t.name %>" class="filter-chip <%= _activeIds.includes(t.id) ? 'active' : '' %> group relative self-start shrink-0 flex flex-col w-[128px] sm:w-[180px] snap-start rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--border-light)] bg-[var(--card)] transition-[border-color,background-color,box-shadow] duration-200 sm:hover:-translate-y-0.5 hover:border-[var(--gold)]/60 text-left">
          <span class="w-full bg-black/20 flex items-center justify-center overflow-hidden border-b border-white/5">
            <img src="<%= t.image %>" alt="<%= t.name %>" class="block w-full h-auto object-contain transition duration-300 group-hover:brightness-105" />
          </span>
          <span class="w-full min-w-0 text-left px-2 sm:px-3 py-2">
            <span class="block text-[11px] sm:text-sm font-semibold text-[var(--text)] truncate"><%= t.name %></span>
            <span class="chip-hint hidden sm:block text-[10px] text-[var(--text-4)]">แตะเพื่อเลือก/ยกเลิก</span>
          </span>
          <span class="check-badge absolute top-1.5 right-1.5 hidden w-4 h-4 rounded-full bg-[var(--gold)] text-[var(--bg)] text-[9px] font-bold items-center justify-center shadow">✓</span>
        </button>
      <% }) %>
    </div>
    <button type="button" id="scrollRightBtn" aria-label="เลื่อนตัวกรองไปทางขวา" class="hidden shrink-0 w-9 h-9 items-center justify-center rounded-full bg-[var(--card)] border border-[var(--border-light)] text-[var(--text-3)] hover:text-[var(--gold)] hover:border-[var(--gold)]/50 transition">›</button>
  </div>
  <div class="filter-action-bar"><p>เลือกแล้ว <strong id="filterFooterCount">0 รายการ</strong></p><button type="button" id="filterApplyBtn" disabled>ดูสินค้าที่เลือก <span>›</span></button></div>
</div>

<style>
  .filter-scroll::-webkit-scrollbar { display: none; }
  .filter-scroll { scrollbar-width: none; -ms-overflow-style: none; touch-action: pan-x; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
  .filter-chip.active { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 12%, transparent); box-shadow: 0 8px 24px -14px color-mix(in srgb, var(--gold) 90%, transparent); }
  .filter-chip.active .check-badge { display: flex; }
  .filter-chip.active .chip-hint { color: var(--gold); }
</style>

<script>
  (function () {
    const widget = document.getElementById('filterWidget');
    if (!widget || widget.dataset.ready === 'true') return;
    widget.dataset.ready = 'true';
    const tagsWrap = document.getElementById('filterTags');
    const searchInput = document.getElementById('filterSearch');
    const scrollLeftBtn = document.getElementById('scrollLeftBtn');
    const scrollRightBtn = document.getElementById('scrollRightBtn');
    const applyBtn = document.getElementById('filterApplyBtn');
    const selectionCount = document.getElementById('filterSelectionCount');
    const clearBtn = document.getElementById('filterClearBtn');
    const viewSelect = document.getElementById('filterView');
    const sortSelect = document.getElementById('filterSort');
    const footerCount = document.getElementById('filterFooterCount');
    const selected = new Set(<%- JSON.stringify(_activeIds) %>);
    let searchQuery = '';

    function normalizeText(value) {
      return String(value || '').normalize('NFKC').trim().toLocaleLowerCase('th-TH');
    }
    function filterTagChoices() {
      tagsWrap.querySelectorAll('.filter-chip').forEach((button) => {
        const view = viewSelect ? viewSelect.value : 'all';
        const selectedMatch = view === 'all' || (view === 'selected' ? selected.has(button.dataset.tagId) : !selected.has(button.dataset.tagId));
        const visible = selectedMatch && (!searchQuery || normalizeText(button.dataset.name).includes(searchQuery));
        button.style.display = visible ? '' : 'none';
      });
    }
    function updateApplyBtn() {
      applyBtn.disabled = selected.size === 0;
      applyBtn.innerHTML = `${selected.size ? `ดูสินค้าที่เลือก (${selected.size})` : 'ดูสินค้าที่เลือก'} <span>›</span>`;
      if (selectionCount) {
        selectionCount.classList.toggle('hidden', selected.size === 0);
        const amount = selectionCount.querySelector('b');
        if (amount) amount.textContent = selected.size;
      }
      if (clearBtn) clearBtn.classList.toggle('hidden', selected.size === 0);
      if (footerCount) footerCount.textContent = `${selected.size} รายการ`;
    }
    tagsWrap.querySelectorAll('.filter-chip').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.tagId;
        if (selected.has(id)) { selected.delete(id); button.classList.remove('active'); }
        else { selected.add(id); button.classList.add('active'); }
        updateApplyBtn();
        filterTagChoices();
      });
    });
    applyBtn.addEventListener('click', () => {
      if (!selected.size) return;
      window.location.href = '/products?tags=' + Array.from(selected).map(encodeURIComponent).join(',');
    });
    if (clearBtn) clearBtn.addEventListener('click', () => {
      selected.clear();
      tagsWrap.querySelectorAll('.filter-chip').forEach(button => button.classList.remove('active'));
      updateApplyBtn();
      filterTagChoices();
    });
    searchInput.addEventListener('input', () => {
      searchQuery = normalizeText(searchInput.value);
      filterTagChoices();
      updateScrollButtons();
    });
    if (viewSelect) viewSelect.addEventListener('change', filterTagChoices);
    if (sortSelect) sortSelect.addEventListener('change', () => {
      const cards = [...tagsWrap.querySelectorAll('.filter-chip')];
      if (sortSelect.value !== 'default') cards.sort((a,b) => normalizeText(a.dataset.name).localeCompare(normalizeText(b.dataset.name),'th') * (sortSelect.value === 'name-desc' ? -1 : 1));
      cards.forEach(card => tagsWrap.appendChild(card));
      updateScrollButtons();
    });
    function updateScrollButtons() {
      const overflowing = tagsWrap.scrollWidth > tagsWrap.clientWidth + 4;
      const atStart = tagsWrap.scrollLeft <= 4;
      const atEnd = tagsWrap.scrollLeft >= tagsWrap.scrollWidth - tagsWrap.clientWidth - 4;
      scrollLeftBtn.classList.toggle('sm:flex', overflowing && !atStart);
      scrollLeftBtn.classList.toggle('hidden', !(overflowing && !atStart));
      scrollRightBtn.classList.toggle('sm:flex', overflowing && !atEnd);
      scrollRightBtn.classList.toggle('hidden', !(overflowing && !atEnd));
    }
    scrollLeftBtn.addEventListener('click', () => tagsWrap.scrollBy({ left: -260, behavior: 'smooth' }));
    scrollRightBtn.addEventListener('click', () => tagsWrap.scrollBy({ left: 260, behavior: 'smooth' }));
    tagsWrap.addEventListener('scroll', updateScrollButtons, { passive: true });
    window.addEventListener('resize', updateScrollButtons);
    function initializeFilter() {
      filterTagChoices();
      updateScrollButtons();
      updateApplyBtn();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeFilter, { once: true });
    } else {
      initializeFilter();
    }
  })();
</script>
