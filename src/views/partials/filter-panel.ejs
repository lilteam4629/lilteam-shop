<div class="relative overflow-hidden bg-gradient-to-br from-[var(--card)] to-[var(--input)] border border-[var(--border)] rounded-2xl p-3 sm:p-5 mb-6" id="filterWidget">
  <div class="absolute -top-16 -right-16 w-44 h-44 rounded-full bg-[var(--gold)]/5 blur-2xl pointer-events-none"></div>
  <div class="relative flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 rounded-xl bg-[var(--gold)]/15 border border-[var(--gold)]/20 flex items-center justify-center text-lg">🏷️</span>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-sm sm:text-base font-semibold text-[var(--text)]">เลือกประเภทที่สนใจ</h2>
          <% if (typeof activeFilterTag !== 'undefined' && activeFilterTag) { %><span class="bg-[var(--gold)] text-[var(--bg)] text-[10px] font-bold rounded-full px-2 py-0.5"><%= activeFilterTag.name %></span><% } %>
        </div>
        <p class="text-[11px] sm:text-xs text-[var(--text-4)]">กดเพื่อเปิดหน้าสินค้าประเภทที่เลือก</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <p class="text-xs sm:text-sm text-[var(--text-3)] whitespace-nowrap"><b class="text-[var(--gold)] text-sm sm:text-base"><%= typeof filterProductCount !== 'undefined' ? filterProductCount : 0 %></b> สินค้า</p>
      <% if (typeof activeFilterTag !== 'undefined' && activeFilterTag) { %><a href="/products" class="text-xs text-[var(--coral)] border border-[var(--coral)]/30 hover:bg-[var(--coral)]/10 rounded-lg px-2.5 py-1.5 whitespace-nowrap transition">ล้างตัวกรอง</a><% } %>
    </div>
  </div>
  <div class="relative mb-3">
    <svg viewBox="0 0 24 24" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 fill-none stroke-[var(--text-4)]" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <input id="filterSearch" type="search" autocomplete="off" placeholder="ค้นหาตัวกรอง เช่น Messi, Denuvo..." class="w-full sm:max-w-sm h-11 bg-black/20 border border-[var(--border-light)] rounded-xl pl-10 pr-4 text-sm text-[var(--text)] placeholder:text-[var(--text-4)] focus:outline-none focus:border-[var(--gold)]/70 focus:ring-2 focus:ring-[var(--gold)]/10 transition" />
  </div>
  <div class="relative flex items-center gap-2">
    <button type="button" id="scrollLeftBtn" aria-label="เลื่อนตัวกรองไปทางซ้าย" class="hidden shrink-0 w-9 h-9 items-center justify-center rounded-full bg-[var(--card)] border border-[var(--border-light)] text-[var(--text-3)] hover:text-[var(--gold)] hover:border-[var(--gold)]/50 transition">‹</button>
    <div id="filterTags" class="filter-scroll flex-1 grid grid-cols-3 sm:flex sm:items-center gap-1.5 sm:gap-2.5 overflow-visible sm:overflow-x-auto scroll-smooth py-1">
      <% filterTags.forEach(t => { %>
        <a href="/products?tag=<%= encodeURIComponent(t.id) %>" data-name="<%= t.name %>" class="filter-chip <%= typeof activeFilterTag !== 'undefined' && activeFilterTag && activeFilterTag.id === t.id ? 'active' : '' %> group relative self-start shrink-0 flex flex-col w-full sm:w-[180px] rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--border-light)] bg-[var(--card)] transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--gold)]/60">
          <span class="w-full bg-black/20 flex items-center justify-center overflow-hidden border-b border-white/5">
            <img src="<%= t.image %>" alt="<%= t.name %>" class="block w-full h-auto object-contain transition duration-300 group-hover:brightness-105" />
          </span>
          <span class="w-full min-w-0 text-left px-2 sm:px-3 py-2">
            <span class="block text-[11px] sm:text-sm font-semibold text-[var(--text)] truncate"><%= t.name %></span>
            <span class="chip-hint hidden sm:block text-[10px] text-[var(--text-4)]">เปิดดูสินค้าประเภทนี้</span>
          </span>
          <span class="check-badge absolute top-1.5 right-1.5 hidden w-4 h-4 rounded-full bg-[var(--gold)] text-[var(--bg)] text-[9px] font-bold items-center justify-center shadow">✓</span>
        </a>
      <% }) %>
    </div>
    <button type="button" id="scrollRightBtn" aria-label="เลื่อนตัวกรองไปทางขวา" class="hidden shrink-0 w-9 h-9 items-center justify-center rounded-full bg-[var(--card)] border border-[var(--border-light)] text-[var(--text-3)] hover:text-[var(--gold)] hover:border-[var(--gold)]/50 transition">›</button>
  </div>
</div>

<style>
  .filter-scroll::-webkit-scrollbar { display: none; }
  .filter-scroll { scrollbar-width: none; -ms-overflow-style: none; }
  .filter-chip.active { border-color: var(--gold); background: rgba(200,166,63,.12); box-shadow: 0 8px 24px -14px rgba(200,166,63,.9); }
  .filter-chip.active .check-badge { display: flex; }
  .filter-chip.active .chip-hint { color: var(--gold); }
</style>

<script>
  (function () {
    const widget = document.getElementById('filterWidget');
    if (!widget || widget.dataset.ready === 'true') return;
    widget.dataset.ready = 'true';
    const tagsWrap = document.getElementById('filterTags');
    const searchInput = document.getElementById('filterSearch');
    const scrollLeftBtn = document.getElementById('scrollLeftBtn');
    const scrollRightBtn = document.getElementById('scrollRightBtn');
    let searchQuery = '';
    function normalizeText(value) {
      return String(value || '').normalize('NFKC').trim().toLocaleLowerCase('th-TH');
    }
    function filterTagChoices() {
      tagsWrap.querySelectorAll('.filter-chip').forEach((button) => {
        const visible = !searchQuery || normalizeText(button.dataset.name).includes(searchQuery);
        button.style.display = visible ? '' : 'none';
      });
    }
    searchInput.addEventListener('input', () => {
      searchQuery = normalizeText(searchInput.value);
      filterTagChoices();
      updateScrollButtons();
    });
    function updateScrollButtons() {
      const overflowing = tagsWrap.scrollWidth > tagsWrap.clientWidth + 4;
      const atStart = tagsWrap.scrollLeft <= 4;
      const atEnd = tagsWrap.scrollLeft >= tagsWrap.scrollWidth - tagsWrap.clientWidth - 4;
      scrollLeftBtn.classList.toggle('sm:flex', overflowing && !atStart);
      scrollLeftBtn.classList.toggle('hidden', !(overflowing && !atStart));
      scrollRightBtn.classList.toggle('sm:flex', overflowing && !atEnd);
      scrollRightBtn.classList.toggle('hidden', !(overflowing && !atEnd));
    }
    scrollLeftBtn.addEventListener('click', () => tagsWrap.scrollBy({ left: -260, behavior: 'smooth' }));
    scrollRightBtn.addEventListener('click', () => tagsWrap.scrollBy({ left: 260, behavior: 'smooth' }));
    tagsWrap.addEventListener('scroll', updateScrollButtons, { passive: true });
    window.addEventListener('resize', updateScrollButtons);
    function initializeFilter() {
      filterTagChoices();
      updateScrollButtons();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeFilter, { once: true });
    } else {
      initializeFilter();
    }
  })();
</script>
