<section class="store-status-section main-service-section w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-6" data-storefront-preview-hours-bar <%= settings.showOpenHoursBar === false ? 'hidden' : '' %>>
  <%- include('main-service-strip') %>
</section>

<% if (announcements.length) { %>
<div class="store-announcements w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto mt-2 space-y-2">
  <% announcements.forEach(a => { %>
    <div class="announce-hud relative flex items-start gap-3 rounded-xl px-4 py-3 text-[var(--text)] text-sm overflow-hidden">
      <div class="announce-hud-glow"></div>
      <span class="announce-hud-icon relative z-[1] flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"><svg width="24" height="24"><use href="#ui-megaphone"/></svg></span>
      <p class="relative z-[1] min-w-0 leading-relaxed"><b class="text-[var(--gold-text)]"><%= a.title %></b> — <%= a.body %></p>
    </div>
  <% }) %>
</div>
<% } %>
