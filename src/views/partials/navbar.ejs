<header class="store-nav sticky top-0 z-50">
  <svg class="ui-icon-sprite" aria-hidden="true">
    <symbol id="ui-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></symbol>
    <symbol id="ui-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
    <symbol id="ui-box" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></symbol>
    <symbol id="ui-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></symbol>
    <symbol id="ui-tag" viewBox="0 0 24 24"><path d="M3 11V4a1 1 0 0 1 1-1h7l10 10-8 8z"/><circle cx="8" cy="8" r="1.5"/></symbol>
    <symbol id="ui-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
    <symbol id="ui-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></symbol>
    <symbol id="ui-moon" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2z"/></symbol>
    <symbol id="ui-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.2 10h10.6l2-7H6"/><circle cx="9" cy="19" r="1.5"/><circle cx="18" cy="19" r="1.5"/></symbol>
    <symbol id="ui-book" viewBox="0 0 24 24"><path d="M4 5a3 3 0 0 1 3-2h5v17H7a3 3 0 0 0-3 2zM20 5a3 3 0 0 0-3-2h-5v17h5a3 3 0 0 1 3 2z"/></symbol>
    <symbol id="ui-megaphone" viewBox="0 0 24 24"><path d="M4 10v4h4l9 4V6L8 10zM8 14l1.5 5h3"/><path d="M20 9v6"/></symbol>
    <symbol id="ui-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="ui-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
    <symbol id="ui-wallet" viewBox="0 0 24 24"><path d="M4 6h14a2 2 0 0 1 2 2v10H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12"/><path d="M15 11h5v4h-5a2 2 0 0 1 0-4z"/></symbol>
    <symbol id="ui-shield" viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-5"/></symbol>
    <symbol id="ui-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.8 9a2.4 2.4 0 1 1 3.3 2.2c-.8.4-1.1.9-1.1 1.8M12 17h.01"/></symbol>
    <symbol id="ui-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a15 15 0 0 0 5 5L15 13l5 2v4c0 1.1-.9 2-2 2C9.7 21 3 14.3 3 6c0-1.1.9-2 2-2z"/></symbol>
    <symbol id="ui-logout" viewBox="0 0 24 24"><path d="M10 4H4v16h6M14 8l4 4-4 4M8 12h10"/></symbol>
  </svg>
  <div class="store-nav__inner">
    <button type="button" class="store-nav__round store-nav__mobile-toggle" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="storeMobileMenu"><span></span><span></span><span></span></button>
    <a href="/" class="store-nav__brand" aria-label="หน้าแรก <%= settings.shopName %>">
      <% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName %>" /><% } else { %><span class="store-nav__logo-fallback">L</span><% } %>
      <strong><%= settings.shopName %></strong>
    </a>
    <nav class="store-nav__links" aria-label="เมนูหลัก">
      <a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'is-active' : '' %>"><svg><use href="#ui-home"/></svg> หน้าแรก</a>
      <a href="/products" class="<%= typeof currentPath !== 'undefined' && currentPath === '/products' ? 'is-active' : '' %>"><svg><use href="#ui-box"/></svg> สินค้าทั้งหมด</a>
      <details class="store-nav__category">
        <summary class="store-nav__category-link" aria-label="เปิดเมนูหมวดหมู่"><svg><use href="#ui-grid"/></svg> หมวดหมู่ <span>⌄</span></summary>
        <div class="store-nav__category-menu">
          <a href="/products" class="store-nav__category-all"><svg><use href="#ui-box"/></svg><span><b>สินค้าทั้งหมด</b><small>ดูสินค้าทุกประเภท</small></span></a>
          <% (typeof navFilterTags !== 'undefined' ? navFilterTags : []).slice(0, 10).forEach(tag => { %>
            <a href="/products?tags=<%= encodeURIComponent(tag.id) %>">
              <% if (tag.image) { %><img src="<%= tag.image %>" alt="" loading="lazy" /><% } else { %><i><svg><use href="#ui-tag"/></svg></i><% } %>
              <span><b><%= tag.name %></b><small>ดูสินค้าในหมวดนี้</small></span>
            </a>
          <% }) %>
        </div>
      </details>
      <a href="/help"><svg><use href="#ui-book"/></svg> วิธีสั่งซื้อ</a>
      <a href="/contact"><svg><use href="#ui-phone"/></svg> ติดต่อเรา</a>
    </nav>
    <form action="/search" method="get" class="store-nav__search" role="search">
      <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ค้นหาสินค้า..." aria-label="ค้นหาสินค้า" /><button aria-label="ค้นหา"><svg><use href="#ui-search"/></svg></button>
    </form>
    <div class="store-nav__actions">
      <button id="theme-toggle-btn" type="button" title="สลับโหมดมืด/สว่าง" aria-label="สลับโหมดมืดและสว่าง" class="store-nav__round store-nav__theme"><span id="theme-toggle-icon"><svg class="theme-icon-moon"><use href="#ui-moon"/></svg><svg class="theme-icon-sun"><use href="#ui-sun"/></svg></span></button>
      <a href="/cart" class="store-nav__round store-nav__cart" aria-label="ตะกร้าสินค้า"><svg><use href="#ui-cart"/></svg><% if (cartCount > 0) { %><b><%= cartCount %></b><% } %></a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="store-nav__mobile-topup" aria-label="เติมเงิน"><svg><use href="#ui-wallet"/></svg><span>เติมเงิน</span></a>
        <a href="/account/topup" class="store-nav__desktop-topup" aria-label="เติมเงิน"><svg><use href="#ui-wallet"/></svg><span>เติมเงิน</span></a>
        <a href="/account/topup" class="store-nav__wallet" aria-label="ยอดเงิน ฿<%= currentUser.walletBalance.toLocaleString() %>"><span>฿<%= currentUser.walletBalance.toLocaleString() %></span><b>＋</b></a>
        <details class="store-nav__account">
          <summary><span class="store-nav__avatar"><%= (currentUser.username || 'U')[0].toUpperCase() %></span><span class="store-nav__account-name"><%= currentUser.username %></span><span class="store-nav__chevron">⌄</span></summary>
          <div class="store-nav__account-menu" <% if (settings.hero && settings.hero.bannerImage) { %>style="--account-menu-bg:url('<%= settings.hero.bannerImage %>')"<% } %>>
            <div class="store-nav__profile-card">
              <span class="store-nav__profile-avatar"><%= (currentUser.username || 'U')[0].toUpperCase() %></span>
              <span><strong><%= currentUser.username %></strong><small><svg><use href="#ui-<%= currentUser.role === 'admin' ? 'shield' : 'user' %>"/></svg><%= currentUser.role === 'admin' ? 'ADMIN' : 'สมาชิก' %></small></span>
              <b><small>ยอดเงิน</small> ฿<%= currentUser.walletBalance.toLocaleString() %>.00</b>
            </div>
            <% if (currentUser.role === 'admin') { %><a href="/admin" class="store-nav__admin-link"><i><svg><use href="#ui-shield"/></svg></i><span><strong>จัดการหลังบ้าน</strong><small>สินค้า คำสั่งซื้อ และร้านค้า</small></span><em>→</em></a><% } %>
            <div class="store-nav__menu-group">
              <a href="/account"><i><svg><use href="#ui-user"/></svg></i><span>บัญชีของฉัน</span></a>
              <a href="/cart"><i><svg><use href="#ui-cart"/></svg></i><span>ตะกร้าสินค้า</span><% if (cartCount > 0) { %><em><%= cartCount %></em><% } %></a>
              <a href="/account/orders"><i><svg><use href="#ui-receipt"/></svg></i><span>คำสั่งซื้อของฉัน</span></a>
              <a href="/account/topup"><i><svg><use href="#ui-wallet"/></svg></i><span>เติมเงิน</span></a>
            </div>
            <div class="store-nav__menu-group store-nav__menu-group--support">
              <a href="/help"><i><svg><use href="#ui-help"/></svg></i><span>คู่มือการใช้งาน</span></a>
              <a href="/contact"><i><svg><use href="#ui-phone"/></svg></i><span>ติดต่อร้าน</span></a>
            </div>
            <a href="/logout" class="store-nav__logout"><i><svg><use href="#ui-logout"/></svg></i><span>ออกจากระบบ</span></a>
          </div>
        </details>
      <% } else { %>
        <a href="/register" class="store-nav__register"><svg><use href="#ui-user"/></svg> สมัครสมาชิก</a><a href="/login" class="store-nav__login"><svg><use href="#ui-user"/></svg> เข้าสู่ระบบ</a>
      <% } %>
    </div>
  </div>
  <aside class="store-nav__mobile-row" id="storeMobileMenu" aria-label="เมนูมือถือ">
    <header><a href="/" class="store-nav__drawer-brand"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt="" /><% } else { %><span>L</span><% } %><strong><%= settings.shopName %></strong></a><button type="button" class="store-nav__mobile-close" aria-label="ปิดเมนู">×</button></header>
    <form action="/search" method="get"><input type="search" name="q" placeholder="ค้นหาสินค้า..." /><button aria-label="ค้นหา"><svg><use href="#ui-search"/></svg></button></form>
    <nav><a href="/"><svg><use href="#ui-home"/></svg><span>หน้าหลัก</span></a><a href="/products"><svg><use href="#ui-grid"/></svg><span>หมวดหมู่สินค้า</span></a><a href="/products"><svg><use href="#ui-box"/></svg><span>สินค้าทั้งหมด</span></a><a href="/help"><svg><use href="#ui-book"/></svg><span>คู่มือการใช้งาน</span></a><% if (currentUser) { %><a href="/account/topup"><svg><use href="#ui-wallet"/></svg><span>เติมเงิน</span></a><a href="/cart"><svg><use href="#ui-cart"/></svg><span>ตะกร้า</span></a><% } %><a href="/contact"><svg><use href="#ui-phone"/></svg><span>ติดต่อเรา</span></a></nav>
    <% if (currentUser) { %><div class="store-nav__drawer-section"><b>ระบบสมาชิก</b></div><nav><a href="/account"><svg><use href="#ui-user"/></svg><span>จัดการโปรไฟล์</span></a><a href="/account/orders"><svg><use href="#ui-box"/></svg><span>สถานะคำสั่งซื้อ</span></a><% if (currentUser.role === 'admin') { %><a href="/admin"><svg><use href="#ui-shield"/></svg><span>จัดการหลังบ้าน</span></a><% } %><a href="/logout" class="store-nav__drawer-logout"><svg><use href="#ui-logout"/></svg><span>ออกจากระบบ</span></a></nav><% } else { %><div class="store-nav__drawer-auth"><a href="/login">เข้าสู่ระบบ</a><a href="/register">สมัครสมาชิก</a></div><% } %>
  </aside>
</header>
<script>(function(){const account=document.querySelector('.store-nav__account'),toggle=document.querySelector('.store-nav__mobile-toggle'),menu=document.getElementById('storeMobileMenu'),close=document.querySelector('.store-nav__mobile-close');if(!menu)return;const backdrop=document.createElement('button');backdrop.type='button';backdrop.className='store-nav__mobile-backdrop';backdrop.setAttribute('aria-label','ปิดเมนู');document.body.appendChild(backdrop);let lockedY=0;function unlockPage(){const body=document.body;if(!body.dataset.menuLocked)return;const y=Number(body.dataset.menuLocked)||0;body.style.position='';body.style.top='';body.style.left='';body.style.right='';body.style.width='';delete body.dataset.menuLocked;window.scrollTo(0,y)}function lockPage(){lockedY=window.scrollY||window.pageYOffset||0;const body=document.body;body.dataset.menuLocked=String(lockedY);body.style.position='fixed';body.style.top='-'+lockedY+'px';body.style.left='0';body.style.right='0';body.style.width='100%'}function closeMenu(){if(!toggle||!menu)return;menu.classList.remove('is-open');backdrop.classList.remove('is-open');toggle.classList.remove('is-open');toggle.setAttribute('aria-expanded','false');document.documentElement.classList.remove('store-menu-open');unlockPage()}function openMenu(){if(!toggle||!menu)return;lockPage();menu.scrollTop=0;backdrop.classList.add('is-open');menu.classList.add('is-open');toggle.classList.add('is-open');toggle.setAttribute('aria-expanded','true');document.documentElement.classList.add('store-menu-open')}if(toggle)toggle.addEventListener('click',function(event){event.stopPropagation();menu.classList.contains('is-open')?closeMenu():openMenu()});if(close)close.addEventListener('click',closeMenu);backdrop.addEventListener('click',closeMenu);menu.addEventListener('click',function(event){if(event.target.closest('a[href]'))closeMenu()});document.addEventListener('lilteam:page-unloading',closeMenu);document.addEventListener('lilteam:page-loaded',closeMenu);document.addEventListener('keydown',function(event){if(event.key==='Escape'){if(account)account.removeAttribute('open');closeMenu()}});document.addEventListener('click',function(event){if(account&&account.open&&!account.contains(event.target))account.removeAttribute('open')});window.addEventListener('pagehide',closeMenu);})();</script>
<script>(function(){const category=document.querySelector('.store-nav__category'),account=document.querySelector('.store-nav__account');if(!category)return;category.querySelector('summary')?.addEventListener('click',()=>{if(account)account.removeAttribute('open')});document.addEventListener('click',event=>{if(category.open&&!category.contains(event.target))category.removeAttribute('open')});document.addEventListener('keydown',event=>{if(event.key==='Escape')category.removeAttribute('open')});})();</script>
