<header class="bg-[#100e08]/90 backdrop-blur border-b border-[#3a3220] sticky top-0 z-50">
  <div class="w-full max-w-[1800px] px-4 lg:w-[85%] lg:px-0 mx-auto py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-bold text-xl shrink-0">
      <span class="bg-[#c8a63f] text-[#100e08] w-9 h-9 rounded-lg flex items-center justify-center">L</span>
      <span><%= settings.shopName %></span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 text-sm text-[#d6c9a0]">
      <a href="/" class="hover:text-[#c8a63f]">หน้าแรก</a>
      <a href="/help" class="hover:text-[#c8a63f]">วิธีใช้งาน</a>
      <a href="/contact" class="hover:text-[#c8a63f]">ติดต่อร้าน</a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="hover:text-[#c8a63f]">เติมเงิน</a>
      <% } %>
    </nav>

    <form action="/search" method="get" class="hidden md:flex flex-1 max-w-xs">
      <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ค้นหาเกม..."
        class="w-full bg-[#211c11] border border-[#443a22] rounded-l-lg px-3 py-2 text-sm focus:outline-none focus:border-[#c8a63f]" />
      <button class="bg-[#332b1a] hover:bg-[#4a3f26] border border-[#443a22] border-l-0 rounded-r-lg px-3 text-sm text-[#c8a63f]">🔍</button>
    </form>

    <div class="flex items-center gap-3 text-sm shrink-0">
      <a href="/cart" class="relative hover:text-[#c8a63f]">
        ตะกร้า
        <% if (cartCount > 0) { %>
          <span class="absolute -top-2 -right-3 bg-[#e2836f] text-[#100e08] text-[10px] rounded-full px-1.5 py-0.5"><%= cartCount %></span>
        <% } %>
      </a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="hidden sm:flex items-center gap-1.5 bg-[#211c11] hover:bg-[#2b2416] border border-[#443a22] hover:border-[#c8a63f]/50 rounded-full pl-3 pr-1.5 py-1 text-[#d6c9a0] transition-colors">
          <span>💰 <%= currentUser.walletBalance.toLocaleString() %> ฿</span>
          <span class="bg-[#c8a63f] text-[#100e08] w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold">+</span>
        </a>
        <div class="relative group">
          <button class="hover:text-[#c8a63f]"><%= currentUser.username %> ▾</button>
          <div class="absolute right-0 mt-1 w-44 bg-[#211c11] border border-[#443a22] rounded-lg shadow-xl hidden group-hover:block">
            <a href="/account" class="block px-4 py-2 hover:bg-[#2b2416] text-sm rounded-t-lg">บัญชีของฉัน</a>
            <a href="/account/orders" class="block px-4 py-2 hover:bg-[#2b2416] text-sm">คำสั่งซื้อของฉัน</a>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="block px-4 py-2 hover:bg-[#2b2416] text-sm">ระบบหลังบ้าน</a>
            <% } %>
            <a href="/logout" class="block px-4 py-2 hover:bg-[#2b2416] text-sm text-[#e2836f] rounded-b-lg">ออกจากระบบ</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="bg-[#332b1a] hover:bg-[#4a3f26] px-3 py-1.5 rounded-lg text-[#d6c9a0]">เข้าสู่ระบบ</a>
        <a href="/register" class="bg-[#c8a63f] hover:bg-[#d9bc5e] text-[#100e08] font-medium px-3 py-1.5 rounded-lg">สมัครสมาชิก</a>
      <% } %>
    </div>
  </div>
</header>
