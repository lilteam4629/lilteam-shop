<header class="relative bg-[var(--bg)]/90 backdrop-blur border-b border-[var(--border)] sticky top-0 z-50 mb-6 sm:mb-0">
  <div class="w-full max-w-[1800px] px-3 sm:px-4 lg:w-[85%] lg:px-0 mx-auto py-3 flex items-center justify-between gap-2 sm:gap-4">
    <a href="/" class="flex items-center gap-2 font-bold text-base sm:text-xl min-w-0 shrink">
      <% if (settings.branding && settings.branding.logoImage) { %>
        <img src="<%= settings.branding.logoImage %>" alt="โลโก้ <%= settings.shopName %>" class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-xl object-contain bg-white/5 border border-[var(--border-light)]" />
      <% } else { %>
        <span class="bg-[var(--gold)] text-[var(--bg)] w-9 h-9 rounded-lg flex items-center justify-center">L</span>
      <% } %>
      <span class="truncate max-w-[145px] sm:max-w-none"><%= settings.shopName %></span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 text-sm text-[var(--text-2)]">
      <a href="/" class="hover:text-[var(--gold)]">หน้าแรก</a>
      <a href="/help" class="hover:text-[var(--gold)]">วิธีใช้งาน</a>
      <a href="/contact" class="hover:text-[var(--gold)]">ติดต่อร้าน</a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="hover:text-[var(--gold)]">เติมเงิน</a>
      <% } %>
    </nav>

    <form action="/search" method="get" class="hidden md:flex flex-1 max-w-xs">
      <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ค้นหาเกม..."
        class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-l-lg px-3 py-2 text-sm focus:outline-none focus:border-[var(--gold)]" />
      <button class="bg-[#332b1a] hover:bg-[#4a3f26] border border-[var(--border-light)] border-l-0 rounded-r-lg px-3 text-sm text-[var(--gold)]">🔍</button>
    </form>

    <div class="flex items-center gap-1.5 sm:gap-3 text-sm shrink-0">
      <button id="theme-toggle-btn" type="button" title="สลับโหมดมืด/สว่าง"
        class="w-9 h-9 shrink-0 rounded-full bg-[var(--input)] border border-[var(--border-light)] hover:border-[var(--gold)]/60 flex items-center justify-center transition">
        <span id="theme-toggle-icon">🌙</span>
      </button>
      <a href="/cart" aria-label="ตะกร้าสินค้า<%= cartCount > 0 ? ` ${cartCount} รายการ` : '' %>"
        class="h-9 inline-flex items-center gap-1.5 rounded-full bg-[var(--input)] border border-[var(--border-light)] hover:border-[var(--gold)]/70 hover:text-[var(--gold)] px-2.5 transition-colors whitespace-nowrap">
        <span class="text-base leading-none" aria-hidden="true">🛒</span>
        <span class="hidden sm:inline">ตะกร้า</span>
        <% if (cartCount > 0) { %>
          <span class="min-w-5 h-5 px-1.5 inline-flex items-center justify-center bg-[var(--coral)] text-white text-[10px] font-bold rounded-full shadow-[0_0_10px_rgba(226,131,111,.35)]"><%= cartCount %></span>
        <% } %>
      </a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="hidden sm:flex items-center gap-1.5 bg-[var(--input)] hover:bg-[#2b2416] border border-[var(--border-light)] hover:border-[var(--gold)]/50 rounded-full pl-3 pr-1.5 py-1 text-[var(--text-2)] transition-colors">
          <span>💰 <%= currentUser.walletBalance.toLocaleString() %> ฿</span>
          <span class="bg-[var(--gold)] text-[var(--bg)] w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold">+</span>
        </a>
        <div class="relative group min-w-0">
          <button aria-label="เมนูบัญชี <%= currentUser.username %>" class="w-9 sm:w-auto sm:max-w-[150px] h-9 sm:h-auto flex items-center justify-center sm:justify-start gap-0.5 rounded-full sm:rounded-none bg-[var(--input)] sm:bg-transparent border sm:border-0 border-[var(--border-light)] hover:text-[var(--gold)]">
            <span class="sm:hidden" aria-hidden="true">👤</span>
            <span class="hidden sm:inline truncate"><%= currentUser.username %></span><span class="shrink-0">▾</span>
          </button>
          <div class="absolute right-0 mt-1 w-44 bg-[var(--input)] border border-[var(--border-light)] rounded-lg shadow-xl hidden group-hover:block group-focus-within:block">
            <a href="/account/topup" class="block px-4 py-2 hover:bg-[#2b2416] text-sm text-[var(--gold)] rounded-t-lg">💰 เติมเงิน</a>
            <a href="/account" class="block px-4 py-2 hover:bg-[#2b2416] text-sm">บัญชีของฉัน</a>
            <a href="/account/orders" class="block px-4 py-2 hover:bg-[#2b2416] text-sm">คำสั่งซื้อของฉัน</a>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="block px-4 py-2 hover:bg-[#2b2416] text-sm">ระบบหลังบ้าน</a>
            <% } %>
            <a href="/logout" class="block px-4 py-2 hover:bg-[#2b2416] text-sm text-[var(--coral)] rounded-b-lg">ออกจากระบบ</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" aria-label="เข้าสู่ระบบหรือสมัครสมาชิก" title="เข้าสู่ระบบ / สมัครสมาชิก"
          class="sm:hidden w-9 h-9 shrink-0 rounded-full bg-[var(--input)] border border-[var(--border-light)] hover:border-[var(--gold)]/60 flex items-center justify-center transition">👤</a>
        <a href="/login" class="hidden sm:inline-flex bg-[#332b1a] hover:bg-[#4a3f26] px-3 py-1.5 rounded-lg text-[var(--text-2)]">เข้าสู่ระบบ</a>
        <a href="/register" class="hidden sm:inline-flex bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-medium px-3 py-1.5 rounded-lg">สมัครสมาชิก</a>
      <% } %>
    </div>
  </div>
  <div class="sm:hidden absolute left-1/2 -bottom-[21px] -translate-x-1/2 w-[calc(100%_-_2.5rem)] max-w-[310px] h-10 flex items-center rounded-full bg-[var(--card)] backdrop-blur-xl border border-[#76632d]/70 ring-4 ring-[var(--bg)] shadow-[0_10px_26px_rgba(0,0,0,.5),0_0_16px_rgba(200,166,63,.08)] overflow-hidden">
    <a href="/account/topup" class="flex-1 h-full flex items-center justify-center gap-2 text-[var(--gold-hover)] font-semibold text-sm active:bg-[var(--gold)]/10 transition-colors">
      <span class="w-6 h-6 rounded-full bg-[var(--gold)]/15 flex items-center justify-center text-xs" aria-hidden="true">💰</span><span>เติมเงิน</span>
    </a>
    <span class="w-px h-5 bg-[var(--border-light)]" aria-hidden="true"></span>
    <a href="/contact" class="flex-1 h-full flex items-center justify-center gap-2 text-[var(--text-2)] font-medium text-sm active:bg-white/5 transition-colors">
      <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-xs" aria-hidden="true">💬</span><span>ติดต่อร้าน</span>
    </a>
  </div>
</header>
