<header class="new-nav" id="storefront-navigation">
  <div class="new-nav__utility"><span>ลิลทีมช็อป · สินค้าดิจิทัลคัดจากสต๊อกจริง</span><span><%= settings.openHours || 'เปิดให้บริการ 24 ชั่วโมง' %></span></div>
  <div class="new-nav__bar">
    <button type="button" class="new-nav__menu" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="new-mobile-menu"><span></span><span></span><span></span></button>
    <a href="/" class="new-nav__brand" aria-label="หน้าแรก <%= settings.shopName %>">
      <span class="new-nav__mark"><% if (settings.branding && settings.branding.logoImage) { %><img src="<%= settings.branding.logoImage %>" alt=""><% } else { %><%= (settings.shopName || 'L')[0] %><% } %></span>
      <span><strong><%= settings.shopName %></strong><small>verified game drops</small></span>
    </a>
    <nav class="new-nav__links" aria-label="เมนูหลัก">
      <a href="/" class="<%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'is-active' : '' %>">หน้าหลัก</a><a href="/products" class="<%= (typeof currentPath !== 'undefined' && currentPath === '/products') ? 'is-active' : '' %>">สินค้า</a><a href="/help">วิธีสั่งซื้อ</a><a href="/contact">ติดต่อร้าน</a>
    </nav>
    <form action="/search" method="get" class="new-nav__search" role="search"><span aria-hidden="true">⌕</span><input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ค้นหาสินค้า" aria-label="ค้นหาสินค้า"><button aria-label="ค้นหา">↵</button></form>
    <div class="new-nav__actions">
      <button id="theme-toggle-btn" type="button" title="สลับโหมดมืด/สว่าง" aria-label="สลับโหมดมืดและสว่าง" class="new-nav__icon"><span id="theme-toggle-icon">◐</span></button>
      <a href="/cart" class="new-nav__cart" aria-label="ตะกร้าสินค้า">ตะกร้า<% if (cartCount > 0) { %><b><%= cartCount %></b><% } %></a>
      <% if (currentUser) { %>
        <a href="/account/topup" class="new-nav__balance" aria-label="ยอดเงิน ฿<%= currentUser.walletBalance.toLocaleString() %>">฿<%= currentUser.walletBalance.toLocaleString() %><span>เติมเงิน</span></a>
        <details class="new-nav__account">
          <summary><span class="new-nav__avatar"><%= (currentUser.username || 'U')[0].toUpperCase() %></span><span class="new-nav__user"><%= currentUser.username %></span><span>⌄</span></summary>
          <div class="new-nav__account-menu">
            <strong><%= currentUser.username %></strong><small><%= currentUser.role === 'admin' ? 'ผู้ดูแลระบบ' : 'สมาชิก' %></small>
            <a href="/account">บัญชีของฉัน</a><a href="/account/orders">คำสั่งซื้อ</a><a href="/account/topup">เติมเงิน</a>
            <% if (currentUser.role === 'admin') { %><a href="/admin">เปิดหลังบ้าน</a><% } %>
            <a href="/logout">ออกจากระบบ</a>
          </div>
        </details>
      <% } else { %>
        <a href="/login" class="new-nav__login">เข้าสู่ระบบ</a><a href="/register" class="new-nav__signup">สมัครสมาชิก</a>
      <% } %>
    </div>
  </div>
  <aside class="new-nav__mobile" id="new-mobile-menu" aria-label="เมนูมือถือ">
    <div class="new-nav__mobile-head"><a href="/" class="new-nav__brand"><span class="new-nav__mark"><%= (settings.shopName || 'L')[0] %></span><strong><%= settings.shopName %></strong></a><button type="button" class="new-nav__mobile-close" aria-label="ปิดเมนู">×</button></div>
    <form action="/search" method="get" class="new-nav__mobile-search"><input name="q" type="search" placeholder="ค้นหาสินค้า"><button>ค้นหา</button></form>
    <nav><a href="/">หน้าหลัก</a><a href="/products">สินค้าทั้งหมด</a><a href="/help">วิธีสั่งซื้อ</a><a href="/contact">ติดต่อร้าน</a><% if (currentUser) { %><a href="/account">บัญชีของฉัน</a><a href="/account/topup">เติมเงิน</a><a href="/account/orders">คำสั่งซื้อ</a><% } else { %><a href="/login">เข้าสู่ระบบ</a><a href="/register">สมัครสมาชิก</a><% } %></nav>
  </aside>
</header>
<script>
(function(){
  const root=document.documentElement,menu=document.querySelector('.new-nav__menu'),panel=document.getElementById('new-mobile-menu'),close=document.querySelector('.new-nav__mobile-close'),account=document.querySelector('.new-nav__account');
  function closeMenu(){panel?.classList.remove('is-open');menu?.setAttribute('aria-expanded','false');root.classList.remove('new-menu-open')}
  function openMenu(){panel?.classList.add('is-open');menu?.setAttribute('aria-expanded','true');root.classList.add('new-menu-open')}
  if(menu) menu.addEventListener('click',()=>panel?.classList.contains('is-open')?closeMenu():openMenu());close?.addEventListener('click',closeMenu);panel?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();account?.removeAttribute('open')}})
})();
</script>
