<section class="drop-preview">
  <div class="drop-shell">
    <div class="drop-preview-bar"><span><i></i> ตัวอย่าง NEO STREET DROP — เห็นเฉพาะแอดมิน</span><a href="/admin/appearance">กลับหลังบ้าน</a></div>
    <% if (newest.length) { const featured=newest[0]; const total=Math.min(5,newest.length); %>
    <div id="drop-stage" class="drop-stage">
      <div class="drop-copy">
        <div><span class="drop-eyebrow">LILTEAM / NEW RELEASE</span><h1><em>DROP</em><br>ประจำวันนี้</h1><p>สินค้าเกมฟุตบอลคัดพิเศษ<br>พร้อมส่งและตรวจสอบได้ทันที</p></div>
        <div class="drop-filters"><a class="active" href="/products">ทั้งหมด</a><% (filterTags||[]).slice(0,3).forEach(tag=>{ %><a href="/products?tags=<%= tag.id %>"><%= tag.name %></a><% }) %></div>
        <a href="/products" class="drop-see-all">ดูสินค้าทั้งหมด <b>↗</b></a>
      </div>
      <div class="drop-showcase">
        <div class="drop-number">01</div><span class="drop-flash">⚡ FLASH DROP</span>
        <a id="drop-image-link" class="drop-card" href="/game/<%= featured.slug %>"><img id="drop-image" src="<%= featured.images[0] %>" alt="<%= featured.title %>"></a>
        <% if(newest[1]){ %><button type="button" class="drop-peek" data-drop-index="1" aria-label="ดูสินค้าถัดไป"><img src="<%= newest[1].images[0] %>" alt=""><span>›</span></button><% } %>
        <div class="drop-progress"><b id="drop-current">01</b><span><i id="drop-progress-fill" style="width:<%= 100/total %>%"></i></span><small><%= String(total).padStart(2,'0') %></small></div>
      </div>
      <aside class="drop-buy-panel">
        <span class="drop-panel-label">FEATURED PRODUCT</span>
        <div><span id="drop-status" class="drop-status <%= featured.stockCount>0?'':'is-out' %>"><i></i><%= featured.stockCount>0?'พร้อมส่ง':'สินค้าหมด' %></span><h2 id="drop-title"><%= featured.title %></h2><p>สินค้าพร้อมใช้งานจาก LILTeam Shop</p></div>
        <div class="drop-purchase"><div class="drop-facts"><span><small>ราคาสินค้า</small><strong id="drop-price">฿<%= featured.price.toLocaleString() %>.00</strong></span><span><small>คงเหลือ</small><strong><b id="drop-stock"><%= featured.stockCount %></b> ชิ้น</strong></span></div><a id="drop-buy" href="/game/<%= featured.slug %>">เลือกซื้อสินค้า <b>↗</b></a><small class="drop-safe">✓ ชำระเงินปลอดภัย &nbsp; ✓ ตรวจสอบคำสั่งซื้อได้</small></div>
      </aside>
      <nav class="drop-rail" aria-label="เลือกสินค้า"><% newest.slice(0,5).forEach((p,index)=>{ %><button type="button" class="drop-choice <%= index===0?'active':'' %>" data-image="<%= p.images[0] %>" data-title="<%= p.title %>" data-price="<%= p.price %>" data-stock="<%= p.stockCount %>" data-slug="<%= p.slug %>" data-index="<%= index %>"><span><%= String(index+1).padStart(2,'0') %></span><img src="<%= p.images[0] %>" alt=""><small><%= p.title %></small></button><% }) %></nav>
    </div>
    <% } else { %><div class="drop-empty">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
  </div>
</section>
<style>
.drop-preview{--pink:#f124aa;--gold:#d6af52;--lime:#b8f34a;overflow:hidden;border-bottom:1px solid var(--border);background:#080a09;color:#f5eee3}.drop-shell{width:min(96%,1800px);margin:auto;padding:1rem 0 2rem}.drop-preview-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.75rem;border:1px solid #d6af5247;border-radius:.8rem;background:#d6af5212;padding:.65rem .85rem;color:#ceb77d;font-size:.72rem}.drop-preview-bar span{display:flex;align-items:center;gap:.45rem}.drop-preview-bar i{width:.45rem;height:.45rem;border-radius:50%;background:var(--lime);box-shadow:0 0 12px var(--lime)}.drop-preview-bar a{border:1px solid #d6af5247;border-radius:.55rem;padding:.35rem .65rem;white-space:nowrap}
.drop-stage{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(16rem,.78fr) minmax(25rem,1.25fr) minmax(18rem,.8fr);grid-template-rows:minmax(38rem,74vh) auto;overflow:hidden;border:1px solid #d6af5259;border-radius:1.15rem;background:radial-gradient(circle at 52% 45%,#f124aa1f,transparent 28%),repeating-linear-gradient(115deg,transparent 0 31px,#ffffff06 32px 33px),linear-gradient(115deg,#0b0e0c,#080a09 56%,#11100c);box-shadow:0 28px 90px #0007}.drop-copy{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,4vw,4.5rem) clamp(1.5rem,3vw,3.5rem)}.drop-eyebrow,.drop-panel-label{color:var(--gold);font-size:.58rem;font-weight:800;letter-spacing:.22em}.drop-copy h1{margin:2rem 0 1rem;font-size:clamp(3.4rem,6.2vw,7.2rem);font-weight:950;line-height:.78;letter-spacing:-.075em}.drop-copy h1 em{color:var(--pink);font-style:italic;text-shadow:3px 3px 0 #d6af5247}.drop-copy p{color:#aaa499;font-size:.78rem;line-height:1.75}.drop-filters{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:auto;padding-top:2rem}.drop-filters a{border:1px solid #302f2b;border-radius:999px;padding:.48rem .72rem;color:#98948c;font-size:.58rem}.drop-filters a.active,.drop-filters a:hover{border-color:var(--pink);color:#fff}.drop-see-all{display:flex;align-items:center;justify-content:space-between;width:min(100%,15rem);margin-top:1.1rem;border:1px solid #d6af528c;padding:.75rem .9rem;color:#eee6d8;font-size:.68rem}.drop-see-all b{color:var(--gold);font-size:1rem}
.drop-showcase{position:relative;display:grid;place-items:center;min-width:0;border-inline:1px solid #d6af522e}.drop-showcase:before,.drop-showcase:after{content:'';position:absolute;border:1px solid #f124aa33;border-radius:50%;width:min(78%,34rem);aspect-ratio:1}.drop-showcase:after{width:min(58%,24rem);border-color:#d6af5224}.drop-number{position:absolute;top:2%;left:4%;z-index:-1;color:#f124aa0e;font-size:19rem;font-weight:950;line-height:1}.drop-flash{position:absolute;z-index:5;top:7%;right:6%;transform:rotate(3deg);background:var(--pink);padding:.58rem .85rem;color:#fff;font-size:.62rem;font-weight:900;box-shadow:5px 5px 0 var(--gold)}.drop-card{position:relative;z-index:2;display:block;width:min(66%,23rem);transition:transform .22s,opacity .15s;filter:drop-shadow(0 30px 28px #000a)}.drop-card:hover{transform:translateY(-5px) rotate(-.5deg)}.drop-card img{display:block;width:100%;max-height:31rem;aspect-ratio:3/4;object-fit:contain}.drop-card.is-changing{opacity:.2;transform:scale(.97)}.drop-peek{position:absolute;z-index:4;right:-8%;display:flex;align-items:center;width:26%;height:62%;overflow:hidden;border:1px solid #d6af5261;border-radius:.8rem 0 0 .8rem;background:#12140f;box-shadow:-18px 0 35px #0007}.drop-peek img{width:100%;height:100%;object-fit:contain;opacity:.62}.drop-peek span{position:absolute;left:.7rem;display:grid;width:2.2rem;height:2.2rem;place-items:center;border-radius:50%;background:#080a09;color:#fff;font-size:1.6rem}.drop-progress{position:absolute;bottom:4%;left:9%;right:9%;z-index:5;display:flex;align-items:center;gap:.8rem;color:#827d74;font-size:.6rem}.drop-progress b{color:var(--pink);font-size:1rem}.drop-progress>span{height:3px;flex:1;overflow:hidden;background:#292b29}.drop-progress i{display:block;height:100%;background:var(--pink);transition:width .2s}
.drop-buy-panel{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,3.2vw,3.7rem) clamp(1.4rem,2.6vw,2.8rem);background:linear-gradient(#13130f4d,#d6af520a)}.drop-status{display:inline-flex;align-items:center;gap:.4rem;margin-bottom:1rem;border:1px solid #b8f34a4d;border-radius:999px;padding:.38rem .65rem;color:var(--lime);font-size:.59rem;font-weight:700}.drop-status i{width:.38rem;height:.38rem;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}.drop-status.is-out{border-color:#ee696059;color:#ee6960}.drop-buy-panel h2{font-size:clamp(1.6rem,2.5vw,3rem);font-weight:900;line-height:1.06;letter-spacing:-.04em;overflow-wrap:anywhere}.drop-buy-panel>div>p{margin-top:.8rem;color:#8f8a81;font-size:.68rem}.drop-facts{display:grid;grid-template-columns:1fr auto;align-items:end;gap:1rem;border-top:1px solid #343229;padding-top:1.2rem}.drop-facts span:last-child{text-align:right}.drop-facts small{display:block;margin-bottom:.35rem;color:#827d74;font-size:.56rem}.drop-facts strong{color:#f6eee0;font-size:.78rem}.drop-facts span:first-child strong{color:var(--gold);font-size:clamp(1.8rem,2.7vw,3rem);font-weight:950}.drop-buy{display:flex;align-items:center;justify-content:space-between;margin-top:1.25rem;background:var(--pink);padding:.92rem 1rem;color:white;font-size:.75rem;font-weight:900;box-shadow:5px 5px 0 #d6af52cc}.drop-safe{display:block;margin-top:1rem;color:#77736c;font-size:.49rem}
.drop-rail{grid-column:1/4;display:flex;overflow-x:auto;border-top:1px solid #d6af5240;scrollbar-width:none}.drop-choice{display:grid;grid-template-columns:auto 2.5rem minmax(5rem,1fr);align-items:center;gap:.6rem;min-width:12rem;flex:1;border-right:1px solid #282823;padding:.65rem .8rem;color:#77736c;text-align:left}.drop-choice img{width:2.5rem;height:3rem;object-fit:contain}.drop-choice small{overflow:hidden;color:#a39e94;font-size:.52rem;text-overflow:ellipsis;white-space:nowrap}.drop-choice.active{background:#f124aa17;color:var(--pink)}.drop-choice.active small{color:#fff}.drop-empty{border:1px dashed var(--border);border-radius:1rem;padding:4rem;text-align:center;color:var(--text-4)}
@media(max-width:1050px){.drop-stage{grid-template-columns:.8fr 1.2fr;grid-template-rows:auto minmax(34rem,65vh) auto auto}.drop-copy{grid-column:1/3;display:grid;grid-template-columns:1fr auto;align-items:end;gap:1rem;padding:2rem}.drop-copy h1{font-size:4rem}.drop-copy p,.drop-see-all{display:none}.drop-filters{justify-content:flex-end;padding:0}.drop-buy-panel{grid-column:2}.drop-rail{grid-column:1/3}}
@media(max-width:650px){.drop-shell{width:100%;padding:.65rem}.drop-preview-bar{font-size:.6rem}.drop-stage{display:flex;flex-direction:column}.drop-copy{display:block;padding:1.4rem 1.1rem .85rem}.drop-copy h1{margin:.8rem 0 .55rem;font-size:3.05rem}.drop-copy h1 br{display:none}.drop-copy p{display:block;font-size:.63rem}.drop-filters{margin-top:.8rem;padding:0;justify-content:flex-start;flex-wrap:nowrap;overflow:auto}.drop-filters a{white-space:nowrap}.drop-showcase{order:2;min-height:25rem;border:0;border-block:1px solid #d6af522e}.drop-number{font-size:10rem}.drop-card{width:min(58%,13.5rem)}.drop-card img{max-height:20rem}.drop-flash{top:5%;font-size:.53rem}.drop-peek{right:-12%;height:52%;width:30%}.drop-buy-panel{order:3;padding:1.25rem 1.1rem;gap:1.6rem}.drop-panel-label{display:none}.drop-buy-panel h2{font-size:1.55rem}.drop-buy-panel>div>p{margin-top:.4rem}.drop-facts span:first-child strong{font-size:2rem}.drop-rail{order:4;width:100%}.drop-choice{min-width:8.5rem;grid-template-columns:auto 2rem;gap:.45rem;padding:.55rem}.drop-choice img{width:2rem;height:2.5rem}.drop-choice small{grid-column:1/3}.drop-safe{font-size:.46rem}}
</style>
<script>
(function(){const root=document.getElementById('drop-stage');if(!root)return;const choices=[...root.querySelectorAll('.drop-choice')],card=root.querySelector('.drop-card'),image=document.getElementById('drop-image'),title=document.getElementById('drop-title'),price=document.getElementById('drop-price'),stock=document.getElementById('drop-stock'),status=document.getElementById('drop-status'),current=document.getElementById('drop-current'),fill=document.getElementById('drop-progress-fill'),buy=document.getElementById('drop-buy'),imageLink=document.getElementById('drop-image-link'),peek=root.querySelector('.drop-peek');function select(index){const btn=choices[index];if(!btn)return;choices.forEach(x=>x.classList.remove('active'));btn.classList.add('active');card.classList.add('is-changing');setTimeout(()=>{image.src=btn.dataset.image;image.alt=btn.dataset.title;title.textContent=btn.dataset.title;price.textContent='฿'+Number(btn.dataset.price).toLocaleString()+'.00';stock.textContent=btn.dataset.stock;current.textContent=String(index+1).padStart(2,'0');fill.style.width=((index+1)/choices.length*100)+'%';const ok=Number(btn.dataset.stock)>0;status.className='drop-status'+(ok?'':' is-out');status.innerHTML='<i></i>'+(ok?'พร้อมส่ง':'สินค้าหมด');buy.href=imageLink.href='/game/'+btn.dataset.slug;card.classList.remove('is-changing')},130)}choices.forEach((btn,index)=>btn.addEventListener('click',()=>select(index)));if(peek)peek.addEventListener('click',()=>select(1));let startX=0,show=root.querySelector('.drop-showcase');show.addEventListener('touchstart',e=>startX=e.changedTouches[0].clientX,{passive:true});show.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)<45)return;const active=choices.findIndex(x=>x.classList.contains('active'));select(dx<0?(active+1)%choices.length:(active-1+choices.length)%choices.length)},{passive:true})})();
</script>
