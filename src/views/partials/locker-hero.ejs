<section class="locker-hero border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[88%] lg:px-0 lg:py-7">
    <% if (!publicPreview) { %><div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]"><span>👁️ โหมดทดลอง — หน้านี้เห็นได้เฉพาะแอดมิน ยังไม่กระทบหน้าร้านจริง</span><a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1 hover:bg-[var(--gold)]/10">กลับหลังบ้าน</a></div><% } %>
    <div class="draft-hero overflow-hidden rounded-2xl border border-[var(--border)]" data-draft><header class="draft-heading"><span>LIVE PLAYER DRAFT</span><h1>สุ่มการ์ด <em>ค้นหาตัวที่ใช่</em></h1><p>เลือกดูทีละใบ หรือกดสุ่มให้ระบบค้นหาสินค้าเด่นให้คุณ</p></header><div class="draft-arena"><div class="draft-deck"><% newest.slice(0,5).forEach((p,index)=>{ %><a href="/game/<%= p.slug %>" class="draft-card" data-draft-card="<%= index %>" aria-label="ดูสินค้า <%= p.title %>"><span class="draft-number">0<%= index + 1 %></span><span class="draft-ready">● พร้อมส่ง</span><img src="<%= p.images[0] %>" alt="<%= p.title %>"><span class="draft-info"><strong><%= p.title %></strong><small>฿<%= p.price.toLocaleString() %>.00</small><i>เลือกสินค้านี้ ↗</i></span></a><% }) %><div class="draft-burst" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div><div class="draft-controls"><button type="button" data-draft-prev aria-label="สินค้าก่อนหน้า">←</button><button type="button" class="draft-random" data-draft-random><span>✦</span> สุ่มนักเตะให้ฉัน</button><button type="button" data-draft-next aria-label="สินค้าถัดไป">→</button></div><div class="draft-dots" aria-label="ตำแหน่งสินค้า"><% newest.slice(0,5).forEach((p,index)=>{ %><button type="button" data-draft-dot="<%= index %>" aria-label="เลือกสินค้า <%= index + 1 %>"></button><% }) %></div></div></div>
  </div>
</section>
