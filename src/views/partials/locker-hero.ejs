<section class="locker-hero border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[88%] lg:px-0 lg:py-7">
    <div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]"><span>👁️ โหมดทดลอง — หน้านี้เห็นได้เฉพาะแอดมิน ยังไม่กระทบหน้าร้านจริง</span><a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1 hover:bg-[var(--gold)]/10">กลับหลังบ้าน</a></div>
    <div class="locker-room overflow-hidden rounded-2xl border border-white/10">
      <div class="locker-copy"><div><span class="locker-kicker">LILTEAM LOCKER ROOM</span><h1>เลือกล็อกเกอร์<br>ค้นหานักเตะ<br><em>ที่ใช่สำหรับคุณ</em></h1><p>นักเตะหลากหลาย รอคุณอยู่ที่นี่ เลือกสินค้าที่ชอบได้ในที่เดียว</p><a href="/products" class="locker-cta">เปิดล็อกเกอร์เลย <span>→</span></a></div><div class="locker-trust"><div><b><%= stats.customerCount.toLocaleString() %></b><span>ผู้ใช้งานของเรา</span></div><div><b><%= stats.gameCount.toLocaleString() %></b><span>สินค้าพร้อมเลือก</span></div></div></div>
      <div class="locker-showcase"><% const lockerLabels=['สินค้าใหม่','ยอดนิยม','แนะนำ','ราคาพิเศษ']; %><% newest.slice(0,4).forEach((p,index)=>{ %><a href="/game/<%= p.slug %>" class="locker-bay group" aria-label="ดูสินค้า <%= p.title %>"><span class="locker-label"><%= lockerLabels[index] %></span><span class="locker-light"></span><span class="locker-hanger"><i></i></span><span class="locker-product"><img src="<%= p.images[0] %>" alt="<%= p.title %>"></span><span class="locker-product-info"><strong><%= p.title %></strong><small>฿<%= p.price.toLocaleString() %>.00</small></span><span class="locker-bench"></span></a><% }) %></div>
    </div>
  </div>
</section>
<style>
.locker-room{display:grid;grid-template-columns:minmax(17rem,30%) 1fr;min-height:33rem;background:var(--card);box-shadow:0 24px 70px -42px color-mix(in srgb,var(--gold) 38%,transparent)}.locker-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,4vw,4.5rem) clamp(1.5rem,3vw,3.4rem);background:linear-gradient(115deg,var(--card) 68%,color-mix(in srgb,var(--card) 88%,transparent));border-right:1px solid var(--border)}.locker-copy:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 15% 15%,color-mix(in srgb,var(--gold) 12%,transparent),transparent 38%)}.locker-copy>div{position:relative}.locker-kicker{display:inline-block;margin-bottom:1rem;color:var(--gold);font-size:.66rem;font-weight:800;letter-spacing:.2em}.locker-copy h1{font-size:clamp(2rem,3.3vw,4rem);font-weight:800;line-height:1.08;letter-spacing:-.035em;color:var(--text)}.locker-copy h1 em{font-style:normal;color:var(--gold)}.locker-copy p{max-width:28rem;margin-top:1.25rem;color:var(--text-3);font-size:.9rem;line-height:1.75}.locker-cta{display:inline-flex;align-items:center;gap:1.2rem;margin-top:1.7rem;padding:.8rem 1.15rem;border-radius:.65rem;background:var(--gold);color:var(--bg);font-size:.78rem;font-weight:800;box-shadow:0 10px 25px -15px var(--gold);transition:background .2s,transform .2s}.locker-cta:hover{background:var(--gold-hover);transform:translateY(-1px)}.locker-cta span{font-size:1.05rem}.locker-trust{display:flex;gap:1.6rem;margin-top:2rem}.locker-trust div{display:flex;flex-direction:column}.locker-trust b{font-size:1rem;color:var(--gold)}.locker-trust span{font-size:.58rem;color:var(--text-4)}
.locker-showcase{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:linear-gradient(180deg,var(--input),color-mix(in srgb,var(--bg) 72%,var(--card)))}.locker-bay{position:relative;display:flex;min-width:0;flex-direction:column;align-items:center;overflow:hidden;border-right:1px solid color-mix(in srgb,var(--gold) 24%,var(--border));background:linear-gradient(90deg,color-mix(in srgb,var(--bg) 24%,transparent),transparent 18%,transparent 82%,color-mix(in srgb,var(--bg) 28%,transparent));transition:background .25s}.locker-bay:last-child{border-right:0}.locker-bay:hover{background-color:color-mix(in srgb,var(--gold) 7%,transparent)}.locker-label{position:relative;z-index:4;height:3.1rem;padding-top:1.15rem;color:var(--text-2);font-size:.66rem;font-weight:600}.locker-light{position:absolute;z-index:1;top:2.75rem;left:50%;width:72%;height:.22rem;transform:translateX(-50%);border-radius:99px;background:var(--gold);box-shadow:0 2px 10px color-mix(in srgb,var(--gold) 72%,transparent),0 18px 55px 14px color-mix(in srgb,var(--gold) 15%,transparent)}.locker-hanger{position:relative;z-index:2;display:block;width:52%;height:2.3rem;margin-top:.75rem;border-bottom:2px solid color-mix(in srgb,var(--text-3) 65%,transparent)}.locker-hanger:before{content:'';position:absolute;left:50%;top:.25rem;width:.55rem;height:.55rem;border:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);border-bottom:0;border-radius:99px 99px 0 0;transform:translateX(-50%)}.locker-hanger i{position:absolute;left:50%;bottom:-.2rem;width:70%;height:1.35rem;border-left:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);border-right:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);transform:translateX(-50%) skewX(-35deg)}.locker-product{position:relative;z-index:3;display:block;width:min(76%,12rem);aspect-ratio:3/4;margin-top:-.2rem;filter:drop-shadow(0 14px 15px color-mix(in srgb,var(--bg) 72%,transparent));transition:transform .25s}.locker-product img{width:100%;height:100%;border:1px solid color-mix(in srgb,var(--gold) 25%,var(--border));border-radius:.55rem;object-fit:cover}.locker-bay:hover .locker-product{transform:translateY(-4px) scale(1.025)}.locker-product-info{position:relative;z-index:4;display:block;width:82%;margin-top:.65rem;text-align:center}.locker-product-info strong{display:block;overflow:hidden;color:var(--text);font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.locker-product-info small{display:block;margin-top:.25rem;color:var(--gold);font-size:.72rem;font-weight:800}.locker-bench{position:absolute;z-index:2;right:7%;bottom:1.4rem;left:7%;height:2.8rem;border-top:5px solid color-mix(in srgb,var(--gold) 42%,var(--border));background:linear-gradient(90deg,var(--bg),color-mix(in srgb,var(--gold) 12%,var(--input)) 50%,var(--bg));box-shadow:0 -8px 18px color-mix(in srgb,var(--gold) 7%,transparent),inset 0 1px color-mix(in srgb,var(--gold) 45%,transparent)}
@media(max-width:900px){.locker-room{grid-template-columns:1fr;min-height:0}.locker-copy{padding:2rem 1.5rem;border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}.locker-copy h1{font-size:2.2rem}.locker-copy p{font-size:.8rem}.locker-showcase{min-height:27rem}.locker-bench{bottom:1rem}}@media(max-width:560px){.locker-room{border-radius:1rem}.locker-copy{padding:1.5rem 1.15rem}.locker-copy h1{font-size:1.85rem}.locker-copy p{margin-top:.8rem;line-height:1.6}.locker-cta{width:100%;justify-content:center;margin-top:1.1rem}.locker-trust{margin-top:1.25rem}.locker-showcase{grid-template-columns:repeat(2,minmax(0,1fr));min-height:0}.locker-bay{min-height:20rem;border-bottom:1px solid rgba(207,167,61,.2)}.locker-bay:nth-child(2){border-right:0}.locker-label{height:2.7rem}.locker-light{top:2.35rem}.locker-product{width:min(68%,8rem)}.locker-product-info{margin-top:.4rem}.locker-bench{height:2.1rem;bottom:.7rem}}
.locker-hero{background:#070707!important}.locker-room{min-height:37rem;border-color:#5d4a32!important;border-radius:.65rem!important;background:#090909!important;box-shadow:0 28px 80px #000c}.locker-copy{padding:clamp(2.2rem,4vw,4.8rem) clamp(1.5rem,3.2vw,3.7rem);border-right:1px solid #4a3827;background:radial-gradient(circle at 15% 22%,#2a2116 0,transparent 38%),linear-gradient(115deg,#090909 70%,#100e0b)}.locker-copy:before{background:linear-gradient(90deg,transparent,#c2914120,transparent);opacity:.55}.locker-kicker{color:#d0a45d}.locker-copy h1{color:#f5f1e8;font-size:clamp(2rem,3vw,3.7rem);line-height:1.04}.locker-copy h1 em{color:#d7a947}.locker-copy p{max-width:20rem;color:#aaa397}.locker-cta{border-radius:999px;background:linear-gradient(135deg,#f0c452,#d79b2d);color:#17110a;box-shadow:0 12px 25px #d79b2d2e}.locker-cta:hover{background:#f4cd62}.locker-trust b{color:#e0b64e}.locker-trust span{color:#7e776d}.locker-showcase{position:relative;background:linear-gradient(180deg,#11100e,#090909 62%,#12100c)}.locker-showcase:before{content:'';position:absolute;z-index:1;top:0;right:0;left:0;height:2.1rem;background:linear-gradient(#201b14,#0c0b09);border-bottom:1px solid #5c442d;box-shadow:0 10px 25px #000}.locker-bay{border-right:4px solid #4b3826;background:radial-gradient(ellipse at 50% 18%,#d9a64d21,transparent 35%),linear-gradient(90deg,#0b0a08,#15120e 50%,#0a0908)}.locker-bay:last-child{border-right:0}.locker-bay:before{content:'';position:absolute;z-index:2;top:2rem;right:.35rem;bottom:0;left:.35rem;border-inline:1px solid #70513638;box-shadow:inset 0 0 30px #000}.locker-bay:hover{background-color:#17130d}.locker-label{height:4.4rem;padding-top:2.8rem;color:#d6c9b9;font-size:.7rem}.locker-light{top:3.7rem;width:58%;height:.18rem;background:#f0c56f;box-shadow:0 2px 9px #ffd581,0 16px 48px 17px #d79b2d24}.locker-hanger{height:2.5rem;margin-top:.55rem;border-color:#8b7256}.locker-hanger:before,.locker-hanger i{border-color:#8b7256}.locker-product{width:min(72%,12.5rem);margin-top:-.15rem;filter:drop-shadow(0 17px 14px #000c)}.locker-product img{border:1px solid #8e672e;border-radius:.35rem;object-fit:contain;background:#080808}.locker-product-info{margin-top:.55rem}.locker-product-info strong{color:#eee7dc}.locker-product-info small{color:#e2b04f}.locker-bench{right:3%;bottom:2.2rem;left:3%;height:3.4rem;border-top:7px solid #5a412a;background:linear-gradient(#261c12 0 22%,#0b0907 23% 100%);box-shadow:0 -10px 28px #d69b2b12,inset 0 1px #b7884b}.locker-bench:after{content:'';position:absolute;right:12%;bottom:-1.4rem;left:12%;height:1.5rem;border-inline:5px solid #3a2a1c}.locker-bay:nth-child(1):after,.locker-bay:nth-child(4):after{content:'';position:absolute;z-index:3;right:12%;bottom:2.8rem;width:2.8rem;height:1.25rem;border-radius:.25rem;background:linear-gradient(15deg,#1b2631,#395069);box-shadow:-1.2rem .15rem 0 #5a3422}.locker-bay:nth-child(4):after{background:#6b281f;box-shadow:-1rem .2rem 0 #2a211a}@media(max-width:900px){.locker-room{min-height:0}.locker-copy{border-bottom-color:#4a3827}.locker-showcase{min-height:29rem}}@media(max-width:560px){.locker-room{border-radius:.55rem!important}.locker-showcase{grid-template-columns:repeat(2,minmax(0,1fr))}.locker-bay{min-height:22rem;border-right-width:2px}.locker-label{height:3.8rem;padding-top:2.4rem}.locker-light{top:3.25rem}.locker-product{width:min(76%,8.5rem)}.locker-bench{bottom:1.1rem;height:2.6rem}.locker-bay:nth-child(1):after,.locker-bay:nth-child(4):after{bottom:1.8rem;transform:scale(.75)}}
</style>
