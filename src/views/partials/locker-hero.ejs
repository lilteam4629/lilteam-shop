<script>
(()=>{document.querySelectorAll('[data-cinematic]').forEach(root=>{const slides=[...root.querySelectorAll('[data-slide]')],tabs=[...root.querySelectorAll('[data-tab]')];const show=index=>{slides.forEach((slide,i)=>{const active=i===index;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',String(!active))});tabs.forEach((tab,i)=>{const active=i===index;tab.classList.toggle('is-active',active);tab.setAttribute('aria-selected',String(active))})};tabs.forEach((tab,index)=>{tab.addEventListener('mouseenter',()=>show(index));tab.addEventListener('focus',()=>show(index));tab.addEventListener('click',()=>show(index));tab.addEventListener('keydown',event=>{if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight')return;event.preventDefault();const next=(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;tabs[next].focus();show(next)})})})})();
</script>
<script>
(()=>{document.querySelectorAll('[data-cinematic]').forEach(root=>{const reveal=()=>{const slide=root.querySelector('.cinematic-slide.is-active');if(!slide)return;slide.classList.remove('is-revealing');void slide.offsetWidth;slide.classList.add('is-revealing');setTimeout(()=>slide.classList.remove('is-revealing'),520)};root.querySelectorAll('[data-tab]').forEach(tab=>tab.addEventListener('click',()=>requestAnimationFrame(reveal)));root.querySelectorAll('.cinematic-slide').forEach(slide=>slide.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();if(slide.classList.contains('is-tapped'))return;slide.classList.add('is-tapped');const target=slide.href;setTimeout(()=>{window.location.href=target},760)}))})})();
</script>
<script>
(()=>{document.querySelectorAll('.fan-card').forEach(card=>card.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();if(card.classList.contains('is-tapped'))return;card.classList.add('is-tapped');setTimeout(()=>{window.location.href=card.href},480)}))})();
</script>
<script>
(()=>{document.querySelectorAll('[data-draft]').forEach(root=>{const cards=[...root.querySelectorAll('[data-draft-card]')],dots=[...root.querySelectorAll('[data-draft-dot]')];if(!cards.length)return;let active=Math.min(2,cards.length-1),shuffling=false;const update=()=>{cards.forEach((card,index)=>{const distance=(index-active+cards.length)%cards.length;card.classList.remove('is-active','is-prev','is-next','is-far-prev','is-far-next');card.classList.add(distance===0?'is-active':distance===1?'is-next':distance===cards.length-1?'is-prev':distance===2?'is-far-next':'is-far-prev')});dots.forEach((dot,index)=>dot.classList.toggle('is-active',index===active))};const select=index=>{active=(index+cards.length)%cards.length;root.classList.remove('is-revealed');update()};root.querySelector('[data-draft-prev]')?.addEventListener('click',()=>select(active-1));root.querySelector('[data-draft-next]')?.addEventListener('click',()=>select(active+1));dots.forEach((dot,index)=>dot.addEventListener('click',()=>select(index)));cards.forEach((card,index)=>card.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;if(shuffling||index!==active){event.preventDefault();if(!shuffling)select(index);return}event.preventDefault();root.classList.remove('is-revealed');void root.offsetWidth;root.classList.add('is-revealed');setTimeout(()=>{window.location.href=card.href},680)}));root.querySelector('[data-draft-random]')?.addEventListener('click',()=>{if(shuffling)return;shuffling=true;root.classList.add('is-shuffling');root.classList.remove('is-revealed');let step=0;const total=12+Math.floor(Math.random()*5);const spin=()=>{active=(active+1)%cards.length;update();step+=1;if(step<total){setTimeout(spin,55+step*8)}else{shuffling=false;root.classList.remove('is-shuffling');root.classList.add('is-revealed');setTimeout(()=>root.classList.remove('is-revealed'),850)}};spin()});update()})})();
</script>
