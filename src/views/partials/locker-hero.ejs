<section class="locker-hero border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[88%] lg:px-0 lg:py-7">
    <div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]">
      <span>👁️ โหมดทดลอง — หน้านี้เห็นได้เฉพาะแอดมิน ยังไม่กระทบหน้าร้านจริง</span>
      <a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1 hover:bg-[var(--gold)]/10">กลับหลังบ้าน</a>
    </div>

    <div class="locker-room overflow-hidden rounded-2xl border border-white/10">
      <div class="locker-copy">
        <div>
          <span class="locker-kicker">LILTEAM SELECTION</span>
          <h1>เลือกสินค้าเกม<br><em>ที่ใช่สำหรับคุณ</em></h1>
          <p>รวมสินค้าเกมพร้อมส่ง คัดรายการเด่นและราคาพิเศษไว้ให้เลือกในที่เดียว</p>
          <a href="/products" class="locker-cta">เลือกซื้อสินค้า <span>→</span></a>
        </div>
        <div class="locker-trust">
          <div><b><%= stats.gameCount.toLocaleString() %></b><span>สินค้าพร้อมเลือก</span></div>
          <div><b><%= stats.customerCount.toLocaleString() %></b><span>สมาชิกของร้าน</span></div>
        </div>
      </div>

      <div class="locker-showcase">
        <% const lockerLabels = ['สินค้าใหม่', 'ยอดนิยม', 'แนะนำ', 'ราคาพิเศษ']; %>
        <% newest.slice(0, 4).forEach((p, index) => { %>
          <a href="/game/<%= p.slug %>" class="locker-bay group" aria-label="ดูสินค้า <%= p.title %>">
            <span class="locker-label"><%= lockerLabels[index] %></span>
            <span class="locker-light"></span>
            <span class="locker-hanger"><i></i></span>
            <span class="locker-product">
              <img src="<%= p.images[0] %>" alt="<%= p.title %>" />
            </span>
            <span class="locker-product-info">
              <strong><%= p.title %></strong>
              <small>฿<%= p.price.toLocaleString() %>.00</small>
            </span>
            <span class="locker-bench"></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<style>
  .locker-room{display:grid;grid-template-columns:minmax(17rem,30%) 1fr;min-height:33rem;background:var(--card);box-shadow:0 24px 70px -42px color-mix(in srgb,var(--gold) 38%,transparent)}
  .locker-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,4vw,4.5rem) clamp(1.5rem,3vw,3.4rem);background:linear-gradient(115deg,var(--card) 68%,color-mix(in srgb,var(--card) 88%,transparent));border-right:1px solid var(--border)}
  .locker-copy:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 15% 15%,color-mix(in srgb,var(--gold) 12%,transparent),transparent 38%)}
  .locker-copy>div{position:relative}.locker-kicker{display:inline-block;margin-bottom:1rem;color:var(--gold);font-size:.66rem;font-weight:800;letter-spacing:.2em}
  .locker-copy h1{font-size:clamp(2rem,3.3vw,4rem);font-weight:800;line-height:1.08;letter-spacing:-.035em;color:var(--text)}.locker-copy h1 em{font-style:normal;color:var(--gold)}
  .locker-copy p{max-width:28rem;margin-top:1.25rem;color:var(--text-3);font-size:.9rem;line-height:1.75}
  .locker-cta{display:inline-flex;align-items:center;gap:1.2rem;margin-top:1.7rem;padding:.8rem 1.15rem;border-radius:.65rem;background:var(--gold);color:var(--bg);font-size:.78rem;font-weight:800;box-shadow:0 10px 25px -15px var(--gold);transition:background .2s,transform .2s}.locker-cta:hover{background:var(--gold-hover);transform:translateY(-1px)}.locker-cta span{font-size:1.05rem}
  .locker-trust{display:flex;gap:1.6rem;margin-top:2rem}.locker-trust div{display:flex;flex-direction:column}.locker-trust b{font-size:1rem;color:var(--gold)}.locker-trust span{font-size:.58rem;color:var(--text-4)}
  .locker-showcase{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:linear-gradient(180deg,var(--input),color-mix(in srgb,var(--bg) 72%,var(--card)))}
  .locker-bay{position:relative;display:flex;min-width:0;flex-direction:column;align-items:center;overflow:hidden;border-right:1px solid color-mix(in srgb,var(--gold) 24%,var(--border));background:linear-gradient(90deg,color-mix(in srgb,var(--bg) 24%,transparent),transparent 18%,transparent 82%,color-mix(in srgb,var(--bg) 28%,transparent));transition:background .25s}.locker-bay:last-child{border-right:0}.locker-bay:hover{background-color:color-mix(in srgb,var(--gold) 7%,transparent)}
  .locker-label{position:relative;z-index:4;height:3.1rem;padding-top:1.15rem;color:var(--text-2);font-size:.66rem;font-weight:600}
  .locker-light{position:absolute;z-index:1;top:2.75rem;left:50%;width:72%;height:.22rem;transform:translateX(-50%);border-radius:99px;background:var(--gold);box-shadow:0 2px 10px color-mix(in srgb,var(--gold) 72%,transparent),0 18px 55px 14px color-mix(in srgb,var(--gold) 15%,transparent)}
  .locker-hanger{position:relative;z-index:2;display:block;width:52%;height:2.3rem;margin-top:.75rem;border-bottom:2px solid color-mix(in srgb,var(--text-3) 65%,transparent)}.locker-hanger:before{content:'';position:absolute;left:50%;top:.25rem;width:.55rem;height:.55rem;border:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);border-bottom:0;border-radius:99px 99px 0 0;transform:translateX(-50%)}.locker-hanger i{position:absolute;left:50%;bottom:-.2rem;width:70%;height:1.35rem;border-left:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);border-right:2px solid color-mix(in srgb,var(--text-3) 65%,transparent);transform:translateX(-50%) skewX(-35deg)}
  .locker-product{position:relative;z-index:3;display:block;width:min(76%,12rem);aspect-ratio:3/4;margin-top:-.2rem;filter:drop-shadow(0 14px 15px color-mix(in srgb,var(--bg) 72%,transparent));transition:transform .25s}.locker-product img{width:100%;height:100%;border:1px solid color-mix(in srgb,var(--gold) 25%,var(--border));border-radius:.55rem;object-fit:cover}.locker-bay:hover .locker-product{transform:translateY(-4px) scale(1.025)}
  .locker-product-info{position:relative;z-index:4;display:block;width:82%;margin-top:.65rem;text-align:center}.locker-product-info strong{display:block;overflow:hidden;color:var(--text);font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.locker-product-info small{display:block;margin-top:.25rem;color:var(--gold);font-size:.72rem;font-weight:800}
  .locker-bench{position:absolute;z-index:2;right:7%;bottom:1.4rem;left:7%;height:2.8rem;border-top:5px solid color-mix(in srgb,var(--gold) 42%,var(--border));background:linear-gradient(90deg,var(--bg),color-mix(in srgb,var(--gold) 12%,var(--input)) 50%,var(--bg));box-shadow:0 -8px 18px color-mix(in srgb,var(--gold) 7%,transparent),inset 0 1px color-mix(in srgb,var(--gold) 45%,transparent)}
  @media(max-width:900px){.locker-room{grid-template-columns:1fr;min-height:0}.locker-copy{padding:2rem 1.5rem;border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}.locker-copy h1{font-size:2.2rem}.locker-copy p{font-size:.8rem}.locker-showcase{min-height:27rem}.locker-bench{bottom:1rem}}
  @media(max-width:560px){.locker-room{border-radius:1rem}.locker-copy{padding:1.5rem 1.15rem}.locker-copy h1{font-size:1.85rem}.locker-copy p{margin-top:.8rem;line-height:1.6}.locker-cta{width:100%;justify-content:center;margin-top:1.1rem}.locker-trust{margin-top:1.25rem}.locker-showcase{grid-template-columns:repeat(2,minmax(0,1fr));min-height:0}.locker-bay{min-height:20rem;border-bottom:1px solid rgba(207,167,61,.2)}.locker-bay:nth-child(2){border-right:0}.locker-label{height:2.7rem}.locker-light{top:2.35rem}.locker-product{width:min(68%,8rem)}.locker-product-info{margin-top:.4rem}.locker-bench{height:2.1rem;bottom:.7rem}}
</style>
