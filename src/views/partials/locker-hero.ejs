<section class="scout-preview border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[92%] lg:px-0 lg:py-7">
    <div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]">
      <span>👁️ โหมดทดลอง Scouting Command Center — เห็นเฉพาะแอดมิน</span>
      <a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1">กลับหลังบ้าน</a>
    </div>

    <% if (newest.length) { const featured = newest[0]; %>
    <div id="scout-command" class="scout-command">
      <div class="scout-grid-lines"></div>
      <div class="scout-copy">
        <span class="scout-kicker">◉ SCOUTING COMMAND CENTER</span>
        <h1>ศูนย์รวมสินค้าเกมฟุตบอล<br><em>ค้นหาสินค้าที่ใช่สำหรับคุณ</em></h1>
        <p>คัดเลือกสินค้าเด่น พร้อมข้อมูล ราคา และสต็อกให้ตรวจสอบก่อนสั่งซื้อได้ทันที</p>
        <div class="scout-benefits"><span>◎ สินค้าคัดสรร</span><span>▣ ข้อมูลเรียลไทม์</span><span>◇ ระบบปลอดภัย</span></div>
        <a id="scout-browse-link" href="/game/<%= featured.slug %>" class="scout-cta">เลือกซื้อสินค้า <b>→</b></a>
      </div>

      <div class="scout-stage">
        <div class="scout-radar"></div><span class="scout-scan-label">SCANNING PRODUCT</span>
        <a id="scout-feature-link" href="/game/<%= featured.slug %>" class="scout-frame">
          <img id="scout-feature-image" src="<%= featured.images[0] %>" alt="<%= featured.title %>" />
          <span class="scout-corner c1"></span><span class="scout-corner c2"></span><span class="scout-corner c3"></span><span class="scout-corner c4"></span>
        </a>
        <div class="scout-stock-row"><span id="scout-stock-dot" class="<%= featured.stockCount > 0 ? 'available' : 'sold' %>"></span><strong id="scout-stock-text"><%= featured.stockCount > 0 ? 'พร้อมส่ง' : 'สินค้าหมด' %></strong><small>สต็อก: <b id="scout-stock-count"><%= featured.stockCount %></b></small></div>
      </div>

      <aside class="scout-data">
        <div class="scout-data-title"><span>PRODUCT DATA</span><b>LIVE</b></div>
        <div class="scout-rating"><span>RATING</span><strong id="scout-rating"><%= 98 - 0 %></strong><div class="scout-hex">◈</div></div>
        <dl><div><dt>ชื่อสินค้า</dt><dd id="scout-title"><%= featured.title %></dd></div><div><dt>หมวดหมู่</dt><dd>สินค้าเกมฟุตบอล</dd></div><div><dt>การจัดส่ง</dt><dd class="delivery">⚡ พร้อมส่งผ่านระบบ</dd></div></dl>
        <div class="scout-price"><span>ราคาสินค้า</span><strong id="scout-price">฿<%= featured.price.toLocaleString() %>.00</strong></div>
        <a id="scout-buy-link" href="/game/<%= featured.slug %>" class="scout-buy">🛒 ดูสินค้าและสั่งซื้อ</a>
      </aside>

      <div class="scout-selector">
        <button type="button" class="scout-nav" aria-label="เลื่อนซ้าย">‹</button>
        <div class="scout-thumbs">
          <% newest.slice(0, 5).forEach((p, index) => { %>
            <button type="button" class="scout-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= p.images[0] %>" data-title="<%= p.title %>" data-price="<%= p.price %>" data-stock="<%= p.stockCount %>" data-slug="<%= p.slug %>" data-rating="<%= Math.max(90, 98 - index) %>">
              <span><%= Math.max(90, 98 - index) %></span><img src="<%= p.images[0] %>" alt="<%= p.title %>" /><small><%= p.title %></small>
            </button>
          <% }) %>
        </div>
        <button type="button" class="scout-nav" aria-label="เลื่อนขวา">›</button>
      </div>
    </div>
    <% } else { %><div class="rounded-2xl border border-dashed border-[var(--border)] p-12 text-center text-[var(--text-4)]">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
  </div>
</section>

<style>
  .scout-command{position:relative;display:grid;grid-template-columns:minmax(16rem,1.05fr) minmax(18rem,.8fr) minmax(15rem,.7fr);grid-template-rows:auto auto;gap:1rem;overflow:hidden;border:1px solid color-mix(in srgb,var(--gold) 30%,#242116);border-radius:1.1rem;background:radial-gradient(circle at 50% 30%,color-mix(in srgb,var(--gold) 9%,#080a09),#050706 58%);padding:clamp(1rem,2.3vw,2rem);color:#f5eedc;box-shadow:0 30px 80px -45px rgba(0,0,0,.95)}
  .scout-grid-lines{position:absolute;inset:0;opacity:.16;background-image:linear-gradient(color-mix(in srgb,var(--gold) 24%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--gold) 24%,transparent) 1px,transparent 1px);background-size:46px 46px;mask-image:linear-gradient(to bottom,#000,transparent)}
  .scout-copy,.scout-stage,.scout-data,.scout-selector{position:relative;z-index:2}.scout-copy{display:flex;flex-direction:column;justify-content:center;padding:1rem clamp(.2rem,2vw,1.5rem)}.scout-kicker{color:var(--gold);font-size:.63rem;font-weight:800;letter-spacing:.12em}.scout-copy h1{margin-top:1rem;font-size:clamp(1.8rem,3vw,3.5rem);font-weight:800;line-height:1.12;letter-spacing:-.04em}.scout-copy h1 em{font-style:normal;color:var(--gold)}.scout-copy p{max-width:31rem;margin-top:1rem;color:#989080;font-size:.78rem;line-height:1.7}.scout-benefits{display:flex;flex-wrap:wrap;gap:.65rem 1rem;margin-top:1.3rem;color:#c7bfae;font-size:.6rem}.scout-benefits span:first-child{color:var(--gold)}.scout-cta{display:flex;width:max-content;align-items:center;gap:2rem;margin-top:1.6rem;border:1px solid color-mix(in srgb,var(--gold) 75%,white);border-radius:.55rem;background:linear-gradient(135deg,var(--gold-hover),var(--gold));padding:.75rem 1rem;color:#121007;font-size:.72rem;font-weight:800}.scout-cta b{font-size:1rem}
  .scout-stage{display:flex;min-height:31rem;flex-direction:column;align-items:center;justify-content:center;border:1px solid color-mix(in srgb,var(--gold) 35%,transparent);background:linear-gradient(180deg,rgba(255,255,255,.02),transparent);padding:2.2rem 1rem 1rem}.scout-scan-label{position:absolute;top:.75rem;color:var(--gold);font-size:.55rem;letter-spacing:.2em}.scout-radar{position:absolute;width:90%;aspect-ratio:1;border:1px solid color-mix(in srgb,var(--gold) 18%,transparent);border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 2.5rem,color-mix(in srgb,var(--gold) 10%,transparent) 2.55rem 2.6rem)}.scout-frame{position:relative;display:block;width:min(82%,17rem);aspect-ratio:3/4;padding:.38rem;border:1px solid var(--gold);background:#080a08;box-shadow:0 0 30px color-mix(in srgb,var(--gold) 14%,transparent)}.scout-frame img{width:100%;height:100%;object-fit:contain;background:#050505}.scout-corner{position:absolute;width:1.2rem;height:1.2rem;border-color:#ffe89a}.c1{top:-.35rem;left:-.35rem;border-top:2px solid;border-left:2px solid}.c2{top:-.35rem;right:-.35rem;border-top:2px solid;border-right:2px solid}.c3{bottom:-.35rem;left:-.35rem;border-bottom:2px solid;border-left:2px solid}.c4{right:-.35rem;bottom:-.35rem;border-right:2px solid;border-bottom:2px solid}.scout-stock-row{display:flex;width:min(82%,17rem);align-items:center;gap:.4rem;margin-top:.8rem;font-size:.65rem}.scout-stock-row small{margin-left:auto;color:#aaa190}.scout-stock-row>span{width:.55rem;height:.55rem;border-radius:50%}.scout-stock-row .available{background:#58d56b}.scout-stock-row .sold{background:#e66f63}.scout-stock-row strong{color:#64dc77}
  .scout-data{align-self:center;border:1px solid color-mix(in srgb,var(--gold) 28%,transparent);background:rgba(5,7,6,.82);padding:1rem}.scout-data-title{display:flex;justify-content:space-between;color:var(--gold);font-size:.56rem;letter-spacing:.12em}.scout-data-title b{border:1px solid #4fbf64;border-radius:99px;padding:.12rem .35rem;color:#68d87b;font-size:.45rem}.scout-rating{position:relative;margin-top:1rem;padding-bottom:1rem;border-bottom:1px solid #29271f}.scout-rating>span{display:block;color:#8f887a;font-size:.5rem}.scout-rating>strong{font-size:2.2rem;color:var(--gold)}.scout-hex{position:absolute;right:.3rem;top:.1rem;color:color-mix(in srgb,var(--gold) 72%,transparent);font-size:3.2rem}.scout-data dl>div{padding:.65rem 0;border-bottom:1px solid #29271f}.scout-data dt{color:#817a6d;font-size:.5rem;text-transform:uppercase}.scout-data dd{margin-top:.2rem;overflow:hidden;color:#eee7d7;font-size:.67rem;text-overflow:ellipsis;white-space:nowrap}.scout-data .delivery{color:#61d777}.scout-price{display:flex;align-items:end;justify-content:space-between;margin-top:1rem}.scout-price span{color:#8b8375;font-size:.55rem}.scout-price strong{color:var(--gold);font-size:1.45rem}.scout-buy{display:block;margin-top:.85rem;border-radius:.5rem;background:var(--gold);padding:.7rem;text-align:center;color:#111006;font-size:.68rem;font-weight:800}
  .scout-selector{grid-column:1/4;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.55rem}.scout-thumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.55rem}.scout-thumb{position:relative;display:grid;grid-template-columns:2.7rem minmax(0,1fr);grid-template-rows:1fr auto;gap:0 .5rem;min-width:0;overflow:hidden;border:1px solid #383428;border-radius:.55rem;background:#0b0d0c;padding:.35rem;text-align:left}.scout-thumb.active{border-color:var(--gold);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--gold) 35%,transparent)}.scout-thumb>span{position:absolute;top:.25rem;left:.25rem;z-index:2;border-radius:.25rem;background:var(--gold);padding:.08rem .22rem;color:#111;font-size:.5rem;font-weight:900}.scout-thumb img{grid-row:1/3;width:2.7rem;height:3.4rem;border-radius:.25rem;object-fit:cover}.scout-thumb small{align-self:end;overflow:hidden;color:#ddd5c5;font-size:.54rem;text-overflow:ellipsis;white-space:nowrap}.scout-nav{color:var(--gold);font-size:1.5rem}
  @media(max-width:1050px){.scout-command{grid-template-columns:1fr 1fr}.scout-copy{grid-column:1/3;text-align:center;align-items:center}.scout-stage{grid-column:1}.scout-data{grid-column:2}.scout-selector{grid-column:1/3}}
  @media(max-width:640px){.scout-command{display:block;padding:.8rem}.scout-copy{padding:1.2rem .35rem 1.5rem}.scout-copy h1{font-size:1.85rem}.scout-copy p{font-size:.68rem}.scout-benefits{justify-content:center}.scout-stage{min-height:27rem;padding-top:2.1rem}.scout-frame{width:min(74%,14rem)}.scout-data{margin-top:.75rem}.scout-selector{display:block;margin-top:.75rem}.scout-nav{display:none}.scout-thumbs{display:flex;overflow-x:auto;padding-bottom:.25rem;scrollbar-width:none}.scout-thumb{min-width:8.5rem;flex:0 0 8.5rem}.scout-price strong{font-size:1.7rem}}
</style>

<script>
  (function(){
    const root=document.getElementById('scout-command');if(!root)return;
    const thumbs=Array.from(root.querySelectorAll('.scout-thumb'));
    const image=document.getElementById('scout-feature-image'),title=document.getElementById('scout-title'),price=document.getElementById('scout-price'),rating=document.getElementById('scout-rating'),stockCount=document.getElementById('scout-stock-count'),stockText=document.getElementById('scout-stock-text'),stockDot=document.getElementById('scout-stock-dot');
    const links=[document.getElementById('scout-feature-link'),document.getElementById('scout-buy-link'),document.getElementById('scout-browse-link')];
    thumbs.forEach(btn=>btn.addEventListener('click',()=>{thumbs.forEach(x=>x.classList.remove('active'));btn.classList.add('active');image.src=btn.dataset.image;image.alt=btn.dataset.title;title.textContent=btn.dataset.title;price.textContent='฿'+Number(btn.dataset.price).toLocaleString()+'.00';rating.textContent=btn.dataset.rating;stockCount.textContent=btn.dataset.stock;const available=Number(btn.dataset.stock)>0;stockText.textContent=available?'พร้อมส่ง':'สินค้าหมด';stockDot.className=available?'available':'sold';links.forEach(a=>a.href='/game/'+btn.dataset.slug);}));
  })();
</script>
