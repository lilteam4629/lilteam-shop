<section class="album-preview"><div class="album-shell">
  <div class="album-preview-bar"><span><i>2</i> CARD COLLECTION ALBUM</span><span>ตัวอย่างเฉพาะแอดมิน</span><a href="/admin/appearance">กลับหลังบ้าน</a></div>
  <% if(newest.length){ const cards=newest.slice(0,5),start=Math.min(1,cards.length-1); %>
  <div id="album-stage" class="album-stage">
    <header><span>LILTEAM EXCLUSIVE COLLECTION</span><h1>สะสมนักเตะระดับโลก<br><em>สร้างตำนานทีมของคุณ</em></h1><p>รวมสินค้าฟุตบอลคัดสรร พร้อมส่งและตรวจสอบได้ทันที</p></header>
    <div class="album-gallery"><button class="album-arrow prev" type="button" aria-label="ก่อนหน้า">‹</button><div class="album-cards"><% cards.slice(0,3).forEach((p,i)=>{ %><button class="album-card p<%= i %> <%= i===1?'active':'' %>" type="button" data-index="<%= i %>"><img src="<%= p.images[0] %>" alt="<%= p.title %>"></button><% }) %></div><button class="album-arrow next" type="button" aria-label="ถัดไป">›</button></div>
    <div class="album-selected"><div><span id="album-status"><i></i><%= cards[start].stockCount>0?'พร้อมส่ง':'สินค้าหมด' %></span><h2 id="album-title"><%= cards[start].title %></h2><small>คงเหลือ <b id="album-stock"><%= cards[start].stockCount %></b> ชิ้น</small></div><strong id="album-price">฿<%= cards[start].price.toLocaleString() %>.00</strong><a id="album-buy" href="/game/<%= cards[start].slug %>">ดูสินค้านี้ <b>⌕</b></a></div>
    <div class="album-dots"><% cards.forEach((p,i)=>{ %><button class="<%= i===start?'active':'' %>" type="button" data-index="<%= i %>" aria-label="สินค้า <%= i+1 %>"></button><% }) %></div>
  </div><script type="application/json" id="album-data"><%- JSON.stringify(cards.map(p=>({title:p.title,image:p.images[0],price:p.price,stock:p.stockCount,slug:p.slug}))).replace(/</g,'\\u003c') %></script>
  <% }else{ %><div class="album-empty">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
</div></section>
<style>
.album-preview{--ivory:#f8f4ec;--ink:#29251f;--muted:#746b5c;--gold:#c58d2e;overflow:hidden;border-bottom:1px solid #ded3c2;background:#eae5db;color:var(--ink)}.album-shell{width:min(96%,1800px);margin:auto;padding:1rem 0 2rem}.album-preview-bar{display:flex;align-items:center;gap:.75rem;border-radius:.8rem .8rem 0 0;background:#a8742c;padding:.55rem .75rem;color:#fff;font-size:.65rem;font-weight:800;letter-spacing:.06em}.album-preview-bar i{display:inline-grid;width:1.2rem;height:1.2rem;place-items:center;background:#fff;color:#9b6b25;font-style:normal}.album-preview-bar span:nth-child(2){margin-left:auto;opacity:.8}.album-preview-bar a{border-left:1px solid #ffffff55;padding-left:.75rem}.album-stage{position:relative;isolation:isolate;overflow:hidden;border:1px solid #d8cdbb;border-top:0;border-radius:0 0 1rem 1rem;background:radial-gradient(ellipse at 50% 68%,#fff,#f8f4ec 48%,#eee8dd);box-shadow:0 24px 70px #5d4c3426}.album-stage:before,.album-stage:after{content:'';position:absolute;z-index:-1;width:35rem;height:35rem;border:1px solid #c89c5542;transform:rotate(35deg);background:#ffffff42}.album-stage:before{top:25%;left:-24rem}.album-stage:after{top:25%;right:-24rem}.album-ghosts{position:absolute;inset:38% 0 auto;z-index:-1;display:flex;justify-content:space-between;height:14rem;overflow:hidden;opacity:.14;filter:blur(2px)}.album-ghosts img{width:10rem;object-fit:contain}.album-stage>header{padding:3rem 1rem 1rem;text-align:center}.album-stage>header>span{color:var(--gold);font-size:.58rem;font-weight:800;letter-spacing:.15em}.album-stage h1{margin:.7rem 0 .5rem;font-size:clamp(2rem,4.2vw,4.2rem);font-weight:900;line-height:.96;letter-spacing:-.055em}.album-stage h1 em{color:#a77727;font-style:normal}.album-stage header p{color:var(--muted);font-size:.72rem}.album-gallery{display:grid;grid-template-columns:auto minmax(20rem,52rem) auto;align-items:center;justify-content:center;gap:1rem;padding:1rem 3rem}.album-cards{position:relative;display:flex;align-items:center;justify-content:center;height:25rem;perspective:900px}.album-card{position:absolute;width:15rem;background:none;transition:transform .28s,filter .28s,opacity .2s}.album-card img{display:block;width:100%;height:20rem;object-fit:contain;filter:drop-shadow(0 22px 20px #5b452e45)}.album-card.p0{z-index:1;transform:translateX(-82%) scale(.86) rotateY(15deg)}.album-card.p1{z-index:3;transform:scale(1.08)}.album-card.p2{z-index:1;transform:translateX(82%) scale(.86) rotateY(-15deg)}.album-card.active img{filter:drop-shadow(0 24px 20px #8c642d59) drop-shadow(0 0 2px #b87c20)}.album-arrow{display:grid;width:2.8rem;height:2.8rem;place-items:center;border:1px solid #cfa252;border-radius:50%;background:#fffaf1;color:#a87423;font-size:1.7rem;box-shadow:0 8px 20px #80612626}.album-arrow:hover{background:#dca84a;color:#fff}.album-selected{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:1.5rem;width:min(90%,52rem);margin:-.2rem auto 1rem;border:1px solid #decba7;border-radius:.8rem;background:#fffcf5e8;padding:.8rem 1rem;box-shadow:0 12px 32px #70501f1c}.album-selected>div>span{display:flex;align-items:center;gap:.35rem;color:#568435;font-size:.55rem;font-weight:700}.album-selected>div>span i{width:.38rem;height:.38rem;border-radius:50%;background:#68a23e}.album-selected h2{max-width:23rem;margin:.18rem 0;font-size:.9rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.album-selected small{color:#8b806f;font-size:.5rem}.album-selected>strong{color:#a87520;font-size:1.5rem}.album-selected>a{display:flex;align-items:center;gap:1rem;border-radius:.55rem;background:linear-gradient(135deg,#e7b857,#ca8e2e);padding:.75rem 1.35rem;color:#31230e;font-size:.68rem;font-weight:800;box-shadow:0 8px 18px #b47d2938}.album-dots{display:flex;justify-content:center;gap:.45rem;margin-bottom:1.5rem}.album-dots button{width:.4rem;height:.4rem;border-radius:50%;background:#c8bda9}.album-dots button.active{width:1.6rem;border-radius:1rem;background:var(--gold)}.album-trust{display:grid;grid-template-columns:repeat(4,1fr);margin:0 1.2rem 1.2rem;border:1px solid #e0d7c8;border-radius:.8rem;background:#ffffffc7;padding:.9rem}.album-trust>span{display:flex;align-items:center;justify-content:center;gap:.65rem;border-right:1px solid #e1d6c5;padding:.3rem .8rem}.album-trust>span:last-child{border:0}.album-trust b{color:#a87526;font-size:1.25rem}.album-trust i{font-style:normal}.album-trust strong,.album-trust small{display:block}.album-trust strong{font-size:.57rem}.album-trust small{color:#887f71;font-size:.48rem}.album-empty{padding:4rem;text-align:center}
@media(max-width:850px){.album-card{width:12rem}.album-card img{height:17rem}.album-cards{height:21rem}.album-trust{grid-template-columns:1fr 1fr}.album-trust>span:nth-child(2){border-right:0}.album-selected{width:94%}}
@media(max-width:600px){.album-shell{width:100%;padding:.6rem}.album-preview-bar{font-size:.52rem}.album-preview-bar span:nth-child(2){display:none}.album-stage>header{padding:2rem .8rem .4rem}.album-stage h1{font-size:2.15rem}.album-stage header p{font-size:.6rem}.album-gallery{grid-template-columns:2.2rem minmax(0,1fr) 2.2rem;gap:.2rem;padding:.5rem .35rem}.album-arrow{width:2.1rem;height:2.1rem;font-size:1.3rem}.album-cards{height:19rem}.album-card{width:10.5rem}.album-card img{height:16rem}.album-card.p0{transform:translateX(-58%) scale(.72);opacity:.45}.album-card.p1{transform:scale(1)}.album-card.p2{transform:translateX(58%) scale(.72);opacity:.45}.album-selected{grid-template-columns:1fr auto;gap:.7rem;margin-top:-.8rem;padding:.75rem}.album-selected>strong{font-size:1.3rem}.album-selected>a{grid-column:1/3;justify-content:center}.album-trust{grid-template-columns:1fr 1fr;margin:.6rem;padding:.55rem}.album-trust>span{justify-content:flex-start;padding:.55rem .35rem}.album-trust strong{font-size:.48rem}.album-trust small{font-size:.42rem}.album-ghosts{display:none}}
.album-preview{--brand:#8f2a7d;--night:#100b12;--panel:#19121b;background:linear-gradient(180deg,var(--bg),#130d15);border-color:#53304c}.album-preview-bar{background:linear-gradient(100deg,#23151f,#55304e 58%,#8f2a7d);border:1px solid #9a6b395c}.album-stage{border-color:#69425f;border-top:0;background:radial-gradient(circle at 50% 58%,#482340 0,#241421 28%,#130e14 63%,#0d0b0d 100%);box-shadow:0 26px 70px #0009;color:#f5eee4}.album-stage:before,.album-stage:after{border-color:#b88a4b26;background:#8f2a7d0a}.album-stage>header{position:relative}.album-stage>header>span{color:#d6ad61}.album-stage h1{color:#f6eee5}.album-stage h1 em{color:#d5a857}.album-stage header p{color:#a99ba6}.album-stage>header:after{content:'';position:absolute;top:0;bottom:0;left:-30%;width:22%;pointer-events:none;background:linear-gradient(100deg,transparent,#d8a95c38,transparent);transform:skewX(-18deg);opacity:0}.album-stage.is-sliding>header:after{animation:album-scan .65s ease-out}.album-card{will-change:transform,opacity;transition:transform .38s cubic-bezier(.2,.8,.2,1),filter .38s,opacity .26s}.album-card.p0{transform:translate(-77%,7%) scale(.78) rotateY(13deg);filter:brightness(.72) saturate(.82)}.album-card.p1{transform:translateY(-1%) scale(1.08)}.album-card.p2{transform:translate(77%,7%) scale(.78) rotateY(-13deg);filter:brightness(.72) saturate(.82)}.album-card:after{content:'';position:absolute;inset:5% 8%;pointer-events:none;background:linear-gradient(115deg,transparent 35%,#ffffff80 48%,transparent 61%);transform:translateX(-160%);opacity:0}.album-stage.is-sliding .album-card.active:after{animation:album-glint .7s ease-out}.album-card.active img{filter:drop-shadow(0 28px 22px #000b) drop-shadow(0 0 7px #d0a14b)}.album-arrow{border-color:#c89b53;background:#1a121a;color:#d9ad5d;box-shadow:0 8px 24px #0008}.album-arrow:hover{background:#8f2a7d;color:#fff}.album-selected{border-color:#6b455f;background:#181119e8;box-shadow:0 16px 38px #0008;color:#f5eee4}.album-selected h2{color:#f6eee5}.album-selected small{color:#a2959e}.album-selected>strong{color:#e0b45f}.album-selected>a{background:linear-gradient(135deg,#d8ab55,#a8752c);color:#1b1118}.album-dots button{background:#725f6d}.album-stage.slide-next .album-cards{animation:album-next .42s ease}.album-stage.slide-prev .album-cards{animation:album-prev .42s ease}.album-dots button.active{background:linear-gradient(90deg,#d5aa58,var(--brand))}@keyframes album-next{45%{transform:translateX(-2.5%) scale(.985);filter:blur(1.5px)}}@keyframes album-prev{45%{transform:translateX(2.5%) scale(.985);filter:blur(1.5px)}}@keyframes album-glint{0%{transform:translateX(-160%);opacity:0}25%{opacity:.8}100%{transform:translateX(160%);opacity:0}}@keyframes album-scan{0%{left:-30%;opacity:0}25%{opacity:.4}100%{left:112%;opacity:0}}@media(max-width:600px){.album-card.p0{transform:translate(-55%,8%) scale(.68);opacity:.55}.album-card.p1{transform:scale(1)}.album-card.p2{transform:translate(55%,8%) scale(.68);opacity:.55}}@media(prefers-reduced-motion:reduce){.album-cards,.album-card:after,.album-stage>header:after{animation:none!important}.album-card{transition:none!important}}
</style>
<script>
(function(){const root=document.getElementById('album-stage');if(!root)return;const data=JSON.parse(document.getElementById('album-data').textContent),cards=[...root.querySelectorAll('.album-card')],dots=[...root.querySelectorAll('.album-dots button')],title=document.getElementById('album-title'),price=document.getElementById('album-price'),stock=document.getElementById('album-stock'),status=document.getElementById('album-status'),buy=document.getElementById('album-buy');let selected=Math.min(1,data.length-1),moving=false;function render(){const ids=[selected-1,selected,selected+1].map(i=>(i+data.length)%data.length);cards.forEach((b,i)=>{const item=data[ids[i]];if(!item){b.hidden=true;return}b.hidden=false;b.dataset.index=ids[i];b.className='album-card p'+i+(i===1?' active':'');const img=b.querySelector('img');img.src=item.image;img.alt=item.title});dots.forEach((d,i)=>d.classList.toggle('active',i===selected));const item=data[selected];title.textContent=item.title;price.textContent='฿'+Number(item.price).toLocaleString()+'.00';stock.textContent=item.stock;status.innerHTML='<i></i>'+(item.stock>0?'พร้อมส่ง':'สินค้าหมด');buy.href='/game/'+item.slug}function pick(i){i=(i+data.length)%data.length;if(moving||i===selected)return;moving=true;const forward=(i-selected+data.length)%data.length<=data.length/2;root.classList.add('is-sliding',forward?'slide-next':'slide-prev');setTimeout(()=>{selected=i;render();root.classList.remove('slide-next','slide-prev');setTimeout(()=>{root.classList.remove('is-sliding');moving=false},390)},180)}root.querySelector('.prev').onclick=()=>pick(selected-1);root.querySelector('.next').onclick=()=>pick(selected+1);cards.forEach(b=>b.onclick=()=>pick(Number(b.dataset.index)));dots.forEach((d,i)=>d.onclick=()=>pick(i));let x=0;root.querySelector('.album-cards').addEventListener('touchstart',e=>x=e.changedTouches[0].clientX,{passive:true});root.querySelector('.album-cards').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-x;if(Math.abs(dx)>40)pick(selected+(dx<0?1:-1))},{passive:true});render()})();
</script>
