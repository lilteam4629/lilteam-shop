<section class="one-preview border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[92%] lg:px-0 lg:py-7">
    <div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]"><span>👁️ โหมดทดลอง ONE / SELECT — เห็นเฉพาะแอดมิน</span><a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1">กลับหลังบ้าน</a></div>
    <% if (newest.length) { const featured=newest[0]; %>
    <div id="one-select" class="one-select">
      <div class="one-watermark">LIL</div><div class="one-index-watermark">01</div>
      <div class="one-copy">
        <span class="one-kicker">CURATED GAME GOODS / 2026</span>
        <div><small>SELECTED PRODUCT</small><h1 id="one-title"><%= featured.title %></h1><p>สินค้าคัดพิเศษจาก LILTeam พร้อมส่งและตรวจสอบสถานะได้ทันที</p></div>
        <div class="one-meta"><span><i id="one-dot" class="<%= featured.stockCount>0?'ok':'off' %>"></i><b id="one-status"><%= featured.stockCount>0?'พร้อมส่ง':'สินค้าหมด' %></b></span><span>STOCK <b id="one-stock"><%= featured.stockCount %></b></span></div>
      </div>
      <div class="one-art">
        <span class="one-orbit"></span><span class="one-line horizontal"></span><span class="one-line vertical"></span>
        <a id="one-image-link" href="/game/<%= featured.slug %>" class="one-image-wrap"><img id="one-image" src="<%= featured.images[0] %>" alt="<%= featured.title %>" /></a>
        <span class="one-caption">LILTEAM<br>EXCLUSIVE SELECTION</span>
      </div>
      <div class="one-action">
        <span class="one-count"><b id="one-current">01</b> / <%= String(Math.min(5,newest.length)).padStart(2,'0') %></span>
        <div class="one-price"><small>ราคาสินค้า</small><strong id="one-price">฿<%= featured.price.toLocaleString() %>.00</strong></div>
        <a id="one-buy" href="/game/<%= featured.slug %>" class="one-buy"><span>ดูสินค้า</span><b>↗</b></a>
        <a href="/products" class="one-all">ดูสินค้าทั้งหมด <span>→</span></a>
      </div>
      <nav class="one-rail" aria-label="เลือกสินค้า">
        <% newest.slice(0,5).forEach((p,index)=>{ %>
          <button type="button" class="one-choice <%= index===0?'active':'' %>" data-image="<%= p.images[0] %>" data-title="<%= p.title %>" data-price="<%= p.price %>" data-stock="<%= p.stockCount %>" data-slug="<%= p.slug %>" data-number="<%= String(index+1).padStart(2,'0') %>">
            <span><%= String(index+1).padStart(2,'0') %></span><i></i><small><%= p.title %></small>
          </button>
        <% }) %>
      </nav>
    </div>
    <% } else { %><div class="rounded-2xl border border-dashed border-[var(--border)] p-12 text-center text-[var(--text-4)]">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
  </div>
</section>
<style>
  .one-select{position:relative;display:grid;grid-template-columns:minmax(16rem,.9fr) minmax(20rem,1.1fr) minmax(12rem,.55fr);grid-template-rows:minmax(34rem,auto) auto;overflow:hidden;border:1px solid var(--border);border-radius:1.2rem;background:linear-gradient(135deg,var(--card),color-mix(in srgb,var(--bg) 70%,var(--card)));color:var(--text);box-shadow:0 30px 80px -55px color-mix(in srgb,var(--gold) 55%,transparent)}
  .one-watermark{position:absolute;top:-5rem;left:-1rem;color:color-mix(in srgb,var(--text) 3.5%,transparent);font-size:22rem;font-weight:900;line-height:1;letter-spacing:-.12em;pointer-events:none}.one-index-watermark{position:absolute;right:2rem;bottom:2rem;color:color-mix(in srgb,var(--gold) 7%,transparent);font-size:13rem;font-weight:900;line-height:1;pointer-events:none}
  .one-copy,.one-art,.one-action,.one-rail{position:relative;z-index:2}.one-copy{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(2rem,4vw,4rem)}.one-kicker{color:var(--gold);font-size:.56rem;font-weight:800;letter-spacing:.2em}.one-copy small{color:var(--text-4);font-size:.53rem;letter-spacing:.15em}.one-copy h1{max-width:34rem;margin-top:.65rem;font-size:clamp(2rem,4.3vw,5rem);font-weight:900;line-height:.98;letter-spacing:-.055em;overflow-wrap:anywhere}.one-copy p{max-width:24rem;margin-top:1.25rem;color:var(--text-3);font-size:.72rem;line-height:1.75}.one-meta{display:flex;gap:1.2rem;color:var(--text-4);font-size:.54rem;letter-spacing:.08em}.one-meta span{display:flex;align-items:center;gap:.35rem}.one-meta i{width:.45rem;height:.45rem;border-radius:50%}.one-meta i.ok{background:#4ed46b;box-shadow:0 0 8px #4ed46b}.one-meta i.off{background:#df6b63}.one-meta b{color:var(--text-2)}
  .one-art{display:grid;place-items:center;overflow:hidden;border-right:1px solid var(--border);border-left:1px solid var(--border)}.one-orbit{position:absolute;width:min(78%,30rem);aspect-ratio:1;border:1px solid color-mix(in srgb,var(--gold) 25%,transparent);border-radius:50%}.one-orbit:before,.one-orbit:after{content:'';position:absolute;inset:12%;border:1px solid color-mix(in srgb,var(--gold) 13%,transparent);border-radius:50%}.one-orbit:after{inset:31%;background:color-mix(in srgb,var(--gold) 4%,transparent)}.one-line{position:absolute;background:color-mix(in srgb,var(--gold) 13%,transparent)}.one-line.horizontal{right:8%;left:8%;height:1px}.one-line.vertical{top:8%;bottom:8%;width:1px}.one-image-wrap{position:relative;z-index:3;display:block;width:min(58%,18rem);aspect-ratio:3/4;filter:drop-shadow(0 24px 25px color-mix(in srgb,var(--bg) 76%,transparent));transition:transform .25s}.one-image-wrap:hover{transform:translateY(-4px)}.one-image-wrap img{width:100%;height:100%;border:1px solid color-mix(in srgb,var(--gold) 35%,var(--border));border-radius:.65rem;object-fit:contain;background:var(--bg)}.one-caption{position:absolute;right:1.2rem;bottom:1.2rem;color:var(--text-4);font-size:.43rem;line-height:1.5;letter-spacing:.14em;text-align:right}
  .one-action{display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(1.5rem,3vw,2.6rem)}.one-count{position:absolute;top:2rem;color:var(--text-4);font-size:.65rem;letter-spacing:.15em}.one-count b{color:var(--gold);font-size:1.2rem}.one-price small{display:block;color:var(--text-4);font-size:.53rem}.one-price strong{display:block;margin-top:.35rem;color:var(--gold);font-size:clamp(1.7rem,2.6vw,2.8rem);font-weight:900}.one-buy{display:flex;align-items:center;justify-content:space-between;margin-top:1.25rem;border-radius:.55rem;background:var(--gold);padding:.8rem .9rem;color:var(--bg);font-size:.68rem;font-weight:800}.one-buy b{font-size:1rem}.one-all{display:flex;align-items:center;justify-content:space-between;margin-top:.75rem;padding:.55rem .1rem;color:var(--text-3);font-size:.58rem;border-bottom:1px solid var(--border)}
  .one-rail{grid-column:1/4;display:flex;border-top:1px solid var(--border);overflow-x:auto;scrollbar-width:none}.one-choice{display:grid;grid-template-columns:auto auto minmax(5rem,1fr);align-items:center;gap:.65rem;min-width:10rem;flex:1;padding:.9rem 1rem;border-right:1px solid var(--border);color:var(--text-4);text-align:left}.one-choice:last-child{border-right:0}.one-choice>span{font-size:.58rem;font-weight:800}.one-choice>i{width:.35rem;height:.35rem;border-radius:50%;background:var(--border-light)}.one-choice>small{overflow:hidden;font-size:.5rem;text-overflow:ellipsis;white-space:nowrap}.one-choice.active{background:color-mix(in srgb,var(--gold) 7%,transparent);color:var(--gold)}.one-choice.active i{background:var(--gold);box-shadow:0 0 8px var(--gold)}
  @media(max-width:980px){.one-select{grid-template-columns:1fr 1fr;grid-template-rows:auto minmax(28rem,auto) auto}.one-copy{grid-column:1/3;min-height:20rem;text-align:center;align-items:center}.one-copy h1{font-size:3rem}.one-copy p{margin-right:auto;margin-left:auto}.one-art{grid-column:1;border-left:0}.one-action{grid-column:2}.one-rail{grid-column:1/3}}
  @media(max-width:600px){.one-select{display:flex;flex-direction:column}.one-copy{min-height:auto;padding:2rem 1.2rem 1.5rem}.one-copy h1{font-size:2.25rem}.one-copy p{margin-top:.8rem}.one-meta{margin-top:1.4rem}.one-art{min-height:25rem;border-top:1px solid var(--border);border-right:0;border-bottom:1px solid var(--border)}.one-image-wrap{width:min(55%,12rem)}.one-action{padding:1.4rem}.one-count{position:static;margin-bottom:1rem}.one-price strong{font-size:2rem}.one-rail{order:3}.one-action{order:4}.one-choice{min-width:8.2rem;padding:.75rem}.one-choice small{max-width:4rem}.one-watermark{font-size:12rem;top:1rem}.one-index-watermark{font-size:8rem}}
</style>
<script>
  (function(){const root=document.getElementById('one-select');if(!root)return;const choices=Array.from(root.querySelectorAll('.one-choice')),image=document.getElementById('one-image'),title=document.getElementById('one-title'),price=document.getElementById('one-price'),stock=document.getElementById('one-stock'),status=document.getElementById('one-status'),dot=document.getElementById('one-dot'),current=document.getElementById('one-current'),buy=document.getElementById('one-buy'),imageLink=document.getElementById('one-image-link');choices.forEach(btn=>btn.addEventListener('click',()=>{choices.forEach(x=>x.classList.remove('active'));btn.classList.add('active');image.src=btn.dataset.image;image.alt=btn.dataset.title;title.textContent=btn.dataset.title;price.textContent='฿'+Number(btn.dataset.price).toLocaleString()+'.00';stock.textContent=btn.dataset.stock;current.textContent=btn.dataset.number;const ok=Number(btn.dataset.stock)>0;status.textContent=ok?'พร้อมส่ง':'สินค้าหมด';dot.className=ok?'ok':'off';buy.href=imageLink.href='/game/'+btn.dataset.slug;}));})();
</script>
