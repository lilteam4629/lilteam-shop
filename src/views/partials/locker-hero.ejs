<section class="sky-preview"><div class="sky-shell">
  <div class="sky-preview-bar"><span>⚽ FOOTBALL SKY HUB</span><small>ตัวอย่างเฉพาะแอดมิน</small><a href="/admin/appearance">กลับหลังบ้าน</a></div>
  <% if(newest.length){ const items=newest.slice(0,5),featured=items[0]; %>
  <div id="sky-stage" class="sky-stage">
    <div class="sky-cloud c1"></div><div class="sky-cloud c2"></div><div class="sky-cloud c3"></div>
    <header class="sky-head"><div><span>04 · LILTEAM FOOTBALL</span><h1>สร้างทีมในฝัน<br>สไตล์เกมเมอร์</h1><p>เลือกสินค้าพร้อมส่ง แล้วเริ่มสร้างทีมของคุณได้ทันที</p></div><div class="sky-live"><i></i> อัปเดตสต็อกสด</div></header>
    <div class="sky-feature">
      <div class="sky-copy"><span class="sky-badge">สินค้าแนะนำ</span><h2 id="sky-title"><%= featured.title %></h2><p>นักเตะและสินค้าเกมคัดพิเศษ พร้อมส่งทันทีหลังชำระเงิน</p><div class="sky-meta"><span><small>ราคา</small><strong id="sky-price">฿<%= featured.price.toLocaleString() %>.00</strong></span><span><small>คงเหลือ</small><strong><b id="sky-stock"><%= featured.stockCount %></b> ชิ้น</strong></span></div><a id="sky-buy" href="/game/<%= featured.slug %>">ดูสินค้านี้ <b>→</b></a></div>
      <div class="sky-player"><div class="sky-ring"></div><img id="sky-image" src="<%= featured.images[0] %>" alt="<%= featured.title %>"><span class="sky-shine"></span></div>
    </div>
    <div class="sky-trust"><span>◉ <b>เปิดบริการ 17:00–00:00</b></span><span>◷ <b>พร้อมส่งทันที</b></span><span>✓ <b>ตรวจสอบคำสั่งซื้อได้</b></span></div>
  </div><script id="sky-data" type="application/json"><%- JSON.stringify(items.map(p=>({title:p.title,image:p.images[0],price:p.price,stock:p.stockCount,slug:p.slug}))).replace(/</g,'\\u003c') %></script>
  <% }else{ %><div class="sky-empty">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
</div></section>
<style>
.sky-preview{--sky:#168df0;--deep:#0751a8;--navy:#092f62;--yellow:#ffd347;--grass:#2aa84a;overflow:hidden;background:linear-gradient(180deg,var(--bg),#091b35);color:#fff}.sky-shell{width:min(96%,1680px);margin:auto;padding:1rem 0 2rem}.sky-preview-bar{display:flex;align-items:center;gap:1rem;border-radius:.85rem .85rem 0 0;background:#073972;padding:.6rem .85rem;font-size:.65rem;font-weight:800}.sky-preview-bar small{margin-left:auto;color:#a9d5ff}.sky-preview-bar a{border-left:1px solid #ffffff4d;padding-left:1rem}.sky-stage{position:relative;isolation:isolate;overflow:hidden;border:1px solid #72c9ff;border-top:0;border-radius:0 0 1.2rem 1.2rem;background:linear-gradient(180deg,#1594f3 0,#35aef7 56%,#89d5ff 72%,#48a94a 72.3%,#167638 100%);box-shadow:0 30px 80px #0007}.sky-stage:after{content:'';position:absolute;z-index:-1;right:-8%;bottom:9%;left:-8%;height:18%;border-radius:50% 50% 0 0;background:repeating-linear-gradient(90deg,#ffffff0d 0 8%,transparent 8% 16%),linear-gradient(#35a84b,#18763a)}.sky-cloud{position:absolute;z-index:-1;width:8rem;height:2.2rem;border-radius:999px;background:#fff;opacity:.86;filter:drop-shadow(24px -12px 0 #fff) drop-shadow(-25px 5px 0 #ffffffcc)}.sky-cloud.c1{top:8%;left:5%;transform:scale(.55)}.sky-cloud.c2{top:15%;right:7%;transform:scale(.38)}.sky-cloud.c3{top:39%;left:35%;transform:scale(.25);opacity:.5}.sky-head{display:flex;align-items:flex-start;justify-content:space-between;padding:2.3rem clamp(1.2rem,4vw,4rem) .5rem}.sky-head span{font-size:.55rem;font-weight:800;letter-spacing:.1em}.sky-head h1{margin:.55rem 0 .3rem;font-size:clamp(2.5rem,5vw,5.5rem);font-weight:950;line-height:.85;letter-spacing:-.055em;text-shadow:0 4px 0 #0753a5}.sky-head p{color:#e8f7ff;font-size:.72rem}.sky-live{display:flex;align-items:center;gap:.4rem;border:1px solid #ffffff80;border-radius:999px;background:#0568bf88;padding:.5rem .75rem;font-size:.58rem}.sky-live i{width:.45rem;height:.45rem;border-radius:50%;background:#a7ff6a;box-shadow:0 0 9px #a7ff6a}.sky-search{display:flex;width:min(72%,46rem);margin:1.2rem auto 0;border:3px solid #fff;border-radius:.65rem;background:#fff;box-shadow:0 8px 0 #0754a6}.sky-search input{min-width:0;flex:1;border:0;background:white;padding:.7rem .9rem;color:#183959;font-size:.68rem;outline:0}.sky-search button{width:3.2rem;border-radius:.4rem;background:var(--yellow);color:#17365a;font-size:1.1rem;font-weight:900}.sky-categories{display:flex;justify-content:center;gap:clamp(.8rem,3vw,3rem);padding:1.7rem 1rem 1rem}.sky-categories a{display:flex;flex-direction:column;align-items:center;gap:.3rem;min-width:4rem;text-align:center}.sky-categories i{display:grid;width:2.55rem;height:2.55rem;place-items:center;border:2px solid #b9e6ff;border-radius:50%;background:linear-gradient(#137fe0,#0753ad);font-style:normal;box-shadow:0 5px 0 #06488f}.sky-categories span{font-size:.53rem;font-weight:700;text-shadow:0 1px 2px #064785}.sky-feature{display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;width:min(92%,68rem);min-height:31rem;margin:1rem auto 0;border:1px solid #ffffff5c;border-radius:1rem;background:linear-gradient(115deg,#073f8bd9,#147fd3a6 48%,#52b9e74a);box-shadow:0 24px 50px #063a7766;backdrop-filter:blur(5px)}.sky-copy{z-index:3;padding:clamp(1.5rem,4vw,3.5rem)}.sky-badge{display:inline-block;border-radius:999px;background:var(--yellow);padding:.4rem .7rem;color:#143d69;font-size:.55rem;font-weight:900}.sky-copy h2{margin:.9rem 0 .5rem;font-size:clamp(1.6rem,3.5vw,3.5rem);font-weight:950;line-height:1;overflow-wrap:anywhere}.sky-copy>p{color:#cceaff;font-size:.66rem;line-height:1.7}.sky-meta{display:flex;gap:2rem;margin:1.5rem 0}.sky-meta small,.sky-meta strong{display:block}.sky-meta small{color:#b8ddf5;font-size:.5rem}.sky-meta strong{margin-top:.2rem;font-size:.82rem}.sky-meta span:first-child strong{color:var(--yellow);font-size:1.6rem}.sky-copy>a{display:flex;align-items:center;justify-content:space-between;width:min(100%,16rem);border-radius:.6rem;background:var(--yellow);padding:.8rem 1rem;color:#16385e;font-size:.68rem;font-weight:900;box-shadow:0 7px 0 #c69216}.sky-player{position:relative;align-self:stretch;display:grid;place-items:center;overflow:hidden;min-width:0}.sky-ring{position:absolute;width:min(72%,28rem);aspect-ratio:1;border:2px solid #ffffff66;border-radius:50%;box-shadow:0 0 0 3rem #ffffff0a,0 0 0 6rem #ffffff08}.sky-player img{position:relative;z-index:2;width:min(76%,27rem);height:28rem;object-fit:contain;filter:drop-shadow(0 28px 20px #052e5d99);transition:transform .38s cubic-bezier(.2,.8,.2,1),opacity .18s}.sky-player.changing img{opacity:0;transform:translateX(8%) scale(.96)}.sky-shine{position:absolute;z-index:3;inset:12% 15%;pointer-events:none;background:linear-gradient(110deg,transparent 40%,#ffffff75 50%,transparent 60%);transform:translateX(-150%)}.sky-player.changing .sky-shine{animation:sky-scan .65s ease}.sky-products{position:relative;z-index:4;width:min(94%,76rem);margin:-1.2rem auto 1rem;border:1px solid #ffe68b;border-radius:.85rem;background:#08366beb;padding:.8rem;box-shadow:0 18px 36px #06284e99}.sky-products-head{display:flex;justify-content:space-between;margin-bottom:.6rem;font-size:.58rem;font-weight:800}.sky-products-head small{color:#9ed8ff;font-size:.48rem}.sky-row{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem}.sky-card{position:relative;display:grid;grid-template-columns:3.3rem 1fr;align-items:center;gap:.5rem;min-width:0;border:1px solid #2c74b9;border-radius:.55rem;background:#092e59;padding:.45rem;color:#fff;text-align:left;transition:transform .2s,border-color .2s}.sky-card:hover,.sky-card.active{border-color:var(--yellow);transform:translateY(-3px);box-shadow:0 5px 0 #d7a522}.sky-card>img{width:3.3rem;height:4.2rem;object-fit:contain}.sky-card>span:last-child{min-width:0}.sky-card b,.sky-card small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sky-card b{font-size:.52rem}.sky-card small{margin-top:.35rem;color:var(--yellow);font-size:.54rem;font-weight:800}.sky-rating{position:absolute;top:.25rem;left:.25rem;z-index:2;color:#fff;font-size:.48rem;font-weight:900;text-shadow:0 1px 2px #000}.sky-trust{display:flex;justify-content:center;gap:clamp(1rem,4vw,4rem);padding:1rem 1rem 1.3rem;color:#e6f7e8;font-size:.55rem}.sky-empty{padding:4rem;text-align:center}
@keyframes sky-scan{0%{transform:translateX(-150%)}100%{transform:translateX(150%)}}@media(prefers-reduced-motion:reduce){.sky-player img,.sky-shine{animation:none!important;transition:none!important}}
@media(max-width:800px){.sky-feature{grid-template-columns:1fr 1fr}.sky-row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.sky-card{min-width:11rem;scroll-snap-align:start}.sky-player img{width:90%}}
@media(max-width:600px){.sky-shell{width:100%;padding:.6rem}.sky-preview-bar{font-size:.52rem}.sky-preview-bar small{display:none}.sky-head{padding:1.6rem 1rem .4rem}.sky-head h1{font-size:2.7rem}.sky-head p{font-size:.58rem}.sky-live{display:none}.sky-search{width:88%;margin-top:.8rem}.sky-categories{justify-content:flex-start;gap:1rem;overflow-x:auto;padding:1.3rem .8rem}.sky-categories a{min-width:4.2rem}.sky-feature{display:flex;width:94%;min-height:0;flex-direction:column-reverse}.sky-player{width:100%;height:25rem}.sky-player img{width:74%;height:23rem;object-fit:contain}.sky-copy{width:100%;padding:1.1rem}.sky-copy h2{font-size:1.65rem}.sky-copy>p{display:none}.sky-meta{margin:1rem 0}.sky-copy>a{width:100%}.sky-products{margin-top:.8rem}.sky-trust{flex-wrap:wrap;gap:.7rem 1.2rem}.sky-cloud{opacity:.5}}
</style>
<script>
(function(){const root=document.getElementById('sky-stage');if(!root)return;const image=document.getElementById('sky-image');if(image)image.addEventListener('load',()=>image.classList.add('is-ready'),{once:true})})();
</script>
