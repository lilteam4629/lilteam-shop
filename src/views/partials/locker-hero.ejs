<section class="pitch-preview border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto w-full max-w-[1800px] px-4 py-4 lg:w-[92%] lg:px-0 lg:py-7">
    <div class="mb-3 flex items-center justify-between gap-3 rounded-xl border border-[var(--gold)]/35 bg-[var(--gold)]/10 px-3 py-2 text-xs text-[var(--gold-hover)]"><span>👁️ โหมดทดลอง Tactical Pitch Market — เห็นเฉพาะแอดมิน</span><a href="/admin/appearance" class="shrink-0 rounded-lg border border-[var(--gold)]/35 px-2.5 py-1">กลับหลังบ้าน</a></div>
    <% if (newest.length) { const featured = newest[0]; const positions = [{x:50,y:14,pos:'CF'},{x:22,y:38,pos:'LWF'},{x:78,y:38,pos:'RWF'},{x:36,y:66,pos:'CMF'},{x:64,y:66,pos:'AMF'}]; %>
    <div id="tactical-market" class="tactical-market">
      <header class="tactical-head"><div><span>LIVE TRANSFER BOARD</span><h1>จัดทีมในฝัน<br><em>เลือกสินค้าที่ใช่</em></h1></div><p>กดตำแหน่งบนสนามเพื่อดูรายละเอียดสินค้า<br>แล้วสั่งซื้อได้ทันทีจากแผนของคุณ</p><a href="/products">ดูตลาดทั้งหมด →</a></header>
      <div class="tactical-layout">
        <div class="pitch-wrap">
          <div class="pitch-score"><span>LILTEAM XI</span><b>FORMATION 3–2</b></div>
          <div class="pitch-field">
            <span class="pitch-half"></span><span class="pitch-circle"></span><span class="penalty top"></span><span class="penalty bottom"></span>
            <% newest.slice(0,5).forEach((p,index)=>{ const point=positions[index]; %>
              <button type="button" class="pitch-player <%= index===0?'active':'' %>" style="--x:<%= point.x %>%;--y:<%= point.y %>%" data-title="<%= p.title %>" data-image="<%= p.images[0] %>" data-price="<%= p.price %>" data-stock="<%= p.stockCount %>" data-slug="<%= p.slug %>" data-pos="<%= point.pos %>">
                <span class="player-position"><%= point.pos %></span><span class="player-card"><img src="<%= p.images[0] %>" alt="<%= p.title %>" /></span><strong><%= p.title %></strong><i></i>
              </button>
            <% }) %>
          </div>
          <div class="pitch-legend"><span><i class="online"></i> พร้อมส่ง</span><span><i class="selected"></i> สินค้าที่เลือก</span><span>แตะการ์ดเพื่อเปลี่ยน</span></div>
        </div>
        <aside class="draft-panel">
          <div class="draft-top"><span>DRAFT PICK</span><b id="draft-position">CF</b></div>
          <div class="draft-visual"><span class="draft-number">01</span><img id="draft-image" src="<%= featured.images[0] %>" alt="<%= featured.title %>" /><span class="draft-grid"></span></div>
          <div class="draft-copy"><span>SELECTED PRODUCT</span><h2 id="draft-title"><%= featured.title %></h2><div class="draft-status"><i id="draft-status-dot" class="<%= featured.stockCount>0?'ok':'off' %>"></i><strong id="draft-status-text"><%= featured.stockCount>0?'พร้อมส่งทันที':'สินค้าหมด' %></strong><small>คงเหลือ <b id="draft-stock"><%= featured.stockCount %></b></small></div></div>
          <div class="draft-price"><span>ราคาปัจจุบัน</span><strong id="draft-price">฿<%= featured.price.toLocaleString() %>.00</strong></div>
          <a id="draft-buy" href="/game/<%= featured.slug %>" class="draft-buy">เลือกสินค้านี้ <b>→</b></a>
          <div class="draft-safe"><span>✓ ชำระผ่านกระเป๋าร้าน</span><span>✓ ตรวจสอบคำสั่งซื้อได้</span></div>
        </aside>
      </div>
      <div class="substitutes"><span class="sub-label">SUBSTITUTES</span><div><% newest.slice(0,5).forEach((p,index)=>{ %><button type="button" class="sub-card" data-target="<%= index %>"><img src="<%= p.images[0] %>" alt="" /><span><b><%= String(index+1).padStart(2,'0') %></b><small><%= p.title %></small></span></button><% }) %></div></div>
    </div>
    <% } else { %><div class="rounded-2xl border border-dashed border-[var(--border)] p-12 text-center text-[var(--text-4)]">ยังไม่มีสินค้าสำหรับแสดงตัวอย่าง</div><% } %>
  </div>
</section>
<style>
  .tactical-market{position:relative;overflow:hidden;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--border));border-radius:1.2rem;background:linear-gradient(145deg,#0a0d0b,#080907 58%,color-mix(in srgb,var(--gold) 7%,#080907));color:#f5eedc;box-shadow:0 30px 80px -48px rgba(0,0,0,.95)}
  .tactical-market:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 49.9%,color-mix(in srgb,var(--gold) 8%,transparent) 50%,transparent 50.1%)}.tactical-head{position:relative;z-index:2;display:grid;grid-template-columns:1.2fr 1fr auto;align-items:end;gap:2rem;padding:clamp(1.2rem,2.5vw,2.4rem);border-bottom:1px solid #25251d}.tactical-head span{color:var(--gold);font-size:.58rem;font-weight:800;letter-spacing:.18em}.tactical-head h1{margin-top:.35rem;font-size:clamp(1.8rem,3vw,3.5rem);font-weight:900;line-height:1.02;letter-spacing:-.04em}.tactical-head h1 em{font-style:normal;color:var(--gold)}.tactical-head p{color:#8d887b;font-size:.68rem;line-height:1.7}.tactical-head>a{border:1px solid #3b3729;border-radius:.55rem;padding:.65rem .8rem;color:var(--gold);font-size:.63rem}
  .tactical-layout{position:relative;z-index:2;display:grid;grid-template-columns:minmax(28rem,1.45fr) minmax(16rem,.55fr);gap:1rem;padding:1rem}.pitch-wrap{min-width:0;border:1px solid #2d3129;border-radius:.8rem;background:#0c110d;padding:.75rem}.pitch-score{display:flex;justify-content:space-between;margin-bottom:.6rem;color:#9a9688;font-size:.52rem;letter-spacing:.12em}.pitch-score b{color:var(--gold)}.pitch-field{position:relative;min-height:34rem;overflow:hidden;border:1px solid rgba(221,232,205,.28);border-radius:.45rem;background:radial-gradient(circle at 50% 48%,rgba(235,198,87,.08),transparent 30%),repeating-linear-gradient(90deg,#102b1b 0 11%,#12331f 11% 22%)}.pitch-field:before{content:'';position:absolute;inset:1rem;border:1px solid rgba(233,239,221,.28)}.pitch-half{position:absolute;top:50%;right:1rem;left:1rem;border-top:1px solid rgba(233,239,221,.28)}.pitch-circle{position:absolute;top:50%;left:50%;width:9rem;height:9rem;border:1px solid rgba(233,239,221,.28);border-radius:50%;transform:translate(-50%,-50%)}.pitch-circle:after{content:'';position:absolute;top:50%;left:50%;width:.4rem;height:.4rem;border-radius:50%;background:rgba(233,239,221,.45);transform:translate(-50%,-50%)}.penalty{position:absolute;left:50%;width:15rem;height:5rem;border:1px solid rgba(233,239,221,.28);transform:translateX(-50%)}.penalty.top{top:1rem;border-top:0}.penalty.bottom{bottom:1rem;border-bottom:0}
  .pitch-player{position:absolute;top:var(--y);left:var(--x);z-index:4;width:6.2rem;transform:translate(-50%,-50%);text-align:center}.player-card{display:block;width:3.8rem;height:4.8rem;margin:auto;overflow:hidden;border:1px solid #4e4938;border-radius:.45rem;background:#080908;box-shadow:0 8px 18px rgba(0,0,0,.5);transition:transform .2s,border-color .2s}.player-card img{width:100%;height:100%;object-fit:cover}.pitch-player:hover .player-card,.pitch-player.active .player-card{transform:translateY(-3px);border-color:var(--gold);box-shadow:0 0 0 2px color-mix(in srgb,var(--gold) 25%,transparent),0 10px 22px rgba(0,0,0,.55)}.player-position{position:absolute;z-index:2;top:-.3rem;left:.5rem;border-radius:.25rem;background:var(--gold);padding:.1rem .25rem;color:#111006;font-size:.47rem;font-weight:900}.pitch-player strong{display:block;margin-top:.3rem;overflow:hidden;color:#e7dfd0;font-size:.52rem;text-overflow:ellipsis;white-space:nowrap}.pitch-player i{display:block;width:.4rem;height:.4rem;margin:.25rem auto 0;border-radius:50%;background:#54d76c;box-shadow:0 0 8px #54d76c}.pitch-legend{display:flex;gap:1rem;margin-top:.6rem;color:#7f7b70;font-size:.5rem}.pitch-legend span{display:flex;align-items:center;gap:.25rem}.pitch-legend i{width:.4rem;height:.4rem;border-radius:50%}.pitch-legend .online{background:#54d76c}.pitch-legend .selected{background:var(--gold)}
  .draft-panel{display:flex;min-width:0;flex-direction:column;border:1px solid color-mix(in srgb,var(--gold) 32%,#25251d);border-radius:.8rem;background:linear-gradient(180deg,#0c0e0c,#080908);padding:1rem}.draft-top{display:flex;align-items:center;justify-content:space-between;color:var(--gold);font-size:.55rem;letter-spacing:.15em}.draft-top b{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid var(--gold);border-radius:50%}.draft-visual{position:relative;display:grid;min-height:17rem;place-items:center;margin-top:.75rem;overflow:hidden;border:1px solid #29291f;background:radial-gradient(circle,color-mix(in srgb,var(--gold) 12%,transparent),transparent 58%)}.draft-visual img{position:relative;z-index:2;width:min(72%,10rem);max-height:15rem;object-fit:contain;filter:drop-shadow(0 12px 14px rgba(0,0,0,.6))}.draft-number{position:absolute;top:-1rem;left:.5rem;color:color-mix(in srgb,var(--gold) 13%,transparent);font-size:7rem;font-weight:900}.draft-grid{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--gold) 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--gold) 8%,transparent) 1px,transparent 1px);background-size:24px 24px}.draft-copy{margin-top:1rem}.draft-copy>span{color:#777166;font-size:.48rem;letter-spacing:.12em}.draft-copy h2{margin-top:.25rem;overflow:hidden;color:#f0e9da;font-size:1rem;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.draft-status{display:flex;align-items:center;gap:.35rem;margin-top:.65rem;font-size:.58rem}.draft-status i{width:.45rem;height:.45rem;border-radius:50%}.draft-status i.ok{background:#55d76b}.draft-status i.off{background:#e66d62}.draft-status strong{color:#5fd875}.draft-status small{margin-left:auto;color:#807a6e}.draft-price{display:flex;align-items:end;justify-content:space-between;margin-top:1rem;padding-top:.8rem;border-top:1px solid #29291f}.draft-price span{color:#817b70;font-size:.55rem}.draft-price strong{color:var(--gold);font-size:1.5rem}.draft-buy{display:flex;align-items:center;justify-content:space-between;margin-top:.8rem;border-radius:.55rem;background:var(--gold);padding:.75rem .9rem;color:#111006;font-size:.68rem;font-weight:800}.draft-safe{display:flex;flex-wrap:wrap;gap:.4rem .8rem;margin-top:.7rem;color:#777166;font-size:.48rem}
  .substitutes{position:relative;z-index:2;display:flex;align-items:center;gap:1rem;padding:0 1rem 1rem}.sub-label{writing-mode:vertical-rl;color:var(--gold);font-size:.47rem;letter-spacing:.14em}.substitutes>div{display:flex;min-width:0;flex:1;gap:.5rem;overflow-x:auto;scrollbar-width:none}.sub-card{display:flex;min-width:9rem;flex:1;align-items:center;gap:.45rem;border:1px solid #29291f;border-radius:.5rem;background:#0b0d0c;padding:.35rem;text-align:left}.sub-card img{width:2rem;height:2.55rem;border-radius:.25rem;object-fit:cover}.sub-card span{min-width:0}.sub-card b{display:block;color:var(--gold);font-size:.55rem}.sub-card small{display:block;overflow:hidden;color:#aaa395;font-size:.48rem;text-overflow:ellipsis;white-space:nowrap}
  @media(max-width:900px){.tactical-head{grid-template-columns:1fr auto}.tactical-head p{display:none}.tactical-layout{grid-template-columns:1fr}.pitch-field{min-height:31rem}.draft-panel{display:grid;grid-template-columns:9rem minmax(0,1fr);gap:0 1rem}.draft-top{grid-column:1/3}.draft-visual{grid-row:2/6;min-height:14rem}.draft-buy,.draft-safe{grid-column:2}.draft-copy{align-self:end}}
  @media(max-width:600px){.tactical-head{display:block;padding:1.2rem}.tactical-head h1{font-size:1.9rem}.tactical-head>a{display:inline-flex;margin-top:1rem}.tactical-layout{padding:.65rem}.pitch-field{min-height:30rem}.pitch-player{width:4.8rem}.player-card{width:3rem;height:3.8rem}.player-position{left:.1rem}.penalty{width:10rem}.draft-panel{display:flex}.draft-visual{min-height:17rem}.draft-visual img{width:min(60%,9rem)}.substitutes{padding:.2rem .65rem .75rem}.pitch-legend{flex-wrap:wrap}}
</style>
<script>
  (function(){const root=document.getElementById('tactical-market');if(!root)return;const players=Array.from(root.querySelectorAll('.pitch-player')),subs=Array.from(root.querySelectorAll('.sub-card'));const image=document.getElementById('draft-image'),title=document.getElementById('draft-title'),price=document.getElementById('draft-price'),stock=document.getElementById('draft-stock'),status=document.getElementById('draft-status-text'),dot=document.getElementById('draft-status-dot'),pos=document.getElementById('draft-position'),buy=document.getElementById('draft-buy');function select(index){const btn=players[index];if(!btn)return;players.forEach(x=>x.classList.remove('active'));btn.classList.add('active');image.src=btn.dataset.image;image.alt=btn.dataset.title;title.textContent=btn.dataset.title;price.textContent='฿'+Number(btn.dataset.price).toLocaleString()+'.00';stock.textContent=btn.dataset.stock;pos.textContent=btn.dataset.pos;const ok=Number(btn.dataset.stock)>0;status.textContent=ok?'พร้อมส่งทันที':'สินค้าหมด';dot.className=ok?'ok':'off';buy.href='/game/'+btn.dataset.slug;}players.forEach((btn,i)=>btn.addEventListener('click',()=>select(i)));subs.forEach(btn=>btn.addEventListener('click',()=>select(Number(btn.dataset.target))));})();
</script>
