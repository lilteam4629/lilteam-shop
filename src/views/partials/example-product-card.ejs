<%
  // Shown instead of a real product-card when the shop has no products
  // yet, so the storefront isn't a blank grid — clearly marked as an
  // example, not a real item for sale. Pass { n } as the card number.
  const _n = typeof n !== 'undefined' ? n : 1;
%>
<div class="relative flex w-full h-full aspect-[3/4] rounded-2xl overflow-hidden border border-dashed border-[var(--border-light)] bg-[var(--input)]">
  <div class="absolute inset-0 opacity-[0.08] bg-[repeating-linear-gradient(45deg,var(--gold)_0,var(--gold)_2px,transparent_2px,transparent_14px)]"></div>
  <div class="relative flex-1 flex flex-col items-center justify-center text-center px-3">
    <div class="text-[var(--gold)]/40 text-3xl mb-2">🖼️</div>
    <div class="text-[var(--text-4)] text-xs font-medium">ตัวอย่างสินค้า <%= _n %></div>
    <div class="text-[var(--gold)]/70 text-[10px] font-mono mt-1">ขนาดแนะนำ: 1000 x 750</div>
  </div>
  <div class="absolute inset-x-0 bottom-0 p-3 flex flex-col gap-1 min-w-0 bg-gradient-to-t from-black/70 to-transparent">
    <h3 class="font-semibold text-sm text-white/70">สินค้าตัวอย่าง <%= _n %></h3>
    <span class="text-[var(--gold)]/70 font-bold text-[15px]">฿0.00</span>
  </div>
</div>
