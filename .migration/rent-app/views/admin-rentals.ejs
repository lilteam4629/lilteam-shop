<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><script src="https://cdn.tailwindcss.com"></script><%- include('_head-style') %><%- include('_theme-init') %></head>
<body class="admin-page"><div class="admin-content"><%- include('_admin-nav',{active:'rentals'}) %>
<% messages.error.forEach(m=>{ %><div class="bg-red-500/10 text-red-400 p-3 rounded-xl mb-3"><%= m %></div><% }) %><% messages.success.forEach(m=>{ %><div class="bg-emerald-500/10 text-emerald-400 p-3 rounded-xl mb-3"><%= m %></div><% }) %>
<div class="grid sm:grid-cols-3 gap-3 mb-6"><% [['ร้านทั้งหมด',rentedShops.length],['ร้านใช้งานอยู่',rentedShops.filter(s=>!s.expiresAt||s.expiresAt>Date.now()).length],['รายการชำระ',transactions.filter(t=>t.amount<0).length]].forEach(x=>{ %><div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4"><p class="text-xs text-[var(--text-3)]"><%= x[0] %></p><b class="text-2xl"><%= x[1] %></b></div><% }) %></div>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto mb-6"><h2 class="font-semibold p-4">ร้านที่เช่าอยู่</h2><table class="w-full text-sm min-w-[700px]"><thead><tr><th class="p-3 text-left">ร้าน</th><th class="p-3 text-left">ผู้เช่า</th><th class="p-3 text-left">หมดอายุ</th><th></th></tr></thead><tbody><% rentedShops.forEach(shop=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><b><%= shop.name %></b><small class="block"><%= shop.slug %></small></td><td class="p-3"><%= shop.ownerUsername %></td><td class="p-3"><%= shop.expiresAt?new Date(shop.expiresAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}):'-' %></td><td class="p-3"><form method="post" action="/admin/rentals/<%= encodeURIComponent(shop.id) %>/delete" onsubmit="var n=prompt('พิมพ์ชื่อร้านเพื่อยืนยัน');if(n!==this.dataset.name)return false;this.confirmName.value=n" data-name="<%= shop.name %>"><input type="hidden" name="confirmName"><button class="text-red-400">ลบร้าน</button></form></td></tr><% }) %><% if(!rentedShops.length){ %><tr><td colspan="4" class="p-6 text-center">ยังไม่มีร้าน</td></tr><% } %></tbody></table></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 mb-6"><h2 class="font-semibold mb-3">แจ้งเตือน Discord — <%= discordReady?'พร้อมใช้งาน':discordConfigured?'กำลังเชื่อมต่อ':'ยังไม่ตั้ง Token' %></h2><form action="/admin/discord/settings" method="post" class="grid sm:grid-cols-2 gap-3"><label><input type="checkbox" name="enabled" <%= discordSettings.enabled?'checked':'' %>> เปิดแจ้งเตือน</label><span></span><% [['notifyChannelId','ห้องแจ้งเตือน'],['ticketPanelChannelId','ห้องปุ่มตั๋ว'],['ticketCategoryId','หมวดหมู่ตั๋ว'],['ticketLogChannelId','ห้องบันทึก'],['supportRoleId','บทบาททีมงาน']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= discordSettings[x[0]]||'' %>" class="block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg p-2"></label><% }) %><button class="bg-[var(--gold)] text-[var(--bg)] rounded-lg p-2">บันทึก</button></form><form action="/admin/discord/post-ticket-panel" method="post" class="mt-3"><button class="border rounded-lg p-2">โพสต์ปุ่มเปิดตั๋ว</button></form></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto"><h2 class="font-semibold p-4">ประวัติรายการเช่า</h2><table class="w-full text-sm min-w-[650px]"><tbody><% transactions.forEach(t=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><%= t.username %></td><td class="p-3"><%= t.note %></td><td class="p-3">฿<%= Math.abs(Number(t.amount)).toLocaleString() %></td><td class="p-3"><%= new Date(t.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %></td></tr><% }) %></tbody></table></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto mt-6"><h2 class="font-semibold p-4">ประวัติคีย์และเว็บเช่าแบบเดิม</h2><table class="w-full text-sm min-w-[650px]"><tbody><% sales.forEach(s=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><%= s.username %></td><td class="p-3"><%= s.days %> วัน</td><td class="p-3">฿<%= Number(s.price||0).toLocaleString() %></td><td class="p-3"><%= new Date(s.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %></td></tr><% }) %><% if(!sales.length){ %><tr><td class="p-4">ยังไม่มีประวัติแบบเดิม</td></tr><% } %></tbody></table></section>
</div></body></html>
