<style>
  :root{
    --bg:#100e08; --card:#1a160d; --border:#3a3220; --border-light:#443a22; --input:#211c11;
    --text:#f3ecd8; --text-2:#d6c9a0; --text-3:#a89a6c; --text-4:#7a6f47;
    --gold:#c8a63f; --gold-hover:#dbb94d; --gold-light:#e8d48a; --gold-dark:#8a6f28;
    --coral:#e2836f;
  }
  :root[data-theme="light"]{
    --bg:#faf7ee; --card:#ffffff; --border:#e5ddc4; --border-light:#ded2a8; --input:#f2ecd8;
    --text:#2a2410; --text-2:#4a4020; --text-3:#7a6f47; --text-4:#a89a6c;
    --gold:#a4823a; --gold-hover:#8a6f28; --gold-light:#c8a63f; --gold-dark:#8a6f28;
    --coral:#c14f36;
  }
  body{font-family:'Kanit',sans-serif;background:var(--bg);color:var(--text);transition:background .15s,color .15s;}
  .admin-page{min-height:100vh;background:var(--bg);}
  .admin-sidebar{position:fixed;inset:0 auto 0 0;width:17.5rem;background:var(--card);border-right:1px solid var(--border);z-index:40;display:flex;flex-direction:column;}
  .admin-topbar{position:fixed;left:17.5rem;right:0;top:0;height:4.25rem;background:color-mix(in srgb,var(--card) 92%,transparent);border-bottom:1px solid var(--border);backdrop-filter:blur(14px);z-index:35;display:flex;align-items:center;justify-content:space-between;padding:0 2rem;}
  .admin-content{margin-left:17.5rem;padding:6.25rem 2rem 3rem;max-width:100rem;}
  .admin-nav-link{display:flex;align-items:center;gap:.8rem;padding:.72rem 1rem;border-radius:.8rem;color:var(--text-3);font-size:.86rem;font-weight:500;transition:.18s;}
  .admin-nav-link:hover{background:var(--input);color:var(--text);}
  .admin-nav-link.active{background:color-mix(in srgb,var(--gold) 16%,var(--card));color:var(--gold);box-shadow:inset 3px 0 var(--gold);}
  @media(max-width:800px){.admin-sidebar{position:relative;width:100%;height:auto}.admin-topbar{position:relative;left:0;height:auto;padding:1rem}.admin-content{margin-left:0;padding:1.25rem}.admin-sidebar nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
