<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%- include('_head-style') %>
  <%- include('_theme-init') %>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <%- include('_public-theme-toggle') %>
  <div class="w-full max-w-sm bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6">
    <div class="mb-4">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs text-[var(--text-3)] hover:text-[var(--gold)] transition-colors">
        <span>←</span> <span>กลับหน้าหลัก</span>
      </a>
    </div>
    <div class="text-center mb-5">
      <div class="text-3xl mb-2">🔑</div>
      <h1 class="text-xl font-bold">เข้าสู่ระบบ</h1>
      <p class="text-sm text-[var(--text-3)] mt-1">เข้าสู่ระบบบัญชีผู้เช่าร้านหรือบัญชีแอดมิน</p>
    </div>

    <% messages.error.forEach(m => { %>
      <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/50 text-[var(--coral)] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
    <% }) %>
    <% messages.success.forEach(m => { %>
      <div class="bg-emerald-500/10 border border-emerald-500/40 text-emerald-400 px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
    <% }) %>

    <form action="/login" method="post" class="space-y-3">
      <input name="username" required placeholder="ชื่อผู้ใช้หรืออีเมล" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
      <input name="password" type="password" required placeholder="รหัสผ่าน" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--bg)] font-semibold rounded-lg py-2.5 text-sm">เข้าสู่ระบบ</button>
    </form>
    <p class="text-xs text-[var(--text-4)] text-center mt-4">ยังไม่มีบัญชี? <a href="/register" class="text-[var(--gold)] underline">สมัครสมาชิก</a></p>
  </div>
</body>
</html>
