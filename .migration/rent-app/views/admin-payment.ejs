<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><script src="https://cdn.tailwindcss.com"></script><%- include('_head-style') %><%- include('_theme-init') %></head><body class="admin-page"><div class="admin-content"><%- include('_admin-nav',{active:'payment'}) %><% messages.error.forEach(m=>{ %><div class="p-3 mb-3 bg-red-500/10 text-red-400 rounded-xl"><%= m %></div><% }) %><% messages.success.forEach(m=>{ %><div class="p-3 mb-3 bg-emerald-500/10 text-emerald-400 rounded-xl"><%= m %></div><% }) %>
<form method="post" action="/admin/payment" class="space-y-5"><section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h1 class="text-xl font-bold">ตั้งค่าตรวจสลิปอัตโนมัติ</h1><p class="text-xs text-[var(--text-4)] mt-1 mb-4">EasySlip ใช้พร้อมเพย์ได้ ส่วนค่ายอื่นใช้บัญชีธนาคาร</p>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"><% [['easyslip','EasySlip','พร้อมเพย์ + ธนาคาร'],['slipok','SlipOK','ธนาคารเท่านั้น'],['slipcheck','SlipCheck','ธนาคารเท่านั้น'],['rdcw','SlipRDCW','ธนาคารเท่านั้น'],['slip2go','Slip2Go','ธนาคารเท่านั้น']].forEach(x=>{ %><label class="provider-card cursor-pointer rounded-xl border p-4"><input type="radio" class="sr-only" name="slipProvider" value="<%= x[0] %>" <%= payment.slipProvider===x[0]?'checked':'' %>><b class="block"><%= x[1] %></b><small class="text-[var(--text-4)]"><%= x[2] %></small></label><% }) %></div>
<div class="mt-4"><div class="provider-fields" data-provider="easyslip"><label class="text-xs">EasySlip API Key<input type="password" name="easyslipApiKey" value="<%= payment.easyslipApiKey||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label></div><div class="provider-fields grid sm:grid-cols-2 gap-3" data-provider="slipok"><label class="text-xs">SlipOK Branch ID<input name="slipokBranchId" value="<%= payment.slipokBranchId||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><label class="text-xs">SlipOK API Key<input type="password" name="slipokApiKey" value="<%= payment.slipokApiKey||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label></div><div class="provider-fields" data-provider="slipcheck"><label class="text-xs">SlipCheck API Key<input type="password" name="slipcheckApiKey" value="<%= payment.slipcheckApiKey||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><input type="hidden" name="slipcheckEndpoint" value="<%= payment.slipcheckEndpoint||'https://mxslip.lovable.app/api/public/v1' %>"></div><div class="provider-fields grid sm:grid-cols-2 gap-3" data-provider="rdcw"><label class="text-xs">SlipRDCW Client ID<input name="rdcwClientId" value="<%= payment.rdcwClientId||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><label class="text-xs">SlipRDCW Client Secret<input type="password" name="rdcwClientSecret" value="<%= payment.rdcwClientSecret||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><input type="hidden" name="rdcwEndpoint" value="<%= payment.rdcwEndpoint||'https://suba.rdcw.co.th/v2/inquiry' %>"></div><div class="provider-fields" data-provider="slip2go"><label class="text-xs">Slip2Go API Key<input type="password" name="slip2goApiKey" value="<%= payment.slip2goApiKey||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><input type="hidden" name="slip2goEndpoint" value="<%= payment.slip2goEndpoint||'https://connect.slip2go.com/api' %>"></div></div><button type="button" id="test" class="mt-4 border border-[var(--gold)] text-[var(--gold)] rounded-xl px-4 py-2.5 font-semibold">ทดสอบ API ที่เลือก</button><span id="testResult" class="ml-2 text-sm"></span></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-4">บัญชีรับเงิน</h2><div id="promptpayFields" class="grid sm:grid-cols-2 gap-3 mb-3"><% [['promptpayId','เลขพร้อมเพย์'],['promptpayName','ชื่อพร้อมเพย์']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= payment[x[0]]||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><% }) %></div><p id="bankOnlyHint" class="hidden text-xs text-amber-500 mb-3">ค่ายนี้รองรับเฉพาะบัญชีธนาคาร</p><div class="grid sm:grid-cols-2 gap-3"><% [['bankName','ธนาคาร'],['bankAccountNumber','เลขบัญชี'],['bankAccountName','ชื่อบัญชี']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= payment[x[0]]||'' %>" class="block w-full mt-1 bg-[var(--input)] border rounded-xl p-3"></label><% }) %></div></section>
<section class="bg-[var(--card)] border rounded-2xl p-5"><h2 class="font-bold mb-3">ซองของขวัญ TrueMoney</h2><label><input type="checkbox" name="truemoneyEnabled" <%= payment.truemoneyEnabled?'checked':'' %>> เปิดรับซองอัตโนมัติ</label><input name="truemoneyPhone" value="<%= payment.truemoneyPhone||'' %>" class="mt-3 w-full bg-[var(--input)] border rounded-xl p-3"></section><button class="bg-[var(--gold)] text-[var(--bg)] rounded-xl px-5 py-3 font-bold">บันทึกทั้งหมด</button></form></div>
<script>function refresh(){let s=document.querySelector('[name="slipProvider"]:checked')?.value||'easyslip';document.querySelectorAll('.provider-fields').forEach(x=>x.style.display=x.dataset.provider===s?'grid':'none');document.querySelectorAll('.provider-card').forEach(x=>{let on=x.querySelector('input').checked;x.style.borderColor=on?'var(--gold)':'var(--border-light)';x.style.background=on?'color-mix(in srgb,var(--gold) 10%,transparent)':'var(--input)'});document.getElementById('promptpayFields').style.display=s==='easyslip'?'grid':'none';document.getElementById('bankOnlyHint').classList.toggle('hidden',s==='easyslip')}document.querySelectorAll('[name="slipProvider"]').forEach(x=>x.onchange=refresh);refresh();document.getElementById('test').onclick=async()=>{let f=document.querySelector('form'),r=document.getElementById('testResult');r.textContent='กำลังทดสอบ...';let x=await fetch('/admin/payment/test',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f))}),j=await x.json();r.textContent=(j.ok?'✓ ':'✕ ')+(j.message||'')};</script></body></html>

